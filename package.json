{
  "name": "proyecto",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "posters:thumbs": "node scripts/generate-poster-thumbnails.mjs",
    "test-admin": "node scripts/test-admin.js",
    "dev": "npm run posters:thumbs && node scripts/generate-publicaciones-es.mjs && astro dev",
    "build": "npm run posters:thumbs && node scripts/generate-publicaciones-es.mjs && astro build",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "preview": "astro preview",
    "astro": "astro",
    "prepare:apps-script-preview": "node scripts/prepare-apps-script-preview.mjs && node scripts/prepare-persoas-admin-preview.mjs && node scripts/prepare-fotos-admin-v2-preview.mjs",
    "prepare:apps-script-preview:persoas": "node scripts/prepare-persoas-admin-preview.mjs",
    "prepare:apps-script-preview:fotos": "node scripts/prepare-fotos-admin-v2-preview.mjs"
  },
  "dependencies": {
    "astro": "^7.0.6",
    "firebase": "^12.16.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  }
}