---
/* src/layouts/Layout.astro */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PublicCoralMenu from '../components/PublicCoralMenu.astro';
import PublicPageHero from '../components/PublicPageHero.astro';
import PortalAcceptanceGate from '../components/PortalAcceptanceGate.astro';
import PortalReviewStyles from '../components/PortalReviewStyles.astro';
import '../styles/global.css';

const {
  title,
  lang = 'gl',
  description =
    'Web oficial da Sociedade Coral Polifónica de Pontevedra, fundada en 1925.'
} = Astro.props;

const ruta = Astro.url.pathname;
const eZonaPortal = ruta === '/portal' || ruta.startsWith('/portal/');
const eInicioPortal = ruta === '/portal/' || ruta === '/portal';
const eRepertorio = ruta === '/portal/repertorio' || ruta === '/portal/repertorio/';
const eAxenda = ruta === '/axenda' || ruta === '/axenda/';
const ePortada = ruta === '/';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | SCPP</title>
    <meta name="description" content={description} />
  </head>
  <body class:list={[eZonaPortal && 'portal-private-body']}>
    {!eZonaPortal && <Header lang={lang} />}

    {eZonaPortal ? (
      <main>
        <slot />
      </main>
    ) : (
      <div class:list={['public-site-shell', ePortada && 'is-home']}>
        <PublicCoralMenu currentPath={ruta} />
        <main class="public-site-main">
          <PublicPageHero
            currentPath={ruta}
            pageTitle={title}
            description={description}
          />
          <slot />
        </main>
      </div>
    )}

    {!eZonaPortal && <Footer lang={lang} />}
    {eInicioPortal && <PortalAcceptanceGate />}
    {eInicioPortal && <script is:inline src="/js/portal-auth-diagnostics.js" defer></script>}
    {eZonaPortal && <PortalReviewStyles />}
    {eAxenda && <script is:inline src="/js/poster-thumbnails.js" defer></script>}
    {eRepertorio && <script is:inline src="/js/portal-fast-load.js"></script>}

    {eZonaPortal && (
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.portal-sidebar-footer').forEach((footer) => {
            if (footer.querySelector('.public-site-link')) return;
            const link = document.createElement('a');
            link.className = 'public-site-link';
            link.href = '/';
            link.innerHTML = '<span aria-hidden="true">◎</span><span>Ir á web pública</span>';
            footer.prepend(link);
          });

          const profilePath = '/portal/perfil/';
          document.querySelectorAll('.private-menu .is-disabled').forEach((item) => {
            if (item.textContent?.trim() !== 'O meu perfil') return;
            const link = document.createElement('a');
            link.href = profilePath;
            link.innerHTML = item.innerHTML;
            if (window.location.pathname === profilePath || window.location.pathname === '/portal/perfil') {
              link.classList.add('is-active');
            }
            item.replaceWith(link);
          });

          if (window.location.pathname === profilePath || window.location.pathname === '/portal/perfil') {
            const activeLabel = document.querySelector('.private-mobile-toggle-copy strong');
            if (activeLabel) activeLabel.textContent = 'O meu perfil';
          }

          const dashboardGrid = document.querySelector('#private-dashboard .dashboard-grid');
          if (dashboardGrid && !dashboardGrid.querySelector('[data-profile-module]')) {
            const profileCard = document.createElement('a');
            profileCard.className = 'module-card module-active';
            profileCard.href = profilePath;
            profileCard.dataset.profileModule = 'true';
            profileCard.innerHTML = '<span class="module-number">05</span><div><strong>O meu perfil</strong><p>Consulta e actualiza os teus datos persoais, contacto e preferencias.</p></div><span class="module-arrow" aria-hidden="true">→</span>';
            const firstSoon = dashboardGrid.querySelector('.module-soon');
            dashboardGrid.insertBefore(profileCard, firstSoon || null);
            dashboardGrid.querySelectorAll('.module-soon .module-number').forEach((number, index) => {
              number.textContent = String(index + 6).padStart(2, '0');
            });
          }
        });
      </script>
    )}
  </body>
</html>

<style is:global>
  :root {
    --color-principal: #6b1d2f;
    --color-acento: #bd9648;
    --color-blanco: #ffffff;
    --color-texto: #2d2d2d;
    --color-gris: #f7f7f7;
  }

  * { box-sizing: border-box; }

  [hidden] {
    display: none !important;
  }

  body {
    margin: 0;
    font-family: 'Aptos', 'Calibri', system-ui, sans-serif;
    color: var(--color-texto);
    background-color: var(--color-blanco);
    line-height: 1.6;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /*
   * Estrutura pública estable.
   * Ver docs/GUIA-DESEÑO-WEB-PUBLICA.md antes de modificar estas medidas.
   */
  .public-site-shell {
    display: grid;
    grid-template-columns: minmax(205px, 225px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.2rem, 2vw, 1.8rem);
    width: min(100%, 1400px);
    margin: 0 auto;
    padding: 0 clamp(1rem, 1.8vw, 1.75rem);
  }

  .public-site-main {
    min-width: 0;
  }

  .public-site-shell.is-home {
    display: block;
    width: min(100%, 1240px);
    padding: 0 1.5rem;
  }

  .public-site-shell.is-home .public-site-main {
    width: 100%;
  }

  .public-site-shell.is-home .hero-section {
    padding: 1.35rem 0 0 !important;
  }

  .public-site-shell.is-home .hero-box {
    width: 100% !important;
    max-width: 1120px !important;
    min-height: 325px !important;
    margin: 0 auto !important;
  }

  .public-site-shell.is-home .hero-content {
    padding: 1.7rem 1.4rem !important;
  }

  .public-site-shell.is-home .hero-logo-wrapper {
    width: 116px !important;
    height: 116px !important;
    margin-bottom: 1.15rem !important;
  }

  .public-site-shell.is-home .hero-content h1 {
    max-width: 650px;
    font-size: clamp(1.85rem, 3.2vw, 2.35rem) !important;
    line-height: 1.12 !important;
  }

  .public-site-shell.is-home .minimal-line {
    margin: .85rem 0 !important;
  }

  .public-site-shell.is-home .hero-subtitle {
    font-size: .95rem !important;
  }

  .public-site-main .coral-page-wrapper {
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 0 !important;
  }

  .public-site-main .coral-page-wrapper > .coral-sidebar {
    display: none !important;
  }

  @media (max-width: 1180px) {
    .public-site-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 0;
    }

    .public-site-shell.is-home {
      width: 100%;
      padding: 0 1rem;
    }
  }

  @media (max-width: 640px) {
    .public-site-shell.is-home .hero-box {
      min-height: 290px !important;
    }

    .public-site-shell.is-home .hero-logo-wrapper {
      width: 96px !important;
      height: 96px !important;
    }
  }

  body.portal-private-body .private-menu a[href="/portal/perfil/"] {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: center;
    gap: .72rem;
    min-height: 2.72rem;
    padding: .62rem .72rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: #4e4a47;
    font: inherit;
    font-size: .88rem;
    font-weight: 500;
    line-height: 1.6;
    text-align: left;
    text-decoration: none;
  }

  body.portal-private-body .private-menu a[href="/portal/perfil/"] svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  body.portal-private-body .private-menu a[href="/portal/perfil/"]:hover,
  body.portal-private-body .private-menu a[href="/portal/perfil/"].is-active {
    background: #f2ecec;
    color: var(--color-principal);
  }

  body.portal-private-body .private-menu a[href="/portal/perfil/"].is-active {
    font-weight: 700;
  }

  body.portal-private-body #private-dashboard .dashboard-grid a[data-profile-module] {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    min-height: 135px;
    padding: 1.35rem;
    border: 1px solid #d8d1bc;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: .2s ease;
  }

  body.portal-private-body #private-dashboard .dashboard-grid a[data-profile-module]:hover {
    transform: translateY(-3px);
    border-color: #a18331;
    box-shadow: 0 12px 28px rgba(44, 55, 49, .08);
  }

  body.portal-private-body #private-dashboard a[data-profile-module] .module-number {
    color: #a18331;
    font-size: .75rem;
    font-weight: 800;
  }

  body.portal-private-body #private-dashboard a[data-profile-module] strong {
    display: block;
    margin-bottom: .4rem;
    color: #24362f;
    font-size: 1.15rem;
  }

  body.portal-private-body #private-dashboard a[data-profile-module] p {
    margin: 0;
    color: #69746f;
    line-height: 1.5;
  }

  body.portal-private-body #private-dashboard a[data-profile-module] .module-arrow {
    align-self: center;
    color: #7a263a;
    font-size: 1.5rem;
  }

  /* Inicio de sesión: evita que as tarxetas se esmaguen ao usar media pantalla. */
  @media (min-width: 981px) and (max-width: 1320px) {
    body.portal-private-body #portal-shell:not(.private-active) .portal-hero {
      grid-template-columns: minmax(0, 1fr) !important;
      gap: 2rem !important;
    }

    body.portal-private-body #portal-shell:not(.private-active) .portal-intro {
      width: 100% !important;
      max-width: none !important;
    }

    body.portal-private-body #portal-shell:not(.private-active) .portal-access-card {
      width: min(100%, 620px) !important;
      justify-self: start !important;
    }
  }

  @media (min-width: 1181px) {
    body.portal-private-body .portal-sidebar-container:not([hidden]) {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      z-index: 100 !important;
      width: 282px !important;
      height: 100vh !important;
    }

    body.portal-private-body .portal-sidebar-container + #portal-shell.private-active {
      width: calc(100% - 282px);
      max-width: none;
      margin-top: 0 !important;
      margin-right: 0;
      margin-left: 282px;
    }

    body.portal-private-body .profile-main .private-page-header,
    body.portal-private-body .profile-main .portal-state,
    body.portal-private-body .profile-main .profile-panel {
      width: 100% !important;
      max-width: none !important;
      margin-right: 0 !important;
      margin-left: 0 !important;
    }
  }

  @media (max-width: 1180px) {
    body.portal-private-body .portal-sidebar-container {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      z-index: auto !important;
      width: 100% !important;
      height: auto !important;
    }

    body.portal-private-body .portal-sidebar-container + #portal-shell,
    body.portal-private-body .portal-sidebar-container + #portal-shell.private-active {
      clear: both;
      width: 100%;
      max-width: 1240px;
      margin-right: auto;
      margin-left: auto;
    }
  }

  @media (min-width: 621px) and (max-width: 1180px) {
    body.portal-private-body .portal-sidebar-container .private-sidebar {
      position: relative !important;
      width: 100% !important;
      height: auto !important;
      padding: 1rem !important;
      overflow: visible !important;
      border-right: 0 !important;
      border-bottom: 1px solid #e7e3df !important;
    }

    body.portal-private-body .portal-sidebar-container .private-brand {
      grid-template-columns: 48px minmax(0, 1fr);
      padding-bottom: 1rem;
    }

    body.portal-private-body .portal-sidebar-container .private-crest {
      width: 44px;
      height: 60px;
    }

    body.portal-private-body .portal-sidebar-container .private-menu {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    body.portal-private-body .portal-sidebar-container .private-menu .is-disabled {
      display: none;
    }

    body.portal-private-body .portal-sidebar-container .private-sidebar-footer {
      grid-template-columns: 1fr 1fr;
      margin-top: .8rem;
    }
  }

  @media (max-width: 640px) {
    body.portal-private-body #private-dashboard .dashboard-grid a[data-profile-module] {
      grid-template-columns: auto 1fr;
    }

    body.portal-private-body #private-dashboard a[data-profile-module] .module-arrow {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
