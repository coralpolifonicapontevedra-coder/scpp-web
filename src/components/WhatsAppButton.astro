---
const phone = '34681254688';
const label = 'Contactar SCPP';
const href = `https://wa.me/${phone}`;
---

<a
  class="whatsapp-contact"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label} por WhatsApp`}
  title={`${label} por WhatsApp`}
>
  <svg aria-hidden="true" viewBox="0 0 32 32">
    <path d="M16.04 3.2A12.73 12.73 0 0 0 5.3 22.77L3.2 28.8l6.2-2.04A12.76 12.76 0 1 0 16.04 3.2Zm0 23.18c-2.08 0-4.11-.61-5.84-1.76l-.42-.25-3.68 1.21 1.23-3.58-.27-.43a10.45 10.45 0 1 1 8.98 4.81Zm5.73-7.82c-.31-.16-1.86-.92-2.15-1.02-.29-.11-.5-.16-.71.16-.21.31-.81 1.02-1 1.23-.18.21-.36.24-.68.08-.31-.16-1.32-.49-2.52-1.56a9.42 9.42 0 0 1-1.75-2.18c-.18-.31-.02-.48.14-.64.14-.14.31-.37.47-.55.16-.18.21-.31.31-.52.11-.21.06-.39-.02-.55-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.54-.71-.55h-.61c-.21 0-.55.08-.84.39-.29.32-1.1 1.08-1.1 2.63s1.13 3.05 1.29 3.26c.16.21 2.22 3.39 5.38 4.75.75.32 1.34.52 1.8.66.76.24 1.45.21 1.99.13.61-.09 1.86-.76 2.12-1.5.26-.73.26-1.36.18-1.49-.08-.13-.29-.21-.61-.37Z" />
  </svg>
  <span>{label}</span>
</a>

<style>
  .whatsapp-contact {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    min-height: 3.25rem;
    padding: .72rem 1rem;
    border-radius: 999px;
    background: #197a4a;
    color: #fff;
    box-shadow: 0 7px 22px rgba(22, 61, 43, .25);
    font-size: .9rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform .18s ease, background-color .18s ease, box-shadow .18s ease;
  }

  .whatsapp-contact:hover {
    transform: translateY(-2px);
    background: #12643b;
    box-shadow: 0 9px 26px rgba(22, 61, 43, .32);
  }

  .whatsapp-contact:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .whatsapp-contact svg {
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 auto;
    fill: currentColor;
  }

  @media (max-width: 520px) {
    .whatsapp-contact {
      width: 3.4rem;
      height: 3.4rem;
      justify-content: center;
      padding: 0;
    }

    .whatsapp-contact span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-contact { transition: none; }
  }
</style>
