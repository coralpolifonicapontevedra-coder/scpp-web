---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-wrapper">
    <div class="footer-brand">
      <p class="brand-name">Sociedad Coral Polifónica de Pontevedra</p>
      <p class="legal-id">NIF: G-36011286</p>
      <p class="legal-id">Registro de Asociaciones: 1966/72-1</p>
      <p class="tagline">Fundada en 1925. Cien años de polifonía y patrimonio cultural en Galicia.</p>
    </div>

    <div class="footer-sections">
      <div class="footer-section">
        <h4>Dirección de la sede</h4>
        <p>Rúa Luís Braille 40</p>
        <p>36003 Pontevedra</p>
        <p style="margin-top:.8rem"><strong>Teléfono:</strong> <a href="tel:+34681254688">681 254 688</a></p>
        <p><strong>Correo:</strong> <a href="mailto:secretaria@coralpolifonicapontevedra.org">secretaria@coralpolifonicapontevedra.org</a></p>
      </div>

      <div class="footer-section">
        <h4>Enlaces</h4>
        <ul>
          <li><a href="/es/">Inicio</a></li>
          <li><a href="/es/la-coral">La Coral</a></li>
          <li><a href="/es/agenda">Agenda</a></li>
          <li><a href="/es/colabora">Colabora</a></li>
          <li><a href="/portal">Área privada</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Redes sociales</h4>
        <div class="social-footer">
          <a href="https://www.facebook.com/PolifonicaPontevedra/" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" class="social-icon-footer"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/></svg></a>
          <a href="https://www.instagram.com/polifonicapontevedra/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" class="social-icon-footer"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg></a>
          <a href="https://www.youtube.com/@coralpolifonicadepontevedr4676" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" class="social-icon-footer"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Sociedad Coral Polifónica de Pontevedra. Todos los derechos reservados.</p>
    <div class="footer-legal">
      <a href="/es/privacidad">Privacidad</a> | <a href="/es/aviso-legal">Aviso legal</a> | <a href="/es/cookies">Cookies</a>
    </div>
  </div>
</footer>

<script is:inline>
(() => {
  const path = window.location.pathname;

  if (/^\/es\/?$/.test(path)) {
    const collaborationLink = Array.from(document.querySelectorAll('.home-actions a')).find((link) => link.getAttribute('href') === '/es/colabora');
    if (collaborationLink) collaborationLink.setAttribute('href', '/es/donar/');
  }

  if (/^\/es\/historia\/?$/.test(path)) {
    const sanDavid = document.querySelector('.castelao-san-david-block .castelao-hero-image img');
    if (sanDavid instanceof HTMLImageElement) {
      sanDavid.src = 'https://drive.google.com/uc?export=view&id=1eFX4RgrgWbbmk7nsqiVIYn0xqsediyZ6';
      sanDavid.alt = 'Escudo de San David de la Sociedad Coral Polifónica de Pontevedra';
    }

    const roseton = document.querySelector('.castelao-roseton-block .castelao-hero-image img');
    if (roseton instanceof HTMLImageElement) {
      roseton.src = '/api/galeria-orixinal?ruta=fotos%2Forixinais%2F91630e1a-725d-42c9-9aa5-259e6655ef08.jpg';
      roseton.alt = 'Rosetón ojival diseñado por Castelao para la Sociedad Coral Polifónica de Pontevedra';
    }
  }
})();
</script>

<style>
.site-footer{background-color:var(--color-principal);color:var(--color-blanco);padding:4rem 2rem 2rem;margin-top:6rem}.footer-wrapper{display:grid;grid-template-columns:1fr 2fr;gap:4rem;margin-bottom:3rem}.footer-brand{display:flex;flex-direction:column;justify-content:flex-start}.brand-name,.legal-id,.tagline{font-size:.9rem;line-height:1.6}.brand-name{margin:0 0 .35rem;color:var(--color-blanco);font-weight:700}.legal-id{margin:0;opacity:.85}.tagline{margin-top:1rem;opacity:.85}.footer-sections{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.footer-section h4{font-size:.95rem;text-transform:uppercase;letter-spacing:.05em;color:var(--color-acento);margin-bottom:1rem;font-weight:700}.footer-section p{font-size:.85rem;opacity:.8;margin-bottom:.5rem;line-height:1.5}.footer-section a{color:var(--color-blanco);text-decoration:none;opacity:.8;transition:opacity .2s ease}.footer-section a:hover{opacity:1;color:var(--color-acento)}.footer-section ul{list-style:none;padding:0}.footer-section li{margin-bottom:.5rem}.social-footer{display:flex;gap:1rem}.social-footer a{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;background:rgba(255,255,255,.1);border-radius:4px;transition:all .3s ease}.social-footer a:hover{background:var(--color-acento);transform:scale(1.05)}.social-icon-footer{width:20px;height:20px;fill:var(--color-blanco)}.social-footer a:hover .social-icon-footer{fill:var(--color-principal)}.footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:2rem;text-align:center}.footer-bottom p{font-size:.8rem;opacity:.6;margin-bottom:1rem}.footer-legal{font-size:.75rem;opacity:.5}.footer-legal a{color:var(--color-blanco);text-decoration:none;margin:0 .5rem}.footer-legal a:hover{color:var(--color-acento)}
:global(.castelao-san-david-block){display:block!important;overflow:auto}:global(.castelao-san-david-block .castelao-hero-image){float:left!important;width:min(60%,590px)!important;aspect-ratio:1084/720!important;margin:0 clamp(1.4rem,3vw,2.4rem) 1rem 0!important}:global(.castelao-san-david-block .castelao-hero-image img){width:100%!important;height:auto!important;min-height:0!important;object-fit:contain!important}:global(.castelao-san-david-block .castelao-hero-copy){padding:clamp(.4rem,1.2vw,1rem) 0 0!important;align-self:auto!important}
:global(.castelao-roseton-block .castelao-hero-image){aspect-ratio:auto!important;display:block!important;overflow:hidden!important;padding:0!important;background:#fff!important}:global(.castelao-roseton-block .castelao-hero-image img){width:100%!important;max-width:none!important;height:auto!important;min-height:0!important;aspect-ratio:auto!important;object-fit:contain!important;clip-path:none!important;background:#fff!important}
@media(max-width:992px){.footer-wrapper{grid-template-columns:1fr;gap:2rem}.footer-sections{grid-template-columns:1fr}}@media(max-width:700px){:global(.castelao-san-david-block .castelao-hero-image){float:none!important;width:100%!important;margin:0 0 1.35rem!important}:global(.castelao-san-david-block .castelao-hero-copy){padding:0 1.35rem 1.35rem!important}}@media(max-width:576px){.footer-sections{grid-template-columns:1fr;gap:1.5rem}.brand-name,.legal-id,.tagline{font-size:.8rem}.social-footer{gap:.8rem}.social-footer a{width:36px;height:36px}.social-icon-footer{width:18px;height:18px}}
</style>
