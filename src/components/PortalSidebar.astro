---
import { Image } from 'astro:assets';
import escudoImg from '../assets/escudo-raw.svg';
import { getPortalNavigationLabel, getPortalNavigationModules } from '../data/portal-navigation';

const { active = '', logoutId = 'portal-logout' } = Astro.props;
const modules = getPortalNavigationModules('sidebar');

const activeLabel = getPortalNavigationLabel(active, 'Menú do portal');

const ICONS = {
  inicio: '<path d="M3 11.5 12 4l9 7.5M5.5 10.5V20h5v-5h3v5h5v-9.5" />',
  subir: '<path d="M12 16V5m0 0L8 9m4-4 4 4M5.5 18.5a4 4 0 0 1 .6-7.95A6 6 0 0 1 17.6 9a4.5 4.5 0 0 1 .9 8.9" />',
  revisar: '<rect x="4" y="4" width="13" height="13" rx="1.5" /><path d="m7 14 3-3 2.2 2.2 2-2L17 14M16 8h4v12H8v-3" />',
  repertorio: '<path d="M9 18V6l10-2v12M9 10l10-2M6 20a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm10 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />',
  partituras: '<path d="M6 3h9l3 3v15H6zM15 3v4h4M9 11h6m-6 4h6m-6 4h4" />',
  concertos: '<rect x="4" y="6" width="16" height="14" rx="1.5" /><path d="M8 3v6m8-6v6M4 11h16" />',
  ensaios: '<circle cx="8" cy="8" r="3" /><circle cx="16.5" cy="9" r="2.5" /><path d="M2.5 20c.5-4 2.3-6 5.5-6s5 2 5.5 6m0-5c3.3-.8 6.2 1 7 5" />',
  galeria: '<rect x="4" y="4" width="16" height="16" rx="1.5" /><circle cx="9" cy="9" r="1.5" /><path d="m5.5 17 4.5-4.5 3 3 2-2 3.5 3.5" />',
  documentacion: '<path d="M6 3h8l4 4v14H6zM14 3v5h5M9 13h6m-6 4h6" />',
  axuda: '<circle cx="12" cy="12" r="9" /><path d="M9.8 9a2.4 2.4 0 1 1 3.8 1.95c-1 .7-1.6 1.15-1.6 2.55M12 17.5v.1" />',
  perfil: '<circle cx="12" cy="8" r="3.5" /><path d="M5.5 21c.6-4.5 2.7-6.5 6.5-6.5s5.9 2 6.5 6.5" />',
  administracion: '<path d="m12 3 7 3v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6z" /><circle cx="12" cy="10" r="2.2" /><path d="M8.5 16c.5-2 1.7-3 3.5-3s3 1 3.5 3" />',
} as const;

const iconFor = (id: string) => ICONS[id as keyof typeof ICONS] || '';
---

<aside class="private-sidebar" aria-label="Navegación do portal privado">
  <a class="private-brand" href="/portal/" aria-label="Inicio do Portal do Coralista">
    <Image src={escudoImg} alt="Escudo da Sociedade Coral Polifónica de Pontevedra" class="private-crest" />
    <span class="private-brand-copy">
      <strong>Sociedade Coral<br />Polifónica<br />de Pontevedra</strong>
      <small>Desde 1925</small>
    </span>
  </a>

  <p class="private-menu-title">Portal do Coralista</p>

  <button class="private-mobile-toggle" type="button" aria-expanded="false" aria-controls="private-navigation-panel">
    <span class="private-mobile-toggle-copy"><small>Menú do portal</small><strong>{activeLabel}</strong></span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>

  <div id="private-navigation-panel" class="private-navigation-panel">
    <nav class="private-menu">
      {modules.map((module) => {
        const isEnabled = module.sidebarEnabled ?? module.enabled;
        return isEnabled ? (
          <a
            class:list={[active === module.id && 'is-active']}
            href={module.path}
            data-nav-id={module.id}
            data-review-admin={module.id === 'revisar' ? 'true' : undefined}
            data-board-role={module.id === 'administracion' ? 'true' : undefined}
            hidden={module.id === 'revisar' || module.id === 'administracion' ? true : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={iconFor(module.id)} />
            <span>{module.label}</span>
          </a>
        ) : (
          <span class="is-disabled">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={iconFor(module.id)} />
            <span>{module.label}</span>
          </span>
        );
      })}
    </nav>

    <div class="private-sidebar-footer">
      <a href="/" class="private-public-link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><span>Ir á web pública</span>
      </a>
      <button id={logoutId} type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4m4-4H9" /></svg><span>Pechar sesión</span>
      </button>
    </div>
  </div>
</aside>

<script>
  import { onAuthStateChanged } from 'firebase/auth';
  import { auth, readPortalSession } from '../lib/portal-session.js';

  const mobileMenuQuery = window.matchMedia('(max-width: 620px)');
  const PROTECTED_MENU_CACHE_KEY = 'scpp-protected-menu-v2';
  const PROTECTED_MENU_CACHE_TTL = 15 * 60 * 1000;

  function normalizeEmail(value) {
    return String(value || '').trim().toLowerCase();
  }

  function readProtectedMenuCache(email) {
    try {
      const raw = window.sessionStorage.getItem(PROTECTED_MENU_CACHE_KEY);
      if (!raw) return null;
      const cached = JSON.parse(raw);
      if (normalizeEmail(cached?.email) !== normalizeEmail(email)) return null;
      if (typeof cached?.reviewAllowed !== 'boolean' || typeof cached?.administrationAllowed !== 'boolean') return null;
      if (!cached?.savedAt || Date.now() - Number(cached.savedAt) > PROTECTED_MENU_CACHE_TTL) {
        window.sessionStorage.removeItem(PROTECTED_MENU_CACHE_KEY);
        return null;
      }
      return cached;
    } catch {
      return null;
    }
  }

  function writeProtectedMenuCache(email, reviewAllowed, administrationAllowed) {
    try {
      window.sessionStorage.setItem(PROTECTED_MENU_CACHE_KEY, JSON.stringify({
        email: normalizeEmail(email),
        reviewAllowed: Boolean(reviewAllowed),
        administrationAllowed: Boolean(administrationAllowed),
        savedAt: Date.now()
      }));
    } catch {
      // Ignorar sesión non dispoñible.
    }
  }

  function clearProtectedMenuCache() {
    try {
      window.sessionStorage.removeItem(PROTECTED_MENU_CACHE_KEY);
    } catch {
      // Ignorar sesión non dispoñible.
    }
  }

  async function checkProtectedAccess(idToken) {
    const response = await fetch('/api/portal-access', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken })
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || result?.ok !== true) {
      throw new Error(result?.erro || `Erro HTTP ${response.status}`);
    }
    return result;
  }

  function syncProtectedNavigation({ reviewAllowed, administrationAllowed }) {
    document
      .querySelectorAll('[data-review-admin="true"]')
      .forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        item.hidden = !reviewAllowed;
      });

    document
      .querySelectorAll('[data-board-role="true"]')
      .forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        item.hidden = !administrationAllowed;
      });
  }

  document.querySelectorAll<HTMLElement>('.private-sidebar').forEach((sidebar) => {
    const toggle = sidebar.querySelector<HTMLButtonElement>('.private-mobile-toggle');
    const panel = sidebar.querySelector<HTMLElement>('.private-navigation-panel');
    if (!toggle || !panel) return;
    sidebar.classList.add('has-mobile-menu');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('is-open', open);
      panel.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    sidebar.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
    });
    mobileMenuQuery.addEventListener('change', (event) => { if (!event.matches) setOpen(false); });
  });

  onAuthStateChanged(auth, async (user) => {
    if (!user?.email) {
      clearProtectedMenuCache();
      syncProtectedNavigation({ reviewAllowed: false, administrationAllowed: false });
      return;
    }

    const cachedPermissions = readProtectedMenuCache(user.email);
    const session = readPortalSession();
    const sessionAdministration = normalizeEmail(session?.email) === normalizeEmail(user.email)
      && session?.nivel === 'Administración';
    const knownAdministration = Boolean(cachedPermissions?.administrationAllowed || sessionAdministration);
    const knownReview = Boolean(cachedPermissions?.reviewAllowed || knownAdministration);

    if (cachedPermissions || sessionAdministration) {
      syncProtectedNavigation({
        reviewAllowed: knownReview,
        administrationAllowed: knownAdministration
      });
    }

    let access;
    try {
      const idToken = await user.getIdToken();
      access = await checkProtectedAccess(idToken);
    } catch {
      return;
    }

    const administrationAllowed = access.administrationKnown
      ? Boolean(access.administrationAllowed)
      : knownAdministration;
    const reviewAllowed = access.reviewKnown
      ? Boolean(access.reviewAllowed)
      : Boolean(cachedPermissions?.reviewAllowed || administrationAllowed);

    writeProtectedMenuCache(user.email, reviewAllowed, administrationAllowed);
    syncProtectedNavigation({ reviewAllowed, administrationAllowed });
  });
</script>

<script is:inline src="/js/repertorio-search-results.js" defer></script>

<style>
  .private-sidebar { position: sticky; top: 0; display: flex; flex-direction: column; width: 282px; height: 100vh; padding: 1.8rem 1.1rem 1.25rem; overflow-y: auto; border-right: 1px solid #e7e3df; background: #fafafa; }
  .private-brand { display: grid; grid-template-columns: 62px minmax(0, 1fr); align-items: center; gap: .9rem; padding: 0 .5rem 1.85rem; color: #24211f; }
  .private-crest { width: 58px; height: 78px; object-fit: contain; }
  .private-brand-copy { display: grid; gap: .3rem; }
  .private-brand-copy strong { color: #24211f; font-family: Georgia, 'Times New Roman', serif; font-size: .82rem; font-weight: 700; line-height: 1.42; text-transform: uppercase; }
  .private-brand-copy small { color: var(--color-acento); font-size: .72rem; font-weight: 700; }
  .private-menu-title { margin: 0; padding: .55rem .75rem .8rem; color: var(--color-principal); font-size: .84rem; font-weight: 800; text-transform: uppercase; }
  .private-mobile-toggle { display: none; }
  .private-navigation-panel { display: flex; flex: 1 1 auto; flex-direction: column; min-height: 0; }
  .private-menu { display: grid; gap: .12rem; }
  .private-menu a, .private-menu .is-disabled, .private-sidebar-footer a, .private-sidebar-footer button { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); align-items: center; gap: .72rem; min-height: 2.72rem; padding: .62rem .72rem; border: 0; border-radius: 4px; background: transparent; color: #4e4a47; font: inherit; font-size: .88rem; font-weight: 500; text-align: left; text-decoration: none; }
  .private-menu svg, .private-sidebar-footer svg, .private-mobile-toggle svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
  .private-menu a[hidden], .private-menu .is-disabled[hidden], .private-sidebar-footer a[hidden], .private-sidebar-footer button[hidden] { display: none !important; }
  .private-menu a:hover, .private-menu a.is-active, .private-sidebar-footer a:hover, .private-sidebar-footer button:hover { background: #f2ecec; color: var(--color-principal); }
  .private-menu a.is-active { font-weight: 700; }
  .private-menu .is-disabled { color: #77716d; cursor: default; }
  .private-sidebar-footer { display: grid; gap: .25rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid #e4e0dc; }
  .private-sidebar-footer a, .private-sidebar-footer button { width: 100%; cursor: pointer; }
  .private-public-link { color: var(--color-principal) !important; }
  @media (max-width: 900px) {
    :global(body .portal-sidebar-container) { position: relative; width: 100%; height: auto; }
    :global(body .portal-sidebar-container .private-sidebar) { position: relative !important; width: 100% !important; height: auto !important; }
    .private-sidebar { position: relative; width: 100%; height: auto; padding: 1rem; border-right: 0; border-bottom: 1px solid #e7e3df; }
    .private-brand { grid-template-columns: 48px minmax(0, 1fr); padding-bottom: 1rem; }
    .private-crest { width: 44px; height: 60px; }
    .private-menu { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .private-menu .is-disabled { display: none; }
    .private-sidebar-footer { grid-template-columns: 1fr 1fr; margin-top: .8rem; }
  }
  @media (max-width: 620px) {
    .private-sidebar { padding: .85rem 1rem 1rem; overflow: visible; }
    .private-brand { padding-bottom: .75rem; }
    .private-menu-title { display: none; }
    .private-sidebar.has-mobile-menu .private-mobile-toggle { display: grid; }
    .private-mobile-toggle { grid-template-columns: minmax(0, 1fr) 1.25rem; align-items: center; gap: .75rem; width: 100%; min-height: 3.25rem; padding: .55rem .75rem; border: 1px solid #ddd6d2; border-radius: 6px; background: #fff; color: var(--color-principal); font: inherit; text-align: left; cursor: pointer; }
    .private-mobile-toggle-copy { display: grid; gap: .1rem; min-width: 0; }
    .private-mobile-toggle-copy small { color: #6b6561; font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
    .private-mobile-toggle-copy strong { overflow: hidden; font-size: .9rem; text-overflow: ellipsis; white-space: nowrap; }
    .private-mobile-toggle svg { justify-self: end; transition: transform .2s ease; }
    .private-mobile-toggle.is-open svg { transform: rotate(180deg); }
    .private-navigation-panel { display: none; margin-top: .55rem; padding: .4rem; border: 1px solid #e0dad5; border-radius: 6px; background: #fff; box-shadow: 0 12px 30px rgba(40, 30, 25, .08); }
    .private-navigation-panel.is-open { display: flex; }
    .private-menu { grid-template-columns: 1fr; }
    .private-menu .is-disabled { display: none; }
    .private-sidebar-footer { grid-template-columns: 1fr; }
  }
</style>