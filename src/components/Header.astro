---
/* src/components/Header.astro */
import { Image } from 'astro:assets';
import escudoImg from '../assets/escudo-raw.svg';

const { lang = 'gl' } = Astro.props;
const currentPath = Astro.url.pathname;
const homeUrl = lang === 'es' ? '/es/' : '/';
const brandName = lang === 'es'
  ? 'Sociedad Coral Polifónica de Pontevedra'
  : 'Sociedade Coral Polifónica de Pontevedra';

const menuItems = {
  gl: [
    { name: 'Inicio', url: '/' },
    { name: 'A Coral', url: '/acoral' },
    { name: 'Axenda', url: '/axenda' },
    { name: 'Actualidade', url: '/actualidade' },
    { name: 'Galería', url: '/galeria' },
    { name: 'Colabora', url: '/colabora' },
    { name: 'Contacto', url: '/contacto' },
    { name: 'Portal', url: '/portal' }
  ],
  es: [
    { name: 'Inicio', url: '/es/' },
    /* As restantes rutas manteranse na versión galega ata completar cada tradución. */
    { name: 'La Coral', url: '/acoral' },
    { name: 'Agenda', url: '/axenda' },
    { name: 'Actualidad', url: '/actualidade' },
    { name: 'Galería', url: '/galeria' },
    { name: 'Colabora', url: '/colabora' },
    { name: 'Contacto', url: '/contacto' },
    { name: 'Portal', url: '/portal' }
  ]
};

const currentMenu = menuItems[lang] ?? menuItems.gl;
const isActive = (url) =>
  currentPath === url ||
  currentPath === `${url}/` ||
  (url !== '/' && url !== '/es/' && currentPath.startsWith(`${url}/`));
const activeItem = currentMenu.find((item) => isActive(item.url)) ?? currentMenu[0];
const openMenuLabel = 'Abrir menú';
const closeMenuLabel = lang === 'es' ? 'Cerrar menú' : 'Pechar menú';
const languageLabel = lang === 'es' ? 'Cambiar idioma' : 'Cambiar idioma';
---

<header class="site-header">
  <div class="header-wrap">
    <a href={homeUrl} class="logo-link">
      <Image
        src={escudoImg}
        alt="Escudo SCPP"
        class="main-logo"
      />

      <div class="brand-text">
        <span class="brand-title">SCPP</span>
        <span class="brand-sub">{brandName}</span>
      </div>
    </a>

    <nav id="navMenu" class="nav-menu" aria-label="Navegación principal">
      {currentMenu.map((item) => (
        <a
          href={item.url}
          class={isActive(item.url) ? 'active-link' : ''}
        >
          {item.name}
        </a>
      ))}
    </nav>

    <div class="header-right-zone">
      <div class="header-social-links">
        <a href="https://www.facebook.com/PolifonicaPontevedra/" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook">
          <svg viewBox="0 0 24 24" class="social-icon"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/></svg>
        </a>
        <a href="https://www.instagram.com/polifonicapontevedra/" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram">
          <svg viewBox="0 0 24 24" class="social-icon"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
        </a>
        <a href="https://www.youtube.com/@coralpolifonicadepontevedr4676" target="_blank" rel="noopener noreferrer" title="YouTube" aria-label="YouTube">
          <svg viewBox="0 0 24 24" class="social-icon"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>

      <nav class="lang-selector" aria-label={languageLabel}>
        <a href="/" lang="gl" hreflang="gl" class={lang === 'gl' ? 'active-lang' : ''} aria-current={lang === 'gl' ? 'page' : undefined}>GL</a>
        <span aria-hidden="true">|</span>
        <a href="/es/" lang="es" hreflang="es" class={lang === 'es' ? 'active-lang' : ''} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
      </nav>
    </div>

    <button
      id="menuToggle"
      class="menu-toggle"
      type="button"
      aria-label={openMenuLabel}
      aria-expanded="false"
      aria-controls="navMenu"
      data-open-label={openMenuLabel}
      data-close-label={closeMenuLabel}
    >
      <span class="menu-toggle-copy">
        <small>Menú principal</small>
        <strong>{activeItem.name}</strong>
      </span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>

    <nav class="lang-selector lang-selector--mobile" aria-label={languageLabel}>
      <a href="/" lang="gl" hreflang="gl" class={lang === 'gl' ? 'active-lang' : ''} aria-current={lang === 'gl' ? 'page' : undefined}>GL</a>
      <span aria-hidden="true">|</span>
      <a href="/es/" lang="es" hreflang="es" class={lang === 'es' ? 'active-lang' : ''} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');
  const mobileMenuQuery = window.matchMedia('(max-width: 992px)');

  const setMenuOpen = (open: boolean) => {
    if (!(menuToggle instanceof HTMLButtonElement) || !(navMenu instanceof HTMLElement)) return;
    menuToggle.classList.toggle('is-open', open);
    navMenu.classList.toggle('is-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute(
      'aria-label',
      open
        ? menuToggle.dataset.closeLabel || 'Pechar menú'
        : menuToggle.dataset.openLabel || 'Abrir menú'
    );
  };

  menuToggle?.addEventListener('click', () => {
    setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  navMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      menuToggle.focus();
    }
  });

  mobileMenuQuery.addEventListener('change', (event) => {
    if (!event.matches) setMenuOpen(false);
  });
</script>

<style>
.site-header{
  background:var(--color-blanco);
  border-bottom:1px solid var(--color-gris);
  position:sticky;
  top:0;
  z-index:100;
}

.header-wrap{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:1.2rem 2rem;
  max-width:1400px;
  margin:0 auto;
  width:100%;
}

.logo-link{
  display:flex;
  align-items:center;
  gap:1.2rem;
  text-decoration:none;
}

.main-logo{
  height:4cm;
  width:auto;
  display:block;
}

.brand-text{
  display:flex;
  flex-direction:column;
}

.brand-title{
  font-size:1.6rem;
  font-weight:700;
  color:var(--color-principal);
  line-height:1.1;
}

.brand-sub{
  font-size:.78rem;
  text-transform:uppercase;
  opacity:.8;
  color:var(--color-texto);
}

.nav-menu{
  display:flex;
  align-items:center;
  flex-grow:1;
  justify-content:center;
  padding:0 1.5rem;
}

.nav-menu a{
  margin:0 .65rem;
  font-size:.85rem;
  font-weight:600;
  letter-spacing:.05em;
  text-transform:uppercase;
  text-decoration:none;
  color:var(--color-texto);
  transition:.2s;
  white-space:nowrap;
}

.nav-menu a:hover{
  color:var(--color-acento);
}

.active-link{
  color:var(--color-acento);
  font-weight:700;
}

.header-right-zone{
  display:flex;
  align-items:center;
  gap:1.5rem;
}

.header-social-links{
  display:flex;
  align-items:center;
  gap:.9rem;
}

.social-icon{
  width:20px;
  height:20px;
  fill:var(--color-principal);
  transition:transform .2s ease, fill .2s ease;
  display:block;
}

.header-social-links a:hover .social-icon{
  fill:var(--color-acento);
  transform:scale(1.1);
}

.lang-selector{
  display:flex;
  align-items:center;
  gap:.35rem;
  font-size:.8rem;
  font-weight:600;
  color:#bbb;
}

.lang-selector a{
  color:#9d9895;
  text-decoration:none;
  text-underline-offset:3px;
}

.lang-selector a:hover,
.lang-selector a:focus-visible{
  color:var(--color-acento);
  text-decoration:underline;
}

.lang-selector a.active-lang{
  color:var(--color-principal);
  font-weight:800;
  text-decoration:none;
}

.lang-selector--mobile{
  display:none;
}

.menu-toggle{
  display:none;
}

@media (max-width:1150px){
  .header-social-links{
    display:none;
  }
}

@media (max-width:992px){
  .header-wrap{
    flex-wrap:wrap;
    gap:.75rem;
    padding:.85rem 1rem 1rem;
  }

  .logo-link{
    flex:1 1 100%;
    min-width:0;
    gap:.85rem;
  }

  .main-logo{
    height:78px;
  }

  .brand-sub{
    max-width:250px;
    font-size:.7rem;
    line-height:1.35;
  }

  .header-right-zone{
    display:none;
  }

  .menu-toggle{
    display:grid;
    flex:0 0 100%;
    grid-template-columns:minmax(0, 1fr) 1.25rem;
    align-items:center;
    gap:.75rem;
    width:100%;
    min-height:3.25rem;
    padding:.55rem .75rem;
    border:1px solid #ddd6d2;
    border-radius:6px;
    background:#fff;
    color:var(--color-principal);
    font:inherit;
    text-align:left;
    cursor:pointer;
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible{
    border-color:var(--color-principal);
    background:#f8f3f3;
  }

  .menu-toggle-copy{
    display:grid;
    gap:.1rem;
    min-width:0;
  }

  .menu-toggle-copy small{
    color:#6b6561;
    font-size:.68rem;
    font-weight:700;
    letter-spacing:.04em;
    text-transform:uppercase;
  }

  .menu-toggle-copy strong{
    overflow:hidden;
    font-size:.9rem;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .menu-toggle svg{
    justify-self:end;
    width:17px;
    height:17px;
    fill:none;
    stroke:currentColor;
    stroke-width:1.65;
    stroke-linecap:round;
    stroke-linejoin:round;
    transition:transform .2s ease;
  }

  .menu-toggle.is-open svg{
    transform:rotate(180deg);
  }

  .lang-selector--mobile{
    display:flex;
    flex:0 0 100%;
    justify-content:flex-end;
    padding:0 .2rem;
  }

  .nav-menu{
    position:static;
    display:none;
    flex:0 0 100%;
    width:100%;
    height:auto;
    grid-template-columns:1fr;
    gap:.15rem;
    padding:.05rem 0 0;
    background:transparent;
    box-shadow:none;
  }

  .nav-menu.is-open{
    display:grid;
  }

  .nav-menu a{
    display:flex;
    align-items:center;
    min-height:44px;
    margin:0;
    padding:.68rem .8rem;
    border-radius:4px;
    font-size:.88rem;
  }

  .nav-menu a:hover,
  .nav-menu a:focus-visible,
  .nav-menu a.active-link{
    background:#f2ecec;
    color:var(--color-principal);
  }
}

@media (max-width:430px){
  .brand-sub{
    display:none;
  }
}
</style>