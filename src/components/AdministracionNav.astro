---
const { active = '' } = Astro.props;

const items = [
  { id: 'persoas', label: 'Persoas', path: '/portal/administracion/persoas/' },
  { id: 'estado', label: 'Estado do sistema', path: '/portal/administracion/estado/' }
];
---

<nav class="admin-nav" aria-label="Administración">
  {items.map((item) => (
    <a
      href={item.path}
      class:list={['admin-nav-link', { 'is-active': active === item.id }]}
      aria-current={active === item.id ? 'page' : undefined}
    >
      {item.label}
    </a>
  ))}
</nav>

<style>
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin: 0 0 1.25rem;
  }

  .admin-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding: .55rem .9rem;
    border: 1px solid rgba(93, 20, 43, .2);
    border-radius: 999px;
    background: #fff;
    color: #3b2028;
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color .15s ease, background .15s ease;
  }

  .admin-nav-link:hover {
    border-color: rgba(93, 20, 43, .5);
  }

  .admin-nav-link.is-active {
    background: #5d142b;
    border-color: #5d142b;
    color: #fff;
  }
</style>
