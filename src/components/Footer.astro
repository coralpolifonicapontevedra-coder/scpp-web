---
/* src/components/Footer.astro */
const { lang = 'gl' } = Astro.props;
const year = new Date().getFullYear();
const brandName = lang === 'es' ? 'Sociedad Coral Polifónica de Pontevedra' : 'Sociedade Coral Polifónica de Pontevedra';
const contactInfo = {
  gl:{direccion:'Enderezo da Sede',telefono:'Teléfono',email:'Email',enlaces:'Ligazóns',redes:'Redes Sociais',registry:'Rexistro de Asociacións: 1966/72-1',tagline:'Fundada en 1925. Cen anos de polifonía e patrimonio cultural en Galicia.',copyright:'Todos os dereitos reservados.',links:[['Inicio','/'],['A Coral','/acoral'],['Axenda','/axenda'],['Colabora','/colabora'],['Área privada','/portal']],legalLinks:[['Privacidade','/privacidade/'],['Aviso legal','/aviso-legal/'],['Cookies','/cookies/']]},
  es:{direccion:'Dirección de la Sede',telefono:'Teléfono',email:'Correo',enlaces:'Enlaces',redes:'Redes Sociales',registry:'Registro de Asociaciones: 1966/72-1',tagline:'Fundada en 1925. Cien años de polifonía y patrimonio cultural en Galicia.',copyright:'Todos los derechos reservados.',links:[['Inicio','/es/'],['La Coral','/es/la-coral'],['Agenda','/es/agenda'],['Colabora','/es/colabora'],['Área privada','/portal']],legalLinks:[['Privacidad','/es/privacidad'],['Aviso legal','/es/aviso-legal'],['Cookies','/es/cookies']]}
};
const texts=contactInfo[lang]||contactInfo.gl;
---
<footer class="site-footer"><div class="container footer-wrapper"><div class="footer-brand"><p class="brand-name">{brandName}</p><p class="legal-id">NIF: G-36011286</p><p class="legal-id">{texts.registry}</p><p class="tagline">{texts.tagline}</p></div><div class="footer-sections"><div class="footer-section"><h4>{texts.direccion}</h4><p>Rúa Luís Braille 40</p><p>36003 Pontevedra</p><p style="margin-top: 0.8rem;"><strong>{texts.telefono}:</strong> <a href="tel:+34681254688">681 254 688</a></p><p><strong>{texts.email}:</strong> <a href="mailto:secretaria@coralpolifonicapontevedra.org">secretaria@coralpolifonicapontevedra.org</a></p></div><div class="footer-section"><h4>{texts.enlaces}</h4><ul>{texts.links.map(([name,url])=><li><a href={url}>{name}</a></li>)}</ul></div><div class="footer-section"><h4>{texts.redes}</h4><div class="social-footer"><a href="https://www.facebook.com/PolifonicaPontevedra/" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook"><svg viewBox="0 0 24 24" class="social-icon-footer"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/></svg></a><a href="https://www.instagram.com/polifonicapontevedra/" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram"><svg viewBox="0 0 24 24" class="social-icon-footer"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg></a><a href="https://www.youtube.com/@coralpolifonicadepontevedr4676" target="_blank" rel="noopener noreferrer" title="YouTube" aria-label="YouTube"><svg viewBox="0 0 24 24" class="social-icon-footer"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a></div></div></div></div><div class="footer-bottom"><p>&copy; {year} {brandName}. {texts.copyright}</p><div class="footer-legal">{texts.legalLinks.map(([name,url],index)=><>{index>0&&<span aria-hidden="true"> | </span>}<a href={url}>{name}</a></>)}</div></div></footer>
<script is:inline>
(() => {
 const path=window.location.pathname;
 const homeDonationTarget=path==='/'?'/donar/':(/^\/es\/?$/.test(path)?'/es/donar/':null);
 if(homeDonationTarget){const link=Array.from(document.querySelectorAll('.home-actions a')).find(a=>['/colabora','/es/colabora'].includes(a.getAttribute('href')));if(link)link.setAttribute('href',homeDonationTarget)}
 if(/^\/es\/historia\/?$/.test(path)){
  const panel=document.querySelector('#panel-castelao');
  if(panel){
   const heading=panel.querySelector('.castelao-heading > p:last-child'); if(heading) heading.textContent='Castelao no fue solo uno de los fundadores de la Sociedad Coral Polifónica, cantor bajo y presidente entre 1929 y 1932. Su colaboración con la Coral dio lugar a una de las aportaciones más singulares de nuestra historia: una escenografía concebida para hacer visible la música.';
   const san=panel.querySelector('.castelao-san-david-block .castelao-hero-copy'); if(san) san.innerHTML='<p class="section-kicker">1926 · Telón de boca</p><h3 id="san-david-title-es">San David</h3><p>El rey David músico preside una de las imágenes más reconocibles de la historia de la Polifónica. Castelao lo concibió como telón de boca para el primer gran concierto civil de la Sociedad, celebrado en el Teatro Principal de Pontevedra el 23 de marzo de 1926.</p><p>Su fuerza no reside solo en la dimensión monumental. San David resume una idea nueva para aquel momento: que la arquitectura, el color, la pintura y la música pudieran formar parte de una misma experiencia artística.</p><span class="pano-caption">Archivo SCPP</span>';
   const oldV=panel.querySelector('.castelao-vignettes'); if(oldV){oldV.className='castelao-timeline';oldV.innerHTML='<div class="pano-section-title"><p class="section-kicker">De la idea al escenario</p><h3>Una historia en cuatro momentos</h3></div><div class="castelao-vinetas"><article><span>1921</span><h4>París y el teatro de arte</h4><p>Castelao conoce nuevas fórmulas escénicas, entre ellas los coros ucranianos y el Teatro del Murciélago de Nikita Balieff. La idea de un espectáculo en el que todas las artes dialogan quedará en su memoria.</p></article><article><span>1925</span><h4>Fundador y cantor bajo</h4><p>Participa en la fundación de la Sociedad Coral Polifónica y se integra en la propia vida musical de la entidad. Su relación con la Coral es personal, artística e institucional.</p></article><article><span>1926</span><h4>El escenario se transforma</h4><p>Para el concierto del 23 de marzo crea San David, Sala de los Quiquiriquís, Pórtico románico, Rosetón ojival y Alcoba. Las grandes dimensiones obligan a trabajar en la Casa da Luz.</p></article><article><span>1934</span><h4>Capilla ojival</h4><p>Con la última escenografía conocida para la Polifónica se cierra un ciclo de casi una década en el que Castelao convierte el escenario coral en una obra plástica total.</p></article></div>'}
   const ros=panel.querySelector('.castelao-roseton-block .castelao-hero-copy'); if(ros) ros.innerHTML='<p class="section-kicker">1926 · Arquitectura y música</p><h3 id="roseton-title-es">Rosetón ojival</h3><p>El gran rosetón convierte el fondo del escenario en una arquitectura imaginada. La escena deja de funcionar como decoración neutra y crea un espacio visual capaz de acompañar el carácter del repertorio interpretado por la Coral.</p><p>Es una de las obras que mejor explica la modernidad de la propuesta de Castelao: pocos elementos, una composición monumental y una imagen inmediatamente reconocible que continúa formando parte de la memoria visual de la Sociedad.</p><span class="pano-caption">Archivo SCPP</span>';
   const counts=panel.querySelector('.castelao-counts'); if(counts&&!panel.querySelector('.castelao-legado')) counts.insertAdjacentHTML('afterend','<section class="castelao-legado"><div class="pano-section-title"><p class="section-kicker">Su legado</p><h3>Mucho más que unos decorados</h3><p>Los paños forman parte de una manera de entender la Polifónica en la que música, cultura gallega y creación plástica avanzan juntas.</p></div><div class="castelao-vinetas castelao-legado-grid"><article><span>01</span><h4>Una identidad propia</h4><p>La escenografía distinguió los conciertos de la Polifónica desde sus primeros años y contribuyó a crear una personalidad reconocible dentro y fuera de Galicia.</p></article><article><span>02</span><h4>La música hecha imagen</h4><p>Castelao no concibió estos fondos como ornamentación. Cada paño participa de la atmósfera de la obra interpretada y amplía su significado sobre el escenario.</p></article><article><span>03</span><h4>Patrimonio de la Sociedad</h4><p>El Museo de Pontevedra conserva ocho escenografías en depósito de la Sociedad Coral Polifónica, un conjunto excepcional por su dimensión y por su historia.</p></article><article><span>04</span><h4>Memoria viva</h4><p>Su conservación, estudio y difusión permiten que la relación entre Castelao y la Polifónica siga formando parte del relato cultural de Pontevedra.</p></article></div></section>');
   const cons=panel.querySelector('.castelao-conservation'); if(cons){const k=cons.querySelector('.section-kicker');if(k)k.textContent='Conservación';const h=cons.querySelector('h3');if(h)h.textContent='Un patrimonio monumental y frágil';const p=cons.querySelector('p:not(.section-kicker)');if(p)p.textContent='Las grandes dimensiones y la propia naturaleza de los materiales hacen especialmente compleja su conservación y exposición permanente. En la muestra del centenario de 2025 el Museo de Pontevedra recurrió a reproducciones a escala de varias piezas para acercar este patrimonio al público sin comprometer los originales.'}
   const video=panel.querySelector('.castelao-video-block'); if(video&&!panel.querySelector('.castelao-quote')) video.insertAdjacentHTML('beforebegin','<blockquote class="archive-quote castelao-quote"><p>Con Castelao, la Polifónica no solo cantaba ante un escenario: construía un espacio artístico en el que la música y la imagen hablaban un mismo lenguaje.</p></blockquote>');
   const vp=panel.querySelector('.castelao-video-copy p:last-child');if(vp)vp.textContent='El Museo de Pontevedra dedica en este vídeo una explicación específica a las escenografías creadas por Castelao para la Sociedad Coral Polifónica: su origen, su uso en los conciertos y los trabajos de conservación realizados a lo largo del tiempo.';
  }
 }
 if(!/^\/historia\/?$/.test(path))return;
 const activate=()=>{const id=window.location.hash.replace(/^#/,'');if(!id)return;const tab=document.querySelector(`.archive-tab[data-tab="${CSS.escape(id)}"]`),panel=document.querySelector(`#panel-${CSS.escape(id)}`);if(!(tab instanceof HTMLElement)||!(panel instanceof HTMLElement))return;tab.click();requestAnimationFrame(()=>panel.scrollIntoView({block:'start'}))};
 const sync=()=>document.querySelectorAll('.archive-tab[data-tab]').forEach(tab=>tab.addEventListener('click',()=>{const id=tab.getAttribute('data-tab');if(id&&window.location.hash!==`#${id}`)history.replaceState(null,'',`#${id}`)}));window.addEventListener('load',()=>{sync();activate()},{once:true});window.addEventListener('hashchange',activate);
})();
</script>
<style>
.site-footer{background-color:var(--color-principal);color:var(--color-blanco);padding:4rem 2rem 2rem;margin-top:6rem}.footer-wrapper{display:grid;grid-template-columns:1fr 2fr;gap:4rem;margin-bottom:3rem}.footer-brand{display:flex;flex-direction:column}.brand-name,.legal-id,.tagline{font-size:.9rem;line-height:1.6}.brand-name{margin:0 0 .35rem;color:var(--color-blanco);font-weight:700}.legal-id{margin:0;opacity:.85}.tagline{margin-top:1rem;opacity:.85}.footer-sections{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.footer-section h4{font-size:.95rem;text-transform:uppercase;letter-spacing:.05em;color:var(--color-acento);margin-bottom:1rem;font-weight:700}.footer-section p{font-size:.85rem;opacity:.8;margin-bottom:.5rem;line-height:1.5}.footer-section a{color:var(--color-blanco);text-decoration:none;opacity:.8}.footer-section ul{list-style:none;padding:0}.footer-section li{margin-bottom:.5rem}.social-footer{display:flex;gap:1rem}.social-footer a{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;background:rgba(255,255,255,.1);border-radius:4px}.social-icon-footer{width:20px;height:20px;fill:var(--color-blanco)}.footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:2rem;text-align:center}.footer-bottom p{font-size:.8rem;opacity:.6;margin-bottom:1rem}.footer-legal{font-size:.75rem;opacity:.5}.footer-legal a{color:var(--color-blanco);text-decoration:none;margin:0 .5rem}:global(.castelao-san-david-block){display:block!important;overflow:auto}:global(.castelao-san-david-block .castelao-hero-image){float:left!important;width:min(60%,590px)!important;aspect-ratio:1083/720!important;margin:0 clamp(1.4rem,3vw,2.4rem) 1rem 0!important}:global(.castelao-san-david-block .castelao-hero-copy){padding:clamp(.4rem,1.2vw,1rem) 0 0!important}:global(.castelao-timeline),:global(.castelao-legado){margin:2.5rem 0}:global(.castelao-vinetas){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line)}:global(.castelao-vinetas article){padding:1.6rem;background:#f7f4ef}:global(.castelao-vinetas span){color:var(--gold);font-weight:800}:global(.castelao-vinetas h4){color:var(--wine);font-size:1.08rem;margin:.55rem 0}:global(.castelao-vinetas p),:global(.castelao-quote p){color:#4c4744;line-height:1.65}:global(.castelao-quote){margin:2.5rem 0;padding:1.4rem 1.8rem;border-left:4px solid var(--gold);background:#f7f4ef}
@media(max-width:992px){.footer-wrapper{grid-template-columns:1fr}.footer-sections{grid-template-columns:1fr}}@media(max-width:700px){:global(.castelao-san-david-block .castelao-hero-image){float:none!important;width:100%!important;margin:0 0 1.35rem!important}:global(.castelao-san-david-block .castelao-hero-copy){padding:0 1.35rem 1.35rem!important}:global(.castelao-vinetas){grid-template-columns:1fr}}@media(max-width:576px){.brand-name,.legal-id,.tagline{font-size:.8rem}.social-footer a{width:36px;height:36px}.social-icon-footer{width:18px;height:18px}}
</style>