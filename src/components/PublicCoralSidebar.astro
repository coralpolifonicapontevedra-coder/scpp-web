---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { label: 'A Coral', href: '/acoral' },
  { label: 'Historia', href: '/historia' },
  { label: 'Centenario', href: '/centenario' },
  { label: 'Directora', href: '/directora' },
  { label: 'Xunta Directiva', href: '/xunta-directiva' },
  { label: 'Coralistas', href: '/coralistas' },
  { label: 'Distincións', href: '/distincions' },
  { label: 'Colaboracións', href: '/acoral#colaboracions' },
  { label: 'Solicitar un concerto', href: '/acoral#contratacion' }
];

const isActive = (href) => {
  const path = href.split('#')[0].replace(/\/$/, '') || '/';
  return !href.includes('#') && currentPath === path;
};
---

<aside class="public-coral-sidebar" aria-label="Seccións de A Coral">
  <button
    class="public-coral-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="public-coral-navigation"
  >
    <span><small>Menú auxiliar</small><strong>Seccións de A Coral</strong></span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>

  <nav id="public-coral-navigation" class="public-coral-navigation">
    <p>A Coral</p>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} class:list={[isActive(link.href) && 'is-active']}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.public-coral-sidebar').forEach((sidebar) => {
    const toggle = sidebar.querySelector<HTMLButtonElement>('.public-coral-toggle');
    const navigation = sidebar.querySelector<HTMLElement>('.public-coral-navigation');
    if (!toggle || !navigation) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('is-open', open);
      navigation.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    navigation.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  });
</script>

<style>
  .public-coral-sidebar {
    position: relative;
    min-width: 0;
  }

  .public-coral-toggle {
    display: none;
  }

  .public-coral-navigation {
    position: sticky;
    top: 175px;
    padding: 2rem 1.55rem;
    border: 1px solid #e7e0da;
    border-radius: 4px;
    background: #f7f4ef;
  }

  .public-coral-navigation p {
    margin: 0 0 1rem;
    color: var(--color-principal);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .public-coral-navigation ul {
    display: grid;
    gap: .15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .public-coral-navigation a {
    display: block;
    padding: .58rem .65rem;
    border-radius: 4px;
    color: #514b47;
    font-size: .9rem;
    line-height: 1.35;
    text-decoration: none;
    transition: background .18s ease, color .18s ease, transform .18s ease;
  }

  .public-coral-navigation a:hover,
  .public-coral-navigation a:focus-visible,
  .public-coral-navigation a.is-active {
    background: #eee6e5;
    color: var(--color-principal);
    transform: translateX(3px);
  }

  .public-coral-navigation a.is-active {
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .public-coral-toggle {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 1.2rem;
      align-items: center;
      gap: .75rem;
      width: 100%;
      min-height: 3.25rem;
      padding: .55rem .75rem;
      border: 1px solid #ddd6d2;
      border-radius: 6px;
      background: #fff;
      color: var(--color-principal);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .public-coral-toggle span {
      display: grid;
      gap: .08rem;
    }

    .public-coral-toggle small {
      color: #6b6561;
      font-size: .67rem;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .public-coral-toggle strong {
      font-size: .9rem;
    }

    .public-coral-toggle svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.65;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform .2s ease;
    }

    .public-coral-toggle.is-open svg {
      transform: rotate(180deg);
    }

    .public-coral-navigation {
      position: static;
      display: none;
      margin-top: .5rem;
      padding: .4rem;
      background: #fff;
    }

    .public-coral-navigation.is-open {
      display: block;
    }

    .public-coral-navigation p {
      display: none;
    }

    .public-coral-navigation a {
      min-height: 44px;
      padding: .7rem .8rem;
    }
  }
</style>
