---
/* Menú institucional común da parte pública. */
const { currentPath = '/' } = Astro.props;

const rutaActual = String(currentPath || '/').replace(/\/$/, '') || '/';
const ePortada = rutaActual === '/';
const seccions = [
  { nome: 'A Coral', url: '/acoral', rutas: ['/acoral'] },
  { nome: 'Historia', url: '/historia', rutas: ['/historia'] },
  { nome: 'Centenario', url: '/centenario', rutas: ['/centenario'] },
  { nome: 'Directora', url: '/directora', rutas: ['/directora'] },
  { nome: 'Xunta Directiva', url: '/xunta-directiva', rutas: ['/xunta-directiva'] },
  { nome: 'Coralistas', url: '/coralistas', rutas: ['/coralistas'] },
  { nome: 'Distincións recibidas', url: '/distincions', rutas: ['/distincions'] },
  { nome: 'Honras concedidas', url: '/honras', rutas: ['/honras'] },
  { nome: 'Solicitar un concerto', url: '/contacto', rutas: ['/contacto'] }
];

const eActiva = (rutas = []) => rutas.some((ruta) =>
  rutaActual === ruta || rutaActual.startsWith(`${ruta}/`)
);
---

{!ePortada && (
  <aside
    class="public-coral-menu"
    aria-label="Menú de A Coral"
    data-current-path={rutaActual}
  >
    <button
      id="publicCoralMenuToggle"
      class="public-coral-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="publicCoralMenuNav"
      aria-label="Abrir o menú de A Coral"
    >
      <span>
        <small>Coñece a institución</small>
        <strong>A Coral</strong>
      </span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>

    <nav id="publicCoralMenuNav" class="public-coral-nav" aria-label="Seccións de A Coral">
      <header>
        <span>Sociedade Coral</span>
        <h2>A Coral</h2>
        <p>Historia, persoas e patrimonio dunha institución centenaria.</p>
      </header>

      <ul>
        {seccions.map((seccion) => (
          <li>
            <a
              href={seccion.url}
              class:list={[eActiva(seccion.rutas) && 'is-active']}
              aria-current={eActiva(seccion.rutas) ? 'page' : undefined}
            >
              <span>{seccion.nome}</span>
              <span class="menu-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  const menu = document.querySelector<HTMLElement>('.public-coral-menu');
  const toggle = document.querySelector<HTMLButtonElement>('#publicCoralMenuToggle');
  const nav = document.querySelector<HTMLElement>('#publicCoralMenuNav');
  const mobileQuery = window.matchMedia('(max-width: 1180px)');

  if (menu && toggle && nav) {
    menu.classList.add('is-enhanced');

    const setOpen = (open: boolean) => {
      toggle.classList.toggle('is-open', open);
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Pechar o menú de A Coral' : 'Abrir o menú de A Coral');
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    mobileQuery.addEventListener('change', (event) => {
      if (!event.matches) setOpen(false);
    });

    /* Mantense a ligazón ao centenario ao final de Distincións. */
    if (menu.dataset.currentPath === '/distincions') {
      const moveCentenaryButton = () => {
        const button = document.querySelector<HTMLElement>('.distincions-page .btn-centenario');
        const destination = document.querySelector<HTMLElement>('.distincions-page .documentation-note');
        if (button && destination) destination.append(button);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', moveCentenaryButton, { once: true });
      } else {
        moveCentenaryButton();
      }
    }

    /*
     * Historia · Presidencias.
     * Priorízanse fotografías xa autorizadas da SCPP/R2. Para os casos nos que
     * non existe unha imaxe propia identificada empréganse fontes abertas e
     * acreditadas de Wikimedia Commons, mantendo a atribución e a licenza.
     */
    if (menu.dataset.currentPath === '/historia') {
      const fotosPresidencias: Record<string, {
        src: string;
        alt: string;
        credito: string;
        fonte?: string;
      }> = {
        'Antón Losada Diéguez': {
          src: '/api/galeria-orixinal?ruta=fotos%2Forixinais%2F288c578f-7316-565a-b573-160a866fc0eb.jpg',
          alt: 'Retrato de Antón Losada Diéguez, primeiro presidente da Sociedade Coral Polifónica de Pontevedra',
          credito: 'Museo de Pontevedra · Arquivo da SCPP'
        },
        'Alfonso Daniel Rodríguez Castelao': {
          src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Castelao%20Vida%20Gallega%20442.png',
          alt: 'Retrato de Alfonso Daniel Rodríguez Castelao publicado en Vida Gallega en 1930',
          credito: 'Vida Gallega · Galiciana / Wikimedia Commons · dominio público',
          fonte: 'https://commons.wikimedia.org/wiki/File:Castelao_Vida_Gallega_442.png'
        },
        'José Blein Llinás': {
          src: '/api/galeria-orixinal?ruta=fotos%2Forixinais%2F991becc5-ce34-514b-b2d3-1bc1fe090377.jpg',
          alt: 'Retrato de José Blein Llinás na década de 1930',
          credito: 'Museo de Pontevedra · Arquivo da SCPP'
        },
        'Vicente Riestra Calderón': {
          src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Riestra%20Calder%C3%B3n%2C%20Enrique%20Peinador%2C%20Valle-Incl%C3%A1n%2C%20Ram%C3%B3n%20Cabanillas%20e%20Victoriano%20Garc%C3%ADa%20Mart%C3%AD.jpg',
          alt: 'Vicente Riestra Calderón nunha fotografía de grupo no Balneario de Mondariz, primeiro pola esquerda',
          credito: 'Wikimedia Commons · dominio público',
          fonte: 'https://commons.wikimedia.org/wiki/File:Riestra_Calder%C3%B3n,_Enrique_Peinador,_Valle-Incl%C3%A1n,_Ram%C3%B3n_Cabanillas_e_Victoriano_Garc%C3%ADa_Mart%C3%AD.jpg'
        },
        'Augusto García Sánchez': {
          src: '/api/galeria-orixinal?ruta=fotos%2Forixinais%2Fea4d64bf-dd2f-4f10-8fde-b855a8c2b04d.jpg',
          alt: 'A Sociedade Coral Polifónica de Pontevedra dirixida por Agustín Bertomeu en 1975, durante a presidencia de Augusto García Sánchez',
          credito: 'Arquivo SCPP · A Polifónica en 1975'
        },
        'José Fernando Filgueira Valverde': {
          src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Xos%C3%A9%20Filgueira%20Valverde%2C%201931.jpg',
          alt: 'Retrato de Xosé Filgueira Valverde en 1931',
          credito: 'Fundación Filgueira / Wikimedia Commons · dominio público',
          fonte: 'https://commons.wikimedia.org/wiki/File:Xos%C3%A9_Filgueira_Valverde,_1931.jpg'
        },
        'Xosé Carlos Valle Pérez': {
          src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Milagros%20Bar%C3%A1%20e%20Xos%C3%A9%20Carlos%20Valle%20P%C3%A9rez.jpg',
          alt: 'Milagros Bará e Xosé Carlos Valle Pérez nunha charla no Museo de Pontevedra en 2011',
          credito: 'Estevoaei / Wikimedia Commons · CC BY-SA 4.0',
          fonte: 'https://commons.wikimedia.org/wiki/File:Milagros_Bar%C3%A1_e_Xos%C3%A9_Carlos_Valle_P%C3%A9rez.jpg'
        },
        'José Raposeiras Correa': {
          src: '/api/galeria-orixinal?ruta=fotos%2Forixinais%2F1.jpg',
          alt: 'José Raposeiras Correa nunha recepción da Xunta Directiva da SCPP na Deputación de Pontevedra en 2026',
          credito: 'Prensa Deputación · Deputación Provincial de Pontevedra'
        }
      };

      const inserirFotosPresidencias = () => {
        document.querySelectorAll<HTMLElement>('.presidency-card').forEach((card) => {
          if (card.querySelector('.presidency-photo')) return;
          const titulo = card.querySelector('h3')?.textContent?.trim() || '';
          const foto = fotosPresidencias[titulo];
          if (!foto) return;

          const figure = document.createElement('figure');
          figure.className = 'presidency-photo';

          const image = document.createElement('img');
          image.src = foto.src;
          image.alt = foto.alt;
          image.loading = 'lazy';
          image.decoding = 'async';
          figure.append(image);

          const caption = document.createElement('figcaption');
          if (foto.fonte) {
            const link = document.createElement('a');
            link.href = foto.fonte;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.textContent = foto.credito;
            caption.append(link);
          } else {
            caption.textContent = foto.credito;
          }
          figure.append(caption);
          card.prepend(figure);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', inserirFotosPresidencias, { once: true });
      } else {
        inserirFotosPresidencias();
      }
    }
  }
</script>

<style>
  .public-coral-menu {
    min-width: 0;
    padding-top: 1.25rem;
  }

  .public-coral-toggle {
    display: none;
  }

  .public-coral-nav {
    position: sticky;
    top: 174px;
    overflow: hidden;
    border: 1px solid rgba(106, 27, 41, .12);
    border-radius: 5px;
    background: #f4f0e6;
    box-shadow: 0 9px 24px rgba(53, 35, 37, .045);
  }

  .public-coral-nav header {
    padding: 1.25rem 1.1rem 1rem;
    border-bottom: 1px solid rgba(106, 27, 41, .1);
    background: rgba(255, 255, 255, .5);
  }

  .public-coral-nav header span {
    display: block;
    margin-bottom: .2rem;
    color: #98722f;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .public-coral-nav h2 {
    margin: 0;
    color: var(--color-principal);
    font-size: 1.18rem;
    line-height: 1.2;
  }

  .public-coral-nav p {
    margin: .52rem 0 0;
    color: #625b56;
    font-size: .75rem;
    line-height: 1.5;
  }

  .public-coral-nav ul {
    display: grid;
    gap: .08rem;
    margin: 0;
    padding: .55rem;
    list-style: none;
  }

  .public-coral-nav a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .65rem;
    min-height: 2.45rem;
    padding: .5rem .58rem;
    border-radius: 3px;
    color: #48413d;
    font-size: .8rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transition: background .18s ease, color .18s ease;
  }

  .public-coral-nav a:hover,
  .public-coral-nav a.is-active {
    background: #fff;
    color: var(--color-principal);
  }

  .public-coral-nav a.is-active {
    font-weight: 800;
    box-shadow: inset 3px 0 0 var(--color-acento);
  }

  .menu-arrow {
    color: var(--color-acento);
    font-size: .92rem;
  }

  :global(.public-site-main .historia-page .presidency-card .presidency-photo) {
    margin: -.1rem -.1rem 1rem;
    overflow: hidden;
    border: 1px solid rgba(106, 27, 41, .1);
    border-radius: 4px;
    background: #f4f0e6;
  }

  :global(.public-site-main .historia-page .presidency-card .presidency-photo img) {
    display: block;
    width: 100%;
    height: clamp(190px, 20vw, 250px);
    object-fit: contain;
    object-position: center;
    background: #eee9df;
  }

  :global(.public-site-main .historia-page .presidency-card .presidency-photo figcaption) {
    margin: 0;
    padding: .48rem .58rem .52rem;
    border-top: 1px solid rgba(106, 27, 41, .08);
    color: #746b65;
    font-size: .64rem;
    line-height: 1.35;
  }

  :global(.public-site-main .historia-page .presidency-card .presidency-photo figcaption a) {
    color: #746b65;
    text-decoration: none;
  }

  :global(.public-site-main .historia-page .presidency-card .presidency-photo figcaption a:hover) {
    color: var(--color-principal);
    text-decoration: underline !important;
  }

  :global(.public-site-main .centenario-page .centenario-intro h2),
  :global(.public-site-main .centenario-page .closing-section h2),
  :global(.public-site-main .coralistas-page .directory-heading h2),
  :global(.public-site-main .distincions-page .intro-section h2),
  :global(.public-site-main .distincions-page .section-heading h2),
  :global(.public-site-main .distincions-page .documentation-note h2),
  :global(.public-site-main .honras-page .directory-heading h2) {
    font-size: clamp(1.55rem, 2.6vw, 2.2rem) !important;
    line-height: 1.15 !important;
    letter-spacing: -.02em !important;
  }

  :global(.public-site-main .coral-page-wrapper #colaboracions) {
    display: none !important;
  }

  @media (max-width: 1180px) {
    .public-coral-menu {
      width: 100%;
      padding: 1rem clamp(1rem, 3vw, 2rem) 0;
    }

    .public-coral-toggle {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 1.15rem;
      align-items: center;
      gap: .7rem;
      width: 100%;
      min-height: 3rem;
      padding: .5rem .7rem;
      border: 1px solid rgba(106, 27, 41, .18);
      border-radius: 5px;
      background: #f4f0e6;
      color: var(--color-principal);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .public-coral-toggle span,
    .public-coral-toggle small,
    .public-coral-toggle strong {
      display: block;
    }

    .public-coral-toggle small {
      margin-bottom: .03rem;
      color: #8a6a32;
      font-size: .59rem;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .public-coral-toggle strong {
      font-size: .87rem;
    }

    .public-coral-toggle svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      transition: transform .2s ease;
    }

    .public-coral-toggle.is-open svg {
      transform: rotate(180deg);
    }

    .public-coral-nav {
      position: static;
      margin-top: .42rem;
      box-shadow: none;
    }

    .public-coral-menu.is-enhanced .public-coral-nav:not(.is-open) {
      display: none;
    }

    .public-coral-nav header {
      display: none;
    }

    .public-coral-nav ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .public-coral-nav ul {
      grid-template-columns: 1fr;
    }

    :global(.public-site-main .historia-page .presidency-card .presidency-photo img) {
      height: min(72vw, 280px);
    }
  }
</style>