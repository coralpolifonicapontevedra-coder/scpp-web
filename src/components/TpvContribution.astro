---
interface Props { lang?: 'gl' | 'es' }
const { lang = 'gl' } = Astro.props;
const isGl = lang === 'gl';
---

<section id="colaboracion-economica" class="tpv-section" aria-labelledby="tpv-title">
  <div class="tpv-copy">
    <p class="tpv-kicker">{isGl ? 'Aportación segura' : 'Aportación segura'}</p>
    <h2 id="tpv-title">{isGl ? 'Fai unha colaboración económica' : 'Haz una colaboración económica'}</h2>
    <p>
      {isGl
        ? 'Escolle o importe e paga con Bizum ou cunha tarxeta de crédito ou débito. Continuarás na pasarela segura de Cecabank para completar a operación.'
        : 'Elige el importe y paga con Bizum o con una tarjeta de crédito o débito. Continuarás en la pasarela segura de Cecabank para completar la operación.'}
    </p>
    <div class="security-note">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5.1 3.4 9.8 8 11 4.6-1.2 8-5.9 8-11V5l-8-3Zm0 2.2L18 6.4V11c0 4-2.5 7.8-6 8.9C8.5 18.8 6 15 6 11V6.4l6-2.2Zm-1 4.3v3H8.5v2H11v2.5h2V13.5h2.5v-2H13v-3h-2Z"/></svg>
      <span>{isGl ? 'A Coral non recibe nin almacena os teus datos bancarios.' : 'La Coral no recibe ni almacena tus datos bancarios.'}</span>
    </div>
  </div>

  <form class="tpv-form" data-tpv-form data-locale={lang}>
    <fieldset>
      <legend>{isGl ? 'Importe da colaboración' : 'Importe de la colaboración'}</legend>
      <div class="amount-options" aria-label={isGl ? 'Importes rápidos' : 'Importes rápidos'}>
        {[20, 50, 100].map((amount) => (
          <button type="button" class="amount-option" data-amount={amount}>{amount} €</button>
        ))}
      </div>
      <label class="amount-custom">
        <span>{isGl ? 'Outro importe' : 'Otro importe'}</span>
        <span class="amount-input"><input type="number" name="amount" min="2" max="5000" step="0.01" inputmode="decimal" required /><b>€</b></span>
      </label>
    </fieldset>

    <fieldset>
      <legend>{isGl ? 'Forma de pago' : 'Forma de pago'}</legend>
      <div class="payment-methods">
        <label><input type="radio" name="method" value="bizum" required /><span><strong>Bizum</strong><small>{isGl ? 'Pago desde o móbil' : 'Pago desde el móvil'}</small></span></label>
        <label><input type="radio" name="method" value="card" required /><span><strong>{isGl ? 'Tarxeta' : 'Tarjeta'}</strong><small>{isGl ? 'Crédito ou débito' : 'Crédito o débito'}</small></span></label>
      </div>
    </fieldset>

    <div class="tpv-honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
    <button type="submit" class="tpv-submit">{isGl ? 'Continuar ao pago seguro' : 'Continuar al pago seguro'} <span aria-hidden="true">→</span></button>
    <p class="tpv-status" data-tpv-status aria-live="polite" hidden></p>
    <p class="tpv-legal">
      {isGl ? 'Ao continuar aceptas o tratamento técnico necesario para xestionar o pago, conforme á ' : 'Al continuar aceptas el tratamiento técnico necesario para gestionar el pago, conforme a la '}
      <a href={isGl ? '/privacidade/' : '/es/privacidad/'}>{isGl ? 'política de privacidade' : 'política de privacidad'}</a>.
    </p>
  </form>
</section>

<script src="/js/tpv-colabora.js" defer></script>

<style>
  .tpv-section{scroll-margin-top:130px;display:grid;grid-template-columns:minmax(250px,.85fr) minmax(0,1.15fr);gap:clamp(2rem,6vw,5rem);margin-top:clamp(4rem,9vw,7rem);padding:clamp(1.75rem,5vw,3rem);border-top:3px solid var(--color-principal);background:var(--color-gris)}
  .tpv-kicker{color:var(--color-principal);font-size:.82rem;font-weight:700;letter-spacing:.16em;margin:0 0 .85rem;text-transform:uppercase}.tpv-copy h2{color:var(--color-texto);font-size:clamp(1.55rem,3vw,2rem);line-height:1.18;margin:0}.tpv-copy>p:not(.tpv-kicker){color:#444;line-height:1.7;margin:1.2rem 0}.security-note{display:flex;gap:.7rem;align-items:flex-start;color:#31533d;font-size:.9rem;font-weight:600;line-height:1.45}.security-note svg{width:1.35rem;flex:0 0 auto;fill:currentColor}.tpv-form{display:flex;flex-direction:column;gap:1.35rem}.tpv-form fieldset{border:0;margin:0;padding:0}.tpv-form legend{color:var(--color-texto);font-size:.92rem;font-weight:700;margin-bottom:.7rem}.amount-options{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}.amount-option{border:1px solid rgba(106,27,41,.25);border-radius:5px;background:#fff;color:var(--color-principal);cursor:pointer;font:inherit;font-weight:700;padding:.85rem}.amount-option:hover,.amount-option.is-selected{border-color:var(--color-principal);background:var(--color-principal);color:#fff}.amount-custom{display:flex;flex-direction:column;gap:.45rem;margin-top:.75rem;color:var(--color-texto);font-size:.9rem;font-weight:600}.amount-input{display:grid;grid-template-columns:1fr auto;align-items:center;border:1px solid rgba(106,27,41,.25);border-radius:5px;background:#fff}.amount-input:focus-within{border-color:var(--color-principal);box-shadow:0 0 0 3px rgba(106,27,41,.08)}.amount-input input{min-width:0;border:0;background:transparent;color:var(--color-texto);font:inherit;font-size:1.08rem;padding:.85rem 1rem;outline:0}.amount-input b{padding-right:1rem}.payment-methods{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.payment-methods label{position:relative;cursor:pointer}.payment-methods input{position:absolute;opacity:0}.payment-methods span{display:flex;flex-direction:column;gap:.18rem;min-height:72px;border:1px solid rgba(106,27,41,.25);border-radius:5px;background:#fff;padding:1rem}.payment-methods input:checked+span{border-color:var(--color-principal);box-shadow:inset 0 0 0 2px var(--color-principal)}.payment-methods input:focus-visible+span{outline:3px solid rgba(106,27,41,.25);outline-offset:2px}.payment-methods small{color:#555}.tpv-submit{display:flex;justify-content:space-between;align-items:center;border:0;border-radius:4px;background:var(--color-principal);color:#fff;cursor:pointer;font:inherit;font-size:.82rem;font-weight:700;letter-spacing:.06em;padding:1rem 1.25rem;text-transform:uppercase}.tpv-submit:hover{background:var(--color-acento)}.tpv-submit:disabled{cursor:wait;opacity:.65}.tpv-status{margin:0;font-size:.9rem;line-height:1.45}.tpv-status[data-state="error"]{color:#8b1f2d}.tpv-status[data-state="loading"]{color:#444}.tpv-legal{color:#555;font-size:.78rem;line-height:1.5;margin:0}.tpv-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}@media(max-width:820px){.tpv-section{grid-template-columns:1fr}}@media(max-width:520px){.amount-options,.payment-methods{grid-template-columns:1fr}.amount-options{grid-template-columns:repeat(3,1fr)}}
</style>

