---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Revisión de datos persoais" lang="gl">
  <main class="review-public-main">
    <section class="review-shell">
      <span class="section-kicker">Sociedade Coral Polifónica de Pontevedra</span>
      <h1>Revisión de datos persoais</h1>
      <p class="intro">Comproba os datos que constan na ficha. Podes corrixir os campos persoais e confirmar a información ao rematar.</p>

      <section id="loading" class="state-box">Cargando a ficha…</section>
      <section id="error-state" class="state-box error-box" hidden><strong>Non foi posible abrir a revisión</strong><p id="error-message"></p></section>

      <form id="review-form" hidden>
        <section class="locked-card">
          <strong id="person-name">—</strong>
          <p id="person-internal"></p>
          <small>A voz, o tipo de socio, o cargo e a data de incorporación son datos administrativos e non se modifican desde esta ficha.</small>
        </section>

        <fieldset>
          <legend>Identificación</legend>
          <div class="form-grid">
            <label><span>Nome *</span><input id="f-nome" required /></label>
            <label><span>Primeiro apelido *</span><input id="f-primeiro" required /></label>
            <label><span>Segundo apelido</span><input id="f-segundo" /></label>
            <label><span>NIF</span><input id="f-nif" autocomplete="off" /></label>
            <label><span>Data de nacemento</span><input id="f-nacemento" type="date" /></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Contacto e domicilio</legend>
          <div class="form-grid">
            <label><span>Teléfono</span><input id="f-telefono" type="tel" /></label>
            <label><span>Correo electrónico</span><input id="f-correo" type="email" /></label>
            <label class="wide"><span>Enderezo</span><input id="f-enderezo" /></label>
            <label><span>Cidade</span><input id="f-cidade" /></label>
            <label><span>Código postal</span><input id="f-cp" inputmode="numeric" /></label>
            <label><span>Preferencia de comunicación</span><select id="f-comunicacion"><option value="">Sen indicar</option><option>Correo electrónico</option><option>WhatsApp</option><option>Teléfono</option></select></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Contacto de emerxencia</legend>
          <div class="form-grid">
            <label class="wide"><span>Persoa de contacto</span><input id="f-emerxencia" /></label>
            <label><span>Teléfono de emerxencia</span><input id="f-telefono-emerxencia" type="tel" /></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Privacidade</legend>
          <div class="form-grid">
            <label><span>Consentimento de fotografía</span><select id="f-consentimento"><option value="">Sen indicar</option><option>Non autorizo</option><option>Só uso interno</option><option>Uso interno e difusión pública</option></select></label>
            <label class="check-line"><input id="f-aniversario" type="checkbox" /><span>Permitir mostrar aniversario cando corresponda</span></label>
          </div>
        </fieldset>

        <div class="confirmation-box">
          <label class="check-line"><input id="confirm-check" type="checkbox" required /><span>Confirmo que revisei estes datos e que son correctos, coas modificacións que acabo de introducir.</span></label>
          <p>Esta proba de preview aínda non inclúe a aceptación legal nin a xeración do PDF; esa será a seguinte fase.</p>
        </div>

        <footer><span id="form-state"></span><button id="save-button" type="submit">Confirmar datos</button></footer>
      </form>

      <section id="success-state" class="success-box" hidden><h2>Datos confirmados</h2><p>Os cambios quedaron gardados correctamente. Esta ligazón xa non poderá volver utilizarse.</p></section>
    </section>
  </main>
</BaseLayout>

<script>
  const loading=document.querySelector('#loading');
  const errorState=document.querySelector('#error-state');
  const errorMessage=document.querySelector('#error-message');
  const form=document.querySelector('#review-form');
  const success=document.querySelector('#success-state');
  const personName=document.querySelector('#person-name');
  const personInternal=document.querySelector('#person-internal');
  const saveButton=document.querySelector('#save-button');
  const formState=document.querySelector('#form-state');
  const token=new URLSearchParams(location.search).get('token')||'';

  const q=(s)=>document.querySelector(s);
  const set=(id,value)=>{const n=q(id);if(n instanceof HTMLInputElement||n instanceof HTMLSelectElement)n.value=String(value??'');};
  const clean=(value)=>String(value??'').trim();
  function inputDate(value){const t=clean(value);const m=/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(t);if(m)return`${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;return /^\d{4}-\d{2}-\d{2}$/.test(t)?t:'';}

  async function request(method,body){
    const url=method==='GET'?`/api/persoas-revision?token=${encodeURIComponent(token)}`:'/api/persoas-revision';
    const response=await fetch(url,{method,headers:method==='POST'?{'Content-Type':'application/json'}:undefined,body:method==='POST'?JSON.stringify(body):undefined});
    const data=await response.json().catch(()=>null);
    if(!response.ok||!data?.ok) throw new Error(data?.erro||`Erro HTTP ${response.status}`);
    return data;
  }

  function showError(error){if(loading instanceof HTMLElement)loading.hidden=true;if(form instanceof HTMLFormElement)form.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Erro descoñecido';}

  function fill(p){
    if(personName instanceof HTMLElement) personName.textContent=p.nomeCompleto||[p.nome,p.primeiroApelido,p.segundoApelido].filter(Boolean).join(' ');
    if(personInternal instanceof HTMLElement) personInternal.textContent=[p.voz,p.tipoSocio,p.cargo,p.dataIncorporacion].filter(Boolean).join(' · ');
    set('#f-nome',p.nome);set('#f-primeiro',p.primeiroApelido);set('#f-segundo',p.segundoApelido);set('#f-nif',p.nif);set('#f-nacemento',inputDate(p.dataNacemento));set('#f-telefono',p.telefono);set('#f-correo',p.correo);set('#f-enderezo',p.enderezo);set('#f-cidade',p.cidade);set('#f-cp',p.cp);set('#f-comunicacion',p.preferenciaComunicacion);set('#f-emerxencia',p.contactoEmerxencia);set('#f-telefono-emerxencia',p.telefonoEmerxencia);set('#f-consentimento',p.consentimentoFoto);
    const aniversario=q('#f-aniversario');if(aniversario instanceof HTMLInputElement)aniversario.checked=p.mostrarAniversario===true;
  }

  function value(id){const n=q(id);return n instanceof HTMLInputElement||n instanceof HTMLSelectElement?n.value.trim():'';}
  function collect(){const aniversario=q('#f-aniversario');return{nome:value('#f-nome'),primeiroApelido:value('#f-primeiro'),segundoApelido:value('#f-segundo'),nif:value('#f-nif'),dataNacemento:value('#f-nacemento'),telefono:value('#f-telefono'),correo:value('#f-correo'),enderezo:value('#f-enderezo'),cidade:value('#f-cidade'),cp:value('#f-cp'),preferenciaComunicacion:value('#f-comunicacion'),contactoEmerxencia:value('#f-emerxencia'),telefonoEmerxencia:value('#f-telefono-emerxencia'),consentimentoFoto:value('#f-consentimento'),mostrarAniversario:aniversario instanceof HTMLInputElement&&aniversario.checked};}

  async function load(){if(!token){showError(new Error('A ligazón de revisión non é válida.'));return;}try{const data=await request('GET');fill(data.persoa||{});if(loading instanceof HTMLElement)loading.hidden=true;if(form instanceof HTMLFormElement)form.hidden=false;}catch(error){showError(error);}}

  form?.addEventListener('submit',async(event)=>{event.preventDefault();if(!(saveButton instanceof HTMLButtonElement))return;const old=saveButton.textContent;saveButton.disabled=true;saveButton.textContent='Gardando…';if(formState instanceof HTMLElement)formState.textContent='';try{const data=await request('POST',{accion:'gardarRevision',token,persoa:collect()});if(form instanceof HTMLFormElement)form.hidden=true;if(success instanceof HTMLElement)success.hidden=false;}catch(error){if(formState instanceof HTMLElement)formState.textContent=error instanceof Error?error.message:'Non foi posible gardar os datos.';saveButton.disabled=false;saveButton.textContent=old||'Confirmar datos';}});
  load();
</script>

<style is:global>
  body{background:#f5f3f1}.review-public-main{min-height:100vh;padding:clamp(1rem,4vw,3rem);font-family:var(--fuente-minimalista)}.review-shell{max-width:920px;margin:0 auto;padding:clamp(1.2rem,3vw,2.2rem);border:1px solid #d9d2cc;background:#fff}.section-kicker{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--color-acento)}h1{margin:.25rem 0 .6rem;color:var(--color-principal);font-size:clamp(2rem,5vw,3.5rem)}.intro{margin:0 0 1.4rem;color:#625c58}.state-box,.locked-card,.confirmation-box,.success-box{padding:1rem 1.1rem;border:1px solid #ded8d3;background:#faf9f7}.error-box{border-color:#b98b91}.locked-card{display:grid;gap:.3rem;margin-bottom:1rem}.locked-card p,.locked-card small{margin:0;color:#665f5a}.locked-card strong{font-size:1.2rem;color:var(--color-principal)}fieldset{margin:0;padding:0;border:0;border-top:1px solid #e5dfda}legend{padding:1.2rem 0 .2rem;color:var(--color-principal);font-weight:800}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem 1rem;padding:.8rem 0 1.2rem}.form-grid label{display:grid;gap:.35rem}.form-grid label>span{font-size:.75rem;font-weight:800;text-transform:uppercase}.wide{grid-column:1/-1}input,select{width:100%;min-height:2.8rem;padding:.6rem .75rem;border:1px solid #cfc8c2;background:#fff;font:inherit}.check-line{display:grid!important;grid-template-columns:auto 1fr!important;align-items:center;gap:.65rem!important}.check-line input{width:1rem;min-height:auto}.confirmation-box{margin-top:1rem}.confirmation-box p{margin:.7rem 0 0;color:#716963;font-size:.87rem}footer{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding-top:1.1rem}footer span{color:#7b3440}button{min-height:2.8rem;padding:.65rem 1.1rem;border:1px solid var(--color-principal);background:var(--color-principal);color:#fff;font:inherit;font-weight:800;cursor:pointer}.success-box h2{margin:.1rem 0 .5rem;color:var(--color-principal)}.success-box p{margin:0}@media(max-width:680px){.form-grid{grid-template-columns:1fr}.wide{grid-column:auto}footer{display:grid}}
</style>
