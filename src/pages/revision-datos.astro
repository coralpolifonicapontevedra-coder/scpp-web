---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Revisión de datos persoais" lang="gl">
  <main class="review-public-main">
    <section class="review-shell">
      <span class="section-kicker">Sociedade Coral Polifónica de Pontevedra</span>
      <h1>Revisión de datos persoais</h1>
      <p class="intro">Comproba os datos que constan na túa ficha. Podes corrixir os campos persoais e confirmar a información ao rematar.</p>

      <section id="loading" class="state-box">Cargando a ficha…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir a revisión</strong>
        <p id="error-message"></p>
      </section>

      <form id="review-form" hidden>
        <section class="locked-card">
          <strong id="person-name">—</strong>
          <p id="person-internal"></p>
          <small>A voz, o tipo de socio, o cargo e a data de incorporación son datos administrativos e non se modifican desde esta ficha.</small>
        </section>

        <fieldset>
          <legend>Identificación</legend>
          <div class="form-grid">
            <label><span>Nome *</span><input id="f-nome" required /></label>
            <label><span>Primeiro apelido *</span><input id="f-primeiro" required /></label>
            <label><span>Segundo apelido</span><input id="f-segundo" /></label>
            <label><span>NIF</span><input id="f-nif" autocomplete="off" /></label>
            <label><span>Data de nacemento</span><input id="f-nacemento" type="date" /></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Contacto e domicilio</legend>
          <div class="form-grid">
            <label><span>Teléfono</span><input id="f-telefono" type="tel" /></label>
            <label><span>Correo electrónico</span><input id="f-correo" type="email" /></label>
            <label class="wide"><span>Enderezo</span><input id="f-enderezo" /></label>
            <label><span>Cidade</span><input id="f-cidade" /></label>
            <label><span>Código postal</span><input id="f-cp" inputmode="numeric" maxlength="5" /></label>
            <label><span>Preferencia de comunicación</span><input id="f-comunicacion" /></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Contacto de emerxencia</legend>
          <div class="form-grid">
            <label class="wide"><span>Persoa de contacto</span><input id="f-emerxencia" /></label>
            <label><span>Teléfono de emerxencia</span><input id="f-telefono-emerxencia" type="tel" /></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Privacidade e presenza pública</legend>
          <div class="form-grid">
            <label>
              <span>Consentimento de fotografía</span>
              <select id="f-consentimento">
                <option value="">Sen indicar</option>
                <option value="Si">Si</option>
                <option value="Non">Non</option>
              </select>
            </label>
            <label class="check-line"><input id="f-aniversario" type="checkbox" /><span>Permitir mostrar o aniversario cando corresponda</span></label>
          </div>
          <p class="privacy-note">O consentimento para fotografías é independente da aceptación do tratamento dos datos da ficha.</p>
        </fieldset>

        <section class="legal-card" aria-labelledby="legal-title">
          <header>
            <span class="section-kicker">Protección de datos</span>
            <h2 id="legal-title">Texto legal</h2>
            <p id="legal-version"></p>
          </header>
          <div id="legal-text" class="legal-text"></div>
        </section>

        <div class="confirmation-box">
          <label class="check-line confirmation-line">
            <input id="confirm-check" type="checkbox" required />
            <span>Confirmo que revisei os datos desta ficha e que son correctos, coas modificacións que acabo de introducir.</span>
          </label>
          <label class="check-line confirmation-line">
            <input id="legal-check" type="checkbox" required />
            <span>Lin e comprendín o texto legal anterior e acepto o tratamento dos meus datos persoais para a xestión da miña relación coa Sociedade Coral Polifónica de Pontevedra e para o cumprimento dos fins propios da entidade.</span>
          </label>
          <p>Ao confirmar, a aceptación quedará rexistrada e xerarase un PDF individual como evidencia, asociado á versión exacta do texto legal mostrado nesta páxina.</p>
        </div>

        <footer><span id="form-state"></span><button id="save-button" type="submit">Confirmar datos e aceptación</button></footer>
      </form>

      <section id="success-state" class="success-box" hidden>
        <h2>Datos e aceptación rexistrados</h2>
        <p>Os cambios quedaron gardados e xerouse o documento individual de aceptación. Esta ligazón xa non poderá volver utilizarse.</p>
      </section>
    </section>
  </main>
</BaseLayout>

<script>
  const loading=document.querySelector('#loading');
  const errorState=document.querySelector('#error-state');
  const errorMessage=document.querySelector('#error-message');
  const form=document.querySelector('#review-form');
  const success=document.querySelector('#success-state');
  const personName=document.querySelector('#person-name');
  const personInternal=document.querySelector('#person-internal');
  const saveButton=document.querySelector('#save-button');
  const formState=document.querySelector('#form-state');
  const legalTitle=document.querySelector('#legal-title');
  const legalVersion=document.querySelector('#legal-version');
  const legalText=document.querySelector('#legal-text');
  const token=new URLSearchParams(location.search).get('token')||'';

  const q=(s)=>document.querySelector(s);
  const set=(id,value)=>{const n=q(id);if(n instanceof HTMLInputElement||n instanceof HTMLSelectElement)n.value=String(value??'');};
  const clean=(value)=>String(value??'').trim();
  function inputDate(value){const t=clean(value);const m=/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(t);if(m)return`${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;return /^\d{4}-\d{2}-\d{2}$/.test(t)?t:'';}

  async function request(method,body){
    const url=method==='GET'?`/api/persoas-revision?token=${encodeURIComponent(token)}`:'/api/persoas-revision';
    const response=await fetch(url,{method,headers:method==='POST'?{'Content-Type':'application/json'}:undefined,body:method==='POST'?JSON.stringify(body):undefined});
    const data=await response.json().catch(()=>null);
    if(!response.ok||!data?.ok) throw new Error(data?.erro||`Erro HTTP ${response.status}`);
    return data;
  }

  function showError(error){if(loading instanceof HTMLElement)loading.hidden=true;if(form instanceof HTMLFormElement)form.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Erro descoñecido';}

  function fill(p){
    if(personName instanceof HTMLElement) personName.textContent=p.nomeCompleto||[p.nome,p.primeiroApelido,p.segundoApelido].filter(Boolean).join(' ');
    if(personInternal instanceof HTMLElement) personInternal.textContent=[p.voz,p.tipoSocio,p.cargo,p.dataIncorporacion].filter(Boolean).join(' · ');
    set('#f-nome',p.nome);set('#f-primeiro',p.primeiroApelido);set('#f-segundo',p.segundoApelido);set('#f-nif',p.nif);set('#f-nacemento',inputDate(p.dataNacemento));set('#f-telefono',p.telefono);set('#f-correo',p.correo);set('#f-enderezo',p.enderezo);set('#f-cidade',p.cidade);set('#f-cp',p.cp);set('#f-comunicacion',p.preferenciaComunicacion);set('#f-emerxencia',p.contactoEmerxencia);set('#f-telefono-emerxencia',p.telefonoEmerxencia);set('#f-consentimento',p.consentimentoFoto);
    const aniversario=q('#f-aniversario');if(aniversario instanceof HTMLInputElement)aniversario.checked=p.mostrarAniversario===true;
  }

  function fillLegal(legal){
    if(!legal||typeof legal!=='object')throw new Error('Non se recibiu o texto legal da revisión.');
    if(legalTitle instanceof HTMLElement)legalTitle.textContent=String(legal.titulo||'Texto legal');
    if(legalVersion instanceof HTMLElement)legalVersion.textContent=[legal.version?`Versión ${legal.version}`:'',legal.dataVixencia?`vixente desde ${legal.dataVixencia}`:'',legal.ambito||''].filter(Boolean).join(' · ');
    if(legalText instanceof HTMLElement)legalText.textContent=String(legal.texto||'');
  }

  function value(id){const n=q(id);return n instanceof HTMLInputElement||n instanceof HTMLSelectElement?n.value.trim():'';}
  function collect(){const aniversario=q('#f-aniversario');return{nome:value('#f-nome'),primeiroApelido:value('#f-primeiro'),segundoApelido:value('#f-segundo'),nif:value('#f-nif'),dataNacemento:value('#f-nacemento'),telefono:value('#f-telefono'),correo:value('#f-correo'),enderezo:value('#f-enderezo'),cidade:value('#f-cidade'),cp:value('#f-cp'),preferenciaComunicacion:value('#f-comunicacion'),contactoEmerxencia:value('#f-emerxencia'),telefonoEmerxencia:value('#f-telefono-emerxencia'),consentimentoFoto:value('#f-consentimento'),mostrarAniversario:aniversario instanceof HTMLInputElement&&aniversario.checked};}

  async function load(){if(!token){showError(new Error('A ligazón de revisión non é válida.'));return;}try{const data=await request('GET');fill(data.persoa||{});fillLegal(data.textoLegal);if(loading instanceof HTMLElement)loading.hidden=true;if(form instanceof HTMLFormElement)form.hidden=false;}catch(error){showError(error);}}

  form?.addEventListener('submit',async(event)=>{
    event.preventDefault();
    if(!(saveButton instanceof HTMLButtonElement))return;
    const confirmCheck=q('#confirm-check');
    const legalCheck=q('#legal-check');
    const confirmaDatos=confirmCheck instanceof HTMLInputElement&&confirmCheck.checked;
    const aceptaLegal=legalCheck instanceof HTMLInputElement&&legalCheck.checked;
    if(!confirmaDatos||!aceptaLegal){if(formState instanceof HTMLElement)formState.textContent='Debes confirmar os datos e aceptar o texto legal.';return;}
    const old=saveButton.textContent;
    saveButton.disabled=true;
    saveButton.textContent='Gardando e xerando PDF…';
    if(formState instanceof HTMLElement)formState.textContent='';
    try{
      await request('POST',{accion:'gardarRevision',token,persoa:collect(),confirmaDatos,aceptaLegal});
      if(form instanceof HTMLFormElement)form.hidden=true;
      if(success instanceof HTMLElement)success.hidden=false;
    }catch(error){
      if(formState instanceof HTMLElement)formState.textContent=error instanceof Error?error.message:'Non foi posible gardar os datos e a aceptación.';
      saveButton.disabled=false;
      saveButton.textContent=old||'Confirmar datos e aceptación';
    }
  });
  load();
</script>

<style is:global>
  body{background:#f5f3f1}.review-public-main{min-height:100vh;padding:clamp(1rem,4vw,3rem);font-family:var(--fuente-minimalista)}.review-shell{max-width:920px;margin:0 auto;padding:clamp(1.2rem,3vw,2.2rem);border:1px solid #d9d2cc;background:#fff}.section-kicker{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--color-acento)}h1{margin:.25rem 0 .6rem;color:var(--color-principal);font-size:clamp(2rem,5vw,3.5rem)}.intro{margin:0 0 1.4rem;color:#625c58}.state-box,.locked-card,.confirmation-box,.success-box,.legal-card{padding:1rem 1.1rem;border:1px solid #ded8d3;background:#faf9f7}.error-box{border-color:#b98b91}.locked-card{display:grid;gap:.3rem;margin-bottom:1rem}.locked-card p,.locked-card small{margin:0;color:#665f5a}.locked-card strong{font-size:1.2rem;color:var(--color-principal)}fieldset{margin:0;padding:0;border:0;border-top:1px solid #e5dfda}legend{padding:1.2rem 0 .2rem;color:var(--color-principal);font-weight:800}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem 1rem;padding:.8rem 0 1.2rem}.form-grid label{display:grid;gap:.35rem}.form-grid label>span{font-size:.75rem;font-weight:800;text-transform:uppercase}.wide{grid-column:1/-1}input,select{width:100%;min-height:2.8rem;padding:.6rem .75rem;border:1px solid #cfc8c2;background:#fff;font:inherit}.check-line{display:grid!important;grid-template-columns:auto 1fr!important;align-items:start;gap:.65rem!important}.check-line input{width:1rem;min-height:auto;margin-top:.2rem}.privacy-note{margin:-.5rem 0 1rem;color:#716963;font-size:.86rem}.legal-card{margin-top:1rem;background:#fff}.legal-card header{padding-bottom:.85rem;border-bottom:1px solid #e7e0da}.legal-card h2{margin:.2rem 0;color:var(--color-principal)}.legal-card header p{margin:0;color:#716963;font-size:.85rem}.legal-text{padding-top:1rem;white-space:pre-wrap;line-height:1.55;color:#413c39}.confirmation-box{display:grid;gap:1rem;margin-top:1rem}.confirmation-line{padding-bottom:1rem;border-bottom:1px solid #e3ddd8}.confirmation-box p{margin:0;color:#716963;font-size:.87rem}footer{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding-top:1.1rem}footer span{color:#7b3440}button{min-height:2.8rem;padding:.65rem 1.1rem;border:1px solid var(--color-principal);background:var(--color-principal);color:#fff;font:inherit;font-weight:800;cursor:pointer}.success-box h2{margin:.1rem 0 .5rem;color:var(--color-principal)}.success-box p{margin:0}@media(max-width:680px){.form-grid{grid-template-columns:1fr}.wide{grid-column:auto}footer{display:grid}}
</style>
