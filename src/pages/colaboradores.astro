---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout
  title="Entidades colaboradoras"
  lang="gl"
  description="Institucións, entidades e empresas colaboradoras da Sociedade Coral Polifónica de Pontevedra."
>
  <div class="container colaboradores-page">
    <section class="colaboradores-intro" aria-labelledby="colaboradores-intro-title">
      <p class="sobrelinea">Un apoio que fai posible a música</p>
      <h2 id="colaboradores-intro-title">Compromiso coa cultura e coa cidade</h2>
      <p>
        A continuidade dun proxecto cultural centenario tamén se constrúe coa
        colaboración das institucións, entidades e empresas que comparten o seu
        compromiso coa música, co patrimonio e coa vida cultural de Pontevedra.
      </p>
    </section>

    <section class="colaboradores-listado" aria-label="Relación de entidades colaboradoras">
      <div id="colaboradores-status" class="status" role="status" aria-live="polite">
        Cargando as entidades colaboradoras…
      </div>
      <div id="entidades-grid" class="entidades-grid" hidden></div>
      <div id="colaboradores-error-actions" class="error-actions" hidden>
        <button id="colaboradores-retry" type="button" class="retry-button">Tentar de novo</button>
      </div>
    </section>

    <aside class="colaboradores-peche">
      <div>
        <p class="sobrelinea">Suma o teu apoio</p>
        <h2>Colabora coa Sociedade</h2>
      </div>
      <div>
        <p>
          Se representas unha empresa ou entidade e queres apoiar un proxecto
          cultural centenario, estaremos encantados de coñecer a túa proposta.
        </p>
        <a href="/colabora/#form-colabora" class="btn-volver">
          Ver formas de colaboración <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const API_URL = '/api/colaboradores';
    const status = document.getElementById('colaboradores-status');
    const grid = document.getElementById('entidades-grid');
    const errorActions = document.getElementById('colaboradores-error-actions');
    const retry = document.getElementById('colaboradores-retry');

    const clean = (value) => String(value ?? '').trim();
    const safeWeb = (value) => {
      try {
        const url = new URL(clean(value));
        return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
      } catch {
        return '';
      }
    };
    const safeLogo = (value) => {
      const logo = clean(value);
      return logo.startsWith('/arquivos/publico/') || logo.startsWith('/img/colaboradores/') ? logo : '';
    };

    function setStatus(message, isError = false) {
      status.hidden = false;
      status.textContent = message;
      status.classList.toggle('status-error', isError);
    }

    function createCard(entidade, index) {
      const nome = clean(entidade?.nome);
      const web = safeWeb(entidade?.web);
      const logo = safeLogo(entidade?.logo);
      const fallback = safeLogo(entidade?.logoFallback);
      const tipo = clean(entidade?.tipoGl) || 'Entidade colaboradora';

      const card = document.createElement('article');
      card.className = 'entidade-card';

      const numero = document.createElement('span');
      numero.className = 'entidade-numero';
      numero.setAttribute('aria-hidden', 'true');
      numero.textContent = String(index + 1).padStart(2, '0');

      const logoWrap = document.createElement(web ? 'a' : 'span');
      logoWrap.className = 'entidade-logo-link';
      if (web) {
        logoWrap.href = web;
        logoWrap.target = '_blank';
        logoWrap.rel = 'noopener noreferrer';
        logoWrap.setAttribute('aria-label', `Visitar a web de ${nome} (abre nunha nova xanela)`);
      }

      const img = document.createElement('img');
      img.src = logo || fallback;
      img.alt = `Logotipo de ${nome}`;
      img.loading = 'lazy';
      img.decoding = 'async';
      if (fallback) {
        img.addEventListener('error', () => {
          if (!img.dataset.fallbackApplied) {
            img.dataset.fallbackApplied = '1';
            img.src = fallback;
          }
        });
      }
      logoWrap.appendChild(img);

      const info = document.createElement('div');
      info.className = 'entidade-info';
      const strong = document.createElement('strong');
      strong.textContent = nome;
      const small = document.createElement('small');
      small.textContent = tipo;
      info.append(strong, small);

      card.append(numero, logoWrap, info);
      return card;
    }

    function render(entidades) {
      const visibles = Array.isArray(entidades)
        ? entidades.filter((item) => clean(item?.nome) && (safeLogo(item?.logo) || safeLogo(item?.logoFallback)))
        : [];

      if (!visibles.length) {
        throw new Error('Non hai entidades colaboradoras dispoñibles neste momento.');
      }

      grid.replaceChildren(...visibles.map(createCard));
      grid.hidden = false;
      status.hidden = true;
      errorActions.hidden = true;
    }

    async function load() {
      grid.hidden = true;
      errorActions.hidden = true;
      setStatus('Cargando as entidades colaboradoras…');

      try {
        const response = await fetch(API_URL, { headers: { Accept: 'application/json' } });
        const data = await response.json().catch(() => null);
        if (!response.ok || data?.ok !== true || !Array.isArray(data?.entidades)) {
          throw new Error(clean(data?.erro) || 'Non foi posible cargar as entidades colaboradoras.');
        }
        render(data.entidades);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Non foi posible cargar as entidades colaboradoras.', true);
        errorActions.hidden = false;
      }
    }

    retry?.addEventListener('click', load);
    load();
  })();
</script>

<style is:global>
  .colaboradores-page { padding-bottom: 6rem; }
  .sobrelinea { margin: 0 0 .75rem; color: var(--color-principal); font-size: .76rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .colaboradores-intro { max-width: 760px; margin-bottom: clamp(2rem, 5vw, 3.25rem); }
  .colaboradores-intro h2, .colaboradores-peche h2 { margin: 0; color: var(--color-texto); font-size: clamp(1.55rem, 3vw, 2.15rem); line-height: 1.2; }
  .colaboradores-intro > p:last-child, .colaboradores-peche p { color: #4b4745; font-size: 1rem; line-height: 1.75; }
  .colaboradores-listado { min-height: 250px; }
  .status { padding: 1rem 1.1rem; border: 1px solid rgba(106, 27, 41, .12); border-radius: 4px; background: #fff; color: #625d5a; font-size: .92rem; }
  .status-error { border-color: rgba(106, 27, 41, .25); color: var(--color-principal); }
  .error-actions { margin-top: 1rem; }
  .retry-button { border: 1px solid var(--color-principal); border-radius: 4px; background: #fff; color: var(--color-principal); cursor: pointer; font: inherit; font-size: .78rem; font-weight: 700; letter-spacing: .05em; padding: .75rem 1rem; text-transform: uppercase; }
  .retry-button:hover, .retry-button:focus-visible { background: var(--color-principal); color: #fff; }
  .entidades-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .entidade-card { position: relative; display: grid; grid-template-rows: 170px auto; min-height: 245px; overflow: hidden; border: 1px solid rgba(106, 27, 41, .14); border-radius: 4px; background: #fff; color: var(--color-texto); }
  .entidade-numero { position: absolute; top: .85rem; left: 1rem; color: var(--color-acento); font-size: .66rem; font-weight: 800; letter-spacing: .12em; }
  .entidade-logo-link { display: flex; align-items: center; justify-content: center; min-width: 0; padding: 2.25rem 2.5rem 1.75rem; text-decoration: none; }
  a.entidade-logo-link { cursor: pointer; }
  a.entidade-logo-link:focus-visible { outline: 3px solid rgba(106, 27, 41, .18); outline-offset: -6px; border-radius: 4px; }
  .entidade-logo-link img { display: block; width: auto; height: auto; max-width: 250px; max-height: 78px; object-fit: contain; transition: transform .2s ease; }
  a.entidade-logo-link:hover img, a.entidade-logo-link:focus-visible img { transform: scale(1.025); }
  .entidade-info { padding: 1.05rem 1.25rem 1.15rem; border-top: 1px solid rgba(106, 27, 41, .1); background: var(--color-gris); }
  .entidade-info strong, .entidade-info small { display: block; }
  .entidade-info strong { color: var(--color-texto); font-size: 1rem; line-height: 1.3; }
  .entidade-info small { margin-top: .3rem; color: #625d5a; font-size: .78rem; }
  .colaboradores-peche { display: grid; grid-template-columns: minmax(220px, .75fr) minmax(0, 1.25fr); gap: clamp(2rem, 6vw, 5rem); margin-top: clamp(3.5rem, 8vw, 5.5rem); padding: clamp(1.75rem, 4vw, 2.5rem); border-left: 3px solid var(--color-acento); background: var(--color-gris); }
  .colaboradores-peche p { margin-top: 0; }
  .btn-volver { display: inline-flex; align-items: center; gap: .65rem; border-radius: 4px; background: var(--color-principal); color: #fff; font-size: .78rem; font-weight: 700; letter-spacing: .06em; padding: .85rem 1.2rem; text-decoration: none; text-transform: uppercase; transition: background-color .2s ease; }
  .btn-volver:hover, .btn-volver:focus-visible { background: var(--color-acento); }
  @media (max-width: 720px) {
    .entidades-grid, .colaboradores-peche { grid-template-columns: 1fr; }
    .entidade-card { grid-template-rows: 155px auto; min-height: 220px; }
    .entidade-logo-link { padding: 2rem 2rem 1.5rem; }
    .entidade-logo-link img { max-width: 220px; max-height: 72px; }
    .btn-volver { justify-content: center; width: 100%; }
  }
</style>
