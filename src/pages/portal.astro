---
/* src/pages/portal.astro */
import BaseLayout from '../layouts/Layout.astro';
import PortalSidebar from '../components/PortalSidebar.astro';
import { getPortalNavigationModules } from '../data/portal-navigation';

const homeModules = getPortalNavigationModules('home');
---

<BaseLayout title="Portal do Coralista" lang="gl">
  <div id="portal-sidebar-container" class="portal-sidebar-container" hidden>
    <PortalSidebar active="inicio" logoutId="portal-sidebar-logout" />
  </div>

  <main id="portal-shell" class="portal-shell">
    <section class="portal-hero" aria-labelledby="portal-title">
      <div class="portal-intro">
        <header class="portal-heading">
          <div>
            <span class="portal-eyebrow">Espazo privado</span>
            <h1 id="portal-title">Portal do Coralista</h1>
            <p class="portal-lead">
              Consulta a información interna da Coral, accede ao repertorio,
              coñece os próximos concertos e colabora no arquivo da Sociedade.
            </p>
          </div>

          <div id="session-card" class="session-card" hidden>
            <span>Conta identificada</span>
            <strong id="dashboard-email"></strong>
            <button type="button" id="logout-button">Pechar sesión</button>
          </div>
        </header>

        <div id="portal-feature-grid" class="portal-feature-grid is-locked" aria-label="Contidos do portal">
          {homeModules.map((module) => {
            const isEnabled = module.homeEnabled ?? module.enabled;
            const title = module.homeTitle || module.label;
            const description = module.homeDescription || '';
            const number = module.homeNumber || '00';

            return isEnabled ? (
              <a
                id={module.homeCardId}
                class:list={['portal-feature', 'is-active', module.adminOnly && 'is-admin']}
                href={module.path}
                hidden={module.adminOnly ? true : undefined}
              >
                <span>{number}</span><strong>{title}</strong><p>{description}</p><b aria-hidden="true">→</b>
              </a>
            ) : (
              <article class="portal-feature is-disabled">
                <span>{number}</span><strong>{title}</strong><p>{description}</p><em>{module.statusText || 'Próximamente'}</em>
              </article>
            );
          })}
        </div>
      </div>

      <aside class="portal-access-card" aria-labelledby="auth-title">
        <div id="auth-options">
          <span class="access-kicker">Acceso reservado</span>
          <h2 id="auth-title">Identifícate para continuar</h2>
          <p>Emprega a conta autorizada pola Sociedade Coral Polifónica de Pontevedra.</p>

          <button type="button" class="btn-google" id="google-login">
            <span aria-hidden="true">G</span>
            Continuar con Google
          </button>

          <div class="auth-separator" aria-hidden="true"><span>ou</span></div>

          <label for="email-socio">Correo electrónico</label>
          <input type="email" id="email-socio" autocomplete="email" placeholder="nome@correo.gal" />

          <button type="button" class="btn-email" id="email-link-login">Recibir unha ligazón de acceso</button>
          <small>Non necesitas contrasinal. Enviarémosche unha ligazón ao correo.</small>
        </div>

        <div id="session-status" hidden>
          <span class="access-kicker">Sesión iniciada</span>
          <h2>Comprobando o teu acceso</h2>
          <p id="authenticated-email"></p>
          <div class="loading-line" aria-hidden="true"></div>
        </div>

        <p id="portal-message" class="portal-message" role="status" aria-live="polite" hidden></p>

        <footer>
          <p>Es membro da agrupación pero aínda non tes acceso? <a href="/contacto">Solicítao á Xunta Directiva</a>.</p>
        </footer>
      </aside>
    </section>
  </main>

  <div id="privacy-modal" class="privacy-modal" hidden>
    <div class="privacy-backdrop"></div>
    <section class="privacy-dialog" role="dialog" aria-modal="true" aria-labelledby="privacy-title">
      <span class="access-kicker">Primeiro acceso</span>
      <h2 id="privacy-title">Condicións de acceso</h2>
      <div class="privacy-text" id="privacy-text" tabindex="0" aria-live="polite">
        <p>Cargando as condicións vixentes…</p>
      </div>

      <label class="privacy-consent" for="acepta-fines">
        <input id="acepta-fines" type="checkbox" />
        <span>Lin e acepto as condicións de acceso e o tratamento dos meus datos para a xestión da zona privada da web e de SCPP Xestión.</span>
      </label>

      <p id="privacy-message" class="privacy-message" role="status" aria-live="polite" hidden></p>
      <div class="privacy-actions">
        <button type="button" class="btn-secondary" id="privacy-logout">Cancelar e saír</button>
        <button type="button" class="btn-primary" id="portal-submit">Aceptar e continuar</button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import {
    GoogleAuthProvider,
    getAuth,
    isSignInWithEmailLink,
    onAuthStateChanged,
    sendSignInLinkToEmail,
    signInWithEmailLink,
    signInWithPopup,
    signOut
  } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const app = getApps().length ? getApp() : initializeApp(firebaseConfig);
  const auth = getAuth(app);
  auth.useDeviceLanguage();

  const EMAIL_GARDADO = 'scpp-email-acceso';

  const authOptions = document.querySelector('#auth-options');
  const sessionStatus = document.querySelector('#session-status');
  const authenticatedEmail = document.querySelector('#authenticated-email');
  const dashboardEmail = document.querySelector('#dashboard-email');
  const sessionCard = document.querySelector('#session-card');
  const featureGrid = document.querySelector('#portal-feature-grid');
  const portalShell = document.querySelector('#portal-shell');
  const sidebarContainer = document.querySelector('#portal-sidebar-container');
  const privacyModal = document.querySelector('#privacy-modal');
  const privacyTitle = document.querySelector('#privacy-title');
  const privacyText = document.querySelector('#privacy-text');
  const privacyMessage = document.querySelector('#privacy-message');
  const consent = document.querySelector('#acepta-fines');
  const message = document.querySelector('#portal-message');
  const emailInput = document.querySelector('#email-socio');
  const googleButton = document.querySelector('#google-login');
  const emailButton = document.querySelector('#email-link-login');
  const acceptButton = document.querySelector('#portal-submit');
  const logoutButton = document.querySelector('#logout-button');
  const sidebarLogout = document.querySelector('#portal-sidebar-logout');
  const privacyLogout = document.querySelector('#privacy-logout');
  const reviewLink = document.querySelector('#photo-review-link');
  const accessCard = document.querySelector('.portal-access-card');

  let emailLinkPending = isSignInWithEmailLink(auth, window.location.href);
  let checkingUser = false;

  function showMessage(text, type = 'erro') {
    if (!(message instanceof HTMLElement)) return;
    message.textContent = text;
    message.dataset.type = type;
    message.hidden = false;
  }

  function hideMessage() {
    if (!(message instanceof HTMLElement)) return;
    message.textContent = '';
    message.hidden = true;
    delete message.dataset.type;
  }

  function showPrivacyMessage(text) {
    if (!(privacyMessage instanceof HTMLElement)) return;
    privacyMessage.textContent = text;
    privacyMessage.hidden = false;
  }

  function hidePrivacyMessage() {
    if (!(privacyMessage instanceof HTMLElement)) return;
    privacyMessage.textContent = '';
    privacyMessage.hidden = true;
  }

  function setButton(button, disabled, text) {
    if (!(button instanceof HTMLButtonElement)) return;
    button.disabled = disabled;
    button.textContent = text;
  }

  function cleanEmailLinkUrl() {
    window.history.replaceState({}, document.title, window.location.pathname);
  }

  function setAuthenticatedLayout(active) {
    if (portalShell instanceof HTMLElement) portalShell.classList.toggle('private-active', active);
    if (sidebarContainer instanceof HTMLElement) sidebarContainer.hidden = !active;
    if (sessionCard instanceof HTMLElement) sessionCard.hidden = !active;
    if (featureGrid instanceof HTMLElement) featureGrid.classList.toggle('is-locked', !active);
    if (accessCard instanceof HTMLElement) accessCard.hidden = active;
  }

  function showSignedOut() {
    setAuthenticatedLayout(false);
    if (authOptions instanceof HTMLElement) authOptions.hidden = false;
    if (sessionStatus instanceof HTMLElement) sessionStatus.hidden = true;
    if (privacyModal instanceof HTMLElement) privacyModal.hidden = true;
    document.body.classList.remove('modal-open');
    if (reviewLink instanceof HTMLElement) reviewLink.hidden = true;
  }

  function showChecking(email) {
    setAuthenticatedLayout(true);
    if (authOptions instanceof HTMLElement) authOptions.hidden = true;
    if (sessionStatus instanceof HTMLElement) sessionStatus.hidden = false;
    if (authenticatedEmail instanceof HTMLElement) authenticatedEmail.textContent = email;
    if (dashboardEmail instanceof HTMLElement) dashboardEmail.textContent = email;
  }

  function showPrivacyModal() {
    if (privacyModal instanceof HTMLElement) privacyModal.hidden = false;
    document.body.classList.add('modal-open');
    if (consent instanceof HTMLInputElement) consent.checked = false;
    hidePrivacyMessage();
  }

  function renderTextoLegal(textoLegal) {
    const titulo = String(textoLegal?.titulo || '').trim();
    const texto = String(textoLegal?.texto || '').trim();
    if (!titulo || !texto || !(privacyText instanceof HTMLElement)) {
      throw new Error('Non foi posible cargar as condicións de acceso vixentes.');
    }

    if (privacyTitle instanceof HTMLElement) privacyTitle.textContent = titulo;
    privacyText.replaceChildren();
    texto.split(/\n\s*\n/).forEach((paragrafo) => {
      const p = document.createElement('p');
      p.textContent = paragrafo.trim();
      privacyText.appendChild(p);
    });
  }

  function hidePrivacyModal() {
    if (privacyModal instanceof HTMLElement) privacyModal.hidden = true;
    document.body.classList.remove('modal-open');
  }

  async function requestAcceptance(action, extra = {}) {
    const user = auth.currentUser;
    if (!user?.email) throw new Error('A sesión xa non está activa.');
    const idToken = await user.getIdToken(true);
    const response = await fetch('/api/aceptacion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion: action, ...extra })
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || result?.detalle || 'Non foi posible comprobar o acceso.');
    return result;
  }

  async function requestPhotoAdmin() {
    const user = auth.currentUser;
    if (!user?.email) return false;
    const idToken = await user.getIdToken(true);
    const response = await fetch('/api/fotos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion: 'listarFotosRevision' })
    });
    const result = await response.json().catch(() => null);
    return response.ok && result?.ok === true;
  }

  async function showDashboard(user) {
    hidePrivacyModal();
    setAuthenticatedLayout(true);
    if (sessionStatus instanceof HTMLElement) sessionStatus.hidden = true;
    if (dashboardEmail instanceof HTMLElement) dashboardEmail.textContent = user.email || '';
    if (reviewLink instanceof HTMLElement) reviewLink.hidden = !(await requestPhotoAdmin().catch(() => false));
  }

  async function checkAccess(user) {
    if (checkingUser) return;
    checkingUser = true;
    showChecking(user.email || '');
    hideMessage();
    try {
      const result = await requestAcceptance('comprobarAceptacion');
      if (result.aceptacionVixente) await showDashboard(user);
      else {
        renderTextoLegal(result.textoLegal);
        showPrivacyModal();
      }
    } catch (error) {
      await signOut(auth).catch(() => undefined);
      showSignedOut();
      showMessage(error instanceof Error ? error.message : 'Non foi posible comprobar o acceso.');
    } finally {
      checkingUser = false;
    }
  }

  googleButton?.addEventListener('click', async () => {
    hideMessage();
    setButton(googleButton, true, 'Conectando…');
    try { await signInWithPopup(auth, new GoogleAuthProvider()); }
    catch (error) { showMessage(error instanceof Error ? error.message : 'Non foi posible iniciar sesión con Google.'); }
    finally { setButton(googleButton, false, 'Continuar con Google'); }
  });

  emailButton?.addEventListener('click', async () => {
    const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim().toLowerCase() : '';
    if (!email) { showMessage('Introduce o teu correo electrónico.'); return; }
    hideMessage();
    setButton(emailButton, true, 'Enviando…');
    try {
      localStorage.setItem(EMAIL_GARDADO, email);
      await sendSignInLinkToEmail(auth, email, { url: `${window.location.origin}/portal/`, handleCodeInApp: true });
      showMessage('Enviámosche unha ligazón de acceso ao correo.', 'correcto');
    } catch (error) {
      showMessage(error instanceof Error ? error.message : 'Non foi posible enviar a ligazón.');
    } finally {
      setButton(emailButton, false, 'Recibir unha ligazón de acceso');
    }
  });

  acceptButton?.addEventListener('click', async () => {
    if (!(consent instanceof HTMLInputElement) || !consent.checked) {
      showPrivacyMessage('Debes marcar a aceptación para continuar.');
      return;
    }
    hidePrivacyMessage();
    setButton(acceptButton, true, 'Gardando…');
    try {
      await requestAcceptance('rexistrarAceptacion', { aceptaFines: true });
      const user = auth.currentUser;
      if (!user) throw new Error('A sesión xa non está activa.');
      await showDashboard(user);
    } catch (error) {
      showPrivacyMessage(error instanceof Error ? error.message : 'Non foi posible gardar a aceptación.');
    } finally {
      setButton(acceptButton, false, 'Aceptar e continuar');
    }
  });

  async function closeSession() {
    localStorage.removeItem(EMAIL_GARDADO);
    await signOut(auth);
  }

  logoutButton?.addEventListener('click', closeSession);
  sidebarLogout?.addEventListener('click', closeSession);
  privacyLogout?.addEventListener('click', closeSession);

  onAuthStateChanged(auth, async (user) => {
    if (user) await checkAccess(user);
    else showSignedOut();
  });

  if (emailLinkPending) {
    const storedEmail = localStorage.getItem(EMAIL_GARDADO) || '';
    const email = storedEmail || window.prompt('Introduce o correo co que solicitaches a ligazón:') || '';
    if (email) {
      signInWithEmailLink(auth, email.trim().toLowerCase(), window.location.href)
        .then(() => { localStorage.removeItem(EMAIL_GARDADO); cleanEmailLinkUrl(); })
        .catch((error) => showMessage(error instanceof Error ? error.message : 'Non foi posible completar o acceso por correo.'));
    }
  }
</script>

<style>
  :global(body) { background: #f4f1ee; }
  .portal-shell { min-height: 100vh; }
  .portal-hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(320px, .75fr); gap: 3rem; align-items: start; min-height: 100vh; padding: 2.4rem clamp(1.5rem, 5vw, 5.5rem) 3rem; }
  .portal-intro { max-width: 960px; }
  .portal-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: flex-start; margin-bottom: 2rem; }
  .portal-eyebrow, .access-kicker { display: inline-block; margin-bottom: .7rem; color: var(--color-principal); font-size: .76rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .portal-intro h1 { margin: 0; color: #24211f; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.8rem, 5.5vw, 5.4rem); font-weight: 400; line-height: 1; letter-spacing: -.04em; }
  .portal-lead { max-width: 690px; margin: 1.3rem 0 0; color: #5c5652; font-size: 1rem; line-height: 1.72; }
  .portal-feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .portal-feature { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: .3rem 1rem; min-height: 132px; padding: 1.25rem; border: 1px solid #ddd7d1; background: #fff; color: inherit; text-decoration: none; }
  .portal-feature[hidden] { display: none !important; }
  .portal-feature > span { grid-row: 1 / span 2; color: var(--color-acento); font-size: .72rem; font-weight: 800; }
  .portal-feature strong { color: #2f2a27; font-size: 1rem; }
  .portal-feature p { margin: 0; color: #6a625d; font-size: .86rem; line-height: 1.5; }
  .portal-feature b { grid-column: 3; grid-row: 1 / span 2; align-self: center; color: var(--color-principal); font-size: 1.3rem; font-weight: 500; }
  .portal-feature em { grid-column: 2; align-self: end; color: #8b837d; font-size: .68rem; font-style: normal; font-weight: 800; text-transform: uppercase; }
  .portal-feature.is-active { transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .portal-feature.is-active:hover { transform: translateY(-2px); border-color: #bda9aa; box-shadow: 0 12px 30px rgba(68, 45, 45, .08); }
  .portal-feature.is-disabled { background: #f2efec; }
  .portal-feature-grid.is-locked .portal-feature { pointer-events: none; }
  .portal-feature-grid.is-locked .portal-feature.is-active b { display: none; }
  .portal-access-card { align-self: start; padding: clamp(2rem, 4vw, 3rem); border: 1px solid #ded8d2; background: #fff; box-shadow: 0 24px 60px rgba(42, 32, 26, .08); }
  .portal-access-card h2 { margin: 0 0 .9rem; color: #2d2825; font-family: Georgia, 'Times New Roman', serif; font-size: 2rem; font-weight: 400; }
  .portal-access-card p { color: #675f5a; line-height: 1.65; }
  .portal-access-card label { display: block; margin: 1.25rem 0 .45rem; color: #3c3632; font-size: .83rem; font-weight: 700; }
  .portal-access-card input[type='email'] { width: 100%; min-height: 48px; padding: .8rem .9rem; border: 1px solid #cfc7c0; border-radius: 3px; background: #fff; color: #2b2724; font: inherit; }
  .portal-access-card button { width: 100%; min-height: 48px; padding: .8rem 1rem; border: 0; border-radius: 3px; font: inherit; font-weight: 800; cursor: pointer; }
  .btn-google { background: #7b2330; color: #fff; }
  .btn-email { margin-top: .75rem; background: #2f332e; color: #fff; }
  .portal-access-card button:disabled { opacity: .65; cursor: wait; }
  .auth-separator { display: flex; align-items: center; gap: .8rem; margin: 1.2rem 0; color: #8a817b; font-size: .75rem; }
  .auth-separator::before, .auth-separator::after { content: ''; flex: 1; height: 1px; background: #e3ddd8; }
  .portal-access-card small { display: block; margin-top: .8rem; color: #857d77; line-height: 1.5; }
  .portal-access-card footer { margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid #ece7e2; font-size: .84rem; }
  .portal-access-card footer a { color: var(--color-principal); font-weight: 700; }
  .portal-message { margin-top: 1rem; padding: .85rem; border: 1px solid #dfc9c9; background: #fbf1f1; color: #7b2330 !important; font-size: .86rem; }
  .portal-message[data-type='correcto'] { border-color: #c9d8c9; background: #f1f7f1; color: #335b33 !important; }
  .loading-line { height: 3px; margin-top: 1.5rem; overflow: hidden; background: #eee8e3; }
  .loading-line::after { content: ''; display: block; width: 45%; height: 100%; background: var(--color-principal); animation: portal-loading 1.2s ease-in-out infinite alternate; }
  @keyframes portal-loading { to { transform: translateX(120%); } }
  .portal-sidebar-container { width: 282px; flex: 0 0 282px; }
  .session-card { min-width: 230px; padding: .9rem 1rem; border: 1px solid #ddd6d0; background: #fff; }
  .session-card span { display: block; color: #7c746e; font-size: .7rem; text-transform: uppercase; }
  .session-card strong { display: block; margin: .25rem 0 .65rem; color: #332e2b; font-size: .86rem; overflow-wrap: anywhere; }
  .session-card button { border: 0; padding: 0; background: transparent; color: var(--color-principal); font: inherit; font-size: .78rem; font-weight: 800; cursor: pointer; }
  .portal-shell.private-active .portal-hero { grid-template-columns: 1fr; }
  .portal-shell.private-active .portal-intro { max-width: none; }
  .privacy-modal { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 1.2rem; }
  .privacy-modal[hidden] { display: none; }
  .privacy-backdrop { position: absolute; inset: 0; background: rgba(26, 21, 18, .68); backdrop-filter: blur(4px); }
  .privacy-dialog { position: relative; width: min(720px, 100%); max-height: calc(100vh - 2.4rem); overflow: auto; padding: clamp(1.5rem, 4vw, 2.6rem); border: 1px solid #d8d0ca; background: #fff; box-shadow: 0 24px 70px rgba(0, 0, 0, .25); }
  .privacy-dialog h2 { margin: 0 0 1rem; color: #2d2825; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.8rem, 4vw, 2.7rem); font-weight: 400; }
  .privacy-text { max-height: 290px; overflow: auto; padding: 1rem; border: 1px solid #e2dcd7; background: #faf8f6; }
  .privacy-text p { margin: 0 0 1rem; color: #5e5752; line-height: 1.65; }
  .privacy-text p:last-child { margin-bottom: 0; }
  .privacy-consent { display: grid !important; grid-template-columns: auto minmax(0, 1fr); gap: .8rem; align-items: start; margin: 1.2rem 0 0 !important; }
  .privacy-consent input { margin-top: .18rem; }
  .privacy-consent span { color: #4e4844; font-size: .9rem; line-height: 1.55; }
  .privacy-actions { display: flex; justify-content: flex-end; gap: .8rem; margin-top: 1.3rem; }
  .privacy-actions button { width: auto; min-width: 170px; }
  .btn-secondary { border: 1px solid #cabfba !important; background: #fff !important; color: #4e4844 !important; }
  .btn-primary { background: var(--color-principal) !important; color: #fff !important; }
  .privacy-message { color: #7b2330; font-size: .86rem; }
  :global(body.modal-open) { overflow: hidden; }

  @media (max-width: 980px) {
    .portal-hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 1.5rem; }
    .portal-heading { flex-direction: column; }
    .session-card { width: 100%; }
  }

  @media (max-width: 700px) {
    .portal-feature-grid { grid-template-columns: 1fr; }
    .portal-intro h1 { font-size: clamp(2.6rem, 15vw, 4.2rem); }
    .portal-feature { grid-template-columns: auto minmax(0, 1fr); }
    .portal-feature b { grid-column: 2; grid-row: 3; justify-self: start; }
    .privacy-actions { flex-direction: column-reverse; }
    .privacy-actions button { width: 100%; }
  }
</style>

