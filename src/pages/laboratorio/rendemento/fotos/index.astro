---
import BaseLayout from '../../../../layouts/Layout.astro';
---

<BaseLayout title="Laboratorio de rendemento · Fotografías" lang="gl">
  <main class="container performance-lab">
    <header class="lab-header">
      <span>Framework SCPP · Laboratorio</span>
      <h1>Proba de lectura fotográfica desde R2</h1>
      <p>Esta páxina mide a lectura do índice R2 sen modificar a galería pública nin o módulo de revisión.</p>
    </header>

    <section class="metrics" aria-live="polite">
      <div><small>Estado</small><strong id="metric-state">Cargando…</strong></div>
      <div><small>Caché</small><strong id="metric-cache">—</strong></div>
      <div><small>Resposta API</small><strong id="metric-api">—</strong></div>
      <div><small>Renderizado</small><strong id="metric-render">—</strong></div>
      <div><small>Total</small><strong id="metric-total">—</strong></div>
    </section>

    <section class="test-actions">
      <button id="run-test" type="button">Repetir proba</button>
      <span id="lab-status">Solicitando o índice de fotografías…</span>
    </section>

    <section id="gallery-grid" class="gallery-grid" aria-live="polite"></section>
  </main>
</BaseLayout>

<script>
  const grid = document.querySelector('#gallery-grid');
  const status = document.querySelector('#lab-status');
  const runButton = document.querySelector('#run-test');
  const metricState = document.querySelector('#metric-state');
  const metricCache = document.querySelector('#metric-cache');
  const metricApi = document.querySelector('#metric-api');
  const metricRender = document.querySelector('#metric-render');
  const metricTotal = document.querySelector('#metric-total');

  const escapar = (valor = '') => String(valor ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  function crearTarxeta(foto) {
    const article = document.createElement('article');
    const titulo = String(foto?.titulo || 'Fotografía da SCPP').trim();
    const original = String(foto?.urlPublica || '').trim();
    const miniatura = String(foto?.urlMiniaturaPublica || original).trim();
    article.className = 'photo-card';
    article.innerHTML = `
      <a href="${escapar(original)}" target="_blank" rel="noopener">
        <img src="${escapar(miniatura)}" alt="${escapar(titulo)}" loading="lazy" decoding="async" />
      </a>
      <div>
        <h2>${escapar(titulo)}</h2>
        <small>${foto?.urlMiniaturaPublica ? 'Miniatura R2' : 'Orixinal usado como respaldo'}</small>
      </div>`;
    const image = article.querySelector('img');
    image?.addEventListener('error', () => {
      article.classList.add('image-error');
      if (image instanceof HTMLImageElement) image.alt = `Imaxe non dispoñible: ${titulo}`;
    });
    return article;
  }

  async function executarProba() {
    if (runButton instanceof HTMLButtonElement) runButton.disabled = true;
    if (status) status.textContent = 'Solicitando o índice de fotografías…';
    if (metricState) metricState.textContent = 'Cargando…';
    const inicio = performance.now();

    try {
      const resposta = await fetch('/api/galeria-r2-proba', { cache: 'default' });
      const finApi = performance.now();
      const datos = await resposta.json();
      if (!resposta.ok || !datos?.ok || !Array.isArray(datos.fotos)) {
        throw new Error(datos?.erro || 'Non foi posible cargar o índice R2.');
      }

      const inicioRender = performance.now();
      grid?.replaceChildren(...datos.fotos.map(crearTarxeta));
      const finRender = performance.now();
      const cache = datos.cache || resposta.headers.get('X-SCPP-Cache') || '—';

      if (metricState) metricState.textContent = `${datos.fotos.length} fotografías`;
      if (metricCache) metricCache.textContent = cache;
      if (metricApi) metricApi.textContent = `${Math.round(finApi - inicio)} ms`;
      if (metricRender) metricRender.textContent = `${Math.round(finRender - inicioRender)} ms`;
      if (metricTotal) metricTotal.textContent = `${Math.round(finRender - inicio)} ms`;
      if (status) status.textContent = cache === 'MISS'
        ? 'Índice creado. Repite a proba para medir unha lectura HIT desde R2.'
        : cache === 'STALE'
          ? 'Último índice válido servido; actualización solicitada en segundo plano.'
          : 'Índice servido directamente desde R2.';
    } catch (erro) {
      if (metricState) metricState.textContent = 'Erro';
      if (metricCache) metricCache.textContent = 'ERROR';
      if (status) status.textContent = erro instanceof Error ? erro.message : 'Erro descoñecido';
    } finally {
      if (runButton instanceof HTMLButtonElement) runButton.disabled = false;
    }
  }

  runButton?.addEventListener('click', executarProba);
  executarProba();
</script>

<style>
  .performance-lab{padding-top:3rem;padding-bottom:5rem}.lab-header{max-width:820px;margin:0 auto 2rem;text-align:center}.lab-header span{color:var(--color-acento);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.lab-header h1{margin:.5rem 0;color:var(--color-principal);font-size:clamp(2rem,5vw,3rem)}.lab-header p{margin:0;color:#665f5a;line-height:1.6}.metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.7rem;margin-bottom:1rem}.metrics div{display:grid;gap:.25rem;padding:.85rem;border:1px solid #ded8d3;background:#fff}.metrics small{font-size:.66rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.metrics strong{color:var(--color-principal);font-size:.95rem}.test-actions{display:flex;align-items:center;gap:1rem;margin-bottom:1rem;padding:.8rem;border-left:3px solid var(--color-acento);background:#faf8f6}.test-actions button{min-height:2.5rem;padding:.55rem .9rem;border:1px solid var(--color-principal);background:var(--color-principal);color:#fff;font:inherit;cursor:pointer}.test-actions button:disabled{opacity:.5;cursor:wait}.test-actions span{color:#625c57;font-size:.86rem}.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem}.photo-card{overflow:hidden;border:1px solid #ddd7d2;background:#fff}.photo-card>a{display:block;height:210px;background:#eeeae7}.photo-card img{display:block;width:100%;height:100%;object-fit:cover}.photo-card>div{padding:.75rem .9rem .9rem}.photo-card h2{margin:0 0 .25rem;font-size:.92rem;line-height:1.35}.photo-card small{color:#766f69}.photo-card.image-error img{opacity:.18}@media(max-width:850px){.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.metrics div:last-child{grid-column:1/-1}}@media(max-width:650px){.test-actions{align-items:stretch;flex-direction:column}.gallery-grid{grid-template-columns:1fr}}
</style>
