---
import BaseLayout from '../../../../layouts/Layout.astro';
---

<BaseLayout title="Laboratorio de rendemento · Fotografías" lang="gl">
  <main class="container performance-lab">
    <header class="lab-header">
      <span>Framework SCPP · Laboratorio</span>
      <h1>Proba de lectura fotográfica desde R2</h1>
      <p>Esta páxina mide a lectura do índice R2 sen modificar a galería pública nin o módulo de revisión.</p>
    </header>

    <section class="metrics" aria-live="polite">
      <div><small>Estado</small><strong id="metric-state">Cargando…</strong></div>
      <div><small>Caché</small><strong id="metric-cache">—</strong></div>
      <div><small>Resposta API</small><strong id="metric-api">—</strong></div>
      <div><small>Renderizado</small><strong id="metric-render">—</strong></div>
      <div><small>Total</small><strong id="metric-total">—</strong></div>
    </section>

    <section class="test-actions">
      <button id="run-test" type="button">Repetir proba</button>
      <span id="lab-status">Solicitando o índice de fotografías…</span>
    </section>

    <section id="gallery-grid" class="gallery-grid" aria-live="polite"></section>
  </main>

  <dialog id="photo-viewer" class="photo-viewer" aria-labelledby="viewer-title">
    <div class="viewer-shell">
      <button id="viewer-close" class="viewer-close" type="button" aria-label="Pechar fotografía">×</button>
      <button id="viewer-previous" class="viewer-nav viewer-previous" type="button" aria-label="Fotografía anterior">‹</button>
      <figure>
        <div class="viewer-image-wrap">
          <span id="viewer-loading" class="viewer-loading">Cargando fotografía…</span>
          <img id="viewer-image" alt="" decoding="async" />
        </div>
        <figcaption>
          <strong id="viewer-title"></strong>
          <span id="viewer-position"></span>
        </figcaption>
      </figure>
      <button id="viewer-next" class="viewer-nav viewer-next" type="button" aria-label="Fotografía seguinte">›</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  const grid = document.querySelector('#gallery-grid');
  const status = document.querySelector('#lab-status');
  const runButton = document.querySelector('#run-test');
  const metricState = document.querySelector('#metric-state');
  const metricCache = document.querySelector('#metric-cache');
  const metricApi = document.querySelector('#metric-api');
  const metricRender = document.querySelector('#metric-render');
  const metricTotal = document.querySelector('#metric-total');
  const viewer = document.querySelector('#photo-viewer');
  const viewerImage = document.querySelector('#viewer-image');
  const viewerTitle = document.querySelector('#viewer-title');
  const viewerPosition = document.querySelector('#viewer-position');
  const viewerLoading = document.querySelector('#viewer-loading');
  const viewerPrevious = document.querySelector('#viewer-previous');
  const viewerNext = document.querySelector('#viewer-next');
  const viewerClose = document.querySelector('#viewer-close');

  let fotos = [];
  let viewerIndex = 0;

  const escapar = (valor = '') => String(valor ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  const tituloFoto = (foto) => String(foto?.titulo || foto?.peFoto || 'Fotografía da SCPP').trim();
  const urlOriginal = (foto) => String(foto?.urlPublica || '').trim();
  const urlMiniatura = (foto) => String(foto?.urlMiniaturaPublica || foto?.urlPublica || '').trim();

  function precargar(index) {
    const foto = fotos[index];
    const url = urlOriginal(foto);
    if (!url) return;
    const image = new Image();
    image.src = url;
  }

  function actualizarNavegacion() {
    if (viewerPrevious instanceof HTMLButtonElement) viewerPrevious.disabled = viewerIndex <= 0;
    if (viewerNext instanceof HTMLButtonElement) viewerNext.disabled = viewerIndex >= fotos.length - 1;
  }

  function mostrarNoVisor(index) {
    if (!(viewer instanceof HTMLDialogElement) || !(viewerImage instanceof HTMLImageElement)) return;
    const foto = fotos[index];
    if (!foto) return;

    viewerIndex = index;
    const titulo = tituloFoto(foto);
    const original = urlOriginal(foto);
    viewerImage.removeAttribute('src');
    viewerImage.alt = titulo;
    viewerImage.classList.remove('is-ready');
    if (viewerLoading instanceof HTMLElement) viewerLoading.hidden = false;
    if (viewerTitle instanceof HTMLElement) viewerTitle.textContent = titulo;
    if (viewerPosition instanceof HTMLElement) viewerPosition.textContent = `${index + 1} de ${fotos.length}`;
    actualizarNavegacion();

    viewerImage.onload = () => {
      viewerImage.classList.add('is-ready');
      if (viewerLoading instanceof HTMLElement) viewerLoading.hidden = true;
      precargar(index + 1);
      precargar(index - 1);
    };
    viewerImage.onerror = () => {
      if (viewerLoading instanceof HTMLElement) viewerLoading.textContent = 'Non foi posible abrir a fotografía.';
    };
    viewerImage.src = original;

    if (!viewer.open) viewer.showModal();
  }

  function crearTarxeta(foto, index) {
    const article = document.createElement('article');
    const titulo = tituloFoto(foto);
    const miniatura = urlMiniatura(foto);
    article.className = 'photo-card';
    article.innerHTML = `
      <button type="button" class="photo-open" aria-label="Abrir ${escapar(titulo)}">
        <span class="photo-placeholder">Cargando…</span>
        <img src="${escapar(miniatura)}" alt="${escapar(titulo)}" loading="lazy" decoding="async" />
      </button>
      <div class="photo-meta">
        <h2>${escapar(titulo)}</h2>
      </div>`;

    const image = article.querySelector('img');
    const placeholder = article.querySelector('.photo-placeholder');
    image?.addEventListener('load', () => {
      article.classList.add('image-ready');
      if (placeholder instanceof HTMLElement) placeholder.hidden = true;
    });
    image?.addEventListener('error', () => {
      article.classList.add('image-error');
      if (placeholder instanceof HTMLElement) placeholder.textContent = 'Imaxe non dispoñible';
    });
    article.querySelector('.photo-open')?.addEventListener('click', () => mostrarNoVisor(index));
    return article;
  }

  async function executarProba() {
    if (runButton instanceof HTMLButtonElement) runButton.disabled = true;
    if (status) status.textContent = 'Solicitando o índice de fotografías…';
    if (metricState) metricState.textContent = 'Cargando…';
    const inicio = performance.now();

    try {
      const resposta = await fetch('/api/galeria-r2-proba', { cache: 'default' });
      const finApi = performance.now();
      const datos = await resposta.json();
      if (!resposta.ok || !datos?.ok || !Array.isArray(datos.fotos)) {
        throw new Error(datos?.erro || 'Non foi posible cargar o índice R2.');
      }

      fotos = datos.fotos.filter((foto) => urlOriginal(foto));
      const inicioRender = performance.now();
      grid?.replaceChildren(...fotos.map(crearTarxeta));
      const finRender = performance.now();
      const cache = datos.cache || resposta.headers.get('X-SCPP-Cache') || '—';

      if (metricState) metricState.textContent = `${fotos.length} fotografías`;
      if (metricCache) metricCache.textContent = cache;
      if (metricApi) metricApi.textContent = `${Math.round(finApi - inicio)} ms`;
      if (metricRender) metricRender.textContent = `${Math.round(finRender - inicioRender)} ms`;
      if (metricTotal) metricTotal.textContent = `${Math.round(finRender - inicio)} ms`;
      if (status) status.textContent = cache === 'STALE'
        ? 'Último índice válido servido desde R2.'
        : 'Índice servido directamente desde R2.';
    } catch (erro) {
      if (metricState) metricState.textContent = 'Erro';
      if (metricCache) metricCache.textContent = 'ERROR';
      if (status) status.textContent = erro instanceof Error ? erro.message : 'Erro descoñecido';
    } finally {
      if (runButton instanceof HTMLButtonElement) runButton.disabled = false;
    }
  }

  viewerPrevious?.addEventListener('click', () => mostrarNoVisor(viewerIndex - 1));
  viewerNext?.addEventListener('click', () => mostrarNoVisor(viewerIndex + 1));
  viewerClose?.addEventListener('click', () => {
    if (viewer instanceof HTMLDialogElement) viewer.close();
  });
  viewer?.addEventListener('click', (event) => {
    if (event.target === viewer && viewer instanceof HTMLDialogElement) viewer.close();
  });
  document.addEventListener('keydown', (event) => {
    if (!(viewer instanceof HTMLDialogElement) || !viewer.open) return;
    if (event.key === 'ArrowLeft' && viewerIndex > 0) mostrarNoVisor(viewerIndex - 1);
    if (event.key === 'ArrowRight' && viewerIndex < fotos.length - 1) mostrarNoVisor(viewerIndex + 1);
  });

  runButton?.addEventListener('click', executarProba);
  executarProba();
</script>

<style>
  .performance-lab{padding-top:3rem;padding-bottom:5rem}.lab-header{max-width:820px;margin:0 auto 2rem;text-align:center}.lab-header span{color:var(--color-acento);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.lab-header h1{margin:.5rem 0;color:var(--color-principal);font-size:clamp(2rem,5vw,3rem)}.lab-header p{margin:0;color:#665f5a;line-height:1.6}.metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.7rem;margin-bottom:1rem}.metrics div{display:grid;gap:.25rem;padding:.85rem;border:1px solid #ded8d3;background:#fff}.metrics small{font-size:.66rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.metrics strong{color:var(--color-principal);font-size:.95rem}.test-actions{display:flex;align-items:center;gap:1rem;margin-bottom:1.4rem;padding:.8rem;border-left:3px solid var(--color-acento);background:#faf8f6}.test-actions button{min-height:2.5rem;padding:.55rem .9rem;border:1px solid var(--color-principal);background:var(--color-principal);color:#fff;font:inherit;cursor:pointer}.test-actions button:disabled{opacity:.5;cursor:wait}.test-actions span{color:#625c57;font-size:.86rem}.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:.85rem;align-items:start}.photo-card{min-width:0;overflow:hidden;border:1px solid #ddd7d2;background:#fff;box-shadow:0 5px 16px rgba(48,37,31,.05)}.photo-open{position:relative;display:block;width:100%;aspect-ratio:4/3;padding:0;overflow:hidden;border:0;background:#eeeae7;cursor:zoom-in}.photo-open img{display:block;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .2s ease,transform .25s ease}.photo-card.image-ready img{opacity:1}.photo-open:hover img{transform:scale(1.025)}.photo-placeholder{position:absolute;inset:0;display:grid;place-items:center;padding:.7rem;color:#7a726c;font-size:.72rem}.photo-meta{padding:.55rem .7rem .65rem}.photo-meta h2{display:-webkit-box;margin:0;overflow:hidden;color:#4c4540;font-size:.78rem;font-weight:600;line-height:1.35;-webkit-box-orient:vertical;-webkit-line-clamp:2}.photo-card.image-error .photo-open{background:#f2efec}.photo-card.image-error img{display:none}.photo-viewer{width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:0;border:0;background:rgba(20,16,14,.94);color:#fff}.photo-viewer::backdrop{background:rgba(20,16,14,.94)}.viewer-shell{position:relative;display:grid;width:100%;height:100%;grid-template-columns:minmax(44px,72px) minmax(0,1fr) minmax(44px,72px);align-items:center}.viewer-shell figure{display:grid;max-width:min(1280px,calc(100vw - 150px));max-height:calc(100vh - 40px);margin:auto;grid-template-rows:minmax(0,1fr) auto}.viewer-image-wrap{position:relative;display:grid;min-height:240px;place-items:center}.viewer-image-wrap img{display:block;max-width:100%;max-height:calc(100vh - 105px);object-fit:contain;opacity:0;transition:opacity .2s ease}.viewer-image-wrap img.is-ready{opacity:1}.viewer-loading{position:absolute;color:#ddd4ce;font-size:.86rem}.viewer-shell figcaption{display:flex;justify-content:space-between;gap:1rem;padding:.75rem .1rem 0;color:#f5f0ec;font-size:.82rem}.viewer-shell figcaption strong{font-weight:500}.viewer-shell figcaption span{color:#cfc4bd}.viewer-close,.viewer-nav{border:0;background:rgba(255,255,255,.08);color:#fff;cursor:pointer}.viewer-close{position:absolute;z-index:2;top:1rem;right:1rem;width:2.7rem;height:2.7rem;border-radius:50%;font-size:1.8rem}.viewer-nav{width:100%;height:5rem;font-size:3rem}.viewer-nav:disabled{opacity:.2;cursor:default}@media(max-width:850px){.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.metrics div:last-child{grid-column:1/-1}.gallery-grid{grid-template-columns:repeat(auto-fill,minmax(145px,1fr))}.viewer-shell{grid-template-columns:44px minmax(0,1fr) 44px}.viewer-shell figure{max-width:calc(100vw - 96px)}}@media(max-width:650px){.test-actions{align-items:stretch;flex-direction:column}.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.photo-meta{padding:.45rem .55rem}.photo-meta h2{font-size:.72rem}.viewer-shell{grid-template-columns:1fr}.viewer-shell figure{max-width:calc(100vw - 24px)}.viewer-nav{position:absolute;z-index:2;bottom:3.5rem;width:3rem;height:3rem;border-radius:50%;font-size:2rem}.viewer-previous{left:1rem}.viewer-next{right:1rem}.viewer-shell figcaption{padding:1rem 3.8rem 0}.viewer-close{top:.7rem;right:.7rem}}
</style>
