---
import BaseLayout from '../layouts/Layout.astro';
const categorias = ['Todos', 'Concertos', 'Centenario', 'Distincións', 'Prensa', 'Histórico', 'Viaxes', 'Outros'];
---

<BaseLayout title="Galería" lang="gl">
  <main class="container gallery-page-wrapper">
    <header class="gallery-header">
      <span class="gallery-kicker">Arquivo visual da SCPP</span>
      <h1>Galería fotográfica</h1>
      <div class="section-line-center"></div>
      <p class="gallery-intro">Un percorrido pola actividade artística, institucional e histórica da Sociedade Coral Polifónica de Pontevedra.</p>
    </header>

    <nav class="gallery-filters" aria-label="Filtrar fotografías">
      {categorias.map((categoria, index) => (
        <button class:list={['filter-tag', { active: index === 0 }]} type="button" data-filter={categoria}>{categoria}</button>
      ))}
    </nav>

    <p id="gallery-count" class="gallery-count">Cargando fotografías…</p>
    <p id="gallery-status" class="gallery-status" aria-live="polite"></p>
    <section id="gallery-grid" class="gallery-grid" aria-live="polite"></section>
    <p id="gallery-empty" class="gallery-empty" hidden>Non hai fotografías nesta categoría.</p>
  </main>

  <dialog id="gallery-dialog" class="gallery-dialog" aria-labelledby="dialog-title">
    <button id="dialog-close" class="dialog-close" type="button" aria-label="Pechar imaxe">×</button>
    <button id="dialog-previous" class="dialog-nav dialog-previous" type="button" aria-label="Fotografía anterior">‹</button>
    <figure>
      <div class="dialog-image-wrap">
        <span id="dialog-loading">Cargando fotografía…</span>
        <img id="dialog-image" alt="" decoding="async" />
      </div>
      <figcaption><strong id="dialog-title"></strong><span id="dialog-position"></span></figcaption>
    </figure>
    <button id="dialog-next" class="dialog-nav dialog-next" type="button" aria-label="Fotografía seguinte">›</button>
  </dialog>
</BaseLayout>

<script>
  const grid = document.querySelector('#gallery-grid');
  const filterButtons = [...document.querySelectorAll('[data-filter]')];
  const count = document.querySelector('#gallery-count');
  const empty = document.querySelector('#gallery-empty');
  const status = document.querySelector('#gallery-status');
  const dialog = document.querySelector('#gallery-dialog');
  const dialogImage = document.querySelector('#dialog-image');
  const dialogTitle = document.querySelector('#dialog-title');
  const dialogPosition = document.querySelector('#dialog-position');
  const dialogLoading = document.querySelector('#dialog-loading');
  const dialogClose = document.querySelector('#dialog-close');
  const dialogPrevious = document.querySelector('#dialog-previous');
  const dialogNext = document.querySelector('#dialog-next');

  let fotos = [];
  let visibles = [];
  let activeFilter = 'Todos';
  let current = 0;

  const esc = (value = '') => String(value ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const titleOf = (foto) => String(foto?.titulo || foto?.Titulo || foto?.peFoto || foto?.PeFoto || 'Fotografía da SCPP').trim();
  const originalOf = (foto) => String(foto?.urlPublica || '').trim();
  const thumbOf = (foto) => String(foto?.urlMiniaturaPublica || foto?.urlPublica || '').trim();

  function normalizarTexto(value = '') {
    return String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  function categoriaExplicita(foto) {
    const raw = String(
      foto?.categoria || foto?.Categoria || foto?.categoriaPublica || foto?.CategoriaPublica ||
      foto?.tipoGaleria || foto?.TipoGaleria || foto?.seccion || foto?.Seccion || ''
    ).trim();
    const value = normalizarTexto(raw);
    if (!value) return '';
    if (value.includes('concert')) return 'Concertos';
    if (value.includes('centen')) return 'Centenario';
    if (value.includes('distinc') || value.includes('premio') || value.includes('medalla') || value.includes('homenaxe')) return 'Distincións';
    if (value.includes('prensa') || value.includes('noticia') || value.includes('xornal')) return 'Prensa';
    if (value.includes('histor')) return 'Histórico';
    if (value.includes('viax') || value.includes('viaje') || value.includes('excursion')) return 'Viaxes';
    if (value.includes('outro')) return 'Outros';
    return '';
  }

  function categoryOf(foto) {
    const explicit = categoriaExplicita(foto);
    if (explicit) return explicit;

    const text = normalizarTexto([
      foto?.titulo, foto?.Titulo, foto?.peFoto, foto?.PeFoto,
      foto?.evento, foto?.Evento, foto?.concerto, foto?.Concerto,
      foto?.lugar, foto?.Lugar, foto?.procedencia, foto?.Procedencia
    ].filter(Boolean).join(' '));

    const year = Number(String(foto?.ano || foto?.anoAproximado || foto?.AnoAproximado || '').match(/\d{4}/)?.[0] || 0);

    if (/centenario|100 aniversario|cen anos/.test(text)) return 'Centenario';
    if (/medalla|premio|distinc|homenaxe|condecor|recoñec|reconoc/.test(text)) return 'Distincións';
    if (/prensa|xornal|periodic|diario|noticia|entrevista|reportaxe|reportaje/.test(text)) return 'Prensa';
    if (/viax|viaje|excursion|madeira|portugal|francia|italia|vasco|bilbao|santiago|lugo/.test(text)) return 'Viaxes';
    if (/concerto|concierto|festival|actuacion|actuación|misa|cantata|auditorio|igrexa|iglesia|banda|orfeon|orfeão/.test(text)) return 'Concertos';
    if ((year && year < 1980) || /histor|arquivo|archivo|antiga|antiguo|fundacion|fundación|director.*iglesias|vilarelle/.test(text)) return 'Histórico';
    return 'Outros';
  }

  function preload(index) {
    const url = originalOf(visibles[index]);
    if (!url) return;
    const image = new Image();
    image.src = url;
  }

  function showViewer(index) {
    if (!(dialog instanceof HTMLDialogElement) || !(dialogImage instanceof HTMLImageElement)) return;
    const foto = visibles[index];
    if (!foto) return;
    current = index;
    const titulo = titleOf(foto);
    dialogImage.removeAttribute('src');
    dialogImage.classList.remove('ready');
    dialogImage.alt = titulo;
    if (dialogLoading instanceof HTMLElement) { dialogLoading.hidden = false; dialogLoading.textContent = 'Cargando fotografía…'; }
    if (dialogTitle instanceof HTMLElement) dialogTitle.textContent = titulo;
    if (dialogPosition instanceof HTMLElement) dialogPosition.textContent = `${index + 1} de ${visibles.length}`;
    if (dialogPrevious instanceof HTMLButtonElement) dialogPrevious.disabled = index === 0;
    if (dialogNext instanceof HTMLButtonElement) dialogNext.disabled = index === visibles.length - 1;
    dialogImage.onload = () => {
      dialogImage.classList.add('ready');
      if (dialogLoading instanceof HTMLElement) dialogLoading.hidden = true;
      preload(index - 1); preload(index + 1);
    };
    dialogImage.onerror = () => { if (dialogLoading instanceof HTMLElement) dialogLoading.textContent = 'Non foi posible abrir a fotografía.'; };
    dialogImage.src = originalOf(foto);
    if (!dialog.open) dialog.showModal();
  }

  function card(foto) {
    const article = document.createElement('article');
    const titulo = titleOf(foto);
    const categoria = categoryOf(foto);
    const ano = String(foto?.ano || foto?.anoAproximado || foto?.AnoAproximado || '').trim();
    article.className = 'gallery-card';
    article.dataset.category = categoria;
    article.innerHTML = `<button class="gallery-image-button" type="button" aria-label="Ampliar ${esc(titulo)}"><span class="image-state">Cargando…</span><img src="${esc(thumbOf(foto))}" alt="${esc(titulo)}" loading="lazy" decoding="async" /></button><div class="gallery-content-box"><div class="gallery-meta"><span class="gallery-category">${esc(categoria)}</span>${ano ? `<time>${esc(ano)}</time>` : ''}</div><h2>${esc(titulo)}</h2></div>`;
    const image = article.querySelector('img');
    const imageState = article.querySelector('.image-state');
    image?.addEventListener('load', () => { article.classList.add('image-ready'); if (imageState instanceof HTMLElement) imageState.hidden = true; });
    image?.addEventListener('error', () => { article.classList.add('image-error'); if (imageState instanceof HTMLElement) imageState.textContent = 'Imaxe non dispoñible'; });
    article.querySelector('button')?.addEventListener('click', () => showViewer(visibles.indexOf(foto)));
    return article;
  }

  function applyFilter() {
    visibles = activeFilter === 'Todos' ? fotos : fotos.filter((foto) => categoryOf(foto) === activeFilter);
    grid?.replaceChildren(...visibles.map(card));
    if (count) count.textContent = `${visibles.length} fotografía${visibles.length === 1 ? '' : 's'}`;
    if (empty instanceof HTMLElement) empty.hidden = visibles.length > 0;
  }

  filterButtons.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.getAttribute('data-filter') || 'Todos';
    filterButtons.forEach((item) => item.classList.toggle('active', item === button));
    applyFilter();
  }));

  dialogClose?.addEventListener('click', () => dialog instanceof HTMLDialogElement && dialog.close());
  dialogPrevious?.addEventListener('click', () => showViewer(current - 1));
  dialogNext?.addEventListener('click', () => showViewer(current + 1));
  dialog?.addEventListener('click', (event) => { if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close(); });
  document.addEventListener('keydown', (event) => {
    if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return;
    if (event.key === 'ArrowLeft' && current > 0) showViewer(current - 1);
    if (event.key === 'ArrowRight' && current < visibles.length - 1) showViewer(current + 1);
  });

  async function loadGallery() {
    try {
      const response = await fetch('/api/galeria', { cache: 'default' });
      const data = await response.json();
      if (!response.ok || !data?.ok || !Array.isArray(data.fotos)) throw new Error(data?.erro || 'Erro ao cargar a galería');
      fotos = data.fotos.filter((foto) => originalOf(foto) && thumbOf(foto));
      applyFilter();
      if (status) status.textContent = '';
    } catch (error) {
      console.error(error);
      if (count) count.textContent = '0 fotografías';
      if (status) status.textContent = 'Non foi posible cargar a galería neste momento.';
      if (empty instanceof HTMLElement) empty.hidden = false;
    }
  }
  loadGallery();
</script>

<style is:global>
  .gallery-page-wrapper{padding-top:4rem;padding-bottom:6rem}.gallery-header{max-width:820px;margin:0 auto 2.4rem;text-align:center}.gallery-kicker{color:var(--color-principal);font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.gallery-header h1{margin:.5rem 0 0;color:var(--color-principal);font-size:clamp(2.15rem,5vw,3rem)}.section-line-center{width:58px;height:2px;margin:1rem auto 1.4rem;background:var(--color-acento)}.gallery-intro{margin:0;color:#625e5a;font-size:1.02rem;line-height:1.65}.gallery-filters{display:flex;justify-content:center;flex-wrap:wrap;gap:.65rem;margin-bottom:1.3rem}.filter-tag{padding:.48rem 1rem;border:1px solid #d7d1cd;border-radius:999px;background:#fff;color:#544f4b;font:inherit;font-size:.76rem;font-weight:700;letter-spacing:.045em;text-transform:uppercase;cursor:pointer}.filter-tag:hover,.filter-tag.active{border-color:var(--color-principal);background:var(--color-principal);color:#fff}.gallery-count,.gallery-status{margin:0 0 .5rem;color:#766f69;font-size:.78rem;text-align:right}.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:.9rem;align-items:start}.gallery-card{min-width:0;overflow:hidden;border:1px solid #ded9d5;border-radius:4px;background:#fff;box-shadow:0 5px 16px rgba(48,37,31,.05)}.gallery-image-button{position:relative;display:block;width:100%;aspect-ratio:4/3;padding:0;overflow:hidden;border:0;background:#eeeae7;cursor:zoom-in}.gallery-image-button img{display:block;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .2s ease,transform .25s ease}.gallery-card.image-ready img{opacity:1}.gallery-image-button:hover img{transform:scale(1.025)}.image-state{position:absolute;inset:0;display:grid;place-items:center;padding:.6rem;color:#766f69;font-size:.72rem}.gallery-card.image-error img{display:none}.gallery-content-box{padding:.65rem .75rem .8rem}.gallery-meta{display:flex;justify-content:space-between;gap:.7rem;margin-bottom:.35rem}.gallery-category{color:var(--color-principal);font-size:.61rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.gallery-meta time{color:#8b837d;font-size:.66rem}.gallery-content-box h2{display:-webkit-box;margin:0;overflow:hidden;color:#3b3734;font-size:.8rem;font-weight:650;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}.gallery-empty{padding:2rem;border:1px solid #ded9d5;color:#716a65;text-align:center}.gallery-dialog{width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:0;border:0;background:rgba(18,14,13,.94);color:#fff}.gallery-dialog::backdrop{background:rgba(18,14,13,.94)}.gallery-dialog figure{display:grid;width:min(1200px,calc(100vw - 150px));height:calc(100vh - 30px);margin:auto;grid-template-rows:minmax(0,1fr) auto}.dialog-image-wrap{position:relative;display:grid;min-height:240px;place-items:center}.gallery-dialog img{display:block;max-width:100%;max-height:calc(100vh - 95px);object-fit:contain;opacity:0;transition:opacity .2s}.gallery-dialog img.ready{opacity:1}.gallery-dialog figcaption{display:flex;justify-content:space-between;gap:1rem;padding:.7rem;color:#fff;font-size:.82rem}.dialog-close{position:absolute;z-index:3;top:1rem;right:1rem;width:2.7rem;height:2.7rem;border:0;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;font-size:1.8rem;cursor:pointer}.dialog-nav{position:absolute;z-index:2;top:50%;width:4rem;height:5rem;border:0;background:rgba(255,255,255,.08);color:#fff;font-size:3rem;cursor:pointer;transform:translateY(-50%)}.dialog-previous{left:0}.dialog-next{right:0}.dialog-nav:disabled{opacity:.2;cursor:default}@media(max-width:680px){.gallery-page-wrapper{padding-top:2.5rem;padding-bottom:4rem}.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.gallery-count,.gallery-status{text-align:center}.gallery-dialog figure{width:calc(100vw - 24px)}.dialog-nav{top:auto;bottom:3.5rem;width:3rem;height:3rem;border-radius:50%;font-size:2rem;transform:none}.dialog-previous{left:1rem}.dialog-next{right:1rem}}
</style>
