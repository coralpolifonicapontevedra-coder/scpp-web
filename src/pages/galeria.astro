---
import BaseLayout from '../layouts/Layout.astro';
import { fotosGaleria } from '../data/galeria-fotos.js';

const fotos = fotosGaleria
  .map((foto) => ({
    ...foto,
    miniatura: `https://drive.google.com/thumbnail?id=${foto.id}&sz=w900`,
    orixinal: `https://drive.google.com/thumbnail?id=${foto.id}&sz=w1800`
  }))
  .sort((a, b) => {
    const anoA = Number.parseInt(a.ano || '0', 10);
    const anoB = Number.parseInt(b.ano || '0', 10);
    if (anoA !== anoB) return anoB - anoA;
    return a.titulo.localeCompare(b.titulo, 'gl');
  });

const categorias = ['Todos', 'Concertos', 'Centenario', 'Distincións', 'Prensa', 'Histórico', 'Viaxes'];
---

<BaseLayout title="Galería" lang="gl">
  <main class="container gallery-page-wrapper">
    <header class="gallery-header">
      <span class="gallery-kicker">Arquivo visual da SCPP</span>
      <h1>Galería fotográfica</h1>
      <div class="section-line-center"></div>
      <p class="gallery-intro">Un percorrido pola actividade artística, institucional e histórica da Sociedade Coral Polifónica de Pontevedra.</p>
    </header>

    <nav class="gallery-filters" aria-label="Filtrar fotografías">
      {categorias.map((categoria, index) => (
        <button class:list={['filter-tag', { active: index === 0 }]} type="button" data-filter={categoria}>
          {categoria}
        </button>
      ))}
    </nav>

    <p id="gallery-count" class="gallery-count">{fotos.length} fotografías</p>

    <section class="gallery-grid" aria-live="polite">
      {fotos.map((foto) => (
        <article class:list={['gallery-card', { 'is-document': foto.documento }]} data-category={foto.categoria}>
          <button
            class="gallery-image-button"
            type="button"
            data-image={foto.orixinal}
            data-title={foto.titulo}
            aria-label={`Ampliar ${foto.titulo}`}
          >
            <img src={foto.miniatura} alt={foto.titulo} loading="lazy" decoding="async" />
            <span class="zoom-hint" aria-hidden="true">Ampliar</span>
          </button>
          <div class="gallery-content-box">
            <div class="gallery-meta">
              <span class="gallery-category">{foto.categoria}</span>
              {foto.ano && <time>{foto.ano}</time>}
            </div>
            <h2>{foto.titulo}</h2>
          </div>
        </article>
      ))}
    </section>

    <p id="gallery-empty" class="gallery-empty" hidden>Non hai fotografías nesta categoría.</p>
  </main>

  <dialog id="gallery-dialog" class="gallery-dialog">
    <button id="dialog-close" class="dialog-close" type="button" aria-label="Pechar imaxe">×</button>
    <figure>
      <img id="dialog-image" src="" alt="" />
      <figcaption id="dialog-title"></figcaption>
    </figure>
  </dialog>
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
  const cards = Array.from(document.querySelectorAll('.gallery-card'));
  const count = document.querySelector('#gallery-count');
  const empty = document.querySelector('#gallery-empty');
  const dialog = document.querySelector('#gallery-dialog');
  const dialogImage = document.querySelector('#dialog-image');
  const dialogTitle = document.querySelector('#dialog-title');
  const dialogClose = document.querySelector('#dialog-close');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter') || 'Todos';
      filterButtons.forEach((item) => item.classList.toggle('active', item === button));

      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'Todos' || card.getAttribute('data-category') === filter;
        card.toggleAttribute('hidden', !show);
        if (show) visible += 1;
      });

      if (count) count.textContent = `${visible} fotografía${visible === 1 ? '' : 's'}`;
      if (empty instanceof HTMLElement) empty.hidden = visible > 0;
    });
  });

  document.querySelectorAll('[data-image]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(dialog instanceof HTMLDialogElement) || !(dialogImage instanceof HTMLImageElement)) return;
      const image = button.getAttribute('data-image') || '';
      const title = button.getAttribute('data-title') || '';
      dialogImage.src = image;
      dialogImage.alt = title;
      if (dialogTitle) dialogTitle.textContent = title;
      dialog.showModal();
    });
  });

  dialogClose?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
</script>

<style>
  .gallery-page-wrapper { padding-top:4rem; padding-bottom:6rem; }
  .gallery-header { max-width:820px; margin:0 auto 2.4rem; text-align:center; }
  .gallery-kicker { color:var(--color-principal); font-size:.72rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .gallery-header h1 { margin:.5rem 0 0; color:var(--color-principal); font-size:clamp(2.15rem,5vw,3rem); }
  .section-line-center { width:58px; height:2px; margin:1rem auto 1.4rem; background:var(--color-acento); }
  .gallery-intro { margin:0; color:#625e5a; font-size:1.02rem; line-height:1.65; }

  .gallery-filters { display:flex; justify-content:center; flex-wrap:wrap; gap:.65rem; margin-bottom:1.3rem; }
  .filter-tag { padding:.48rem 1rem; border:1px solid #d7d1cd; border-radius:999px; background:#fff; color:#544f4b; font:inherit; font-size:.76rem; font-weight:700; letter-spacing:.045em; text-transform:uppercase; cursor:pointer; transition:background .2s ease,color .2s ease,border-color .2s ease; }
  .filter-tag:hover,.filter-tag.active { border-color:var(--color-principal); background:var(--color-principal); color:#fff; }
  .gallery-count { margin:0 0 1.3rem; color:#766f69; font-size:.78rem; text-align:right; }

  .gallery-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(245px,1fr)); gap:1.25rem; }
  .gallery-card { overflow:hidden; border:1px solid #ded9d5; border-radius:4px; background:#fff; transition:transform .2s ease,box-shadow .2s ease; }
  .gallery-card:hover { transform:translateY(-3px); box-shadow:0 10px 26px rgba(38,28,24,.08); }
  .gallery-card[hidden] { display:none; }

  .gallery-image-button { position:relative; display:block; width:100%; height:220px; padding:0; overflow:hidden; border:0; background:#eeeae7; cursor:zoom-in; }
  .gallery-image-button img { width:100%; height:100%; object-fit:cover; transition:transform .35s ease; }
  .gallery-card:hover img { transform:scale(1.025); }
  .gallery-card.is-document .gallery-image-button { background:#f5f2ed; }
  .gallery-card.is-document .gallery-image-button img { padding:.65rem; object-fit:contain; }
  .gallery-card.is-document:hover img { transform:none; }
  .zoom-hint { position:absolute; right:.8rem; bottom:.8rem; padding:.3rem .55rem; border-radius:2px; background:rgba(50,31,34,.78); color:#fff; font-size:.68rem; font-weight:700; opacity:0; transform:translateY(4px); transition:opacity .2s ease,transform .2s ease; }
  .gallery-image-button:hover .zoom-hint,.gallery-image-button:focus-visible .zoom-hint { opacity:1; transform:translateY(0); }

  .gallery-content-box { padding:.9rem 1rem 1.05rem; }
  .gallery-meta { display:flex; justify-content:space-between; gap:1rem; align-items:center; margin-bottom:.45rem; }
  .gallery-category { color:var(--color-principal); font-size:.65rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .gallery-meta time { color:#8b837d; font-size:.7rem; }
  .gallery-content-box h2 { margin:0; color:#3b3734; font-size:.94rem; font-weight:650; line-height:1.42; }
  .gallery-empty { padding:2rem; border:1px solid #ded9d5; color:#716a65; text-align:center; }

  .gallery-dialog { width:min(94vw,1100px); max-height:92vh; padding:0; overflow:visible; border:0; background:transparent; }
  .gallery-dialog::backdrop { background:rgba(18,14,13,.88); }
  .gallery-dialog figure { margin:0; }
  .gallery-dialog img { display:block; width:100%; max-height:82vh; object-fit:contain; background:#171313; }
  .gallery-dialog figcaption { padding:.85rem 1rem; background:#fff; color:#3c3734; font-size:.88rem; text-align:center; }
  .dialog-close { position:absolute; z-index:2; top:-2.6rem; right:0; width:2.2rem; height:2.2rem; border:1px solid rgba(255,255,255,.65); border-radius:50%; background:rgba(0,0,0,.28); color:#fff; font-size:1.5rem; line-height:1; cursor:pointer; }

  @media(max-width:680px) {
    .gallery-page-wrapper { padding-top:2.5rem; padding-bottom:4rem; }
    .gallery-grid { grid-template-columns:1fr; gap:1rem; }
    .gallery-image-button { height:235px; }
    .gallery-count { text-align:center; }
  }
</style>
