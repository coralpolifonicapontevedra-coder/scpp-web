          <div id="history-summary" class="history-summary-badge" aria-live="polite">Cargando o arquivo…</div>
          <div class="history-actions-row">
            <button id="show-all-history" type="button" class="btn-history">Ver todo o histórico</button>
            <a href="/arquivos/publico/documentos/concertos_scpp_1925_2026.pdf" download="concertos_scpp_1925_2026.pdf" class="btn-history">Descargar histórico (.pdf)</a>
          </div>
        </header>

