    letter-spacing: -0.035em;
    text-shadow: 0 3px 20px rgba(0, 0, 0, 0.38);
  }

  .hero-lead {
    max-width: 720px;
    margin: 1.6rem auto 0;
    color: rgba(255, 255, 255, 0.94);
    font-size: 1.08rem;
    line-height: 1.7;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.42);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.9rem;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
