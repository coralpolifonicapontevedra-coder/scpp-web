---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Histórico de concertos" lang="gl">
  <main class="history-page container">
    <header class="history-hero">
      <p class="eyebrow">Arquivo histórico</p>
      <h1>Un século de concertos</h1>
      <div class="section-line-center"></div>
      <p>Explora por décadas a actividade concertística da Sociedade Coral Polifónica de Pontevedra desde 1925.</p>
      <div id="history-summary" class="history-summary" aria-live="polite">Cargando o arquivo…</div>
      <div class="history-actions">
        <button id="show-all-history" type="button">Ver todo o histórico</button>
        <a href="/documentos/concertos_scpp_1925_2026.pdf" download="concertos_scpp_1925_2026.pdf">Descargar histórico (.pdf)</a>
      </div>
    </header>

    <section id="arquivo-completo" class="history-browser" aria-labelledby="browser-title">
      <div class="history-toolbar">
        <div>
          <p class="eyebrow">Consulta</p>
          <h2 id="browser-title">Concertos por décadas</h2>
        </div>
        <label class="history-search">
          <span class="sr-only">Buscar no histórico</span>
          <input id="history-search" type="search" placeholder="Buscar ano, número, concerto, cidade ou lugar" autocomplete="off" />
        </label>
      </div>
      
      <!-- Contenedor vertical forzado -->
      <div id="history-years" style="display: flex; flex-direction: column; gap: 1.25rem; width: 100%;"></div>
      
      <p id="history-empty" class="history-state" hidden>Non hai concertos que coincidan coa busca.</p>
      <p id="history-error" class="history-state error" hidden>Non foi posible cargar o histórico. Téntao de novo nuns instantes.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const endpoint = '/api/concertos-historico';
  const years = document.querySelector('#history-years');
  const summary = document.querySelector('#history-summary');
  const search = document.querySelector('#history-search');
  const empty = document.querySelector('#history-empty');
  const errorState = document.querySelector('#history-error');
  const showAll = document.querySelector('#show-all-history');
  let concertos = [];

  const normalizar = (value = '') => String(value)
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();

  const escapar = (value = '') => String(value)
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

  const formatarData = (concerto) => {
    if (concerto.dataTextoHistorica) return concerto.dataTextoHistorica;
    if (!concerto.data) return 'Data non documentada';
    const date = new Date(concerto.data + 'T12:00:00');
    return Number.isNaN(date.getTime())
      ? concerto.data
      : new Intl.DateTimeFormat('gl-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
  };

  const inicioPeriodo = (ano) => 1925 + Math.floor((Number(ano) - 1925) / 10) * 10;
  const etiquetaPeriodo = (inicio) => `${inicio}–${Math.min(inicio + 9, 2026)}`;
  const nomeXenerico = (concerto) => {
    const nome = normalizar(concerto.nome).replaceAll(' ', '');
    const numero = normalizar(concerto.numeroConcerto).replaceAll(' ', '');
    return nome === `concerto nº ${numero}`.replaceAll(' ', '')
      || nome === `concerto n.º ${numero}`.replaceAll(' ', '')
      || nome === `concerto numero ${numero}`.replaceAll(' ', '');
  };
  const descricionConcerto = (concerto) =>
    concerto.descricion || (nomeXenerico(concerto) ? '' : concerto.nome) || 'Sen descrición documentada';

  function debuxar() {
    if (!(years instanceof HTMLElement)) return;
    const query = normalizar(search instanceof HTMLInputElement ? search.value : '');
    const exactYear = /^\d{4}$/.test(query);
    const filtered = concertos.filter((concerto) => {
      if (exactYear) return String(concerto.ano || '') === query;
      return !query || normalizar([
        concerto.ano, concerto.numeroConcerto, concerto.data, concerto.dataTextoHistorica,
        concerto.nome, concerto.cidade, concerto.lugar, concerto.descricion
      ].join(' ')).includes(query);
    });

    const grouped = new Map();
    filtered.forEach((concerto) => {
      const ano = Number(concerto.ano);
      const periodo = Number.isFinite(ano) ? inicioPeriodo(ano) : 'Sen data';
      if (!grouped.has(periodo)) grouped.set(periodo, []);
      grouped.get(periodo).push(concerto);
    });
    const periodos = Array.from(grouped.keys()).sort((a, b) => {
      if (a === 'Sen data') return 1;
      if (b === 'Sen data') return -1;
      return Number(a) - Number(b);
    });

    const isOpen = query.length > 0 ? 'open' : '';

    years.innerHTML = periodos.map((periodo) => {
      const items = grouped.get(periodo).sort((a, b) => (Number(a.ordeHistorica) || 0) - (Number(b.ordeHistorica) || 0));
      const etiqueta = periodo === 'Sen data' ? periodo : `Década de ${etiquetaPeriodo(periodo)}`;
      
      return `<details class="card-decada" ${isOpen} style="width: 100%; background: #ffffff; border: 1px solid #e2ddd7; border-radius: 6px; overflow: hidden; margin-bottom: 0.5rem;">
        <summary style="display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 1.4rem; background: #faf8f5; cursor: pointer; user-select: none; list-style: none;">
          <div style="display: flex; flex-direction: column; gap: 0.2rem;">
            <span style="font-size: 0.65rem; font-weight: 800; color: #a3821a; text-transform: uppercase; letter-spacing: 0.08em;">Período histórico</span>
            <strong style="font-family: Georgia, serif; font-size: 1.25rem; color: #5c1926;">${escapar(etiqueta)}</strong>
          </div>
          <div style="display: flex; align-items: center; gap: 1rem;">
            <span style="font-size: 0.78rem; font-weight: 700; color: #555; background: #eae4d9; padding: 0.25rem 0.75rem; border-radius: 12px;">${items.length} concertos</span>
            <span style="font-size: 0.8rem; color: #5c1926;">▼</span>
          </div>
        </summary>
        <div style="width: 100%; overflow-x: auto; border-top: 1px solid #e2ddd7; background: #fff;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
            <thead>
              <tr style="background: #fcfbf9; border-bottom: 2px solid #e2ddd7;">
                <th style="padding: 0.8rem 1rem; color: #5c1926; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; width: 8%;">Nº</th>
                <th style="padding: 0.8rem 1rem; color: #5c1926; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; width: 18%;">Data</th>
                <th style="padding: 0.8rem 1rem; color: #5c1926; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; width: 18%;">Localidade</th>
                <th style="padding: 0.8rem 1rem; color: #5c1926; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; width: 24%;">Lugar</th>
                <th style="padding: 0.8rem 1rem; color: #5c1926; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; width: 32%;">Descrición</th>
              </tr>
            </thead>
            <tbody>
              ${items.map((concerto) => `<tr style="border-bottom: 1px solid #f0ebe3;">
                <td data-label="Nº" style="padding: 0.8rem 1rem; color: #a3821a; font-weight: 800; vertical-align: top;">${escapar(concerto.numeroConcerto || '—')}</td>
                <td data-label="Data" style="padding: 0.8rem 1rem; font-weight: 600; white-space: nowrap; vertical-align: top;">${escapar(formatarData(concerto))}</td>
                <td data-label="Localidade" style="padding: 0.8rem 1rem; vertical-align: top;">${escapar(concerto.cidade || '—')}</td>
                <td data-label="Lugar" style="padding: 0.8rem 1rem; vertical-align: top;"><strong>${escapar(concerto.lugar || '—')}</strong></td>
                <td data-label="Descrición" style="padding: 0.8rem 1rem; vertical-align: top; color: #444;">${escapar(descricionConcerto(concerto))}</td>
              </tr>`).join('')}
            </tbody>
          </table>
        </div>
      </details>`;
    }).join('');

    if (summary instanceof HTMLElement) summary.textContent = `${filtered.length} concerto${filtered.length === 1 ? '' : 's'} documentado${filtered.length === 1 ? '' : 's'} · ${periodos.length} ${periodos.length === 1 ? 'década' : 'décadas'}`;
    if (empty instanceof HTMLElement) empty.hidden = filtered.length > 0;
  }

  async function cargar() {
    try {
      const response = await fetch(endpoint, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      if (!data?.ok || !Array.isArray(data.concertos)) throw new Error('Índice non válido');
      concertos = data.concertos;
      debuxar();
    } catch {
      if (summary instanceof HTMLElement) summary.textContent = 'Arquivo temporalmente non dispoñible';
      if (errorState instanceof HTMLElement) errorState.hidden = false;
    }
  }

  search?.addEventListener('input', debuxar);
  showAll?.addEventListener('click', () => {
    if (search instanceof HTMLInputElement) search.value = '';
    debuxar();
    document.querySelector('#arquivo-completo')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  cargar();
</script>

<style>
  .history-page { padding-block: clamp(3rem, 5vw, 5rem); }
  .history-hero { max-width: 850px; margin: 0 auto 3rem; text-align: center; }
  .eyebrow { margin: 0 0 .4rem; color: #a3821a; font-size: .75rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .history-hero h1 { margin: .25rem 0; color: #5c1926; font-size: clamp(2.2rem, 4vw, 3.5rem); font-family: Georgia, serif; }
  .history-hero > p:not(.eyebrow) { max-width: 680px; margin: 1rem auto 0; color: #555; line-height: 1.6; }
  .section-line-center { width: 60px; height: 2px; margin: 1rem auto; background: #a3821a; }
  .history-summary { display: inline-block; margin-top: 1.2rem; padding: .5rem 1rem; color: #5c1926; background: #f4f0e8; font-size: .85rem; font-weight: 700; border-radius: 4px; }
  
  .history-browser { max-width: 1000px; margin: auto; }
  .history-toolbar { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #e0d9d0; }
  .history-toolbar h2 { margin: 0; color: #5c1926; font-size: 1.8rem; font-family: Georgia, serif; }
  .history-search { width: min(100%, 380px); }
  .history-search input { width: 100%; box-sizing: border-box; padding: .75rem 1rem; border: 1px solid #ccc; background: #fff; font: inherit; font-size: .9rem; border-radius: 4px; }
  .history-actions { display: flex; justify-content: center; gap: 1rem; margin-top: 1.2rem; }
  .history-actions a, .history-actions button { padding: .75rem 1.25rem; border: 1px solid #5c1926; background: #fff; color: #5c1926; font-weight: 700; font-size: .8rem; text-decoration: none; cursor: pointer; border-radius: 4px; transition: all .2s; }
  .history-actions a:hover, .history-actions button:hover { background: #5c1926; color: #fff; }

  summary::-webkit-details-marker { display: none !important; }

  .history-state { padding: 1.4rem; background: #f5f2ed; text-align: center; border-radius: 4px; }
  .history-state.error { color: #7a2525; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  [hidden] { display: none !important; }

  @media (max-width: 680px) {
    .history-toolbar { flex-direction: column; align-items: stretch; }
    .history-search { width: 100%; }
  }
</style>