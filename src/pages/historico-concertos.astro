---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Histórico de concertos" lang="gl">
  <main class="history-page container">
    <header class="history-hero">
      <p class="eyebrow">Arquivo histórico</p>
      <h1>Un século de concertos</h1>
      <div class="section-line-center"></div>
      <p>Explora por décadas a actividade concertística da Sociedade Coral Polifónica de Pontevedra desde 1925.</p>
      <div id="history-summary" class="history-summary" aria-live="polite">Cargando o arquivo…</div>
      <div class="history-actions">
        <button id="show-all-history" type="button">Ver todo o histórico</button>
        <a href="/documentos/historico-concertos-scpp-1925-2026.pdf" download>Descargar histórico (.pdf)</a>
      </div>
    </header>

    <section id="arquivo-completo" class="history-browser" aria-labelledby="browser-title">
      <div class="history-toolbar">
        <div>
          <p class="eyebrow">Consulta</p>
          <h2 id="browser-title">Concertos por décadas</h2>
        </div>
        <label class="history-search">
          <span class="sr-only">Buscar no histórico</span>
          <input id="history-search" type="search" placeholder="Buscar ano, número, concerto, cidade ou lugar" autocomplete="off" />
        </label>
      </div>
      <div id="history-years" class="history-years"></div>
      <p id="history-empty" class="history-state" hidden>Non hai concertos que coincidan coa busca.</p>
      <p id="history-error" class="history-state error" hidden>Non foi posible cargar o histórico. Téntao de novo nuns instantes.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const endpoint = '/api/concertos-historico';
  const years = document.querySelector('#history-years');
  const summary = document.querySelector('#history-summary');
  const search = document.querySelector('#history-search');
  const empty = document.querySelector('#history-empty');
  const errorState = document.querySelector('#history-error');
  const showAll = document.querySelector('#show-all-history');
  let concertos = [];

  const normalizar = (value = '') => String(value)
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();

  const escapar = (value = '') => String(value)
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

  const formatarData = (concerto) => {
    if (concerto.dataTextoHistorica) return concerto.dataTextoHistorica;
    if (!concerto.data) return 'Data non documentada';
    const date = new Date(concerto.data + 'T12:00:00');
    return Number.isNaN(date.getTime())
      ? concerto.data
      : new Intl.DateTimeFormat('gl-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
  };

  const inicioPeriodo = (ano) => 1925 + Math.floor((Number(ano) - 1925) / 10) * 10;
  const etiquetaPeriodo = (inicio) => `${inicio}–${Math.min(inicio + 9, 2026)}`;
  const nomeXenerico = (concerto) => {
    const nome = normalizar(concerto.nome).replaceAll(' ', '');
    const numero = normalizar(concerto.numeroConcerto).replaceAll(' ', '');
    return nome === `concerto nº ${numero}`.replaceAll(' ', '')
      || nome === `concerto n.º ${numero}`.replaceAll(' ', '')
      || nome === `concerto numero ${numero}`.replaceAll(' ', '');
  };
  const descricionConcerto = (concerto) =>
    concerto.descricion || (nomeXenerico(concerto) ? '' : concerto.nome) || 'Sen descrición documentada';

  function debuxar() {
    if (!(years instanceof HTMLElement)) return;
    const query = normalizar(search instanceof HTMLInputElement ? search.value : '');
    const exactYear = /^\d{4}$/.test(query);
    const filtered = concertos.filter((concerto) => {
      if (exactYear) return String(concerto.ano || '') === query;
      return !query || normalizar([
        concerto.ano, concerto.numeroConcerto, concerto.data, concerto.dataTextoHistorica,
        concerto.nome, concerto.cidade, concerto.lugar, concerto.descricion
      ].join(' ')).includes(query);
    });

    const grouped = new Map();
    filtered.forEach((concerto) => {
      const ano = Number(concerto.ano);
      const periodo = Number.isFinite(ano) ? inicioPeriodo(ano) : 'Sen data';
      if (!grouped.has(periodo)) grouped.set(periodo, []);
      grouped.get(periodo).push(concerto);
    });
    const periodos = Array.from(grouped.keys()).sort((a, b) => {
      if (a === 'Sen data') return 1;
      if (b === 'Sen data') return -1;
      return Number(a) - Number(b);
    });

    // Abrir automáticamente las viñetas si el usuario está realizando una búsqueda
    const isOpen = query.length > 0 ? 'open' : '';

    years.innerHTML = periodos.map((periodo) => {
      const items = grouped.get(periodo).sort((a, b) => (Number(a.ordeHistorica) || 0) - (Number(b.ordeHistorica) || 0));
      const etiqueta = periodo === 'Sen data' ? periodo : etiquetaPeriodo(periodo);
      return `<details class="period-block" ${isOpen} name="periodos-historicos">
        <summary class="period-heading">
          <span class="period-title"><small>Período histórico</small><strong>${escapar(etiqueta)}</strong></span>
          <span class="period-count"><strong>${items.length}</strong> concerto${items.length === 1 ? '' : 's'}</span>
          <span class="period-toggle">Ver concertos <b aria-hidden="true">+</b></span>
        </summary>
        <div class="history-table-wrap">
          <table class="history-table">
            <thead><tr><th>Nº</th><th>Data</th><th>Localidade</th><th>Lugar</th><th>Descrición</th></tr></thead>
            <tbody>${items.map((concerto) => `<tr>
              <td data-label="Nº" class="col-num">${escapar(concerto.numeroConcerto || '—')}</td>
              <td data-label="Data" class="col-data">${escapar(formatarData(concerto))}</td>
              <td data-label="Localidade" class="col-loc">${escapar(concerto.cidade || '—')}</td>
              <td data-label="Lugar" class="col-lugar">${escapar(concerto.lugar || '—')}</td>
              <td data-label="Descrición" class="col-desc">${escapar(descricionConcerto(concerto))}</td>
            </tr>`).join('')}</tbody>
          </table>
        </div>
      </details>`;
    }).join('');

    if (summary instanceof HTMLElement) summary.textContent = `${filtered.length} concerto${filtered.length === 1 ? '' : 's'} documentado${filtered.length === 1 ? '' : 's'} · ${periodos.length} ${periodos.length === 1 ? 'período' : 'períodos'}`;
    if (empty instanceof HTMLElement) empty.hidden = filtered.length > 0;
  }

  async function cargar() {
    try {
      const response = await fetch(endpoint, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      if (!data?.ok || !Array.isArray(data.concertos)) throw new Error('Índice non válido');
      concertos = data.concertos;
      debuxar();
    } catch {
      if (summary instanceof HTMLElement) summary.textContent = 'Arquivo temporalmente non dispoñible';
      if (errorState instanceof HTMLElement) errorState.hidden = false;
    }
  }

  search?.addEventListener('input', debuxar);
  showAll?.addEventListener('click', () => {
    if (search instanceof HTMLInputElement) search.value = '';
    debuxar();
    document.querySelector('#arquivo-completo')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  cargar();
</script>

<style>
  .history-page { padding-block:clamp(3rem,7vw,6rem); }
  .history-hero { max-width:850px; margin:0 auto clamp(3rem,6vw,5rem); text-align:center; }
  .eyebrow { margin:0 0 .4rem; color:var(--color-acento); font-size:.74rem; font-weight:800; letter-spacing:.15em; text-transform:uppercase; }
  .history-hero h1 { margin:.25rem 0; color:var(--color-principal); font-size:clamp(2.2rem,5vw,4rem); }
  .history-hero > p:not(.eyebrow) { max-width:680px; margin:1.1rem auto 0; color:#625c57; line-height:1.7; }
  .section-line-center { width:70px; height:2px; margin:1rem auto; background:var(--color-acento); }
  .history-summary { display:inline-block; margin-top:1.5rem; padding:.65rem 1rem; color:var(--color-principal); background:#f4f0e8; font-size:.82rem; font-weight:700; }
  .history-browser { max-width:1120px; margin:auto; }
  .history-toolbar { display:flex; justify-content:space-between; align-items:end; gap:1.5rem; margin-bottom:1.5rem; padding-bottom:1rem; border-bottom:1px solid #ded8d1; }
  .history-toolbar h2 { margin:.1rem 0 0; color:var(--color-principal); font-size:clamp(1.45rem,3vw,2rem); }
  .history-search { width:min(100%,430px); }
  .history-search input { box-sizing:border-box; width:100%; min-height:46px; padding:.7rem .9rem; border:1px solid #cfc7bf; background:#fff; color:#302b27; font:inherit; }
  .history-search input:focus { outline:2px solid var(--color-acento); outline-offset:2px; }
  .history-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:.75rem; margin-top:1rem; }
  .history-actions a,.history-actions button { min-height:44px; padding:.72rem 1rem; border:1px solid var(--color-principal); background:#fff; color:var(--color-principal); font:inherit; font-size:.78rem; font-weight:800; text-decoration:none; cursor:pointer; }
  .history-actions a:hover,.history-actions button:hover { background:var(--color-principal); color:#fff; }
  
  .history-years { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1rem; align-items:start; }
  .period-block { min-width:0; border:1px solid #d8d1c9; background:#fff; box-shadow:0 4px 12px rgba(54,42,36,.03); transition:border-color .2s; }
  .period-block[open] { grid-column:1/-1; border-color:var(--color-acento); box-shadow:0 8px 24px rgba(54,42,36,.07); }
  
  .period-heading { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.65rem 1rem; padding:1.1rem 1.25rem; list-style:none; cursor:pointer; background:#faf8f5; transition:background .18s; }
  .period-heading::-webkit-details-marker { display:none; }
  .period-heading:hover { background:#f2ede4; }
  .period-title { display:grid; gap:.15rem; min-width:0; }
  .period-title small { color:#967328; font-size:.65rem; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }
  .period-title>strong { color:var(--color-principal); font-family:Georgia,serif; font-size:1.35rem; }
  .period-count { align-self:center; color:#69625c; font-size:.75rem; text-align:right; }
  .period-count strong { color:#2e2925; font-size:.95rem; }
  .period-toggle { display:flex; grid-column:1/-1; justify-content:space-between; align-items:center; gap:.75rem; padding-top:.55rem; border-top:1px solid #ece5dc; color:var(--color-principal); font-size:.68rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; }
  .period-toggle b { color:var(--color-acento); font-size:1.15rem; line-height:1; transition:transform .18s; }
  .period-block[open] .period-toggle b { transform:rotate(45deg); }

  /* Estilos de la tabla tipo Informe de Asistencia */
  .history-table-wrap { width:100%; overflow-x:auto; border-top:1px solid #d8d1c9; background:#fff; }
  .history-table { width:100%; border-collapse:collapse; text-align:left; font-size:.85rem; }
  .history-table th,.history-table td { padding:.75rem 1rem; border-bottom:1px solid #eee9e4; line-height:1.45; vertical-align:top; }
  .history-table th { color:var(--color-principal); background:#fcfbf9; font-size:.7rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; border-bottom:2px solid #e2ddd7; }
  .history-table tr:hover { background-color:#faf8f5; }
  
  .history-table .col-num { width:60px; color:var(--color-acento); font-weight:800; text-align:center; }
  .history-table .col-data { width:140px; font-weight:600; color:#222; white-space:nowrap; }
  .history-table .col-loc { width:150px; font-weight:600; color:#444; }
  .history-table .col-lugar { width:220px; color:#555; }
  .history-table .col-desc { color:#666; }
  
  .history-table tr:last-child td { border-bottom:0; }
  .history-state { padding:1.4rem; background:#f5f2ed; text-align:center; }
  .history-state.error { color:#7a2525; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  [hidden] { display:none !important; }

  @media (max-width:768px) {
    .history-page { padding-inline:1rem; }
    .history-toolbar { align-items:stretch; flex-direction:column; }
    .history-search { width:100%; }
    .history-actions { align-items:stretch; flex-direction:column; }
    .history-actions a,.history-actions button { box-sizing:border-box; width:100%; text-align:center; }
    .history-table,.history-table tbody,.history-table tr,.history-table td { display:block; width:100%; box-sizing:border-box; }
    .history-table thead { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }
    .history-table tr { display:grid; gap:.4rem; padding:1rem; border-bottom:1px solid #ded8d1; }
    .history-table tr:last-child { border-bottom:0; }
    .history-table td,.history-table td:nth-child(n) { display:grid; grid-template-columns:100px minmax(0,1fr); gap:.5rem; width:100%; padding:0; border:0; text-align:left; }
    .history-table td::before { content:attr(data-label); color:var(--color-principal); font-size:.68rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; }
  }
</style>