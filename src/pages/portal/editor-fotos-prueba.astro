---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Editor de fotografías" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="revisar" logoutId="editor-logout" />
    <main class="editor-main">
      <header class="editor-header">
        <div>
          <span>Laboratorio fotográfico</span>
          <h1>Editor de fotografías</h1>
          <p>Proba de edición non destrutiva: o orixinal consérvase e a nova versión gárdase en R2.</p>
        </div>
      </header>

      <section id="editor-state" class="editor-state">Comprobando permisos e fotografías pendentes…</section>

      <section id="editor-shell" hidden>
        <div class="editor-selector">
          <label><span>Fotografía pendente</span><select id="photo-select"></select></label>
          <button id="load-photo" type="button">Cargar fotografía</button>
        </div>

        <div class="editor-grid">
          <section class="canvas-panel" aria-label="Área de edición">
            <div id="canvas-wrap" class="canvas-wrap">
              <canvas id="editor-canvas"></canvas>
              <div id="crop-box" class="crop-box" hidden></div>
            </div>
          </section>

          <aside class="tools-panel">
            <section>
              <h2>Orientación</h2>
              <div class="tool-grid">
                <button data-tool="rotate-left" type="button">↺ Girar esquerda</button>
                <button data-tool="rotate-right" type="button">↻ Girar dereita</button>
                <button data-tool="flip-x" type="button">↔ Voltear horizontal</button>
                <button data-tool="flip-y" type="button">↕ Voltear vertical</button>
              </div>
            </section>

            <section>
              <h2>Recorte</h2>
              <p>Preme «Seleccionar recorte» e arrastra un rectángulo sobre a imaxe.</p>
              <div class="tool-grid">
                <button id="start-crop" type="button">✂ Seleccionar recorte</button>
                <button id="apply-crop" type="button" disabled>Aplicar recorte</button>
              </div>
            </section>

            <section>
              <h2>Resultado</h2>
              <div class="tool-grid">
                <button id="reset-photo" type="button">Restablecer orixinal</button>
                <button id="save-photo" class="primary" type="button">Gardar versión editada</button>
              </div>
            </section>

            <p id="editor-message" class="editor-message" role="status" aria-live="polite"></p>
          </aside>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const state = document.querySelector('#editor-state');
  const shell = document.querySelector('#editor-shell');
  const select = document.querySelector('#photo-select');
  const canvas = document.querySelector('#editor-canvas');
  const wrap = document.querySelector('#canvas-wrap');
  const cropBox = document.querySelector('#crop-box');
  const startCrop = document.querySelector('#start-crop');
  const applyCrop = document.querySelector('#apply-crop');
  const resetButton = document.querySelector('#reset-photo');
  const saveButton = document.querySelector('#save-photo');
  const message = document.querySelector('#editor-message');
  const logout = document.querySelector('#editor-logout');

  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
  let fotos = [];
  let actual = null;
  let original = null;
  let mimeType = 'image/jpeg';
  let idToken = '';
  let flipX = 1;
  let flipY = 1;
  let cropMode = false;
  let cropStart = null;
  let cropRect = null;

  const texto = (v='') => String(v ?? '').trim();
  const escapar = (v='') => texto(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');

  function setMessage(value='', error=false) {
    if (!(message instanceof HTMLElement)) return;
    message.textContent = value;
    message.dataset.error = error ? 'true' : 'false';
  }

  async function api(url, body) {
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, ...body })
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || `HTTP ${response.status}`);
    return result;
  }

  function fitCanvas(image) {
    if (!(canvas instanceof HTMLCanvasElement) || !ctx) return;
    const maxW = 1500;
    const maxH = 1100;
    const scale = Math.min(1, maxW / image.width, maxH / image.height);
    canvas.width = Math.max(1, Math.round(image.width * scale));
    canvas.height = Math.max(1, Math.round(image.height * scale));
    ctx.setTransform(1,0,0,1,0,0);
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.translate(canvas.width / 2, canvas.height / 2);
    ctx.scale(flipX, flipY);
    ctx.drawImage(image, -canvas.width / 2, -canvas.height / 2, canvas.width, canvas.height);
    ctx.setTransform(1,0,0,1,0,0);
  }

  function imageFromCanvas() {
    return new Promise((resolve, reject) => {
      if (!(canvas instanceof HTMLCanvasElement)) return reject(new Error('Canvas non dispoñible'));
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error('Non se puido reconstruír a imaxe'));
      img.src = canvas.toDataURL(mimeType, 0.92);
    });
  }

  async function rotate(degrees) {
    if (!(canvas instanceof HTMLCanvasElement) || !ctx) return;
    const source = await imageFromCanvas();
    const swap = Math.abs(degrees) % 180 === 90;
    const w = swap ? source.height : source.width;
    const h = swap ? source.width : source.height;
    const temp = document.createElement('canvas');
    temp.width = w; temp.height = h;
    const t = temp.getContext('2d');
    if (!t) return;
    t.translate(w/2,h/2); t.rotate(degrees * Math.PI / 180); t.drawImage(source,-source.width/2,-source.height/2);
    canvas.width = w; canvas.height = h;
    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,w,h); ctx.drawImage(temp,0,0);
    flipX = 1; flipY = 1;
  }

  async function flip(axis) {
    if (!(canvas instanceof HTMLCanvasElement) || !ctx) return;
    const source = await imageFromCanvas();
    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.translate(canvas.width/2,canvas.height/2);
    ctx.scale(axis === 'x' ? -1 : 1, axis === 'y' ? -1 : 1);
    ctx.drawImage(source,-canvas.width/2,-canvas.height/2);
    ctx.setTransform(1,0,0,1,0,0);
  }

  function resetCrop() {
    cropMode = false; cropStart = null; cropRect = null;
    if (cropBox instanceof HTMLElement) cropBox.hidden = true;
    if (applyCrop instanceof HTMLButtonElement) applyCrop.disabled = true;
    if (wrap instanceof HTMLElement) wrap.classList.remove('is-cropping');
  }

  function pointerPosition(event) {
    if (!(canvas instanceof HTMLCanvasElement)) return { x:0, y:0 };
    const rect = canvas.getBoundingClientRect();
    return {
      x: Math.max(0, Math.min(rect.width, event.clientX - rect.left)),
      y: Math.max(0, Math.min(rect.height, event.clientY - rect.top))
    };
  }

  function drawCropBox() {
    if (!(cropBox instanceof HTMLElement) || !cropRect) return;
    cropBox.hidden = false;
    cropBox.style.left = `${cropRect.x}px`;
    cropBox.style.top = `${cropRect.y}px`;
    cropBox.style.width = `${cropRect.w}px`;
    cropBox.style.height = `${cropRect.h}px`;
  }

  async function loadSelected() {
    if (!(select instanceof HTMLSelectElement)) return;
    const idFoto = select.value;
    actual = fotos.find((f) => texto(f.rowId || f.idFoto) === idFoto);
    if (!actual) return;
    setMessage('Cargando o orixinal…');
    const result = await api('/api/editor-fotos', { accion: 'obterOriginal', idFoto });
    mimeType = result.mimeType || 'image/jpeg';
    const img = new Image();
    img.onload = () => {
      original = img;
      flipX = 1; flipY = 1;
      fitCanvas(img);
      resetCrop();
      setMessage('Fotografía preparada para editar.');
    };
    img.onerror = () => setMessage('Non se puido abrir a fotografía.', true);
    img.src = `data:${mimeType};base64,${result.base64}`;
  }

  async function saveEdited() {
    if (!(canvas instanceof HTMLCanvasElement) || !actual) return;
    setMessage('Gardando a versión editada en R2…');
    if (saveButton instanceof HTMLButtonElement) saveButton.disabled = true;
    try {
      const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
      const base64 = dataUrl.split(',')[1] || '';
      const result = await api('/api/editor-fotos', {
        accion: 'gardarEdicion',
        idFoto: texto(actual.rowId || actual.idFoto),
        mimeType: 'image/jpeg',
        base64,
        publicarPublica: actual.publicarPublica === true,
        publicarPrivada: actual.publicarPrivada === true
      });
      setMessage(result.mensaxe || 'Edición gardada correctamente.');
    } catch (error) {
      setMessage(error instanceof Error ? error.message : 'Non se puido gardar a edición.', true);
    } finally {
      if (saveButton instanceof HTMLButtonElement) saveButton.disabled = false;
    }
  }

  onAuthStateChanged(auth, async (user) => {
    if (!user?.email) return window.location.replace('/portal/');
    try {
      idToken = await user.getIdToken(true);
      const result = await api('/api/fotos', { accion: 'listarFotosRevision' });
      fotos = Array.isArray(result.fotos) ? result.fotos : [];
      if (!(select instanceof HTMLSelectElement)) return;
      select.innerHTML = fotos.map((f, i) => {
        const id = texto(f.rowId || f.idFoto);
        const title = texto(f.titulo || f.nomeFicheiro || `Fotografía ${i+1}`);
        return `<option value="${escapar(id)}">${escapar(title)}</option>`;
      }).join('');
      if (state instanceof HTMLElement) state.hidden = true;
      if (shell instanceof HTMLElement) shell.hidden = false;
      if (fotos.length) await loadSelected();
      else setMessage('Non hai fotografías pendentes de revisión.');
    } catch (error) {
      if (state instanceof HTMLElement) state.textContent = error instanceof Error ? error.message : 'Non se puido abrir o editor.';
    }
  });

  document.querySelector('#load-photo')?.addEventListener('click', loadSelected);
  document.querySelectorAll('[data-tool]').forEach((button) => button.addEventListener('click', async () => {
    const tool = button.getAttribute('data-tool');
    if (tool === 'rotate-left') await rotate(-90);
    if (tool === 'rotate-right') await rotate(90);
    if (tool === 'flip-x') await flip('x');
    if (tool === 'flip-y') await flip('y');
    resetCrop();
  }));

  startCrop?.addEventListener('click', () => {
    cropMode = true;
    cropRect = null;
    if (wrap instanceof HTMLElement) wrap.classList.add('is-cropping');
    setMessage('Arrastra sobre a imaxe para seleccionar o recorte.');
  });

  canvas?.addEventListener('pointerdown', (event) => {
    if (!cropMode || !(canvas instanceof HTMLCanvasElement)) return;
    canvas.setPointerCapture(event.pointerId);
    cropStart = pointerPosition(event);
    cropRect = { x: cropStart.x, y: cropStart.y, w: 0, h: 0 };
    drawCropBox();
  });

  canvas?.addEventListener('pointermove', (event) => {
    if (!cropMode || !cropStart || !(canvas instanceof HTMLCanvasElement)) return;
    const p = pointerPosition(event);
    cropRect = {
      x: Math.min(cropStart.x, p.x),
      y: Math.min(cropStart.y, p.y),
      w: Math.abs(p.x - cropStart.x),
      h: Math.abs(p.y - cropStart.y)
    };
    drawCropBox();
  });

  canvas?.addEventListener('pointerup', () => {
    if (applyCrop instanceof HTMLButtonElement) applyCrop.disabled = !cropRect || cropRect.w < 10 || cropRect.h < 10;
  });

  applyCrop?.addEventListener('click', () => {
    if (!(canvas instanceof HTMLCanvasElement) || !ctx || !cropRect) return;
    const rect = canvas.getBoundingClientRect();
    const sx = canvas.width / rect.width;
    const sy = canvas.height / rect.height;
    const x = Math.round(cropRect.x * sx);
    const y = Math.round(cropRect.y * sy);
    const w = Math.round(cropRect.w * sx);
    const h = Math.round(cropRect.h * sy);
    const data = ctx.getImageData(x, y, w, h);
    canvas.width = w; canvas.height = h;
    ctx.putImageData(data, 0, 0);
    resetCrop();
    setMessage('Recorte aplicado.');
  });

  resetButton?.addEventListener('click', () => {
    if (original) { flipX = 1; flipY = 1; fitCanvas(original); resetCrop(); setMessage('Recuperouse o orixinal.'); }
  });
  saveButton?.addEventListener('click', saveEdited);
  logout?.addEventListener('click', async () => { await signOut(auth); window.location.href = '/portal/'; });
</script>

<style>
  :global(body){background:#f5f3f0}.private-layout{display:grid;grid-template-columns:282px minmax(0,1fr);min-height:100vh}.editor-main{padding:2.6rem clamp(1rem,4vw,4rem) 5rem;font-family:Aptos,'Segoe UI',Arial,sans-serif}.editor-header span{color:var(--color-acento);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.editor-header h1{margin:.35rem 0 .45rem;color:var(--color-principal);font-size:clamp(2rem,4vw,3.2rem);font-weight:400}.editor-header p{max-width:760px;margin:0 0 1.6rem;color:#625d59}.editor-state,.editor-selector,.canvas-panel,.tools-panel{border:1px solid #ddd7d2;background:#fff}.editor-state{padding:1rem}.editor-selector{display:flex;gap:1rem;align-items:end;padding:1rem;margin-bottom:1rem}.editor-selector label{display:grid;gap:.35rem;flex:1}.editor-selector span,.tools-panel h2{font-size:.68rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.editor-selector select,.editor-selector button,.tools-panel button{min-height:2.55rem;padding:.6rem .8rem;border:1px solid #cfc7c1;background:#fff;color:#4b4642;font:inherit;cursor:pointer}.editor-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:1rem}.canvas-panel{min-height:620px;padding:1rem;display:grid;place-items:center;background:#ebe7e2}.canvas-wrap{position:relative;max-width:100%;max-height:78vh}.canvas-wrap canvas{display:block;max-width:100%;max-height:76vh;background:#fff;box-shadow:0 8px 28px rgba(30,24,20,.12);touch-action:none}.canvas-wrap.is-cropping canvas{cursor:crosshair}.crop-box{position:absolute;border:2px solid #fff;outline:1px solid #6d2032;background:rgba(109,32,50,.12);pointer-events:none}.tools-panel{padding:1rem;align-self:start}.tools-panel section+section{margin-top:1.2rem;padding-top:1.2rem;border-top:1px solid #e4dfda}.tools-panel h2{margin:0 0 .65rem;color:var(--color-principal)}.tools-panel p{margin:0 0 .7rem;color:#6b6561;font-size:.8rem;line-height:1.5}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.tools-panel button.primary{grid-column:1/-1;background:var(--color-principal);color:#fff;border-color:var(--color-principal)}.tools-panel button:disabled{opacity:.45;cursor:not-allowed}.editor-message{min-height:2.5rem;margin:1rem 0 0;padding:.65rem;border-left:3px solid var(--color-acento);background:#faf8f6;font-size:.8rem}.editor-message[data-error='true']{border-left-color:#a12b2b;color:#842323}@media(max-width:1000px){.private-layout{grid-template-columns:1fr}.editor-grid{grid-template-columns:1fr}.canvas-panel{min-height:460px}.tools-panel{width:100%}}@media(max-width:620px){.editor-selector{align-items:stretch;flex-direction:column}.tool-grid{grid-template-columns:1fr}.canvas-panel{min-height:320px;padding:.5rem}}
</style>
