---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Galería privada" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="galeria" logoutId="gallery-logout" />
    <main class="gallery-main">
      <header class="gallery-header">
        <div><span>Arquivo fotográfico</span><h1>Galería privada</h1><p>Fotografías da vida da Coral dispoñibles para persoas autorizadas.</p></div>
        <a href="/portal/fotos/" class="upload-link">＋ Subir fotografías</a>
      </header>
      <section id="gallery-state" class="gallery-state">Comprobando o teu acceso…</section>
      <section id="gallery-shell" hidden>
        <div class="gallery-controls">
          <label><span>Buscar</span><input id="gallery-search" type="search" placeholder="Título, lugar, concerto ou ano…" /></label>
          <label><span>Ano</span><select id="gallery-year"><option value="">Todos os anos</option></select></label>
          <strong id="gallery-count">0 fotografías</strong>
        </div>
        <div id="gallery-content" class="photo-grid"></div>
        <p id="gallery-empty" class="gallery-empty" hidden>Non hai fotografías que coincidan coa busca.</p>
      </section>
    </main>
  </div>

  <dialog id="gallery-viewer" class="viewer">
    <button id="viewer-close" class="viewer-close" type="button" aria-label="Pechar">×</button>
    <button id="viewer-prev" class="viewer-nav prev" type="button" aria-label="Fotografía anterior">‹</button>
    <figure><div class="viewer-image-wrap"><span id="viewer-loading">Cargando fotografía…</span><img id="viewer-image" alt="" /></div><figcaption><strong id="viewer-title"></strong><span id="viewer-position"></span></figcaption></figure>
    <button id="viewer-next" class="viewer-nav next" type="button" aria-label="Fotografía seguinte">›</button>
  </dialog>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';
  const firebaseConfig = { apiKey:'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs', authDomain:'scpp-portal-privado.firebaseapp.com', projectId:'scpp-portal-privado', storageBucket:'scpp-portal-privado.firebasestorage.app', messagingSenderId:'506857659587', appId:'1:506857659587:web:a7ed36b22f044f5f639676' };
  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const state = document.querySelector('#gallery-state'); const shell = document.querySelector('#gallery-shell'); const content = document.querySelector('#gallery-content'); const search = document.querySelector('#gallery-search'); const year = document.querySelector('#gallery-year'); const count = document.querySelector('#gallery-count'); const empty = document.querySelector('#gallery-empty'); const logout = document.querySelector('#gallery-logout'); const viewer = document.querySelector('#gallery-viewer'); const viewerImage = document.querySelector('#viewer-image'); const viewerTitle = document.querySelector('#viewer-title'); const viewerPosition = document.querySelector('#viewer-position'); const viewerLoading = document.querySelector('#viewer-loading'); const viewerPrev = document.querySelector('#viewer-prev'); const viewerNext = document.querySelector('#viewer-next'); const viewerClose = document.querySelector('#viewer-close');
  let idToken=''; let fotos=[]; let visibles=[]; let current=0; const thumbUrls=new Map(); const originalUrls=new Map();
  const esc=(v='')=>String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const titleOf=(foto)=>String(foto?.titulo||foto?.peFoto||'Fotografía do arquivo').trim(); const yearOf=(foto)=>String(foto?.anoAproximado||String(foto?.data||'').slice(0,4)||'').trim(); const searchable=(foto)=>[foto?.titulo,foto?.peFoto,foto?.lugar,foto?.concerto,foto?.evento,foto?.anoAproximado,foto?.data].join(' ').toLowerCase();
  async function acceptance(user){
    const token=await user.getIdToken();
    const response=await fetch('/api/aceptacion',{method:'POST',headers:{'Content-Type':'application/json'},cache:'no-store',body:JSON.stringify({idToken:token,accion:'comprobarAceptacion',version:'PRIVACIDADE-WEB-1.0'})});
    const result=await response.json().catch(()=>null);
    if(response.status===401||response.status===403)return {ok:true,vixente:false};
    if(!response.ok||!result?.ok)throw new Error(result?.erro||'Non foi posible comprobar a aceptación neste momento.');
    return {ok:true,vixente:result.aceptacionVixente===true};
  }
  async function privateImage(idFoto,miniatura){const cache=miniatura?thumbUrls:originalUrls;if(cache.has(idFoto))return cache.get(idFoto);const response=await fetch('/api/galeria-privada',{method:'POST',headers:{'Content-Type':'application/json'},cache:'no-store',body:JSON.stringify({idToken,accion:'imaxe',idFoto,miniatura})});if(response.status===401)throw new Error('A sesión caducou. Volve iniciar sesión.');if(!response.ok)throw new Error('Non foi posible cargar a fotografía.');const url=URL.createObjectURL(await response.blob());cache.set(idFoto,url);return url;}
  async function loadThumb(image,foto,card){try{image.src=await privateImage(foto.idFoto,true);card.classList.add('ready');}catch{card.classList.add('error');card.querySelector('.photo-state')?.replaceChildren('Imaxe non dispoñible');}}
  function card(foto){const article=document.createElement('article');const titulo=titleOf(foto);article.className='photo-card';article.innerHTML=`<button type="button"><span class="photo-state">Cargando…</span><img alt="${esc(titulo)}" loading="lazy" decoding="async" /></button><div><small>${esc(yearOf(foto))}</small><h2>${esc(titulo)}</h2></div>`;const image=article.querySelector('img');if(image instanceof HTMLImageElement)loadThumb(image,foto,article);article.querySelector('button')?.addEventListener('click',()=>showViewer(visibles.indexOf(foto)));return article;}
  function filterGallery(){const query=search instanceof HTMLInputElement?search.value.trim().toLowerCase():'';const selected=year instanceof HTMLSelectElement?year.value:'';visibles=fotos.filter(f=>(!query||searchable(f).includes(query))&&(!selected||yearOf(f)===selected));content?.replaceChildren(...visibles.map(card));if(count instanceof HTMLElement)count.textContent=`${visibles.length} ${visibles.length===1?'fotografía':'fotografías'}`;if(empty instanceof HTMLElement)empty.hidden=visibles.length!==0;}
  async function showViewer(index){if(!(viewer instanceof HTMLDialogElement)||!(viewerImage instanceof HTMLImageElement))return;const foto=visibles[index];if(!foto)return;current=index;viewerImage.removeAttribute('src');viewerImage.classList.remove('ready');if(viewerLoading instanceof HTMLElement){viewerLoading.hidden=false;viewerLoading.textContent='Cargando fotografía…';}if(viewerTitle instanceof HTMLElement)viewerTitle.textContent=titleOf(foto);if(viewerPosition instanceof HTMLElement)viewerPosition.textContent=`${index+1} de ${visibles.length}`;if(viewerPrev instanceof HTMLButtonElement)viewerPrev.disabled=index===0;if(viewerNext instanceof HTMLButtonElement)viewerNext.disabled=index===visibles.length-1;if(!viewer.open)viewer.showModal();try{viewerImage.src=await privateImage(foto.idFoto,false);viewerImage.onload=()=>{viewerImage.classList.add('ready');if(viewerLoading instanceof HTMLElement)viewerLoading.hidden=true;};}catch{if(viewerLoading instanceof HTMLElement)viewerLoading.textContent='Non foi posible abrir a fotografía.';}}
  async function loadGallery(){const response=await fetch('/api/galeria-privada',{method:'POST',headers:{'Content-Type':'application/json'},cache:'no-store',body:JSON.stringify({idToken,accion:'listar'})});const data=await response.json().catch(()=>null);if(response.status===401)throw new Error('A sesión caducou. Volve iniciar sesión.');if(!response.ok||!data?.ok||!Array.isArray(data.fotos))throw new Error(data?.erro||'Non foi posible cargar a galería privada.');fotos=data.fotos;const years=[...new Set(fotos.map(yearOf).filter(Boolean))].sort().reverse();if(year instanceof HTMLSelectElement)year.replaceChildren(new Option('Todos os anos',''),...years.map(v=>new Option(v,v)));filterGallery();}
  onAuthStateChanged(auth,async(user)=>{
    if(!user?.email)return window.location.replace('/portal/');
    try{
      const aceptacion=await acceptance(user);
      if(aceptacion.vixente!==true)return window.location.replace('/portal/');
      idToken=await user.getIdToken(true);
      await loadGallery();
      if(state instanceof HTMLElement)state.hidden=true;
      if(shell instanceof HTMLElement)shell.hidden=false;
    }catch(error){
      if(state instanceof HTMLElement){
        state.textContent=error instanceof Error?error.message:'A galería privada non está dispoñible.';
        const boton=document.createElement('button');boton.type='button';boton.textContent='Tentar de novo';boton.style.marginLeft='.75rem';boton.addEventListener('click',()=>window.location.reload());state.appendChild(boton);
      }
    }
  });
  search?.addEventListener('input',filterGallery);year?.addEventListener('change',filterGallery);viewerPrev?.addEventListener('click',()=>showViewer(current-1));viewerNext?.addEventListener('click',()=>showViewer(current+1));viewerClose?.addEventListener('click',()=>viewer instanceof HTMLDialogElement&&viewer.close());viewer?.addEventListener('click',(event)=>{if(event.target===viewer&&viewer instanceof HTMLDialogElement)viewer.close();});document.addEventListener('keydown',(event)=>{if(!(viewer instanceof HTMLDialogElement)||!viewer.open)return;if(event.key==='ArrowLeft'&&current>0)showViewer(current-1);if(event.key==='ArrowRight'&&current<visibles.length-1)showViewer(current+1);});logout?.addEventListener('click',async()=>{await signOut(auth);window.location.href='/portal/';});
</script>

<style is:global>
  body{background:#f5f3f0}.private-layout{display:grid;grid-template-columns:282px minmax(0,1fr);min-height:100vh}.gallery-main{width:100%;max-width:1500px;margin:0 auto;padding:2.7rem clamp(1.3rem,4vw,4.2rem) 5rem}.gallery-header{display:flex;justify-content:space-between;gap:2rem;margin-bottom:2rem}.gallery-header span{color:var(--color-acento);font-size:.72rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.gallery-header h1{margin:.3rem 0 .5rem;color:var(--color-principal);font-size:clamp(2.4rem,4.5vw,4rem)}.gallery-header p{margin:0;color:#625d58}.upload-link{align-self:flex-start;padding:.75rem 1rem;border:1px solid var(--color-principal);color:var(--color-principal);text-decoration:none}.gallery-state,.gallery-empty{padding:1rem;border:1px solid #ddd7d2;background:#fff}.gallery-controls{display:grid;grid-template-columns:minmax(220px,1fr) 180px auto;gap:1rem;align-items:end;margin-bottom:1.2rem}.gallery-controls label{display:grid;gap:.35rem}.gallery-controls span{font-size:.7rem;font-weight:700;text-transform:uppercase}.gallery-controls input,.gallery-controls select{min-height:2.7rem;padding:.55rem .7rem;border:1px solid #d7d1cd;background:#fff}.photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.85rem}.photo-card{overflow:hidden;border:1px solid #ddd7d2;background:#fff}.photo-card button{position:relative;display:block;width:100%;aspect-ratio:4/3;padding:0;overflow:hidden;border:0;background:#eeeae7;cursor:zoom-in}.photo-card img{display:block;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .2s}.photo-card.ready img{opacity:1}.photo-card.error img{display:none}.photo-state{position:absolute;inset:0;display:grid;place-items:center;padding:.6rem;color:#756d67;font-size:.72rem}.photo-card>div{padding:.55rem .7rem .7rem}.photo-card small{color:#8b837d;font-size:.65rem}.photo-card h2{display:-webkit-box;margin:.2rem 0 0;overflow:hidden;color:#403b37;font-size:.8rem;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}.viewer{width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:0;border:0;background:rgba(18,14,13,.94);color:#fff}.viewer::backdrop{background:rgba(18,14,13,.94)}.viewer figure{display:grid;width:min(1200px,calc(100vw - 150px));height:calc(100vh - 30px);margin:auto;grid-template-rows:minmax(0,1fr) auto}.viewer-image-wrap{position:relative;display:grid;place-items:center}.viewer img{display:block;max-width:100%;max-height:calc(100vh - 95px);object-fit:contain;opacity:0}.viewer img.ready{opacity:1}.viewer figcaption{display:flex;justify-content:space-between;padding:.7rem}.viewer-close{position:absolute;z-index:3;top:1rem;right:1rem;width:2.7rem;height:2.7rem;border:0;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;font-size:1.8rem}.viewer-nav{position:absolute;z-index:2;top:50%;width:4rem;height:5rem;border:0;background:rgba(255,255,255,.08);color:#fff;font-size:3rem;transform:translateY(-50%)}.viewer-nav.prev{left:0}.viewer-nav.next{right:0}.viewer-nav:disabled{opacity:.2}@media(max-width:900px){.private-layout{grid-template-columns:1fr}.gallery-main{padding:1.5rem}.gallery-controls{grid-template-columns:1fr 1fr}.gallery-controls strong{grid-column:1/-1}.photo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
