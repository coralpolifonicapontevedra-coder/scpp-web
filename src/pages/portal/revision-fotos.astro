---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Xestión de fotografías" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="revisar" logoutId="review-logout" />

    <main class="review-main">
      <header class="page-header">
        <div>
          <p class="page-kicker">Administración do arquivo visual</p>
          <h1>Xestión de fotografías</h1>
          <p class="page-description">Revisa as novas fotografías e administra as que xa están publicadas sen borrar o ficheiro nin o rexistro da folla Fotos.</p>
        </div>
        <button id="review-refresh" class="outline-button" type="button">Actualizar</button>
      </header>

      <nav class="module-tabs" aria-label="Apartados da xestión de fotografías">
        <button class="module-tab active" type="button" data-tab="pendentes">
          Pendentes <span id="review-count">0</span>
        </button>
        <button class="module-tab" type="button" data-tab="publicadas">
          Publicadas <span id="published-count">—</span>
        </button>
      </nav>

      <p id="review-message" class="portal-message" role="status" aria-live="polite" hidden></p>

      <section id="pending-panel" class="module-panel">
        <div class="panel-heading">
          <div>
            <p class="panel-kicker">Revisión</p>
            <h2>Fotografías pendentes</h2>
          </div>
          <div class="review-navigation">
            <button id="review-previous" class="square-button" type="button">←</button>
            <strong id="review-position">0 de 0</strong>
            <button id="review-next" class="square-button" type="button">→</button>
          </div>
        </div>

        <div id="review-list"></div>
        <p id="review-empty" class="empty-state" hidden>Non hai fotografías pendentes de revisión.</p>
      </section>

      <section id="published-panel" class="module-panel" hidden>
        <div class="panel-heading">
          <div>
            <p class="panel-kicker">Publicación</p>
            <h2>Fotografías publicadas</h2>
          </div>
          <button id="load-published" class="outline-button" type="button">Cargar publicadas</button>
        </div>

        <p class="panel-note">Este apartado só se carga cando o abres, para non ralentizar a revisión das fotografías novas.</p>
        <div id="published-list" class="published-grid"></div>
        <p id="published-empty" class="empty-state" hidden>Non hai fotografías publicadas.</p>
      </section>

      <section id="access-state" class="access-state" aria-live="polite">
        <p>Comprobando a sesión e os permisos de administración…</p>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const app = getApps().length ? getApp() : initializeApp(firebaseConfig);
  const auth = getAuth(app);
  auth.useDeviceLanguage();

  const estadoAcceso = document.querySelector('#access-state');
  const mensaxe = document.querySelector('#review-message');
  const actualizar = document.querySelector('#review-refresh');
  const lista = document.querySelector('#review-list');
  const listaPublicadas = document.querySelector('#published-list');
  const contador = document.querySelector('#review-count');
  const contadorPublicadas = document.querySelector('#published-count');
  const posicion = document.querySelector('#review-position');
  const baleiro = document.querySelector('#review-empty');
  const baleiroPublicadas = document.querySelector('#published-empty');
  const anterior = document.querySelector('#review-previous');
  const seguinte = document.querySelector('#review-next');
  const pecharSesion = document.querySelector('#review-logout');
  const pendingPanel = document.querySelector('#pending-panel');
  const publishedPanel = document.querySelector('#published-panel');
  const cargarPublicadasButton = document.querySelector('#load-published');
  const tabs = Array.from(document.querySelectorAll('.module-tab'));

  let fotosRevision = [];
  let fotosPublicadas = [];
  let indiceActual = 0;
  let publicadasCargadas = false;

  function escaparHtml(texto) {
    return String(texto ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function urlSegura(valor) {
    const url = String(valor ?? '').trim();
    return /^https:\/\//i.test(url) ? url : '';
  }

  function primeiroValor(...valores) {
    return valores.find((valor) => String(valor ?? '').trim()) ?? '';
  }

  function mostrarMensaxe(texto = '', tipo = '') {
    if (!(mensaxe instanceof HTMLElement)) return;
    mensaxe.textContent = texto;
    mensaxe.dataset.tipo = tipo;
    mensaxe.hidden = !texto;
  }

  async function solicitar(accion, datos = {}) {
    const usuario = auth.currentUser;
    if (!usuario?.email) throw new Error('A sesión non está activa.');
    const idToken = await usuario.getIdToken(true);
    const resposta = await fetch('/api/fotos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion, ...datos })
    });
    const resultado = await resposta.json().catch(() => null);
    if (!resposta.ok || !resultado?.ok) {
      throw new Error(resultado?.erro || 'Non foi posible completar a operación.');
    }
    return resultado;
  }

  function actualizarNavegacion() {
    const total = fotosRevision.length;
    if (contador instanceof HTMLElement) contador.textContent = String(total);
    if (posicion instanceof HTMLElement) posicion.textContent = total ? `${indiceActual + 1} de ${total}` : '0 de 0';
    if (anterior instanceof HTMLButtonElement) anterior.disabled = indiceActual <= 0 || total === 0;
    if (seguinte instanceof HTMLButtonElement) seguinte.disabled = indiceActual >= total - 1 || total === 0;
    if (baleiro instanceof HTMLElement) baleiro.hidden = total !== 0;
  }

  function debuxarFotoActual() {
    if (!(lista instanceof HTMLElement)) return;
    actualizarNavegacion();
    const foto = fotosRevision[indiceActual];
    if (!foto) {
      lista.innerHTML = '';
      return;
    }

    const miniaturaUrl = urlSegura(foto.miniaturaUrl);
    const ficheiroUrl = urlSegura(foto.ficheiroUrl);
    const evento = primeiroValor(foto.evento, foto.concerto, 'Sen indicar');
    const data = primeiroValor(foto.data, foto.anoAproximado, 'Sen indicar');
    const lugar = primeiroValor(foto.lugar, 'Sen indicar');
    const autor = primeiroValor(foto.autor, foto.procedencia, 'Sen indicar');
    const persoa = primeiroValor(foto.subidaPor, 'Sen indicar');

    lista.innerHTML = `
      <article class="review-card" data-row-id="${escaparHtml(foto.rowId || foto.idFoto)}">
        <div class="review-photo-column">
          <div class="photo-frame">
            ${miniaturaUrl
              ? `<a href="${escaparHtml(ficheiroUrl || miniaturaUrl)}" target="_blank" rel="noopener noreferrer"><img src="${escaparHtml(miniaturaUrl)}" alt="${escaparHtml(foto.titulo || 'Fotografía')}" /></a>`
              : '<div class="photo-placeholder">Sen miniatura dispoñible</div>'}
          </div>
          ${ficheiroUrl ? `<a class="drive-link" href="${escaparHtml(ficheiroUrl)}" target="_blank" rel="noopener noreferrer">Ver orixinal en Drive</a>` : ''}
        </div>

        <div class="review-form">
          <div class="data-grid">
            <label class="field"><span>Evento / Concerto</span><input readonly value="${escaparHtml(evento)}" /></label>
            <label class="field"><span>Data</span><input readonly value="${escaparHtml(data)}" /></label>
            <label class="field"><span>Lugar</span><input readonly value="${escaparHtml(lugar)}" /></label>
            <label class="field"><span>Autor / Procedencia</span><input readonly value="${escaparHtml(autor)}" /></label>
            <label class="field field-wide"><span>Persoa que subiu a foto</span><input readonly value="${escaparHtml(persoa)}" /></label>
          </div>

          <label class="field"><span>Título ou descrición</span><input name="titulo" maxlength="120" value="${escaparHtml(foto.titulo)}" /></label>
          <label class="field"><span>Pé de foto</span><textarea name="peFoto" rows="3" maxlength="600">${escaparHtml(foto.peFoto)}</textarea></label>
          <label class="field"><span>Notas privadas</span><textarea name="observacions" rows="3" maxlength="500">${escaparHtml(foto.observacions)}</textarea></label>

          <fieldset class="destination-box">
            <legend>Destino da publicación</legend>
            <label class="destination-option"><input type="checkbox" name="publicarPublica" /><span><strong>Galería pública</strong><small>Visible para calquera visitante</small></span></label>
            <label class="destination-option"><input type="checkbox" name="publicarPrivada" /><span><strong>Galería privada</strong><small>Visible só no Portal</small></span></label>
          </fieldset>

          <div class="review-actions">
            <button class="secondary-action" type="button" data-review-action="rexeitar">Rexeitar</button>
            <button class="secondary-action" type="button" data-review-action="aceptar">Aceptar e arquivar</button>
            <button class="primary-action" type="button" data-review-action="publicar">Publicar</button>
          </div>
        </div>
      </article>`;
  }

  function debuxarPublicadas() {
    if (!(listaPublicadas instanceof HTMLElement)) return;
    if (contadorPublicadas instanceof HTMLElement) contadorPublicadas.textContent = String(fotosPublicadas.length);
    if (baleiroPublicadas instanceof HTMLElement) baleiroPublicadas.hidden = fotosPublicadas.length !== 0;

    listaPublicadas.innerHTML = fotosPublicadas.map((foto) => {
      const miniaturaUrl = urlSegura(foto.miniaturaUrl);
      const ficheiroUrl = urlSegura(foto.ficheiroUrl);
      const publica = foto.publicarPublica === true;
      const privada = foto.publicarPrivada === true;

      return `
        <article class="published-card" data-row-id="${escaparHtml(foto.rowId || foto.idFoto)}">
          <div class="published-photo">
            ${miniaturaUrl
              ? `<a href="${escaparHtml(ficheiroUrl || miniaturaUrl)}" target="_blank" rel="noopener noreferrer"><img src="${escaparHtml(miniaturaUrl)}" alt="${escaparHtml(foto.titulo || 'Fotografía')}" /></a>`
              : '<div class="photo-placeholder">Sen miniatura</div>'}
          </div>
          <div class="published-content">
            <p class="card-kicker">Fotografía aprobada</p>
            <h3>${escaparHtml(foto.titulo || 'Fotografía sen título')}</h3>
            <p class="card-description">${escaparHtml(primeiroValor(foto.evento, foto.concerto, foto.lugar, foto.data, 'Sen datos adicionais'))}</p>
            <div class="publication-status">
              <span class="status-box ${publica ? 'active' : ''}">Pública: ${publica ? 'Si' : 'Non'}</span>
              <span class="status-box ${privada ? 'active' : ''}">Privada: ${privada ? 'Si' : 'Non'}</span>
            </div>
            <div class="published-actions">
              ${publica ? '<button type="button" data-published-action="retirar-publica">Retirar da pública</button>' : '<button type="button" data-published-action="publicar-publica">Publicar na pública</button>'}
              ${privada ? '<button type="button" data-published-action="retirar-privada">Retirar da privada</button>' : '<button type="button" data-published-action="publicar-privada">Publicar na privada</button>'}
            </div>
          </div>
        </article>`;
    }).join('');
  }

  async function cargarPendentes() {
    if (actualizar instanceof HTMLButtonElement) actualizar.disabled = true;
    mostrarMensaxe('Cargando fotografías pendentes…', 'cargando');
    try {
      const resultado = await solicitar('listarFotosRevision');
      fotosRevision = Array.isArray(resultado.fotos) ? resultado.fotos : [];
      indiceActual = Math.min(indiceActual, Math.max(0, fotosRevision.length - 1));
      if (estadoAcceso instanceof HTMLElement) estadoAcceso.hidden = true;
      debuxarFotoActual();
      mostrarMensaxe();
    } catch (erro) {
      mostrarMensaxe(erro instanceof Error ? erro.message : 'Non foi posible cargar as fotografías.', 'erro');
    } finally {
      if (actualizar instanceof HTMLButtonElement) actualizar.disabled = false;
    }
  }

  async function cargarPublicadas(forzar = false) {
    if (publicadasCargadas && !forzar) return;
    if (cargarPublicadasButton instanceof HTMLButtonElement) {
      cargarPublicadasButton.disabled = true;
      cargarPublicadasButton.textContent = 'Cargando…';
    }
    mostrarMensaxe('Cargando fotografías publicadas…', 'cargando');
    try {
      const resultado = await solicitar('listarFotosPublicadas');
      fotosPublicadas = Array.isArray(resultado.fotos) ? resultado.fotos : [];
      publicadasCargadas = true;
      debuxarPublicadas();
      mostrarMensaxe();
    } catch (erro) {
      mostrarMensaxe(erro instanceof Error ? erro.message : 'Non foi posible cargar as fotografías publicadas.', 'erro');
    } finally {
      if (cargarPublicadasButton instanceof HTMLButtonElement) {
        cargarPublicadasButton.disabled = false;
        cargarPublicadasButton.textContent = publicadasCargadas ? 'Actualizar publicadas' : 'Cargar publicadas';
      }
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const destino = tab.getAttribute('data-tab');
      tabs.forEach((item) => item.classList.toggle('active', item === tab));
      if (pendingPanel instanceof HTMLElement) pendingPanel.hidden = destino !== 'pendentes';
      if (publishedPanel instanceof HTMLElement) publishedPanel.hidden = destino !== 'publicadas';
      if (destino === 'publicadas') cargarPublicadas();
    });
  });

  anterior?.addEventListener('click', () => {
    if (indiceActual <= 0) return;
    indiceActual -= 1;
    debuxarFotoActual();
  });

  seguinte?.addEventListener('click', () => {
    if (indiceActual >= fotosRevision.length - 1) return;
    indiceActual += 1;
    debuxarFotoActual();
  });

  actualizar?.addEventListener('click', cargarPendentes);
  cargarPublicadasButton?.addEventListener('click', () => cargarPublicadas(true));

  lista?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const boton = target.closest('button[data-review-action]');
    if (!(boton instanceof HTMLButtonElement)) return;
    const tarxeta = boton.closest('.review-card');
    if (!(tarxeta instanceof HTMLElement)) return;
    const accion = boton.dataset.reviewAction;

    if (accion === 'rexeitar' && !window.confirm('Queres marcar esta fotografía como rexeitada?')) return;

    const publicarPublica = tarxeta.querySelector('[name="publicarPublica"]');
    const publicarPrivada = tarxeta.querySelector('[name="publicarPrivada"]');
    const publica = publicarPublica instanceof HTMLInputElement && publicarPublica.checked;
    const privada = publicarPrivada instanceof HTMLInputElement && publicarPrivada.checked;

    if (accion === 'publicar' && !publica && !privada) {
      mostrarMensaxe('Selecciona polo menos unha galería antes de publicar.', 'erro');
      return;
    }

    const botons = tarxeta.querySelectorAll('button[data-review-action]');
    botons.forEach((elemento) => { if (elemento instanceof HTMLButtonElement) elemento.disabled = true; });

    try {
      const titulo = tarxeta.querySelector('[name="titulo"]');
      const peFoto = tarxeta.querySelector('[name="peFoto"]');
      const observacions = tarxeta.querySelector('[name="observacions"]');
      const resultado = await solicitar('actualizarRevisionFoto', {
        rowId: tarxeta.dataset.rowId,
        estado: accion === 'rexeitar' ? 'Rexeitada' : 'Aprobada',
        publicarPublica: accion === 'publicar' && publica,
        publicarPrivada: accion === 'publicar' && privada,
        titulo: titulo instanceof HTMLInputElement ? titulo.value : '',
        peFoto: peFoto instanceof HTMLTextAreaElement ? peFoto.value : '',
        observacions: observacions instanceof HTMLTextAreaElement ? observacions.value : ''
      });
      publicadasCargadas = false;
      if (contadorPublicadas instanceof HTMLElement) contadorPublicadas.textContent = '—';
      await cargarPendentes();
      mostrarMensaxe(resultado.mensaxe || 'Fotografía actualizada correctamente.', 'ok');
    } catch (erro) {
      mostrarMensaxe(erro instanceof Error ? erro.message : 'Non foi posible actualizar a fotografía.', 'erro');
      botons.forEach((elemento) => { if (elemento instanceof HTMLButtonElement) elemento.disabled = false; });
    }
  });

  listaPublicadas?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const boton = target.closest('button[data-published-action]');
    if (!(boton instanceof HTMLButtonElement)) return;
    const tarxeta = boton.closest('.published-card');
    if (!(tarxeta instanceof HTMLElement)) return;

    const foto = fotosPublicadas.find((item) => String(item.rowId || item.idFoto) === String(tarxeta.dataset.rowId));
    if (!foto) return;

    let publicarPublica = foto.publicarPublica === true;
    let publicarPrivada = foto.publicarPrivada === true;
    const accion = boton.dataset.publishedAction;

    if (accion === 'retirar-publica') publicarPublica = false;
    if (accion === 'retirar-privada') publicarPrivada = false;
    if (accion === 'publicar-publica') publicarPublica = true;
    if (accion === 'publicar-privada') publicarPrivada = true;

    if (accion?.startsWith('retirar') && !window.confirm('A fotografía seguirá na folla Fotos e no Drive. Confirmas a retirada?')) return;

    try {
      boton.disabled = true;
      await solicitar('actualizarPublicacionFoto', {
        rowId: tarxeta.dataset.rowId,
        publicarPublica,
        publicarPrivada
      });
      await cargarPublicadas(true);
      mostrarMensaxe('Destinos da fotografía actualizados.', 'ok');
    } catch (erro) {
      boton.disabled = false;
      mostrarMensaxe(erro instanceof Error ? erro.message : 'Non foi posible actualizar os destinos.', 'erro');
    }
  });

  onAuthStateChanged(auth, (usuario) => {
    if (!usuario?.email) {
      if (estadoAcceso instanceof HTMLElement) estadoAcceso.innerHTML = '<p>Identifícate primeiro no portal privado.</p><a href="/portal/">Ir ao portal</a>';
      return;
    }
    cargarPendentes();
  });

  pecharSesion?.addEventListener('click', async () => {
    await signOut(auth);
    window.location.href = '/portal/';
  });
</script>

<style>
  .private-layout{display:grid;grid-template-columns:282px minmax(0,1fr);min-height:100vh;background:#fff}.review-main{width:100%;max-width:1420px;margin:0 auto;padding:2.7rem clamp(1.5rem,4vw,4rem) 4rem;font-family:inherit;color:#373230}.page-header{display:flex;justify-content:space-between;align-items:flex-start;gap:2rem;padding-bottom:1.35rem;border-bottom:1px solid #ded8d4}.page-kicker,.panel-kicker,.card-kicker{margin:0 0 .35rem;color:var(--color-principal);font-size:.68rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.page-header h1{margin:0 0 .45rem;color:var(--color-principal);font-size:clamp(2rem,3.2vw,2.65rem);font-weight:700;letter-spacing:-.02em}.page-description{max-width:790px;margin:0;color:#625c58;font-size:.92rem;line-height:1.55}.outline-button,.square-button,.primary-action,.secondary-action,.published-actions button{border-radius:0;font:inherit;font-weight:700;cursor:pointer}.outline-button{min-height:2.65rem;padding:.55rem .9rem;border:1px solid var(--color-principal);background:#fff;color:var(--color-principal)}.outline-button:disabled{opacity:.55;cursor:wait}.module-tabs{display:flex;gap:0;margin:1.5rem 0 1.2rem;border-bottom:1px solid #ded8d4}.module-tab{min-width:150px;padding:.72rem 1rem;border:0;border-right:1px solid #ded8d4;border-bottom:3px solid transparent;background:#fff;color:#625c58;font:inherit;font-size:.84rem;font-weight:700;cursor:pointer}.module-tab:first-child{border-left:1px solid #ded8d4}.module-tab.active{border-bottom-color:var(--color-principal);color:var(--color-principal);background:#fbf8f7}.module-tab span{display:inline-grid;min-width:1.55rem;height:1.55rem;place-items:center;margin-left:.35rem;border:1px solid #d8cfcb;background:#fff;font-size:.72rem}.module-panel[hidden],.portal-message[hidden],.empty-state[hidden],.access-state[hidden]{display:none}.panel-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;margin-bottom:1rem}.panel-heading h2{margin:0;color:#3c3734;font-size:1.15rem;font-weight:700}.panel-note{margin:-.25rem 0 1rem;padding:.7rem .8rem;border-left:3px solid var(--color-principal);background:#faf7f5;color:#68615d;font-size:.79rem}.review-navigation{display:flex;align-items:center;gap:.65rem}.square-button{width:2.55rem;height:2.55rem;border:1px solid var(--color-principal);background:#fff;color:var(--color-principal);font-size:1rem}.square-button:disabled{border-color:#d6cfcb;color:#aaa3a0;cursor:default}.review-navigation strong{min-width:78px;color:#5f5854;font-size:.8rem;text-align:center}.portal-message,.empty-state,.access-state{margin:0 0 1rem;padding:.9rem 1rem;border:1px solid #ddd6d2;background:#faf8f6;color:#615a56;font-size:.84rem}.portal-message[data-tipo='erro']{border-left:3px solid var(--color-principal);background:#fff5f5}.portal-message[data-tipo='ok']{border-left:3px solid #3f7049;background:#f3f8f4}.empty-state,.access-state{text-align:center}.access-state{max-width:620px;margin:4rem auto}.access-state a{display:inline-block;margin-top:.7rem;color:var(--color-principal);font-weight:700}.review-card{display:grid;grid-template-columns:minmax(330px,1.02fr) minmax(380px,.98fr);gap:1.3rem;padding:1.2rem;border:1px solid #dcd5d1;background:#fff}.review-photo-column{display:grid;align-content:start;gap:.7rem}.photo-frame{display:grid;min-height:430px;place-items:center;overflow:hidden;border:1px solid #e2dcda;background:#f5f2f0}.photo-frame a{display:grid;width:100%;height:100%;place-items:center}.photo-frame img{display:block;width:100%;height:100%;max-height:620px;object-fit:contain}.photo-placeholder{color:#7a726d;font-size:.8rem}.drive-link{display:inline-flex;justify-self:start;padding:.5rem .7rem;border:1px solid var(--color-principal);color:var(--color-principal);font-size:.76rem;font-weight:700}.review-form{display:grid;align-content:start;gap:.75rem}.data-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.field{display:grid;gap:.32rem}.field-wide{grid-column:1/-1}.fiel