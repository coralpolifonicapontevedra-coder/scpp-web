---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Xestión de fotografías" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="revisar" logoutId="review-logout" />

    <main class="review-main">
      <header class="private-page-header">
        <div>
          <h1>Xestión de fotografías</h1>
          <p>Revisa as novas fotografías e administra as que xa están publicadas sen borrar o arquivo nin o rexistro da folla Fotos.</p>
        </div>
        <button id="review-refresh" class="refresh-button" type="button" aria-label="Actualizar fotografías">↻ Actualizar</button>
      </header>

      <nav class="photo-tabs" aria-label="Apartados de fotografías">
        <button class="photo-tab active" type="button" data-tab="pendentes">
          Pendentes <span id="review-count">0</span>
        </button>
        <button class="photo-tab" type="button" data-tab="publicadas">
          Publicadas <span id="published-count">0</span>
        </button>
      </nav>

      <p id="review-message" class="portal-message" role="status" aria-live="polite" hidden></p>

      <section id="pending-panel" class="photo-panel">
        <div class="review-navigation">
          <button id="review-previous" type="button">← Anterior</button>
          <strong id="review-position">0 de 0</strong>
          <button id="review-next" type="button">Seguinte →</button>
        </div>
        <div id="review-list"></div>
        <p id="review-empty" class="review-empty" hidden>Non hai fotografías pendentes de revisión.</p>
      </section>

      <section id="published-panel" class="photo-panel" hidden>
        <div id="published-list" class="published-grid"></div>
        <p id="published-empty" class="review-empty" hidden>Non hai fotografías publicadas.</p>
      </section>

      <section id="access-state" class="access-state" aria-live="polite">
        <p>Comprobando a sesión e os permisos de administración…</p>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const app = getApps().length ? getApp() : initializeApp(firebaseConfig);
  const auth = getAuth(app);
  auth.useDeviceLanguage();

  const estadoAcceso = document.querySelector('#access-state');
  const mensaxe = document.querySelector('#review-message');
  const actualizar = document.querySelector('#review-refresh');
  const lista = document.querySelector('#review-list');
  const listaPublicadas = document.querySelector('#published-list');
  const contador = document.querySelector('#review-count');
  const contadorPublicadas = document.querySelector('#published-count');
  const posicion = document.querySelector('#review-position');
  const baleiro = document.querySelector('#review-empty');
  const baleiroPublicadas = document.querySelector('#published-empty');
  const anterior = document.querySelector('#review-previous');
  const seguinte = document.querySelector('#review-next');
  const pecharSesion = document.querySelector('#review-logout');
  const pendingPanel = document.querySelector('#pending-panel');
  const publishedPanel = document.querySelector('#published-panel');
  const tabs = Array.from(document.querySelectorAll('.photo-tab'));

  let fotosRevision = [];
  let fotosPublicadas = [];
  let indiceActual = 0;

  function escaparHtml(texto) {
    return String(texto ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function urlSegura(valor) {
    const url = String(valor ?? '').trim();
    return /^https:\/\//i.test(url) ? url : '';
  }

  function primeiroValor(...valores) {
    return valores.find((valor) => String(valor ?? '').trim()) ?? '';
  }

  function mostrarMensaxe(texto = '', tipo = '') {
    if (!(mensaxe instanceof HTMLElement)) return;
    mensaxe.textContent = texto;
    mensaxe.dataset.tipo = tipo;
    mensaxe.hidden = !texto;
  }

  async function solicitar(accion, datos = {}) {
    const usuario = auth.currentUser;
    if (!usuario?.email) throw new Error('A sesión non está activa.');
    const idToken = await usuario.getIdToken(true);
    const resposta = await fetch('/api/fotos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion, ...datos })
    });
    const resultado = await resposta.json().catch(() => null);
    if (!resposta.ok || !resultado?.ok) {
      throw new Error(resultado?.erro || 'Non foi posible completar a operación.');
    }
    return resultado;
  }

  function actualizarNavegacion() {
    const total = fotosRevision.length;
    if (contador instanceof HTMLElement) contador.textContent = String(total);
    if (posicion instanceof HTMLElement) posicion.textContent = total ? `${indiceActual + 1} de ${total}` : '0 de 0';
    if (anterior instanceof HTMLButtonElement) anterior.disabled = indiceActual <= 0 || total === 0;
    if (seguinte instanceof HTMLButtonElement) seguinte.disabled = indiceActual >= total - 1 || total === 0;
    if (baleiro instanceof HTMLElement) baleiro.hidden = total !== 0;
  }

  function debuxarFotoActual() {
    if (!(lista instanceof HTMLElement)) return;
    actualizarNavegacion();
    const foto = fotosRevision[indiceActual];
    if (!foto) {
      lista.innerHTML = '';
      return;
    }

    const miniaturaUrl = urlSegura(foto.miniaturaUrl);
    const ficheiroUrl = urlSegura(foto.ficheiroUrl);
    const evento = primeiroValor(foto.evento, foto.concerto, 'Sen indicar');
    const data = primeiroValor(foto.data, foto.anoAproximado, 'Sen indicar');

    lista.innerHTML = `
      <article class="review-card" data-row-id="${escaparHtml(foto.rowId)}">
        <div class="photo-frame">
          ${miniaturaUrl ? `<a href="${escaparHtml(ficheiroUrl || miniaturaUrl)}" target="_blank" rel="noopener noreferrer"><img src="${escaparHtml(miniaturaUrl)}" alt="${escaparHtml(foto.titulo || 'Fotografía')}" /></a>` : '<div class="photo-placeholder">Sen miniatura</div>'}
        </div>
        <div class="review-form">
          <div class="readonly-grid">
            <label><span>Evento / Concerto</span><input readonly value="${escaparHtml(evento)}" /></label>
            <label><span>Data</span><input readonly value="${escaparHtml(data)}" /></label>
            <label><span>Lugar</span><input readonly value="${escaparHtml(foto.lugar || 'Sen indicar')}" /></label>
          </div>
          <label><span>Título ou descrición</span><input name="titulo" maxlength="120" value="${escaparHtml(foto.titulo)}" /></label>
          <label><span>Pé de foto</span><textarea name="peFoto" rows="3" maxlength="600">${escaparHtml(foto.peFoto)}</textarea></label>
          <label><span>Notas privadas</span><textarea name="observacions" rows="3" maxlength="500">${escaparHtml(foto.observacions)}</textarea></label>

          <fieldset class="publication-box">
            <legend>Destino da publicación</legend>
            <label><input type="checkbox" name="publicarPublica" /> Galería pública</label>
            <label><input type="checkbox" name="publicarPrivada" /> Galería privada do Portal</label>
          </fieldset>

          <div class="review-actions">
            <button class="reject-button" type="button" data-review-action="rexeitar">Rexeitar</button>
            <button class="accept-button" type="button" data-review-action="aceptar">Aceptar e arquivar</button>
            <button class="publish-button" type="button" data-review-action="publicar">Publicar</button>
          </div>
        </div>
      </article>`;
  }

  function debuxarPublicadas() {
    if (!(listaPublicadas instanceof HTMLElement)) return;
    if (contadorPublicadas instanceof HTMLElement) contadorPublicadas.textContent = String(fotosPublicadas.length);
    if (baleiroPublicadas instanceof HTMLElement) baleiroPublicadas.hidden = fotosPublicadas.length !== 0;

    listaPublicadas.innerHTML = fotosPublicadas.map((foto) => {
      const miniaturaUrl = urlSegura(foto.miniaturaUrl);
      const ficheiroUrl = urlSegura(foto.ficheiroUrl);
      const publica = foto.publicarPublica === true;
      const privada = foto.publicarPrivada === true;
      return `
        <article class="published-card" data-row-id="${escaparHtml(foto.rowId || foto.idFoto)}">
          <div class="published-image">
            ${miniaturaUrl ? `<a href="${escaparHtml(ficheiroUrl || miniaturaUrl)}" target="_blank" rel="noopener noreferrer"><img src="${escaparHtml(miniaturaUrl)}" alt="${escaparHtml(foto.titulo || 'Fotografía')}" /></a>` : '<div class="photo-placeholder">Sen miniatura</div>'}
          </div>
          <div class="published-body">
            <h2>${escaparHtml(foto.titulo || 'Fotografía sen título')}</h2>
            <p>${escaparHtml(primeiroValor(foto.evento, foto.concerto, foto.lugar, 'Sen datos adicionais'))}</p>
            <div class="status-row">
              <span class="status-pill ${publica ? 'on' : 'off'}">Pública: ${publica ? 'Si' : 'Non'}</span>
              <span class="status-pill ${privada ? 'on' : 'off'}">Privada: ${privada ? 'Si' : 'Non'}</span>
            </div>
            <div class="published-actions">
              ${publica ? '<button type="button" data-published-action="retirar-publica">Retirar da pública</button>' : ''}
              ${privada ? '<button type="button" data-published-action="retirar-privada">Retirar da privada</button>' : ''}
              ${!publica ? '<button type="button" data-published-action="publicar-publica">Publicar na pública</button>' : ''}
              ${!privada ? '<button type="button" data-published-action="publicar-privada">Publicar na privada</button>' : ''}
            </div>
          </div>
        </article>`;
    }).join('');
  }

  async function cargarTodo() {
    if (actualizar instanceof HTMLButtonElement) actualizar.disabled = true;
    mostrarMensaxe('Actualizando fotografías…', 'cargando');
    try {
      const [pendentes, publicadas] = await Promise.all([
        solicitar('listarFotosRevision'),
        solicitar('listarFotosPublicadas')
      ]);
      fotosRevision = Array.isArray(pendentes.fotos) ? pendentes.fotos : [];
      fotosPublicadas = Array.isArray(publicadas.fotos) ? publicadas.fotos : [];
      indiceActual = Math.min(indiceActual, Math.max(0, fotosRevision.length - 1));
      if (estadoAcceso instanceof HTMLElement) estadoAcceso.hidden = true;
      debuxarFotoActual();
      debuxarPublicadas();
      mostrarMensaxe();
    } catch (erro) {
      mostrarMensaxe(erro instanceof Error ? erro.message : 'Non foi posible cargar as fotografías.', 'erro');
    } finally {
      if (actualizar instanceof HTMLButtonElement) actualizar.disabled = false;
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const destino = tab.getAttribute('data-tab');
      tabs.forEach((item) => item.classList.toggle('active', item === tab));
      if (pendingPanel instanceof HTMLElement) pendingPanel.hidden = destino !== 'pendentes';
      if (publishedPanel instanceof HTMLElement) publishedPanel.hidden = destino !== 'publicadas';
    });
  });

  anterior?.addEventListener('click', () => {
    if (indiceActual > 0) {
      indiceActual -= 1;
      debuxarFotoActual();
    }
  });

  seguinte?.addEventListener('click', () => {
    if (indiceActual < fotosRevision.length - 1) {
      indiceActual += 1;
      debuxarFotoActual();
    }
  });

  actualizar?.addEventListener('click', cargarTodo);

  lista?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const boton = target.closest('button[data-review-action]');
    if (!(boton instanceof HTMLButtonElement)) return;
    const tarxeta = boton.closest('.review-card');
    if (!(tarxeta instanceof HTMLElement)) return;
    const accion = boton.dataset.reviewAction;

    if (accion === 'rexeitar' && !window.confirm('Queres marcar esta fotografía como rexeitada?')) return;

    const publicarPublica = tarxeta.querySelector('[name="publicarPublica"]');
    const publicarPrivada = tarxeta.querySelector('[name="publicarPrivada"]');
    const publica = publicarPublica instanceof HTMLInputElement && publicarPublica.checked;
    const privada = publicarPrivada instanceof HTMLInputElement && publicarPrivada.checked;

    if (accion === 'publicar' && !publica && !privada) {
      mostrarMensaxe('Selecciona polo menos unha galería antes de publicar.', 'erro');
      return;
    }

    try {
      boton.disabled = true;
      const titulo = tarxeta.querySelector('[name="titulo"]');
      const peFoto = tarxeta.querySelector('[name="peFoto"]');
      const observacions = tarxeta.querySelector('[name="observacions"]');
      await solicitar('actualizarRevisionFoto', {
        rowId: tarxeta.dataset.rowId,
        estado: accion === 'rexeitar' ? 'Rexeitada' : 'Aprobada',
        publicarPublica: accion === 'publicar' && publica,
        publicarPrivada: accion === 'publicar' && privada,
        titulo: titulo instanceof HTMLInputElement ? titulo.value : '',
        peFoto: peFoto instanceof HTMLTextAreaElement ? peFoto.value : '',
        observacions: observacions instanceof HTMLTextAreaElement ? observacions.value : ''
      });
      mostrarMensaxe('Fotografía actualizada correctamente.', 'ok');
      await cargarTodo();
    } catch (erro) {
      boton.disabled = false;
      mostrarMensaxe(erro instanceof Error ? erro.message : 'Non foi posible actualizar a fotografía.', 'erro');
    }
  });

  listaPublicadas?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const boton = target.closest('button[data-published-action]');
    if (!(boton instanceof HTMLButtonElement)) return;
    const tarxeta = boton.closest('.published-card');
    if (!(tarxeta instanceof HTMLElement)) return;
    const foto = fotosPublicadas.find((item) => String(item.rowId || item.idFoto) === String(tarxeta.dataset.rowId));
    if (!foto) return;

    let publicarPublica = foto.publicarPublica === true;
    let publicarPrivada = foto.publicarPrivada === true;
    const accion = boton.dataset.publishedAction;
    if (accion === 'retirar-publica') publicarPublica = false;
    if (accion === 'retirar-privada') publicarPrivada = false;
    if (accion === 'publicar-publica') publicarPublica = true;
    if (accion === 'publicar-privada') publicarPrivada = true;

    if ((accion === 'retirar-publica' || accion === 'retirar-privada') && !window.confirm('A fotografía seguirá na folla Fotos e no Drive. Confirmas a retirada desta galería?')) return;

    try {
      boton.disabled = true;
      await solicitar('actualizarPublicacionFoto', {
        rowId: tarxeta.dataset.rowId,
        publicarPublica,
        publicarPrivada
      });
      mostrarMensaxe('Destinos da fotografía actualizados.', 'ok');
      await cargarTodo();
    } catch (erro) {
      boton.disabled = false;
      mostrarMensaxe(erro instanceof Error ? erro.message : 'Non foi posible actualizar os destinos.', 'erro');
    }
  });

  onAuthStateChanged(auth, (usuario) => {
    if (!usuario?.email) {
      if (estadoAcceso instanceof HTMLElement) estadoAcceso.innerHTML = '<p>Identifícate primeiro no portal privado.</p><a href="/portal/">Ir ao portal</a>';
      return;
    }
    cargarTodo();
  });

  pecharSesion?.addEventListener('click', async () => {
    await signOut(auth);
    window.location.href = '/portal/';
  });
</script>

<style>
  .review-main{flex:1;min-width:0;padding:2rem 2.2rem 4rem}.private-page-header{display:flex;justify-content:space-between;gap:1.5rem;align-items:flex-start;margin-bottom:1.4rem}.private-page-header h1{margin:0 0 .45rem;color:var(--color-principal)}.private-page-header p{max-width:780px;margin:0;color:#6b6460;line-height:1.55}.refresh-button{padding:.65rem 1rem;border:1px solid var(--color-principal);background:#fff;color:var(--color-principal);border-radius:4px;font-weight:700;cursor:pointer}.photo-tabs{display:flex;gap:.65rem;margin:1rem 0 1.2rem;border-bottom:1px solid #ddd6d2}.photo-tab{padding:.75rem 1rem;border:0;border-bottom:3px solid transparent;background:transparent;color:#665e59;font-weight:750;cursor:pointer}.photo-tab.active{border-bottom-color:var(--color-principal);color:var(--color-principal)}.photo-tab span{display:inline-grid;place-items:center;min-width:1.55rem;height:1.55rem;margin-left:.35rem;border-radius:999px;background:#eee9e6;font-size:.75rem}.review-navigation{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}.review-navigation button{padding:.55rem .8rem;border:1px solid #d5ceca;background:#fff;border-radius:4px;cursor:pointer}.review-card{display:grid;grid-template-columns:minmax(260px,38%) 1fr;gap:1.5rem;padding:1.25rem;border:1px solid #ddd6d2;background:#fff}.photo-frame,.published-image{display:grid;place-items:center;min-height:260px;background:#f3efec;overflow:hidden}.photo-frame img,.published-image img{display:block;width:100%;height:100%;max-height:420px;object-fit:contain}.review-form{display:grid;gap:.85rem}.review-form label{display:grid;gap:.35rem}.review-form label span,.readonly-grid span{font-size:.76rem;font-weight:750;color:#5d5550}.review-form input,.review-form textarea{width:100%;box-sizing:border-box;padding:.65rem .7rem;border:1px solid #d5ceca;border-radius:3px;font:inherit}.readonly-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.publication-box{display:flex;gap:1.2rem;flex-wrap:wrap;padding:1rem;border:1px solid #ddd6d2}.publication-box legend{padding:0 .35rem;font-weight:750;color:var(--color-principal)}.publication-box label{display:flex;grid-template-columns:none;align-items:center;gap:.45rem}.publication-box input{width:auto}.review-actions,.published-actions{display:flex;gap:.65rem;flex-wrap:wrap}.review-actions button,.published-actions button{padding:.65rem .9rem;border-radius:3px;font-weight:750;cursor:pointer}.reject-button{border:1px solid #8a3939;background:#fff;color:#8a3939}.accept-button{border:1px solid #786f69;background:#fff;color:#544d49}.publish-button,.published-actions button{border:1px solid var(--color-principal);background:var(--color-principal);color:#fff}.published-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem}.published-card{overflow:hidden;border:1px solid #ddd6d2;background:#fff}.published-image{height:210px;min-height:210px}.published-body{padding:1rem}.published-body h2{margin:0 0 .4rem;font-size:1rem;color:#403a36}.published-body p{min-height:2.4em;margin:0 0 .8rem;color:#746c67;font-size:.85rem}.status-row{display:flex;gap:.45rem;flex-wrap:wrap;margin-bottom:.8rem}.status-pill{padding:.3rem .55rem;border-radius:999px;font-size:.7rem;font-weight:750}.status-pill.on{background:#e8f2ea;color:#315d3b}.status-pill.off{background:#f0ecea;color:#796f69}.review-empty,.access-state{padding:2rem;border:1px dashed #d5ceca;text-align:center;color:#746c67}.portal-message{padding:.75rem 1rem;border-left:4px solid var(--color-principal);background:#f6f1ef}.portal-message[data-tipo="erro"]{border-left-color:#9d3333;background:#fff1f1}.portal-message[data-tipo="ok"]{border-left-color:#3d7248;background:#eef8f0}@media(max-width:850px){.review-main{padding:1.2rem}.private-page-header{display:block}.refresh-button{margin-top:1rem}.review-card{grid-template-columns:1fr}.readonly-grid{grid-template-columns:1fr}.published-grid{grid-template-columns:1fr}}
</style>
