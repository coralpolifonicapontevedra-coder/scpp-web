---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Revisión e edición de fotografías" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="revisar" logoutId="review-editor-logout" />
    <main class="page-main">
      <header class="page-header">
        <span>Arquivo fotográfico</span>
        <h1>Revisión e edición</h1>
        <p>Edita, completa os datos e publica a fotografía nun único fluxo. O orixinal consérvase sen cambios.</p>
      </header>

      <section id="state" class="state">Comprobando permisos e fotografías pendentes…</section>

      <section id="shell" hidden>
        <div class="selector-row">
          <button id="previous-photo" type="button" disabled>← Anterior</button>
          <label><span>Fotografía pendente</span><select id="photo-select"></select></label>
          <button id="next-photo" type="button" disabled>Seguinte →</button>
          <button id="load-photo" type="button">Cargar fotografía</button>
        </div>

        <div class="workspace">
          <section class="image-column">
            <div id="canvas-wrap" class="canvas-wrap">
              <canvas id="editor-canvas"></canvas>
              <div id="crop-box" class="crop-box" hidden></div>
            </div>

            <div class="tools" aria-label="Ferramentas de edición">
              <button data-tool="rotate-left" type="button">↺ Girar esquerda</button>
              <button data-tool="rotate-right" type="button">↻ Girar dereita</button>
              <button data-tool="flip-x" type="button">↔ Voltear horizontal</button>
              <button data-tool="flip-y" type="button">↕ Voltear vertical</button>
              <button id="start-crop" type="button">✂ Seleccionar recorte</button>
              <button id="apply-crop" type="button" disabled>Aplicar recorte</button>
              <button id="reset-photo" type="button">Restablecer orixinal</button>
            </div>
          </section>

          <aside class="review-column">
            <section class="field-group">
              <h2>Datos da fotografía</h2>
              <label><span>Título ou descrición</span><input id="title" maxlength="120" /></label>
              <label><span>Pé de foto</span><textarea id="caption" rows="3" maxlength="600"></textarea></label>
              <label><span>Observacións privadas</span><textarea id="notes" rows="3" maxlength="500"></textarea></label>
            </section>

            <section class="field-group">
              <h2>Destino da publicación</h2>
              <label class="check"><input id="publish-public" type="checkbox" /><span><strong>Galería pública</strong><small>Visible para calquera visitante</small></span></label>
              <label class="check secondary"><input id="featured-public" type="checkbox" disabled /><span>Destacar na galería pública</span></label>
              <label class="check"><input id="publish-private" type="checkbox" /><span><strong>Galería privada</strong><small>Visible para persoas autorizadas</small></span></label>
              <label class="check secondary"><input id="featured-private" type="checkbox" disabled /><span>Destacar na galería privada</span></label>
            </section>

            <section class="actions">
              <button id="save-modified" type="button">Gardar modificada</button>
              <button id="save-draft" type="button">Conservar sen publicar</button>
              <button id="publish" class="primary" type="button">Publicar edición</button>
              <button id="delete-photo" class="danger" type="button">Eliminar fotografía</button>
            </section>

            <div class="status-grid">
              <div><span>R2</span><strong id="r2-status">Sin guardar</strong></div>
              <div><span>Sheet</span><strong id="sheet-status">Sin sincronizar</strong></div>
            </div>
            <p id="message" class="message" role="status" aria-live="polite"></p>
          </aside>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const state = document.querySelector('#state');
  const shell = document.querySelector('#shell');
  const select = document.querySelector('#photo-select');
  const previousButton = document.querySelector('#previous-photo');
  const nextButton = document.querySelector('#next-photo');
  const loadButton = document.querySelector('#load-photo');
  const canvas = document.querySelector('#editor-canvas');
  const wrap = document.querySelector('#canvas-wrap');
  const cropBox = document.querySelector('#crop-box');
  const applyCrop = document.querySelector('#apply-crop');
  const message = document.querySelector('#message');
  const r2Status = document.querySelector('#r2-status');
  const sheetStatus = document.querySelector('#sheet-status');
  const publishPublic = document.querySelector('#publish-public');
  const publishPrivate = document.querySelector('#publish-private');
  const featuredPublic = document.querySelector('#featured-public');
  const featuredPrivate = document.querySelector('#featured-private');
  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;

  let idToken = '';
  let fotos = [];
  let actual = null;
  let original = null;
  let mimeType = 'image/jpeg';
  let cropMode = false;
  let cropStart = null;
  let cropRect = null;
  let polling = 0;
  let loadSequence = 0;
  const originalCache = new Map();
  const preloadPending = new Set();

  const texto = (v='') => String(v ?? '').trim();
  const escapar = (v='') => texto(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const idDaFoto = (foto) => texto(foto?.rowId || foto?.idFoto);

  function setMessage(value='', error=false) {
    if (!(message instanceof HTMLElement)) return;
    message.textContent = value;
    message.dataset.error = error ? 'true' : 'false';
  }

  async function token(force=false) {
    const user = auth.currentUser;
    if (!user) throw new Error('A sesión non está activa.');
    if (!idToken || force) idToken = await user.getIdToken(force);
    return idToken;
  }

  async function api(url, body) {
    let response = await fetch(url, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      cache:'no-store',
      body:JSON.stringify({ idToken: await token(), ...body })
    });
    if (response.status === 401) {
      response = await fetch(url, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        cache:'no-store',
        body:JSON.stringify({ idToken: await token(true), ...body })
      });
    }
    const result = await response.json().catch(()=>null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || `HTTP ${response.status}`);
    return result;
  }

  function updateNavigation() {
    if (!(select instanceof HTMLSelectElement)) return;
    const index = Math.max(0, select.selectedIndex);
    const total = fotos.length;
    if (previousButton instanceof HTMLButtonElement) previousButton.disabled = total === 0 || index <= 0;
    if (nextButton instanceof HTMLButtonElement) nextButton.disabled = total === 0 || index >= total - 1;
    if (loadButton instanceof HTMLButtonElement) loadButton.disabled = total === 0;
  }

  function drawImage(image) {
    if (!(canvas instanceof HTMLCanvasElement) || !ctx) return;
    const maxW = 1500, maxH = 1050;
    const scale = Math.min(1, maxW/image.width, maxH/image.height);
    canvas.width = Math.max(1, Math.round(image.width*scale));
    canvas.height = Math.max(1, Math.round(image.height*scale));
    ctx.setTransform(1,0,0,1,0,0);
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.drawImage(image,0,0,canvas.width,canvas.height);
  }

  function imageFromUrl(url) {
    return new Promise((resolve,reject)=>{
      const image = new Image();
      image.onload = ()=>resolve(image);
      image.onerror = ()=>reject(new Error('Non se puido abrir a fotografía'));
      image.src = url;
    });
  }

  function imageFromCanvas() {
    return new Promise((resolve,reject)=>{
      if (!(canvas instanceof HTMLCanvasElement)) return reject(new Error('Canvas non dispoñible'));
      const image = new Image();
      image.onload = ()=>resolve(image);
      image.onerror = ()=>reject(new Error('Non se puido reconstruír a imaxe'));
      image.src = canvas.toDataURL('image/jpeg',.92);
    });
  }

  async function obterOriginal(id) {
    const cached = originalCache.get(id);
    if (cached) return cached;
    let response = await fetch(`/api/editor-fotos-original?idFoto=${encodeURIComponent(id)}`, {
      headers: { Authorization: `Bearer ${await token()}` },
      cache: 'force-cache'
    });
    if (response.status === 401) {
      response = await fetch(`/api/editor-fotos-original?idFoto=${encodeURIComponent(id)}`, {
        headers: { Authorization: `Bearer ${await token(true)}` },
        cache: 'force-cache'
      });
    }
    if (!response.ok) {
      const error = await response.json().catch(()=>null);
      throw new Error(error?.erro || `HTTP ${response.status}`);
    }
    const blob = await response.blob();
    const url = URL.createObjectURL(blob);
    const entry = { url, mimeType: blob.type || 'image/jpeg' };
    originalCache.set(id, entry);
    return entry;
  }

  async function preloadIndex(index) {
    const foto = fotos[index];
    const id = idDaFoto(foto);
    if (!id || originalCache.has(id) || preloadPending.has(id)) return;
    preloadPending.add(id);
    try { await obterOriginal(id); } catch {} finally { preloadPending.delete(id); }
  }

  function preloadAround() {
    if (!(select instanceof HTMLSelectElement)) return;
    const index = select.selectedIndex;
    window.setTimeout(() => {
      preloadIndex(index + 1);
      preloadIndex(index - 1);
    }, 150);
  }

  async function rotate(degrees) {
    if (!(canvas instanceof HTMLCanvasElement) || !ctx) return;
    const source = await imageFromCanvas();
    const swap = Math.abs(degrees)%180===90;
    const temp = document.createElement('canvas');
    temp.width = swap ? source.height : source.width;
    temp.height = swap ? source.width : source.height;
    const t = temp.getContext('2d');
    if (!t) return;
    t.translate(temp.width/2,temp.height/2);
    t.rotate(degrees*Math.PI/180);
    t.drawImage(source,-source.width/2,-source.height/2);
    canvas.width=temp.width; canvas.height=temp.height;
    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height); ctx.drawImage(temp,0,0);
    resetCrop();
  }

  async function flip(axis) {
    if (!(canvas instanceof HTMLCanvasElement) || !ctx) return;
    const source = await imageFromCanvas();
    ctx.setTransform(1,0,0,1,0,0); ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.translate(canvas.width/2,canvas.height/2);
    ctx.scale(axis==='x'?-1:1,axis==='y'?-1:1);
    ctx.drawImage(source,-canvas.width/2,-canvas.height/2);
    ctx.setTransform(1,0,0,1,0,0);
    resetCrop();
  }

  function resetCrop() {
    cropMode=false;cropStart=null;cropRect=null;
    if(cropBox instanceof HTMLElement)cropBox.hidden=true;
    if(applyCrop instanceof HTMLButtonElement)applyCrop.disabled=true;
    wrap?.classList.remove('is-cropping');
  }

  function pointerPosition(event) {
    if (!(canvas instanceof HTMLCanvasElement)) return {x:0,y:0};
    const rect=canvas.getBoundingClientRect();
    return {x:Math.max(0,Math.min(rect.width,event.clientX-rect.left)),y:Math.max(0,Math.min(rect.height,event.clientY-rect.top))};
  }

  function drawCropBox() {
    if (!(cropBox instanceof HTMLElement) || !cropRect) return;
    cropBox.hidden=false;
    cropBox.style.left=`${cropRect.x}px`;cropBox.style.top=`${cropRect.y}px`;
    cropBox.style.width=`${cropRect.w}px`;cropBox.style.height=`${cropRect.h}px`;
  }

  function loadFields() {
    const value=(selector,v)=>{const e=document.querySelector(selector);if(e instanceof HTMLInputElement||e instanceof HTMLTextAreaElement)e.value=texto(v)};
    value('#title',actual?.titulo);value('#caption',actual?.peFoto);value('#notes',actual?.observacions);
    if(publishPublic instanceof HTMLInputElement)publishPublic.checked=actual?.publicarPublica===true;
    if(publishPrivate instanceof HTMLInputElement)publishPrivate.checked=actual?.publicarPrivada===true;
    updateFeatured();
  }

  function updateFeatured() {
    if(featuredPublic instanceof HTMLInputElement&&publishPublic instanceof HTMLInputElement){featuredPublic.disabled=!publishPublic.checked;if(!publishPublic.checked)featuredPublic.checked=false;}
    if(featuredPrivate instanceof HTMLInputElement&&publishPrivate instanceof HTMLInputElement){featuredPrivate.disabled=!publishPrivate.checked;if(!publishPrivate.checked)featuredPrivate.checked=false;}
  }

  async function loadSelected() {
    if (!(select instanceof HTMLSelectElement)) return;
    updateNavigation();
    const id = select.value;
    actual = fotos.find(f=>idDaFoto(f)===id);
    if(!actual)return;
    loadFields();
    const sequence = ++loadSequence;
    const started = performance.now();
    setMessage(originalCache.has(id) ? 'Abrindo fotografía desde a caché…' : 'Cargando o orixinal desde R2…');
    if(loadButton instanceof HTMLButtonElement)loadButton.disabled=true;
    try {
      const entry=await obterOriginal(id);
      const image=await imageFromUrl(entry.url);
      if(sequence!==loadSequence)return;
      mimeType=entry.mimeType;
      original=image;
      drawImage(image);resetCrop();
      setMessage(`Fotografía preparada en ${Math.round(performance.now()-started)} ms${originalCache.has(id)?' (caché activa)':''}.`);
      preloadAround();
    } catch(error) {
      if(sequence===loadSequence)setMessage(error instanceof Error?error.message:'Non se puido abrir a fotografía.',true);
    } finally {
      updateNavigation();
    }
  }

  function fieldValue(id){const e=document.querySelector(id);return e instanceof HTMLInputElement||e instanceof HTMLTextAreaElement?e.value:'';}

  function editionBase64(){
    if(!(canvas instanceof HTMLCanvasElement)||!canvas.width||!canvas.height)throw new Error('Carga primeiro a fotografía antes de gardar os cambios.');
    return canvas.toDataURL('image/jpeg',.9).split(',')[1]||'';
  }

  async function saveModified(){
    if(!actual)return setMessage('Non hai ningunha fotografía seleccionada.',true);
    setMessage('Gardando a versión modificada en R2…');
    if(r2Status instanceof HTMLElement)r2Status.textContent='Gardando';
    if(sheetStatus instanceof HTMLElement)sheetStatus.textContent='Sen cambios';
    try{
      const result=await api('/api/gardar-borrador-foto',{idFoto:idDaFoto(actual),mimeType:'image/jpeg',base64:editionBase64(),titulo:fieldValue('#title'),peFoto:fieldValue('#caption'),observacions:fieldValue('#notes')});
      if(r2Status instanceof HTMLElement)r2Status.textContent='Gardada';
      setMessage(result.mensaxe||'Versión modificada gardada. A fotografía continúa pendente de revisión.');
    }catch(error){if(r2Status instanceof HTMLElement)r2Status.textContent='Erro';setMessage(error instanceof Error?error.message:'Non se puido gardar a modificación.',true);}
  }

  async function save(publish) {
    if (!(canvas instanceof HTMLCanvasElement)||!actual)return;
    const publica=publish&&publishPublic instanceof HTMLInputElement&&publishPublic.checked;
    const privada=publish&&publishPrivate instanceof HTMLInputElement&&publishPrivate.checked;
    if(publish&&!publica&&!privada){setMessage('Selecciona a galería pública, a privada ou ambas.',true);return;}
    if(!publish&&!window.confirm('Conservar esta fotografía no arquivo sen publicala?\n\nGardaranse as modificacións, pecharase a revisión e non se enviará a ningunha galería.'))return;
    setMessage(publish?'Gardando e publicando a versión editada…':'Conservando a fotografía sen publicar…');
    if(r2Status instanceof HTMLElement)r2Status.textContent='Gardando';
    if(sheetStatus instanceof HTMLElement)sheetStatus.textContent='En espera';
    try{
      const result=await api('/api/editor-fotos',{accion:'gardarEdicion',idFoto:idDaFoto(actual),mimeType:'image/jpeg',base64:editionBase64(),estado:'Aprobada',titulo:fieldValue('#title'),peFoto:fieldValue('#caption'),observacions:fieldValue('#notes'),publicarPublica:publica,publicarPrivada:privada,destacadaPublica:publica&&featuredPublic instanceof HTMLInputElement&&featuredPublic.checked,destacadaPrivada:privada&&featuredPrivate instanceof HTMLInputElement&&featuredPrivate.checked});
      if(r2Status instanceof HTMLElement)r2Status.textContent='Gardado';
      if(sheetStatus instanceof HTMLElement)sheetStatus.textContent='Sincronizando';
      setMessage(result.mensaxe||'Edición gardada.');startPolling();
    }catch(error){if(r2Status instanceof HTMLElement)r2Status.textContent='Erro';setMessage(error instanceof Error?error.message:'Non se puido gardar.',true);}
  }

  function removeCurrentPhoto(id) {
    const index = fotos.findIndex(foto => idDaFoto(foto) === id);
    if (index < 0) return;
    const cached = originalCache.get(id);
    if (cached) {
      URL.revokeObjectURL(cached.url);
      originalCache.delete(id);
    }
    fotos.splice(index, 1);
    actual = null;
    original = null;
    if (select instanceof HTMLSelectElement) {
      select.innerHTML = fotos.map((foto, i) => `<option value="${escapar(idDaFoto(foto))}">${escapar(texto(foto.titulo || foto.nomeFicheiro || `Fotografía ${i + 1}`))}</option>`).join('');
      select.selectedIndex = Math.min(index, fotos.length - 1);
    }
    if (canvas instanceof HTMLCanvasElement && ctx) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      canvas.width = 0;
      canvas.height = 0;
    }
    updateNavigation();
  }

  async function deletePhoto() {
    if (!actual) return setMessage('Non hai ningunha fotografía seleccionada.', true);
    const id = idDaFoto(actual);
    const nome = texto(actual.titulo || actual.nomeFicheiro || 'esta fotografía');
    if (!window.confirm(`Eliminar definitivamente «${nome}»?\n\nEliminarase o rexistro da Sheet, o orixinal de Drive e as copias asociadas de R2. Esta acción non se pode desfacer.`)) return;
    const button = document.querySelector('#delete-photo');
    if (button instanceof HTMLButtonElement) button.disabled = true;
    setMessage('Eliminando a fotografía de Sheet, Drive e R2…');
    if (r2Status instanceof HTMLElement) r2Status.textContent = 'Eliminando';
    if (sheetStatus instanceof HTMLElement) sheetStatus.textContent = 'Eliminando';
    try {
      const result = await api('/api/eliminar-foto-revision', { idFoto: id, rowId: id });
      removeCurrentPhoto(id);
      if (r2Status instanceof HTMLElement) r2Status.textContent = result.aviso ? 'Limpeza pendente' : 'Eliminada';
      if (sheetStatus instanceof HTMLElement) sheetStatus.textContent = 'Eliminada';
      setMessage(result.mensaxe || 'Fotografía eliminada correctamente.');
      if (fotos.length && select instanceof HTMLSelectElement) {
        loadFields();
        preloadIndex(select.selectedIndex);
      }
    } catch (error) {
      if (r2Status instanceof HTMLElement) r2Status.textContent = 'Erro';
      if (sheetStatus instanceof HTMLElement) sheetStatus.textContent = 'Erro';
      setMessage(error instanceof Error ? error.message : 'Non se puido eliminar a fotografía.', true);
    } finally {
      if (button instanceof HTMLButtonElement) button.disabled = false;
    }
  }

  function startPolling(){
    if(polling)window.clearInterval(polling);
    const id=idDaFoto(actual);let tries=0;
    polling=window.setInterval(async()=>{tries+=1;try{const result=await api('/api/editor-fotos',{accion:'estadoSincronizacion',idFoto:id});if(sheetStatus instanceof HTMLElement)sheetStatus.textContent=result.estado==='sincronizada'?'Sincronizada':result.estado==='erro'?'Erro':'Sincronizando';if(result.estado==='sincronizada'){setMessage('Edición gardada en R2 e Sheet sincronizada.');window.clearInterval(polling);polling=0;}if(result.estado==='erro'){setMessage(`A edición está en R2, pero a Sheet deu erro: ${result.erro||''}`,true);window.clearInterval(polling);polling=0;}}catch{}if(tries>=20&&polling){window.clearInterval(polling);polling=0;}},2000);
  }

  function moveSelection(delta){
    if(!(select instanceof HTMLSelectElement))return;
    const next=Math.max(0,Math.min(fotos.length-1,select.selectedIndex+delta));
    if(next===select.selectedIndex)return;
    select.selectedIndex=next;updateNavigation();loadSelected();
  }

  onAuthStateChanged(auth,async user=>{
    if(!user?.email)return window.location.replace('/portal/');
    try{
      await token(false);
      const started=performance.now();
      const result=await api('/api/fotos',{accion:'listarFotosRevision'});
      fotos=Array.isArray(result.fotos)?result.fotos:[];
      if(select instanceof HTMLSelectElement)select.innerHTML=fotos.map((f,i)=>`<option value="${escapar(idDaFoto(f))}">${escapar(texto(f.titulo||f.nomeFicheiro||`Fotografía ${i+1}`))}</option>`).join('');
      if(state instanceof HTMLElement)state.hidden=true;
      if(shell instanceof HTMLElement)shell.hidden=false;
      updateNavigation();
      if(fotos.length){loadFields();setMessage(`Lista preparada en ${Math.round(performance.now()-started)} ms. Preme «Cargar fotografía» ou usa Anterior/Seguinte.`);preloadIndex(0);}else setMessage('Non hai fotografías pendentes de revisión.');
    }catch(error){if(state instanceof HTMLElement)state.textContent=error instanceof Error?error.message:'Non se puido abrir o módulo.';}
  });

  loadButton?.addEventListener('click',loadSelected);
  previousButton?.addEventListener('click',()=>moveSelection(-1));
  nextButton?.addEventListener('click',()=>moveSelection(1));
  select?.addEventListener('change',()=>{updateNavigation();loadFields();});
  document.querySelectorAll('[data-tool]').forEach(button=>button.addEventListener('click',async()=>{const tool=button.getAttribute('data-tool');if(tool==='rotate-left')await rotate(-90);if(tool==='rotate-right')await rotate(90);if(tool==='flip-x')await flip('x');if(tool==='flip-y')await flip('y');}));
  document.querySelector('#start-crop')?.addEventListener('click',()=>{cropMode=true;cropRect=null;wrap?.classList.add('is-cropping');setMessage('Arrastra sobre a imaxe para seleccionar o recorte.');});
  canvas?.addEventListener('pointerdown',event=>{if(!cropMode||!(canvas instanceof HTMLCanvasElement))return;canvas.setPointerCapture(event.pointerId);cropStart=pointerPosition(event);cropRect={x:cropStart.x,y:cropStart.y,w:0,h:0};drawCropBox();});
  canvas?.addEventListener('pointermove',event=>{if(!cropMode||!cropStart)return;const p=pointerPosition(event);cropRect={x:Math.min(cropStart.x,p.x),y:Math.min(cropStart.y,p.y),w:Math.abs(p.x-cropStart.x),h:Math.abs(p.y-cropStart.y)};drawCropBox();});
  canvas?.addEventListener('pointerup',()=>{if(applyCrop instanceof HTMLButtonElement)applyCrop.disabled=!cropRect||cropRect.w<10||cropRect.h<10;});
  applyCrop?.addEventListener('click',()=>{if(!(canvas instanceof HTMLCanvasElement)||!ctx||!cropRect)return;const rect=canvas.getBoundingClientRect();const sx=canvas.width/rect.width,sy=canvas.height/rect.height;const x=Math.round(cropRect.x*sx),y=Math.round(cropRect.y*sy),w=Math.round(cropRect.w*sx),h=Math.round(cropRect.h*sy);const data=ctx.getImageData(x,y,w,h);canvas.width=w;canvas.height=h;ctx.putImageData(data,0,0);resetCrop();setMessage('Recorte aplicado.');});
  document.querySelector('#reset-photo')?.addEventListener('click',()=>{if(original){drawImage(original);resetCrop();setMessage('Recuperouse o orixinal.');}});
  publishPublic?.addEventListener('change',updateFeatured);publishPrivate?.addEventListener('change',updateFeatured);
  document.querySelector('#save-modified')?.addEventListener('click',saveModified);
  document.querySelector('#save-draft')?.addEventListener('click',()=>save(false));
  document.querySelector('#publish')?.addEventListener('click',()=>save(true));
  document.querySelector('#delete-photo')?.addEventListener('click',deletePhoto);
  document.querySelector('#review-editor-logout')?.addEventListener('click',async()=>{originalCache.forEach(entry=>URL.revokeObjectURL(entry.url));await signOut(auth);window.location.href='/portal/';});
  window.addEventListener('pagehide',()=>originalCache.forEach(entry=>URL.revokeObjectURL(entry.url)));
</script>

