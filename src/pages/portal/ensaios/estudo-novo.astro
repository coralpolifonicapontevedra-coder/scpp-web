---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
---

<BaseLayout title="Estudo da obra" lang="gl">
  <div class="private-layout new-study-layout">
    <PortalSidebar active="ensaios" logoutId="estudo-novo-logout" />
    <main class="private-main new-study-main">
      <header class="new-study-header">
        <h1>Estudo da obra</h1>
        <a href="/portal/ensaios/">← Volver a Ensaios</a>
      </header>

      <section id="loading" class="study-message">Cargando o material de estudo…</section>
      <section id="error" class="study-message error" hidden></section>

      <section id="app" class="study-player" hidden>
        <div class="study-topbar">
          <div class="work-info">
            <strong id="work-title">—</strong>
            <small id="work-meta"></small>
          </div>
          <label class="voice-select">
            <span>Audio / voz</span>
            <select id="audio-select"></select>
          </label>
          <div class="zoom-controls" aria-label="Zoom da partitura">
            <button id="zoom-out" type="button" aria-label="Reducir zoom">−</button>
            <strong id="zoom-value">100%</strong>
            <button id="zoom-in" type="button" aria-label="Aumentar zoom">+</button>
          </div>
          <button id="fullscreen" class="fullscreen" type="button" aria-label="Pantalla completa" title="Pantalla completa">⛶</button>
        </div>

        <div class="audio-row">
          <audio id="audio-player" controls preload="metadata"></audio>
        </div>

        <div id="viewer-shell" class="viewer-shell">
          <div id="pdf-status" class="pdf-status">Preparando a partitura…</div>
          <div id="canvas-wrap" class="canvas-wrap" hidden>
            <canvas id="pdf-canvas" aria-label="Partitura"></canvas>
          </div>
        </div>

        <nav class="page-nav" aria-label="Navegación da partitura">
          <button id="prev" type="button">← <span>Anterior</span></button>
          <label>
            <span>Páx.</span>
            <input id="page-number" type="number" min="1" value="1" inputmode="numeric" />
            <small id="page-total"></small>
          </label>
          <button id="next" type="button"><span>Seguinte</span> →</button>
        </nav>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const $ = (selector) => document.querySelector(selector);
  const norm = (value = '') => String(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();
  const canon = (value) => {
    const text = String(value ?? '').trim();
    const number = Number(text.replace(',', '.'));
    return Number.isFinite(number) ? String(Math.trunc(number)) : text;
  };
  const workId = (item) => canon(item?.idRepertorio ?? item?.repertorio ?? item?.Id_Repertorio ?? item?.id ?? item?.Id);
  const workName = (item) => String(item?.nomeObra ?? item?.nome ?? item?.NomeObra ?? '').trim();

  const params = new URLSearchParams(location.search);
  const requestedWorkId = canon(params.get('obra') || '');
  let repertoirePayload = null;
  let rehearsalPayload = null;
  let currentWork = null;
  let pdfDocument = null;
  let currentPage = 1;
  let zoomPercent = 100;
  let renderTask = null;
  let audioUrl = '';
  let pdfjsPromise = null;

  async function api(url, action, extra = {}) {
    const user = auth.currentUser;
    if (!user) throw new Error('A sesión non está dispoñible.');
    const idToken = await user.getIdToken();
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion: action, ...extra })
    });
    if (!response.ok) {
      const error = await response.json().catch(() => null);
      throw new Error(error?.erro || `Erro ${response.status}`);
    }
    return response;
  }

  async function apiJson(url, action, extra = {}) {
    const response = await api(url, action, extra);
    const data = await response.json();
    if (!data?.ok) throw new Error(data?.erro || 'Non foi posible completar a operación.');
    return data;
  }

  function loadPdfJs() {
    if (window.pdfjsLib?.getDocument) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';
      return Promise.resolve(window.pdfjsLib);
    }
    if (pdfjsPromise) return pdfjsPromise;
    pdfjsPromise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/vendor/pdfjs/pdf.min.js';
      script.async = true;
      script.onload = () => {
        if (!window.pdfjsLib?.getDocument) {
          reject(new Error('PDF.js non quedou dispoñible.'));
          return;
        }
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';
        resolve(window.pdfjsLib);
      };
      script.onerror = () => reject(new Error('Non foi posible cargar o visor PDF.'));
      document.head.append(script);
    });
    return pdfjsPromise;
  }

  function catalogWorks() {
    return repertoirePayload?.obras || repertoirePayload?.repertorio || repertoirePayload?.datos || [];
  }

  function findWork(id) {
    const target = canon(id);
    return catalogWorks().find((item) => workId(item) === target) || null;
  }

  function scores(work) {
    return Array.isArray(work?.partituras) ? work.partituras.filter((item) => item?.ruta || item?.r2Key) : [];
  }

  function audios(work) {
    return Array.isArray(work?.audios) ? work.audios.filter((item) => item?.ruta || item?.r2Key) : [];
  }

  function userVoice() {
    return String(
      rehearsalPayload?.perfil?.voz ||
      rehearsalPayload?.usuario?.voz ||
      rehearsalPayload?.persoa?.voz ||
      ''
    ).trim();
  }

  function preferredAudio(items) {
    const voice = norm(userVoice());
    if (voice) {
      const exact = items.find((item) => norm(item?.voz) === voice);
      if (exact) return exact;
      const compatible = items.find((item) => norm(item?.voz).includes(voice) || voice.includes(norm(item?.voz)));
      if (compatible) return compatible;
    }
    return items.find((item) => ['audioxeral', 'xeral', 'general', 'tutti'].includes(norm(item?.voz))) || items[0] || null;
  }

  async function privateResponse(resource) {
    const key = String(resource?.r2Key || resource?.ruta || '').trim();
    if (!key) throw new Error('O recurso non ten un ficheiro asociado.');
    return api('/api/repertorio', 'obterFicheiroRepertorio', { r2Key: key, ruta: key });
  }

  async function loadPdf(score) {
    $('#pdf-status').hidden = false;
    $('#pdf-status').textContent = 'Cargando a partitura…';
    $('#canvas-wrap').hidden = true;
    const [pdfjsLib, response] = await Promise.all([loadPdfJs(), privateResponse(score)]);
    const buffer = await response.arrayBuffer();
    const bytes = new Uint8Array(buffer);
    if (!bytes.length) throw new Error('A partitura chegou baleira.');
    pdfDocument = await pdfjsLib.getDocument({ data: bytes }).promise;
    currentPage = 1;
    $('#page-total').textContent = `de ${pdfDocument.numPages}`;
    await renderPage();
  }

  async function renderPage() {
    if (!pdfDocument) return;
    currentPage = Math.min(pdfDocument.numPages, Math.max(1, Math.trunc(Number(currentPage) || 1)));
    $('#page-number').value = String(currentPage);
    $('#prev').disabled = currentPage <= 1;
    $('#next').disabled = currentPage >= pdfDocument.numPages;

    if (renderTask) {
      try { renderTask.cancel(); } catch {}
      renderTask = null;
    }

    const page = await pdfDocument.getPage(currentPage);
    const shell = $('#viewer-shell');
    const canvas = $('#pdf-canvas');
    const context = canvas.getContext('2d', { alpha: false });
    if (!context) throw new Error('Non se puido preparar o visor.');

    const baseViewport = page.getViewport({ scale: 1 });
    const availableWidth = Math.max(260, shell.clientWidth - 16);
    const fitScale = availableWidth / baseViewport.width;
    const scale = fitScale * (zoomPercent / 100);
    const viewport = page.getViewport({ scale });
    const outputScale = Math.min(2, window.devicePixelRatio || 1);

    canvas.width = Math.floor(viewport.width * outputScale);
    canvas.height = Math.floor(viewport.height * outputScale);
    canvas.style.width = `${Math.floor(viewport.width)}px`;
    canvas.style.height = `${Math.floor(viewport.height)}px`;

    const transform = outputScale !== 1 ? [outputScale, 0, 0, outputScale, 0, 0] : null;
    renderTask = page.render({ canvasContext: context, transform, viewport });
    await renderTask.promise;
    renderTask = null;
    $('#pdf-status').hidden = true;
    $('#canvas-wrap').hidden = false;
    shell.scrollTo({ top: 0, left: 0 });
  }

  async function loadAudio(resource) {
    const player = $('#audio-player');
    player.pause();
    if (audioUrl) URL.revokeObjectURL(audioUrl);
    audioUrl = '';
    player.removeAttribute('src');
    player.load();
    if (!resource) return;
    const response = await privateResponse(resource);
    const blob = await response.blob();
    audioUrl = URL.createObjectURL(blob);
    player.src = audioUrl;
    player.load();
  }

  function renderAudioOptions(work) {
    const items = audios(work);
    const preferred = preferredAudio(items);
    const select = $('#audio-select');
    select.innerHTML = items.map((item, index) => {
      const id = canon(item?.id ?? item?.idAudio ?? item?.Id_Audio ?? index);
      const label = [item?.voz || 'Audio', item?.tipo].filter(Boolean).join(' — ');
      return `<option value="${id}">${label}</option>`;
    }).join('');
    if (preferred) {
      const preferredId = canon(preferred?.id ?? preferred?.idAudio ?? preferred?.Id_Audio ?? items.indexOf(preferred));
      select.value = preferredId;
      loadAudio(preferred).catch((error) => console.error(error));
    }
  }

  function selectedAudio() {
    const items = audios(currentWork);
    const selected = canon($('#audio-select').value);
    return items.find((item, index) => canon(item?.id ?? item?.idAudio ?? item?.Id_Audio ?? index) === selected) || null;
  }

  function setZoom(value) {
    zoomPercent = Math.max(50, Math.min(200, value));
    $('#zoom-value').textContent = `${zoomPercent}%`;
    renderPage().catch(showError);
  }

  function showError(error) {
    console.error(error);
    $('#pdf-status').hidden = false;
    $('#pdf-status').textContent = String(error?.message || 'Non foi posible abrir a partitura.');
  }

  async function toggleFullscreen() {
    const player = $('#app');
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else if (player.requestFullscreen) await player.requestFullscreen();
    } catch (error) {
      console.warn(error);
    }
  }

  $('#prev').addEventListener('click', () => { currentPage -= 1; renderPage().catch(showError); });
  $('#next').addEventListener('click', () => { currentPage += 1; renderPage().catch(showError); });
  $('#page-number').addEventListener('change', (event) => { currentPage = Number(event.target.value) || 1; renderPage().catch(showError); });
  $('#zoom-out').addEventListener('click', () => setZoom(zoomPercent - 10));
  $('#zoom-in').addEventListener('click', () => setZoom(zoomPercent + 10));
  $('#fullscreen').addEventListener('click', toggleFullscreen);
  $('#audio-select').addEventListener('change', () => loadAudio(selectedAudio()).catch(console.error));
  window.addEventListener('resize', () => { if (pdfDocument) window.setTimeout(() => renderPage().catch(showError), 120); });
  window.addEventListener('beforeunload', () => { if (audioUrl) URL.revokeObjectURL(audioUrl); });

  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      location.href = '/portal/';
      return;
    }
    try {
      [repertoirePayload, rehearsalPayload] = await Promise.all([
        apiJson('/api/repertorio', 'listarRepertorioPortal'),
        apiJson('/api/ensaios-coralista', 'listar').catch(() => null)
      ]);
      currentWork = findWork(requestedWorkId) || catalogWorks()[0] || null;
      if (!currentWork) throw new Error('Non se atopou a obra no catálogo de Repertorio.');

      $('#work-title').textContent = workName(currentWork) || `Obra ${requestedWorkId}`;
      $('#work-meta').textContent = [currentWork?.compositor, currentWork?.autorLetra].filter(Boolean).join(' · ');
      renderAudioOptions(currentWork);

      const score = scores(currentWork)[0] || null;
      if (!score) throw new Error('Esta obra non ten partitura dispoñible.');

      $('#loading').hidden = true;
      $('#app').hidden = false;
      await loadPdf(score);
    } catch (error) {
      $('#loading').hidden = true;
      $('#error').hidden = false;
      $('#error').textContent = String(error?.message || 'Non foi posible cargar o material de estudo.');
    }
  });
</script>

<style>
  .new-study-layout { display:grid; grid-template-columns:282px minmax(0,1fr); min-height:100vh; background:#f7f6f4; }
  .new-study-main { min-width:0; padding:1rem 1.2rem 5rem; }
  .new-study-header { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:.65rem; }
  .new-study-header h1 { margin:0; font-size:clamp(1.45rem,2.5vw,2rem); line-height:1.1; }
  .new-study-header a { color:var(--color-principal); font-weight:800; text-decoration:none; white-space:nowrap; }
  .study-message { padding:1rem; border:1px solid #ded9d4; border-radius:6px; background:#fff; }
  .study-message.error { color:#7a263a; }
  .study-player { display:flex; flex-direction:column; min-height:calc(100vh - 110px); overflow:hidden; border:1px solid #ded9d4; border-radius:7px; background:#fff; }
  .study-topbar { display:grid; grid-template-columns:minmax(170px,1fr) minmax(190px,320px) auto auto; gap:.5rem; align-items:center; padding:.5rem .65rem; border-bottom:1px solid #e7e2de; }
  .work-info { min-width:0; }
  .work-info strong,.work-info small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .work-info small { color:#746e69; font-size:.72rem; }
  .voice-select { display:grid; gap:.15rem; }
  .voice-select span { font-size:.66rem; font-weight:800; }
  .voice-select select { width:100%; min-height:2.15rem; padding:.3rem .45rem; border:1px solid #d4cec8; border-radius:4px; background:#fff; font:inherit; }
  .zoom-controls { display:grid; grid-template-columns:2rem 3.2rem 2rem; align-items:center; overflow:hidden; border:1px solid #d4cec8; border-radius:4px; }
  .zoom-controls button,.fullscreen { min-height:2.15rem; border:0; background:#fff; color:var(--color-principal); font:inherit; font-weight:900; cursor:pointer; }
  .zoom-controls strong { text-align:center; font-size:.76rem; }
  .fullscreen { min-width:2.3rem; border:1px solid #d4cec8; border-radius:4px; font-size:1rem; }
  .audio-row { padding:.35rem .55rem; border-bottom:1px solid #e7e2de; }
  .audio-row audio { display:block; width:100%; height:34px; }
  .viewer-shell { flex:1 1 auto; min-height:0; overflow:auto; background:#d3d0cc; text-align:center; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; }
  .pdf-status { display:grid; min-height:420px; place-items:center; padding:1rem; color:#655f5a; }
  .canvas-wrap { display:inline-block; min-width:100%; padding:.5rem; line-height:0; box-sizing:border-box; }
  #pdf-canvas { display:inline-block; max-width:none; background:#fff; box-shadow:0 2px 12px rgba(0,0,0,.16); }
  .page-nav { display:grid; grid-template-columns:1fr auto 1fr; gap:.5rem; align-items:center; padding:.45rem; border-top:1px solid #d7d0ca; background:#fff; }
  .page-nav button { min-height:2.65rem; border:1px solid var(--color-principal); border-radius:5px; background:#fff; color:var(--color-principal); font:inherit; font-weight:800; }
  .page-nav button:last-child { background:var(--color-principal); color:#fff; }
  .page-nav button:disabled { opacity:.35; }
  .page-nav label { display:grid; grid-template-columns:auto 58px auto; gap:.3rem; align-items:center; font-size:.75rem; font-weight:800; }
  .page-nav input { width:58px; min-height:2.35rem; border:1px solid #d4cec8; border-radius:4px; text-align:center; }
  .study-player:fullscreen { width:100vw; height:100vh; border:0; border-radius:0; }

  @media (max-width:1180px) {
    .new-study-layout { grid-template-columns:1fr; }
  }

  @media (max-width:760px) {
    .new-study-main { padding:.45rem .4rem 4.8rem; }
    .new-study-header { margin:.15rem .2rem .45rem; }
    .new-study-header h1 { font-size:1.35rem; }
    .new-study-header a { font-size:.8rem; }
    .study-player { min-height:calc(100dvh - 165px); border-radius:6px; }
    .study-topbar { grid-template-columns:minmax(0,1fr) auto auto; gap:.35rem; padding:.38rem .42rem; }
    .work-info { grid-column:1 / -1; display:flex; gap:.4rem; align-items:baseline; }
    .work-info strong { flex:1 1 auto; font-size:.88rem; }
    .work-info small { flex:0 1 auto; font-size:.65rem; }
    .voice-select span { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
    .voice-select select { min-height:2rem; font-size:.78rem; }
    .zoom-controls { grid-template-columns:1.8rem 2.8rem 1.8rem; }
    .zoom-controls button,.fullscreen { min-height:2rem; }
    .audio-row { padding:.28rem .38rem; }
    .audio-row audio { height:32px; }
    .pdf-status { min-height:360px; }
    .canvas-wrap { padding:.22rem; }
    .page-nav { position:fixed; z-index:90; left:.45rem; right:.45rem; bottom:max(.45rem,env(safe-area-inset-bottom)); border:1px solid #d7d0ca; border-radius:8px; box-shadow:0 10px 30px rgba(35,30,27,.18); }
    .page-nav button { min-height:3rem; }
  }

  @media (max-width:420px) {
    .page-nav button span { display:none; }
  }
</style>
