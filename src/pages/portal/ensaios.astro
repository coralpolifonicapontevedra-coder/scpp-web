---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="ensaios" logoutId="ensaios-logout" />

    <main class="ensaios-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Portal do Coralista</span>
          <h1>Ensaios</h1>
          <p>Planificación, asistencia, repertorio traballado e seguimento da preparación musical.</p>
        </div>
        <div class="header-actions">
          <button id="new-rehearsal-button" class="new-rehearsal-button" type="button" hidden>+ Novo ensaio</button>
          <div class="account-card" aria-label="Conta identificada">
            <small>Conta identificada</small>
            <strong id="user-email">—</strong>
          </div>
        </div>
      </header>

      <dialog id="new-rehearsal-dialog" class="rehearsal-dialog">
        <form id="new-rehearsal-form" class="rehearsal-form">
          <header>
            <div>
              <span class="section-kicker">Planificación</span>
              <h2>Novo ensaio</h2>
              <p>O ensaio gardarase na Sheet e o índice privado de R2 actualizarase despois da escritura.</p>
            </div>
            <button id="close-rehearsal-dialog" class="dialog-close" type="button" aria-label="Pechar">×</button>
          </header>
          <div class="form-grid">
            <label>Data <input id="new-date" type="date" required /></label>
            <label>Hora de inicio <input id="new-start" type="time" required /></label>
            <label>Hora de fin <input id="new-end" type="time" /></label>
            <label>Lugar <input id="new-place" type="text" maxlength="120" /></label>
            <label>Tipo de ensaio
              <input id="new-type" type="text" list="rehearsal-types" maxlength="80" required />
              <datalist id="rehearsal-types">
                <option value="Ordinario"></option>
                <option value="Extraordinario"></option>
                <option value="Xeral"></option>
                <option value="Por cordas"></option>
              </datalist>
            </label>
            <label>Concerto relacionado
              <select id="new-concert"><option value="">Sen concerto asociado</option></select>
            </label>
            <label class="form-wide">Descrición <textarea id="new-description" rows="3"></textarea></label>
            <label class="form-wide">Observacións <textarea id="new-notes" rows="3"></textarea></label>
          </div>
          <p id="new-rehearsal-status" class="form-status" role="status" aria-live="polite"></p>
          <footer>
            <button id="cancel-new-rehearsal" class="secondary-button" type="button">Cancelar</button>
            <button id="save-new-rehearsal" class="primary-button" type="submit">Gardar ensaio</button>
          </footer>
        </form>
      </dialog>

      <dialog id="program-dialog" class="rehearsal-dialog program-dialog">
        <form id="program-form" class="rehearsal-form">
          <header>
            <div>
              <span class="section-kicker">Obras traballadas</span>
              <h2>Incluír desde programa</h2>
              <p>Escolle o concerto do que queres incorporar o programa.</p>
            </div>
            <button id="close-program-dialog" class="dialog-close" type="button" aria-label="Pechar">×</button>
          </header>
          <label class="program-select-label">Concerto
            <select id="program-concert-select"><option value="">Escolle un concerto…</option></select>
          </label>
          <p id="program-dialog-message" class="form-status" role="status" aria-live="polite"></p>
          <footer>
            <button id="cancel-program" class="secondary-button" type="button">Cancelar</button>
            <button class="primary-button" type="submit">Incluír programa</button>
          </footer>
        </form>
      </dialog>

      <section id="loading" class="portal-state">Cargando os ensaios…</section>
      <section id="error-state" class="portal-state error-state" hidden>
        <strong>Non foi posible cargar os ensaios</strong>
        <p id="error-message"></p>
        <button id="retry-button" type="button">Tentar de novo</button>
      </section>

      <section id="ensaios-app" class="ensaios-app" hidden>
        <nav class="view-switch" aria-label="Vistas de ensaios">
          <button type="button" class="is-active" data-view="proximo">Próximo ensaio</button>
          <button type="button" data-view="calendario">Calendario</button>
          <button type="button" data-view="historico">Histórico</button>
          <button type="button" data-view="seguimento">Seguimento</button>
        </nav>

        <section id="view-proximo" class="module-view">
          <article id="next-rehearsal" class="hero-card"></article>
          <section id="work-panel" class="work-panel" hidden>
            <div class="work-tabs">
              <button type="button" class="is-active" data-work="asistencia">Asistencia</button>
              <button type="button" data-work="repertorio">Obras traballadas</button>
            </div>

            <div id="attendance-panel" class="work-content">
              <div class="voice-tabs" aria-label="Asistencia por corda">
                <button type="button" class="is-active" data-voice="Asistentes">Asistentes</button>
                <button type="button" data-voice="Soprano">Sopranos</button>
                <button type="button" data-voice="Contralto">Contraltos</button>
                <button type="button" data-voice="Tenor">Tenores</button>
                <button type="button" data-voice="Baixo">Baixos</button>
              </div>
              <div class="attendance-heading">
                <div><span>Control de presenza</span><h2 id="attendance-title">Asistentes</h2></div>
                <strong id="attendance-summary">—</strong>
              </div>
              <div id="attendance-list" class="attendance-list"></div>
            </div>

            <div id="repertoire-panel" class="work-content" hidden>
              <div class="attendance-heading">
                <div><span>Preparación musical</span><h2>Obras traballadas</h2></div>
                <strong id="repertoire-summary">—</strong>
              </div>
              <div class="repertoire-tools">
                <button id="include-program" type="button" class="secondary-button">Incluír desde programa</button>
                <div class="work-search">
                  <input id="work-search-input" type="search" placeholder="Buscar por título ou compositor…" autocomplete="off" />
                  <select id="work-search-select"><option value="">Escolle unha obra…</option></select>
                  <button id="add-work" type="button" class="primary-button">Engadir obra</button>
                </div>
              </div>
              <p id="repertoire-message" class="helper" role="status" aria-live="polite"></p>
              <div id="repertoire-list" class="repertoire-list"></div>
            </div>
          </section>
        </section>

        <section id="view-calendario" class="module-view" hidden>
          <header class="section-heading">
            <div><span>Planificación</span><h2>Calendario de ensaios</h2></div>
            <strong id="calendar-summary"></strong>
          </header>
          <div id="calendar-list" class="rehearsal-list"></div>
        </section>

        <section id="view-historico" class="module-view" hidden>
          <header class="section-heading">
            <div><span>Arquivo de traballo</span><h2>Histórico</h2></div>
            <strong id="history-summary"></strong>
          </header>
          <div id="history-list" class="rehearsal-list"></div>
        </section>

        <section id="view-seguimento" class="module-view" hidden>
          <header class="section-heading">
            <div><span>Dirección e Xunta Directiva</span><h2>Seguimento</h2><p>Indicadores calculados sobre o período seleccionado.</p></div>
          </header>
          <form id="tracking-form" class="tracking-filters">
            <label>Desde<input id="date-from" type="date" /></label>
            <label>Ata<input id="date-to" type="date" /></label>
            <label>Concerto<select id="concert-filter"><option value="">Todos</option></select></label>
            <label>Corda<select id="voice-filter"><option value="">Todas</option><option>Soprano</option><option>Contralto</option><option>Tenor</option><option>Baixo</option></select></label>
            <button type="submit">Aplicar</button>
          </form>
          <div id="tracking-kpis" class="kpi-grid"></div>
          <div class="tracking-grid">
            <section class="tracking-card"><h3>Asistencia por corda</h3><div id="tracking-voices"></div></section>
            <section class="tracking-card"><h3>Obras traballadas</h3><div id="tracking-works"></div></section>
          </div>
        </section>

        <p id="data-source" class="data-source" aria-live="polite"></p>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const $ = (selector) => document.querySelector(selector);
  const loading = $('#loading');
  const errorState = $('#error-state');
  const errorMessage = $('#error-message');
  const app = $('#ensaios-app');
  const userEmail = $('#user-email');
  const dataSource = $('#data-source');
  const newButton = $('#new-rehearsal-button');
  const newDialog = $('#new-rehearsal-dialog');
  const newForm = $('#new-rehearsal-form');
  const newStatus = $('#new-rehearsal-status');
  const programDialog = $('#program-dialog');
  let payload = null;
  let selectedRehearsal = null;
  let selectedVoice = 'Asistentes';

  const esc = (value = '') => String(value).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const norm = (value = '') => String(value).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
  const compactNorm = (value = '') => norm(value).replace(/[^a-z0-9]/g, '');
  const truthy = (value) => value === true || ['true','1','si','sí','yes','x'].includes(norm(value));
  const toDate = (value) => {
    const text = String(value || '').trim();
    if (!text) return null;
    const iso = /^\d{4}-\d{2}-\d{2}/.test(text) ? text.slice(0, 10) : text.split(/[\/-]/).reverse().join('-');
    const date = new Date(`${iso}T12:00:00`);
    return Number.isNaN(date.getTime()) ? null : date;
  };
  const fmtDate = (value) => {
    const date = toDate(value);
    return date ? new Intl.DateTimeFormat('gl-ES', { weekday:'long', day:'numeric', month:'long', year:'numeric' }).format(date) : String(value || '');
  };
  const fmtTime = (value) => String(value || '').trim().replace(/^(\d{1,2}:\d{2}):\d{2}$/, '$1');
  const personName = (person) => person.nomeCompleto || [person.nome, person.primeiroApelido, person.segundoApelido].filter(Boolean).join(' ');
  const alpha = (a, b) => personName(a).localeCompare(personName(b), 'gl', { sensitivity:'base' });

  async function api(accion, extra = {}) {
    const user = auth.currentUser;
    if (!user?.email) throw new Error('A sesión non está dispoñible.');
    const idToken = await user.getIdToken();
    const response = await fetch('/api/ensaios', {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body:JSON.stringify({ idToken, accion, ...extra })
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || `Erro ${response.status}`);
    return result;
  }

  function rehearsalId(item) { return String(item?.idEnsaio || item?.id || '').trim(); }
  function rehearsalById(id) { return (payload?.ensaios || []).find((item) => rehearsalId(item) === String(id || '')); }
  function uniqueRehearsals(items = []) {
    const map = new Map();
    items.forEach((item) => {
      const key = rehearsalId(item) || [item.data, item.horaInicio, item.tipoEnsaio, item.lugar].map((v) => compactNorm(v)).join('|');
      if (key && !map.has(key)) map.set(key, item);
    });
    return [...map.values()];
  }
  function nextRehearsal() {
    const today = new Date();
    today.setHours(0,0,0,0);
    return uniqueRehearsals(payload?.ensaios || [])
      .filter((item) => !truthy(item.cancelado) && (!toDate(item.data) || toDate(item.data) >= today))
      .sort((a,b) => (toDate(a.data)?.getTime() || 0) - (toDate(b.data)?.getTime() || 0))[0] || null;
  }
  function concertById(id) { return (payload?.concertos || []).find((concert) => String(concert.id || '') === String(id || '')) || null; }
  function selectedConcert() { return concertById(selectedRehearsal?.concerto); }

  function renderHero() {
    selectedRehearsal = selectedRehearsal || nextRehearsal();
    const box = $('#next-rehearsal');
    if (!selectedRehearsal) {
      box.innerHTML = '<div class="empty-state"><strong>Non hai próximos ensaios rexistrados.</strong></div>';
      $('#work-panel').hidden = true;
      return;
    }
    const rehearsal = selectedRehearsal;
    const cancelled = truthy(rehearsal.cancelado);
    const horario = [fmtTime(rehearsal.horaInicio), rehearsal.horaFin ? fmtTime(rehearsal.horaFin) : ''].filter(Boolean).join(' – ');
    const situacion = [horario, rehearsal.lugar].filter(Boolean).join(' · ');
    const clasificacion = [rehearsal.tipoEnsaio, rehearsal.concertoNome || 'Ensaio xeral'].filter(Boolean).join(' · ');
    box.innerHTML = `<div class="hero-date"><span>${cancelled ? 'Ensaio cancelado' : 'Próximo ensaio'}</span><h2>${esc(fmtDate(rehearsal.data))}</h2>${situacion ? `<p>${esc(situacion)}</p>` : ''}</div><div class="hero-meta"><p class="hero-classification">${esc(clasificacion)}</p>${rehearsal.descricion ? `<p>${esc(rehearsal.descricion)}</p>` : ''}</div>`;
    $('#work-panel').hidden = false;
    selectedVoice = 'Asistentes';
    document.querySelectorAll('[data-voice]').forEach((button) => button.classList.toggle('is-active', button.dataset.voice === 'Asistentes'));
    renderAttendance();
    renderRepertoire();
  }

  function attendanceForSelected() {
    const id = rehearsalId(selectedRehearsal);
    return (payload?.asistencias || []).filter((attendance) => String(attendance.ensaio || attendance.idEnsaio || '') === id);
  }
  function attendanceMap() {
    return new Map(attendanceForSelected().map((attendance) => [String(attendance.persoa || attendance.idPersoa || ''), attendance]));
  }
  function renderAttendance() {
    const people = [...(payload?.persoas || [])];
    const map = attendanceMap();
    const title = $('#attendance-title');
    if (selectedVoice === 'Asistentes') {
      const voices = ['Soprano','Contralto','Tenor','Baixo'];
      let total = 0;
      const sections = voices.map((voice) => {
        const present = people.filter((person) => norm(person.voz) === norm(voice) && norm(map.get(String(person.idPersoa || person.id || ''))?.estadoAsistencia) === 'asiste').sort(alpha);
        total += present.length;
        const label = voice === 'Baixo' ? 'Baixos' : `${voice}s`;
        return `<section class="attendance-group"><header><h3>${esc(label)}</h3><strong>${present.length}</strong></header>${present.length ? `<div class="attendee-names">${present.map((person) => `<span>${esc(personName(person))}</span>`).join('')}</div>` : '<p class="helper group-empty">Sen asistentes rexistrados.</p>'}</section>`;
      }).join('');
      if (title) title.textContent = 'Asistentes';
      $('#attendance-summary').textContent = `${total} asistentes`;
      $('#attendance-list').innerHTML = sections;
      return;
    }

    const filtered = people.filter((person) => norm(person.voz) === norm(selectedVoice)).sort(alpha);
    const decided = filtered.filter((person) => {
      const state = norm(map.get(String(person.idPersoa || person.id || ''))?.estadoAsistencia);
      return state === 'asiste' || state === 'non asiste';
    }).length;
    const present = filtered.filter((person) => norm(map.get(String(person.idPersoa || person.id || ''))?.estadoAsistencia) === 'asiste').length;
    if (title) title.textContent = selectedVoice === 'Baixo' ? 'Baixos' : `${selectedVoice}s`;
    $('#attendance-summary').textContent = `${present} asisten · ${decided}/${filtered.length} rexistrados`;
    $('#attendance-list').innerHTML = filtered.map((person) => {
      const id = String(person.idPersoa || person.id || '');
      const attendance = map.get(id) || {};
      const state = norm(attendance.estadoAsistencia);
      return `<article class="person-row" data-person="${esc(id)}"><strong>${esc(personName(person))}</strong><div class="attendance-actions"><button type="button" class="${state === 'asiste' ? 'is-selected' : ''}" data-state="Asiste">✓ Asiste</button><button type="button" class="${state === 'non asiste' ? 'is-selected negative' : ''}" data-state="Non asiste">× Non asiste</button></div><label class="justify"><input type="checkbox" ${truthy(attendance.xustificada) ? 'checked' : ''} disabled /> Xustificada</label><span class="save-status" aria-live="polite"></span></article>`;
    }).join('') || '<p class="empty-state">Non hai persoas nesta corda.</p>';
  }

  function workedForSelected() {
    const id = rehearsalId(selectedRehearsal);
    return (payload?.ensaiosRepertorio || []).filter((row) => String(row.ensaio || row.idEnsaio || '') === id);
  }
  function workById(id) { return (payload?.repertorio || []).find((work) => String(work.idRepertorio || work.id || '') === String(id || '')); }
  function resolveProgramWorkId(item) {
    if (item?.idRepertorio && workById(item.idRepertorio)) return String(item.idRepertorio);
    const target = compactNorm(item?.obra || '');
    if (!target) return '';
    const works = payload?.repertorio || [];
    const exact = works.find((work) => compactNorm(work.nomeObra || work.nome || '') === target);
    if (exact) return String(exact.idRepertorio || exact.id || '');
    const close = works.find((work) => {
      const candidate = compactNorm(work.nomeObra || work.nome || '');
      return candidate && (candidate.includes(target) || target.includes(candidate));
    });
    return close ? String(close.idRepertorio || close.id || '') : '';
  }
  function updateWorkSearch() {
    const input = $('#work-search-input');
    const select = $('#work-search-select');
    if (!(select instanceof HTMLSelectElement)) return;
    const query = norm(input?.value || '');
    const already = new Set(workedForSelected().map((row) => String(row.repertorio || row.idRepertorio || '')));
    const options = (payload?.repertorio || [])
      .filter((work) => !already.has(String(work.idRepertorio || work.id || '')) && (!query || norm([work.nomeObra, work.nome, work.compositor].join(' ')).includes(query)))
      .sort((a,b) => String(a.nomeObra || a.nome || '').localeCompare(String(b.nomeObra || b.nome || ''), 'gl', { sensitivity:'base' }))
      .slice(0, 80);
    select.innerHTML = '<option value="">Escolle unha obra…</option>' + options.map((work) => `<option value="${esc(work.idRepertorio || work.id || '')}">${esc([work.nomeObra || work.nome, work.compositor].filter(Boolean).join(' — '))}</option>`).join('');
  }
  function renderRepertoire() {
    const worked = workedForSelected().sort((a,b) => Number(a.orde || 999) - Number(b.orde || 999));
    $('#repertoire-summary').textContent = `${worked.length} traballadas`;
    $('#repertoire-list').innerHTML = worked.map((row) => {
      const id = String(row.repertorio || row.idRepertorio || '');
      const work = workById(id) || {};
      return `<article class="work-row" data-work-id="${esc(id)}"><div class="work-main"><a class="work-link" href="/portal/repertorio/?id=${encodeURIComponent(id)}"><strong>${esc(work.nomeObra || work.nome || id)}</strong>${work.compositor ? `<small>${esc(work.compositor)}</small>` : ''}</a></div><div class="work-fields"><select class="work-type"><option value="">Tipo de traballo</option>${['Lectura','Montaxe','Repaso','Perfeccionamento','Interpretación completa'].map((value) => `<option ${row.tipoTraballo === value ? 'selected' : ''}>${value}</option>`).join('')}</select><input class="work-from" placeholder="Desde" value="${esc(row.desde || '')}"/><input class="work-to" placeholder="Ata" value="${esc(row.ata || '')}"/><input class="work-notes" placeholder="Observacións" value="${esc(row.observacions || '')}"/><button class="save-work" type="button">Gardar</button><span class="save-status"></span></div></article>`;
    }).join('') || '<p class="empty-state">Aínda non se rexistraron obras neste ensaio.</p>';
    const include = $('#include-program');
    if (include instanceof HTMLButtonElement) {
      include.disabled = !(payload?.concertos || []).some((concert) => Array.isArray(concert.programa) && concert.programa.length);
      include.title = include.disabled ? 'Non hai programas de concertos dispoñibles.' : '';
    }
    updateWorkSearch();
  }

  function rehearsalCard(item) {
    const horario = [fmtTime(item.horaInicio), item.horaFin ? fmtTime(item.horaFin) : ''].filter(Boolean).join(' – ');
    const details = [horario, item.lugar, item.concertoNome].filter(Boolean).join(' · ');
    return `<button type="button" class="rehearsal-card ${truthy(item.cancelado) ? 'is-cancelled' : ''}" data-rehearsal="${esc(rehearsalId(item))}"><time>${esc(fmtDate(item.data))}</time><div class="rehearsal-card-copy"><strong>${esc(item.tipoEnsaio || 'Ensaio')}</strong>${details ? `<span>${esc(details)}</span>` : ''}</div></button>`;
  }
  function renderLists() {
    const today = new Date();
    today.setHours(0,0,0,0);
    const all = uniqueRehearsals(payload?.ensaios || []).sort((a,b) => (toDate(b.data)?.getTime() || 0) - (toDate(a.data)?.getTime() || 0));
    const future = all.filter((item) => toDate(item.data) && toDate(item.data) >= today);
    const history = all.filter((item) => toDate(item.data) && toDate(item.data) < today);
    $('#calendar-list').innerHTML = future.map(rehearsalCard).join('') || '<p class="empty-state">Non hai ensaios previstos.</p>';
    $('#calendar-summary').textContent = `${future.length} próximos`;
    $('#history-list').innerHTML = history.map(rehearsalCard).join('') || '<p class="empty-state">Aínda non hai histórico.</p>';
    $('#history-summary').textContent = `${history.length} ensaios`;
  }
  function renderTracking(result = payload?.seguimento) {
    const tracking = result || {};
    const kpis = [['Ensaios realizados', tracking.ensaiosRealizados ?? 0], ['Asistencia media', `${tracking.asistenciaMedia ?? 0} %`], ['Ausencias xustificadas', tracking.ausenciasXustificadas ?? 0], ['Obras traballadas', tracking.obrasTraballadas ?? 0]];
    $('#tracking-kpis').innerHTML = kpis.map(([label,value]) => `<article><span>${esc(label)}</span><strong>${esc(value)}</strong></article>`).join('');
    $('#tracking-voices').innerHTML = (tracking.porVoz || []).map((item) => `<div class="metric-row"><span>${esc(item.voz)}</span><strong>${esc(item.porcentaxe)} %</strong></div>`).join('') || '<p class="helper">Sen datos no período.</p>';
    $('#tracking-works').innerHTML = (tracking.porObra || []).slice(0,12).map((item) => `<div class="metric-row"><span>${esc(item.nome)}</span><strong>${esc(item.ensaios)} ens.</strong></div>`).join('') || '<p class="helper">Sen datos no período.</p>';
  }
  function fillConcertSelectors() {
    const concerts = [...(payload?.concertos || [])].sort((a,b) => String(a.data || '').localeCompare(String(b.data || '')));
    const options = concerts.map((concert) => `<option value="${esc(concert.id)}">${esc([concert.data, concert.nome].filter(Boolean).join(' · '))}</option>`).join('');
    const newSelect = $('#new-concert');
    if (newSelect) newSelect.innerHTML = '<option value="">Sen concerto asociado</option>' + options;
    const programSelect = $('#program-concert-select');
    if (programSelect) programSelect.innerHTML = '<option value="">Escolle un concerto…</option>' + options;
    const filter = $('#concert-filter');
    if (filter) filter.innerHTML = '<option value="">Todos</option>' + concerts.map((concert) => `<option value="${esc(concert.nome)}">${esc(concert.nome)}</option>`).join('');
  }
  async function load(forzar = false) {
    loading.hidden = false;
    errorState.hidden = true;
    app.hidden = true;
    try {
      payload = await api('listarEnsaiosPortal', { forzar });
      selectedRehearsal = null;
      renderHero();
      renderLists();
      renderTracking();
      fillConcertSelectors();
      dataSource.textContent = payload.diagnostico?.fonte ? `Fonte: ${payload.diagnostico.fonte}${payload.diagnostico.xeradoEn ? ` · actualizado ${payload.diagnostico.xeradoEn}` : ''}` : '';
      if (newButton instanceof HTMLButtonElement) newButton.hidden = payload?.perfil?.podeEditar !== true;
      loading.hidden = true;
      app.hidden = false;
    } catch (error) {
      loading.hidden = true;
      errorState.hidden = false;
      errorMessage.textContent = error instanceof Error ? error.message : 'Erro descoñecido';
    }
  }

  function closeNewDialog() {
    if (newDialog instanceof HTMLDialogElement) newDialog.close();
    if (newStatus) newStatus.textContent = '';
  }
  newButton?.addEventListener('click', () => {
    if (!(newDialog instanceof HTMLDialogElement)) return;
    if (newForm instanceof HTMLFormElement) newForm.reset();
    if (newStatus) newStatus.textContent = '';
    const date = $('#new-date');
    if (date instanceof HTMLInputElement) date.value = new Date().toISOString().slice(0,10);
    newDialog.showModal();
  });
  $('#close-rehearsal-dialog')?.addEventListener('click', closeNewDialog);
  $('#cancel-new-rehearsal')?.addEventListener('click', closeNewDialog);
  newDialog?.addEventListener('click', (event) => { if (event.target === newDialog) closeNewDialog(); });
  newForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const save = $('#save-new-rehearsal');
    if (save instanceof HTMLButtonElement) { save.disabled = true; save.textContent = 'Gardando…'; }
    if (newStatus) newStatus.textContent = 'Gardando o ensaio na Sheet…';
    try {
      await api('gardarEnsaio', {
        data:$('#new-date')?.value || '',
        horaInicio:$('#new-start')?.value || '',
        horaFin:$('#new-end')?.value || '',
        lugar:$('#new-place')?.value || '',
        tipoEnsaio:$('#new-type')?.value || '',
        concerto:$('#new-concert')?.value || '',
        descricion:$('#new-description')?.value || '',
        observacions:$('#new-notes')?.value || '',
        cancelado:false
      });
      if (newStatus) newStatus.textContent = '✓ Ensaio gardado correctamente.';
      await load(true);
      setTimeout(closeNewDialog, 450);
    } catch (error) {
      if (newStatus) newStatus.textContent = error instanceof Error ? `⚠ ${error.message}` : '⚠ Non foi posible gardar o ensaio.';
    } finally {
      if (save instanceof HTMLButtonElement) { save.disabled = false; save.textContent = 'Gardar ensaio'; }
    }
  });

  $('#work-search-input')?.addEventListener('input', updateWorkSearch);
  $('#add-work')?.addEventListener('click', async () => {
    const select = $('#work-search-select');
    const message = $('#repertoire-message');
    const id = select?.value || '';
    if (!id) { if (message) message.textContent = 'Escolle primeiro unha obra.'; return; }
    if (message) message.textContent = 'Engadindo obra…';
    try {
      await api('gardarEnsaioRepertorio', { idEnsaio:rehearsalId(selectedRehearsal), idRepertorio:id, tipoTraballo:'', desde:'', ata:'', observacions:'' });
      payload = await api('listarEnsaiosPortal', { forzar:true });
      if (message) message.textContent = '✓ Obra engadida.';
      renderRepertoire();
    } catch (error) {
      if (message) message.textContent = error instanceof Error ? `⚠ ${error.message}` : '⚠ Non se puido engadir a obra.';
    }
  });

  function closeProgramDialog() {
    if (programDialog instanceof HTMLDialogElement) programDialog.close();
    const message = $('#program-dialog-message');
    if (message) message.textContent = '';
  }
  $('#include-program')?.addEventListener('click', () => {
    if (!(programDialog instanceof HTMLDialogElement)) return;
    const select = $('#program-concert-select');
    if (select instanceof HTMLSelectElement) select.value = selectedRehearsal?.concerto || '';
    const message = $('#program-dialog-message');
    if (message) message.textContent = '';
    programDialog.showModal();
  });
  $('#close-program-dialog')?.addEventListener('click', closeProgramDialog);
  $('#cancel-program')?.addEventListener('click', closeProgramDialog);
  programDialog?.addEventListener('click', (event) => { if (event.target === programDialog) closeProgramDialog(); });
  $('#program-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const select = $('#program-concert-select');
    const message = $('#program-dialog-message');
    const concert = concertById(select?.value || '');
    if (!concert) { if (message) message.textContent = 'Escolle primeiro un concerto.'; return; }
    const existing = new Set(workedForSelected().map((row) => String(row.repertorio || row.idRepertorio || '')));
    const ids = [...new Set((concert.programa || []).map(resolveProgramWorkId).filter((id) => id && !existing.has(String(id))))];
    if (!ids.length) {
      if (message) message.textContent = concert.programa?.length ? 'Non se puideron relacionar obras novas do programa co Repertorio.' : 'Ese concerto non ten programa cargado.';
      return;
    }
    if (message) message.textContent = `Incluíndo ${ids.length} obras…`;
    try {
      const result = await api('incluírProgramaEnsaio', { idEnsaio:rehearsalId(selectedRehearsal), idsRepertorio:ids });
      payload = result.payload || await api('listarEnsaiosPortal', { forzar:true });
      const mainMessage = $('#repertoire-message');
      if (mainMessage) mainMessage.textContent = `✓ ${result.engadidas || ids.length} obras incluídas desde o programa.`;
      renderRepertoire();
      closeProgramDialog();
    } catch (error) {
      if (message) message.textContent = error instanceof Error ? `⚠ ${error.message}` : '⚠ Non se puido incluír o programa.';
    }
  });

  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const viewButton = target.closest('[data-view]');
    if (viewButton) {
      document.querySelectorAll('[data-view]').forEach((button) => button.classList.toggle('is-active', button === viewButton));
      document.querySelectorAll('.module-view').forEach((view) => { view.hidden = view.id !== `view-${viewButton.dataset.view}`; });
      return;
    }
    const workButton = target.closest('[data-work]');
    if (workButton) {
      document.querySelectorAll('[data-work]').forEach((button) => button.classList.toggle('is-active', button === workButton));
      $('#attendance-panel').hidden = workButton.dataset.work !== 'asistencia';
      $('#repertoire-panel').hidden = workButton.dataset.work !== 'repertorio';
      return;
    }
    const voiceButton = target.closest('[data-voice]');
    if (voiceButton) {
      selectedVoice = voiceButton.dataset.voice || 'Asistentes';
      document.querySelectorAll('[data-voice]').forEach((button) => button.classList.toggle('is-active', button === voiceButton));
      renderAttendance();
      return;
    }
    const rehearsalButton = target.closest('[data-rehearsal]');
    if (rehearsalButton) {
      selectedRehearsal = rehearsalById(rehearsalButton.dataset.rehearsal);
      document.querySelectorAll('[data-view]').forEach((button) => button.classList.toggle('is-active', button.dataset.view === 'proximo'));
      document.querySelectorAll('.module-view').forEach((view) => { view.hidden = view.id !== 'view-proximo'; });
      renderHero();
      window.scrollTo({ top:0, behavior:'smooth' });
      return;
    }
    const stateButton = target.closest('[data-state]');
    if (stateButton) {
      const row = stateButton.closest('.person-row');
      const status = row?.querySelector('.save-status');
      if (!row) return;
      stateButton.setAttribute('disabled','');
      if (status) status.textContent = 'Gardando…';
      try {
        await api('gardarAsistenciaEnsaio', { idEnsaio:rehearsalId(selectedRehearsal), idPersoa:row.dataset.person, estadoAsistencia:stateButton.dataset.state, xustificada:false });
        payload = await api('listarEnsaiosPortal', { forzar:true });
        renderAttendance();
      } catch {
        if (status) status.textContent = '⚠ Non se puido gardar';
        stateButton.removeAttribute('disabled');
      }
      return;
    }
    const saveWork = target.closest('.save-work');
    if (saveWork) {
      const row = saveWork.closest('.work-row');
      const status = row?.querySelector('.save-status');
      if (!row) return;
      if (status) status.textContent = 'Gardando…';
      try {
        await api('gardarEnsaioRepertorio', {
          idEnsaio:rehearsalId(selectedRehearsal),
          idRepertorio:row.dataset.workId,
          tipoTraballo:row.querySelector('.work-type')?.value || '',
          desde:row.querySelector('.work-from')?.value || '',
          ata:row.querySelector('.work-to')?.value || '',
          observacions:row.querySelector('.work-notes')?.value || ''
        });
        payload = await api('listarEnsaiosPortal', { forzar:true });
        if (status) status.textContent = '✓ Gardado';
        renderRepertoire();
      } catch {
        if (status) status.textContent = '⚠ Non se puido gardar';
      }
    }
  });

  $('#tracking-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      const result = await api('obterSeguimentoEnsaios', { desde:$('#date-from')?.value || '', ata:$('#date-to')?.value || '', concerto:$('#concert-filter')?.value || '', voz:$('#voice-filter')?.value || '' });
      renderTracking(result.seguimento);
    } catch (error) {
      alert(error instanceof Error ? error.message : 'Non foi posible calcular o seguimento.');
    }
  });
  $('#retry-button')?.addEventListener('click', () => load(true));
  $('#ensaios-logout')?.addEventListener('click', async () => { await signOut(auth); location.href='/portal/acceso/'; });
  onAuthStateChanged(auth, (user) => {
    if (!user?.email) { location.href='/portal/acceso/'; return; }
    userEmail.textContent = user.email;
    load();
  });
</script>

