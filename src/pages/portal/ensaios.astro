  .rehearsal-card{display:grid;grid-template-columns:minmax(170px,.8fr) minmax(0,2fr);gap:1rem;align-items:center;width:100%;max-width:100%;box-sizing:border-box;text-align:left;padding:.9rem 1rem;border:1px solid #e4ded8;background:#fff;cursor:pointer;min-width:0}
  .rehearsal-card time{font-weight:700;color:#3d3733}.rehearsal-card-copy{display:flex;flex-wrap:wrap;gap:.35rem .75rem;align-items:baseline;min-width:0}.rehearsal-card-copy strong{flex:0 0 auto}.rehearsal-card-copy span{color:#6d655f;min-width:0;overflow-wrap:anywhere}.rehearsal-card.is-cancelled{opacity:.55;text-decoration:line-through}
  .tracking-filters{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr)) auto;gap:.75rem;align-items:end;padding:1rem;background:#fff;border:1px solid #e2ddd8;min-width:0}.tracking-filters label{display:grid;gap:.35rem;font-size:.74rem;font-weight:700}
  .kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin:1rem 0}.kpi-grid article,.tracking-card{padding:1rem;background:#fff;border:1px solid #e3ddd8;min-width:0}.kpi-grid span{display:block;color:#817872;font-size:.72rem}.kpi-grid strong{display:block;margin-top:.35rem;font-family:Georgia,'Times New Roman',serif;font-size:1.5rem}
  .tracking-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.tracking-card h3{margin-top:0}.metric-row{display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid #eee9e5}.empty-state{padding:1rem;color:#817872}.data-source{text-align:right;margin-top:1rem;overflow-wrap:anywhere}

  @media(max-width:900px){
    :global(.private-layout){display:block!important;width:100%!important;max-width:100vw!important;overflow-x:hidden!important}
    .ensaios-main{width:100%;max-width:100vw;padding:1.35rem 1rem 3rem}
    .private-page-header{display:block}.header-actions{margin-top:1rem;flex-wrap:wrap}.account-card{margin-top:0}.hero-card,.tracking-grid{grid-template-columns:1fr}.hero-meta{padding-left:0;border-left:0;border-top:1px solid #e4ded8;padding-top:1rem}
    .person-row{grid-template-columns:1fr}.work-fields{grid-template-columns:1fr 1fr}.work-search{grid-template-columns:1fr}.tracking-filters{grid-template-columns:1fr 1fr}.kpi-grid{grid-template-columns:1fr 1fr}.rehearsal-card{grid-template-columns:1fr;gap:.35rem}
  }
  @media(max-width:560px){
    .ensaios-main{padding:1rem .75rem 2.5rem}.view-switch{display:grid;grid-template-columns:1fr 1fr}.view-switch button{width:100%}.voice-tabs{display:grid;grid-template-columns:1fr 1fr}.voice-tabs button{width:100%}.voice-tabs button:first-child{grid-column:1/-1}
    .attendance-heading,.section-heading{align-items:flex-start}.attendance-heading{flex-direction:column;gap:.25rem}.attendance-actions{display:grid;grid-template-columns:1fr 1fr}.attendance-actions button{width:100%}.work-fields,.tracking-filters,.kpi-grid,.form-grid{grid-template-columns:1fr}.form-wide{grid-column:auto}.hero-card{padding:1.1rem}.private-page-header h1{font-size:1.85rem}.header-actions{display:grid}.new-rehearsal-button,.account-card{width:100%;box-sizing:border-box}.repertoire-tools{display:grid}.attendee-names{grid-template-columns:1fr}.rehearsal-form{padding:1rem}.rehearsal-form footer{flex-direction:column-reverse}.rehearsal-form footer button{width:100%}.rehearsal-card{padding:.8rem}.rehearsal-card-copy{display:grid;gap:.2rem}.data-source{text-align:left}
  }
</style>
