---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="ensaios" logoutId="ensaios-logout" />

    <main class="ensaios-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Portal do Coralista</span>
          <h1>Ensaios</h1>
          <p>Planificación, asistencia, repertorio traballado e seguimento da preparación musical.</p>
        </div>
        <div class="account-card" aria-label="Conta identificada">
          <small>Conta identificada</small>
          <strong id="user-email">—</strong>
        </div>
      </header>

      <section id="loading" class="portal-state">Cargando os ensaios…</section>
      <section id="error-state" class="portal-state error-state" hidden>
        <strong>Non foi posible cargar os ensaios</strong>
        <p id="error-message"></p>
        <button id="retry-button" type="button">Tentar de novo</button>
      </section>

      <section id="ensaios-app" class="ensaios-app" hidden>
        <nav class="view-switch" aria-label="Vistas de ensaios">
          <button type="button" class="is-active" data-view="proximo">Próximo ensaio</button>
          <button type="button" data-view="calendario">Calendario</button>
          <button type="button" data-view="historico">Histórico</button>
          <button type="button" data-view="seguimento">Seguimento</button>
        </nav>

        <section id="view-proximo" class="module-view">
          <article id="next-rehearsal" class="hero-card"></article>
          <section id="work-panel" class="work-panel" hidden>
            <div class="work-tabs">
              <button type="button" class="is-active" data-work="asistencia">Asistencia</button>
              <button type="button" data-work="repertorio">Obras traballadas</button>
            </div>

            <div id="attendance-panel" class="work-content">
              <div class="voice-tabs" aria-label="Filtrar por corda">
                <button type="button" class="is-active" data-voice="Todas">Todas</button>
                <button type="button" data-voice="Soprano">Sopranos</button>
                <button type="button" data-voice="Contralto">Contraltos</button>
                <button type="button" data-voice="Tenor">Tenores</button>
                <button type="button" data-voice="Baixo">Baixos</button>
              </div>
              <div class="attendance-heading">
                <div><span>Control de presenza</span><h2>Asistencia</h2></div>
                <strong id="attendance-summary">—</strong>
              </div>
              <div id="attendance-list" class="attendance-list"></div>
            </div>

            <div id="repertoire-panel" class="work-content" hidden>
              <div class="attendance-heading">
                <div><span>Preparación musical</span><h2>Obras traballadas</h2></div>
                <strong id="repertoire-summary">—</strong>
              </div>
              <p class="helper">As obras do concerto asociado aparecen primeiro. Os audios ábrense desde o índice privado de Repertorio en R2.</p>
              <div id="repertoire-list" class="repertoire-list"></div>
            </div>
          </section>
        </section>

        <section id="view-calendario" class="module-view" hidden>
          <header class="section-heading"><div><span>Planificación</span><h2>Calendario de ensaios</h2></div><strong id="calendar-summary"></strong></header>
          <div id="calendar-list" class="rehearsal-list"></div>
        </section>

        <section id="view-historico" class="module-view" hidden>
          <header class="section-heading"><div><span>Arquivo de traballo</span><h2>Histórico</h2></div><strong id="history-summary"></strong></header>
          <div id="history-list" class="rehearsal-list"></div>
        </section>

        <section id="view-seguimento" class="module-view" hidden>
          <header class="section-heading"><div><span>Dirección e Xunta Directiva</span><h2>Seguimento</h2><p>Indicadores calculados sobre o período seleccionado.</p></div></header>
          <form id="tracking-form" class="tracking-filters">
            <label>Desde<input id="date-from" type="date" /></label>
            <label>Ata<input id="date-to" type="date" /></label>
            <label>Concerto<select id="concert-filter"><option value="">Todos</option></select></label>
            <label>Corda<select id="voice-filter"><option value="">Todas</option><option>Soprano</option><option>Contralto</option><option>Tenor</option><option>Baixo</option></select></label>
            <button type="submit">Aplicar</button>
          </form>
          <div id="tracking-kpis" class="kpi-grid"></div>
          <div class="tracking-grid">
            <section class="tracking-card"><h3>Asistencia por corda</h3><div id="tracking-voices"></div></section>
            <section class="tracking-card"><h3>Obras traballadas</h3><div id="tracking-works"></div></section>
          </div>
        </section>

        <p id="data-source" class="data-source" aria-live="polite"></p>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const $ = (selector) => document.querySelector(selector);
  const loading = $('#loading');
  const errorState = $('#error-state');
  const errorMessage = $('#error-message');
  const app = $('#ensaios-app');
  const userEmail = $('#user-email');
  const dataSource = $('#data-source');
  let payload = null;
  let selectedRehearsal = null;
  let selectedVoice = 'Todas';

  const esc = (value = '') => String(value).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const norm = (value = '') => String(value).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
  const truthy = (value) => value === true || ['true','1','si','sí','yes','x'].includes(norm(value));
  const toDate = (value) => { const text=String(value||'').trim(); if(!text) return null; const iso=/^\d{4}-\d{2}-\d{2}/.test(text)?text.slice(0,10):text.split(/[\/-]/).reverse().join('-'); const d=new Date(`${iso}T12:00:00`); return Number.isNaN(d.getTime())?null:d; };
  const fmtDate = (value) => { const d=toDate(value); return d ? new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d) : String(value||''); };
  const fmtTime = (value) => String(value||'').trim().replace(/^(\d{1,2}:\d{2}):\d{2}$/, '$1');

  async function api(accion, extra = {}) {
    const user = auth.currentUser;
    if (!user?.email) throw new Error('A sesión non está dispoñible.');
    const idToken = await user.getIdToken();
    const response = await fetch('/api/ensaios', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ idToken, accion, ...extra }) });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || `Erro ${response.status}`);
    return result;
  }

  function rehearsalById(id) { return (payload?.ensaios || []).find((item) => String(item.idEnsaio || item.id || '') === String(id || '')); }
  function nextRehearsal() {
    const now = new Date(); now.setHours(0,0,0,0);
    return [...(payload?.ensaios || [])].filter((e)=>!truthy(e.cancelado) && (!toDate(e.data) || toDate(e.data)>=now)).sort((a,b)=>(toDate(a.data)?.getTime()||0)-(toDate(b.data)?.getTime()||0))[0] || null;
  }

  function renderHero() {
    selectedRehearsal = selectedRehearsal || nextRehearsal();
    const box = $('#next-rehearsal');
    if (!selectedRehearsal) { box.innerHTML='<div class="empty-state"><strong>Non hai próximos ensaios rexistrados.</strong></div>'; $('#work-panel').hidden=true; return; }
    const e=selectedRehearsal; const cancelled=truthy(e.cancelado);
    box.innerHTML=`<div class="hero-date"><span>${cancelled?'Ensaio cancelado':'Próximo ensaio'}</span><h2>${esc(fmtDate(e.data))}</h2><p>${esc(fmtTime(e.horaInicio))}${e.horaFin?` – ${esc(fmtTime(e.horaFin))}`:''}${e.lugar?` · ${esc(e.lugar)}`:''}</p></div><div class="hero-meta">${e.tipoEnsaio?`<span>${esc(e.tipoEnsaio)}</span>`:''}${e.concertoNome?`<strong>${esc(e.concertoNome)}</strong>`:'<strong>Ensaio xeral</strong>'}${e.descricion?`<p>${esc(e.descricion)}</p>`:''}</div>`;
    $('#work-panel').hidden=false; renderAttendance(); renderRepertoire();
  }

  function attendanceForSelected() { const id=String(selectedRehearsal?.idEnsaio||selectedRehearsal?.id||''); return (payload?.asistencias||[]).filter((a)=>String(a.ensaio||a.idEnsaio||'')===id); }
  function peopleForVoice() { return (payload?.persoas||[]).filter((p)=>selectedVoice==='Todas' || norm(p.voz)===norm(selectedVoice)); }
  function renderAttendance() {
    const attendances=attendanceForSelected(); const people=peopleForVoice(); const map=new Map(attendances.map((a)=>[String(a.persoa||a.idPersoa||''),a]));
    const present=people.filter((p)=>norm(map.get(String(p.idPersoa||p.id||''))?.estadoAsistencia)==='asiste').length;
    $('#attendance-summary').textContent=`${present} / ${people.length}`;
    $('#attendance-list').innerHTML=people.map((p)=>{ const id=String(p.idPersoa||p.id||''); const a=map.get(id)||{}; const state=norm(a.estadoAsistencia); return `<article class="person-row" data-person="${esc(id)}"><div><strong>${esc(p.nomeCompleto||[p.nome,p.primeiroApelido,p.segundoApelido].filter(Boolean).join(' '))}</strong><span>${esc(p.voz||'')}</span></div><div class="attendance-actions"><button type="button" class="${state==='asiste'?'is-selected':''}" data-state="Asiste">✓ Asiste</button><button type="button" class="${state==='non asiste'?'is-selected negative':''}" data-state="Non asiste">× Non asiste</button></div><label class="justify"><input type="checkbox" ${truthy(a.xustificada)?'checked':''} ${state==='non asiste'?'':'disabled'} /> Xustificada</label><span class="save-status" aria-live="polite"></span></article>`; }).join('') || '<p class="empty-state">Non hai persoas nesta corda.</p>';
  }

  function renderRepertoire() {
    const id=String(selectedRehearsal?.idEnsaio||selectedRehearsal?.id||''); const worked=(payload?.ensaiosRepertorio||[]).filter((r)=>String(r.ensaio||r.idEnsaio||'')===id); const workedMap=new Map(worked.map((r)=>[String(r.repertorio||r.idRepertorio||''),r]));
    const works=(payload?.repertorio||[]); $('#repertoire-summary').textContent=`${worked.length} traballadas`;
    $('#repertoire-list').innerHTML=works.map((w)=>{const wid=String(w.idRepertorio||w.id||''); const r=workedMap.get(wid); const audios=Array.isArray(w.audios)?w.audios:[]; return `<article class="work-row" data-work-id="${esc(wid)}"><div class="work-main"><label><input type="checkbox" class="worked-check" ${r?'checked':''}/><span><strong>${esc(w.nomeObra||w.nome||'Obra')}</strong>${w.compositor?`<small>${esc(w.compositor)}</small>`:''}</span></label><div class="audio-links">${audios.slice(0,6).map((a)=>`<a href="${esc(a.url||a.href||'#')}" target="_blank" rel="noopener">▶ ${esc(a.voz||a.tipo||'Audio')}</a>`).join('')}</div></div><div class="work-fields" ${r?'':'hidden'}><select class="work-type"><option value="">Tipo de traballo</option>${['Lectura','Montaxe','Repaso','Perfeccionamento','Interpretación completa'].map((v)=>`<option ${r?.tipoTraballo===v?'selected':''}>${v}</option>`).join('')}</select><input class="work-from" placeholder="Desde" value="${esc(r?.desde||'')}"/><input class="work-to" placeholder="Ata" value="${esc(r?.ata||'')}"/><input class="work-notes" placeholder="Observacións" value="${esc(r?.observacions||'')}"/><button class="save-work" type="button">Gardar</button><span class="save-status"></span></div></article>`;}).join('') || '<p class="empty-state">Non hai repertorio dispoñible.</p>';
  }

  function renderLists() {
    const today=new Date(); today.setHours(0,0,0,0); const all=[...(payload?.ensaios||[])].sort((a,b)=>(toDate(b.data)?.getTime()||0)-(toDate(a.data)?.getTime()||0));
    const card=(e)=>`<button type="button" class="rehearsal-card ${truthy(e.cancelado)?'is-cancelled':''}" data-rehearsal="${esc(e.idEnsaio||e.id||'')}"><time>${esc(fmtDate(e.data))}</time><strong>${esc(e.tipoEnsaio||'Ensaio')}</strong><span>${esc([fmtTime(e.horaInicio),e.lugar,e.concertoNome].filter(Boolean).join(' · '))}</span></button>`;
    const future=all.filter((e)=>toDate(e.data)>=today); const history=all.filter((e)=>toDate(e.data)<today);
    $('#calendar-list').innerHTML=future.map(card).join('')||'<p class="empty-state">Non hai ensaios previstos.</p>'; $('#calendar-summary').textContent=`${future.length} próximos`;
    $('#history-list').innerHTML=history.map(card).join('')||'<p class="empty-state">Aínda non hai histórico.</p>'; $('#history-summary').textContent=`${history.length} ensaios`;
  }

  function renderTracking(result = payload?.seguimento) {
    const t=result||{}; const kpis=[['Ensaios realizados',t.ensaiosRealizados??0],['Asistencia media',`${t.asistenciaMedia??0} %`],['Ausencias xustificadas',t.ausenciasXustificadas??0],['Obras traballadas',t.obrasTraballadas??0]];
    $('#tracking-kpis').innerHTML=kpis.map(([l,v])=>`<article><span>${esc(l)}</span><strong>${esc(v)}</strong></article>`).join('');
    $('#tracking-voices').innerHTML=(t.porVoz||[]).map((v)=>`<div class="metric-row"><span>${esc(v.voz)}</span><strong>${esc(v.porcentaxe)} %</strong></div>`).join('')||'<p class="helper">Sen datos no período.</p>';
    $('#tracking-works').innerHTML=(t.porObra||[]).slice(0,12).map((w)=>`<div class="metric-row"><span>${esc(w.nome)}</span><strong>${esc(w.ensaios)} ens.</strong></div>`).join('')||'<p class="helper">Sen datos no período.</p>';
  }

  async function load() {
    loading.hidden=false; errorState.hidden=true; app.hidden=true;
    try { payload=await api('listarEnsaiosPortal'); selectedRehearsal=null; renderHero(); renderLists(); renderTracking(); const concerts=[...new Set((payload.ensaios||[]).map((e)=>e.concertoNome).filter(Boolean))].sort(); $('#concert-filter').innerHTML='<option value="">Todos</option>'+concerts.map((c)=>`<option>${esc(c)}</option>`).join(''); dataSource.textContent=payload.diagnostico?.fonte?`Fonte: ${payload.diagnostico.fonte}${payload.diagnostico.xeradoEn?` · actualizado ${payload.diagnostico.xeradoEn}`:''}`:''; loading.hidden=true; app.hidden=false; }
    catch(error){ loading.hidden=true; errorState.hidden=false; errorMessage.textContent=error instanceof Error?error.message:'Erro descoñecido'; }
  }

  document.addEventListener('click', async (event)=>{
    const target=event.target; if(!(target instanceof HTMLElement)) return;
    const viewButton=target.closest('[data-view]'); if(viewButton){ document.querySelectorAll('[data-view]').forEach((b)=>b.classList.toggle('is-active',b===viewButton)); document.querySelectorAll('.module-view').forEach((v)=>v.hidden=v.id!==`view-${viewButton.dataset.view}`); return; }
    const workButton=target.closest('[data-work]'); if(workButton){ document.querySelectorAll('[data-work]').forEach((b)=>b.classList.toggle('is-active',b===workButton)); $('#attendance-panel').hidden=workButton.dataset.work!=='asistencia'; $('#repertoire-panel').hidden=workButton.dataset.work!=='repertorio'; return; }
    const voiceButton=target.closest('[data-voice]'); if(voiceButton){ selectedVoice=voiceButton.dataset.voice||'Todas'; document.querySelectorAll('[data-voice]').forEach((b)=>b.classList.toggle('is-active',b===voiceButton)); renderAttendance(); return; }
    const rehearsalButton=target.closest('[data-rehearsal]'); if(rehearsalButton){ selectedRehearsal=rehearsalById(rehearsalButton.dataset.rehearsal); document.querySelectorAll('[data-view]').forEach((b)=>b.classList.toggle('is-active',b.dataset.view==='proximo')); document.querySelectorAll('.module-view').forEach((v)=>v.hidden=v.id!=='view-proximo'); renderHero(); window.scrollTo({top:0,behavior:'smooth'}); return; }
    const stateButton=target.closest('[data-state]'); if(stateButton){ const row=stateButton.closest('.person-row'); const status=row?.querySelector('.save-status'); if(!row) return; stateButton.setAttribute('disabled',''); if(status) status.textContent='Gardando…'; try{ await api('gardarAsistenciaEnsaio',{ idEnsaio:selectedRehearsal?.idEnsaio||selectedRehearsal?.id, idPersoa:row.dataset.person, estadoAsistencia:stateButton.dataset.state, xustificada:false }); if(status) status.textContent='✓ Gardado'; payload=await api('listarEnsaiosPortal',{ forzar:true }); renderAttendance(); }catch(e){ if(status) status.textContent='⚠ Non se puido gardar'; stateButton.removeAttribute('disabled'); } return; }
    const saveWork=target.closest('.save-work'); if(saveWork){ const row=saveWork.closest('.work-row'); const status=row?.querySelector('.save-status'); if(!row) return; if(status) status.textContent='Gardando…'; try{ await api('gardarEnsaioRepertorio',{ idEnsaio:selectedRehearsal?.idEnsaio||selectedRehearsal?.id, idRepertorio:row.dataset.workId, tipoTraballo:row.querySelector('.work-type')?.value||'', desde:row.querySelector('.work-from')?.value||'', ata:row.querySelector('.work-to')?.value||'', observacions:row.querySelector('.work-notes')?.value||'' }); if(status) status.textContent='✓ Gardado'; payload=await api('listarEnsaiosPortal',{ forzar:true }); renderRepertoire(); }catch(e){ if(status) status.textContent='⚠ Non se puido gardar'; } }
  });

  document.addEventListener('change',(event)=>{ const input=event.target; if(input instanceof HTMLInputElement && input.classList.contains('worked-check')){ const fields=input.closest('.work-row')?.querySelector('.work-fields'); if(fields instanceof HTMLElement) fields.hidden=!input.checked; } });
  $('#tracking-form')?.addEventListener('submit',async(event)=>{event.preventDefault(); try{ const result=await api('obterSeguimentoEnsaios',{ desde:$('#date-from')?.value||'', ata:$('#date-to')?.value||'', concerto:$('#concert-filter')?.value||'', voz:$('#voice-filter')?.value||'' }); renderTracking(result.seguimento); }catch(e){ alert(e instanceof Error?e.message:'Non foi posible calcular o seguimento.'); }});
  $('#retry-button')?.addEventListener('click',load);
  $('#ensaios-logout')?.addEventListener('click',async()=>{await signOut(auth); location.href='/portal/acceso/';});
  onAuthStateChanged(auth,(user)=>{ if(!user?.email){location.href='/portal/acceso/';return;} userEmail.textContent=user.email; load(); });
</script>

<style>
  :global(.private-layout){display:flex;min-height:100vh;background:#f7f5f2;color:#26221f}.ensaios-main{flex:1;min-width:0;padding:2.3rem 3rem 4rem}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.section-kicker,.section-heading span,.attendance-heading span{color:var(--color-principal);font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.private-page-header h1{margin:.2rem 0 .45rem;font-family:Georgia,'Times New Roman',serif;font-size:2.25rem}.private-page-header p{max-width:720px;margin:0;color:#6b645f}.account-card{min-width:220px;padding:.8rem 1rem;border:1px solid #ded8d2;background:#fff}.account-card small{display:block;color:#847b74;font-size:.7rem}.account-card strong{display:block;margin-top:.18rem;font-size:.82rem}.portal-state{padding:2rem;border:1px solid #e2ddd8;background:#fff}.error-state{border-left:3px solid var(--color-principal)}.error-state button,.tracking-filters button{margin-top:.5rem;border:0;background:var(--color-principal);color:#fff;padding:.7rem 1rem;cursor:pointer}.view-switch,.work-tabs,.voice-tabs{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:1.2rem}.view-switch button,.work-tabs button,.voice-tabs button{border:1px solid #d9d2cc;background:#fff;color:#504944;padding:.62rem .9rem;border-radius:3px;cursor:pointer}.view-switch button.is-active,.work-tabs button.is-active,.voice-tabs button.is-active{background:var(--color-principal);border-color:var(--color-principal);color:#fff}.hero-card{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.75fr);gap:2rem;padding:2rem;border-top:4px solid var(--color-principal);background:#fff;box-shadow:0 10px 30px rgba(65,43,37,.06)}.hero-date span,.hero-meta span{color:var(--color-principal);font-size:.72rem;font-weight:800;text-transform:uppercase}.hero-date h2{margin:.35rem 0;font-family:Georgia,'Times New Roman',serif;font-size:1.8rem}.hero-date p,.hero-meta p{color:#6d655f}.hero-meta{padding-left:1.5rem;border-left:1px solid #e4ded8}.hero-meta strong{display:block;margin:.35rem 0;font-size:1rem}.work-panel{margin-top:1.2rem;padding:1.3rem;background:#fff;border:1px solid #e2ddd8}.attendance-heading,.section-heading{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin:1rem 0}.attendance-heading h2,.section-heading h2{margin:.18rem 0;font-family:Georgia,'Times New Roman',serif}.attendance-list,.repertoire-list,.rehearsal-list{display:grid;gap:.45rem}.person-row{display:grid;grid-template-columns:minmax(220px,1fr) auto auto minmax(90px,auto);gap:.8rem;align-items:center;padding:.7rem .8rem;border-bottom:1px solid #eee9e5}.person-row>div:first-child{display:flex;flex-direction:column}.person-row span{font-size:.76rem;color:#817872}.attendance-actions{display:flex;gap:.35rem}.attendance-actions button{border:1px solid #d6d0ca;background:#fff;padding:.5rem .65rem;cursor:pointer}.attendance-actions button.is-selected{background:#eef3ed;border-color:#78906f}.attendance-actions button.negative{background:#f6eded;border-color:#b98282}.justify{font-size:.78rem}.save-status{font-size:.72rem;color:#6f665f}.helper,.data-source{color:#817872;font-size:.78rem}.work-row{padding:.9rem;border:1px solid #e7e1dc}.work-main{display:flex;justify-content:space-between;gap:1rem}.work-main label{display:flex;gap:.7rem}.work-main label span{display:flex;flex-direction:column}.work-main small{color:#817872}.audio-links{display:flex;flex-wrap:wrap;gap:.35rem}.audio-links a{color:#27221f;text-decoration:none;font-size:.74rem}.work-fields{display:grid;grid-template-columns:1fr 1fr 1fr 2fr auto auto;gap:.5rem;margin-top:.8rem}.work-fields input,.work-fields select,.tracking-filters input,.tracking-filters select{min-width:0;border:1px solid #d9d2cc;background:#fff;padding:.58rem}.save-work{border:0;background:var(--color-principal);color:#fff;padding:.55rem .8rem}.rehearsal-card{display:grid;grid-template-columns:1.2fr 1fr 2fr;gap:1rem;text-align:left