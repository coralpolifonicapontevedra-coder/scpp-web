  .view-switch button.is-active,.work-tabs button.is-active,.voice-tabs button.is-active{background:var(--color-principal);border-color:var(--color-principal);color:#fff}
  .hero-card{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.75fr);gap:2rem;padding:2rem;border-top:4px solid var(--color-principal);background:#fff;box-shadow:0 10px 30px rgba(65,43,37,.06);min-width:0}
  .hero-date span{color:var(--color-principal);font-size:.72rem;font-weight:800;text-transform:uppercase}.hero-date h2{margin:.35rem 0;font-family:Georgia,'Times New Roman',serif;font-size:1.8rem}
  .hero-date p,.hero-meta p{color:#6d655f}.hero-meta{padding-left:1.5rem;border-left:1px solid #e4ded8;min-width:0}.hero-classification{margin:.2rem 0;font-weight:700;color:#302b27!important}
  .work-panel{margin-top:1.2rem;padding:1.3rem;background:#fff;border:1px solid #e2ddd8;min-width:0}.attendance-heading,.section-heading{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin:1rem 0}
  .attendance-heading h2,.section-heading h2{margin:.18rem 0;font-family:Georgia,'Times New Roman',serif}.attendance-list,.repertoire-list,.rehearsal-list{display:grid;gap:.55rem;min-width:0}
  .attendance-group{border:1px solid #e5dfda;background:#faf9f7;min-width:0}.attendance-group header{display:flex;justify-content:space-between;align-items:center;padding:.7rem .85rem;border-bottom:1px solid #e5dfda}
  .attendance-group h3{margin:0;font-size:.95rem}.attendance-group header strong{color:var(--color-principal)}.group-empty{padding:0 .85rem .75rem}
  .attendee-names{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.45rem .8rem;padding:.8rem}.attendee-names span{padding:.35rem .45rem;background:#fff;border:1px solid #eee8e3;min-width:0;overflow-wrap:anywhere}
