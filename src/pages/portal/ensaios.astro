  .attendance-actions{display:flex;gap:.35rem}.attendance-actions button{border:1px solid #d6d0ca;background:#fff;padding:.5rem .65rem;cursor:pointer}.attendance-actions button.is-selected{background:#eef3ed;border-color:#78906f}.attendance-actions button.negative{background:#f6eded;border-color:#b98282}
  .justify{font-size:.78rem}.save-status{font-size:.72rem;color:#6f665f}.helper,.data-source{color:#817872;font-size:.78rem}
  .repertoire-tools{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;margin-bottom:.7rem}.work-search{display:grid;grid-template-columns:minmax(180px,1fr) minmax(220px,1.4fr) auto;gap:.45rem;flex:1;min-width:0}
