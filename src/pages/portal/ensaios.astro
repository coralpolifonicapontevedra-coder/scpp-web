---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---
<BaseLayout title="Ensaios" lang="gl">
<div class="private-layout"><PortalSidebar active="ensaios" logoutId="ensaios-logout" /><main class="private-main">
<header class="page-header"><div><span class="kicker">Portal do Coralista</span><h1>Ensaios</h1><p>Preparación do próximo ensaio. O traballo permanece en R2 ata finalizar o ensaio.</p></div><div class="storage"><small>Almacenamento de traballo</small><strong>R2 privado</strong></div></header>
<section id="loading" class="card">Cargando os ensaios…</section><section id="error" class="card error" hidden></section>
<section id="app" class="app" hidden>
<section class="selector card"><label>Ensaio</label><select id="ensaio-select"></select><nav class="module-nav only-board"><button id="nav-works" class="secondary active">Obras a ensaiar</button><button id="nav-att" class="secondary">Lista de asistentes</button><button id="nav-analysis" class="secondary">Análise de asistencias</button></nav></section>
<article id="summary" class="summary card"></article>
<section id="works" class="panel card"><header class="heading"><div><span class="kicker">Preparación musical</span><h2>Obras a ensaiar</h2></div><strong id="works-count"></strong></header><div class="works-toolbar only-board"><button id="load-program" class="secondary">Cargar desde programa</button><div class="search"><input id="work-search" type="search" placeholder="Buscar obra ou compositor…"><button id="work-search-btn" class="secondary" aria-label="Buscar">⌕</button></div><select id="work-select"><option value="">Escolle unha obra…</option></select><button id="add-work" class="primary">Engadir obra</button></div><p id="work-result" class="status only-board"></p><p id="works-status" class="status"></p><div id="works-list" class="works-grid"></div></section>
<section id="attendance" class="panel card only-board" hidden><header class="heading"><div><span class="kicker">Control de asistencia</span><h2>Lista de asistentes</h2><p>En «Todos» móstranse só os asistentes. Por corda realízase o control.</p></div><button class="secondary back">Volver ás obras</button></header><div class="attendance-toolbar"><div class="voice-tabs"><button class="active" data-voice="Todos">Todos</button><button data-voice="Soprano">Sopranos</button><button data-voice="Contralto">Contraltos</button><button data-voice="Tenor">Tenores</button><button data-voice="Baixo">Baixos</button></div><input id="people-search" type="search" placeholder="Buscar coralista…"></div><div id="attendance-list"></div></section>
<section id="analysis" class="panel card only-board" hidden><header class="heading"><div><span class="kicker">Seguimento</span><h2>Análise de asistencias</h2><p>Consulta por período, persoa, corda ou conxunto da coral.</p></div><button class="secondary back">Volver ás obras</button></header><div class="analysis-filters"><label><span>Desde</span><input id="from" type="date"></label><label><span>Ata</span><input id="to" type="date"></label><label><span>Consulta</span><select id="scope"><option value="general">Xeral</option><option value="voice">Por corda</option><option value="person">Por persoa</option></select></label><label id="voice-wrap" hidden><span>Corda</span><select id="analysis-voice"><option value="Soprano">Sopranos</option><option value="Contralto">Contraltos</option><option value="Tenor">Tenores</option><option value="Baixo">Baixos</option></select></label><label id="person-wrap" hidden><span>Coralista</span><select id="analysis-person"></select></label><button id="consult" class="primary">Consultar</button></div><section class="analysis-block"><h3>Relación por ensaios</h3><div id="by-rehearsal"></div></section><div class="ranking-action"><button id="toggle-ranking" class="secondary" type="button">Ver ranking de asistencias</button></div><section id="ranking-block" class="analysis-block" hidden><h3>Ranking de asistencias</h3><div id="ranking"></div></section></section>
<p id="final-status" class="status only-board"></p><div class="final-zone only-board"><button id="finalize" class="primary">Finalizar ensaio</button></div>
</section>
<dialog id="absence-dialog"><form id="absence-form"><header><h2>Aviso de non asistencia</h2><button id="close-absence" type="button">×</button></header><p>Este aviso corresponde unicamente á túa asistencia ao ensaio seleccionado.</p><div class="absence-options"><button id="absence-simple" type="button" class="secondary active">Non asistirei</button><button id="absence-justified" type="button" class="secondary">Non asistirei con xustificación</button></div><label id="reason-wrap" hidden><span>Motivo da xustificación</span><textarea id="absence-reason" rows="3" maxlength="240"></textarea></label><p id="absence-status" class="status"></p><footer><button id="cancel-absence" type="button" class="secondary">Cancelar</button><button class="primary" type="submit">Enviar aviso</button></footer></form></dialog>
<dialog id="program-dialog"><form id="program-form"><header><h2>Cargar desde programa</h2><button id="close-program" type="button">×</button></header><label><span>Concerto</span><select id="program-select"></select></label><p id="program-status" class="status"></p><footer><button id="cancel-program" type="button" class="secondary">Cancelar</button><button class="primary">Incluír programa</button></footer></form></dialog>
</main></div>
</BaseLayout>
<script>
import {getApp,getApps,initializeApp} from 'firebase/app';import {getAuth,onAuthStateChanged} from 'firebase/auth';
const cfg={apiKey:'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',authDomain:'scpp-portal-privado.firebaseapp.com',projectId:'scpp-portal-privado',storageBucket:'scpp-portal-privado.firebasestorage.app',messagingSenderId:'506857659587',appId:'1:506857659587:web:a7ed36b22f044f5f639676'};const auth=getAuth(getApps().length?getApp():initializeApp(cfg));const $=s=>document.querySelector(s);const norm=(v='')=>String(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();const esc=(v='')=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');const truthy=v=>v===true||['true','1','si','sí','yes','x'].includes(norm(v));const rid=r=>String(r?.idEnsaio||r?.id||'').trim(),pid=p=>String(p?.idPersoa||p?.id||'').trim(),wid=w=>String(w?.idRepertorio||w?.id||'').trim();const name=p=>[p?.primeiroApelido,p?.segundoApelido,p?.nome].filter(Boolean).join(' ')||String(p?.nomeCompleto||'');const sortPeople=(a,b)=>name(a).localeCompare(name(b),'gl',{sensitivity:'base'});const VOICES=['Soprano','Contralto','Tenor','Baixo'];const vl=v=>({Soprano:'Sopranos',Contralto:'Contraltos',Tenor:'Tenores',Baixo:'Baixos'}[v]||v);const date=v=>{if(!v)return null;const s=String(v);const iso=/^\d{4}-\d{2}-\d{2}/.test(s)?s.slice(0,10):s.split(/[\/-]/).reverse().join('-');const d=new Date(iso+'T12:00:00');return isNaN(d)?null:d};const fmt=v=>{const d=date(v);return d?new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d):String(v||'')};const short=v=>{const d=date(v);return d?new Intl.DateTimeFormat('gl-ES',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d):String(v||'')};let payload,selected,draft,board=false,voice='Todos',absenceKind='non',rankingData='';
async function call(url,accion,extra={}){const u=auth.currentUser;if(!u)throw Error('A sesión non está dispoñible.');const idToken=await u.getIdToken();const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const x=await r.json().catch(()=>null);if(!r.ok||!x?.ok)throw Error(x?.erro||`Erro ${r.status}`);return x}const api=(a,e={})=>call('/api/ensaios',a,e),draftApi=(a,e={})=>call('/api/ensaios-borrador',a,{idEnsaio:rid(selected),...e});async function loadPayload(){try{return await call('/api/ensaios-coralista','listar')}catch(e){if(/non autorizado|forbidden|non tes permisos/i.test(String(e?.message||'')))return await api('listarEnsaiosPortal');throw e}}
function rehearsals(){const t=new Date();t.setHours(0,0,0,0);return [...new Map((payload?.ensaios||[]).map(r=>[rid(r),r])).values()].filter(r=>!truthy(r.cancelado)&&(!date(r.data)||date(r.data)>=t)).sort((a,b)=>(date(a.data)?.getTime()||0)-(date(b.data)?.getTime()||0))}function renderSelector(){const rs=rehearsals();if(!selected)selected=rs[0];$('#ensaio-select').innerHTML=rs.map(r=>`<option value="${esc(rid(r))}">${esc(fmt(r.data))}</option>`).join('');if(selected)$('#ensaio-select').value=rid(selected)}
function selectAbsence(k){absenceKind=k;const justified=k==='xustificada';$('#reason-wrap').hidden=!justified;$('#absence-simple').classList.toggle('active',!justified);$('#absence-justified').classList.toggle('active',justified)}
function renderSummary(){if(!selected){$('#summary').innerHTML='<p>Non hai próximos ensaios.</p>';return}$('#summary').innerHTML=`<div><span class="kicker">Ensaio seleccionado</span><h2>${esc(fmt(selected.data))}</h2></div><button id="absence" class="secondary">Aviso de non asistencia</button>`;$('#absence').onclick=()=>{selectAbsence('non');$('#absence-reason').value='';$('#absence-status').textContent='';$('#absence-dialog').showModal()}}
const amap=()=>new Map((draft?.asistencias||[]).map(a=>[String(a.persoa||a.idPersoa||''),a]));function kind(a={}){const s=norm(a.estadoAsistencia);if(s==='asiste')return'asiste';if(s==='non asiste'&&truthy(a.xustificada))return'xustificada';if(s==='non asiste')return'non';return''}
function row(p){const a=amap().get(pid(p))||{},k=kind(a);return `<article class="person-row" data-person="${esc(pid(p))}"><strong>${esc(name(p))}</strong><div class="att-buttons"><button type="button" data-kind="asiste" class="${k==='asiste'?'active':''}">Asiste</button><button type="button" data-kind="non" class="${k==='non'?'active':''}">Non asiste</button><button type="button" data-kind="xustificada" class="${k==='xustificada'?'active':''}">Non asiste con xustificación</button></div>${k==='xustificada'?`<label class="reason"><span>Motivo da xustificación</span><input data-reason value="${esc(a.motivo||'')}"></label>`:''}</article>`}
function renderAttendance(){if(!board||!draft)return;const q=norm($('#people-search').value),people=(payload?.persoas||[]).filter(p=>!q||norm(name(p)).includes(q)),m=amap();if(voice==='Todos'){$('#attendance-list').innerHTML=VOICES.map(v=>{const rs=people.filter(p=>norm(p.voz)===norm(v)&&kind(m.get(pid(p)))==='asiste').sort(sortPeople);return `<section class="voice-group"><header><h3>${vl(v)}</h3><strong>${rs.length}</strong></header><div class="attendee-names">${rs.map(p=>`<span>${esc(name(p))}</span>`).join('')||'<p>Sen asistentes rexistrados.</p>'}</div></section>`}).join('')}else{const rs=people.filter(p=>norm(p.voz)===norm(voice)).sort(sortPeople);$('#attendance-list').innerHTML=`<section class="voice-group"><header><h3>${vl(voice)}</h3></header><div class="voice-people">${rs.map(row).join('')}</div></section>`}}
async function saveAtt(id,k,motivo){const m=amap(),cur=m.get(id)||{},v=k==='asiste'?{estadoAsistencia:'Asiste',xustificada:false,motivo:''}:k==='xustificada'?{estadoAsistencia:'Non asiste',xustificada:true,motivo:String(motivo??cur.motivo??'')}:{estadoAsistencia:'Non asiste',xustificada:false,motivo:''};m.set(id,{...cur,persoa:id,...v});draft={...draft,asistencias:[...m.values()]};renderAttendance();try{draft=(await draftApi('gardarAsistencia',{idPersoa:id,...v,observacions:String(cur.observacions||'')})).draft;renderAttendance()}catch{}}
const work=id=>(payload?.repertorio||[]).find(w=>wid(w)===String(id))||{};const works=()=>draft?.repertorio||[];function picker(first=false){if(!board)return;const q=norm($('#work-search').value),used=new Set(works().map(r=>String(r.repertorio||r.idRepertorio||''))),rs=(payload?.repertorio||[]).filter(w=>!used.has(wid(w))&&(!q||norm([w.nomeObra,w.nome,w.compositor].join(' ')).includes(q))).sort((a,b)=>String(a.nomeObra||a.nome||'').localeCompare(String(b.nomeObra||b.nome||''),'gl'));$('#work-select').innerHTML='<option value="">Escolle unha obra…</option>'+rs.slice(0,100).map(w=>`<option value="${esc(wid(w))}">${esc([w.nomeObra||w.nome,w.compositor].filter(Boolean).join(' — '))}</option>`).join('');$('#work-result').textContent=q?`${rs.length} resultados para «${$('#work-search').value}»`:'';if(first&&rs.length)$('#work-select').value=wid(rs[0])}
function renderWorks(){if(!draft)return;const rs=[...works()].sort((a,b)=>Number(a.orde||999)-Number(b.orde||999));$('#works-count').textContent=`${rs.length} obras`;$('#works-list').innerHTML=rs.map((r,i)=>{const id=String(r.repertorio||r.idRepertorio||''),w=work(id);return `<article class="work-card" data-work="${esc(id)}"><header><span class="num">${i+1}</span><div><a href="/portal/repertorio/?id=${encodeURIComponent(id)}">${esc(w.nomeObra||w.nome||id)}</a>${w.compositor?`<small>${esc(w.compositor)}</small>`:''}</div>${board?'<button class="remove">×</button>':''}</header>${board?`<label><span>Observacións</span><textarea class="notes" rows="2">${esc(r.observacions||'')}</textarea></label><footer><button class="save secondary">Gardar</button></footer>`:(r.observacions?`<p>${esc(r.observacions)}</p>`:'')}</article>`}).join('')||'<p>Aínda non hai obras neste ensaio.</p>';picker()}
async function loadDraft(){if(!selected)return;try{const out=board?await draftApi('obter'):await call('/api/ensaios-obras','obter',{idEnsaio:rid(selected)});draft=out.draft;renderWorks();renderAttendance()}catch(e){$('#works-status').textContent='⚠ '+e.message}}
function hist(){const t=new Date();t.setHours(23,59,59,999);return(payload?.ensaios||[]).filter(e=>!truthy(e.cancelado)&&date(e.data)&&date(e.data)<=t).sort((a,b)=>date(a.data)-date(b.data))}const hmap=()=>new Map((payload?.asistencias||[]).map(a=>[`${a.ensaio}|${a.persoa}`,a]));function analysisPeople(){const s=$('#scope').value;if(s==='person')return(payload?.persoas||[]).filter(p=>pid(p)===$('#analysis-person').value);if(s==='voice')return(payload?.persoas||[]).filter(p=>norm(p.voz)===norm($('#analysis-voice').value));return payload?.persoas||[]}
function runAnalysis(){const from=date($('#from').value),to=date($('#to').value),scope=$('#scope').value,people=analysisPeople(),m=hmap(),es=hist().filter(e=>(!from||date(e.data)>=from)&&(!to||date(e.data)<=to));const rows=es.map(e=>{if(scope==='person'){const p=people[0],a=p?m.get(`${rid(e)}|${pid(p)}`):null,k=kind(a),label=k==='asiste'?'Asiste':k==='xustificada'?'Non asiste con xustificación':k==='non'?'Non asiste':'Sen rexistro';return `<tr><td>${esc(short(e.data))}</td><td>${esc(label)}</td><td>${esc(a?.motivo||'')}</td></tr>`}let a=0,n=0,j=0,d=0;people.forEach(p=>{const k=kind(m.get(`${rid(e)}|${pid(p)}`));if(k){d++;if(k==='asiste')a++;else if(k==='xustificada')j++;else n++}});return `<tr><td>${esc(short(e.data))}</td><td>${a}</td><td>${n}</td><td>${j}</td><td>${d?Math.round(a*100/d):0}%</td></tr>`}).join('');$('#by-rehearsal').innerHTML=scope==='person'?`<div class="table-wrap"><table><thead><tr><th>Data</th><th>Estado</th><th>Motivo</th></tr></thead><tbody>${rows}</tbody></table></div>`:`<div class="table-wrap"><table><thead><tr><th>Data</th><th>Asisten</th><th>Non asisten</th><th>Xustificadas</th><th>%</th></tr></thead><tbody>${rows}</tbody></table></div>`;const rank=people.map(p=>{let a=0,n=0,j=0,d=0;es.forEach(e=>{const k=kind(m.get(`${rid(e)}|${pid(p)}`));if(k){d++;if(k==='asiste')a++;else if(k==='xustificada')j++;else n++}});return{p,a,n,j,pct:d?Math.round(a*100/d):0}}).sort((x,y)=>y.pct-x.pct||y.a-x.a||sortPeople(x.p,y.p));rankingData=`<div class="table-wrap"><table><thead><tr><th>#</th><th>Coralista</th><th>Corda</th><th>Asiste</th><th>Ausencias</th><th>%</th></tr></thead><tbody>${rank.map((r,i)=>`<tr><td>${i+1}</td><td>${esc(name(r.p))}</td><td>${esc(vl(r.p.voz||''))}</td><td>${r.a}</td><td>${r.n+r.j}</td><td>${r.pct}%</td></tr>`).join('')}</tbody></table></div>`;$('#ranking').innerHTML=rankingData;$('#ranking-block').hidden=true;$('#toggle-ranking').textContent='Ver ranking de asistencias'}
function show(n){$('#works').hidden=n!=='works';$('#attendance').hidden=n!=='attendance';$('#analysis').hidden=n!=='analysis';$('#summary').hidden=n!=='works';$('#finalize').closest('.final-zone').hidden=!board||n!=='attendance';[['nav-works','works'],['nav-att','attendance'],['nav-analysis','analysis']].forEach(([id,x])=>$('#'+id)?.classList.toggle('active',n===x));scrollTo({top:0,behavior:'smooth'})}function role(){board=payload?.perfil?.podeEditar===true;document.querySelectorAll('.only-board').forEach(el=>el.hidden=!board);show('works')}
async function load(){try{payload=await loadPayload();selected=rehearsals()[0];renderSelector();renderSummary();$('#analysis-person').innerHTML=[...(payload?.persoas||[])].sort(sortPeople).map(p=>`<option value="${esc(pid(p))}">${esc(name(p))} · ${esc(vl(p.voz||''))}</option>`).join('');$('#program-select').innerHTML='<option value="">Escolle un concerto…</option>'+[...(payload?.concertos||[])].map(c=>`<option value="${esc(c.id||'')}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join('');role();$('#loading').hidden=true;$('#app').hidden=false;await loadDraft()}catch(e){$('#loading').hidden=true;$('#error').hidden=false;$('#error').textContent=e.message}}
$('#ensaio-select').onchange=e=>{selected=rehearsals().find(r=>rid(r)===e.target.value);renderSummary();loadDraft()};$('#work-search').oninput=()=>picker();$('#work-search').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();picker(true)}};$('#work-search-btn').onclick=()=>picker(true);$('#people-search').oninput=renderAttendance;$('#nav-works').onclick=()=>show('works');$('#nav-att').onclick=()=>{voice='Todos';renderAttendance();show('attendance')};$('#nav-analysis').onclick=()=>{show('analysis')};document.querySelectorAll('.back').forEach(b=>b.onclick=()=>show('works'));$('#scope').onchange=e=>{$('#voice-wrap').hidden=e.target.value!=='voice';$('#person-wrap').hidden=e.target.value!=='person'};$('#consult').onclick=runAnalysis;$('#toggle-ranking').onclick=()=>{const b=$('#ranking-block');b.hidden=!b.hidden;$('#toggle-ranking').textContent=b.hidden?'Ver ranking de asistencias':'Ocultar ranking de asistencias'};
document.addEventListener('click',async e=>{const t=e.target;if(!(t instanceof HTMLElement))return;const vb=t.closest('[data-voice]');if(vb){voice=vb.dataset.voice;document.querySelectorAll('[data-voice]').forEach(b=>b.classList.toggle('active',b===vb));renderAttendance();return}const ab=t.closest('[data-kind]');if(ab){const r=ab.closest('.person-row');if(r&&board&&voice!=='Todos')await saveAtt(r.dataset.person,ab.dataset.kind);return}const rm=t.closest('.remove');if(rm){const r=rm.closest('.work-card'),id=r?.dataset.work;if(id&&board){draft=(await draftApi('eliminarObra',{idRepertorio:id})).draft;renderWorks()}return}const sv=t.closest('.save');if(sv){const r=sv.closest('.work-card'),id=r?.dataset.work,old=works().find(x=>String(x.repertorio||x.idRepertorio||'')===id)||{};if(id&&board){draft=(await draftApi('gardarObra',{idRepertorio:id,orde:old.orde||1,tipoTraballo:'',desde:'',ata:'',observacions:r.querySelector('.notes')?.value||''})).draft;renderWorks()}}});document.addEventListener('change',e=>{const i=e.target;if(i instanceof HTMLInputElement&&i.matches('[data-reason]')){const r=i.closest('.person-row');if(r)saveAtt(r.dataset.person,'xustificada',i.value)}});
$('#add-work').onclick=async()=>{const id=$('#work-select').value;if(!id)return;draft=(await draftApi('gardarObra',{idRepertorio:id,orde:works().length+1,tipoTraballo:'',desde:'',ata:'',observacions:''})).draft;$('#work-search').value='';renderWorks()};const pd=$('#program-dialog');$('#load-program').onclick=()=>pd.showModal();$('#close-program').onclick=$('#cancel-program').onclick=()=>pd.close();$('#program-form').onsubmit=async e=>{e.preventDefault();const c=(payload?.concertos||[]).find(x=>String(x.id||'')===$('#program-select').value);if(!c)return;const used=new Set(works().map(r=>String(r.repertorio||r.idRepertorio||''))),ids=[...new Set((c.programa||[]).map(x=>x.idRepertorio).filter(id=>id&&!used.has(String(id))))];if(ids.length){draft=(await draftApi('incluírPrograma',{idsRepertorio:ids})).draft;renderWorks();pd.close()}};$('#finalize').onclick=async()=>{if(!confirm('Finalizar o ensaio e gravar definitivamente asistencia e obras nas Sheets?'))return;draft=(await draftApi('finalizar')).draft;$('#final-status').textContent='✓ Ensaio finalizado.'};$('#absence-simple').onclick=()=>selectAbsence('non');$('#absence-justified').onclick=()=>selectAbsence('xustificada');$('#close-absence').onclick=$('#cancel-absence').onclick=()=>$('#absence-dialog').close();$('#absence-form').onsubmit=async e=>{e.preventDefault();const st=$('#absence-status'),motivo=$('#absence-reason').value.trim();if(absenceKind==='xustificada'&&!motivo){st.textContent='Indica o motivo da xustificación.';return}try{st.textContent='Gardando aviso…';await call('/api/ensaios-aviso','gardar',{idEnsaio:rid(selected),xustificada:absenceKind==='xustificada',motivo});st.textContent='✓ Aviso de non asistencia gardado.';if(board)await loadDraft();setTimeout(()=>$('#absence-dialog').close(),700)}catch(err){st.textContent='⚠ '+err.message}};onAuthStateChanged(auth,u=>u?load():location.assign('/portal/'));
