---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-logout" />
    <main class="admin-rehearsals-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Administración</span>
          <h1>Administración de ensaios</h1>
          <p>Planificación, obras a traballar e control de asistencia desde unha única pantalla.</p>
        </div>
        <div class="account-card">
          <span><small>Conta identificada</small><strong id="user-email">—</strong></span>
          <span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span>
        </div>
      </header>

      <AdministracionNav active="ensaios" />

      <section id="loading" class="state-box">Comprobando permisos e cargando ensaios…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir a administración de ensaios</strong>
        <p id="error-message"></p>
        <button id="retry" type="button" class="secondary">Tentar de novo</button>
      </section>

      <section id="app" hidden>
        <div class="toolbar">
          <label><span>Mostrar</span><select id="filter"><option value="activos">Ensaios activos</option><option value="todos">Todos os ensaios</option><option value="baixa">Dados de baixa</option></select></label>
          <p id="count"></p>
          <button id="new-rehearsal" type="button" class="primary">+ Novo ensaio</button>
        </div>
        <div id="list" class="rehearsal-list"></div>
      </section>
    </main>
  </div>

  <dialog id="new-dialog" class="wide-dialog">
    <form id="new-form">
      <header><div><small>Planificación</small><h2>Novo ensaio</h2></div><button type="button" data-close="new-dialog">×</button></header>
      <div class="form-grid">
        <label><span>Data</span><input name="data" type="date" required /></label>
        <label><span>Hora de inicio</span><input name="horaInicio" type="time" required /></label>
        <label><span>Hora de fin</span><input name="horaFin" type="time" /></label>
        <label><span>Lugar</span><input name="lugar" /></label>
        <label><span>Tipo de ensaio</span><input name="tipoEnsaio" list="tipos-ensaio" required /></label>
        <label><span>Concerto relacionado</span><select name="concerto" id="new-concert"><option value="">Sen concerto asociado</option></select></label>
        <label class="span-2"><span>Descrición</span><textarea name="descricion" rows="3"></textarea></label>
        <label class="span-2"><span>Observacións</span><textarea name="observacions" rows="3"></textarea></label>
      </div>
      <datalist id="tipos-ensaio"><option value="Ordinario"></option><option value="Extraordinario"></option><option value="Xeral"></option><option value="Por cordas"></option></datalist>
      <p id="new-status" class="dialog-status"></p>
      <footer><button type="button" class="secondary" data-close="new-dialog">Cancelar</button><button type="submit" class="primary">Gardar ensaio</button></footer>
    </form>
  </dialog>

  <dialog id="manage-dialog" class="manage-dialog">
    <section class="manage-shell">
      <header><div><small>Xestión do ensaio</small><h2 id="manage-title">Ensaio</h2><p id="manage-meta"></p></div><button type="button" data-close="manage-dialog">×</button></header>
      <nav class="manage-tabs"><button type="button" class="is-active" data-panel="repertorio">Obras</button><button type="button" data-panel="asistencia">Asistencia</button><button type="button" data-panel="avisos">Avisos<span id="avisos-badge"></span></button></nav>

      <section id="panel-repertorio" class="manage-panel">
        <div class="program-tools">
          <label><span>Cargar programa dun concerto</span><select id="program-concert"><option value="">Escolle un concerto…</option></select></label>
          <button id="include-program" type="button" class="secondary draft-action">Cargar programa</button>
        </div>
        <div class="work-tools">
          <input id="work-search" type="search" placeholder="Buscar obra ou compositor…" />
          <select id="work-select"><option value="">Escolle unha obra…</option></select>
          <button id="add-work" type="button" class="primary draft-action">Engadir obra</button>
        </div>
        <div class="section-heading"><h3>Obras a traballar</h3><strong id="works-count">0</strong></div>
        <p id="works-status" class="dialog-status"></p>
        <div id="works-list" class="works-list"></div>
      </section>

      <section id="panel-asistencia" class="manage-panel" hidden>
        <div class="voice-tabs"><button type="button" class="is-active" data-voice="Todos">Todos</button><button type="button" data-voice="Soprano">Sopranos</button><button type="button" data-voice="Contralto">Contraltos</button><button type="button" data-voice="Tenor">Tenores</button><button type="button" data-voice="Baixo">Baixos</button></div>
        <div class="section-heading"><h3>Control de asistencia</h3><strong id="attendance-count">0</strong></div>
        <p id="attendance-status" class="dialog-status"></p>
        <div id="attendance-list" class="attendance-list"></div>
      </section>

      <section id="panel-avisos" class="manage-panel" hidden>
        <div class="section-heading"><h3>Avisos de non asistencia</h3><strong id="avisos-count">0</strong></div>
        <p id="avisos-status" class="dialog-status"></p>
        <div id="avisos-list" class="avisos-list"></div>
      </section>

      <div class="ensaios-final-bar">
        <span id="ensaios-final-status">Cargando estado confirmado…</span>
        <div class="ensaios-final-actions">
          <button type="button" id="descartar-ensaio" class="secondary">Recargar desde Sheet</button>
          <button type="button" id="finalizar-ensaio" class="primary" disabled>Finalizar ensaio</button>
        </div>
      </div>
    </section>
  </dialog>

  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" data-close="date-dialog">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required /></label><p id="date-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="date-dialog">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>

  <dialog id="cancel-dialog"><form id="cancel-form"><header><h2>Dar de baixa o ensaio</h2><button type="button" data-close="cancel-dialog">×</button></header><p id="cancel-name"></p><p class="warning">O ensaio quedará marcado como cancelado. Non se eliminarán o seu identificador nin as relacións existentes.</p><p id="cancel-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="cancel-dialog">Volver</button><button type="submit" class="danger">Dar de baixa</button></footer></form></dialog>

  <dialog id="delete-dialog"><form id="delete-form"><header><h2>Eliminar ensaio</h2><button type="button" data-close="delete-dialog">×</button></header><p id="delete-name"></p><p class="warning"><strong>Esta acción non se pode desfacer.</strong> Eliminarase o ensaio e a información asociada segundo as regras do sistema.</p><label><span>Escribe ELIMINAR para confirmar</span><input id="delete-confirm" autocomplete="off" /></label><p id="delete-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="delete-dialog">Cancelar</button><button id="delete-submit" type="submit" class="danger-solid" disabled>Eliminar definitivamente</button></footer></form></dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';

  const $ = (selector) => document.querySelector(selector);
  const clean = (value = '') => String(value ?? '').trim();
  const norm = (value = '') => clean(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const esc = (value = '') => String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
  const idEnsaio = (row = {}) => clean(row.idEnsaio || row.id || row.Id_Ensaio);
  const refEnsaio = (row = {}) => clean(row.ensaio || row.idEnsaio || row.Id_Ensaio);
  const idPersoa = (row = {}) => clean(row.persoa || row.idPersoa || row.id || row.RowID);
  const idObra = (row = {}) => clean(row.repertorio || row.idRepertorio || row.id);
  const nomePersoa = (p = {}) => clean(p.nomeCompleto) || [p.nome, p.primeiroApelido, p.segundoApelido].map(clean).filter(Boolean).join(' ');
  const nomeOrden = (p = {}) => [p.primeiroApelido, p.segundoApelido, p.nome].map(clean).filter(Boolean).join(' ') || nomePersoa(p);
  const getVoiceRank = (value) => { const v = norm(value); return v === 'soprano' ? 1 : v === 'contralto' ? 2 : v === 'tenor' ? 3 : v === 'baixo' ? 4 : 5; };
  const fmt = (value) => { if (!value) return 'Sen data'; const d = new Date(`${String(value).slice(0, 10)}T12:00:00`); return Number.isNaN(d.getTime()) ? String(value) : new Intl.DateTimeFormat('gl-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d); };
  const truthy = (value) => value === true || ['true', '1', 'si', 'sí', 'yes', 'x'].includes(clean(value).toLowerCase());

  let payload = null;
  let ensaios = [];
  let selected = null;
  let selectedVoice = 'Todos';
  let draft = null;
  let avisos = [];
  let conflito = false;
  let busy = false;

  const loading = $('#loading');
  const errorState = $('#error-state');
  const errorMessage = $('#error-message');
  const app = $('#app');
  const list = $('#list');
  const filter = $('#filter');
  const count = $('#count');

  async function call(endpoint, accion, extra = {}) {
    const user = auth.currentUser;
    if (!user?.email) throw new Error('A sesión non está activa.');
    const idToken = await user.getIdToken();
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion, ...extra })
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) {
      const error = new Error(result?.erro || `Erro HTTP ${response.status}`);
      error.code = result?.codigo || '';
      throw error;
    }
    return result;
  }
  const adminApi = (accion, extra = {}) => call('/api/ensaios-admin-v2', accion, extra);
  const xestionApi = (accion, extra = {}) => call('/api/ensaios-admin-xestion', accion, { idEnsaio: idEnsaio(selected), ...extra });

  function prepararLista(index) {
    const countA = new Map();
    const countW = new Map();
    for (const row of index?.asistencias || []) { const id = refEnsaio(row); if (id) countA.set(id, (countA.get(id) || 0) + 1); }
    for (const row of index?.ensaiosRepertorio || []) { const id = refEnsaio(row); if (id) countW.set(id, (countW.get(id) || 0) + 1); }
    return (index?.ensaios || []).map((row) => {
      const id = idEnsaio(row);
      return {
        idEnsaio: id,
        data: clean(row.data || row.Data).slice(0, 10),
        horaInicio: clean(row.horaInicio || row.HoraInicio),
        horaFin: clean(row.horaFin || row.HoraFin),
        lugar: clean(row.lugar || row.Lugar),
        tipoEnsaio: clean(row.tipoEnsaio || row.TipoEnsaio) || 'Ensaio',
        concerto: clean(row.concerto || row.Concerto),
        descricion: clean(row.descricion || row.Descricion),
        observacions: clean(row.observacions || row.Observacions),
        cancelado: truthy(row.cancelado ?? row.Cancelado),
        obras: countW.get(id) || 0,
        asistencias: countA.get(id) || 0
      };
    }).filter((row) => row.idEnsaio).sort((a, b) => String(b.data).localeCompare(String(a.data)));
  }

  function visible() {
    const mode = filter instanceof HTMLSelectElement ? filter.value : 'activos';
    return ensaios.filter((row) => mode === 'todos' || (mode === 'baixa' ? row.cancelado : !row.cancelado));
  }
  function draw() {
    if (!(list instanceof HTMLElement)) return;
    const rows = visible();
    if (count instanceof HTMLElement) count.textContent = `${rows.length} ensaio${rows.length === 1 ? '' : 's'}`;
    list.innerHTML = rows.length ? rows.map((row) => `<article class="rehearsal-card ${row.cancelado ? 'is-cancelled' : ''}"><div class="rehearsal-date"><small>Data</small><strong>${esc(fmt(row.data))}</strong></div><div class="rehearsal-info"><h2>${esc(row.tipoEnsaio || 'Ensaio')}</h2><p>${esc([row.horaInicio, row.lugar].filter(Boolean).join(' · ') || 'Sen máis datos')}</p><div class="meta"><span>${Number(row.obras || 0)} obras</span><span>${Number(row.asistencias || 0)} asistencias</span></div></div><div class="rehearsal-state"><strong>${row.cancelado ? 'Baixa' : 'Activo'}</strong></div><div class="actions">${row.cancelado ? '' : `<button class="primary manage" data-id="${esc(row.idEnsaio)}">Xestionar</button><button class="secondary change-date" data-id="${esc(row.idEnsaio)}">Cambiar data</button><button class="danger cancel-rehearsal" data-id="${esc(row.idEnsaio)}">Dar de baixa</button>`}<button class="danger delete-rehearsal" data-id="${esc(row.idEnsaio)}">Eliminar</button></div></article>`).join('') : '<section class="state-box">Non hai ensaios para este filtro.</section>';
  }

  function fillConcerts() {
    const concerts = [...(payload?.concertos || [])].sort((a, b) => clean(a.data).localeCompare(clean(b.data)));
    const options = concerts.map((c) => `<option value="${esc(clean(c.id || c.idConcerto))}">${esc([c.data, c.nome || c.titulo].filter(Boolean).join(' · '))}</option>`).join('');
    const newConcert = $('#new-concert');
    const programConcert = $('#program-concert');
    if (newConcert instanceof HTMLSelectElement) newConcert.innerHTML = '<option value="">Sen concerto asociado</option>' + options;
    if (programConcert instanceof HTMLSelectElement) programConcert.innerHTML = '<option value="">Escolle un concerto…</option>' + options;
  }

  function workById(id) { return (payload?.repertorio || []).find((row) => clean(row.idRepertorio || row.id) === clean(id)) || null; }
  function isValidWork(work) { const title = clean(work?.nomeObra || work?.nome); return !!clean(work?.idRepertorio || work?.id) && !!title && !/^\d+$/.test(title); }
  function workRows() { return [...(draft?.repertorio || [])].sort((a, b) => Number(a.orde || 999) - Number(b.orde || 999)); }
  function attendanceRows() { return draft?.asistencias || []; }

  function updateWorkPicker() {
    const select = $('#work-select');
    const search = $('#work-search');
    if (!(select instanceof HTMLSelectElement)) return;
    const q = norm(search instanceof HTMLInputElement ? search.value : '');
    const used = new Set(workRows().map((row) => idObra(row)));
    const works = (payload?.repertorio || []).filter((work) => {
      const id = clean(work.idRepertorio || work.id);
      const title = clean(work.nomeObra || work.nome);
      if (!isValidWork(work) || used.has(id)) return false;
      return !q || norm(`${title} ${work.compositor || ''}`).includes(q);
    }).sort((a, b) => clean(a.nomeObra || a.nome).localeCompare(clean(b.nomeObra || b.nome), 'gl', { sensitivity: 'base' })).slice(0, 120);
    select.innerHTML = '<option value="">Escolle unha obra…</option>' + works.map((work) => `<option value="${esc(clean(work.idRepertorio || work.id))}">${esc([work.nomeObra || work.nome, work.compositor].filter(Boolean).join(' — '))}</option>`).join('');
  }

  function renderWorks() {
    const box = $('#works-list');
    const total = $('#works-count');
    if (!(box instanceof HTMLElement)) return;
    const rows = workRows().map((row) => ({ row, id: idObra(row), work: workById(idObra(row)) }));
    if (total instanceof HTMLElement) total.textContent = `${rows.length} obra${rows.length === 1 ? '' : 's'}`;
    box.innerHTML = rows.length ? rows.map(({ id, work }, index) => `<article class="work-row ${isValidWork(work) ? '' : 'invalid-work'}"><span class="work-order">${isValidWork(work) ? index + 1 : '!'}</span><div><strong>${esc(isValidWork(work) ? work.nomeObra || work.nome : 'Rexistro de obra incorrecto')}</strong><small>${esc(isValidWork(work) ? work.compositor || '' : `Referencia: ${id}`)}</small></div><button type="button" class="remove-work danger draft-action" data-work-id="${esc(id)}">Eliminar</button></article>`).join('') : '<p class="empty">Aínda non hai obras asignadas a este ensaio.</p>';
    updateWorkPicker();
  }

  function attendanceState(row) {
    if (!row) return '';
    if (norm(row.estadoAsistencia) === 'asiste') return 'asiste';
    if (norm(row.estadoAsistencia) === 'non asiste') return truthy(row.xustificada) ? 'xustificada' : 'non';
    return '';
  }
  function renderAttendance() {
    const box = $('#attendance-list');
    const total = $('#attendance-count');
    if (!(box instanceof HTMLElement)) return;
    const map = new Map(attendanceRows().map((row) => [idPersoa(row), row]));
    const people = (payload?.persoas || []).filter((p) => idPersoa(p) && clean(p.voz) && (selectedVoice === 'Todos' || norm(p.voz) === norm(selectedVoice))).sort((a, b) => {
      const diff = getVoiceRank(a.voz) - getVoiceRank(b.voz);
      return diff !== 0 ? diff : nomeOrden(a).localeCompare(nomeOrden(b), 'gl', { sensitivity: 'base' });
    });
    const present = people.filter((p) => attendanceState(map.get(idPersoa(p))) === 'asiste').length;
    if (total instanceof HTMLElement) total.textContent = `${present}/${people.length}`;
    box.innerHTML = people.map((p) => {
      const state = attendanceState(map.get(idPersoa(p)));
      return `<article class="person-row" data-person="${esc(idPersoa(p))}"><div><strong>${esc(nomePersoa(p))}</strong><small>${esc(p.voz || '')}</small></div><div class="attendance-actions"><button type="button" data-att="asiste" class="draft-action ${state === 'asiste' ? 'is-selected' : ''}">Asiste</button><button type="button" data-att="non" class="draft-action ${state === 'non' ? 'is-selected negative' : ''}">Non asiste</button><button type="button" data-att="xustificada" class="draft-action ${state === 'xustificada' ? 'is-selected justified' : ''}">Xustificada</button></div><span class="row-status"></span></article>`;
    }).join('') || '<p class="empty">Non hai persoas nesta selección.</p>';
    updateDraftControls();
  }

  function renderAvisos() {
    const box = $('#avisos-list');
    const total = $('#avisos-count');
    const badge = $('#avisos-badge');
    if (!(box instanceof HTMLElement)) return;
    if (total instanceof HTMLElement) total.textContent = String(avisos.length);
    if (badge instanceof HTMLElement) badge.textContent = avisos.length ? ` (${avisos.length})` : '';
    box.innerHTML = avisos.length ? avisos.map((aviso) => `<article class="aviso-row"><div><strong>${esc(aviso.nome || aviso.idPersoa)}</strong><small>${esc(aviso.voz || '')} · ${aviso.xustificada ? 'Non asiste con xustificación' : 'Non asiste'}${aviso.motivo ? ` · ${esc(aviso.motivo)}` : ''}</small></div><button type="button" class="accept-aviso primary draft-action" data-person="${esc(aviso.idPersoa)}" ${aviso.aceptadoEnBorrador ? 'disabled' : ''}>${aviso.aceptadoEnBorrador ? 'Aceptado no borrador' : 'Aceptar'}</button></article>`).join('') : '<p class="empty">Non hai avisos pendentes de coralistas para este ensaio.</p>';
    updateDraftControls();
  }

  function setFinalStatus(text, tone = '') {
    const node = $('#ensaios-final-status');
    if (!(node instanceof HTMLElement)) return;
    node.textContent = text;
    node.dataset.tone = tone;
  }
  function updateDraftControls() {
    const finalButton = $('#finalizar-ensaio');
    const reloadButton = $('#descartar-ensaio');
    if (finalButton instanceof HTMLButtonElement) finalButton.disabled = busy || conflito || draft?.dirty !== true;
    if (reloadButton instanceof HTMLButtonElement) reloadButton.disabled = busy;
    document.querySelectorAll('#manage-dialog .draft-action').forEach((node) => { if (node instanceof HTMLButtonElement) node.disabled = node.disabled || busy || conflito; });
    if (conflito) setFinalStatus('A Sheet cambiou desde que se abriu este borrador · recarga antes de continuar', 'error');
    else if (draft?.dirty === true) setFinalStatus('Cambios gardados en R2 · pendentes de finalizar');
    else setFinalStatus('Sen cambios pendentes');
  }
  function renderManage() { renderWorks(); renderAttendance(); renderAvisos(); updateDraftControls(); }

  async function refreshIndex(force = true) {
    const result = await call('/api/ensaios-admin-xestion', 'listar', { forzar: force });
    payload = result.index;
    ensaios = prepararLista(payload);
    fillConcerts();
    draw();
    return result;
  }

  async function load() {
    if (loading instanceof HTMLElement) loading.hidden = false;
    if (errorState instanceof HTMLElement) errorState.hidden = true;
    if (app instanceof HTMLElement) app.hidden = true;
    try {
      const user = await waitForPortalUser();
      if (!user?.email) throw new Error('Non hai unha sesión válida.');
      const email = $('#user-email');
      if (email instanceof HTMLElement) email.textContent = user.email;
      const result = await refreshIndex(true);
      const level = $('#user-level');
      if (level instanceof HTMLElement) level.textContent = result.nivel || 'ensaios';
      if (loading instanceof HTMLElement) loading.hidden = true;
      if (app instanceof HTMLElement) app.hidden = false;
    } catch (error) {
      if (loading instanceof HTMLElement) loading.hidden = true;
      if (errorState instanceof HTMLElement) errorState.hidden = false;
      if (errorMessage instanceof HTMLElement) errorMessage.textContent = error instanceof Error ? error.message : 'Produciuse un erro inesperado.';
    }
  }

  async function openManage(item) {
    selected = item;
    selectedVoice = 'Todos';
    draft = null;
    avisos = [];
    conflito = false;
    document.querySelectorAll('[data-voice]').forEach((node) => node.classList.toggle('is-active', node.dataset.voice === 'Todos'));
    const title = $('#manage-title');
    const meta = $('#manage-meta');
    if (title instanceof HTMLElement) title.textContent = item.tipoEnsaio || 'Ensaio';
    if (meta instanceof HTMLElement) meta.textContent = [fmt(item.data), item.horaInicio, item.lugar].filter(Boolean).join(' · ');
    const dialog = $('#manage-dialog');
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
    setFinalStatus('Comprobando estado confirmado en Sheet…');
    try {
      const result = await xestionApi('obterXestion', { refrescarBase: true });
      draft = result.draft;
      avisos = Array.isArray(result.avisos) ? result.avisos : [];
      conflito = result.conflito === true;
      renderManage();
    } catch (error) {
      setFinalStatus(error instanceof Error ? error.message : String(error), 'error');
    }
  }

  filter?.addEventListener('change', draw);
  $('#retry')?.addEventListener('click', load);
  $('#admin-ensaios-logout')?.addEventListener('click', async () => { await closePortalSession(); location.href = '/'; });
  document.querySelectorAll('[data-close]').forEach((button) => button.addEventListener('click', () => { const dialog = document.getElementById(button.dataset.close || ''); if (dialog instanceof HTMLDialogElement) dialog.close(); }));

  $('#new-rehearsal')?.addEventListener('click', () => {
    const form = $('#new-form');
    if (form instanceof HTMLFormElement) form.reset();
    const status = $('#new-status');
    if (status instanceof HTMLElement) status.textContent = '';
    fillConcerts();
    const dialog = $('#new-dialog');
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
  });
  $('#new-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const status = $('#new-status');
    if (!(form instanceof HTMLFormElement)) return;
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      if (status instanceof HTMLElement) status.textContent = 'Gardando…';
      const result = await adminApi('crear', data);
      payload = result.index;
      ensaios = prepararLista(payload);
      fillConcerts();
      draw();
      const dialog = $('#new-dialog');
      if (dialog instanceof HTMLDialogElement) dialog.close();
      const aviso = clean(result.resultado?.avisoPrograma);
      if (aviso) window.alert(aviso);
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });

  list?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    const item = ensaios.find((row) => row.idEnsaio === target.dataset.id);
    if (!item) return;
    if (target.classList.contains('manage')) { void openManage(item); return; }
    if (target.classList.contains('change-date')) {
      selected = item;
      const dialog = $('#date-dialog'), input = $('#new-date'), name = $('#date-name');
      if (name instanceof HTMLElement) name.textContent = `${item.tipoEnsaio || 'Ensaio'} · ${fmt(item.data)}`;
      if (input instanceof HTMLInputElement) input.value = clean(item.data).slice(0, 10);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }
    if (target.classList.contains('cancel-rehearsal')) {
      selected = item;
      const dialog = $('#cancel-dialog'), name = $('#cancel-name');
      if (name instanceof HTMLElement) name.textContent = `${item.tipoEnsaio || 'Ensaio'} · ${fmt(item.data)}`;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }
    if (target.classList.contains('delete-rehearsal')) {
      selected = item;
      const dialog = $('#delete-dialog'), name = $('#delete-name'), confirm = $('#delete-confirm'), submit = $('#delete-submit'), status = $('#delete-status');
      if (name instanceof HTMLElement) name.textContent = `${item.tipoEnsaio || 'Ensaio'} · ${fmt(item.data)}`;
      if (confirm instanceof HTMLInputElement) confirm.value = '';
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (status instanceof HTMLElement) status.textContent = '';
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    }
  });

  $('#date-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = $('#new-date'), status = $('#date-status');
    if (!selected || !(input instanceof HTMLInputElement) || !input.value) return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Gardando…';
      const result = await adminApi('cambiarData', { idEnsaio: selected.idEnsaio, data: input.value });
      payload = result.index; ensaios = prepararLista(payload); fillConcerts(); draw();
      const dialog = $('#date-dialog'); if (dialog instanceof HTMLDialogElement) dialog.close();
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });
  $('#cancel-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = $('#cancel-status');
    if (!selected) return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Gardando…';
      const result = await adminApi('darBaixa', { idEnsaio: selected.idEnsaio });
      payload = result.index; ensaios = prepararLista(payload); fillConcerts(); draw();
      const dialog = $('#cancel-dialog'); if (dialog instanceof HTMLDialogElement) dialog.close();
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });
  $('#delete-confirm')?.addEventListener('input', (event) => {
    const target = event.target, submit = $('#delete-submit');
    if (submit instanceof HTMLButtonElement) submit.disabled = !(target instanceof HTMLInputElement && target.value.trim().toUpperCase() === 'ELIMINAR');
  });
  $('#delete-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = $('#delete-status'), confirm = $('#delete-confirm');
    if (!selected || !(confirm instanceof HTMLInputElement) || confirm.value.trim().toUpperCase() !== 'ELIMINAR') return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Eliminando…';
      const result = await adminApi('eliminar', { idEnsaio: selected.idEnsaio });
      payload = result.index; ensaios = prepararLista(payload); selected = null; fillConcerts(); draw();
      const dialog = $('#delete-dialog'); if (dialog instanceof HTMLDialogElement) dialog.close();
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });

  document.querySelectorAll('[data-panel]').forEach((button) => button.addEventListener('click', () => {
    const panel = button.dataset.panel;
    document.querySelectorAll('[data-panel]').forEach((node) => node.classList.toggle('is-active', node === button));
    $('#panel-repertorio').hidden = panel !== 'repertorio';
    $('#panel-asistencia').hidden = panel !== 'asistencia';
    $('#panel-avisos').hidden = panel !== 'avisos';
  }));
  document.querySelectorAll('[data-voice]').forEach((button) => button.addEventListener('click', () => {
    selectedVoice = button.dataset.voice || 'Todos';
    document.querySelectorAll('[data-voice]').forEach((node) => node.classList.toggle('is-active', node === button));
    renderAttendance();
  }));
  $('#work-search')?.addEventListener('input', updateWorkPicker);

  $('#add-work')?.addEventListener('click', async () => {
    const select = $('#work-select'), status = $('#works-status');
    if (!selected || !(select instanceof HTMLSelectElement) || !select.value || busy || conflito) return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Gardando en R2…';
      const result = await xestionApi('gardarObra', { idRepertorio: select.value });
      draft = result.draft; renderWorks(); updateDraftControls();
      if (status instanceof HTMLElement) status.textContent = 'Obra gardada en R2.';
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });
  $('#works-list')?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.classList.contains('remove-work') || !selected || busy || conflito) return;
    const id = clean(target.dataset.workId), status = $('#works-status');
    if (!id || !window.confirm('Eliminar esta obra do ensaio?')) return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Eliminando do borrador R2…';
      const result = await xestionApi('eliminarObra', { idRepertorio: id });
      draft = result.draft; renderWorks(); updateDraftControls();
      if (status instanceof HTMLElement) status.textContent = 'Obra eliminada do borrador R2.';
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });
  $('#include-program')?.addEventListener('click', async () => {
    const select = $('#program-concert'), status = $('#works-status');
    if (!selected || !(select instanceof HTMLSelectElement) || !select.value || busy || conflito) return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Cargando programa en R2…';
      const result = await xestionApi('incluírProgramaConcerto', { idConcerto: select.value });
      draft = result.draft; renderWorks(); updateDraftControls();
      if (status instanceof HTMLElement) status.textContent = `Programa cargado en R2: ${Number(result.engadidas || 0)} obras.`;
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });

  $('#attendance-list')?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.att || !selected || !draft || busy || conflito) return;
    const row = target.closest('.person-row');
    if (!(row instanceof HTMLElement)) return;
    const pid = clean(row.dataset.person), status = row.querySelector('.row-status');
    const current = attendanceState(attendanceRows().find((a) => idPersoa(a) === pid));
    const clicked = clean(target.dataset.att);
    const next = current === clicked ? '' : clicked;
    try {
      let result;
      if (!next) result = await xestionApi('quitarAsistencia', { idPersoa: pid });
      else {
        const motivo = next === 'xustificada' ? window.prompt('Motivo da xustificación (opcional):', '') || '' : '';
        result = await xestionApi('gardarAsistencia', { idPersoa: pid, estadoAsistencia: next === 'asiste' ? 'Asiste' : 'Non asiste', xustificada: next === 'xustificada', motivo, observacions: '' });
      }
      draft = result.draft; renderAttendance(); updateDraftControls();
      if (status instanceof HTMLElement) status.textContent = 'Gardado en R2';
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });

  $('#avisos-list')?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.classList.contains('accept-aviso') || busy || conflito) return;
    const aviso = avisos.find((row) => clean(row.idPersoa) === clean(target.dataset.person));
    if (!aviso) return;
    const status = $('#avisos-status');
    try {
      const result = await xestionApi('gardarAsistencia', { idPersoa: aviso.idPersoa, estadoAsistencia: 'Non asiste', xustificada: aviso.xustificada === true, motivo: aviso.motivo || '', observacions: aviso.observacions || '' });
      draft = result.draft;
      aviso.aceptadoEnBorrador = true;
      renderAttendance(); renderAvisos(); updateDraftControls();
      if (status instanceof HTMLElement) status.textContent = 'Aviso aceptado no borrador R2. Finaliza o ensaio para confirmalo en Sheet.';
    } catch (error) { if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : String(error); }
  });

  $('#descartar-ensaio')?.addEventListener('click', async () => {
    if (!selected || busy) return;
    if (draft?.dirty === true && !window.confirm('Descartar os cambios pendentes en R2 e recargar o estado actual da Sheet?')) return;
    busy = true; updateDraftControls(); setFinalStatus('Recargando desde Sheet…');
    try {
      const result = await xestionApi('descartar');
      draft = result.draft; avisos = Array.isArray(result.avisos) ? result.avisos : []; conflito = false;
      payload = result.index || payload; ensaios = prepararLista(payload); fillConcerts(); draw(); renderManage();
      setFinalStatus('Estado actualizado desde Sheet');
    } catch (error) { setFinalStatus(error instanceof Error ? error.message : String(error), 'error'); }
    finally { busy = false; updateDraftControls(); }
  });

  $('#finalizar-ensaio')?.addEventListener('click', async () => {
    if (!selected || !draft || draft.dirty !== true || busy || conflito) return;
    busy = true; updateDraftControls(); setFinalStatus('Sincronizando con Sheet…');
    try {
      const result = await xestionApi('finalizar');
      draft = result.draft; avisos = Array.isArray(result.avisos) ? result.avisos : []; conflito = false;
      payload = result.index || payload; ensaios = prepararLista(payload); fillConcerts(); draw(); renderManage();
      setFinalStatus('Ensaio finalizado e sincronizado con Sheet');
    } catch (error) {
      if (error?.code === 'DRAFT_CONFLICT') conflito = true;
      setFinalStatus(error instanceof Error ? error.message : String(error), 'error');
    } finally { busy = false; updateDraftControls(); }
  });

  load();
</script>

