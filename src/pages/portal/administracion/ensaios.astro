$('#program-form')?.addEventListener('submit',async event=>{event.preventDefault();const st=$('#program-status');try{const concert=(payload?.concertos||[]).find(x=>String(x.id||'')===$('#program-select')?.value);if(!concert)return;const used=new Set(works().map(r=>String(r.repertorio||r.idRepertorio||''))),ids=[...new Set((concert.programa||[]).map(x=>x.idRepertorio).filter(id=>id&&!used.has(String(id))))];if(!ids.length){if(st)st.textContent='Non hai obras novas neste programa.';return;}draft=(await draftApi('incluírPrograma',{idsRepertorio:ids})).draft;renderWorks();programDialog?.close();}catch(error){if(st)st.textContent=error instanceof Error?error.message:'Non foi posible cargar o programa.';}});
