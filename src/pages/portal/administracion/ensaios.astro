---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
---

<BaseLayout title="Administración de ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-logout" />

    <main class="admin-rehearsals-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Administración</span>
          <h1>Administración de ensaios</h1>
          <p>Cambia a data dun ensaio programado ou dálle de baixa sen eliminar o seu historial nin as relacións existentes.</p>
        </div>
        <div class="account-card">
          <span><small>Conta identificada</small><strong id="user-email">—</strong></span>
          <span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span>
        </div>
      </header>

      <nav class="admin-local-nav" aria-label="Administración">
        <a href="/portal/administracion/persoas/">Persoas</a>
        <a href="/portal/administracion/ensaios/" class="is-active" aria-current="page">Ensaios</a>
        <a href="/portal/administracion/estado/">Estado do sistema</a>
      </nav>

      <section id="loading" class="state-box">Comprobando permisos e cargando ensaios…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir a administración de ensaios</strong>
        <p id="error-message"></p>
        <button id="retry" type="button" class="secondary">Tentar de novo</button>
      </section>

      <section id="app" hidden>
        <div class="toolbar">
          <label>
            <span>Mostrar</span>
            <select id="filter">
              <option value="activos">Ensaios activos</option>
              <option value="todos">Todos os ensaios</option>
              <option value="baixa">Dados de baixa</option>
            </select>
          </label>
          <p id="count"></p>
        </div>
        <div id="list" class="rehearsal-list"></div>
      </section>
    </main>
  </div>

  <dialog id="date-dialog">
    <form id="date-form">
      <header><h2>Cambiar data</h2><button type="button" id="date-close" aria-label="Pechar">×</button></header>
      <p id="date-name"></p>
      <label><span>Nova data</span><input id="new-date" type="date" required /></label>
      <p id="date-status" class="dialog-status"></p>
      <footer><button type="button" id="date-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer>
    </form>
  </dialog>

  <dialog id="cancel-dialog">
    <form id="cancel-form">
      <header><h2>Dar de baixa o ensaio</h2><button type="button" id="cancel-close" aria-label="Pechar">×</button></header>
      <p id="cancel-name"></p>
      <p class="warning">O ensaio quedará marcado como cancelado. Non se eliminarán nin o seu identificador nin as relacións con obras ou asistencias.</p>
      <p id="cancel-status" class="dialog-status"></p>
      <footer><button type="button" id="cancel-back" class="secondary">Volver</button><button type="submit" class="danger">Dar de baixa</button></footer>
    </form>
  </dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';

  const $ = (selector) => document.querySelector(selector);
  const loading = $('#loading');
  const errorState = $('#error-state');
  const errorMessage = $('#error-message');
  const app = $('#app');
  const list = $('#list');
  const filter = $('#filter');
  const count = $('#count');
  const userEmail = $('#user-email');
  const userLevel = $('#user-level');
  const dateDialog = $('#date-dialog');
  const cancelDialog = $('#cancel-dialog');
  let ensaios = [];
  let selected = null;

  const fmt = (value) => {
    if (!value) return 'Sen data';
    const d = new Date(`${String(value).slice(0, 10)}T12:00:00`);
    return Number.isNaN(d.getTime()) ? String(value) : new Intl.DateTimeFormat('gl-ES', {
      weekday:'long', day:'numeric', month:'long', year:'numeric'
    }).format(d);
  };

  async function request(accion, extra = {}) {
    const user = auth.currentUser;
    if (!user?.email) throw new Error('A sesión non está activa.');
    const idToken = await user.getIdToken();
    const response = await fetch('/api/ensaios-admin', {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body:JSON.stringify({ idToken, accion, ...extra })
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || `Erro HTTP ${response.status}`);
    return result;
  }

  function visible() {
    const mode = filter instanceof HTMLSelectElement ? filter.value : 'activos';
    return ensaios.filter((item) => mode === 'todos' || (mode === 'baixa' ? item.cancelado : !item.cancelado));
  }

  function draw() {
    if (!(list instanceof HTMLElement)) return;
    const rows = visible();
    if (count instanceof HTMLElement) count.textContent = `${rows.length} ensaio${rows.length === 1 ? '' : 's'}`;
    if (!rows.length) {
      list.innerHTML = '<section class="state-box">Non hai ensaios para este filtro.</section>';
      return;
    }
    list.innerHTML = rows.map((item) => `
      <article class="rehearsal-card ${item.cancelado ? 'is-cancelled' : ''}" data-id="${item.idEnsaio}">
        <div class="rehearsal-date"><small>Data</small><strong>${fmt(item.data)}</strong></div>
        <div class="rehearsal-info">
          <h2>${item.tipoEnsaio || 'Ensaio'}</h2>
          <p>${[item.horaInicio, item.lugar].filter(Boolean).join(' · ') || 'Sen máis datos'}</p>
          <div class="meta"><span>${Number(item.obras || 0)} obras vinculadas</span><span>${Number(item.asistencias || 0)} rexistros de asistencia</span></div>
        </div>
        <div class="rehearsal-state">${item.cancelado ? '<strong>Baixa</strong>' : '<strong>Activo</strong>'}</div>
        <div class="actions">
          ${item.cancelado ? '' : `<button type="button" class="secondary change-date" data-id="${item.idEnsaio}">Cambiar data</button><button type="button" class="danger cancel-rehearsal" data-id="${item.idEnsaio}">Dar de baixa</button>`}
        </div>
      </article>`).join('');
  }

  async function load() {
    if (loading instanceof HTMLElement) loading.hidden = false;
    if (errorState instanceof HTMLElement) errorState.hidden = true;
    if (app instanceof HTMLElement) app.hidden = true;
    try {
      const user = await waitForPortalUser();
      if (!user?.email) throw new Error('Non hai unha sesión válida.');
      if (userEmail instanceof HTMLElement) userEmail.textContent = user.email;
      const result = await request('listar');
      ensaios = Array.isArray(result.ensaios) ? result.ensaios : [];
      if (userLevel instanceof HTMLElement) userLevel.textContent = result.nivel || 'Xunta Directiva';
      if (loading instanceof HTMLElement) loading.hidden = true;
      if (app instanceof HTMLElement) app.hidden = false;
      draw();
    } catch (error) {
      if (loading instanceof HTMLElement) loading.hidden = true;
      if (errorState instanceof HTMLElement) errorState.hidden = false;
      if (errorMessage instanceof HTMLElement) errorMessage.textContent = error instanceof Error ? error.message : 'Produciuse un erro inesperado.';
    }
  }

  filter?.addEventListener('change', draw);
  $('#retry')?.addEventListener('click', load);
  $('#admin-ensaios-logout')?.addEventListener('click', async () => { await closePortalSession(); location.href = '/'; });

  list?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    selected = ensaios.find((item) => item.idEnsaio === target.dataset.id) || null;
    if (!selected) return;
    if (target.classList.contains('change-date') && dateDialog instanceof HTMLDialogElement) {
      $('#date-name').textContent = `${selected.tipoEnsaio || 'Ensaio'} · ${fmt(selected.data)}`;
      const input = $('#new-date');
      if (input instanceof HTMLInputElement) input.value = String(selected.data || '').slice(0, 10);
      $('#date-status').textContent = '';
      dateDialog.showModal();
    }
    if (target.classList.contains('cancel-rehearsal') && cancelDialog instanceof HTMLDialogElement) {
      $('#cancel-name').textContent = `${selected.tipoEnsaio || 'Ensaio'} · ${fmt(selected.data)}`;
      $('#cancel-status').textContent = '';
      cancelDialog.showModal();
    }
  });

  const closeDate = () => dateDialog instanceof HTMLDialogElement && dateDialog.close();
  const closeCancel = () => cancelDialog instanceof HTMLDialogElement && cancelDialog.close();
  $('#date-close')?.addEventListener('click', closeDate);
  $('#date-cancel')?.addEventListener('click', closeDate);
  $('#cancel-close')?.addEventListener('click', closeCancel);
  $('#cancel-back')?.addEventListener('click', closeCancel);

  $('#date-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = $('#new-date');
    const status = $('#date-status');
    if (!selected || !(input instanceof HTMLInputElement) || !input.value) return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Gardando…';
      await request('cambiarData', { idEnsaio:selected.idEnsaio, data:input.value });
      closeDate();
      await load();
    } catch (error) {
      if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : 'Non foi posible cambiar a data.';
    }
  });

  $('#cancel-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = $('#cancel-status');
    if (!selected) return;
    try {
      if (status instanceof HTMLElement) status.textContent = 'Gardando…';
      await request('darBaixa', { idEnsaio:selected.idEnsaio });
      closeCancel();
      await load();
    } catch (error) {
      if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : 'Non foi posible dar de baixa o ensaio.';
    }
  });

  load();
</script>

<style>
  :global(body.portal-private-body) { background:#f5f3f1; }
  .admin-rehearsals-main { flex:1 1 auto; min-width:0; padding:clamp(1.6rem,3vw,3rem) clamp(1.4rem,3vw,3.5rem) 4rem; }
  .private-page-header { display:flex; justify-content:space-between; gap:2rem; margin-bottom:1rem; padding-bottom:1.35rem; border-bottom:1px solid #ded8d3; }
  .private-page-header h1 { margin:.25rem 0 .55rem; }
  .private-page-header p { max-width:760px; margin:0; color:#625c58; }
  .section-kicker { color:#5d142b; font-size:.75rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .account-card { display:grid; flex:0 0 min(310px,32vw); gap:.8rem; min-width:260px; padding:1rem 1.15rem; border:1px solid #ded8d3; border-radius:7px; background:#fff; }
  .account-card span { display:grid; gap:.2rem; }
  .account-card small { color:#7c726d; font-size:.68rem; font-weight:800; text-transform:uppercase; }
  .admin-local-nav { display:flex; flex-wrap:wrap; gap:.55rem; margin:0 0 1.5rem; }
  .admin-local-nav a { padding:.55rem .9rem; border:1px solid rgba(93,20,43,.2); border-radius:999px; background:#fff; color:#3b2028; font-size:.9rem; font-weight:700; text-decoration:none; }
  .admin-local-nav a.is-active { background:#5d142b; border-color:#5d142b; color:#fff; }
  .state-box, .toolbar, .rehearsal-card { border:1px solid #ded8d3; border-radius:7px; background:#fff; }
  .state-box { padding:1.15rem 1.25rem; }
  .error-box { color:#8b2d36; }
  .toolbar { display:flex; align-items:end; justify-content:space-between; gap:1rem; margin-bottom:1rem; padding:1rem 1.15rem; }
  .toolbar label { display:grid; gap:.35rem; }
  .toolbar label span { color:#6e6265; font-size:.78rem; font-weight:800; }
  .toolbar select, dialog input { min-height:2.5rem; padding:.45rem .65rem; border:1px solid #cfc7c3; border-radius:5px; background:#fff; }
  .toolbar p { margin:0; color:#6e6265; font-weight:700; }
  .rehearsal-list { display:grid; gap:.8rem; }
  .rehearsal-card { display:grid; grid-template-columns:minmax(180px,1.1fr) minmax(260px,2fr) auto auto; align-items:center; gap:1.2rem; padding:1rem 1.15rem; }
  .rehearsal-card.is-cancelled { opacity:.68; }
  .rehearsal-date { display:grid; gap:.25rem; }
  .rehearsal-date small { color:#806f74; font-size:.7rem; font-weight:800; text-transform:uppercase; }
  .rehearsal-info h2 { margin:0 0 .25rem; font-size:1rem; }
  .rehearsal-info p { margin:0; color:#6f6561; font-size:.88rem; }
  .meta { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:.45rem; color:#806f74; font-size:.78rem; }
  .rehearsal-state strong { display:inline-flex; padding:.32rem .55rem; border-radius:999px; background:#edf4ef; color:#3f6c50; font-size:.75rem; }
  .is-cancelled .rehearsal-state strong { background:#f4eded; color:#843941; }
  .actions { display:flex; gap:.45rem; }
  button { min-height:2.35rem; padding:.5rem .8rem; border-radius:5px; cursor:pointer; font-weight:800; }
  .secondary { border:1px solid #cfc5c8; background:#fff; color:#4f333b; }
  .primary { border:1px solid #5d142b; background:#5d142b; color:#fff; }
  .danger { border:1px solid #8e3440; background:#fff7f7; color:#8e3440; }
  dialog { width:min(520px,calc(100vw - 2rem)); border:0; border-radius:8px; padding:0; box-shadow:0 18px 60px rgba(0,0,0,.22); }
  dialog::backdrop { background:rgba(35,27,29,.45); }
  dialog form { padding:1.25rem; }
  dialog header, dialog footer { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  dialog header { padding-bottom:1rem; border-bottom:1px solid #e7e0dd; }
  dialog header h2 { margin:0; font-size:1.15rem; }
  dialog header button { min-height:auto; border:0; background:transparent; font-size:1.5rem; }
  dialog label { display:grid; gap:.4rem; margin:1rem 0; }
  dialog footer { justify-content:flex-end; padding-top:1rem; border-top:1px solid #e7e0dd; }
  .warning { padding:.8rem; border:1px solid #ead5d8; border-radius:5px; background:#fff8f8; color:#7f343d; }
  .dialog-status { min-height:1.4rem; color:#7f343d; font-size:.85rem; }
  @media (max-width:980px) { .rehearsal-card { grid-template-columns:1fr 1fr; } .actions { justify-content:flex-end; } }
  @media (max-width:900px) { .private-page-header { display:grid; } .account-card { min-width:0; width:100%; } }
  @media (max-width:620px) { .admin-rehearsals-main { padding:1.15rem .9rem 2.5rem; } .toolbar, .rehearsal-card { display:grid; grid-template-columns:1fr; } .actions { justify-content:flex-start; flex-wrap:wrap; } }
</style>
