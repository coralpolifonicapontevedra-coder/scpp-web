---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-logout" />
    <main class="admin-rehearsals-main">
      <header class="private-page-header">
        <div><span class="section-kicker">Administración</span><h1>Administración de ensaios</h1><p>Da de alta novos ensaios, cambia a súa data ou dálles de baixa sen eliminar o historial nin as relacións existentes.</p></div>
        <div class="account-card"><span><small>Conta identificada</small><strong id="user-email">—</strong></span><span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span></div>
      </header>
      <AdministracionNav active="ensaios" />
      <section id="loading" class="state-box">Comprobando permisos e cargando ensaios…</section>
      <section id="error-state" class="state-box error-box" hidden><strong>Non foi posible abrir a administración de ensaios</strong><p id="error-message"></p><button id="retry" type="button" class="secondary">Tentar de novo</button></section>
      <section id="app" hidden>
        <div class="toolbar"><label><span>Mostrar</span><select id="filter"><option value="activos">Ensaios activos</option><option value="todos">Todos os ensaios</option><option value="baixa">Dados de baixa</option></select></label><div class="toolbar-actions"><p id="count"></p><button id="new-rehearsal" type="button" class="primary">Novo ensaio</button></div></div>
        <div id="list" class="rehearsal-list"></div>
      </section>
    </main>
  </div>

  <dialog id="new-dialog"><form id="new-form"><header><h2>Novo ensaio</h2><button type="button" id="new-close" aria-label="Pechar">×</button></header><div class="form-grid"><label><span>Data *</span><input id="create-date" type="date" required /></label><label><span>Hora de inicio *</span><input id="create-start" type="time" required /></label><label><span>Hora de fin</span><input id="create-end" type="time" /></label><label><span>Tipo de ensaio *</span><input id="create-type" type="text" value="Ensaio ordinario" required /></label><label><span>Lugar</span><input id="create-place" type="text" /></label><label><span>Concerto relacionado</span><input id="create-concert" type="text" /></label></div><label><span>Descrición</span><input id="create-description" type="text" /></label><label><span>Observacións</span><textarea id="create-notes" rows="3"></textarea></label><p id="new-status" class="dialog-status"></p><footer><button type="button" id="new-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Crear ensaio</button></footer></form></dialog>
  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" id="date-close" aria-label="Pechar">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required /></label><p id="date-status" class="dialog-status"></p><footer><button type="button" id="date-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>
  <dialog id="cancel-dialog"><form id="cancel-form"><header><h2>Dar de baixa o ensaio</h2><button type="button" id="cancel-close" aria-label="Pechar">×</button></header><p id="cancel-name"></p><p class="warning">O ensaio quedará marcado como cancelado. Non se eliminarán nin o seu identificador nin as relacións con obras ou asistencias.</p><p id="cancel-status" class="dialog-status"></p><footer><button type="button" id="cancel-back" class="secondary">Volver</button><button type="submit" class="danger">Dar de baixa</button></footer></form></dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
  const $=(s)=>document.querySelector(s); const loading=$('#loading'),errorState=$('#error-state'),errorMessage=$('#error-message'),app=$('#app'),list=$('#list'),filter=$('#filter'),count=$('#count'),userEmail=$('#user-email'),userLevel=$('#user-level'),newDialog=$('#new-dialog'),dateDialog=$('#date-dialog'),cancelDialog=$('#cancel-dialog'); let ensaios=[],selected=null;
  const fmt=(v)=>{if(!v)return'Sen data';const d=new Date(`${String(v).slice(0,10)}T12:00:00`);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d)};
  async function request(accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch('/api/ensaios-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}
  function visible(){const mode=filter instanceof HTMLSelectElement?filter.value:'activos';return ensaios.filter(i=>mode==='todos'||(mode==='baixa'?i.cancelado:!i.cancelado));}
  function draw(){if(!(list instanceof HTMLElement))return;const rows=visible();if(count instanceof HTMLElement)count.textContent=`${rows.length} ensaio${rows.length===1?'':'s'}`;if(!rows.length){list.innerHTML='<section class="state-box">Non hai ensaios para este filtro.</section>';return;}list.innerHTML=rows.map(i=>`<article class="rehearsal-card ${i.cancelado?'is-cancelled':''}" data-id="${i.idEnsaio}"><div class="rehearsal-date"><small>Data</small><strong>${fmt(i.data)}</strong></div><div class="rehearsal-info"><h2>${i.tipoEnsaio||'Ensaio'}</h2><p>${[i.horaInicio,i.lugar].filter(Boolean).join(' · ')||'Sen máis datos'}</p><div class="meta"><span>${Number(i.obras||0)} obras vinculadas</span><span>${Number(i.asistencias||0)} rexistros de asistencia</span></div></div><div class="rehearsal-state"><strong>${i.cancelado?'Baixa':'Activo'}</strong></div><div class="actions">${i.cancelado?'':`<button type="button" class="secondary change-date" data-id="${i.idEnsaio}">Cambiar data</button><button type="button" class="danger cancel-rehearsal" data-id="${i.idEnsaio}">Dar de baixa</button>`}</div></article>`).join('');}
  async function load(){if(loading instanceof HTMLElement)loading.hidden=false;if(errorState instanceof HTMLElement)errorState.hidden=true;if(app instanceof HTMLElement)app.hidden=true;try{const user=await waitForPortalUser();if(!user?.email)throw new Error('Non hai unha sesión válida.');if(userEmail instanceof HTMLElement)userEmail.textContent=user.email;const result=await request('listar');ensaios=Array.isArray(result.ensaios)?result.ensaios:[];if(userLevel instanceof HTMLElement)userLevel.textContent=result.nivel||'Xunta Directiva';if(loading instanceof HTMLElement)loading.hidden=true;if(app instanceof HTMLElement)app.hidden=false;draw();}catch(error){if(loading instanceof HTMLElement)loading.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Produciuse un erro inesperado.';}}
  filter?.addEventListener('change',draw);$('#retry')?.addEventListener('click',load);$('#admin-ensaios-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});
  $('#new-rehearsal')?.addEventListener('click',()=>{if(newDialog instanceof HTMLDialogElement){const status=$('#new-status');if(status)status.textContent='';newDialog.showModal();}});
  list?.addEventListener('click',(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement))return;selected=ensaios.find(i=>i.idEnsaio===target.dataset.id)||null;if(!selected)return;if(target.classList.contains('change-date')&&dateDialog instanceof HTMLDialogElement){const n=$('#date-name');if(n)n.textContent=`${selected.tipoEnsaio||'Ensaio'} · ${fmt(selected.data)}`;const input=$('#new-date');if(input instanceof HTMLInputElement)input.value=String(selected.data||'').slice(0,10);const s=$('#date-status');if(s)s.textContent='';dateDialog.showModal();}if(target.classList.contains('cancel-rehearsal')&&cancelDialog instanceof HTMLDialogElement){const n=$('#cancel-name');if(n)n.textContent=`${selected.tipoEnsaio||'Ensaio'} · ${fmt(selected.data)}`;const s=$('#cancel-status');if(s)s.textContent='';cancelDialog.showModal();}});
  const closeNew=()=>newDialog instanceof HTMLDialogElement&&newDialog.close(),closeDate=()=>dateDialog instanceof HTMLDialogElement&&dateDialog.close(),closeCancel=()=>cancelDialog instanceof HTMLDialogElement&&cancelDialog.close();$('#new-close')?.addEventListener('click',closeNew);$('#new-cancel')?.addEventListener('click',closeNew);$('#date-close')?.addEventListener('click',closeDate);$('#date-cancel')?.addEventListener('click',closeDate);$('#cancel-close')?.addEventListener('click',closeCancel);$('#cancel-back')?.addEventListener('click',closeCancel);
  $('#new-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const data=$('#create-date'),start=$('#create-start'),end=$('#create-end'),type=$('#create-type'),place=$('#create-place'),concert=$('#create-concert'),description=$('#create-description'),notes=$('#create-notes'),status=$('#new-status');if(!(data instanceof HTMLInputElement)||!(start instanceof HTMLInputElement)||!(type instanceof HTMLInputElement)||!data.value||!start.value||!type.value.trim())return;try{if(status instanceof HTMLElement)status.textContent='Creando…';await request('novo',{data:data.value,horaInicio:start.value,horaFin:end instanceof HTMLInputElement?end.value:'',tipoEnsaio:type.value.trim(),lugar:place instanceof HTMLInputElement?place.value.trim():'',concerto:concert instanceof HTMLInputElement?concert.value.trim():'',descricion:description instanceof HTMLInputElement?description.value.trim():'',observacions:notes instanceof HTMLTextAreaElement?notes.value.trim():''});closeNew();event.currentTarget instanceof HTMLFormElement&&event.currentTarget.reset();await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible crear o ensaio.';}});
  $('#date-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-date'),status=$('#date-status');if(!selected||!(input instanceof HTMLInputElement)||!input.value)return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarData',{idEnsaio:selected.idEnsaio,data:input.value});closeDate();await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar a data.';}});
  $('#cancel-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const status=$('#cancel-status');if(!selected)return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('darBaixa',{idEnsaio:selected.idEnsaio});closeCancel();await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible dar de baixa o ensaio.';}});load();
</script>

<style is:global>
  body{background:#f5f3f1}.private-layout{display:flex;min-height:100vh}.admin-rehearsals-main{flex:1;min-width:0;padding:2.1rem clamp(1.25rem,3vw,3.5rem) 4rem;font-family:var(--fuente-minimalista)}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.8rem}.section-kicker{color:var(--color-acento);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.private-page-header h1{margin:.2rem 0 .55rem;color:var(--color-principal);font-size:clamp(2rem,4vw,3.5rem)}.private-page-header p{max-width:760px;margin:0;color:#625c58}.account-card{display:grid;gap:.7rem;min-width:250px;padding:1rem 1.15rem;border:1px solid #ded8d3;background:#fff}.account-card span{display:grid;gap:.18rem}.account-card small{color:#77706b;font-size:.68rem;font-weight:700;text-transform:uppercase}.state-box,.toolbar,.rehearsal-card{border:1px solid #ded8d3;background:#fff}.state-box{padding:1.35rem}.error-box{color:#8b2d36}.toolbar{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:1.25rem;padding:1rem 1.15rem}.toolbar label{display:grid;gap:.45rem;width:min(420px,100%)}.toolbar label span{font-size:.78rem;font-weight:800;text-transform:uppercase}.toolbar select,dialog input,dialog select,dialog textarea{min-height:2.75rem;padding:.55rem .7rem;border:1px solid #d6cfca;background:#fff;font:inherit}.toolbar-actions{display:flex;align-items:center;gap:.8rem}.toolbar p{margin:0;color:#736c67;font-size:.82rem}.rehearsal-list{display:grid;gap:.8rem}.rehearsal-card{display:grid;grid-template-columns:minmax(190px,1.1fr) minmax(260px,2fr) auto auto;align-items:center;gap:1.2rem;padding:1rem 1.15rem}.rehearsal-card.is-cancelled{opacity:.68}.rehearsal-date{display:grid;gap:.25rem}.rehearsal-date small{color:#806f74;font-size:.7rem;font-weight:800;text-transform:uppercase}.rehearsal-info h2{margin:0 0 .25rem;color:var(--color-principal);font-size:1rem}.rehearsal-info p{margin:0;color:#6f6561;font-size:.88rem}.meta{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:.45rem;color:#806f74;font-size:.78rem}.rehearsal-state strong{display:inline-flex;padding:.32rem .55rem;border-radius:999px;background:#edf4ef;color:#3f6c50;font-size:.75rem}.is-cancelled .rehearsal-state strong{background:#f4eded;color:#843941}.actions{display:flex;gap:.45rem}.admin-rehearsals-main button{min-height:2.35rem;padding:.5rem .8rem;border-radius:4px;cursor:pointer;font-weight:800}.secondary{border:1px solid #cfc5c8;background:#fff;color:#4f333b}.primary{border:1px solid #5d142b;background:#5d142b;color:#fff}.danger{border:1px solid #8e3440;background:#fff7f7;color:#8e3440}dialog{width:min(620px,calc(100vw - 2rem));border:0;padding:0;box-shadow:0 18px 60px rgba(0,0,0,.22)}dialog::backdrop{background:rgba(35,27,29,.45)}dialog form{padding:1.25rem}dialog header,dialog footer{display:flex;align-items:center;justify-content:space-between;gap:1rem}dialog header{padding-bottom:1rem;border-bottom:1px solid #e7e0dd}dialog header h2{margin:0;font-size:1.15rem}dialog header button{min-height:auto;border:0;background:transparent;font-size:1.5rem}dialog label{display:grid;gap:.4rem;margin:1rem 0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 1rem}dialog footer{justify-content:flex-end;padding-top:1rem;border-top:1px solid #e7e0dd}.warning{padding:.8rem;border:1px solid #ead5d8;background:#fff8f8;color:#7f343d}.dialog-status{min-height:1.4rem;color:#7f343d;font-size:.85rem}@media(max-width:980px){.rehearsal-card{grid-template-columns:1fr 1fr}.actions{justify-content:flex-end}}@media(max-width:900px){.private-layout{display:block}.private-page-header,.toolbar{display:grid}.account-card{min-width:0}.rehearsal-card{grid-template-columns:1fr 1fr}.toolbar-actions{justify-content:space-between}}@media(max-width:620px){.admin-rehearsals-main{padding:1.15rem .9rem 2.5rem}.rehearsal-card,.form-grid{grid-template-columns:1fr}.actions{justify-content:flex-start;flex-wrap:wrap}.toolbar-actions{display:grid}}
</style>
