---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-logout" />
    <main class="admin-main">
      <header class="page-header">
        <div>
          <span class="kicker">Administración</span>
          <h1>Ensaios</h1>
          <p>Alta, xestión musical, asistencia, análise, baixa e eliminación nun único módulo.</p>
        </div>
        <div class="account-card">
          <span><small>Conta identificada</small><strong id="user-email">—</strong></span>
          <span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span>
        </div>
      </header>

      <AdministracionNav active="ensaios" />

      <section id="loading" class="state-box">Comprobando permisos e cargando ensaios…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir a administración de ensaios</strong>
        <p id="error-message"></p>
        <button id="retry" type="button" class="secondary">Tentar de novo</button>
      </section>

      <section id="app" hidden>
        <section class="admin-toolbar card">
          <div>
            <span class="kicker">Xestión</span>
            <h2>Ensaios programados</h2>
          </div>
          <div class="toolbar-actions">
            <label><span>Mostrar</span><select id="filter"><option value="activos">Ensaios activos</option><option value="todos">Todos os ensaios</option><option value="baixa">Dados de baixa</option></select></label>
            <button id="new-rehearsal" class="primary" type="button">+ Novo ensaio</button>
          </div>
          <p id="count" class="count"></p>
        </section>

        <div id="list" class="rehearsal-list"></div>

        <section id="workbench" class="workbench" hidden>
          <header class="workbench-header card">
            <div>
              <span class="kicker">Ensaio seleccionado</span>
              <h2 id="selected-title">—</h2>
              <p id="selected-meta"></p>
            </div>
            <button id="close-workbench" type="button" class="secondary">Pechar xestión</button>
          </header>

          <nav class="module-nav card" aria-label="Xestión do ensaio">
            <button id="nav-works" class="secondary active" type="button">Obras a ensaiar</button>
            <button id="nav-att" class="secondary" type="button">Lista de asistentes</button>
            <button id="nav-analysis" class="secondary" type="button">Análise de asistencias</button>
          </nav>

          <section id="works" class="panel card">
            <header class="heading"><div><span class="kicker">Preparación musical</span><h2>Obras a ensaiar</h2></div><strong id="works-count"></strong></header>
            <div class="works-toolbar">
              <button id="load-program" class="secondary" type="button">Cargar desde programa</button>
              <div class="search"><input id="work-search" type="search" placeholder="Buscar obra ou compositor…"><button id="work-search-btn" class="secondary" type="button" aria-label="Buscar">⌕</button></div>
              <select id="work-select"><option value="">Escolle unha obra…</option></select>
              <button id="add-work" class="primary" type="button">Engadir obra</button>
            </div>
            <p id="work-result" class="status"></p>
            <p id="works-status" class="status"></p>
            <div id="works-list" class="works-grid"></div>
          </section>

          <section id="attendance" class="panel card" hidden>
            <header class="heading"><div><span class="kicker">Control de asistencia</span><h2>Lista de asistentes</h2><p>En «Todos» móstranse os asistentes. Por corda realízase o control individual.</p></div></header>
            <div class="attendance-toolbar">
              <div class="voice-tabs"><button class="active" data-voice="Todos" type="button">Todos</button><button data-voice="Soprano" type="button">Sopranos</button><button data-voice="Contralto" type="button">Contraltos</button><button data-voice="Tenor" type="button">Tenores</button><button data-voice="Baixo" type="button">Baixos</button></div>
              <input id="people-search" type="search" placeholder="Buscar coralista…">
            </div>
            <div id="attendance-list"></div>
            <p id="final-status" class="status"></p>
            <div class="final-zone"><button id="finalize" class="primary" type="button">Finalizar ensaio</button></div>
          </section>

          <section id="analysis" class="panel card" hidden>
            <header class="heading"><div><span class="kicker">Seguimento</span><h2>Análise de asistencias</h2><p>Consulta por período, persoa, corda ou conxunto da coral.</p></div></header>
            <div class="analysis-filters">
              <label><span>Desde</span><input id="from" type="date"></label>
              <label><span>Ata</span><input id="to" type="date"></label>
              <label><span>Consulta</span><select id="scope"><option value="general">Xeral</option><option value="voice">Por corda</option><option value="person">Por persoa</option></select></label>
              <label id="voice-wrap" hidden><span>Corda</span><select id="analysis-voice"><option value="Soprano">Sopranos</option><option value="Contralto">Contraltos</option><option value="Tenor">Tenores</option><option value="Baixo">Baixos</option></select></label>
              <label id="person-wrap" hidden><span>Coralista</span><select id="analysis-person"></select></label>
              <button id="consult" class="primary" type="button">Consultar</button>
            </div>
            <section class="analysis-block"><h3>Relación por ensaios</h3><div id="by-rehearsal"></div></section>
            <div class="ranking-action"><button id="toggle-ranking" class="secondary" type="button">Ver ranking de asistencias</button></div>
            <section id="ranking-block" class="analysis-block" hidden><h3>Ranking de asistencias</h3><div id="ranking"></div></section>
          </section>
        </section>
      </section>
    </main>
  </div>

  <dialog id="new-dialog"><form id="new-form">
    <header><h2>Novo ensaio</h2><button type="button" id="new-close" aria-label="Pechar">×</button></header>
    <div class="form-grid">
      <label><span>Data *</span><input id="new-date-create" type="date" required></label>
      <label><span>Hora de inicio *</span><input id="new-start" type="time" required value="20:00"></label>
      <label><span>Hora de fin</span><input id="new-end" type="time"></label>
      <label><span>Tipo de ensaio *</span><input id="new-type" type="text" required value="Ensaio ordinario"></label>
      <label class="wide"><span>Lugar</span><input id="new-place" type="text" value="Centro Social Sur - Luís Braille 40"></label>
      <label class="wide"><span>Concerto relacionado</span><select id="new-concert"><option value="">Sen concerto relacionado</option></select></label>
      <label class="wide"><span>Descrición</span><textarea id="new-description" rows="2"></textarea></label>
      <label class="wide"><span>Observacións</span><textarea id="new-notes" rows="2"></textarea></label>
    </div>
    <p id="new-status" class="dialog-status"></p>
    <footer><button type="button" id="new-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Crear ensaio</button></footer>
  </form></dialog>

  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" id="date-close" aria-label="Pechar">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required></label><p id="date-status" class="dialog-status"></p><footer><button type="button" id="date-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>

  <dialog id="cancel-dialog"><form id="cancel-form"><header><h2>Dar de baixa o ensaio</h2><button type="button" id="cancel-close" aria-label="Pechar">×</button></header><p id="cancel-name"></p><p class="warning">O ensaio quedará marcado como cancelado. Non se eliminarán nin o seu identificador nin as relacións con obras ou asistencias.</p><p id="cancel-status" class="dialog-status"></p><footer><button type="button" id="cancel-back" class="secondary">Volver</button><button type="submit" class="danger">Dar de baixa</button></footer></form></dialog>

  <dialog id="delete-dialog"><form id="delete-form"><header><h2>Eliminar definitivamente o ensaio</h2><button type="button" id="delete-close" aria-label="Pechar">×</button></header><p id="delete-name"></p><p id="delete-relations" class="warning"></p><p class="danger-note"><strong>Esta acción non se pode desfacer.</strong> Eliminarase o ensaio e tamén os seus rexistros asociados de obras e asistencias.</p><label><span>Escribe ELIMINAR para confirmar</span><input id="delete-confirm" type="text" autocomplete="off" spellcheck="false"></label><p id="delete-status" class="dialog-status"></p><footer><button type="button" id="delete-back" class="secondary">Cancelar</button><button type="submit" id="delete-submit" class="danger-solid" disabled>Eliminar definitivamente</button></footer></form></dialog>

  <dialog id="program-dialog"><form id="program-form"><header><h2>Cargar desde programa</h2><button id="close-program" type="button" aria-label="Pechar">×</button></header><label><span>Concerto</span><select id="program-select"></select></label><p id="program-status" class="dialog-status"></p><footer><button id="cancel-program" type="button" class="secondary">Cancelar</button><button class="primary" type="submit">Incluír programa</button></footer></form></dialog>
</BaseLayout>

<script>
import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';

const $=(s)=>document.querySelector(s);
const norm=(v='')=>String(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
const esc=(v='')=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
const truthy=v=>v===true||['true','1','si','sí','yes','x'].includes(norm(v));
const rid=r=>String(r?.idEnsaio||r?.id||'').trim();
const pid=p=>String(p?.idPersoa||p?.id||'').trim();
const wid=w=>String(w?.idRepertorio||w?.id||'').trim();
const personName=p=>[p?.primeiroApelido,p?.segundoApelido,p?.nome].filter(Boolean).join(' ')||String(p?.nomeCompleto||'');
const sortPeople=(a,b)=>personName(a).localeCompare(personName(b),'gl',{sensitivity:'base'});
const VOICES=['Soprano','Contralto','Tenor','Baixo'];
const voiceLabel=v=>({Soprano:'Sopranos',Contralto:'Contraltos',Tenor:'Tenores',Baixo:'Baixos'}[v]||v);
const parseDate=v=>{if(!v)return null;const s=String(v);const iso=/^\d{4}-\d{2}-\d{2}/.test(s)?s.slice(0,10):s.split(/[\/-]/).reverse().join('-');const d=new Date(iso+'T12:00:00');return Number.isNaN(d.getTime())?null:d};
const fmt=v=>{const d=parseDate(v);return d?new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d):String(v||'Sen data')};
const short=v=>{const d=parseDate(v);return d?new Intl.DateTimeFormat('gl-ES',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d):String(v||'')};

const loading=$('#loading'),errorState=$('#error-state'),errorMessage=$('#error-message'),app=$('#app'),list=$('#list'),filter=$('#filter'),count=$('#count'),userEmail=$('#user-email'),userLevel=$('#user-level');
const newDialog=$('#new-dialog'),dateDialog=$('#date-dialog'),cancelDialog=$('#cancel-dialog'),deleteDialog=$('#delete-dialog'),programDialog=$('#program-dialog');
let ensaios=[],payload=null,selected=null,draft=null,voice='Todos',rankingData='';

async function call(url,accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}
const adminApi=(accion,extra={})=>call('/api/ensaios-admin',accion,extra);
const rehearsalApi=(accion,extra={})=>call('/api/ensaios',accion,extra);
const draftApi=(accion,extra={})=>call('/api/ensaios-borrador',accion,{idEnsaio:rid(selected),...extra});
async function deleteRequest(idEnsaio){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch('/api/ensaios-eliminar-ensaio',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,idEnsaio})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}

function visible(){const mode=filter instanceof HTMLSelectElement?filter.value:'activos';return ensaios.filter(i=>mode==='todos'||(mode==='baixa'?i.cancelado:!i.cancelado));}
function drawList(){if(!(list instanceof HTMLElement))return;const rows=visible();if(count instanceof HTMLElement)count.textContent=`${rows.length} ensaio${rows.length===1?'':'s'}`;if(!rows.length){list.innerHTML='<section class="state-box">Non hai ensaios para este filtro.</section>';return;}list.innerHTML=rows.map(i=>`<article class="rehearsal-card ${i.cancelado?'is-cancelled':''}" data-id="${esc(i.idEnsaio)}"><div class="rehearsal-date"><small>Data</small><strong>${esc(fmt(i.data))}</strong></div><div class="rehearsal-info"><h2>${esc(i.tipoEnsaio||'Ensaio')}</h2><p>${esc([i.horaInicio,i.lugar].filter(Boolean).join(' · ')||'Sen máis datos')}</p><div class="meta"><span>${Number(i.obras||0)} obras vinculadas</span><span>${Number(i.asistencias||0)} rexistros de asistencia</span></div></div><div class="rehearsal-state"><strong>${i.cancelado?'Baixa':'Activo'}</strong></div><div class="actions">${i.cancelado?'':`<button type="button" class="primary manage-rehearsal" data-id="${esc(i.idEnsaio)}">Xestionar</button><button type="button" class="secondary change-date" data-id="${esc(i.idEnsaio)}">Cambiar data</button><button type="button" class="danger cancel-rehearsal" data-id="${esc(i.idEnsaio)}">Dar de baixa</button>`}<button type="button" class="danger delete-rehearsal" data-id="${esc(i.idEnsaio)}">Eliminar</button></div></article>`).join('');}

async function loadAll({keepSelection=false}={}){if(loading instanceof HTMLElement)loading.hidden=false;if(errorState instanceof HTMLElement)errorState.hidden=true;try{const user=await waitForPortalUser();if(!user?.email)throw new Error('Non hai unha sesión válida.');if(userEmail instanceof HTMLElement)userEmail.textContent=user.email;const [adminResult,fullPayload]=await Promise.all([adminApi('listar'),rehearsalApi('listarEnsaiosPortal',{forzar:true})]);ensaios=Array.isArray(adminResult.ensaios)?adminResult.ensaios:[];payload=fullPayload;if(userLevel instanceof HTMLElement)userLevel.textContent=adminResult.nivel||'Administración';fillConcerts();fillAnalysisPeople();drawList();if(!keepSelection)closeWorkbench();else if(selected){selected=ensaios.find(x=>x.idEnsaio===rid(selected))||selected;renderSelected();}if(loading instanceof HTMLElement)loading.hidden=true;if(app instanceof HTMLElement)app.hidden=false;}catch(error){if(loading instanceof HTMLElement)loading.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Produciuse un erro inesperado.';}}

function fillConcerts(){const concerts=Array.isArray(payload?.concertos)?payload.concertos:[];const options='<option value="">Sen concerto relacionado</option>'+concerts.map(c=>`<option value="${esc(c.id||'')}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join('');const create=$('#new-concert');if(create)create.innerHTML=options;const program=$('#program-select');if(program)program.innerHTML='<option value="">Escolle un concerto…</option>'+concerts.map(c=>`<option value="${esc(c.id||'')}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join('');}
function fillAnalysisPeople(){const select=$('#analysis-person');if(select)select.innerHTML=[...(payload?.persoas||[])].sort(sortPeople).map(p=>`<option value="${esc(pid(p))}">${esc(personName(p))} · ${esc(voiceLabel(p.voz||''))}</option>`).join('');}

function renderSelected(){if(!selected)return;const title=$('#selected-title'),meta=$('#selected-meta');if(title)title.textContent=`${selected.tipoEnsaio||'Ensaio'} · ${fmt(selected.data)}`;if(meta)meta.textContent=[selected.horaInicio,selected.lugar].filter(Boolean).join(' · ');}
async function openWorkbench(id){selected=ensaios.find(i=>i.idEnsaio===id)||null;if(!selected||selected.cancelado)return;renderSelected();const wb=$('#workbench');if(wb)wb.hidden=false;showPanel('works');await loadDraft();wb?.scrollIntoView({behavior:'smooth',block:'start'});}
function closeWorkbench(){selected=null;draft=null;const wb=$('#workbench');if(wb)wb.hidden=true;}
function showPanel(name){const works=$('#works'),attendance=$('#attendance'),analysis=$('#analysis');if(works)works.hidden=name!=='works';if(attendance)attendance.hidden=name!=='attendance';if(analysis)analysis.hidden=name!=='analysis';[['nav-works','works'],['nav-att','attendance'],['nav-analysis','analysis']].forEach(([id,panel])=>$('#'+id)?.classList.toggle('active',name===panel));}

const work=id=>(payload?.repertorio||[]).find(w=>wid(w)===String(id))||{};
const works=()=>draft?.repertorio||[];
function picker(first=false){if(!draft)return;const q=norm($('#work-search')?.value||''),used=new Set(works().map(r=>String(r.repertorio||r.idRepertorio||''))),rows=(payload?.repertorio||[]).filter(w=>!used.has(wid(w))&&(!q||norm([w.nomeObra,w.nome,w.compositor].join(' ')).includes(q))).sort((a,b)=>String(a.nomeObra||a.nome||'').localeCompare(String(b.nomeObra||b.nome||''),'gl'));const select=$('#work-select');if(select)select.innerHTML='<option value="">Escolle unha obra…</option>'+rows.slice(0,120).map(w=>`<option value="${esc(wid(w))}">${esc([w.nomeObra||w.nome,w.compositor].filter(Boolean).join(' — '))}</option>`).join('');const result=$('#work-result');if(result)result.textContent=q?`${rows.length} resultados para «${$('#work-search')?.value||''}»`:'';if(first&&rows.length&&select)select.value=wid(rows[0]);}
function renderWorks(){if(!draft)return;const rows=[...works()].sort((a,b)=>Number(a.orde||999)-Number(b.orde||999));const wc=$('#works-count');if(wc)wc.textContent=`${rows.length} obras`;const target=$('#works-list');if(target)target.innerHTML=rows.map((r,i)=>{const id=String(r.repertorio||r.idRepertorio||''),w=work(id);return `<article class="work-card" data-work="${esc(id)}"><header><span class="num">${i+1}</span><div><a href="/portal/repertorio/?id=${encodeURIComponent(id)}">${esc(w.nomeObra||w.nome||id)}</a>${w.compositor?`<small>${esc(w.compositor)}</small>`:''}</div><button class="remove" type="button" aria-label="Retirar obra">×</button></header><label><span>Observacións</span><textarea class="notes" rows="2">${esc(r.observacions||'')}</textarea></label><footer><button class="save secondary" type="button">Gardar</button></footer></article>`}).join('')||'<p>Aínda non hai obras neste ensaio.</p>';picker();}
async function loadDraft(){if(!selected)return;const status=$('#works-status');try{if(status)status.textContent='Cargando preparación do ensaio…';const out=await draftApi('obter');draft=out.draft;if(status)status.textContent='';renderWorks();renderAttendance();}catch(error){if(status)status.textContent='⚠ '+(error instanceof Error?error.message:'Non se puido cargar o ensaio.');}}

const attendanceMap=()=>new Map((draft?.asistencias||[]).map(a=>[String(a.persoa||a.idPersoa||''),a]));
function attendanceKind(a={}){const s=norm(a.estadoAsistencia);if(s==='asiste')return'asiste';if(s==='non asiste'&&truthy(a.xustificada))return'xustificada';if(s==='non asiste')return'non';return'';}
function personRow(p){const a=attendanceMap().get(pid(p))||{},k=attendanceKind(a);return `<article class="person-row" data-person="${esc(pid(p))}"><strong>${esc(personName(p))}</strong><div class="att-buttons"><button type="button" data-kind="asiste" class="${k==='asiste'?'active':''}">Asiste</button><button type="button" data-kind="non" class="${k==='non'?'active':''}">Non asiste</button><button type="button" data-kind="xustificada" class="${k==='xustificada'?'active':''}">Non asiste con xustificación</button></div>${k==='xustificada'?`<label class="reason"><span>Motivo da xustificación</span><input data-reason value="${esc(a.motivo||'')}"></label>`:''}</article>`;}
function renderAttendance(){if(!draft)return;const q=norm($('#people-search')?.value||''),people=(payload?.persoas||[]).filter(p=>!q||norm(personName(p)).includes(q)),m=attendanceMap(),target=$('#attendance-list');if(!target)return;if(voice==='Todos'){target.innerHTML=VOICES.map(v=>{const rows=people.filter(p=>norm(p.voz)===norm(v)&&attendanceKind(m.get(pid(p)))==='asiste').sort(sortPeople);return `<section class="voice-group"><header><h3>${voiceLabel(v)}</h3><strong>${rows.length}</strong></header><div class="attendee-names">${rows.map(p=>`<span>${esc(personName(p))}</span>`).join('')||'<p>Sen asistentes rexistrados.</p>'}</div></section>`}).join('');}else{const rows=people.filter(p=>norm(p.voz)===norm(voice)).sort(sortPeople);target.innerHTML=`<section class="voice-group"><header><h3>${voiceLabel(voice)}</h3></header><div class="voice-people">${rows.map(personRow).join('')}</div></section>`;}}
async function saveAttendance(id,kind,motivo){const m=attendanceMap(),cur=m.get(id)||{},value=kind==='asiste'?{estadoAsistencia:'Asiste',xustificada:false,motivo:''}:kind==='xustificada'?{estadoAsistencia:'Non asiste',xustificada:true,motivo:String(motivo??cur.motivo??'')}:{estadoAsistencia:'Non asiste',xustificada:false,motivo:''};m.set(id,{...cur,persoa:id,...value});draft={...draft,asistencias:[...m.values()]};renderAttendance();try{draft=(await draftApi('gardarAsistencia',{idPersoa:id,...value,observacions:String(cur.observacions||'')})).draft;renderAttendance();}catch(error){console.error(error);}}

function historical(){const today=new Date();today.setHours(23,59,59,999);return(payload?.ensaios||[]).filter(e=>!truthy(e.cancelado)&&parseDate(e.data)&&parseDate(e.data)<=today).sort((a,b)=>(parseDate(a.data)?.getTime()||0)-(parseDate(b.data)?.getTime()||0));}
const historyMap=()=>new Map((payload?.asistencias||[]).map(a=>[`${a.ensaio}|${a.persoa}`,a]));
function analysisPeople(){const scope=$('#scope')?.value;if(scope==='person')return(payload?.persoas||[]).filter(p=>pid(p)===$('#analysis-person')?.value);if(scope==='voice')return(payload?.persoas||[]).filter(p=>norm(p.voz)===norm($('#analysis-voice')?.value));return payload?.persoas||[];}
function runAnalysis(){const from=parseDate($('#from')?.value),to=parseDate($('#to')?.value),scope=$('#scope')?.value,people=analysisPeople(),m=historyMap(),rehearsals=historical().filter(e=>(!from||parseDate(e.data)>=from)&&(!to||parseDate(e.data)<=to));const rows=rehearsals.map(e=>{if(scope==='person'){const p=people[0],a=p?m.get(`${rid(e)}|${pid(p)}`):null,k=attendanceKind(a),label=k==='asiste'?'Asiste':k==='xustificada'?'Non asiste con xustificación':k==='non'?'Non asiste':'Sen rexistro';return `<tr><td>${esc(short(e.data))}</td><td>${esc(label)}</td><td>${esc(a?.motivo||'')}</td></tr>`;}let yes=0,no=0,justified=0,denom=0;people.forEach(p=>{const k=attendanceKind(m.get(`${rid(e)}|${pid(p)}`));if(k){denom++;if(k==='asiste')yes++;else if(k==='xustificada')justified++;else no++;}});return `<tr><td>${esc(short(e.data))}</td><td>${yes}</td><td>${no}</td><td>${justified}</td><td>${denom?Math.round(yes*100/denom):0}%</td></tr>`;}).join('');const by=$('#by-rehearsal');if(by)by.innerHTML=scope==='person'?`<div class="table-wrap"><table><thead><tr><th>Data</th><th>Estado</th><th>Motivo</th></tr></thead><tbody>${rows}</tbody></table></div>`:`<div class="table-wrap"><table><thead><tr><th>Data</th><th>Asisten</th><th>Non asisten</th><th>Xustificadas</th><th>%</th></tr></thead><tbody>${rows}</tbody></table></div>`;const rank=people.map(p=>{let yes=0,no=0,justified=0,denom=0;rehearsals.forEach(e=>{const k=attendanceKind(m.get(`${rid(e)}|${pid(p)}`));if(k){denom++;if(k==='asiste')yes++;else if(k==='xustificada')justified++;else no++;}});return{p,yes,no,justified,pct:denom?Math.round(yes*100/denom):0};}).sort((a,b)=>b.pct-a.pct||b.yes-a.yes||sortPeople(a.p,b.p));rankingData=`<div class="table-wrap"><table><thead><tr><th>#</th><th>Coralista</th><th>Corda</th><th>Asiste</th><th>Ausencias</th><th>%</th></tr></thead><tbody>${rank.map((r,i)=>`<tr><td>${i+1}</td><td>${esc(personName(r.p))}</td><td>${esc(voiceLabel(r.p.voz||''))}</td><td>${r.yes}</td><td>${r.no+r.justified}</td><td>${r.pct}%</td></tr>`).join('')}</tbody></table></div>`;const ranking=$('#ranking');if(ranking)ranking.innerHTML=rankingData;const block=$('#ranking-block');if(block)block.hidden=true;const toggle=$('#toggle-ranking');if(toggle)toggle.textContent='Ver ranking de asistencias';}

function openDate(item){selected=item;const name=$('#date-name'),input=$('#new-date'),status=$('#date-status');if(name)name.textContent=`${item.tipoEnsaio||'Ensaio'} · ${fmt(item.data)}`;if(input instanceof HTMLInputElement)input.value=String(item.data||'').slice(0,10);if(status)status.textContent='';dateDialog?.showModal();}
function openCancel(item){selected=item;const name=$('#cancel-name'),status=$('#cancel-status');if(name)name.textContent=`${item.tipoEnsaio||'Ensaio'} · ${fmt(item.data)}`;if(status)status.textContent='';cancelDialog?.showModal();}
function openDelete(item){selected=item;const name=$('#delete-name'),relations=$('#delete-relations'),confirm=$('#delete-confirm'),submit=$('#delete-submit'),status=$('#delete-status');if(name)name.textContent=`${item.tipoEnsaio||'Ensaio'} · ${fmt(item.data)}`;if(relations)relations.textContent=`Este ensaio ten ${Number(item.obras||0)} obra${Number(item.obras||0)===1?'':'s'} vinculada${Number(item.obras||0)===1?'':'s'} e ${Number(item.asistencias||0)} rexistro${Number(item.asistencias||0)===1?'':'s'} de asistencia.`;if(confirm instanceof HTMLInputElement)confirm.value='';if(submit instanceof HTMLButtonElement)submit.disabled=true;if(status)status.textContent='';deleteDialog?.showModal();}

list?.addEventListener('click',async event=>{const target=event.target;if(!(target instanceof HTMLButtonElement))return;const item=ensaios.find(i=>i.idEnsaio===target.dataset.id);if(!item)return;if(target.classList.contains('manage-rehearsal'))await openWorkbench(item.idEnsaio);else if(target.classList.contains('change-date'))openDate(item);else if(target.classList.contains('cancel-rehearsal'))openCancel(item);else if(target.classList.contains('delete-rehearsal'))openDelete(item);});
filter?.addEventListener('change',drawList);$('#retry')?.addEventListener('click',()=>loadAll());$('#admin-ensaios-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});$('#close-workbench')?.addEventListener('click',closeWorkbench);
$('#nav-works')?.addEventListener('click',()=>showPanel('works'));$('#nav-att')?.addEventListener('click',()=>{voice='Todos';document.querySelectorAll('[data-voice]').forEach(b=>b.classList.toggle('active',b.getAttribute('data-voice')==='Todos'));renderAttendance();showPanel('attendance');});$('#nav-analysis')?.addEventListener('click',()=>showPanel('analysis'));

$('#new-rehearsal')?.addEventListener('click',()=>{const status=$('#new-status');if(status)status.textContent='';newDialog?.showModal();});
const closeNew=()=>newDialog?.close(),closeDate=()=>dateDialog?.close(),closeCancel=()=>cancelDialog?.close(),closeDelete=()=>deleteDialog?.close();
$('#new-close')?.addEventListener('click',closeNew);$('#new-cancel')?.addEventListener('click',closeNew);$('#date-close')?.addEventListener('click',closeDate);$('#date-cancel')?.addEventListener('click',closeDate);$('#cancel-close')?.addEventListener('click',closeCancel);$('#cancel-back')?.addEventListener('click',closeCancel);$('#delete-close')?.addEventListener('click',closeDelete);$('#delete-back')?.addEventListener('click',closeDelete);
$('#delete-confirm')?.addEventListener('input',event=>{const input=event.currentTarget,submit=$('#delete-submit');if(input instanceof HTMLInputElement&&submit instanceof HTMLButtonElement)submit.disabled=input.value.trim().toUpperCase()!=='ELIMINAR';});

$('#new-form')?.addEventListener('submit',async event=>{event.preventDefault();const status=$('#new-status');try{if(status)status.textContent='Creando ensaio…';await rehearsalApi('gardarEnsaio',{data:$('#new-date-create')?.value||'',horaInicio:$('#new-start')?.value||'',horaFin:$('#new-end')?.value||'',lugar:$('#new-place')?.value||'',tipoEnsaio:$('#new-type')?.value||'',concerto:$('#new-concert')?.value||'',descricion:$('#new-description')?.value||'',observacions:$('#new-notes')?.value||'',cancelado:false});closeNew();await loadAll();}catch(error){if(status)status.textContent=error instanceof Error?error.message:'Non foi posible crear o ensaio.';}});
$('#date-form')?.addEventListener('submit',async event=>{event.preventDefault();const input=$('#new-date'),status=$('#date-status');if(!selected||!(input instanceof HTMLInputElement)||!input.value)return;try{if(status)status.textContent='Gardando…';await adminApi('cambiarData',{idEnsaio:selected.idEnsaio,data:input.value});closeDate();await loadAll();}catch(error){if(status)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar a data.';}});
$('#cancel-form')?.addEventListener('submit',async event=>{event.preventDefault();const status=$('#cancel-status');if(!selected)return;try{if(status)status.textContent='Gardando…';await adminApi('darBaixa',{idEnsaio:selected.idEnsaio});closeCancel();await loadAll();}catch(error){if(status)status.textContent=error instanceof Error?error.message:'Non foi posible dar de baixa o ensaio.';}});
$('#delete-form')?.addEventListener('submit',async event=>{event.preventDefault();const status=$('#delete-status'),confirm=$('#delete-confirm'),submit=$('#delete-submit');if(!selected||!(confirm instanceof HTMLInputElement)||confirm.value.trim().toUpperCase()!=='ELIMINAR')return;try{if(status)status.textContent='Eliminando ensaio e relacións asociadas…';if(submit instanceof HTMLButtonElement)submit.disabled=true;await deleteRequest(selected.idEnsaio);closeDelete();closeWorkbench();await loadAll();}catch(error){if(status)status.textContent=error instanceof Error?error.message:'Non foi posible eliminar o ensaio.';if(submit instanceof HTMLButtonElement)submit.disabled=false;}});

$('#work-search')?.addEventListener('input',()=>picker());$('#work-search')?.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();picker(true);}});$('#work-search-btn')?.addEventListener('click',()=>picker(true));
$('#add-work')?.addEventListener('click',async()=>{const select=$('#work-select'),id=select?.value;if(!id||!selected)return;draft=(await draftApi('gardarObra',{idRepertorio:id,orde:works().length+1,tipoTraballo:'',desde:'',ata:'',observacions:''})).draft;if($('#work-search'))$('#work-search').value='';renderWorks();});
document.addEventListener('click',async event=>{const target=event.target;if(!(target instanceof HTMLElement))return;const voiceButton=target.closest('[data-voice]');if(voiceButton){voice=voiceButton.getAttribute('data-voice')||'Todos';document.querySelectorAll('[data-voice]').forEach(b=>b.classList.toggle('active',b===voiceButton));renderAttendance();return;}const attendanceButton=target.closest('[data-kind]');if(attendanceButton){const row=attendanceButton.closest('.person-row');if(row&&voice!=='Todos')await saveAttendance(row.getAttribute('data-person'),attendanceButton.getAttribute('data-kind'));return;}const remove=target.closest('.remove');if(remove){const row=remove.closest('.work-card'),id=row?.getAttribute('data-work');if(id){draft=(await draftApi('eliminarObra',{idRepertorio:id})).draft;renderWorks();}return;}const save=target.closest('.save');if(save){const row=save.closest('.work-card'),id=row?.getAttribute('data-work'),old=works().find(x=>String(x.repertorio||x.idRepertorio||'')===id)||{};if(id){draft=(await draftApi('gardarObra',{idRepertorio:id,orde:old.orde||1,tipoTraballo:'',desde:'',ata:'',observacions:row.querySelector('.notes')?.value||''})).draft;renderWorks();}}});
