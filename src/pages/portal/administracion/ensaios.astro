$('#scope')?.addEventListener('change',event=>{const value=event.target?.value;const vw=$('#voice-wrap'),pw=$('#person-wrap');if(vw)vw.hidden=value!=='voice';if(pw)pw.hidden=value!=='person';});$('#consult')?.addEventListener('click',runAnalysis);$('#toggle-ranking')?.addEventListener('click',()=>{const block=$('#ranking-block'),button=$('#toggle-ranking');if(!block||!button)return;block.hidden=!block.hidden;button.textContent=block.hidden?'Ver ranking de asistencias':'Ocultar ranking de asistencias';});

loadAll();
</script>

