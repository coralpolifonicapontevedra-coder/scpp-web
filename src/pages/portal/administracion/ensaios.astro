---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-logout" />
    <main class="admin-main">
      <header class="page-head">
        <div><span class="kicker">Administración</span><h1>Administración de ensaios</h1><p>Planificación, repertorio e asistencia cun único fluxo R2 → Sheet.</p></div>
        <div class="account"><small>Conta identificada</small><strong id="user-email">—</strong><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></div>
      </header>
      <AdministracionNav active="ensaios" />

      <section id="loading" class="box">Cargando ensaios de Producción…</section>
      <section id="error" class="box error" hidden><strong>Non foi posible abrir Ensaios</strong><p id="error-text"></p><button id="retry" class="secondary">Tentar de novo</button></section>

      <section id="app" hidden>
        <div class="toolbar">
          <label>Mostrar<select id="filter"><option value="activos">Ensaios activos</option><option value="todos">Todos</option><option value="baixa">Dados de baixa</option></select></label>
          <span id="count"></span>
          <button id="new-btn" class="primary">+ Novo ensaio</button>
        </div>
        <div id="list" class="list"></div>
      </section>
    </main>
  </div>

  <dialog id="new-dialog" class="dialog-wide"><form id="new-form">
    <header><div><small>Planificación</small><h2>Novo ensaio</h2></div><button type="button" data-close="new-dialog">×</button></header>
    <div class="grid">
      <label>Data<input name="data" type="date" required /></label>
      <label>Hora de inicio<input name="horaInicio" type="time" required /></label>
      <label>Hora de fin<input name="horaFin" type="time" /></label>
      <label>Lugar<input name="lugar" value="Centro Social Sur - Luís Braille 40" /></label>
      <label>Tipo de ensaio<input name="tipoEnsaio" value="Ordinario" required /></label>
      <label>Concerto relacionado<select name="concerto" id="new-concert"><option value="">Sen concerto asociado</option></select></label>
      <label class="span2">Descrición<textarea name="descricion" rows="3"></textarea></label>
      <label class="span2">Observacións<textarea name="observacions" rows="3"></textarea></label>
    </div>
    <p id="new-status" class="status"></p>
    <footer><button type="button" class="secondary" data-close="new-dialog">Cancelar</button><button type="submit" class="primary">Gardar ensaio</button></footer>
  </form></dialog>

  <dialog id="manage-dialog" class="manage-dialog"><section class="manage-shell">
    <header><div><small>Xestión do ensaio</small><h2 id="manage-title">Ensaio</h2><p id="manage-meta"></p></div><button type="button" data-close="manage-dialog">×</button></header>
    <nav class="tabs"><button class="is-active" data-panel="obras">Obras</button><button data-panel="asistencia">Asistencia</button><button data-panel="avisos">Avisos <span id="notice-badge"></span></button></nav>

    <section id="panel-obras" class="panel">
      <div class="row-tools"><select id="program-concert"><option value="">Cargar programa dun concerto…</option></select><button id="program-btn" class="secondary">Cargar programa</button></div>
      <div class="row-tools"><input id="work-search" type="search" placeholder="Buscar obra ou compositor…" /><select id="work-select"><option value="">Escolle unha obra…</option></select><button id="work-add" class="primary">Engadir obra</button></div>
      <div class="section-head"><h3>Obras a traballar</h3><strong id="works-count">0</strong></div>
      <p id="works-status" class="status"></p><div id="works-list" class="rows"></div>
    </section>

    <section id="panel-asistencia" class="panel" hidden>
      <div class="voices"><button class="is-active" data-voice="Todos">Todos</button><button data-voice="Soprano">Sopranos</button><button data-voice="Contralto">Contraltos</button><button data-voice="Tenor">Tenores</button><button data-voice="Baixo">Baixos</button></div>
      <div class="section-head"><h3>Control de asistencia</h3><strong id="attendance-count">0</strong></div>
      <p id="attendance-status" class="status"></p><div id="attendance-list" class="rows"></div>
    </section>

    <section id="panel-avisos" class="panel" hidden>
      <div class="section-head"><h3>Avisos de non asistencia</h3><strong id="notice-count">0</strong></div>
      <p id="notice-status" class="status"></p><div id="notice-list" class="rows"></div>
    </section>

    <div class="finalbar"><span id="final-status">Sen cambios pendentes</span><div><button id="reload-sheet" class="secondary">Recargar desde Sheet</button><button id="finalize" class="primary" disabled>Finalizar ensaio</button></div></div>
  </section></dialog>

  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" data-close="date-dialog">×</button></header><label>Nova data<input id="date-input" type="date" required /></label><p id="date-status" class="status"></p><footer><button type="button" class="secondary" data-close="date-dialog">Cancelar</button><button class="primary">Gardar</button></footer></form></dialog>
  <dialog id="cancel-dialog"><form id="cancel-form"><header><h2>Dar de baixa</h2><button type="button" data-close="cancel-dialog">×</button></header><p>O ensaio quedará cancelado, sen borrar os seus datos.</p><p id="cancel-status" class="status"></p><footer><button type="button" class="secondary" data-close="cancel-dialog">Cancelar</button><button class="danger">Dar de baixa</button></footer></form></dialog>
  <dialog id="delete-dialog"><form id="delete-form"><header><h2>Eliminar ensaio</h2><button type="button" data-close="delete-dialog">×</button></header><p class="warning">Eliminaranse o ensaio e as súas obras e asistencias asociadas.</p><label>Escribe ELIMINAR para confirmar<input id="delete-confirm" autocomplete="off" /></label><p id="delete-status" class="status"></p><footer><button type="button" class="secondary" data-close="delete-dialog">Cancelar</button><button id="delete-submit" class="danger" disabled>Eliminar definitivamente</button></footer></form></dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';

  const $ = (s) => document.querySelector(s);
  const clean = (v = '') => String(v ?? '').trim();
  const norm = (v = '') => clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const esc = (v = '') => String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const idEnsaio = (r = {}) => clean(r.idEnsaio || r.ensaio || r.Id_Ensaio || r.id);
  const idPersoa = (r = {}) => clean(r.persoa || r.idPersoa || r.Id_Persoa || r.id || r.RowID);
  const idObra = (r = {}) => clean(r.repertorio || r.idRepertorio || r.Id_Repertorio || r.IdRepertorio || r.id || r.Id);
  const bool = (v) => v === true || ['true','1','si','sí','yes','x'].includes(clean(v).toLowerCase());
  const nome = (p = {}) => clean(p.nomeCompleto || p.NomeCompleto) || [p.nome || p.Nome,p.primeiroApelido || p.PrimeiroApelido,p.segundoApelido || p.SegundoApelido].map(clean).filter(Boolean).join(' ');
  const chavePersoa = (p = {}) => [p.primeiroApelido || p.PrimeiroApelido,p.segundoApelido || p.SegundoApelido,p.nome || p.Nome,nome(p)].map(norm).join('|');
  const fmt = (v) => { const d = new Date(`${clean(v).slice(0,10)}T12:00:00`); return Number.isNaN(d.getTime()) ? clean(v) : new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d); };

  let payload = null;
  let ensaios = [];
  let selected = null;
  let draft = null;
  let notices = [];
  let busy = false;
  let selectedVoice = 'Todos';

  async function api(accion, extra = {}) {
    const user = auth.currentUser;
    if (!user?.email) throw new Error('A sesión non está activa.');
    const idToken = await user.getIdToken();
    const response = await fetch('/api/ensaios-admin-v4', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({idToken,accion,...extra}) });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) {
      const error = new Error(result?.erro || `Erro HTTP ${response.status}`);
      Object.assign(error,{code:result?.codigo || ''});
      throw error;
    }
    return result;
  }

  function preparar(index) {
    const a = new Map(), w = new Map();
    (index?.asistencias || []).forEach((r) => { const id=idEnsaio(r); if(id)a.set(id,(a.get(id)||0)+1); });
    (index?.ensaiosRepertorio || []).forEach((r) => { const id=idEnsaio(r); if(id)w.set(id,(w.get(id)||0)+1); });
    return (index?.ensaios || []).map((r) => { const id=idEnsaio(r); return { idEnsaio:id, data:clean(r.data||r.Data).slice(0,10), horaInicio:clean(r.horaInicio||r.HoraInicio), horaFin:clean(r.horaFin||r.HoraFin), lugar:clean(r.lugar||r.Lugar), tipoEnsaio:clean(r.tipoEnsaio||r.TipoEnsaio)||'Ensaio', concerto:clean(r.concerto||r.Concerto), concertoNome:clean(r.concertoNome||r.ConcertoNome), descricion:clean(r.descricion||r.Descricion), observacions:clean(r.observacions||r.Observacions), cancelado:bool(r.cancelado??r.Cancelado), obras:w.get(id)||0, asistencias:a.get(id)||0 }; }).filter(r=>r.idEnsaio).sort((x,y)=>y.data.localeCompare(x.data));
  }
  function filtered() { const mode = $('#filter')?.value || 'activos'; return ensaios.filter(r => mode==='todos' || (mode==='baixa' ? r.cancelado : !r.cancelado)); }
  function draw() {
    const list=$('#list'), rows=filtered(); if(!(list instanceof HTMLElement))return;
    const count=$('#count'); if(count instanceof HTMLElement)count.textContent=`${rows.length} ensaio${rows.length===1?'':'s'}`;
    list.innerHTML = rows.length ? rows.map(r=>`<article class="card ${r.cancelado?'cancelled':''}"><div class="field-pair"><small>Data</small><strong>${esc(fmt(r.data))}</strong></div><div><h2>${esc(r.tipoEnsaio)}</h2><p>${esc([r.horaInicio,r.lugar].filter(Boolean).join(' · '))}</p><span>${r.obras} obras · ${r.asistencias} asistencias</span></div><div><b>${r.cancelado?'Baixa':'Activo'}</b></div><div class="actions">${r.cancelado?'':`<button class="primary manage" data-id="${esc(r.idEnsaio)}">Xestionar</button><button class="secondary date" data-id="${esc(r.idEnsaio)}">Cambiar data</button><button class="secondary cancel" data-id="${esc(r.idEnsaio)}">Dar de baixa</button>`}<button class="danger delete" data-id="${esc(r.idEnsaio)}">Eliminar</button></div></article>`).join('') : '<div class="box">Non hai ensaios neste filtro.</div>';
  }
  function fillConcerts() {
    const options = (payload?.concertos || []).map(c=>({id:clean(c.id||c.idConcerto),name:clean(c.nome||c.nomeConcerto||c.titulo||c.id)})).filter(c=>c.id);
    ['#new-concert','#program-concert'].forEach(sel=>{ const el=$(sel); if(el instanceof HTMLSelectElement){ const first=sel==='#new-concert'?'Sen concerto asociado':'Cargar programa dun concerto…'; el.innerHTML=`<option value="">${first}</option>`+options.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join(''); } });
  }
  function workName(id) {
    const wanted=clean(id);
    const r=(payload?.repertorio||[]).find(x=>idObra(x)===wanted);
    if(!r)return `Obra ${wanted}`;
    const title=clean(r.nomeObra||r.NomeObra||r.nome||r.Nome||r.titulo||r.Titulo||r.Título||r.obra||r.Obra);
    const composer=clean(r.compositor||r.Compositor||r.autor||r.Autor);
    return title ? `${title}${composer?` · ${composer}`:''}` : `Obra ${wanted}`;
  }
  function updateWorkPicker() { const s=$('#work-search'), sel=$('#work-select'); if(!(sel instanceof HTMLSelectElement))return; const q=norm(s?.value||''); const used=new Set((draft?.repertorio||[]).map(idObra)); const rows=(payload?.repertorio||[]).filter(r=>!used.has(idObra(r))).filter(r=>!q || norm(`${r.nomeObra||r.NomeObra||r.nome||r.Nome||r.titulo||r.Titulo||''} ${r.compositor||r.Compositor||''}`).includes(q)).slice(0,150); sel.innerHTML='<option value="">Escolle unha obra…</option>'+rows.map(r=>`<option value="${esc(idObra(r))}">${esc(workName(idObra(r)))}</option>`).join(''); }
  function renderWorks() { const rows=$('#works-list'), count=$('#works-count'); const works=[...(draft?.repertorio||[])].sort((a,b)=>(Number(a.orde)||999)-(Number(b.orde)||999)); if(count instanceof HTMLElement)count.textContent=String(works.length); if(rows instanceof HTMLElement)rows.innerHTML=works.length?works.map((r,i)=>`<div class="item"><span class="num">${i+1}</span><div><strong>${esc(workName(idObra(r)))}</strong></div><button class="secondary remove-work" data-work="${esc(idObra(r))}">Quitar</button></div>`).join(''):'<p class="empty">Sen obras.</p>'; updateWorkPicker(); }
  function attState(row) { if(!row)return ''; if(clean(row.estadoAsistencia).toLowerCase()==='asiste')return 'asiste'; return bool(row.xustificada)?'xustificada':'non'; }
  function renderAttendance() { const rows=$('#attendance-list'), count=$('#attendance-count'); if(!(rows instanceof HTMLElement))return; const map=new Map((draft?.asistencias||[]).map(r=>[idPersoa(r),r])); let people=[...(payload?.persoas||[])]; if(selectedVoice!=='Todos')people=people.filter(p=>norm(p.voz||p.Voz)===norm(selectedVoice)); people.sort((a,b)=>chavePersoa(a).localeCompare(chavePersoa(b),'gl',{sensitivity:'base'})); if(count instanceof HTMLElement)count.textContent=String(people.length); rows.innerHTML=people.map(p=>{ const id=idPersoa(p), state=attState(map.get(id)); return `<div class="person"><div><strong>${esc(nome(p))}</strong><small>${esc(clean(p.voz||p.Voz))}</small></div><div class="att"><button data-att="asiste" data-person="${esc(id)}" class="${state==='asiste'?'chosen':''}">Asiste</button><button data-att="non" data-person="${esc(id)}" class="${state==='non'?'chosen negative':''}">Non asiste</button><button data-att="xustificada" data-person="${esc(id)}" class="${state==='xustificada'?'chosen justified':''}">Xustificada</button></div></div>`; }).join(''); }
  function renderNotices() { const list=$('#notice-list'), count=$('#notice-count'), badge=$('#notice-badge'); if(count instanceof HTMLElement)count.textContent=String(notices.length); if(badge instanceof HTMLElement)badge.textContent=notices.length?`(${notices.length})`:''; if(list instanceof HTMLElement)list.innerHTML=notices.length?notices.map(n=>`<div class="item"><div><strong>${esc(n.nome||n.persoa)}</strong><small>${esc([n.voz,n.motivo].filter(Boolean).join(' · '))}</small></div><button class="secondary accept-notice" data-person="${esc(n.persoa||n.idPersoa)}" ${n.aceptadoEnBorrador?'disabled':''}>${n.aceptadoEnBorrador?'Aceptado':'Aceptar'}</button></div>`).join(''):'<p class="empty">Non hai avisos pendentes.</p>'; }
  function updateFinal(text) { const st=$('#final-status'), btn=$('#finalize'); if(st instanceof HTMLElement)st.textContent=text || (draft?.dirty?'Cambios gardados en R2 · pendentes de finalizar':'Sen cambios pendentes'); if(btn instanceof HTMLButtonElement)btn.disabled=busy || draft?.dirty!==true; }
  function renderManage() { renderWorks(); renderAttendance(); renderNotices(); updateFinal(''); }

  async function load(force=false) {
    const loading=$('#loading'), error=$('#error'), app=$('#app'); if(loading instanceof HTMLElement)loading.hidden=false; if(error instanceof HTMLElement)error.hidden=true; if(app instanceof HTMLElement)app.hidden=true;
    try { const user=await waitForPortalUser(); if(!user?.email)throw new Error('Non hai unha sesión válida.'); const result=await api('listar',{forzar:force}); payload=result.index; ensaios=preparar(payload); const ue=$('#user-email'), ul=$('#user-level'); if(ue instanceof HTMLElement)ue.textContent=user.email; if(ul instanceof HTMLElement)ul.textContent=result.nivel||'lectura'; fillConcerts(); draw(); if(loading instanceof HTMLElement)loading.hidden=true; if(app instanceof HTMLElement)app.hidden=false; }
    catch(e){ if(loading instanceof HTMLElement)loading.hidden=true; if(error instanceof HTMLElement)error.hidden=false; const t=$('#error-text'); if(t instanceof HTMLElement)t.textContent=e instanceof Error?e.message:String(e); }
  }
  async function openManage(item) { selected=item; busy=true; const d=$('#manage-dialog'); if(d instanceof HTMLDialogElement)d.showModal(); updateFinal('Cargando estado confirmado desde Sheet…'); try { const result=await api('abrir',{idEnsaio:item.idEnsaio}); payload=result.index; draft=result.draft; notices=Array.isArray(result.avisos)?result.avisos:[]; const title=$('#manage-title'), meta=$('#manage-meta'); if(title instanceof HTMLElement)title.textContent=`${item.tipoEnsaio} · ${fmt(item.data)}`; if(meta instanceof HTMLElement)meta.textContent=[item.horaInicio,item.lugar].filter(Boolean).join(' · '); if(result.conflito)updateFinal('Hai cambios pendentes baseados nun estado anterior. Recarga desde Sheet antes de finalizar.'); renderManage(); } catch(e){ updateFinal(e instanceof Error?e.message:String(e)); } finally { busy=false; updateFinal(''); } }

  $('#retry')?.addEventListener('click',()=>void load(true));
  $('#filter')?.addEventListener('change',draw);
  $('#new-btn')?.addEventListener('click',()=>{ const f=$('#new-form'); if(f instanceof HTMLFormElement)f.reset(); const d=$('#new-dialog'); if(d instanceof HTMLDialogElement)d.showModal(); });
  document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>{ const id=b.getAttribute('data-close'); const d=id?document.getElementById(id):null; if(d instanceof HTMLDialogElement)d.close(); }));
  $('#new-form')?.addEventListener('submit',async e=>{ e.preventDefault(); const form=e.currentTarget, st=$('#new-status'); if(!(form instanceof HTMLFormElement))return; try{ if(st instanceof HTMLElement)st.textContent='Gardando ensaio…'; const result=await api('crear',Object.fromEntries(new FormData(form).entries())); payload=result.index; ensaios=preparar(payload); fillConcerts(); draw(); const d=$('#new-dialog'); if(d instanceof HTMLDialogElement)d.close(); if(result.programaPendente)window.alert('O ensaio foi creado. O programa do concerto quedou no borrador R2: abre Xestionar e pulsa Finalizar ensaio para confirmalo na Sheet.'); }catch(err){ if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err); } });
  $('#list')?.addEventListener('click',e=>{ const b=e.target; if(!(b instanceof HTMLButtonElement))return; const item=ensaios.find(r=>r.idEnsaio===b.dataset.id); if(!item)return; if(b.classList.contains('manage')){void openManage(item);return;} selected=item; if(b.classList.contains('date')){const i=$('#date-input'),d=$('#date-dialog');if(i instanceof HTMLInputElement)i.value=item.data;if(d instanceof HTMLDialogElement)d.showModal();} if(b.classList.contains('cancel')){const d=$('#cancel-dialog');if(d instanceof HTMLDialogElement)d.showModal();} if(b.classList.contains('delete')){const i=$('#delete-confirm'),s=$('#delete-submit'),d=$('#delete-dialog'),st=$('#delete-status');if(i instanceof HTMLInputElement)i.value='';if(s instanceof HTMLButtonElement)s.disabled=true;if(st instanceof HTMLElement)st.textContent='';if(d instanceof HTMLDialogElement)d.showModal();} });
  $('#date-form')?.addEventListener('submit',async e=>{e.preventDefault();const i=$('#date-input'),st=$('#date-status');if(!selected||!(i instanceof HTMLInputElement))return;try{const r=await api('cambiarData',{idEnsaio:selected.idEnsaio,data:i.value});payload=r.index;ensaios=preparar(payload);draw();const d=$('#date-dialog');if(d instanceof HTMLDialogElement)d.close();}catch(err){if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});
  $('#cancel-form')?.addEventListener('submit',async e=>{e.preventDefault();const st=$('#cancel-status');if(!selected)return;try{const r=await api('darBaixa',{idEnsaio:selected.idEnsaio});payload=r.index;ensaios=preparar(payload);draw();const d=$('#cancel-dialog');if(d instanceof HTMLDialogElement)d.close();}catch(err){if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});
  $('#delete-confirm')?.addEventListener('input',e=>{const i=e.target,s=$('#delete-submit');if(s instanceof HTMLButtonElement)s.disabled=!(i instanceof HTMLInputElement&&i.value.trim().toUpperCase()==='ELIMINAR');});
  $('#delete-form')?.addEventListener('submit',async e=>{e.preventDefault();const st=$('#delete-status');if(!selected)return;try{if(st instanceof HTMLElement)st.textContent='Eliminando na Sheet…';const r=await api('eliminar',{idEnsaio:selected.idEnsaio});if(r.index){payload=r.index;ensaios=preparar(payload);}else await load(true);draw();const d=$('#delete-dialog');if(d instanceof HTMLDialogElement)d.close();if(r.r2Pendente)window.alert(r.aviso||'Eliminado da Sheet; R2 rexenerarase na seguinte carga.');}catch(err){if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});

  document.querySelectorAll('[data-panel]').forEach(b=>b.addEventListener('click',()=>{const p=b.getAttribute('data-panel');document.querySelectorAll('[data-panel]').forEach(x=>x.classList.toggle('is-active',x===b));['obras','asistencia','avisos'].forEach(n=>{const el=$(`#panel-${n}`);if(el instanceof HTMLElement)el.hidden=n!==p;});}));
  document.querySelectorAll('[data-voice]').forEach(b=>b.addEventListener('click',()=>{selectedVoice=b.getAttribute('data-voice')||'Todos';document.querySelectorAll('[data-voice]').forEach(x=>x.classList.toggle('is-active',x===b));renderAttendance();}));
  $('#work-search')?.addEventListener('input',updateWorkPicker);
  $('#work-add')?.addEventListener('click',async()=>{const s=$('#work-select'),st=$('#works-status');if(!(s instanceof HTMLSelectElement)||!s.value||!selected||busy)return;try{const r=await api('gardarObra',{idEnsaio:selected.idEnsaio,idRepertorio:s.value});draft=r.draft;renderWorks();updateFinal('');if(st instanceof HTMLElement)st.textContent='Obra gardada no borrador R2.';}catch(err){if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});
  $('#works-list')?.addEventListener('click',async e=>{const b=e.target;if(!(b instanceof HTMLButtonElement)||!b.classList.contains('remove-work')||!selected)return;try{const r=await api('quitarObra',{idEnsaio:selected.idEnsaio,idRepertorio:b.dataset.work});draft=r.draft;renderWorks();updateFinal('');}catch(err){const st=$('#works-status');if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});
  $('#program-btn')?.addEventListener('click',async()=>{const s=$('#program-concert'),st=$('#works-status');if(!(s instanceof HTMLSelectElement)||!s.value||!selected)return;try{const r=await api('cargarPrograma',{idEnsaio:selected.idEnsaio,idConcerto:s.value});draft=r.draft;renderWorks();updateFinal('');if(st instanceof HTMLElement)st.textContent='Programa cargado no borrador R2.';}catch(err){if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});
  $('#attendance-list')?.addEventListener('click',async e=>{const b=e.target;if(!(b instanceof HTMLButtonElement)||!b.dataset.att||!selected)return;const pid=clean(b.dataset.person), map=new Map((draft?.asistencias||[]).map(r=>[idPersoa(r),r])), current=attState(map.get(pid)), clicked=clean(b.dataset.att), next=current===clicked?'':clicked;let motivo='';if(next==='xustificada')motivo=window.prompt('Motivo da xustificación (opcional):','')||'';try{const r=await api('gardarAsistencia',{idEnsaio:selected.idEnsaio,idPersoa:pid,estadoAsistencia:next===''?'':next==='asiste'?'Asiste':'Non asiste',xustificada:next==='xustificada',motivo,observacions:''});draft=r.draft;renderAttendance();updateFinal('');}catch(err){const st=$('#attendance-status');if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});
  $('#notice-list')?.addEventListener('click',async e=>{const b=e.target;if(!(b instanceof HTMLButtonElement)||!b.classList.contains('accept-notice')||!selected)return;const n=notices.find(x=>clean(x.persoa||x.idPersoa)===clean(b.dataset.person));if(!n)return;try{const r=await api('aceptarAviso',{idEnsaio:selected.idEnsaio,idPersoa:clean(n.persoa||n.idPersoa),xustificada:bool(n.xustificada),motivo:clean(n.motivo),observacions:clean(n.observacions)});draft=r.draft;n.aceptadoEnBorrador=true;renderAttendance();renderNotices();updateFinal('');}catch(err){const st=$('#notice-status');if(st instanceof HTMLElement)st.textContent=err instanceof Error?err.message:String(err);}});
  $('#reload-sheet')?.addEventListener('click',async()=>{if(!selected||busy)return;if(draft?.dirty&&!window.confirm('Descartar os cambios pendentes de R2 e recargar desde Sheet?'))return;busy=true;updateFinal('Recargando desde Sheet…');try{const r=await api('descartar',{idEnsaio:selected.idEnsaio});payload=r.index;draft=r.draft;notices=r.avisos||[];ensaios=preparar(payload);draw();renderManage();updateFinal('Estado actualizado desde Sheet');}catch(err){updateFinal(err instanceof Error?err.message:String(err));}finally{busy=false;}});
  $('#finalize')?.addEventListener('click',async()=>{if(!selected||!draft?.dirty||busy)return;busy=true;updateFinal('Sincronizando obras e asistencias coa Sheet nunha única operación…');try{const r=await api('finalizar',{idEnsaio:selected.idEnsaio});draft=r.draft||{...draft,dirty:false};if(r.index){payload=r.index;ensaios=preparar(payload);draw();}renderWorks();renderAttendance();updateFinal(r.r2Pendente?'Sheet sincronizada. R2 rexenerarase automaticamente.':'Ensaio finalizado e sincronizado con Sheet');if(r.r2Pendente)window.alert(r.aviso||'A Sheet quedou sincronizada; R2 rexenerarase na seguinte carga.');}catch(err){updateFinal(err instanceof Error?err.message:String(err));}finally{busy=false;const btn=$('#finalize');if(btn instanceof HTMLButtonElement)btn.disabled=draft?.dirty!==true;}});

  const logout=$('#admin-ensaios-logout'); if(logout instanceof HTMLElement)logout.addEventListener('click',async e=>{e.preventDefault();await closePortalSession();window.location.href='/portal/';});
  void load(false);
</script>

