---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Análise de asistencia · Ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-analise-logout" />
    <main class="analysis-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Administración · Ensaios</span>
          <h1>Análise de asistencia</h1>
          <p>Consulta varios ensaios entre dúas datas e combina filtros por corda, coralista, tipo de ensaio ou concerto relacionado.</p>
        </div>
        <div class="account-card">
          <span><small>Conta identificada</small><strong id="user-email">—</strong></span>
          <span><small>Nivel de acceso</small><strong>Administración</strong></span>
        </div>
      </header>

      <AdministracionNav active="ensaios" />

      <div class="analysis-actions">
        <a class="secondary-link" href="/portal/administracion/ensaios-v2/">← Volver a Ensaios</a>
      </div>

      <section class="filter-card">
        <label><span>Data inicial</span><input id="desde" type="date" /></label>
        <label><span>Data final</span><input id="ata" type="date" /></label>
        <label><span>Corda</span><select id="voz"><option value="">Todas as cordas</option></select></label>
        <label><span>Coralista</span><select id="persoa"><option value="">Todos os coralistas</option></select></label>
        <label><span>Tipo de ensaio</span><select id="tipo"><option value="">Todos os tipos</option></select></label>
        <label><span>Concerto relacionado</span><select id="concerto"><option value="">Todos os concertos</option></select></label>
        <div class="filter-actions">
          <button id="clear-filters" type="button" class="secondary">Limpar filtros</button>
          <button id="run-analysis" type="button" class="primary">Calcular análise</button>
        </div>
      </section>

      <section id="active-filters" class="active-filters" hidden></section>
      <section id="loading" class="state-box" hidden>Calculando análise…</section>
      <section id="error-state" class="state-box error-box" hidden><strong>Non foi posible calcular a análise</strong><p id="error-message"></p></section>

      <section id="results" hidden>
        <div id="summary-cards" class="summary-grid"></div>

        <section class="analysis-section">
          <div class="section-head"><div><small>Comparativa</small><h2>Asistencia por corda</h2></div></div>
          <div id="voice-stats" class="voice-grid"></div>
        </section>

        <section class="two-columns">
          <article class="analysis-section compact"><div class="section-head"><div><small>Top 10</small><h2>Maior asistencia</h2></div></div><div id="top-list" class="ranking-list"></div></article>
          <article class="analysis-section compact"><div class="section-head"><div><small>Seguimento</small><h2>Menor asistencia</h2></div></div><div id="bottom-list" class="ranking-list"></div></article>
        </section>

        <section class="analysis-section">
          <div class="section-head"><div><small>Evolución</small><h2>Por mes</h2></div></div>
          <div id="month-list" class="month-list"></div>
        </section>

        <section class="analysis-section">
          <div class="section-head"><div><small>Detalle</small><h2>Asistencia individual</h2></div><label class="table-search"><span>Buscar nos resultados</span><input id="person-search" type="search" placeholder="Nome ou corda" /></label></div>
          <div class="table-wrap"><table><thead><tr><th>Coralista</th><th>Voz</th><th>Asiste</th><th>Non asiste</th><th>Xustificadas</th><th>Sen xustificar</th><th>Rexistros</th><th>Asistencia</th></tr></thead><tbody id="person-table"></tbody></table></div>
        </section>

        <section class="analysis-section">
          <div class="section-head"><div><small>Detalle</small><h2>Por ensaio</h2></div></div>
          <div class="table-wrap"><table><thead><tr><th>Data</th><th>Ensaio</th><th>Concerto</th><th>Presentes</th><th>Rexistros</th><th>Asistencia</th></tr></thead><tbody id="rehearsal-table"></tbody></table></div>
        </section>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
const $=(s)=>document.querySelector(s);
let data=null;
let filtersReady=false;
const esc=(v='')=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
const fmtDate=(v)=>{if(!v)return'—';const d=new Date(`${v}T12:00:00`);return Number.isNaN(d.getTime())?v:new Intl.DateTimeFormat('gl-ES',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d)};
const fmtMonth=(v)=>{if(!/^\d{4}-\d{2}$/.test(v))return v;const d=new Date(`${v}-01T12:00:00`);return new Intl.DateTimeFormat('gl-ES',{month:'long',year:'numeric'}).format(d)};
const value=(id)=>{const el=$(id);return el instanceof HTMLInputElement||el instanceof HTMLSelectElement?el.value:'';};

function currentFilters(){return{desde:value('#desde'),ata:value('#ata'),voz:value('#voz'),persoa:value('#persoa'),tipoEnsaio:value('#tipo'),concerto:value('#concerto')}};
async function request(){
  const user=auth.currentUser;
  if(!user?.email)throw new Error('A sesión non está activa.');
  const idToken=await user.getIdToken();
  const response=await fetch('/api/ensaios-analise-v2',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,...currentFilters()})});
  const result=await response.json().catch(()=>null);
  if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);
  return result;
}

function setOptions(id,rows,placeholder,getValue,getLabel){const select=$(id);if(!(select instanceof HTMLSelectElement))return;const selected=select.value;select.innerHTML=`<option value="">${placeholder}</option>`+rows.map(row=>`<option value="${esc(getValue(row))}">${esc(getLabel(row))}</option>`).join('');if([...select.options].some(o=>o.value===selected))select.value=selected;}
function populateFilters(){const f=data?.filtrosDisponibles||{};setOptions('#voz',Array.isArray(f.voces)?f.voces:[],'Todas as cordas',x=>x,x=>x);setOptions('#persoa',Array.isArray(f.persoas)?f.persoas:[],'Todos os coralistas',x=>x.id,x=>`${x.nome} · ${x.voz}`);setOptions('#tipo',Array.isArray(f.tipos)?f.tipos:[],'Todos os tipos',x=>x,x=>x);setOptions('#concerto',Array.isArray(f.concertos)?f.concertos:[],'Todos os concertos',x=>x.id,x=>x.nome);filtersReady=true;}
function renderActiveFilters(){const box=$('#active-filters');if(!(box instanceof HTMLElement))return;const f=currentFilters();const labels=[];if(f.desde)labels.push(`Desde ${fmtDate(f.desde)}`);if(f.ata)labels.push(`Ata ${fmtDate(f.ata)}`);if(f.voz)labels.push(`Corda: ${f.voz}`);if(f.persoa){const el=$('#persoa');labels.push(`Coralista: ${el instanceof HTMLSelectElement?el.selectedOptions[0]?.textContent||f.persoa:f.persoa}`);}if(f.tipoEnsaio)labels.push(`Tipo: ${f.tipoEnsaio}`);if(f.concerto){const el=$('#concerto');labels.push(`Concerto: ${el instanceof HTMLSelectElement?el.selectedOptions[0]?.textContent||f.concerto:f.concerto}`);}box.hidden=!labels.length;box.innerHTML=labels.map(t=>`<span>${esc(t)}</span>`).join('');}
function progress(p){return `<div class="progress"><span style="width:${Math.max(0,Math.min(100,Number(p)||0))}%"></span></div>`;}
function renderSummary(){const r=data?.resumo||{};const best=r.mellorEnsaio;const worst=r.peorEnsaio;$('#summary-cards').innerHTML=`
  <article><small>Ensaios no período</small><strong>${Number(r.ensaios||0)}</strong></article>
  <article><small>Persoas no filtro</small><strong>${Number(r.persoas||0)}</strong></article>
  <article><small>Asistencia media</small><strong>${Number(r.asistenciaMedia||0)}%</strong></article>
  <article><small>Ausencias xustificadas</small><strong>${Number(r.xustificadas||0)}</strong></article>
  <article><small>Ausencias sen xustificar</small><strong>${Number(r.senXustificar||0)}</strong></article>
  <article class="wide"><small>Mellor asistencia nun ensaio</small><strong>${best?`${esc(fmtDate(best.data))} · ${best.porcentaxe}%`:'Sen datos'}</strong></article>
  <article class="wide"><small>Menor asistencia nun ensaio</small><strong>${worst?`${esc(fmtDate(worst.data))} · ${worst.porcentaxe}%`:'Sen datos'}</strong></article>`;}
function renderVoices(){const rows=Array.isArray(data?.porVoz)?data.porVoz:[];$('#voice-stats').innerHTML=rows.length?rows.map(r=>`<article><div><strong>${esc(r.voz)}</strong><span>${r.persoas} persoas</span></div><b>${r.porcentaxe}%</b>${progress(r.porcentaxe)}<small>${r.asiste} asistencias de ${r.rexistrados} rexistros</small></article>`).join(''):'<p class="empty">Sen datos para as cordas seleccionadas.</p>';}
function rankingHtml(rows){return rows.length?rows.map((r,n)=>`<div class="ranking-row"><span class="rank">${n+1}</span><div><strong>${esc(r.nome)}</strong><small>${esc(r.voz)} · ${r.asiste}/${r.rexistrados}</small></div><b>${r.porcentaxe}%</b></div>`).join(''):'<p class="empty">Sen datos no período.</p>';}
function renderRankings(){const top=Array.isArray(data?.maiores)?data.maiores:[],bottom=Array.isArray(data?.menores)?data.menores:[];$('#top-list').innerHTML=rankingHtml(top);$('#bottom-list').innerHTML=rankingHtml(bottom);}
function renderMonths(){const rows=Array.isArray(data?.porMes)?data.porMes:[];$('#month-list').innerHTML=rows.length?rows.map(r=>`<article><div><strong>${esc(fmtMonth(r.mes))}</strong><span>${r.presentes}/${r.rexistrados}</span></div><b>${r.porcentaxe}%</b>${progress(r.porcentaxe)}</article>`).join(''):'<p class="empty">Sen datos mensuais.</p>';}
function renderPeople(){const q=String($('#person-search')?.value||'').trim().toLowerCase();const rows=(Array.isArray(data?.persoas)?data.persoas:[]).filter(r=>!q||`${r.nome} ${r.voz}`.toLowerCase().includes(q));$('#person-table').innerHTML=rows.length?rows.map(r=>`<tr><td><strong>${esc(r.nome)}</strong></td><td>${esc(r.voz)}</td><td>${r.asiste}</td><td>${r.nonAsiste}</td><td>${r.xustificadas}</td><td>${r.senXustificar}</td><td>${r.rexistrados}/${r.ensaios}</td><td><strong>${r.rexistrados?r.porcentaxe+'%':'—'}</strong></td></tr>`).join(''):'<tr><td colspan="8">Sen resultados.</td></tr>';}
function renderRehearsals(){const rows=Array.isArray(data?.porEnsaio)?data.porEnsaio:[];$('#rehearsal-table').innerHTML=rows.length?rows.map(r=>`<tr><td>${esc(fmtDate(r.data))}</td><td>${esc(r.tipoEnsaio)}</td><td>${esc(r.concertoNome||'—')}</td><td>${r.presentes}</td><td>${r.rexistrados}</td><td><strong>${r.rexistrados?r.porcentaxe+'%':'—'}</strong></td></tr>`).join(''):'<tr><td colspan="6">Sen ensaios para estes filtros.</td></tr>';}
function render(){if(!filtersReady)populateFilters();renderActiveFilters();renderSummary();renderVoices();renderRankings();renderMonths();renderPeople();renderRehearsals();$('#results').hidden=false;}

async function run(){const loading=$('#loading'),error=$('#error-state');loading.hidden=false;error.hidden=true;try{data=await request();populateFilters();render();}catch(e){error.hidden=false;$('#error-message').textContent=e instanceof Error?e.message:String(e);}finally{loading.hidden=true;}}
function clearFilters(){const today=new Date();const year=today.getFullYear();const iso=(d)=>d.toISOString().slice(0,10);const desde=$('#desde'),ata=$('#ata');if(desde instanceof HTMLInputElement)desde.value=`${year}-01-01`;if(ata instanceof HTMLInputElement)ata.value=iso(today);['#voz','#persoa','#tipo','#concerto'].forEach(id=>{const el=$(id);if(el instanceof HTMLSelectElement)el.value='';});run();}

async function init(){const user=await waitForPortalUser();if(!user?.email)return;$('#user-email').textContent=user.email;const today=new Date();const year=today.getFullYear();const iso=(d)=>d.toISOString().slice(0,10);$('#desde').value=`${year}-01-01`;$('#ata').value=iso(today);await run();}
$('#run-analysis')?.addEventListener('click',run);$('#clear-filters')?.addEventListener('click',clearFilters);$('#person-search')?.addEventListener('input',renderPeople);$('#admin-ensaios-analise-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});
init();
</script>

<style is:global>
.analysis-main{padding:2rem;min-width:0}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.private-page-header h1{font-size:clamp(2rem,4vw,3.2rem);margin:.25rem 0}.section-kicker{color:#b58a3b;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.account-card,.filter-card,.analysis-section,.state-box,.summary-grid article{background:#fff;border:1px solid #ddd5d1}.account-card{min-width:250px;padding:1rem;display:grid;gap:1rem}.account-card span{display:grid;gap:.25rem}.account-card small,.summary-grid small,.section-head small{font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;color:#756d69}.analysis-actions{display:flex;justify-content:flex-end;margin:1rem 0}.secondary-link{border:1px solid #cfc3bf;padding:.75rem 1rem;color:#4a3f3c;text-decoration:none}.filter-card{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:1rem;padding:1rem;margin:1rem 0}.filter-card label,.table-search{display:grid;gap:.35rem}.filter-card input,.filter-card select,.table-search input{padding:.75rem;border:1px solid #d4cbc7;font:inherit;background:#fff}.filter-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:.6rem}.primary,.secondary{padding:.8rem 1rem;cursor:pointer;font:inherit}.primary{background:#74162f;color:#fff;border:1px solid #74162f}.secondary{background:#fff;color:#493e3b;border:1px solid #cfc3bf}.active-filters{display:flex;flex-wrap:wrap;gap:.5rem;margin:0 0 1.25rem}.active-filters span{border:1px solid #d9cfcb;background:#fff;padding:.45rem .7rem;font-size:.85rem}.state-box{padding:1.25rem;margin:1rem 0}.error-box{color:#6e2433}.summary-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1rem}.summary-grid article{padding:1.2rem;display:grid;gap:.5rem}.summary-grid strong{font-size:1.8rem;color:#74162f}.summary-grid .wide{grid-column:span 2}.summary-grid .wide strong{font-size:1.05rem;color:#2d2523}.analysis-section{padding:1.25rem;margin-top:1.25rem}.analysis-section.compact{margin-top:0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1rem}.section-head h2{margin:.15rem 0;color:#74162f}.voice-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.voice-grid article{border:1px solid #e3dcda;padding:1rem;display:grid;gap:.65rem}.voice-grid article>div,.month-list article>div{display:flex;justify-content:space-between;gap:.5rem}.voice-grid span,.voice-grid small,.month-list span{color:#756d69}.voice-grid b,.month-list b{font-size:1.4rem;color:#74162f}.progress{height:7px;background:#eee8e5;overflow:hidden}.progress span{display:block;height:100%;background:#74162f}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.25rem}.ranking-list{display:grid}.ranking-row{display:grid;grid-template-columns:34px 1fr auto;gap:.75rem;align-items:center;padding:.7rem 0;border-bottom:1px solid #eee7e3}.ranking-row:last-child{border-bottom:0}.rank{width:30px;height:30px;border:1px solid #d9cfcb;display:grid;place-items:center}.ranking-row div{display:grid;gap:.2rem}.ranking-row small{color:#756d69}.ranking-row b{color:#74162f}.month-list{display:grid;gap:.8rem}.month-list article{display:grid;grid-template-columns:1fr 70px;gap:.5rem 1rem;align-items:center}.month-list .progress{grid-column:1/-1}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:.75rem;border-bottom:1px solid #eee7e3;white-space:nowrap}th{font-size:.75rem;text-transform:uppercase;color:#756d69}.empty{color:#756d69}
@media(max-width:1100px){.filter-card{grid-template-columns:repeat(2,minmax(180px,1fr))}.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.voice-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two-columns{grid-template-columns:1fr}}
@media(max-width:700px){.analysis-main{padding:1rem}.private-page-header{display:block}.account-card{margin-top:1rem;min-width:0}.filter-card{grid-template-columns:1fr}.filter-actions{display:grid}.summary-grid,.voice-grid{grid-template-columns:1fr}.summary-grid .wide{grid-column:auto}.section-head{align-items:stretch;flex-direction:column}.analysis-actions{justify-content:flex-start}}
</style>
