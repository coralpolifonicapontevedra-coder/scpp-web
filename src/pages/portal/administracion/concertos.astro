---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de concertos" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-concertos-logout" />
    <main class="admin-concerts-main">
      <header class="private-page-header">
        <div><span class="section-kicker">Administración</span><h1>Administración de concertos</h1><p>Cambia a data ou o estado dun concerto conservando sempre o seu identificador e todas as relacións existentes.</p></div>
        <div class="account-card"><span><small>Conta identificada</small><strong id="user-email">—</strong></span><span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span></div>
      </header>
      <AdministracionNav active="concertos" />
      <section id="loading" class="state-box">Comprobando permisos e cargando concertos…</section>
      <section id="error-state" class="state-box error-box" hidden><strong>Non foi posible abrir a administración de concertos</strong><p id="error-message"></p><button id="retry" type="button" class="secondary">Tentar de novo</button></section>
      <section id="app" hidden>
        <div class="toolbar"><label><span>Mostrar</span><select id="filter"><option value="todos">Todos</option><option value="Previsto">Previsto</option><option value="Confirmado">Confirmado</option><option value="Aprazado">Aprazado</option><option value="Cancelado">Cancelado</option><option value="Realizado">Realizado</option></select></label><p id="count"></p><button id="new-concert" type="button" class="primary">Alta de concerto</button></div>
        <div id="list" class="concert-list"></div>
      </section>
    </main>
  </div>
  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" id="date-close">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required /></label><p id="date-status" class="dialog-status"></p><footer><button type="button" id="date-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>
  <dialog id="state-dialog"><form id="state-form"><header><h2>Cambiar estado</h2><button type="button" id="state-close">×</button></header><p id="state-name"></p><label><span>Novo estado</span><select id="new-state"><option>Previsto</option><option>Confirmado</option><option>Aprazado</option><option>Cancelado</option><option>Realizado</option></select></label><p id="state-status" class="dialog-status"></p><footer><button type="button" id="state-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar estado</button></footer></form></dialog>
  <dialog id="concert-dialog" class="wide-dialog"><form id="concert-form"><header><h2 id="concert-form-title">Alta de concerto</h2><button type="button" data-close="concert-dialog">×</button></header><div class="form-grid"><label><span>Data</span><input name="data" type="date" required /></label><label><span>Nome</span><input name="nome" required /></label><label><span>Cidade</span><input name="cidade" /></label><label><span>Lugar</span><input name="lugar" /></label><label><span>Hora</span><input name="hora" type="time" /></label><label><span>Estado</span><select name="estado"><option>Previsto</option><option>Confirmado</option><option>Aprazado</option><option>Cancelado</option><option>Realizado</option></select></label><label class="span-2"><span>Descrición</span><textarea name="caracteristicas" rows="3"></textarea></label><label class="check"><input name="mostrarWeb" type="checkbox" /> Mostrar na web</label><label class="check"><input name="destacadoWeb" type="checkbox" /> Destacado</label></div><p id="concert-form-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="concert-dialog">Cancelar</button><button type="submit" class="primary">Gardar concerto</button></footer></form></dialog>
  <dialog id="manage-dialog" class="wide-dialog"><section class="manage-shell"><header><div><small>Xestión integral</small><h2 id="manage-title">Concerto</h2></div><button type="button" data-close="manage-dialog">×</button></header><nav class="manage-tabs"><button type="button" class="is-active" data-panel="programa">Programa</button><button type="button" data-panel="asistentes">Asistentes</button><button type="button" data-panel="documentos">Cartel e tríptico</button></nav><section id="panel-programa" class="manage-panel"><div class="add-work"><select id="work-select"></select><button id="add-work" type="button" class="secondary">Engadir obra</button></div><div id="program-list"></div><button id="save-program" type="button" class="primary">Gardar programa</button></section><section id="panel-asistentes" class="manage-panel" hidden><div id="people-list"></div><button id="save-attendees" type="button" class="primary">Gardar asistentes</button></section><section id="panel-documentos" class="manage-panel" hidden><div class="documents-grid"><article><h3>Cartel</h3><p id="current-poster"></p><input id="poster-file" type="file" accept="image/jpeg,image/png,image/webp" /></article><article><h3>Tríptico / programa de man</h3><p id="current-program-file"></p><input id="program-file" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" /></article></div><p>Esta sección quedará conectada a R2 na seguinte parte do despregamento.</p></section><p id="manage-status" class="dialog-status"></p></section></dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
  const $=(s)=>document.querySelector(s); const loading=$('#loading'),errorState=$('#error-state'),errorMessage=$('#error-message'),app=$('#app'),list=$('#list'),filter=$('#filter'),count=$('#count'),userEmail=$('#user-email'),userLevel=$('#user-level'),dateDialog=$('#date-dialog'),stateDialog=$('#state-dialog'),concertDialog=$('#concert-dialog'),manageDialog=$('#manage-dialog'); let concertos=[],selected=null,xestion={programa:[],persoas:[],obras:[]};
  const fmt=(v)=>{if(!v)return'Sen data';const d=new Date(`${String(v).slice(0,10)}T12:00:00`);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d)};
  async function request(accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch('/api/concertos-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}
  function visible(){const mode=filter instanceof HTMLSelectElement?filter.value:'todos';return concertos.filter(i=>mode==='todos'||i.estado===mode);}
  function draw(){if(!(list instanceof HTMLElement))return;const rows=visible();if(count instanceof HTMLElement)count.textContent=`${rows.length} concerto${rows.length===1?'':'s'}`;if(!rows.length){list.innerHTML='<section class="state-box">Non hai concertos para este filtro.</section>';return;}list.innerHTML=rows.map(i=>`<article class="concert-card"><div><small>Data</small><strong>${fmt(i.data)}</strong></div><div><h2>${i.nome||'Concerto'}</h2><p>${[i.cidade,i.lugar,i.hora].filter(Boolean).join(' · ')}</p><div class="meta"><span>${Number(i.obras||0)} obras</span><span>${Number(i.asistencias||0)} asistencias</span><span>${i.cartel?'Cartel ✓':'Cartel pend.'}</span><span>${i.triptico?'Tríptico ✓':'Tríptico pend.'}</span></div></div><div class="state"><strong>${i.estado||'Sen estado'}</strong></div><div class="actions"><button type="button" class="primary manage-concert" data-id="${i.idConcerto}">Xestionar</button><button type="button" class="secondary edit-concert" data-id="${i.idConcerto}">Editar ficha</button></div></article>`).join('');}
  async function load(){if(loading instanceof HTMLElement)loading.hidden=false;if(errorState instanceof HTMLElement)errorState.hidden=true;if(app instanceof HTMLElement)app.hidden=true;try{const user=await waitForPortalUser();if(!user?.email)throw new Error('Non hai unha sesión válida.');if(userEmail instanceof HTMLElement)userEmail.textContent=user.email;const result=await request('listar');concertos=Array.isArray(result.concertos)?result.concertos:[];if(userLevel instanceof HTMLElement)userLevel.textContent=result.nivel||'Administración';if(loading instanceof HTMLElement)loading.hidden=true;if(app instanceof HTMLElement)app.hidden=false;draw();}catch(error){if(loading instanceof HTMLElement)loading.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Produciuse un erro inesperado.';}}
  function abrirFicha(item=null){selected=item;const form=$('#concert-form');if(!(form instanceof HTMLFormElement)||!(concertDialog instanceof HTMLDialogElement))return;form.reset();$('#concert-form-title').textContent=item?'Editar ficha do concerto':'Alta de concerto';for(const name of ['data','nome','cidade','lugar','hora','estado','caracteristicas']){const field=form.elements.namedItem(name);if(field instanceof HTMLInputElement||field instanceof HTMLSelectElement||field instanceof HTMLTextAreaElement)field.value=String(item?.[name]||'');}for(const name of ['mostrarWeb','destacadoWeb']){const field=form.elements.namedItem(name);if(field instanceof HTMLInputElement)field.checked=item?.[name]===true;}concertDialog.showModal();}
  function pintarPrograma(){const box=$('#program-list');if(!(box instanceof HTMLElement))return;box.innerHTML=xestion.programa.length?xestion.programa.map((p,n)=>{const obra=xestion.obras.find(o=>o.id===p.obraId);return`<article class="program-row" data-index="${n}"><span>${n+1}</span><strong>${obra?.nome||p.obraId}</strong><input data-field="solista" value="${p.solista||''}" placeholder="Solista"/><input data-field="notas" value="${p.notas||''}" placeholder="Notas"/><button type="button" data-remove="${n}">Retirar</button></article>`}).join(''):'<p>Programa pendente.</p>';}
  function pintarPersoas(){const box=$('#people-list');if(!(box instanceof HTMLElement))return;const voces=['Soprano','Contralto','Tenor','Baixo'];box.innerHTML=voces.map(v=>{const ps=xestion.persoas.filter(p=>String(p.voz).toLowerCase()===v.toLowerCase()).sort((a,b)=>`${a.primeiroApelido} ${a.segundoApelido} ${a.nome}`.localeCompare(`${b.primeiroApelido} ${b.segundoApelido} ${b.nome}`,'gl'));return ps.length?`<section class="voice-checks"><h3>${v} <span>${ps.length}</span></h3>${ps.map(p=>`<label><input type="checkbox" data-person="${p.id}" ${p.asiste?'checked':''}/><span>${p.primeiroApelido} ${p.segundoApelido}, ${p.nome}</span></label>`).join('')}</section>`:''}).join('');}
  async function abrirXestion(item){selected=item;if(!(manageDialog instanceof HTMLDialogElement))return;$('#manage-title').textContent=item.nome||'Concerto';$('#manage-status').textContent='Cargando…';manageDialog.showModal();try{xestion=await request('obterXestion',{idConcerto:item.idConcerto});const select=$('#work-select');if(select instanceof HTMLSelectElement)select.innerHTML='<option value="">Selecciona unha obra</option>'+xestion.obras.sort((a,b)=>a.nome.localeCompare(b.nome,'gl')).map(o=>`<option value="${o.id}">${o.nome}${o.autor?' · '+o.autor:''}</option>`).join('');pintarPrograma();pintarPersoas();$('#current-poster').textContent=item.cartel||'Pendente';$('#current-program-file').textContent=item.triptico||'Pendente';$('#manage-status').textContent='';}catch(e){$('#manage-status').textContent=e instanceof Error?e.message:String(e);}}
  filter?.addEventListener('change',draw);$('#retry')?.addEventListener('click',load);$('#new-concert')?.addEventListener('click',()=>abrirFicha());$('#admin-concertos-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});
  list?.addEventListener('click',(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement))return;const item=concertos.find(i=>i.idConcerto===target.dataset.id)||null;if(!item)return;if(target.classList.contains('edit-concert'))abrirFicha(item);if(target.classList.contains('manage-concert'))abrirXestion(item);});
  const closeDate=()=>dateDialog instanceof HTMLDialogElement&&dateDialog.close(),closeState=()=>stateDialog instanceof HTMLDialogElement&&stateDialog.close();$('#date-close')?.addEventListener('click',closeDate);$('#date-cancel')?.addEventListener('click',closeDate);$('#state-close')?.addEventListener('click',closeState);$('#state-cancel')?.addEventListener('click',closeState);
  $('#date-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-date'),status=$('#date-status');if(!selected||!(input instanceof HTMLInputElement)||!input.value)return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarData',{idConcerto:selected.idConcerto,data:input.value});closeDate();await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar a data.';}});
  $('#state-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-state'),status=$('#state-status');if(!selected||!(input instanceof HTMLSelectElement))return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarEstado',{idConcerto:selected.idConcerto,estado:input.value});closeState();await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar o estado.';}});
  document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>{const d=document.querySelector(`#${b.getAttribute('data-close')}`);if(d instanceof HTMLDialogElement)d.close();}));
  $('#concert-form')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget;if(!(form instanceof HTMLFormElement))return;const fd=new FormData(form),concerto={idConcerto:selected?.idConcerto||'',data:String(fd.get('data')||''),nome:String(fd.get('nome')||''),cidade:String(fd.get('cidade')||''),lugar:String(fd.get('lugar')||''),hora:String(fd.get('hora')||''),estado:String(fd.get('estado')||'Previsto'),caracteristicas:String(fd.get('caracteristicas')||''),mostrarWeb:fd.get('mostrarWeb')==='on',destacadoWeb:fd.get('destacadoWeb')==='on'};try{$('#concert-form-status').textContent='Gardando…';await request('gardarConcerto',{concerto});if(concertDialog instanceof HTMLDialogElement)concertDialog.close();await load();}catch(err){$('#concert-form-status').textContent=err instanceof Error?err.message:String(err);}});
  $('.manage-tabs')?.addEventListener('click',e=>{const b=e.target;if(!(b instanceof HTMLButtonElement)||!b.dataset.panel)return;document.querySelectorAll('.manage-tabs button').forEach(x=>x.classList.toggle('is-active',x===b));document.querySelectorAll('.manage-panel').forEach(x=>{if(x instanceof HTMLElement)x.hidden=x.id!==`panel-${b.dataset.panel}`;});});
  $('#add-work')?.addEventListener('click',()=>{const s=$('#work-select');if(!(s instanceof HTMLSelectElement)||!s.value)return;if(!xestion.programa.some(p=>p.obraId===s.value))xestion.programa.push({obraId:s.value,notas:'',solista:'',orde:xestion.programa.length+1});pintarPrograma();});
  $('#program-list')?.addEventListener('click',e=>{const b=e.target;if(!(b instanceof HTMLButtonElement)||b.dataset.remove===undefined)return;xestion.programa.splice(Number(b.dataset.remove),1);pintarPrograma();});
  $('#save-program')?.addEventListener('click',async()=>{if(!selected)return;document.querySelectorAll('.program-row').forEach((r,n)=>{r.querySelectorAll('input').forEach(i=>xestion.programa[n][i.dataset.field]=i.value);});try{$('#manage-status').textContent='Gardando programa…';await request('gardarPrograma',{idConcerto:selected.idConcerto,programa:xestion.programa});$('#manage-status').textContent='Programa gardado.';}catch(e){$('#manage-status').textContent=e instanceof Error?e.message:String(e);}});
  $('#save-attendees')?.addEventListener('click',async()=>{if(!selected)return;const ids=[...document.querySelectorAll('[data-person]:checked')].map(x=>x.getAttribute('data-person'));const persoas=xestion.persoas.filter(p=>ids.includes(p.id));try{$('#manage-status').textContent='Gardando asistentes…';await request('gardarAsistentes',{idConcerto:selected.idConcerto,persoas});$('#manage-status').textContent='Asistentes gardados.';}catch(e){$('#manage-status').textContent=e instanceof Error?e.message:String(e);}});
  async function subirMedio(input,tipo){if(!selected||!(input instanceof HTMLInputElement)||!input.files?.[0])return;const ficheiro=input.files[0],base64=await new Promise((resolve,reject)=>{const r=new FileReader();r.onerror=()=>reject(new Error('Non se puido ler o ficheiro.'));r.onload=()=>resolve(String(r.result||'').split(',')[1]||'');r.readAsDataURL(ficheiro);});$('#manage-status').textContent=`Subindo ${tipo} a R2…`;const result=await request('subirMedio',{idConcerto:selected.idConcerto,tipo,mimeType:ficheiro.type,nomeFicheiro:ficheiro.name,base64});selected[tipo==='cartel'?'cartel':'triptico']=result.ruta;$('#manage-status').textContent=`${tipo==='cartel'?'Cartel':'Tríptico'} gardado en R2.`;}
  $('#poster-file')?.addEventListener('change',async e=>{try{await subirMedio(e.currentTarget,'cartel');$('#current-poster').textContent=selected?.cartel||'Pendente';}catch(err){$('#manage-status').textContent=err instanceof Error?err.message:String(err);}});
  $('#program-file')?.addEventListener('change',async e=>{try{await subirMedio(e.currentTarget,'triptico');$('#current-program-file').textContent=selected?.triptico||'Pendente';}catch(err){$('#manage-status').textContent=err instanceof Error?err.message:String(err);}});
  load();
</script>

<style is:global>
body{background:#f5f3f1}.private-layout{display:flex;min-height:100vh}.admin-concerts-main{flex:1;min-width:0;padding:2.1rem clamp(1.25rem,3vw,3.5rem) 4rem;font-family:var(--fuente-minimalista)}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.8rem}.section-kicker{color:var(--color-acento);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.private-page-header h1{margin:.2rem 0 .55rem;color:var(--color-principal);font-size:clamp(2rem,4vw,3.5rem)}.private-page-header p{max-width:760px;margin:0;color:#625c58}.account-card{display:grid;gap:.7rem;min-width:250px;padding:1rem 1.15rem;border:1px solid #ded8d3;background:#fff}.account-card span{display:grid;gap:.18rem}.account-card small{color:#77706b;font-size:.68rem;font-weight:700;text-transform:uppercase}.state-box,.toolbar,.concert-card{border:1px solid #ded8d3;background:#fff}.state-box{padding:1.35rem}.error-box{color:#8b2d36}.toolbar{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:1.25rem;padding:1rem 1.15rem}.toolbar label{display:grid;gap:.45rem;width:min(420px,100%)}.toolbar select,dialog input,dialog select{min-height:2.75rem;padding:.55rem .7rem;border:1px solid #d6cfca;background:#fff;font:inherit}.concert-list{display:grid;gap:.8rem}.concert-card{display:grid;grid-template-columns:minmax(190px,1.1fr) minmax(260px,2fr) auto auto;align-items:center;gap:1.2rem;padding:1rem 1.15rem}.concert-card small{display:block;color:#806f74;font-size:.7rem;font-weight:800;text-transform:uppercase}.concert-card h2{margin:0 0 .25rem;color:var(--color-principal);font-size:1rem}.concert-card p{margin:0;color:#6f6561;font-size:.88rem}.meta{display:flex;gap:.7rem;margin-top:.45rem;color:#806f74;font-size:.78rem}.state strong{display:inline-flex;padding:.32rem .55rem;border-radius:999px;background:#edf4ef;color:#3f6c50;font-size:.75rem}.actions{display:flex;gap:.45rem}.admin-concerts-main button{min-height:2.35rem;padding:.5rem .8rem;border-radius:4px;cursor:pointer;font-weight:800}.secondary{border:1px solid #cfc5c8;background:#fff;color:#4f333b}.primary{border:1px solid #5d142b;background:#5d142b;color:#fff}dialog{width:min(520px,calc(100vw - 2rem));border:0;padding:0;box-shadow:0 18px 60px rgba(0,0,0,.22)}dialog::backdrop{background:rgba(35,27,29,.45)}dialog form{padding:1.25rem}dialog header,dialog footer{display:flex;align-items:center;justify-content:space-between;gap:1rem}dialog header{padding-bottom:1rem;border-bottom:1px solid #e7e0dd}dialog header h2{margin:0;font-size:1.15rem}dialog header button{min-height:auto;border:0;background:transparent;font-size:1.5rem}dialog label{display:grid;gap:.4rem;margin:1rem 0}dialog footer{justify-content:flex-end;padding-top:1rem;border-top:1px solid #e7e0dd}.dialog-status{min-height:1.4rem;color:#7f343d;font-size:.85rem}@media(max-width:980px){.concert-card{grid-template-columns:1fr 1fr}}@media(max-width:900px){.private-layout{display:block}.private-page-header,.toolbar{display:grid}.account-card{min-width:0}}@media(max-width:620px){.admin-concerts-main{padding:1.15rem .9rem 2.5rem}.concert-card{grid-template-columns:1fr}.actions{flex-wrap:wrap}}
</style>
<style is:global>
.wide-dialog{width:min(1050px,calc(100vw - 2rem));max-height:calc(100vh - 2rem);overflow:auto}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem 1rem;padding:1rem 0}.form-grid label{margin:0}.form-grid .span-2{grid-column:1/-1}.form-grid textarea{padding:.65rem;border:1px solid #d6cfca;font:inherit}.form-grid .check{display:flex;align-items:center;gap:.5rem}.form-grid .check input{min-height:auto}.manage-shell{padding:1.25rem}.manage-shell>header{display:flex;justify-content:space-between;align-items:center}.manage-shell h2{margin:.15rem 0;color:var(--color-principal)}.manage-tabs{display:flex;margin:1rem 0;border-bottom:1px solid #d8d0cc}.manage-tabs button{border:0;background:#fff}.manage-tabs button.is-active{background:var(--color-principal);color:#fff}.manage-panel{padding:.5rem 0}.add-work{display:flex;gap:.6rem;margin-bottom:1rem}.add-work select{flex:1;min-height:2.6rem}.program-row{display:grid;grid-template-columns:35px minmax(180px,1fr) minmax(100px,.7fr) minmax(120px,1fr) auto;gap:.5rem;align-items:center;padding:.6rem;border-top:1px solid #e2ddda}.program-row input{min-width:0;padding:.5rem;border:1px solid #ddd}.voice-checks{margin-bottom:1rem;border:1px solid #ddd}.voice-checks h3{display:flex;justify-content:space-between;margin:0;padding:.65rem;background:#f5f1ef;color:var(--color-principal)}.voice-checks label{display:flex;gap:.6rem;margin:0;padding:.45rem .7rem;border-top:1px solid #eee}.voice-checks input{min-height:auto}.documents-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.documents-grid article{padding:1rem;border:1px solid #ddd}@media(max-width:700px){.form-grid,.documents-grid{grid-template-columns:1fr}.form-grid .span-2{grid-column:auto}.program-row{grid-template-columns:28px 1fr}.program-row input,.program-row button{grid-column:2}}
</style>
