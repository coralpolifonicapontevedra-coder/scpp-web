---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---
<BaseLayout title="Administración de concertos" lang="gl">
<div class="private-layout"><PortalSidebar active="administracion" logoutId="admin-concertos-logout"/><main class="admin-concerts-main">
<header class="private-page-header"><div><span class="section-kicker">Administración</span><h1>Concertos</h1><p>Xestión centralizada dos concertos. Programa e asistentes quedan vinculados ao identificador do concerto.</p></div><div class="account-card"><span><small>Conta</small><strong id="user-email">—</strong></span><span><small>Nivel</small><strong id="user-level">Comprobando…</strong></span></div></header>
<AdministracionNav active="concertos"/>
<section id="loading" class="state-box">Cargando concertos…</section><section id="error-state" class="state-box error-box" hidden><strong>Non foi posible abrir Concertos</strong><p id="error-message"></p><button id="retry" class="secondary">Tentar de novo</button></section>
<section id="app" hidden><div class="toolbar"><label><span>Mostrar</span><select id="filter"><option value="todos">Todos</option><option>Previsto</option><option>Confirmado</option><option>Aprazado</option><option>Cancelado</option><option>Realizado</option></select></label><p id="count"></p></div><div id="list" class="concert-list"></div></section>
</main></div>
<dialog id="manage-dialog" class="manage"><div class="manage-shell"><header><div><small>Xestión do concerto</small><h2 id="manage-title">Concerto</h2><p id="manage-date"></p></div><button id="manage-close" class="close" aria-label="Pechar">×</button></header>
<nav class="tabs"><button class="active" data-tab="programa">Programa</button><button data-tab="asistentes">Asistentes</button><button disabled title="Seguinte fase">Cartel</button><button disabled title="Seguinte fase">Tríptico</button></nav>
<section id="manage-loading" class="state-box">Cargando datos do concerto…</section>
<section id="program-panel" hidden><div class="program-add"><label><span>Engadir obra de Repertorio</span><select id="work-select"><option value="">Selecciona unha obra…</option></select></label><button id="add-work" class="primary">Engadir</button></div><div id="program-list" class="program-list"></div><p id="program-empty" class="state-box" hidden>O concerto aínda non ten obras no programa.</p><footer><p id="program-status"></p><button id="save-program" class="primary">Gardar programa</button></footer></section>
<section id="attendees-panel" hidden><div class="attendees-toolbar"><div><strong id="attendees-count">0 asistentes seleccionados</strong><p>Marca exclusivamente as persoas que asistiron ao concerto.</p></div><div><button id="select-all" class="secondary">Marcar todos</button><button id="clear-all" class="secondary">Limpar selección</button></div></div><div id="attendees-groups" class="attendees-groups"></div><footer><p id="attendees-status"></p><button id="save-attendees" class="primary">Gardar asistentes</button></footer></section>
</div></dialog>
</BaseLayout>
<script>
import { auth,closePortalSession,waitForPortalUser } from '../../../lib/portal-session.js';
const $=s=>document.querySelector(s),loading=$('#loading'),errorState=$('#error-state'),errorMessage=$('#error-message'),app=$('#app'),list=$('#list'),filter=$('#filter'),count=$('#count'),userEmail=$('#user-email'),userLevel=$('#user-level'),manage=$('#manage-dialog'),manageLoading=$('#manage-loading'),programPanel=$('#program-panel'),attendeesPanel=$('#attendees-panel'),workSelect=$('#work-select'),programList=$('#program-list'),programEmpty=$('#program-empty'),programStatus=$('#program-status'),attendeesGroups=$('#attendees-groups'),attendeesCount=$('#attendees-count'),attendeesStatus=$('#attendees-status');
let concertos=[],selected=null,catalogo=[],programa=[],persoas=[],asistentes=new Set(),activeTab='programa';
const esc=v=>String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
const fmt=v=>{if(!v)return'Sen data';const d=new Date(`${String(v).slice(0,10)}T12:00:00`);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('gl-ES',{day:'numeric',month:'long',year:'numeric'}).format(d)};
const norm=v=>String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
async function request(accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const r=await fetch('/api/concertos-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken:await user.getIdToken(),accion,...extra})}),j=await r.json().catch(()=>null);if(!r.ok||!j?.ok)throw new Error(j?.erro||`Erro HTTP ${r.status}`);return j;}
function visible(){const m=filter instanceof HTMLSelectElement?filter.value:'todos';return concertos.filter(i=>m==='todos'||i.estado===m)}
function draw(){const rows=visible();count.textContent=`${rows.length} concerto${rows.length===1?'':'s'}`;list.innerHTML=rows.map(i=>`<article class="concert-card"><div><small>Data</small><strong>${fmt(i.data)}</strong></div><div><h2>${esc(i.nome||'Concerto')}</h2><p>${esc([i.cidade,i.lugar,i.hora].filter(Boolean).join(' · '))}</p><div class="meta"><span>${Number(i.obras||0)} obras</span><span>${Number(i.asistencias||0)} asistentes</span></div></div><div class="state"><strong>${esc(i.estado||'Sen estado')}</strong></div><div class="actions"><button class="primary manage-btn" data-id="${esc(i.idConcerto)}">Xestionar concerto</button></div></article>`).join('')||'<section class="state-box">Non hai concertos para este filtro.</section>';}
async function load(){loading.hidden=false;errorState.hidden=true;app.hidden=true;try{const u=await waitForPortalUser();if(!u?.email)throw new Error('Non hai unha sesión válida.');userEmail.textContent=u.email;const r=await request('listar');concertos=r.concertos||[];userLevel.textContent=r.nivel||'Administración';loading.hidden=true;app.hidden=false;draw();}catch(e){loading.hidden=true;errorState.hidden=false;errorMessage.textContent=e instanceof Error?e.message:'Erro inesperado.';}}
function obra(id){return catalogo.find(x=>String(x.idRepertorio)===String(id))||{};}
function drawProgram(){programEmpty.hidden=programa.length>0;programList.innerHTML=programa.map((i,n)=>{const o=obra(i.idRepertorio);return `<article class="program-row" data-n="${n}"><div class="order"><button class="up" ${n===0?'disabled':''}>↑</button><strong>${n+1}</strong><button class="down" ${n===programa.length-1?'disabled':''}>↓</button></div><div><h3>${esc(o.nomeObra||i.idRepertorio)}</h3><p>${esc(o.compositor||'')}</p><div class="program-fields"><label>Solista<input class="solista" value="${esc(i.solista||'')}"></label><label>Notas<input class="notas" value="${esc(i.notas||'')}"></label></div></div><button class="remove secondary">Retirar</button></article>`}).join('');}
const vozCanon=v=>{const n=norm(v);if(n.startsWith('sopran'))return'Sopranos';if(n.startsWith('contralt')||n.startsWith('alto'))return'Contraltos';if(n.startsWith('tenor'))return'Tenores';if(n.startsWith('baix')||n.startsWith('baj'))return'Baixos';return'Outras voces';};
function apelidosKey(p){return norm([p.primeiroApelido,p.segundoApelido,p.nome].filter(Boolean).join(' '));}
function drawAttendees(){attendeesCount.textContent=`${asistentes.size} asistente${asistentes.size===1?'':'s'} seleccionado${asistentes.size===1?'':'s'}`;const orde=['Sopranos','Contraltos','Tenores','Baixos','Outras voces'];const grupos={};persoas.forEach(p=>{const v=vozCanon(p.voz);(grupos[v]??=[]).push(p)});attendeesGroups.innerHTML=orde.filter(v=>grupos[v]?.length).map(v=>`<section class="voice-group"><header><h3>${v}</h3><strong>${grupos[v].filter(p=>asistentes.has(String(p.idPersoa))).length}/${grupos[v].length}</strong></header><div class="people-grid">${grupos[v].sort((a,b)=>apelidosKey(a).localeCompare(apelidosKey(b),'gl')).map(p=>`<label class="person-check ${asistentes.has(String(p.idPersoa))?'selected':''}"><input type="checkbox" data-person="${esc(p.idPersoa)}" ${asistentes.has(String(p.idPersoa))?'checked':''}><span><strong>${esc(p.nomeCompleto)}</strong><small>${esc(p.voz||'')}</small></span></label>`).join('')}</div></section>`).join('');}
function showTab(tab){activeTab=tab;document.querySelectorAll('.tabs [data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));programPanel.hidden=tab!=='programa';attendeesPanel.hidden=tab!=='asistentes';}
async function openManage(id){selected=concertos.find(i=>i.idConcerto===id);if(!selected)return;$('#manage-title').textContent=selected.nome||'Concerto';$('#manage-date').textContent=fmt(selected.data);manage.showModal();manageLoading.hidden=false;programPanel.hidden=true;attendeesPanel.hidden=true;programStatus.textContent='';attendeesStatus.textContent='';try{const r=await request('obterXestion',{idConcerto:id});catalogo=(r.repertorio||[]).sort((a,b)=>String(a.nomeObra).localeCompare(String(b.nomeObra),'gl'));programa=(r.programa||[]).map(i=>({...i}));persoas=Array.isArray(r.persoas)?r.persoas:[];asistentes=new Set((r.asistentes||[]).map(String));workSelect.innerHTML='<option value="">Selecciona unha obra…</option>'+catalogo.map(o=>`<option value="${esc(o.idRepertorio)}">${esc(o.nomeObra)}${o.compositor?' — '+esc(o.compositor):''}</option>`).join('');drawProgram();drawAttendees();manageLoading.hidden=true;showTab(activeTab);}catch(e){manageLoading.textContent=e instanceof Error?e.message:'Non foi posible cargar o concerto.';}}
list.addEventListener('click',e=>{const b=e.target.closest('.manage-btn');if(b)openManage(b.dataset.id)});filter.addEventListener('change',draw);$('#retry').addEventListener('click',load);$('#manage-close').addEventListener('click',()=>manage.close());$('#admin-concertos-logout').addEventListener('click',async()=>{await closePortalSession();location.href='/';});document.querySelectorAll('.tabs [data-tab]').forEach(b=>b.addEventListener('click',()=>showTab(b.dataset.tab)));
$('#add-work').addEventListener('click',()=>{const id=workSelect.value;if(!id)return;if(programa.some(i=>String(i.idRepertorio)===id)){programStatus.textContent='Esa obra xa está no programa.';return;}programa.push({idRepertorio:id,solista:'',notas:''});workSelect.value='';programStatus.textContent='';drawProgram();});
programList.addEventListener('input',e=>{const row=e.target.closest('.program-row'),n=Number(row?.dataset.n);if(!Number.isInteger(n)||!programa[n])return;if(e.target.classList.contains('solista'))programa[n].solista=e.target.value;if(e.target.classList.contains('notas'))programa[n].notas=e.target.value;});
programList.addEventListener('click',e=>{const row=e.target.closest('.program-row'),n=Number(row?.dataset.n);if(!Number.isInteger(n)||!programa[n])return;if(e.target.closest('.remove'))programa.splice(n,1);else if(e.target.closest('.up')&&n>0)[programa[n-1],programa[n]]=[programa[n],programa[n-1]];else if(e.target.closest('.down')&&n<programa.length-1)[programa[n+1],programa[n]]=[programa[n],programa[n+1]];else return;drawProgram();});
attendeesGroups.addEventListener('change',e=>{const input=e.target.closest('input[data-person]');if(!input)return;input.checked?asistentes.add(String(input.dataset.person)):asistentes.delete(String(input.dataset.person));drawAttendees();attendeesStatus.textContent='';});
$('#select-all').addEventListener('click',()=>{persoas.forEach(p=>asistentes.add(String(p.idPersoa)));drawAttendees();});$('#clear-all').addEventListener('click',()=>{asistentes.clear();drawAttendees();});
$('#save-program').addEventListener('click',async()=>{if(!selected)return;programStatus.textContent='Gardando…';try{await request('gardarPrograma',{idConcerto:selected.idConcerto,programa});programStatus.textContent='Programa gardado correctamente.';selected.obras=programa.length;draw();}catch(e){programStatus.textContent=e instanceof Error?e.message:'Non foi posible gardar.';}});
$('#save-attendees').addEventListener('click',async()=>{if(!selected)return;attendeesStatus.textContent='Gardando…';try{await request('gardarAsistentes',{idConcerto:selected.idConcerto,asistentes:[...asistentes]});attendeesStatus.textContent='Asistentes gardados correctamente.';selected.asistencias=asistentes.size;draw();}catch(e){attendeesStatus.textContent=e instanceof Error?e.message:'Non foi posible gardar os asistentes.';}});load();
</script>
<style is:global>
body{background:#f5f3f1}.private-layout{display:flex;min-height:100vh}.admin-concerts-main{flex:1;min-width:0;padding:2rem clamp(1rem,3vw,3.5rem) 4rem}.private-page-header{display:flex;justify-content:space-between;gap:2rem;margin-bottom:1.5rem}.section-kicker{color:var(--color-acento);font-size:.72rem;font-weight:800;text-transform:uppercase}.private-page-header h1{margin:.2rem 0;color:var(--color-principal);font-size:clamp(2rem,4vw,3.4rem)}.private-page-header p{max-width:760px;color:#625c58}.account-card,.state-box,.toolbar,.concert-card{border:1px solid #ded8d3;background:#fff}.account-card{display:grid;gap:.6rem;min-width:230px;padding:1rem}.account-card span{display:grid}.account-card small{font-size:.68rem;text-transform:uppercase}.state-box{padding:1.2rem}.error-box{color:#8b2d36}.toolbar{display:flex;justify-content:space-between;align-items:end;padding:1rem;margin-bottom:1rem}.toolbar label{display:grid;gap:.35rem}.toolbar select,.program-add select,.program-fields input{min-height:2.7rem;padding:.5rem .65rem;border:1px solid #d6cfca;background:#fff;font:inherit}.concert-list{display:grid;gap:.75rem}.concert-card{display:grid;grid-template-columns:minmax(150px,1fr) minmax(260px,2fr) auto auto;align-items:center;gap:1rem;padding:1rem}.concert-card h2{margin:0;font-size:1rem}.concert-card p{margin:.25rem 0;color:#6f6561}.meta{display:flex;gap:.8rem;font-size:.8rem;color:#806f74}.state strong{padding:.3rem .55rem;background:#edf4ef;color:#3f6c50}.primary,.secondary,.tabs button,.close{min-height:2.4rem;padding:.5rem .8rem;border-radius:4px;font-weight:800;cursor:pointer}.primary{border:1px solid #5d142b;background:#5d142b;color:#fff}.secondary{border:1px solid #cfc5c8;background:#fff;color:#4f333b}.manage{width:min(1100px,calc(100vw - 2rem));max-height:92vh;border:0;padding:0}.manage::backdrop{background:rgba(35,27,29,.48)}.manage-shell{padding:1.25rem}.manage header{display:flex;justify-content:space-between;gap:1rem}.manage h2{margin:.15rem 0}.close{border:0;background:transparent;font-size:1.6rem}.tabs{display:flex;gap:.35rem;margin:1rem 0;border-bottom:1px solid #ddd}.tabs button{border:0;background:transparent}.tabs .active{border-bottom:3px solid #5d142b;color:#5d142b}.program-add{display:grid;grid-template-columns:1fr auto;align-items:end;gap:.7rem;padding:1rem;background:#f7f5f3}.program-add label{display:grid;gap:.35rem}.program-list{display:grid;gap:.65rem;margin:1rem 0}.program-row{display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;padding:.9rem;border:1px solid #ddd;background:#fff}.program-row h3{margin:0}.program-row p{margin:.15rem 0 .6rem;color:#6f6561}.order{display:grid;justify-items:center;gap:.15rem}.order button{border:0;background:transparent;cursor:pointer}.program-fields{display:grid;grid-template-columns:1fr 2fr;gap:.6rem}.program-fields label{display:grid;gap:.25rem;font-size:.78rem}.manage footer{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-top:1rem;border-top:1px solid #ddd}#program-status,#attendees-status{color:#6d293d}.attendees-toolbar{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:1rem;background:#f7f5f3}.attendees-toolbar p{margin:.25rem 0 0;color:#6f6561}.attendees-toolbar>div:last-child{display:flex;gap:.45rem}.attendees-groups{display:grid;gap:1rem;margin:1rem 0}.voice-group{border:1px solid #ddd;background:#fff}.voice-group>header{display:flex;justify-content:space-between;padding:.75rem 1rem;background:#f7f5f3}.voice-group h3{margin:0;font-size:1rem}.people-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;padding:.75rem}.person-check{display:flex;align-items:center;gap:.65rem;padding:.65rem;border:1px solid #e3dedb;background:#fff;cursor:pointer}.person-check.selected{border-color:#8b5363;background:#faf5f7}.person-check input{width:1.15rem;height:1.15rem}.person-check span{display:grid}.person-check small{color:#766d69}@media(max-width:900px){.private-layout{display:block}.private-page-header{display:grid}.concert-card{grid-template-columns:1fr 1fr}}@media(max-width:650px){.admin-concerts-main{padding:1rem .8rem 2rem}.concert-card,.program-row,.program-add,.program-fields,.people-grid{grid-template-columns:1fr}.order{display:flex;justify-content:flex-start}.manage footer,.attendees-toolbar{display:grid}.account-card{min-width:0}.attendees-toolbar>div:last-child{flex-wrap:wrap}}
</style>
