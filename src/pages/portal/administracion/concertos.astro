---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de concertos" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-concertos-logout" />
    <main class="admin-concerts-main">
      <header class="private-page-header">
        <div><span class="section-kicker">Administración</span><h1>Administración de concertos</h1><p>Xestiona os concertos e consulta directamente asistentes e repertorio sen modificar o funcionamento do portal privado de concertos.</p></div>
        <div class="account-card"><span><small>Conta identificada</small><strong id="user-email">—</strong></span><span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span></div>
      </header>
      <AdministracionNav active="concertos" />
      <section id="loading" class="state-box">Comprobando permisos e cargando concertos…</section>
      <section id="error-state" class="state-box error-box" hidden><strong>Non foi posible abrir a administración de concertos</strong><p id="error-message"></p><button id="retry" type="button" class="secondary">Tentar de novo</button></section>
      <section id="app" hidden>
        <div class="toolbar"><label><span>Mostrar</span><select id="filter"><option value="todos">Todos</option><option value="Previsto">Previsto</option><option value="Confirmado">Confirmado</option><option value="Aprazado">Aprazado</option><option value="Cancelado">Cancelado</option><option value="Realizado">Realizado</option></select></label><p id="count"></p></div>
        <div id="list" class="concert-list"></div>
      </section>
    </main>
  </div>

  <dialog id="detail-dialog" class="detail-dialog"><div class="detail-shell"><header><div><small id="detail-kicker">Concerto</small><h2 id="detail-title">Detalle</h2><p id="detail-subtitle"></p></div><button type="button" id="detail-close" aria-label="Pechar">×</button></header><div id="detail-content" class="detail-content"></div></div></dialog>
  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" id="date-close">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required /></label><p id="date-status" class="dialog-status"></p><footer><button type="button" id="date-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>
  <dialog id="state-dialog"><form id="state-form"><header><h2>Cambiar estado</h2><button type="button" id="state-close">×</button></header><p id="state-name"></p><label><span>Novo estado</span><select id="new-state"><option>Previsto</option><option>Confirmado</option><option>Aprazado</option><option>Cancelado</option><option>Realizado</option></select></label><p id="state-status" class="dialog-status"></p><footer><button type="button" id="state-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar estado</button></footer></form></dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
  const $=(s)=>document.querySelector(s);
  const esc=(v)=>String(v??'').replace(/[&<>'"]/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  const loading=$('#loading'),errorState=$('#error-state'),errorMessage=$('#error-message'),app=$('#app'),list=$('#list'),filter=$('#filter'),count=$('#count'),userEmail=$('#user-email'),userLevel=$('#user-level'),dateDialog=$('#date-dialog'),stateDialog=$('#state-dialog'),detailDialog=$('#detail-dialog');
  let concertos=[],selected=null;
  const fmt=(v)=>{if(!v)return'Sen data';const d=new Date(`${String(v).slice(0,10)}T12:00:00`);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d)};
  async function request(accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch('/api/concertos-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}
  function visible(){const mode=filter instanceof HTMLSelectElement?filter.value:'todos';return concertos.filter(i=>mode==='todos'||i.estado===mode);}
  function draw(){if(!(list instanceof HTMLElement))return;const rows=visible();if(count instanceof HTMLElement)count.textContent=`${rows.length} concerto${rows.length===1?'':'s'}`;if(!rows.length){list.innerHTML='<section class="state-box">Non hai concertos para este filtro.</section>';return;}list.innerHTML=rows.map(i=>`<article class="concert-card"><div><small>Data</small><strong>${esc(fmt(i.data))}</strong></div><div><h2>${esc(i.nome||'Concerto')}</h2><p>${esc([i.cidade,i.lugar,i.hora].filter(Boolean).join(' · '))}</p><div class="meta"><button type="button" class="link-detail show-repertoire" data-id="${esc(i.idConcerto)}">${Number(i.obras||0)} obras</button><button type="button" class="link-detail show-attendees" data-id="${esc(i.idConcerto)}">${Number(i.asistencias||0)} asistentes</button></div></div><div class="state"><strong>${esc(i.estado||'Sen estado')}</strong></div><div class="actions"><button type="button" class="secondary change-date" data-id="${esc(i.idConcerto)}">Cambiar data</button><button type="button" class="secondary change-state" data-id="${esc(i.idConcerto)}">Cambiar estado</button></div></article>`).join('');}
  function openDetail(kind,item){if(!(detailDialog instanceof HTMLDialogElement))return;const title=$('#detail-title'),subtitle=$('#detail-subtitle'),kicker=$('#detail-kicker'),content=$('#detail-content');if(title instanceof HTMLElement)title.textContent=kind==='attendees'?'Asistentes':'Repertorio';if(kicker instanceof HTMLElement)kicker.textContent=item.nome||'Concerto';if(subtitle instanceof HTMLElement)subtitle.textContent=`${fmt(item.data)}${item.lugar?' · '+item.lugar:''}`;if(!(content instanceof HTMLElement))return;
    if(kind==='attendees'){const all=Array.isArray(item.asistentes)?item.asistentes:[];const rows=all.filter(a=>a.asiste!==false);content.innerHTML=rows.length?`<div class="detail-list">${rows.map(a=>`<article><div><strong>${esc(a.nome||a.idPersoa||'Persoa')}</strong><span>${esc(a.voz||'Sen voz')}</span></div></article>`).join('')}</div>`:'<p class="empty-detail">Non hai asistentes rexistrados para este concerto.</p>';}
    else {const rows=Array.isArray(item.repertorio)?item.repertorio:[];content.innerHTML=rows.length?`<div class="detail-list repertoire-list">${rows.map((o,idx)=>`<article><b>${o.orde||idx+1}</b><div><strong>${esc(o.titulo||o.idRepertorio||'Obra')}</strong>${o.autor?`<span>${esc(o.autor)}</span>`:''}${o.solista?`<small>Solista: ${esc(o.solista)}</small>`:''}${o.notas?`<small>${esc(o.notas)}</small>`:''}</div></article>`).join('')}</div>`:'<p class="empty-detail">Non hai repertorio rexistrado para este concerto.</p>';}
    detailDialog.showModal();
  }
  async function load(){if(loading instanceof HTMLElement)loading.hidden=false;if(errorState instanceof HTMLElement)errorState.hidden=true;if(app instanceof HTMLElement)app.hidden=true;try{const user=await waitForPortalUser();if(!user?.email)throw new Error('Non hai unha sesión válida.');if(userEmail instanceof HTMLElement)userEmail.textContent=user.email;const result=await request('listar');concertos=Array.isArray(result.concertos)?result.concertos:[];if(userLevel instanceof HTMLElement)userLevel.textContent=result.nivel||'Administración';if(loading instanceof HTMLElement)loading.hidden=true;if(app instanceof HTMLElement)app.hidden=false;draw();}catch(error){if(loading instanceof HTMLElement)loading.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Produciuse un erro inesperado.';}}
  filter?.addEventListener('change',draw);$('#retry')?.addEventListener('click',load);$('#admin-concertos-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});
  list?.addEventListener('click',(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement))return;selected=concertos.find(i=>i.idConcerto===target.dataset.id)||null;if(!selected)return;if(target.classList.contains('show-attendees'))return openDetail('attendees',selected);if(target.classList.contains('show-repertoire'))return openDetail('repertoire',selected);if(target.classList.contains('change-date')&&dateDialog instanceof HTMLDialogElement){const name=$('#date-name');if(name instanceof HTMLElement)name.textContent=`${selected.nome||'Concerto'} · ${fmt(selected.data)}`;const input=$('#new-date');if(input instanceof HTMLInputElement)input.value=String(selected.data||'').slice(0,10);const status=$('#date-status');if(status instanceof HTMLElement)status.textContent='';dateDialog.showModal();}if(target.classList.contains('change-state')&&stateDialog instanceof HTMLDialogElement){const name=$('#state-name');if(name instanceof HTMLElement)name.textContent=`${selected.nome||'Concerto'} · ${fmt(selected.data)}`;const input=$('#new-state');if(input instanceof HTMLSelectElement)input.value=selected.estado||'Previsto';const status=$('#state-status');if(status instanceof HTMLElement)status.textContent='';stateDialog.showModal();}});
  const closeDate=()=>dateDialog instanceof HTMLDialogElement&&dateDialog.close(),closeState=()=>stateDialog instanceof HTMLDialogElement&&stateDialog.close();$('#detail-close')?.addEventListener('click',()=>detailDialog instanceof HTMLDialogElement&&detailDialog.close());$('#date-close')?.addEventListener('click',closeDate);$('#date-cancel')?.addEventListener('click',closeDate);$('#state-close')?.addEventListener('click',closeState);$('#state-cancel')?.addEventListener('click',closeState);
  $('#date-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-date'),status=$('#date-status');if(!selected||!(input instanceof HTMLInputElement)||!input.value)return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarData',{idConcerto:selected.idConcerto,data:input.value});closeDate();await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar a data.';}});
  $('#state-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-state'),status=$('#state-status');if(!selected||!(input instanceof HTMLSelectElement))return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarEstado',{idConcerto:selected.idConcerto,estado:input.value});closeState();await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar o estado.';}});load();
</script>

<style is:global>
body{background:#f5f3f1}.private-layout{display:flex;min-height:100vh}.admin-concerts-main{flex:1;min-width:0;padding:2.1rem clamp(1.25rem,3vw,3.5rem) 4rem;font-family:var(--fuente-minimalista)}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.8rem}.section-kicker{color:var(--color-acento);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.private-page-header h1{margin:.2rem 0 .55rem;color:var(--color-principal);font-size:clamp(2rem,4vw,3.5rem)}.private-page-header p{max-width:760px;margin:0;color:#625c58}.account-card{display:grid;gap:.7rem;min-width:250px;padding:1rem 1.15rem;border:1px solid #ded8d3;background:#fff}.account-card span{display:grid;gap:.18rem}.account-card small{color:#77706b;font-size:.68rem;font-weight:700;text-transform:uppercase}.state-box,.toolbar,.concert-card{border:1px solid #ded8d3;background:#fff}.state-box{padding:1.35rem}.error-box{color:#8b2d36}.toolbar{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:1.25rem;padding:1rem 1.15rem}.toolbar label{display:grid;gap:.45rem;width:min(420px,100%)}.toolbar select,dialog input,dialog select{min-height:2.75rem;padding:.55rem .7rem;border:1px solid #d6cfca;background:#fff;font:inherit}.concert-list{display:grid;gap:.8rem}.concert-card{display:grid;grid-template-columns:minmax(190px,1.1fr) minmax(260px,2fr) auto auto;align-items:center;gap:1.2rem;padding:1rem 1.15rem}.concert-card small{display:block;color:#806f74;font-size:.7rem;font-weight:800;text-transform:uppercase}.concert-card h2{margin:0 0 .25rem;color:var(--color-principal);font-size:1rem}.concert-card p{margin:0;color:#6f6561;font-size:.88rem}.meta{display:flex;gap:.6rem;margin-top:.55rem}.link-detail{min-height:auto!important;padding:0!important;border:0!important;background:transparent!important;color:#5d142b;text-decoration:underline;text-underline-offset:3px;font-size:.8rem}.state strong{display:inline-flex;padding:.32rem .55rem;border-radius:999px;background:#edf4ef;color:#3f6c50;font-size:.75rem}.actions{display:flex;gap:.45rem}.admin-concerts-main button{min-height:2.35rem;padding:.5rem .8rem;border-radius:4px;cursor:pointer;font-weight:800}.secondary{border:1px solid #cfc5c8;background:#fff;color:#4f333b}.primary{border:1px solid #5d142b;background:#5d142b;color:#fff}dialog{width:min(520px,calc(100vw - 2rem));border:0;padding:0;box-shadow:0 18px 60px rgba(0,0,0,.22)}dialog::backdrop{background:rgba(35,27,29,.45)}dialog form,.detail-shell{padding:1.25rem}dialog header,dialog footer{display:flex;align-items:center;justify-content:space-between;gap:1rem}dialog header{padding-bottom:1rem;border-bottom:1px solid #e7e0dd}dialog header h2{margin:0;font-size:1.15rem}dialog header p{margin:.2rem 0 0;color:#766c68;font-size:.82rem}dialog header button{min-height:auto;border:0;background:transparent;font-size:1.5rem}dialog label{display:grid;gap:.4rem;margin:1rem 0}dialog footer{justify-content:flex-end;padding-top:1rem;border-top:1px solid #e7e0dd}.dialog-status{min-height:1.4rem;color:#7f343d;font-size:.85rem}.detail-dialog{width:min(720px,calc(100vw - 2rem))}.detail-content{padding-top:1rem}.detail-list{display:grid;gap:.55rem}.detail-list article{display:flex;align-items:flex-start;gap:.85rem;padding:.8rem .9rem;border:1px solid #e4ded9;background:#fff}.detail-list article>div{display:grid;gap:.15rem}.detail-list strong{color:#3f3035}.detail-list span,.detail-list small{color:#756b67;font-size:.8rem}.repertoire-list b{min-width:1.6rem;color:#5d142b}.empty-detail{margin:.5rem 0;color:#756b67}@media(max-width:980px){.concert-card{grid-template-columns:1fr 1fr}}@media(max-width:900px){.private-layout{display:block}.private-page-header,.toolbar{display:grid}.account-card{min-width:0}}@media(max-width:620px){.admin-concerts-main{padding:1.15rem .9rem 2.5rem}.concert-card{grid-template-columns:1fr}.actions{flex-wrap:wrap}}
</style>
