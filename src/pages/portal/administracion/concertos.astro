---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de concertos" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-concertos-logout" />
    <main class="admin-concerts-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Administración</span>
          <h1>Administración de concertos</h1>
          <p>Alta, baixa e mantemento administrativo dos concertos, conservando sempre o seu identificador e as relacións existentes.</p>
        </div>
        <div class="account-card"><span><small>Conta identificada</small><strong id="user-email">—</strong></span><span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span></div>
      </header>
      <AdministracionNav active="concertos" />
      <section id="loading" class="state-box">Comprobando permisos e cargando concertos…</section>
      <section id="error-state" class="state-box error-box" hidden><strong>Non foi posible abrir a administración de concertos</strong><p id="error-message"></p><button id="retry" type="button" class="secondary">Tentar de novo</button></section>
      <section id="app" hidden>
        <div class="toolbar">
          <label><span>Mostrar</span><select id="filter"><option value="todos">Todos</option><option value="Previsto">Previsto</option><option value="Confirmado">Confirmado</option><option value="Aprazado">Aprazado</option><option value="Cancelado">Cancelado</option><option value="Realizado">Realizado</option></select></label>
          <div class="toolbar-actions"><p id="count"></p><button id="new-concert" type="button" class="primary">+ Novo concerto</button></div>
        </div>
        <div id="list" class="concert-list"></div>
      </section>
    </main>
  </div>

  <dialog id="create-dialog" class="wide-dialog">
    <form id="create-form">
      <header><h2>Novo concerto</h2><button type="button" id="create-close">×</button></header>
      <div class="form-grid">
        <label><span>Data</span><input id="create-date" type="date" required /></label>
        <label><span>Hora</span><input id="create-time" type="time" /></label>
        <label class="span-2"><span>Nome ou título</span><input id="create-name" type="text" maxlength="250" required /></label>
        <label><span>Cidade</span><input id="create-city" type="text" maxlength="150" /></label>
        <label><span>Lugar</span><input id="create-place" type="text" maxlength="250" /></label>
        <label class="span-2"><span>Características / descrición</span><textarea id="create-description" rows="4" maxlength="3000"></textarea></label>
        <label><span>Estado inicial</span><select id="create-state"><option>Previsto</option><option>Confirmado</option><option>Aprazado</option><option>Cancelado</option><option>Realizado</option></select></label>
        <div class="checks"><label><input id="create-web" type="checkbox" /> <span>Mostrar na web</span></label><label><input id="create-featured" type="checkbox" /> <span>Destacado na web</span></label></div>
      </div>
      <p id="create-status" class="dialog-status"></p>
      <footer><button type="button" id="create-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Crear concerto</button></footer>
    </form>
  </dialog>

  <dialog id="delete-dialog">
    <form id="delete-form">
      <header><h2>Dar de baixa concerto</h2><button type="button" id="delete-close">×</button></header>
      <p id="delete-name"></p>
      <p class="warning-copy">A baixa elimina a ficha principal do concerto. Por seguridade, non se permitirá se xa ten programa, asistencias, medios asociados ou numeración histórica.</p>
      <p id="delete-status" class="dialog-status"></p>
      <footer><button type="button" id="delete-cancel" class="secondary">Cancelar</button><button type="submit" class="danger">Dar de baixa</button></footer>
    </form>
  </dialog>

  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" id="date-close">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required /></label><p id="date-status" class="dialog-status"></p><footer><button type="button" id="date-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>
  <dialog id="state-dialog"><form id="state-form"><header><h2>Cambiar estado</h2><button type="button" id="state-close">×</button></header><p id="state-name"></p><label><span>Novo estado</span><select id="new-state"><option>Previsto</option><option>Confirmado</option><option>Aprazado</option><option>Cancelado</option><option>Realizado</option></select></label><p id="state-status" class="dialog-status"></p><footer><button type="button" id="state-cancel" class="secondary">Cancelar</button><button type="submit" class="primary">Gardar estado</button></footer></form></dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
  const $=(s)=>document.querySelector(s);
  const loading=$('#loading'),errorState=$('#error-state'),errorMessage=$('#error-message'),app=$('#app'),list=$('#list'),filter=$('#filter'),count=$('#count'),userEmail=$('#user-email'),userLevel=$('#user-level');
  const createDialog=$('#create-dialog'),deleteDialog=$('#delete-dialog'),dateDialog=$('#date-dialog'),stateDialog=$('#state-dialog');
  let concertos=[],selected=null;
  const fmt=(v)=>{if(!v)return'Sen data';const d=new Date(`${String(v).slice(0,10)}T12:00:00`);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d)};
  const esc=(v='')=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');

  async function request(accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch('/api/concertos-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}
  function visible(){const mode=filter instanceof HTMLSelectElement?filter.value:'todos';return concertos.filter(i=>mode==='todos'||i.estado===mode);}
  function draw(){if(!(list instanceof HTMLElement))return;const rows=visible();if(count instanceof HTMLElement)count.textContent=`${rows.length} concerto${rows.length===1?'':'s'}`;if(!rows.length){list.innerHTML='<section class="state-box">Non hai concertos para este filtro.</section>';return;}list.innerHTML=rows.map(i=>`<article class="concert-card"><div><small>Data</small><strong>${esc(fmt(i.data))}</strong></div><div><h2>${esc(i.nome||'Concerto')}</h2><p>${esc([i.cidade,i.lugar,i.hora].filter(Boolean).join(' · '))}</p><div class="meta"><span>${Number(i.obras||0)} obras</span><span>${Number(i.asistencias||0)} asistencias</span></div></div><div class="state"><strong>${esc(i.estado||'Sen estado')}</strong></div><div class="actions"><button type="button" class="secondary change-date" data-id="${esc(i.idConcerto)}">Cambiar data</button><button type="button" class="secondary change-state" data-id="${esc(i.idConcerto)}">Cambiar estado</button><button type="button" class="danger-outline delete-concert" data-id="${esc(i.idConcerto)}">Dar de baixa</button></div></article>`).join('');}
  async function load(){if(loading instanceof HTMLElement)loading.hidden=false;if(errorState instanceof HTMLElement)errorState.hidden=true;if(app instanceof HTMLElement)app.hidden=true;try{const user=await waitForPortalUser();if(!user?.email)throw new Error('Non hai unha sesión válida.');if(userEmail instanceof HTMLElement)userEmail.textContent=user.email;const result=await request('listar');concertos=Array.isArray(result.concertos)?result.concertos:[];if(userLevel instanceof HTMLElement)userLevel.textContent=result.nivel||'Administración';if(loading instanceof HTMLElement)loading.hidden=true;if(app instanceof HTMLElement)app.hidden=false;draw();}catch(error){if(loading instanceof HTMLElement)loading.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Produciuse un erro inesperado.';}}

  filter?.addEventListener('change',draw);$('#retry')?.addEventListener('click',load);$('#admin-concertos-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});
  $('#new-concert')?.addEventListener('click',()=>{const form=$('#create-form');if(form instanceof HTMLFormElement)form.reset();const state=$('#create-state');if(state instanceof HTMLSelectElement)state.value='Previsto';const status=$('#create-status');if(status instanceof HTMLElement)status.textContent='';if(createDialog instanceof HTMLDialogElement)createDialog.showModal();});

  list?.addEventListener('click',(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement))return;selected=concertos.find(i=>i.idConcerto===target.dataset.id)||null;if(!selected)return;if(target.classList.contains('change-date')&&dateDialog instanceof HTMLDialogElement){const name=$('#date-name');if(name instanceof HTMLElement)name.textContent=`${selected.nome||'Concerto'} · ${fmt(selected.data)}`;const input=$('#new-date');if(input instanceof HTMLInputElement)input.value=String(selected.data||'').slice(0,10);const status=$('#date-status');if(status instanceof HTMLElement)status.textContent='';dateDialog.showModal();}if(target.classList.contains('change-state')&&stateDialog instanceof HTMLDialogElement){const name=$('#state-name');if(name instanceof HTMLElement)name.textContent=`${selected.nome||'Concerto'} · ${fmt(selected.data)}`;const input=$('#new-state');if(input instanceof HTMLSelectElement)input.value=selected.estado||'Previsto';const status=$('#state-status');if(status instanceof HTMLElement)status.textContent='';stateDialog.showModal();}if(target.classList.contains('delete-concert')&&deleteDialog instanceof HTMLDialogElement){const name=$('#delete-name');if(name instanceof HTMLElement)name.textContent=`${selected.nome||'Concerto'} · ${fmt(selected.data)}`;const status=$('#delete-status');if(status instanceof HTMLElement)status.textContent='';deleteDialog.showModal();}});

  const close=(dialog)=>dialog instanceof HTMLDialogElement&&dialog.close();
  $('#create-close')?.addEventListener('click',()=>close(createDialog));$('#create-cancel')?.addEventListener('click',()=>close(createDialog));
  $('#delete-close')?.addEventListener('click',()=>close(deleteDialog));$('#delete-cancel')?.addEventListener('click',()=>close(deleteDialog));
  $('#date-close')?.addEventListener('click',()=>close(dateDialog));$('#date-cancel')?.addEventListener('click',()=>close(dateDialog));
  $('#state-close')?.addEventListener('click',()=>close(stateDialog));$('#state-cancel')?.addEventListener('click',()=>close(stateDialog));

  $('#create-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const status=$('#create-status');const data=$('#create-date'),nome=$('#create-name'),cidade=$('#create-city'),lugar=$('#create-place'),hora=$('#create-time'),caracteristicas=$('#create-description'),estado=$('#create-state'),mostrarWeb=$('#create-web'),destacadoWeb=$('#create-featured');if(!(data instanceof HTMLInputElement)||!(nome instanceof HTMLInputElement)||!(estado instanceof HTMLSelectElement))return;try{if(status instanceof HTMLElement)status.textContent='Creando concerto…';await request('crear',{data:data.value,nome:nome.value,cidade:cidade instanceof HTMLInputElement?cidade.value:'',lugar:lugar instanceof HTMLInputElement?lugar.value:'',hora:hora instanceof HTMLInputElement?hora.value:'',caracteristicas:caracteristicas instanceof HTMLTextAreaElement?caracteristicas.value:'',estado:estado.value,mostrarWeb:mostrarWeb instanceof HTMLInputElement&&mostrarWeb.checked,destacadoWeb:destacadoWeb instanceof HTMLInputElement&&destacadoWeb.checked});close(createDialog);await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible crear o concerto.';}});
  $('#delete-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const status=$('#delete-status');if(!selected)return;try{if(status instanceof HTMLElement)status.textContent='Dando de baixa…';await request('eliminar',{idConcerto:selected.idConcerto});close(deleteDialog);selected=null;await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible dar de baixa o concerto.';}});
  $('#date-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-date'),status=$('#date-status');if(!selected||!(input instanceof HTMLInputElement)||!input.value)return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarData',{idConcerto:selected.idConcerto,data:input.value});close(dateDialog);await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar a data.';}});
  $('#state-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-state'),status=$('#state-status');if(!selected||!(input instanceof HTMLSelectElement))return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarEstado',{idConcerto:selected.idConcerto,estado:input.value});close(stateDialog);await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar o estado.';}});
  load();
</script>

<style is:global>
body{background:#f5f3f1}.private-layout{display:flex;min-height:100vh}.admin-concerts-main{flex:1;min-width:0;padding:2.1rem clamp(1.25rem,3vw,3.5rem) 4rem;font-family:var(--fuente-minimalista)}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.8rem}.section-kicker{color:var(--color-acento);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.private-page-header h1{margin:.2rem 0 .55rem;color:var(--color-principal);font-size:clamp(2rem,4vw,3.5rem)}.private-page-header p{max-width:760px;margin:0;color:#625c58}.account-card{display:grid;gap:.7rem;min-width:250px;padding:1rem 1.15rem;border:1px solid #ded8d3;background:#fff}.account-card span{display:grid;gap:.18rem}.account-card small{color:#77706b;font-size:.68rem;font-weight:700;text-transform:uppercase}.state-box,.toolbar,.concert-card{border:1px solid #ded8d3;background:#fff}.state-box{padding:1.35rem}.error-box{color:#8b2d36}.toolbar{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:1.25rem;padding:1rem 1.15rem}.toolbar>label{display:grid;gap:.45rem;width:min(420px,100%)}.toolbar-actions{display:flex;align-items:center;gap:1rem}.toolbar-actions p{margin:0}.toolbar select,dialog input,dialog select,dialog textarea{min-height:2.75rem;padding:.55rem .7rem;border:1px solid #d6cfca;background:#fff;font:inherit}.concert-list{display:grid;gap:.8rem}.concert-card{display:grid;grid-template-columns:minmax(190px,1.1fr) minmax(260px,2fr) auto auto;align-items:center;gap:1.2rem;padding:1rem 1.15rem}.concert-card small{display:block;color:#806f74;font-size:.7rem;font-weight:800;text-transform:uppercase}.concert-card h2{margin:0 0 .25rem;color:var(--color-principal);font-size:1rem}.concert-card p{margin:0;color:#6f6561;font-size:.88rem}.meta{display:flex;gap:.7rem;margin-top:.45rem;color:#806f74;font-size:.78rem}.state strong{display:inline-flex;padding:.32rem .55rem;border-radius:999px;background:#edf4ef;color:#3f6c50;font-size:.75rem}.actions{display:flex;gap:.45rem;flex-wrap:wrap}.admin-concerts-main button{min-height:2.35rem;padding:.5rem .8rem;border-radius:4px;cursor:pointer;font-weight:800}.secondary{border:1px solid #cfc5c8;background:#fff;color:#4f333b}.primary{border:1px solid #5d142b;background:#5d142b;color:#fff}.danger{border:1px solid #8b2d36;background:#8b2d36;color:#fff}.danger-outline{border:1px solid #b89a9f;background:#fff;color:#8b2d36}dialog{width:min(520px,calc(100vw - 2rem));border:0;padding:0;box-shadow:0 18px 60px rgba(0,0,0,.22)}dialog.wide-dialog{width:min(760px,calc(100vw - 2rem))}dialog::backdrop{background:rgba(35,27,29,.45)}dialog form{padding:1.25rem}dialog header,dialog footer{display:flex;align-items:center;justify-content:space-between;gap:1rem}dialog header{padding-bottom:1rem;border-bottom:1px solid #e7e0dd}dialog header h2{margin:0;font-size:1.15rem}dialog header button{min-height:auto;border:0;background:transparent;font-size:1.5rem}dialog label{display:grid;gap:.4rem;margin:1rem 0}dialog textarea{resize:vertical}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 1rem}.span-2{grid-column:1/-1}.checks{display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap}.checks label{display:flex;align-items:center;gap:.45rem;margin:.25rem 0}.checks input{min-height:auto;width:auto}.warning-copy{padding:.8rem 1rem;background:#fbf5f2;border-left:3px solid #8b2d36;color:#6d444b;font-size:.9rem}dialog footer{justify-content:flex-end;padding-top:1rem;border-top:1px solid #e7e0dd}.dialog-status{min-height:1.4rem;color:#7f343d;font-size:.85rem}@media(max-width:1100px){.concert-card{grid-template-columns:1fr 1.4fr}.state,.actions{justify-self:start}}@media(max-width:900px){.private-layout{display:block}.private-page-header,.toolbar{display:grid}.account-card{min-width:0}.toolbar-actions{justify-content:space-between}}@media(max-width:620px){.admin-concerts-main{padding:1.15rem .9rem 2.5rem}.concert-card{grid-template-columns:1fr}.actions{width:100%}.form-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.toolbar-actions{align-items:stretch;flex-direction:column}.toolbar-actions .primary{width:100%}}
</style>
