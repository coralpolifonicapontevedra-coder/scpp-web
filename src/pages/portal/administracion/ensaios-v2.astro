---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de ensaios v2" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-v2-logout" />
    <main class="admin-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Administración</span>
          <h1>Administración de ensaios</h1>
          <p>Alta, xestión de asistencia, cambio de data, baixa e eliminación.</p>
        </div>
        <div class="account-card">
          <span><small>Conta identificada</small><strong id="user-email">—</strong></span>
          <span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span>
        </div>
      </header>

      <AdministracionNav active="ensaios" />

      <section id="loading" class="state-box">Comprobando permisos e cargando ensaios…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir a administración de ensaios</strong>
        <p id="error-message"></p>
        <button id="retry" type="button" class="secondary">Tentar de novo</button>
      </section>

      <section id="app" hidden>
        <div class="toolbar">
          <label><span>Mostrar</span><select id="filter"><option value="activos">Ensaios activos</option><option value="todos">Todos</option><option value="baixa">Dados de baixa</option></select></label>
          <p id="count"></p>
          <button id="new-rehearsal" type="button" class="primary">Alta de ensaio</button>
        </div>
        <div id="list" class="rehearsal-list"></div>
      </section>
    </main>
  </div>

  <dialog id="new-dialog" class="wide-dialog"><form id="new-form">
    <header><h2>Alta de ensaio</h2><button type="button" data-close="new-dialog">×</button></header>
    <div class="form-grid">
      <label><span>Data *</span><input name="data" type="date" required /></label>
      <label><span>Hora de inicio *</span><input name="horaInicio" type="time" required value="20:00" /></label>
      <label><span>Hora de fin</span><input name="horaFin" type="time" /></label>
      <label><span>Tipo de ensaio *</span><input name="tipoEnsaio" required value="Ensaio ordinario" /></label>
      <label class="span-2"><span>Lugar</span><input name="lugar" value="Centro Social Sur - Luís Braille 40" /></label>
      <label class="span-2"><span>Concerto relacionado</span><input name="concerto" /></label>
      <label class="span-2"><span>Descrición</span><textarea name="descricion" rows="2"></textarea></label>
      <label class="span-2"><span>Observacións</span><textarea name="observacions" rows="2"></textarea></label>
    </div>
    <p id="new-status" class="dialog-status"></p>
    <footer><button type="button" class="secondary" data-close="new-dialog">Cancelar</button><button type="submit" class="primary">Crear ensaio</button></footer>
  </form></dialog>

  <dialog id="manage-dialog" class="manage-dialog"><section class="manage-shell">
    <header><div><small>Xestión integral</small><h2 id="manage-title">Ensaio</h2></div><button type="button" data-close="manage-dialog">×</button></header>
    <nav class="manage-tabs"><button type="button" class="is-active">Asistencia</button><button type="button" disabled>Obras</button><button type="button" disabled>Análise</button></nav>
    <section class="manage-panel">
      <div class="attendance-summary"><strong id="attendance-summary">0 rexistros</strong><span>Marca a situación de cada coralista e garda os cambios.</span></div>
      <div id="people-list"></div>
    </section>
    <footer class="manage-footer"><p id="manage-status" class="dialog-status"></p><button id="save-attendance" type="button" class="primary">Gardar asistencia</button></footer>
  </section></dialog>

  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" data-close="date-dialog">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required /></label><p id="date-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="date-dialog">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>

  <dialog id="cancel-dialog"><form id="cancel-form"><header><h2>Dar de baixa</h2><button type="button" data-close="cancel-dialog">×</button></header><p id="cancel-name"></p><p>O ensaio quedará marcado como cancelado e conservará as relacións existentes.</p><p id="cancel-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="cancel-dialog">Cancelar</button><button type="submit" class="danger">Dar de baixa</button></footer></form></dialog>

  <dialog id="delete-dialog"><form id="delete-form"><header><h2>Eliminar ensaio</h2><button type="button" data-close="delete-dialog">×</button></header><p id="delete-name"></p><p><strong>Esta acción non se pode desfacer.</strong> Eliminarase tamén a información asociada segundo as regras do backend.</p><label><span>Escribe ELIMINAR para confirmar</span><input id="delete-confirm" autocomplete="off" /></label><p id="delete-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="delete-dialog">Cancelar</button><button id="delete-submit" type="submit" class="danger-solid" disabled>Eliminar definitivamente</button></footer></form></dialog>
</BaseLayout>

<script>
import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
const $=(s)=>document.querySelector(s);
const loading=$('#loading'),errorState=$('#error-state'),errorMessage=$('#error-message'),app=$('#app'),list=$('#list'),filter=$('#filter'),count=$('#count'),userEmail=$('#user-email'),userLevel=$('#user-level');
const newDialog=$('#new-dialog'),manageDialog=$('#manage-dialog'),dateDialog=$('#date-dialog'),cancelDialog=$('#cancel-dialog'),deleteDialog=$('#delete-dialog');
let ensaios=[],selected=null,xestion={persoas:[]};
const esc=(v='')=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
const fmt=(v)=>{if(!v)return'Sen data';const d=new Date(`${String(v).slice(0,10)}T12:00:00`);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d)};
const personName=(p)=>[p.primeiroApelido,p.segundoApelido,p.nome].filter(Boolean).join(' ')||p.nomeCompleto||'';

async function request(accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch('/api/ensaios-admin-v2',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}
async function manageRequest(accion,extra={}){const user=auth.currentUser;if(!user?.email)throw new Error('A sesión non está activa.');const idToken=await user.getIdToken();const response=await fetch('/api/ensaios-admin-v2-xestion',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,idEnsaio:selected?.idEnsaio,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro HTTP ${response.status}`);return result;}
function visible(){const mode=filter instanceof HTMLSelectElement?filter.value:'activos';return ensaios.filter(i=>mode==='todos'||(mode==='baixa'?i.cancelado:!i.cancelado));}

function draw(){if(!(list instanceof HTMLElement))return;const rows=visible();if(count instanceof HTMLElement)count.textContent=`${rows.length} ensaio${rows.length===1?'':'s'}`;if(!rows.length){list.innerHTML='<section class="state-box">Non hai ensaios para este filtro.</section>';return;}list.innerHTML=rows.map(i=>`<article class="rehearsal-card ${i.cancelado?'is-cancelled':''}">
  <div class="date-cell"><small>Data</small><strong>${esc(fmt(i.data))}</strong></div>
  <div class="info-cell"><h2>${esc(i.tipoEnsaio||'Ensaio')}</h2><p>${esc([i.horaInicio,i.lugar,i.concertoNome||i.concerto].filter(Boolean).join(' · '))}</p><div class="meta"><span><small>Obras</small><strong>${Number(i.obras||0)}</strong></span><span><small>Asistencias</small><strong>${Number(i.asistencias||0)}</strong></span></div></div>
  <div class="state-cell"><small>Estado</small><strong>${i.cancelado?'Baixa':'Activo'}</strong></div>
  <div class="actions"><button type="button" class="primary manage-rehearsal" data-id="${esc(i.idEnsaio)}">Xestionar</button><button type="button" class="secondary change-date" data-id="${esc(i.idEnsaio)}">Cambiar data</button>${i.cancelado?'':`<button type="button" class="secondary cancel-rehearsal" data-id="${esc(i.idEnsaio)}">Dar de baixa</button>`}<button type="button" class="danger delete-rehearsal" data-id="${esc(i.idEnsaio)}">Eliminar</button></div>
</article>`).join('');}

async function load(){if(loading instanceof HTMLElement)loading.hidden=false;if(errorState instanceof HTMLElement)errorState.hidden=true;if(app instanceof HTMLElement)app.hidden=true;try{const user=await waitForPortalUser();if(!user?.email)throw new Error('Non hai unha sesión válida.');if(userEmail instanceof HTMLElement)userEmail.textContent=user.email;const result=await request('listar');ensaios=Array.isArray(result.ensaios)?result.ensaios:[];if(userLevel instanceof HTMLElement)userLevel.textContent=result.nivel||'Administración';if(loading instanceof HTMLElement)loading.hidden=true;if(app instanceof HTMLElement)app.hidden=false;draw();}catch(error){if(loading instanceof HTMLElement)loading.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Produciuse un erro inesperado.';}}

function pintarPersoas(){const box=$('#people-list'),summary=$('#attendance-summary');if(!(box instanceof HTMLElement))return;const voces=['Soprano','Contralto','Tenor','Baixo'];const marcadas=xestion.persoas.filter(p=>p.estado).length;if(summary instanceof HTMLElement)summary.textContent=`${marcadas} de ${xestion.persoas.length} marcados`;box.innerHTML=voces.map(v=>{const ps=xestion.persoas.filter(p=>String(p.voz).toLowerCase()===v.toLowerCase()).sort((a,b)=>personName(a).localeCompare(personName(b),'gl'));if(!ps.length)return'';return`<section class="voice-group"><h3>${v}<span>${ps.length}</span></h3>${ps.map(p=>`<article class="attendance-person" data-person="${esc(p.id)}"><strong>${esc(personName(p))}</strong><div class="attendance-actions"><button type="button" data-attendance="asiste" class="${p.estado==='asiste'?'is-selected':''}">Asiste</button><button type="button" data-attendance="non_asiste" class="${p.estado==='non_asiste'?'is-selected is-negative':''}">Non asiste</button><button type="button" data-attendance="xustificada" class="${p.estado==='xustificada'?'is-selected is-justified':''}">Non asiste con xustificación</button></div><label class="justification" ${p.estado==='xustificada'?'':'hidden'}><span>Xustificación</span><input data-justification value="${esc(p.xustificacion||'')}" placeholder="Indica o motivo" /></label></article>`).join('')}</section>`}).join('');}

async function abrirXestion(item){selected=item;if(!(manageDialog instanceof HTMLDialogElement))return;const title=$('#manage-title'),status=$('#manage-status');if(title instanceof HTMLElement)title.textContent=`${item.tipoEnsaio} · ${fmt(item.data)}`;if(status instanceof HTMLElement)status.textContent='Cargando asistencia…';manageDialog.showModal();try{const result=await manageRequest('obterXestion');xestion={persoas:Array.isArray(result.persoas)?result.persoas:[]};pintarPersoas();if(status instanceof HTMLElement)status.textContent='';}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cargar a asistencia.';}}
function closeDialog(id){const el=document.getElementById(id);if(el instanceof HTMLDialogElement)el.close();}

document.querySelectorAll('[data-close]').forEach(btn=>btn.addEventListener('click',()=>closeDialog(btn.getAttribute('data-close')||'')));
filter?.addEventListener('change',draw);$('#retry')?.addEventListener('click',load);$('#new-rehearsal')?.addEventListener('click',()=>{const form=$('#new-form');if(form instanceof HTMLFormElement)form.reset();const start=form?.elements.namedItem('horaInicio');if(start instanceof HTMLInputElement)start.value='20:00';const type=form?.elements.namedItem('tipoEnsaio');if(type instanceof HTMLInputElement)type.value='Ensaio ordinario';const place=form?.elements.namedItem('lugar');if(place instanceof HTMLInputElement)place.value='Centro Social Sur - Luís Braille 40';if(newDialog instanceof HTMLDialogElement)newDialog.showModal();});$('#admin-ensaios-v2-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});

list?.addEventListener('click',(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement))return;selected=ensaios.find(i=>i.idEnsaio===target.dataset.id)||null;if(!selected)return;if(target.classList.contains('manage-rehearsal'))abrirXestion(selected);if(target.classList.contains('change-date')){const p=$('#date-name');if(p instanceof HTMLElement)p.textContent=`${selected.tipoEnsaio} · ${fmt(selected.data)}`;const input=$('#new-date');if(input instanceof HTMLInputElement)input.value=selected.data||'';if(dateDialog instanceof HTMLDialogElement)dateDialog.showModal();}if(target.classList.contains('cancel-rehearsal')){const p=$('#cancel-name');if(p instanceof HTMLElement)p.textContent=`${selected.tipoEnsaio} · ${fmt(selected.data)}`;if(cancelDialog instanceof HTMLDialogElement)cancelDialog.showModal();}if(target.classList.contains('delete-rehearsal')){const p=$('#delete-name');if(p instanceof HTMLElement)p.textContent=`${selected.tipoEnsaio} · ${fmt(selected.data)}`;const confirm=$('#delete-confirm'),submit=$('#delete-submit');if(confirm instanceof HTMLInputElement)confirm.value='';if(submit instanceof HTMLButtonElement)submit.disabled=true;if(deleteDialog instanceof HTMLDialogElement)deleteDialog.showModal();}});

$('#people-list')?.addEventListener('click',(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement)||!target.dataset.attendance)return;const row=target.closest('[data-person]');const id=row?.getAttribute('data-person');const p=xestion.persoas.find(x=>x.id===id);if(!p)return;p.estado=target.dataset.attendance;pintarPersoas();});
$('#people-list')?.addEventListener('input',(event)=>{const target=event.target;if(!(target instanceof HTMLInputElement)||!target.matches('[data-justification]'))return;const row=target.closest('[data-person]');const p=xestion.persoas.find(x=>x.id===row?.getAttribute('data-person'));if(p)p.xustificacion=target.value;});
$('#save-attendance')?.addEventListener('click',async()=>{const status=$('#manage-status');try{const selectedRows=xestion.persoas.filter(p=>p.estado);if(status instanceof HTMLElement)status.textContent='Gardando asistencia…';const result=await manageRequest('gardarAsistencias',{persoas:selectedRows});if(status instanceof HTMLElement)status.textContent=`Gardados ${result.gardadas||0} rexistros.`;await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible gardar a asistencia.';}});

$('#new-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget;if(!(form instanceof HTMLFormElement))return;const status=$('#new-status');const data=Object.fromEntries(new FormData(form).entries());try{if(status instanceof HTMLElement)status.textContent='Creando…';await request('crear',data);closeDialog('new-dialog');await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible crear o ensaio.';}});
$('#date-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-date'),status=$('#date-status');if(!selected||!(input instanceof HTMLInputElement)||!input.value)return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('cambiarData',{idEnsaio:selected.idEnsaio,data:input.value});closeDialog('date-dialog');await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible cambiar a data.';}});
$('#cancel-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const status=$('#cancel-status');if(!selected)return;try{if(status instanceof HTMLElement)status.textContent='Gardando…';await request('darBaixa',{idEnsaio:selected.idEnsaio});closeDialog('cancel-dialog');await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible dar de baixa o ensaio.';}});
$('#delete-confirm')?.addEventListener('input',(event)=>{const target=event.target,submit=$('#delete-submit');if(target instanceof HTMLInputElement&&submit instanceof HTMLButtonElement)submit.disabled=target.value.trim()!=='ELIMINAR';});
$('#delete-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const status=$('#delete-status');if(!selected)return;try{if(status instanceof HTMLElement)status.textContent='Eliminando…';await request('eliminar',{idEnsaio:selected.idEnsaio});closeDialog('delete-dialog');await load();}catch(error){if(status instanceof HTMLElement)status.textContent=error instanceof Error?error.message:'Non foi posible eliminar o ensaio.';}});
load();
</script>

<style is:global>
.admin-main{padding:2rem;min-width:0}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.private-page-header h1{font-size:clamp(2rem,4vw,3.2rem);margin:.25rem 0}.section-kicker{color:#b58a3b;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.account-card,.state-box,.toolbar,.rehearsal-card{border:1px solid #ddd5d1;background:#fff}.account-card{min-width:250px;padding:1rem;display:grid;gap:1rem}.account-card span,.date-cell,.state-cell{display:grid;gap:.35rem}.account-card small,.rehearsal-card small{font-size:.72rem;text-transform:uppercase;color:#756d69;font-weight:700;letter-spacing:.04em}.toolbar{display:flex;align-items:end;gap:1rem;padding:1rem;margin:1.5rem 0}.toolbar label{display:grid;gap:.35rem}.toolbar p{margin:0 auto 0 0}.rehearsal-list{display:grid;gap:1rem}.rehearsal-card{display:grid;grid-template-columns:220px minmax(260px,1fr) 100px auto;gap:1.25rem;align-items:center;padding:1.15rem}.rehearsal-card h2{margin:0 0 .4rem;color:#74162f}.rehearsal-card p{margin:0;color:#6f6865}.meta{display:flex;gap:1rem;margin-top:.8rem}.meta span{display:grid;gap:.15rem}.meta strong{font-size:.95rem}.actions{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:flex-end}.is-cancelled{opacity:.72}.state-box{padding:1.25rem}.error-box{color:#6e2433}button{padding:.75rem 1rem;border:1px solid #cfc3bf;background:#fff;cursor:pointer}.primary{background:#74162f;color:#fff;border-color:#74162f}.danger,.danger-solid{color:#74162f;border-color:#74162f}.danger-solid{background:#74162f;color:#fff}dialog{width:min(92vw,620px);border:1px solid #d7ceca;padding:0}dialog form,.manage-shell{padding:1.25rem}dialog header,dialog footer,.manage-shell>header,.manage-footer{display:flex;justify-content:space-between;align-items:center;gap:1rem}.manage-dialog{width:min(96vw,1080px)}.manage-shell>header small{display:block;text-transform:uppercase;color:#756d69;font-size:.72rem}.manage-shell h2{margin:.2rem 0}.manage-tabs{display:flex;gap:.4rem;border-top:1px solid #e3dcda;border-bottom:1px solid #e3dcda;padding:.8rem 0;margin:1rem 0}.manage-tabs .is-active{background:#74162f;color:#fff;border-color:#74162f}.manage-panel{min-height:260px}.attendance-summary{display:flex;justify-content:space-between;gap:1rem;margin-bottom:1rem;color:#6f6865}.voice-group{margin:0 0 1.2rem}.voice-group h3{display:flex;justify-content:space-between;border-bottom:1px solid #e1d9d5;padding-bottom:.5rem;color:#74162f}.attendance-person{display:grid;grid-template-columns:minmax(180px,1fr) auto;gap:.8rem;padding:.75rem 0;border-bottom:1px solid #eee8e5;align-items:center}.attendance-actions{display:flex;gap:.35rem;flex-wrap:wrap}.attendance-actions button{padding:.55rem .7rem}.attendance-actions .is-selected{background:#315c45;color:#fff;border-color:#315c45}.attendance-actions .is-selected.is-negative{background:#74162f;border-color:#74162f}.attendance-actions .is-selected.is-justified{background:#a27a25;border-color:#a27a25}.justification{grid-column:1/-1;display:grid;gap:.35rem}.manage-footer{margin-top:1rem;border-top:1px solid #e3dcda;padding-top:1rem}.manage-footer p{margin:0 auto 0 0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.form-grid label,label{display:grid;gap:.35rem}.span-2{grid-column:1/-1}input,select,textarea{padding:.75rem;border:1px solid #d4cbc7;font:inherit}.dialog-status{min-height:1.25rem;color:#74162f}
@media(max-width:900px){.admin-main{padding:1rem}.private-page-header{display:block}.account-card{margin-top:1rem;min-width:0}.toolbar{align-items:stretch;flex-direction:column}.rehearsal-card{grid-template-columns:1fr}.actions{justify-content:flex-start}.form-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.attendance-person{grid-template-columns:1fr}.attendance-actions{display:grid;grid-template-columns:1fr}.attendance-summary{display:grid}}
</style>
