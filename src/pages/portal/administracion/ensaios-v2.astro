:#fff}.work-order{display:inline-flex;align-items:center;justify-content:center;width:2rem;height:2rem;border-radius:999px;background:#f3efed;font-weight:800}.work-row small,.person-row small{display:block;color:#77706b;margin-top:.15rem}.invalid-work{border-color:#ead5d8;background:#fffafa}.invalid-work strong{color:#843941}.attendance-actions{display:flex;gap:.3rem;flex-wrap:wrap}.attendance-actions button{border:1px solid #d2c9c6;background:#fff}.attendance-actions .is-selected{border-color:#4f725c;background:#edf4ef}.attendance-actions .negative{border-color:#8e3440;background:#fff5f6}.attendance-actions .justified{border-color:#927333;background:#fff9e9}.voice-tabs{display:flex;gap:.3rem;flex-wrap:wrap}.voice-tabs button{border:1px solid #d2c9c6;background:#fff}.voice-tabs button.is-active{border-color:#5d142b;color:#5d142b}.dialog-status{min-height:1.2rem;color:#7f343d}.empty{color:#7a716c}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin:1rem 0}.form-grid label,dialog form>label{display:grid;gap:.35rem}.span-2{grid-column:1/-1}dialog{border:0;padding:0;box-shadow:0 18px 60px rgba(0,0,0,.22)}dialog::backdrop{background:rgba(35,27,29,.45)}dialog form{padding:1.25rem}dialog footer{display:flex;justify-content:flex-end;gap:.6rem;padding-top:1rem;border-top:1px solid #e7e0dd}.warning{padding:.8rem;border:1px solid #ead5d8;background:#fff8f8;color:#7f343d}
