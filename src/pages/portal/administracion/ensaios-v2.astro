---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de ensaios" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="admin-ensaios-logout" />
    <main class="admin-rehearsals-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Administración</span>
          <h1>Administración de ensaios</h1>
          <p>Planificación, obras a traballar e control de asistencia desde unha única pantalla.</p>
        </div>
        <div class="account-card">
          <span><small>Conta identificada</small><strong id="user-email">—</strong></span>
          <span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span>
        </div>
      </header>

      <AdministracionNav active="ensaios" />

      <section id="loading" class="state-box">Comprobando permisos e cargando ensaios…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir a administración de ensaios</strong>
        <p id="error-message"></p>
        <button id="retry" type="button" class="secondary">Tentar de novo</button>
      </section>

      <section id="app" hidden>
        <div class="toolbar">
          <label><span>Mostrar</span><select id="filter"><option value="activos">Ensaios activos</option><option value="todos">Todos os ensaios</option><option value="baixa">Dados de baixa</option></select></label>
          <p id="count"></p>
          <button id="new-rehearsal" type="button" class="primary">+ Novo ensaio</button>
        </div>
        <div id="list" class="rehearsal-list"></div>
      </section>
    </main>
  </div>

  <dialog id="new-dialog" class="wide-dialog">
    <form id="new-form">
      <header><div><small>Planificación</small><h2>Novo ensaio</h2></div><button type="button" data-close="new-dialog">×</button></header>
      <div class="form-grid">
        <label><span>Data</span><input name="data" type="date" required /></label>
        <label><span>Hora de inicio</span><input name="horaInicio" type="time" required /></label>
        <label><span>Hora de fin</span><input name="horaFin" type="time" /></label>
        <label><span>Lugar</span><input name="lugar" /></label>
        <label><span>Tipo de ensaio</span><input name="tipoEnsaio" list="tipos-ensaio" required /></label>
        <label><span>Concerto relacionado</span><select name="concerto" id="new-concert"><option value="">Sen concerto asociado</option></select></label>
        <label class="span-2"><span>Descrición</span><textarea name="descricion" rows="3"></textarea></label>
        <label class="span-2"><span>Observacións</span><textarea name="observacions" rows="3"></textarea></label>
      </div>
      <datalist id="tipos-ensaio"><option value="Ordinario"></option><option value="Extraordinario"></option><option value="Xeral"></option><option value="Por cordas"></option></datalist>
      <p id="new-status" class="dialog-status"></p>
      <footer><button type="button" class="secondary" data-close="new-dialog">Cancelar</button><button type="submit" class="primary">Gardar ensaio</button></footer>
    </form>
  </dialog>

  <dialog id="manage-dialog" class="manage-dialog">
    <section class="manage-shell">
      <header><div><small>Xestión do ensaio</small><h2 id="manage-title">Ensaio</h2><p id="manage-meta"></p></div><button type="button" data-close="manage-dialog">×</button></header>
      <nav class="manage-tabs"><button type="button" class="is-active" data-panel="repertorio">Obras</button><button type="button" data-panel="asistencia">Asistencia</button><button type="button" data-panel="avisos">Avisos<span id="avisos-badge"></span></button></nav>

      <section id="panel-repertorio" class="manage-panel">
        <div class="program-tools">
          <label><span>Cargar programa dun concerto</span><select id="program-concert"><option value="">Escolle un concerto…</option></select></label>
          <button id="include-program" type="button" class="secondary">Cargar programa</button>
        </div>
        <div class="work-tools">
          <input id="work-search" type="search" placeholder="Buscar obra ou compositor…" />
          <select id="work-select"><option value="">Escolle unha obra…</option></select>
          <button id="add-work" type="button" class="primary">Engadir obra</button>
        </div>
        <div class="section-heading"><h3>Obras a traballar</h3><strong id="works-count">0</strong></div>
        <p id="works-status" class="dialog-status"></p>
        <div id="works-list" class="works-list"></div>
      </section>

      <section id="panel-asistencia" class="manage-panel" hidden>
        <div class="voice-tabs"><button type="button" class="is-active" data-voice="Todos">Todos</button><button type="button" data-voice="Soprano">Sopranos</button><button type="button" data-voice="Contralto">Contraltos</button><button type="button" data-voice="Tenor">Tenores</button><button type="button" data-voice="Baixo">Baixos</button></div>
        <div class="section-heading"><h3>Control de asistencia</h3><strong id="attendance-count">0</strong></div>
        <p id="attendance-status" class="dialog-status"></p>
        <div id="attendance-list" class="attendance-list"></div>
      </section>

      <section id="panel-avisos" class="manage-panel" hidden>
        <div class="section-heading"><h3>Avisos de non asistencia</h3><strong id="avisos-count">0</strong></div>
        <p id="avisos-status" class="dialog-status"></p>
        <div id="avisos-list" class="avisos-list"></div>
      </section>
    </section>
  </dialog>

  <dialog id="date-dialog"><form id="date-form"><header><h2>Cambiar data</h2><button type="button" data-close="date-dialog">×</button></header><p id="date-name"></p><label><span>Nova data</span><input id="new-date" type="date" required /></label><p id="date-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="date-dialog">Cancelar</button><button type="submit" class="primary">Gardar nova data</button></footer></form></dialog>

  <dialog id="cancel-dialog"><form id="cancel-form"><header><h2>Dar de baixa o ensaio</h2><button type="button" data-close="cancel-dialog">×</button></header><p id="cancel-name"></p><p class="warning">O ensaio quedará marcado como cancelado. Non se eliminarán o seu identificador nin as relacións existentes.</p><p id="cancel-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="cancel-dialog">Volver</button><button type="submit" class="danger">Dar de baixa</button></footer></form></dialog>

  <dialog id="delete-dialog"><form id="delete-form"><header><h2>Eliminar ensaio</h2><button type="button" data-close="delete-dialog">×</button></header><p id="delete-name"></p><p class="warning"><strong>Esta acción non se pode desfacer.</strong> Eliminarase o ensaio e a información asociada segundo as regras do sistema.</p><label><span>Escribe ELIMINAR para confirmar</span><input id="delete-confirm" autocomplete="off" /></label><p id="delete-status" class="dialog-status"></p><footer><button type="button" class="secondary" data-close="delete-dialog">Cancelar</button><button id="delete-submit" type="submit" class="danger-solid" disabled>Eliminar definitivamente</button></footer></form></dialog>
</BaseLayout>

<script>
  import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';

  const $ = (s) => document.querySelector(s);
  const esc = (v='') => String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const norm = (v='') => String(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
  const clean = (v='') => String(v ?? '').trim();
  const idEnsaio = (r) => clean(r?.idEnsaio || r?.id || r?.Id_Ensaio);
  const idPersoa = (p) => clean(p?.idPersoa || p?.id || p?.RowID);
  const idObra = (w) => clean(w?.idRepertorio || w?.id);
  const nomePersoa = (p) => clean(p?.nomeCompleto) || [p?.nome,p?.primeiroApelido,p?.segundoApelido].filter(Boolean).join(' ');
  const fmt = (v) => { if(!v) return 'Sen data'; const d=new Date(`${String(v).slice(0,10)}T12:00:00`); return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d); };

  let ensaios = [], payload = null, selected = null, selectedVoice = 'Todos', rehearsalDraft = null;
  const loading=$('#loading'), errorState=$('#error-state'), errorMessage=$('#error-message'), app=$('#app'), list=$('#list'), filter=$('#filter'), count=$('#count');

  async function call(endpoint, accion, extra={}) {
    const user=auth.currentUser;
    if(!user?.email) throw new Error('A sesión non está activa.');
    const idToken=await user.getIdToken();
    const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});
    const result=await response.json().catch(()=>null);
    if(!response.ok||!result?.ok) throw new Error(result?.erro||`Erro HTTP ${response.status}`);
    return result;
  }
  const adminApi=(accion,extra={})=>call('/api/ensaios-admin',accion,extra);
  const adminV2Api=(accion,extra={})=>call('/api/ensaios-admin-v2',accion,extra);
  const ensaiosApi=(accion,extra={})=>call('/api/ensaios',accion,extra);
  const draftApi=(accion,extra={})=>call('/api/ensaios-borrador',accion,{idEnsaio:idEnsaio(selected),...extra});

  function fullRehearsal(id){return (payload?.ensaios||[]).find(r=>idEnsaio(r)===clean(id))||null;}
  function attendanceRows(){const id=idEnsaio(selected);return (payload?.asistencias||[]).filter(a=>clean(a.ensaio||a.idEnsaio)===id);}
  function workRows(){const id=idEnsaio(selected);return (payload?.ensaiosRepertorio||[]).filter(r=>clean(r.ensaio||r.idEnsaio)===id).sort((a,b)=>Number(a.orde||999)-Number(b.orde||999));}
  function workById(id){return (payload?.repertorio||[]).find(w=>idObra(w)===clean(id))||null;}
  function isValidWork(w){const title=clean(w?.nomeObra||w?.nome);return !!idObra(w)&&!!title&&!/^\d+$/.test(title);}

  function visible(){const mode=filter instanceof HTMLSelectElement?filter.value:'activos';return ensaios.filter(i=>mode==='todos'||(mode==='baixa'?i.cancelado:!i.cancelado));}
  function draw(){
    if(!(list instanceof HTMLElement)) return;
    const rows=visible();
    if(count instanceof HTMLElement) count.textContent=`${rows.length} ensaio${rows.length===1?'':'s'}`;
    list.innerHTML=rows.length?rows.map(i=>`<article class="rehearsal-card ${i.cancelado?'is-cancelled':''}"><div class="rehearsal-date"><small>Data</small><strong>${esc(fmt(i.data))}</strong></div><div class="rehearsal-info"><h2>${esc(i.tipoEnsaio||'Ensaio')}</h2><p>${esc([i.horaInicio,i.lugar].filter(Boolean).join(' · ')||'Sen máis datos')}</p><div class="meta"><span>${Number(i.obras||0)} obras</span><span>${Number(i.asistencias||0)} asistencias</span></div></div><div class="rehearsal-state"><strong>${i.cancelado?'Baixa':'Activo'}</strong></div><div class="actions">${i.cancelado?'':`<button class="primary manage" data-id="${esc(i.idEnsaio)}">Xestionar</button><button class="secondary change-date" data-id="${esc(i.idEnsaio)}">Cambiar data</button><button class="danger cancel-rehearsal" data-id="${esc(i.idEnsaio)}">Dar de baixa</button>`}<button class="danger delete-rehearsal" data-id="${esc(i.idEnsaio)}">Eliminar</button></div></article>`).join(''):'<section class="state-box">Non hai ensaios para este filtro.</section>';
  }

  function fillConcerts(){
    const concerts=[...(payload?.concertos||[])].sort((a,b)=>clean(a.data).localeCompare(clean(b.data)));
    const opts=concerts.map(c=>`<option value="${esc(c.id)}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join('');
    const a=$('#new-concert'), b=$('#program-concert');
    if(a instanceof HTMLSelectElement)a.innerHTML='<option value="">Sen concerto asociado</option>'+opts;
    if(b instanceof HTMLSelectElement)b.innerHTML='<option value="">Escolle un concerto…</option>'+opts;
  }

  function updateWorkPicker(){
    const select=$('#work-select'), search=$('#work-search'); if(!(select instanceof HTMLSelectElement))return;
    const q=norm(search instanceof HTMLInputElement?search.value:'');
    const used=new Set(workRows().map(r=>clean(r.repertorio||r.idRepertorio)));
    const works=(payload?.repertorio||[]).filter(w=>{
      const id=idObra(w), title=clean(w.nomeObra||w.nome), composer=clean(w.compositor);
      if(!isValidWork(w)||used.has(id))return false;
      return !q||norm(`${title} ${composer}`).includes(q);
    }).sort((a,b)=>clean(a.nomeObra||a.nome).localeCompare(clean(b.nomeObra||b.nome),'gl',{sensitivity:'base'})).slice(0,120);
    select.innerHTML='<option value="">Escolle unha obra…</option>'+works.map(w=>`<option value="${esc(idObra(w))}">${esc([w.nomeObra||w.nome,w.compositor].filter(Boolean).join(' — '))}</option>`).join('');
  }

  function renderWorks(){
    const rows=workRows(), box=$('#works-list'), n=$('#works-count'), status=$('#works-status');
    const valid=[], invalid=[];
    rows.forEach((r)=>{const id=clean(r.repertorio||r.idRepertorio),w=workById(id);(isValidWork(w)?valid:invalid).push({r,id,w});});
    if(n instanceof HTMLElement)n.textContent=`${valid.length} obra${valid.length===1?'':'s'}`;
    if(status instanceof HTMLElement)status.textContent=invalid.length?`Hai ${invalid.length} rexistro${invalid.length===1?'':'s'} de obra incorrecto${invalid.length===1?'':'s'} herdado${invalid.length===1?'':'s'}. Podes eliminalo${invalid.length===1?'':'s'} desde esta lista.`:'';
    if(box instanceof HTMLElement){
      const validHtml=valid.map(({id,w},index)=>`<article class="work-row"><span class="work-order">${index+1}</span><div><strong>${esc(w.nomeObra||w.nome)}</strong>${w.compositor?`<small>${esc(w.compositor)}</small>`:''}</div><button type="button" class="remove-work danger" data-work-id="${esc(id)}">Eliminar</button></article>`).join('');
      const invalidHtml=invalid.map(({id,w})=>`<article class="work-row invalid-work"><span class="work-order">!</span><div><strong>Rexistro de obra incorrecto</strong><small>Referencia: ${esc(clean(w?.nomeObra||w?.nome)||id)}</small></div><button type="button" class="remove-work danger" data-work-id="${esc(id)}">Eliminar</button></article>`).join('');
      box.innerHTML=(validHtml+invalidHtml)||'<p class="empty">Aínda non hai obras asignadas a este ensaio.</p>';
    }
    updateWorkPicker();
  }

  function renderAttendance(){
    const box=$('#attendance-list'), n=$('#attendance-count'); if(!(box instanceof HTMLElement))return;
    const map=new Map(attendanceRows().map(a=>[clean(a.persoa||a.idPersoa),a]));
    const people=(payload?.persoas||[]).filter(p=>idPersoa(p)&&clean(p.voz)&& (selectedVoice==='Todos'||norm(p.voz)===norm(selectedVoice))).sort((a,b)=>nomePersoa(a).localeCompare(nomePersoa(b),'gl',{sensitivity:'base'}));
    const present=people.filter(p=>norm(map.get(idPersoa(p))?.estadoAsistencia)==='asiste').length;
    if(n instanceof HTMLElement)n.textContent=`${present}/${people.length}`;
    box.innerHTML=people.map(p=>{const a=map.get(idPersoa(p))||{}, state=norm(a.estadoAsistencia), justified=a.xustificada===true||String(a.xustificada).toLowerCase()==='true';return `<article class="person-row" data-person="${esc(idPersoa(p))}"><div><strong>${esc(nomePersoa(p))}</strong><small>${esc(p.voz||'')}</small></div><div class="attendance-actions"><button data-att="asiste" class="${state==='asiste'?'is-selected':''}">Asiste</button><button data-att="non" class="${state==='non asiste'&&!justified?'is-selected negative':''}">Non asiste</button><button data-att="xustificada" class="${state==='non asiste'&&justified?'is-selected justified':''}">Xustificada</button></div><span class="row-status"></span></article>`}).join('')||'<p class="empty">Non hai persoas nesta selección.</p>';
  }

  function renderAvisos(){
    const box=$('#avisos-list'),n=$('#avisos-count'),badge=$('#avisos-badge'),status=$('#avisos-status');
    if(!(box instanceof HTMLElement))return;
    if(!rehearsalDraft){box.innerHTML='<p class="empty">Cargando avisos…</p>';if(n)n.textContent='0';if(badge)badge.textContent='';return;}
    const confirmed=new Map(attendanceRows().map(a=>[clean(a.persoa||a.idPersoa),a]));
    const pending=(rehearsalDraft.asistencias||[]).filter(a=>{const pid=clean(a.persoa||a.idPersoa);if(!pid)return false;if(norm(a.estadoAsistencia)!=='non asiste')return false;const conf=confirmed.get(pid);return !conf||norm(conf.estadoAsistencia)!=='non asiste';});
    const rows=pending.map(a=>{const pid=clean(a.persoa||a.idPersoa);const p=(payload?.persoas||[]).find(x=>idPersoa(x)===pid)||null;return{pid,a,p};}).filter(x=>x.p);
    if(n)n.textContent=String(rows.length);if(badge)badge.textContent=rows.length?` (${rows.length})`:'';if(status)status.textContent='';
    if(!rows.length){box.innerHTML='<p class="empty">Non hai avisos pendentes de coralistas para este ensaio.</p>';return;}
    box.innerHTML=rows.map(({pid,a,p})=>{const xust=a.xustificada===true||String(a.xustificada).toLowerCase()==='true';return `<article class="aviso-row"><div><strong>${esc(nomePersoa(p))}</strong><small>${esc(p.voz||'')}${xust?' · Non asiste con xustificación':' · Non asiste'}${a.motivo?` · ${esc(a.motivo)}`:''}</small></div><button type="button" class="accept-aviso primary" data-person="${esc(pid)}" data-xust="${xust}" data-motivo="${esc(a.motivo||'')}">Aceptar</button></article>`;}).join('');
  }

  function openManage(item){
    selected=fullRehearsal(item.idEnsaio)||item; rehearsalDraft=null;
    const dialog=$('#manage-dialog'); if(!(dialog instanceof HTMLDialogElement))return;
    const title=$('#manage-title'), meta=$('#manage-meta');
    if(title)title.textContent=selected.tipoEnsaio||'Ensaio';
    if(meta)meta.textContent=[fmt(selected.data),selected.horaInicio,selected.lugar].filter(Boolean).join(' · ');
    selectedVoice='Todos'; document.querySelectorAll('[data-voice]').forEach(b=>b.classList.toggle('is-active',b.dataset.voice==='Todos'));
    fillConcerts(); renderWorks(); renderAttendance(); renderAvisos(); dialog.showModal();
    draftApi('obter').then(r=>{rehearsalDraft=r.draft||null;renderAvisos();}).catch(()=>{});
  }

  async function refreshFull(forzar=false){payload=await ensaiosApi('listarEnsaiosPortal',{forzar});fillConcerts();}
  async function load(){
    if(loading instanceof HTMLElement)loading.hidden=false;if(errorState instanceof HTMLElement)errorState.hidden=true;if(app instanceof HTMLElement)app.hidden=true;
    try{
      const user=await waitForPortalUser(); if(!user?.email)throw new Error('Non hai unha sesión válida.');
      const email=$('#user-email'); if(email)email.textContent=user.email;
      const admin=await adminApi('listar'); ensaios=Array.isArray(admin.ensaios)?admin.ensaios:[];
      const level=$('#user-level'); if(level)level.textContent=admin.nivel||'Administración';
      await refreshFull(false);
      if(loading instanceof HTMLElement)loading.hidden=true;if(app instanceof HTMLElement)app.hidden=false;draw();
    }catch(error){if(loading instanceof HTMLElement)loading.hidden=true;if(errorState instanceof HTMLElement)errorState.hidden=false;if(errorMessage instanceof HTMLElement)errorMessage.textContent=error instanceof Error?error.message:'Produciuse un erro inesperado.';}
  }

  filter?.addEventListener('change',draw); $('#retry')?.addEventListener('click',load); $('#admin-ensaios-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/';});
  document.querySelectorAll('[data-close]').forEach(button=>button.addEventListener('click',()=>{const d=document.getElementById(button.dataset.close||'');if(d instanceof HTMLDialogElement)d.close();}));

  $('#new-rehearsal')?.addEventListener('click',()=>{const form=$('#new-form');if(form instanceof HTMLFormElement)form.reset();fillConcerts();const d=$('#new-dialog');if(d instanceof HTMLDialogElement)d.showModal();});
  $('#new-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget,status=$('#new-status');if(!(form instanceof HTMLFormElement))return;const data=Object.fromEntries(new FormData(form).entries());try{if(status)status.textContent='Gardando…';await ensaiosApi('gardarEnsaio',{...data,cancelado:false});await refreshFull(true);await load();const d=$('#new-dialog');if(d instanceof HTMLDialogElement)d.close();}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);}});

  list?.addEventListener('click',(event)=>{
    const target=event.target;if(!(target instanceof HTMLButtonElement))return;
    const item=ensaios.find(i=>i.idEnsaio===target.dataset.id);if(!item)return;
    if(target.classList.contains('manage'))openManage(item);
    if(target.classList.contains('change-date')){selected=item;const d=$('#date-dialog'),input=$('#new-date'),name=$('#date-name');if(name)name.textContent=`${item.tipoEnsaio||'Ensaio'} · ${fmt(item.data)}`;if(input instanceof HTMLInputElement)input.value=clean(item.data).slice(0,10);if(d instanceof HTMLDialogElement)d.showModal();}
    if(target.classList.contains('cancel-rehearsal')){selected=item;const d=$('#cancel-dialog'),name=$('#cancel-name');if(name)name.textContent=`${item.tipoEnsaio||'Ensaio'} · ${fmt(item.data)}`;if(d instanceof HTMLDialogElement)d.showModal();}
    if(target.classList.contains('delete-rehearsal')){selected=item;const d=$('#delete-dialog'),name=$('#delete-name'),confirm=$('#delete-confirm'),submit=$('#delete-submit'),status=$('#delete-status');if(name)name.textContent=`${item.tipoEnsaio||'Ensaio'} · ${fmt(item.data)}`;if(confirm instanceof HTMLInputElement)confirm.value='';if(submit instanceof HTMLButtonElement)submit.disabled=true;if(status)status.textContent='';if(d instanceof HTMLDialogElement)d.showModal();}
  });

  $('#date-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const input=$('#new-date'),status=$('#date-status');if(!selected||!(input instanceof HTMLInputElement)||!input.value)return;try{if(status)status.textContent='Gardando…';await adminApi('cambiarData',{idEnsaio:selected.idEnsaio,data:input.value});const d=$('#date-dialog');if(d instanceof HTMLDialogElement)d.close();await load();}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);}});
  $('#cancel-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const status=$('#cancel-status');if(!selected)return;try{if(status)status.textContent='Gardando…';await adminApi('darBaixa',{idEnsaio:selected.idEnsaio});const d=$('#cancel-dialog');if(d instanceof HTMLDialogElement)d.close();await load();}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);}});
  $('#delete-confirm')?.addEventListener('input',(event)=>{const target=event.target,submit=$('#delete-submit');if(submit instanceof HTMLButtonElement)submit.disabled=!(target instanceof HTMLInputElement&&target.value.trim().toUpperCase()==='ELIMINAR');});
  $('#delete-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const status=$('#delete-status'),confirm=$('#delete-confirm');if(!selected||!(confirm instanceof HTMLInputElement)||confirm.value.trim().toUpperCase()!=='ELIMINAR')return;try{if(status)status.textContent='Eliminando…';await adminV2Api('eliminar',{idEnsaio:selected.idEnsaio});const d=$('#delete-dialog');if(d instanceof HTMLDialogElement)d.close();selected=null;await load();}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);}});

  document.querySelectorAll('[data-panel]').forEach(button=>button.addEventListener('click',()=>{const panel=button.dataset.panel;document.querySelectorAll('[data-panel]').forEach(b=>b.classList.toggle('is-active',b===button));$('#panel-repertorio').hidden=panel!=='repertorio';$('#panel-asistencia').hidden=panel!=='asistencia';$('#panel-avisos').hidden=panel!=='avisos';}));
  document.querySelectorAll('[data-voice]').forEach(button=>button.addEventListener('click',()=>{selectedVoice=button.dataset.voice||'Todos';document.querySelectorAll('[data-voice]').forEach(b=>b.classList.toggle('is-active',b===button));renderAttendance();}));
  $('#work-search')?.addEventListener('input',updateWorkPicker);
  $('#add-work')?.addEventListener('click',async()=>{const select=$('#work-select'),status=$('#works-status');if(!selected||!(select instanceof HTMLSelectElement)||!select.value)return;try{if(status)status.textContent='Gardando…';await draftApi('reiniciar');await draftApi('gardarObra',{idRepertorio:select.value});await draftApi('finalizar');await refreshFull(true);selected=fullRehearsal(idEnsaio(selected))||selected;renderWorks();if(status)status.textContent='Obra engadida.';}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);}});
  $('#works-list')?.addEventListener('click',async(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement)||!target.classList.contains('remove-work')||!selected)return;const id=clean(target.dataset.workId),status=$('#works-status');if(!id)return;if(!window.confirm('Eliminar esta obra do ensaio?'))return;try{target.disabled=true;if(status)status.textContent='Eliminando obra…';await draftApi('reiniciar');await draftApi('eliminarObra',{idRepertorio:id});await draftApi('finalizar');await refreshFull(true);selected=fullRehearsal(idEnsaio(selected))||selected;renderWorks();if(status)status.textContent='Obra eliminada.';}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);target.disabled=false;}});
  $('#include-program')?.addEventListener('click',async()=>{const select=$('#program-concert'),status=$('#works-status');if(!selected||!(select instanceof HTMLSelectElement)||!select.value)return;try{if(status)status.textContent='Incluíndo programa…';await draftApi('reiniciar');const r=await draftApi('incluírProgramaConcerto',{idConcerto:select.value});await draftApi('finalizar');await refreshFull(true);selected=fullRehearsal(idEnsaio(selected))||selected;renderWorks();if(status)status.textContent=`Programa cargado: ${r.engadidas||0} obras.`;}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);}});
  $('#attendance-list')?.addEventListener('click',async(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement)||!target.dataset.att||!selected)return;const row=target.closest('.person-row');if(!(row instanceof HTMLElement))return;const pid=clean(row.dataset.person);let estado='Non asiste',xustificada=false,motivo='';if(target.dataset.att==='asiste')estado='Asiste';if(target.dataset.att==='xustificada'){xustificada=true;motivo=window.prompt('Motivo da xustificación (opcional):','')||'';}const status=row.querySelector('.row-status');try{if(status)status.textContent='Gardando…';await ensaiosApi('gardarAsistenciaEnsaio',{idEnsaio:idEnsaio(selected),idPersoa:pid,estadoAsistencia:estado,xustificada,motivo,observacions:''});await refreshFull(true);selected=fullRehearsal(idEnsaio(selected))||selected;renderAttendance();}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);}});

  $('#avisos-list')?.addEventListener('click',async(event)=>{const target=event.target;if(!(target instanceof HTMLButtonElement)||!target.classList.contains('accept-aviso')||!selected)return;const pid=clean(target.dataset.person),xust=target.dataset.xust==='true',motivo=clean(target.dataset.motivo),status=$('#avisos-status');if(!pid)return;try{target.disabled=true;if(status)status.textContent='Aceptando aviso…';await ensaiosApi('gardarAsistenciaEnsaio',{idEnsaio:idEnsaio(selected),idPersoa:pid,estadoAsistencia:'Non asiste',xustificada:xust,motivo,observacions:''});await refreshFull(true);selected=fullRehearsal(idEnsaio(selected))||selected;renderAvisos();renderAttendance();if(status)status.textContent='Aviso aceptado.';}catch(e){if(status)status.textContent=e instanceof Error?e.message:String(e);target.disabled=false;}});

  load();
</script>

