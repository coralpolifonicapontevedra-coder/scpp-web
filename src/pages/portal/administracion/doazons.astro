---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Doazóns" lang="gl">
  <div class="private-layout donations-layout">
    <PortalSidebar active="administracion" logoutId="doazons-logout" />
    <main class="donations-main">
      <header class="page-head"><div><span>Administración</span><h1>Doazóns</h1><p>Consulta as colaboracións rexistradas, revisa o estado dos pagamentos e xestiona as operacións fallidas.</p></div><div class="account"><small>Usuario</small><strong id="user-email">—</strong><small>Nivel</small><strong>Administración</strong></div></header>
      <AdministracionNav active="doazons" />
      <section id="loading" class="state">Cargando doazóns…</section>
      <section id="error" class="state error" hidden><strong>Non foi posible abrir Doazóns</strong><p id="error-message"></p><button id="retry" class="secondary" type="button">Tentar de novo</button></section>
      <section id="app" hidden>
        <div class="metrics"><article><small>Total pagado</small><strong id="m-total">0 €</strong></article><article><small>Pagadas</small><strong id="m-confirmed">0</strong></article><article><small>Pendentes</small><strong id="m-pending">0</strong></article><article><small>Fallidas / anuladas</small><strong id="m-failed">0</strong></article></div>
        <div class="toolbar"><input id="search" type="search" placeholder="Buscar por nome, correo, operación ou referencia"/><select id="status-filter"><option value="">Todos os estados</option></select></div>
        <div class="table-card"><div class="table-wrap"><table><thead><tr><th>Data</th><th>Donante</th><th>Importe</th><th>Estado</th><th>Operación TPV</th><th>Referencia</th><th></th></tr></thead><tbody id="rows"></tbody></table></div></div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { closePortalSession, portalRequest, waitForPortalUser } from '../../../lib/portal-session.js';
  const $=(s)=>document.querySelector(s);
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let data={doazons:[],estados:[]};
  const money=(v)=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?new Intl.NumberFormat('gl-ES',{style:'currency',currency:'EUR'}).format(n):'—';};
  const date=(v)=>{const d=new Date(v);return Number.isNaN(d.getTime())?(v||'—'):new Intl.DateTimeFormat('gl-ES',{dateStyle:'short',timeStyle:'short'}).format(d);};
  async function request(accion,extra={}){return portalRequest('/api/doazons-admin',accion,extra);}
  function metrics(){const paid=data.doazons.filter(x=>x.estadoPago==='Pagado');const pending=data.doazons.filter(x=>x.estadoPago==='Pendente'||!x.estadoPago);const failed=data.doazons.filter(x=>['Fallido','Anulado'].includes(x.estadoPago));const total=paid.reduce((s,x)=>s+(Number(String(x.importe??'').replace(',','.'))||0),0);$('#m-total').textContent=money(total);$('#m-confirmed').textContent=String(paid.length);$('#m-pending').textContent=String(pending.length);$('#m-failed').textContent=String(failed.length);}
  function render(){const q=String($('#search').value||'').toLowerCase(),status=$('#status-filter').value;const rows=data.doazons.filter(x=>(!status||x.estadoPago===status)&&(!q||JSON.stringify(x).toLowerCase().includes(q)));$('#rows').innerHTML=rows.map(x=>`<tr><td>${esc(date(x.dataAlta))}</td><td><strong>${esc(x.anonimo?'Anónimo':(x.nomeCompleto||x.nome||'—'))}</strong>${!x.anonimo&&x.correo?`<small>${esc(x.correo)}</small>`:''}</td><td>${esc(money(x.importe))}</td><td><select data-status="${esc(x.id)}">${data.estados.map(s=>`<option value="${esc(s)}" ${s===x.estadoPago?'selected':''}>${esc(s)}</option>`).join('')}</select></td><td>${esc(x.numOperacionTPV||'—')}</td><td>${esc(x.referenciaTPV||'—')}</td><td class="actions"><button class="secondary" data-save="${esc(x.id)}" type="button">Gardar</button>${['Fallido','Anulado'].includes(x.estadoPago)?`<button class="danger" data-delete="${esc(x.id)}" type="button">Eliminar</button>`:''}</td></tr>`).join('')||'<tr><td colspan="7" class="empty">Non hai doazóns que coincidan cos filtros.</td></tr>';}
  async function load(){try{const u=await waitForPortalUser();if(!u)throw new Error('Non hai unha sesión válida.');$('#user-email').textContent=u.email||'—';data=await request('listarDoazonsAdministracion');$('#status-filter').innerHTML='<option value="">Todos os estados</option>'+data.estados.map(s=>`<option value="${esc(s)}">${esc(s)}</option>`).join('');metrics();render();$('#loading').hidden=true;$('#app').hidden=false;}catch(e){$('#loading').hidden=true;$('#error').hidden=false;$('#error-message').textContent=e instanceof Error?e.message:String(e);}}
  $('#search')?.addEventListener('input',render);$('#status-filter')?.addEventListener('change',render);$('#retry')?.addEventListener('click',()=>{location.reload();});$('#rows')?.addEventListener('click',async e=>{const b=e.target;if(!(b instanceof HTMLButtonElement))return;try{if(b.dataset.save){const id=b.dataset.save,sel=document.querySelector(`select[data-status="${CSS.escape(id)}"]`);await request('actualizarEstadoDoazonAdministracion',{id,estado:sel?.value});await load();}if(b.dataset.delete&&confirm('Eliminar definitivamente esta doazón fallida ou anulada? Esta acción non se pode desfacer.')){await request('eliminarDoazonAdministracion',{id:b.dataset.delete});await load();}}catch(err){alert(err instanceof Error?err.message:String(err));}});$('#doazons-logout')?.addEventListener('click',()=>closePortalSession());load();
</script>

<style is:global>
body{background:#f5f3f1}.donations-layout{display:flex;min-height:100vh}.donations-main{flex:1;min-width:0;padding:2rem clamp(1rem,3vw,3.5rem) 4rem;font-family:var(--fuente-minimalista)}.page-head{display:flex;justify-content:space-between;gap:2rem;margin-bottom:1.5rem}.page-head span,.account small,.metrics small{color:#806f74;font-size:.7rem;font-weight:800;text-transform:uppercase}.page-head h1{margin:.2rem 0;color:var(--color-principal);font-size:clamp(2rem,4vw,3.4rem)}.page-head p{max-width:760px;color:#625c58}.account{display:grid;align-content:start;min-width:250px;padding:1rem;border:1px solid #ddd;background:#fff}.account strong{margin-bottom:.7rem;overflow-wrap:anywhere}.state,.metrics article,.toolbar,.table-card{border:1px solid #ded8d3;background:#fff}.state{padding:1.2rem}.error{color:#8b2d36}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin-bottom:1rem}.metrics article{padding:1rem}.metrics strong{display:block;margin-top:.25rem;color:var(--color-principal);font-size:1.7rem}.toolbar{display:grid;grid-template-columns:1fr 220px;gap:.8rem;padding:1rem;margin-bottom:1rem}.toolbar input,.toolbar select,.table-wrap select{min-height:2.6rem;padding:.55rem;border:1px solid #ccc;background:#fff}.table-wrap{overflow:auto}.table-wrap table{width:100%;border-collapse:collapse}.table-wrap th,.table-wrap td{padding:.75rem;border-bottom:1px solid #eee8e5;text-align:left;vertical-align:top;font-size:.84rem}.table-wrap th{background:#faf8f7;color:#6d6260;font-size:.72rem;text-transform:uppercase}.table-wrap td small{display:block;margin-top:.15rem;color:#806f74}.actions{display:flex;gap:.35rem;white-space:nowrap}.secondary,.danger{min-height:2.35rem;padding:.45rem .7rem;border:1px solid #cfc5c8;background:#fff;font-weight:800;cursor:pointer}.danger{border-color:#9a3944;color:#8b2d36}.empty{text-align:center!important;color:#766b66}@media(max-width:900px){.donations-layout{display:block}.page-head{display:grid}.metrics{grid-template-columns:repeat(2,1fr)}.account{min-width:0}}@media(max-width:620px){.donations-main{padding:1rem .8rem 2rem}.metrics,.toolbar{grid-template-columns:1fr}}
</style>
