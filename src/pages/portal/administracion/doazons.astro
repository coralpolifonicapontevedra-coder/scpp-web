---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Doazóns" lang="gl">
  <div class="private-layout donations-layout">
    <PortalSidebar active="administracion" logoutId="doazons-logout" />
    <main class="donations-main">
      <header class="page-head">
        <div>
          <span>Administración</span>
          <h1>Doazóns</h1>
          <p>Operacións e intentos de doazón realizados a través do TPV virtual.</p>
        </div>
        <div class="account">
          <small>Usuario</small><strong id="user-email">—</strong>
          <small>Nivel</small><strong>Administración</strong>
        </div>
      </header>

      <AdministracionNav active="doazons" />

      <section id="loading" class="state">Cargando operacións TPV…</section>
      <section id="error" class="state error" hidden>
        <strong>Non foi posible abrir Doazóns</strong>
        <p id="error-message"></p>
        <button id="retry" class="secondary" type="button">Tentar de novo</button>
      </section>

      <section id="app" hidden>
        <div class="toolbar">
          <input id="search" type="search" placeholder="Buscar por nome, correo, operación ou referencia" />
          <select id="status-filter"><option value="">Todos os estados</option></select>
        </div>

        <div class="table-card">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Donante</th>
                  <th>Importe</th>
                  <th>Operación TPV</th>
                  <th>Referencia TPV</th>
                  <th>Estado</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="rows"></tbody>
            </table>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { closePortalSession, portalRequest, waitForPortalUser } from '../../../lib/portal-session.js';

  const $ = (selector) => document.querySelector(selector);
  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[char]));

  const ESTADOS = ['Pendente', 'Pagado', 'Fallido', 'Anulado'];
  let data = { doazons: [], estados: ESTADOS };

  const money = (value) => {
    const number = Number(String(value ?? '').replace(',', '.'));
    return Number.isFinite(number)
      ? new Intl.NumberFormat('gl-ES', { style: 'currency', currency: 'EUR' }).format(number)
      : '—';
  };

  const date = (value) => {
    if (!value) return '—';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return String(value);
    return new Intl.DateTimeFormat('gl-ES', {
      dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/Madrid'
    }).format(parsed);
  };

  async function request(accion, extra = {}) {
    return portalRequest('/api/doazons-admin', accion, extra);
  }

  function donor(item) {
    if (item.anonimo) return '<strong>Anónimo</strong>';
    const nome = item.nomeCompleto || item.nome || '—';
    const correo = item.correo ? `<small>${esc(item.correo)}</small>` : '';
    return `<strong>${esc(nome)}</strong>${correo}`;
  }

  function render() {
    const query = String($('#search')?.value || '').trim().toLowerCase();
    const status = $('#status-filter')?.value || '';
    const rows = data.doazons.filter((item) => {
      if (status && item.estadoPago !== status) return false;
      if (!query) return true;
      return [
        item.nomeCompleto,
        item.nome,
        item.correo,
        item.numOperacionTPV,
        item.referenciaTPV,
        item.estadoPago,
        item.importe
      ].some((value) => String(value ?? '').toLowerCase().includes(query));
    });

    $('#rows').innerHTML = rows.map((item) => {
      const estados = (data.estados?.length ? data.estados : ESTADOS)
        .map((estado) => `<option value="${esc(estado)}" ${estado === item.estadoPago ? 'selected' : ''}>${esc(estado)}</option>`)
        .join('');

      return `<tr>
        <td>${esc(date(item.dataAlta))}</td>
        <td>${donor(item)}</td>
        <td>${esc(money(item.importe))}</td>
        <td>${esc(item.numOperacionTPV || '—')}</td>
        <td>${esc(item.referenciaTPV || '—')}</td>
        <td><select data-status="${esc(item.id)}">${estados}</select></td>
        <td class="actions"><button class="secondary" data-save="${esc(item.id)}" type="button">Gardar estado</button></td>
      </tr>`;
    }).join('') || '<tr><td colspan="7" class="empty">Non hai operacións TPV que coincidan cos filtros.</td></tr>';
  }

  async function load() {
    $('#error').hidden = true;
    $('#loading').hidden = false;
    $('#app').hidden = true;

    try {
      const user = await waitForPortalUser();
      if (!user) throw new Error('Non hai unha sesión válida.');
      $('#user-email').textContent = user.email || '—';

      const result = await request('listarDoazonsAdministracion');
      data = {
        doazons: Array.isArray(result.doazons) ? result.doazons : [],
        estados: Array.isArray(result.estados) && result.estados.length ? result.estados : ESTADOS
      };

      $('#status-filter').innerHTML = '<option value="">Todos os estados</option>' +
        data.estados.map((estado) => `<option value="${esc(estado)}">${esc(estado)}</option>`).join('');

      render();
      $('#loading').hidden = true;
      $('#app').hidden = false;
    } catch (error) {
      $('#loading').hidden = true;
      $('#error').hidden = false;
      $('#error-message').textContent = error instanceof Error ? error.message : String(error);
    }
  }

  $('#search')?.addEventListener('input', render);
  $('#status-filter')?.addEventListener('change', render);
  $('#retry')?.addEventListener('click', load);

  $('#rows')?.addEventListener('click', async (event) => {
    const button = event.target;
    if (!(button instanceof HTMLButtonElement) || !button.dataset.save) return;

    const id = button.dataset.save;
    const select = document.querySelector(`select[data-status="${CSS.escape(id)}"]`);
    if (!(select instanceof HTMLSelectElement)) return;

    button.disabled = true;
    const previousText = button.textContent;
    button.textContent = 'Gardando…';

    try {
      await request('actualizarEstadoDoazonAdministracion', { id, estado: select.value });
      button.textContent = 'Gardado';
      const item = data.doazons.find((row) => row.id === id);
      if (item) item.estadoPago = select.value;
      setTimeout(() => { button.textContent = previousText; button.disabled = false; }, 900);
    } catch (error) {
      button.disabled = false;
      button.textContent = previousText;
      alert(error instanceof Error ? error.message : String(error));
    }
  });

  $('#doazons-logout')?.addEventListener('click', () => closePortalSession());
  load();
</script>

<style is:global>
body{background:#f5f3f1}.donations-layout{display:flex;min-height:100vh}.donations-main{flex:1;min-width:0;padding:2rem clamp(1rem,3vw,3.5rem) 4rem;font-family:var(--fuente-minimalista)}.page-head{display:flex;justify-content:space-between;gap:2rem;margin-bottom:1.5rem}.page-head span,.account small{color:#806f74;font-size:.7rem;font-weight:800;text-transform:uppercase}.page-head h1{margin:.2rem 0;color:var(--color-principal);font-size:clamp(2rem,4vw,3.4rem)}.page-head p{max-width:760px;color:#625c58}.account{display:grid;align-content:start;min-width:250px;padding:1rem;border:1px solid #ddd;background:#fff}.account strong{margin-bottom:.7rem;overflow-wrap:anywhere}.state,.toolbar,.table-card{border:1px solid #ded8d3;background:#fff}.state{padding:1.2rem}.error{color:#8b2d36}.toolbar{display:grid;grid-template-columns:1fr 220px;gap:.8rem;padding:1rem;margin-bottom:1rem}.toolbar input,.toolbar select,.table-wrap select{min-height:2.6rem;padding:.55rem;border:1px solid #ccc;background:#fff}.table-wrap{overflow:auto}.table-wrap table{width:100%;border-collapse:collapse}.table-wrap th,.table-wrap td{padding:.75rem;border-bottom:1px solid #eee8e5;text-align:left;vertical-align:middle;font-size:.84rem}.table-wrap th{background:#faf8f7;color:#6d6260;font-size:.72rem;text-transform:uppercase}.table-wrap td small{display:block;margin-top:.15rem;color:#806f74}.actions{white-space:nowrap}.secondary{min-height:2.35rem;padding:.45rem .7rem;border:1px solid #cfc5c8;background:#fff;font-weight:800;cursor:pointer}.secondary:disabled{opacity:.6;cursor:default}.empty{text-align:center!important;color:#766b66}@media(max-width:900px){.donations-layout{display:block}.page-head{display:grid}.account{min-width:0}}@media(max-width:620px){.donations-main{padding:1rem .8rem 2rem}.toolbar{grid-template-columns:1fr}.table-wrap table{min-width:850px}}
</style>
