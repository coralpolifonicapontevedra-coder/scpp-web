---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---
<BaseLayout title="Concertos · proba" lang="gl">
<div class="private-layout"><PortalSidebar active="administracion" logoutId="admin-concertos-proba-logout" /><main class="main">
<header class="head"><div><span>Administración · proba</span><h1>Concertos</h1><p>Nova xestión do programa baseada no fluxo estable do antigo módulo de Ensaios.</p></div><div class="storage"><small>Traballo</small><strong>R2 privado</strong></div></header>
<AdministracionNav active="concertos" />
<section id="loading" class="card">Cargando concertos…</section><section id="error" class="card error" hidden></section>
<section id="app" hidden>
<section class="card selector"><label><span>Concerto</span><select id="concert-select"></select></label></section>
<section class="card"><header class="section-head"><div><span>Preparación musical</span><h2>Programa</h2></div><strong id="count">0 obras</strong></header>
<div class="tools"><input id="search" type="search" placeholder="Buscar por título ou compositor…" autocomplete="off"/><select id="work-select"><option value="">Escolle unha obra…</option></select><button id="add" class="primary" type="button">Engadir obra</button></div>
<p id="message" class="message"></p><div id="program" class="program"></div><footer class="actions"><button id="save" class="primary" type="button">Gardar programa en R2</button></footer></section>
</section></main></div>
</BaseLayout>
<script>
import {auth,closePortalSession,waitForPortalUser} from '../../../lib/portal-session.js';
const $=s=>document.querySelector(s);let concerts=[],selected=null,draft={programa:[],obras:[],persoas:[]};
const clean=v=>String(v??'').trim(),norm=v=>clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const esc=v=>clean(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
async function api(accion,extra={}){const u=auth.currentUser;if(!u)throw Error('A sesión non está activa.');const idToken=await u.getIdToken();const r=await fetch('/api/concertos-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const x=await r.json().catch(()=>null);if(!r.ok||!x?.ok)throw Error(x?.erro||`Erro ${r.status}`);return x}
const workId=w=>clean(w?.id),workName=w=>clean(w?.nome),workAuthor=w=>clean(w?.autor);
function validWork(w){const id=workId(w),name=workName(w);return !!id&&!!name&&!/^\d+$/.test(name)}
function work(id){return (draft.obras||[]).find(w=>workId(w)===clean(id))||{}}
function renderPicker(){const q=norm($('#search').value),used=new Set((draft.programa||[]).map(p=>clean(p.obraId)));const options=(draft.obras||[]).filter(validWork).filter(w=>!used.has(workId(w))&&(!q||norm(`${workName(w)} ${workAuthor(w)}`).includes(q))).sort((a,b)=>workName(a).localeCompare(workName(b),'gl',{sensitivity:'base'}));$('#work-select').innerHTML='<option value="">Escolle unha obra…</option>'+options.slice(0,100).map(w=>`<option value="${esc(workId(w))}">${esc(workName(w))}${workAuthor(w)?` — ${esc(workAuthor(w))}`:''}</option>`).join('');$('#message').textContent=q?`${options.length} resultados`:''}
function render(){const rows=[...(draft.programa||[])].sort((a,b)=>Number(a.orde||999)-Number(b.orde||999));$('#count').textContent=`${rows.length} obra${rows.length===1?'':'s'}`;$('#program').innerHTML=rows.length?rows.map((p,i)=>{const w=work(p.obraId);return `<article class="row" data-i="${i}"><span class="num">${i+1}</span><div><strong>${esc(workName(w)||p.obraId)}</strong>${workAuthor(w)?`<small>${esc(workAuthor(w))}</small>`:''}</div><input data-field="solista" value="${esc(p.solista)}" placeholder="Solista"/><input data-field="notas" value="${esc(p.notas)}" placeholder="Notas"/><button type="button" class="remove" data-remove="${i}">Retirar</button></article>`}).join(''):'<p class="empty">Programa pendente.</p>';renderPicker()}
function collect(){document.querySelectorAll('.row').forEach((row,i)=>{const p=draft.programa[i];if(!p)return;row.querySelectorAll('input').forEach(input=>{if(input.dataset.field)p[input.dataset.field]=input.value.trim()})});draft.programa=draft.programa.map((p,i)=>({...p,orde:i+1}))}
async function openConcert(id){selected=concerts.find(c=>c.idConcerto===id)||null;if(!selected)return;$('#message').textContent='Cargando programa…';draft=await api('obterXestion',{idConcerto:id});render();$('#message').textContent=''}
async function load(){try{await waitForPortalUser();const x=await api('listar');concerts=Array.isArray(x.concertos)?x.concertos:[];$('#concert-select').innerHTML='<option value="">Escolle un concerto…</option>'+concerts.map(c=>`<option value="${esc(c.idConcerto)}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join('');$('#loading').hidden=true;$('#app').hidden=false;if(concerts[0]){$('#concert-select').value=concerts[0].idConcerto;await openConcert(concerts[0].idConcerto)}}catch(e){$('#loading').hidden=true;$('#error').hidden=false;$('#error').textContent=e instanceof Error?e.message:String(e)}}
$('#concert-select')?.addEventListener('change',e=>openConcert(e.target.value));$('#search')?.addEventListener('input',renderPicker);$('#add')?.addEventListener('click',()=>{const id=clean($('#work-select').value);if(!id)return;collect();draft.programa.push({obraId:id,orde:draft.programa.length+1,solista:'',notas:''});render()});$('#program')?.addEventListener('click',e=>{const b=e.target.closest('[data-remove]');if(!b)return;collect();draft.programa.splice(Number(b.dataset.remove),1);render()});$('#save')?.addEventListener('click',async()=>{if(!selected)return;const m=$('#message');try{collect();m.textContent='Gardando en R2…';const x=await api('gardarPrograma',{idConcerto:selected.idConcerto,programa:draft.programa});m.textContent=`Gardado en R2 · ${x.total} obras`;render()}catch(e){m.textContent=e instanceof Error?e.message:String(e)}});$('#admin-concertos-proba-logout')?.addEventListener('click',async()=>{await closePortalSession();location.href='/'});load();
</script>
<style>
.main{padding:2rem;max-width:1300px;width:100%}.head,.section-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.head h1,.section-head h2{margin:.2rem 0}.head span,.section-head span{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:#756b65}.storage{border:1px solid #ddd3cc;padding:.7rem 1rem;border-radius:8px;display:grid}.card{background:#fff;border:1px solid #ded8d3;border-radius:10px;padding:1.2rem;margin:1rem 0}.selector label{display:grid;gap:.4rem}.selector select,.tools input,.tools select,.row input{min-height:42px;border:1px solid #cfc6c0;border-radius:6px;padding:.55rem .7rem;font:inherit}.tools{display:grid;grid-template-columns:minmax(220px,1fr) minmax(280px,1.4fr) auto;gap:.6rem;margin:1rem 0}.primary{background:#6b201f;color:#fff;border:0;border-radius:6px;padding:.65rem 1rem;font:inherit;cursor:pointer}.program{display:grid;gap:.55rem}.row{display:grid;grid-template-columns:2.2rem minmax(200px,1.4fr) minmax(130px,.7fr) minmax(160px,1fr) auto;gap:.55rem;align-items:center;border-top:1px solid #eee7e2;padding:.65rem 0}.row div{display:grid}.row small{color:#756b65}.num{font-weight:700}.remove{border:1px solid #c9bbb3;background:#fff;border-radius:5px;padding:.5rem}.actions{display:flex;justify-content:flex-end;margin-top:1rem}.message{min-height:1.4rem;color:#5f5650}.error{color:#7b1f1f}.empty{color:#756b65}@media(max-width:720px){.main{padding:1rem}.head{display:block}.storage{margin-top:.8rem}.tools{grid-template-columns:1fr}.tools .primary{width:100%}.row{grid-template-columns:2rem 1fr}.row input,.row .remove{grid-column:2}.section-head{align-items:center}}
</style>