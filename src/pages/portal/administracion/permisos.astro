---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
---
<BaseLayout title="Accesos e permisos" lang="gl">
  <div class="private-layout permisos-layout">
    <PortalSidebar active="administracion" logoutId="permisos-logout" />
    <main class="permisos-main">
      <a class="volver" href="/portal/administracion/">← Administración</a>
      <header><span>Seguridade e gobernanza</span><h1>Accesos e permisos</h1><p>Consulta quen pode acceder, concede permisos individualizados e revisa os accesos e accións realizadas.</p></header>
      <div id="estado">Cargando…</div>
      <nav><button data-tab="persoas" class="activo">Persoas</button><button data-tab="modulos">Módulos</button><button data-tab="actividade">Rexistro de actividade</button></nav>

      <section id="persoas" class="tab-panel">
        <div class="filtros"><input id="buscar" type="search" placeholder="Buscar por nome ou correo"><select id="filtro-modulo"><option value="">Todos os módulos</option></select></div>
        <div class="grid"><div id="lista" class="lista"></div><div id="detalle" class="detalle"><p>Selecciona unha persoa.</p></div></div>
      </section>

      <section id="modulos" class="tab-panel" hidden>
        <div class="filtros"><select id="modulo-consulta"></select></div>
        <div class="tabla"><table><thead><tr><th>Persoa</th><th>Correo</th><th>Nivel</th><th>Contido</th></tr></thead><tbody id="tabla-modulos"></tbody></table></div>
      </section>

      <section id="actividade" class="tab-panel" hidden>
        <div class="filtros"><input id="desde" type="date"><input id="ata" type="date"><select id="act-email"><option value="">Todas as persoas</option></select><select id="act-modulo"><option value="">Todos os módulos</option></select><button id="consultar">Consultar</button></div>
        <div class="tabla"><table><thead><tr><th>Data e hora</th><th>Persoa</th><th>Módulo</th><th>Acción</th><th>Elemento</th><th>Resultado</th></tr></thead><tbody id="tabla-actividade"></tbody></table></div>
      </section>
    </main>
  </div>
</BaseLayout>
<script>
  import { closePortalSession, portalRequest, waitForPortalUser } from '../../../lib/portal-session.js';
  const $=s=>document.querySelector(s); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const nomes={administracion:'Administración',persoas:'Persoas',ensaios:'Ensaios',concertos:'Concertos',fotografias:'Fotografías',documentacion:'Documentación',repertorio:'Repertorio',partituras:'Partituras',sincronizacion:'Sincronización',estado:'Estado do sistema',permisos:'Accesos e permisos'};
  const niveis={sen_acceso:'Sen acceso',lectura:'Lectura',escritura:'Lectura e escritura',administracion:'Administración'};
  let data={usuarios:[],permisos:[],modulos:[]},seleccion='';
  const nome=u=>u?.nome||u?.persoa||u?.email||'—'; const ps=email=>data.permisos.filter(p=>p.email===email&&p.activo!==false);
  function selects(){const op=data.modulos.map(m=>`<option value="${esc(m)}">${esc(nomes[m]||m)}</option>`).join('');$('#filtro-modulo').innerHTML='<option value="">Todos os módulos</option>'+op;$('#modulo-consulta').innerHTML=op;$('#act-modulo').innerHTML='<option value="">Todos os módulos</option>'+op;$('#act-email').innerHTML='<option value="">Todas as persoas</option>'+data.usuarios.map(u=>`<option value="${esc(u.email)}">${esc(nome(u))}</option>`).join('');}
  function lista(){const q=$('#buscar').value.toLowerCase(),m=$('#filtro-modulo').value;const us=data.usuarios.filter(u=>(!q||(`${nome(u)} ${u.email}`).toLowerCase().includes(q))&&(!m||ps(u.email).some(p=>p.modulo===m)));$('#lista').innerHTML=us.map(u=>`<button class="persoa ${seleccion===u.email?'sel':''}" data-email="${esc(u.email)}"><strong>${esc(nome(u))}</strong><small>${esc(u.email)} · ${ps(u.email).length} permisos</small></button>`).join('')||'<p>Sen resultados.</p>';document.querySelectorAll('.persoa').forEach(b=>b.onclick=()=>{seleccion=b.dataset.email;lista();detalle();});}
  function detalle(){const u=data.usuarios.find(x=>x.email===seleccion);if(!u){$('#detalle').innerHTML='<p>Selecciona unha persoa.</p>';return;}const perms=ps(u.email);$('#detalle').innerHTML=`<h2>${esc(nome(u))}</h2><p>${esc(u.email)}</p><div class="matriz">${data.modulos.map(m=>{const p=perms.find(x=>x.modulo===m&&!x.contido);return `<label><span>${esc(nomes[m]||m)}</span><select data-modulo="${esc(m)}"><option value="sen_acceso" ${!p||p.nivel==='sen_acceso'?'selected':''}>Sen acceso</option><option value="lectura" ${p?.nivel==='lectura'?'selected':''}>Lectura</option><option value="escritura" ${p?.nivel==='escritura'?'selected':''}>Lectura e escritura</option><option value="administracion" ${p?.nivel==='administracion'?'selected':''}>Administración</option></select></label>`}).join('')}</div><h3>Documentación por contido</h3><div class="filtros"><input id="contido" placeholder="Ex.: Actas XD"><select id="nivel-contido"><option value="lectura">Lectura</option><option value="escritura">Lectura e escritura</option><option value="administracion">Administración</option><option value="sen_acceso">Sen acceso</option></select><button id="add-contido">Engadir</button></div><div class="chips">${perms.filter(p=>p.modulo==='documentacion'&&p.contido).map(p=>`<button data-id="${esc(p.id)}">${esc(p.contido)} · ${esc(niveis[p.nivel]||p.nivel)} ×</button>`).join('')||'Sen excepcións específicas.'}</div>`;
    document.querySelectorAll('.matriz select').forEach(s=>s.onchange=async()=>{s.disabled=true;try{await portalRequest('/api/permisos','gardarPermisoPortal',{usuarioEmail:u.email,persoa:u.persoa||u.nome||'',modulo:s.dataset.modulo,contido:'',nivel:s.value,rol:''});await cargar(false);seleccion=u.email;lista();detalle();}catch(e){alert(e.message);s.disabled=false;}});
    $('#add-contido').onclick=async()=>{const c=$('#contido').value.trim();if(!c)return;try{await portalRequest('/api/permisos','gardarPermisoPortal',{usuarioEmail:u.email,persoa:u.persoa||u.nome||'',modulo:'documentacion',contido:c,nivel:$('#nivel-contido').value,rol:''});await cargar(false);seleccion=u.email;detalle();}catch(e){alert(e.message);}};
    document.querySelectorAll('.chips button[data-id]').forEach(b=>b.onclick=async()=>{if(!confirm('Eliminar este permiso específico?'))return;try{await portalRequest('/api/permisos','eliminarPermisoPortal',{id:b.dataset.id});await cargar(false);seleccion=u.email;detalle();}catch(e){alert(e.message);}});
  }
  function modulos(){const m=$('#modulo-consulta').value;$('#tabla-modulos').innerHTML=data.permisos.filter(p=>p.activo!==false&&p.modulo===m).map(p=>{const u=data.usuarios.find(x=>x.email===p.email);return `<tr><td>${esc(nome(u)||p.persoa)}</td><td>${esc(p.email)}</td><td>${esc(niveis[p.nivel]||p.nivel)}</td><td>${esc(p.contido||'—')}</td></tr>`}).join('')||'<tr><td colspan="4">Sen permisos definidos.</td></tr>';}
  async function actividade(){try{const r=await portalRequest('/api/permisos','listarActividadePortal',{desde:$('#desde').value,ata:$('#ata').value,filtroEmail:$('#act-email').value,filtroModulo:$('#act-modulo').value,limite:500});$('#tabla-actividade').innerHTML=(r.actividade||[]).map(a=>`<tr><td>${esc((a.dataHora||'').replace('T',' '))}</td><td>${esc(a.persoa||a.email)}</td><td>${esc(nomes[a.modulo]||a.modulo||'—')}</td><td>${esc(a.accion||'—')}</td><td>${esc(a.elemento||'—')}</td><td>${esc(a.resultado||'—')}</td></tr>`).join('')||'<tr><td colspan="6">Sen actividade.</td></tr>';}catch(e){$('#tabla-actividade').innerHTML=`<tr><td colspan="6">${esc(e.message)}</td></tr>`;}}
  async function cargar(show=true){if(show)$('#estado').textContent='Cargando…';try{const r=await portalRequest('/api/permisos','listarPermisosPortal');data={usuarios:r.usuarios||[],permisos:r.permisos||[],modulos:r.modulos||[]};selects();lista();detalle();modulos();$('#estado').textContent='';}catch(e){$('#estado').textContent=e.message||'Erro ao cargar.';}}
  document.querySelectorAll('nav button[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('nav button[data-tab]').forEach(x=>x.classList.toggle('activo',x===b));document.querySelectorAll('.tab-panel').forEach(x=>x.hidden=true);$('#'+b.dataset.tab).hidden=false;if(b.dataset.tab==='modulos')modulos();if(b.dataset.tab==='actividade')actividade();});
  $('#buscar').oninput=lista;$('#filtro-modulo').onchange=lista;$('#modulo-consulta').onchange=modulos;$('#consultar').onclick=actividade;$('#permisos-logout').onclick=()=>closePortalSession();const h=new Date().toISOString().slice(0,10);$('#desde').value=h;$('#ata').value=h;waitForPortalUser().then(u=>{if(!u?.email)location.href='/portal/';else cargar();});
</script>
<style is:global>
body{background:#f5f3f1}.permisos-layout{display:flex;min-height:100vh}.permisos-main{flex:1;min-width:0;padding:2rem clamp(1rem,3vw,3rem) 4rem;font-family:var(--fuente-minimalista)}.volver{color:#5d142b;text-decoration:none;font-weight:700}.permisos-main header{padding:1rem 0 1.3rem;border-bottom:1px solid #ddd6d1}.permisos-main header span{color:var(--color-acento);font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.permisos-main h1{margin:.2rem 0;color:#5d142b;font-size:clamp(2rem,4vw,3.2rem)}.permisos-main header p{margin:.4rem 0 0;color:#665f5b}#estado{margin:1rem 0;color:#7b312f}.permisos-main nav{display:flex;gap:.3rem;border-bottom:1px solid #d9d2cd}.permisos-main nav button{border:0;background:none;padding:.8rem 1rem;font-weight:750;color:#675f5a;cursor:pointer}.permisos-main nav button.activo{color:#5d142b;border-bottom:3px solid #5d142b}.tab-panel{padding-top:1rem}.filtros{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem}.filtros input,.filtros select,.filtros button,.matriz select{min-height:40px;border:1px solid #cec5bf;background:#fff;padding:.5rem .65rem;font:inherit}.filtros button{color:#fff;background:#5d142b;border-color:#5d142b;font-weight:700}.grid{display:grid;grid-template-columns:320px 1fr;gap:1rem}.lista,.detalle{background:#fff;border:1px solid #ddd6d1;min-height:480px}.lista{padding:.4rem}.persoa{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid #eee8e4;background:#fff;padding:.75rem;cursor:pointer}.persoa.sel{background:#f4e9ed}.persoa strong,.persoa small{display:block}.persoa small{color:#7d746f;margin-top:.2rem}.detalle{padding:1rem}.detalle h2{color:#5d142b;margin:.2rem 0}.matriz{margin:1rem 0}.matriz label{display:grid;grid-template-columns:1fr 220px;align-items:center;gap:1rem;border-top:1px solid #eee8e4;padding:.6rem 0}.chips{display:flex;gap:.4rem;flex-wrap:wrap}.chips button{border:1px solid #d5ccc6;background:#f7f3f1;padding:.35rem .55rem}.tabla{overflow:auto;background:#fff;border:1px solid #ddd6d1}.tabla table{width:100%;border-collapse:collapse;min-width:760px}.tabla th,.tabla td{padding:.65rem .75rem;border-bottom:1px solid #eee8e4;text-align:left}.tabla th{background:#f2eeeb;font-size:.75rem;text-transform:uppercase}@media(max-width:900px){.permisos-layout{display:block}.grid{grid-template-columns:1fr}.lista{min-height:0;max-height:320px;overflow:auto}}@media(max-width:620px){.permisos-main{padding:1rem .8rem 2rem}.matriz label{grid-template-columns:1fr}.filtros>*{width:100%}}
</style>
