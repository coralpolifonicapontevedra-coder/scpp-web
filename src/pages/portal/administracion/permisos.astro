---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
---

<BaseLayout title="Accesos e permisos" lang="gl">
  <div class="private-layout permisos-layout">
    <PortalSidebar active="administracion" logoutId="permisos-logout" />

    <main class="permisos-main">
      <header class="private-page-header permisos-header">
        <div>
          <a class="volver" href="/portal/administracion/">← Administración</a>
          <span class="section-kicker">Seguridade e gobernanza</span>
          <h1>Accesos e permisos</h1>
          <p>Define que pode consultar ou modificar cada persoa e revisa a actividade administrativa do portal.</p>
        </div>
        <div class="account-card">
          <span><small>Conta identificada</small><strong id="user-email">—</strong></span>
          <span><small>Nivel de acceso</small><strong id="user-level">Comprobando…</strong></span>
        </div>
      </header>

      <section id="loading" class="state-box">Comprobando permisos e cargando a configuración…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir Accesos e permisos</strong>
        <p id="error-message"></p>
        <button id="retry-button" type="button" class="secondary-action">Tentar de novo</button>
      </section>

      <section id="permissions-app" class="permissions-app" hidden>
        <div id="feedback" class="feedback" role="status" hidden></div>

        <section class="permissions-summary" aria-label="Resumo de permisos">
          <div><small>Persoas con acceso</small><strong id="metric-users">0</strong></div>
          <div><small>Permisos definidos</small><strong id="metric-permissions">0</strong></div>
          <div><small>Módulos xestionables</small><strong id="metric-modules">0</strong></div>
          <div><small>Administración</small><strong>Activa</strong></div>
        </section>

        <nav class="permissions-tabs" aria-label="Seccións de permisos">
          <button data-tab="persoas" class="activo" type="button"><span>Persoas</span><small>Permisos individuais</small></button>
          <button data-tab="modulos" type="button"><span>Módulos</span><small>Vista por área</small></button>
          <button data-tab="actividade" type="button"><span>Rexistro de actividade</span><small>Auditoría</small></button>
        </nav>

        <section id="persoas" class="tab-panel">
          <section class="filters-panel compact-filters">
            <label class="search-field"><span>Buscar persoa</span><input id="buscar" type="search" placeholder="Nome ou correo electrónico" autocomplete="off" /></label>
            <label><span>Filtrar por módulo</span><select id="filtro-modulo"><option value="">Todos os módulos</option></select></label>
          </section>

          <div class="permissions-grid">
            <section class="people-panel">
              <header><div><span class="section-kicker">Persoas</span><h2>Usuarios do portal</h2></div><strong id="visible-count">0</strong></header>
              <div id="lista" class="lista"></div>
            </section>

            <section id="detalle" class="detail-panel empty-detail">
              <div class="empty-icon">⌁</div>
              <h2>Selecciona unha persoa</h2>
              <p>Escolle un usuario da lista para consultar ou modificar os seus permisos.</p>
            </section>
          </div>
        </section>

        <section id="modulos" class="tab-panel" hidden>
          <section class="filters-panel compact-filters module-filter">
            <label><span>Módulo</span><select id="modulo-consulta"></select></label>
          </section>
          <div class="table-card">
            <header><div><span class="section-kicker">Vista por módulo</span><h2>Permisos configurados</h2></div></header>
            <div class="tabla"><table><thead><tr><th>Persoa</th><th>Correo</th><th>Nivel</th><th>Contido específico</th></tr></thead><tbody id="tabla-modulos"></tbody></table></div>
          </div>
        </section>

        <section id="actividade" class="tab-panel" hidden>
          <section class="filters-panel audit-filters">
            <label><span>Desde</span><input id="desde" type="date" /></label>
            <label><span>Ata</span><input id="ata" type="date" /></label>
            <label><span>Persoa</span><select id="act-email"><option value="">Todas as persoas</option></select></label>
            <label><span>Módulo</span><select id="act-modulo"><option value="">Todos os módulos</option></select></label>
            <button id="consultar" class="primary-action" type="button">Consultar actividade</button>
          </section>
          <div class="table-card">
            <header><div><span class="section-kicker">Auditoría</span><h2>Rexistro de actividade</h2></div></header>
            <div class="tabla"><table><thead><tr><th>Data e hora</th><th>Persoa</th><th>Módulo</th><th>Acción</th><th>Elemento</th><th>Resultado</th></tr></thead><tbody id="tabla-actividade"></tbody></table></div>
          </div>
        </section>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { closePortalSession, portalRequest, waitForPortalUser } from '../../../lib/portal-session.js';

  const $ = (selector) => document.querySelector(selector);
  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[char]));

  const nomes = {
    administracion:'Administración', persoas:'Persoas', ensaios:'Ensaios', concertos:'Concertos',
    fotografias:'Fotografías', documentacion:'Documentación', repertorio:'Repertorio',
    partituras:'Partituras', sincronizacion:'Sincronización', estado:'Estado do sistema', permisos:'Accesos e permisos'
  };
  const niveis = {
    sen_acceso:'Sen acceso', lectura:'Lectura', escritura:'Lectura e escritura', administracion:'Administración'
  };

  let data = { usuarios:[], permisos:[], modulos:[] };
  let seleccion = '';

  const nome = (u) => u?.nome || u?.persoa || u?.email || '—';
  const permisosUsuario = (email) => data.permisos.filter((p) => p.email === email && p.activo !== false);

  function notify(message, kind='ok') {
    const feedback = $('#feedback');
    if (!(feedback instanceof HTMLElement)) return;
    feedback.textContent = message;
    feedback.className = `feedback ${kind === 'error' ? 'is-error' : 'is-ok'}`;
    feedback.hidden = false;
    setTimeout(() => { feedback.hidden = true; }, 4500);
  }

  function actualizarMetricas() {
    $('#metric-users').textContent = String(data.usuarios.length);
    $('#metric-permissions').textContent = String(data.permisos.filter((p) => p.activo !== false).length);
    $('#metric-modules').textContent = String(data.modulos.length);
  }

  function cargarSelects() {
    const options = data.modulos.map((m) => `<option value="${esc(m)}">${esc(nomes[m] || m)}</option>`).join('');
    $('#filtro-modulo').innerHTML = '<option value="">Todos os módulos</option>' + options;
    $('#modulo-consulta').innerHTML = options;
    $('#act-modulo').innerHTML = '<option value="">Todos os módulos</option>' + options;
    $('#act-email').innerHTML = '<option value="">Todas as persoas</option>' + data.usuarios
      .map((u) => `<option value="${esc(u.email)}">${esc(nome(u))}</option>`).join('');
  }

  function renderLista() {
    const query = String($('#buscar').value || '').toLowerCase();
    const modulo = $('#filtro-modulo').value;
    const usuarios = data.usuarios.filter((u) => {
      const coincideTexto = !query || (`${nome(u)} ${u.email}`).toLowerCase().includes(query);
      const coincideModulo = !modulo || permisosUsuario(u.email).some((p) => p.modulo === modulo);
      return coincideTexto && coincideModulo;
    });

    $('#visible-count').textContent = String(usuarios.length);
    $('#lista').innerHTML = usuarios.map((u) => {
      const permisos = permisosUsuario(u.email);
      const seleccionada = seleccion === u.email;
      return `<button class="persoa ${seleccionada ? 'sel' : ''}" data-email="${esc(u.email)}" type="button">
        <span class="person-avatar">${esc((nome(u).charAt(0) || '?').toUpperCase())}</span>
        <span class="person-copy"><strong>${esc(nome(u))}</strong><small>${esc(u.email)}</small></span>
        <span class="permission-count">${permisos.length}</span>
      </button>`;
    }).join('') || '<div class="empty-list"><strong>Sen resultados</strong><span>Non hai persoas que coincidan cos filtros.</span></div>';

    document.querySelectorAll('.persoa').forEach((button) => {
      button.onclick = () => {
        seleccion = button.dataset.email || '';
        renderLista();
        renderDetalle();
      };
    });
  }

  function renderDetalle() {
    const usuario = data.usuarios.find((item) => item.email === seleccion);
    const detalle = $('#detalle');
    if (!usuario) {
      detalle.className = 'detail-panel empty-detail';
      detalle.innerHTML = '<div class="empty-icon">⌁</div><h2>Selecciona unha persoa</h2><p>Escolle un usuario da lista para consultar ou modificar os seus permisos.</p>';
      return;
    }

    const permisos = permisosUsuario(usuario.email);
    detalle.className = 'detail-panel';
    detalle.innerHTML = `
      <header class="detail-header">
        <div><span class="section-kicker">Permisos individuais</span><h2>${esc(nome(usuario))}</h2><p>${esc(usuario.email)}</p></div>
        <span class="detail-badge">${permisos.length} definidos</span>
      </header>
      <section class="permission-section">
        <div class="section-intro"><h3>Acceso por módulo</h3><p>Escolle o nivel xeral que terá esta persoa en cada área do portal.</p></div>
        <div class="matriz">${data.modulos.map((modulo) => {
          const permiso = permisos.find((p) => p.modulo === modulo && !p.contido);
          const nivel = permiso?.nivel || 'sen_acceso';
          return `<label>
            <span><strong>${esc(nomes[modulo] || modulo)}</strong><small>Permiso xeral do módulo</small></span>
            <select data-modulo="${esc(modulo)}">
              <option value="sen_acceso" ${nivel === 'sen_acceso' ? 'selected' : ''}>Sen acceso</option>
              <option value="lectura" ${nivel === 'lectura' ? 'selected' : ''}>Lectura</option>
              <option value="escritura" ${nivel === 'escritura' ? 'selected' : ''}>Lectura e escritura</option>
              <option value="administracion" ${nivel === 'administracion' ? 'selected' : ''}>Administración</option>
            </select>
          </label>`;
        }).join('')}</div>
      </section>
      <section class="permission-section content-permissions">
        <div class="section-intro"><h3>Documentación por contido</h3><p>Engade excepcións para tipos concretos de documentación, por exemplo actas ou contratos.</p></div>
        <div class="inline-form">
          <label><span>Contido</span><input id="contido" placeholder="Ex.: Actas XD" /></label>
          <label><span>Nivel</span><select id="nivel-contido"><option value="lectura">Lectura</option><option value="escritura">Lectura e escritura</option><option value="administracion">Administración</option><option value="sen_acceso">Sen acceso</option></select></label>
          <button id="add-contido" class="secondary-action" type="button">Engadir permiso</button>
        </div>
        <div class="chips">${permisos.filter((p) => p.modulo === 'documentacion' && p.contido).map((p) => `<button data-id="${esc(p.id)}" type="button"><span>${esc(p.contido)}</span><small>${esc(niveis[p.nivel] || p.nivel)}</small><b>×</b></button>`).join('') || '<span class="muted-copy">Sen excepcións específicas.</span>'}</div>
      </section>`;

    document.querySelectorAll('.matriz select').forEach((select) => {
      select.onchange = async () => {
        select.disabled = true;
        try {
          await portalRequest('/api/permisos', 'gardarPermisoPortal', {
            usuarioEmail: usuario.email,
            persoa: usuario.persoa || usuario.nome || '',
            modulo: select.dataset.modulo,
            contido: '',
            nivel: select.value,
            rol: ''
          });
          await cargar(false);
          seleccion = usuario.email;
          renderLista();
          renderDetalle();
          notify('Permiso actualizado correctamente.');
        } catch (error) {
          notify(error.message || 'Non foi posible gardar o permiso.', 'error');
          select.disabled = false;
        }
      };
    });

    $('#add-contido').onclick = async () => {
      const contido = $('#contido').value.trim();
      if (!contido) return;
      try {
        await portalRequest('/api/permisos', 'gardarPermisoPortal', {
          usuarioEmail: usuario.email,
          persoa: usuario.persoa || usuario.nome || '',
          modulo: 'documentacion',
          contido,
          nivel: $('#nivel-contido').value,
          rol: ''
        });
        await cargar(false);
        seleccion = usuario.email;
        renderLista();
        renderDetalle();
        notify('Permiso específico engadido.');
      } catch (error) {
        notify(error.message || 'Non foi posible engadir o permiso.', 'error');
      }
    };

    document.querySelectorAll('.chips button[data-id]').forEach((button) => {
      button.onclick = async () => {
        if (!confirm('Eliminar este permiso específico?')) return;
        try {
          await portalRequest('/api/permisos', 'eliminarPermisoPortal', { id: button.dataset.id });
          await cargar(false);
          seleccion = usuario.email;
          renderLista();
          renderDetalle();
          notify('Permiso específico eliminado.');
        } catch (error) {
          notify(error.message || 'Non foi posible eliminar o permiso.', 'error');
        }
      };
    });
  }

  function renderModulos() {
    const modulo = $('#modulo-consulta').value;
    const permisos = data.permisos.filter((p) => p.activo !== false && p.modulo === modulo);
    $('#tabla-modulos').innerHTML = permisos.map((p) => {
      const usuario = data.usuarios.find((item) => item.email === p.email);
      return `<tr><td><strong>${esc(nome(usuario) || p.persoa)}</strong></td><td>${esc(p.email)}</td><td><span class="level-pill">${esc(niveis[p.nivel] || p.nivel)}</span></td><td>${esc(p.contido || '—')}</td></tr>`;
    }).join('') || '<tr><td colspan="4" class="table-empty">Non hai permisos definidos neste módulo.</td></tr>';
  }

  async function renderActividade() {
    const tbody = $('#tabla-actividade');
    tbody.innerHTML = '<tr><td colspan="6" class="table-empty">Cargando actividade…</td></tr>';
    try {
      const response = await portalRequest('/api/permisos', 'listarActividadePortal', {
        desde: $('#desde').value,
        ata: $('#ata').value,
        filtroEmail: $('#act-email').value,
        filtroModulo: $('#act-modulo').value,
        limite: 500
      });
      tbody.innerHTML = (response.actividade || []).map((item) => `<tr><td>${esc((item.dataHora || '').replace('T',' '))}</td><td><strong>${esc(item.persoa || item.email)}</strong></td><td>${esc(nomes[item.modulo] || item.modulo || '—')}</td><td>${esc(item.accion || '—')}</td><td>${esc(item.elemento || '—')}</td><td><span class="result-pill">${esc(item.resultado || '—')}</span></td></tr>`).join('') || '<tr><td colspan="6" class="table-empty">Non hai actividade para os filtros seleccionados.</td></tr>';
    } catch (error) {
      tbody.innerHTML = `<tr><td colspan="6" class="table-empty error-copy">${esc(error.message || 'Non foi posible consultar a actividade.')}</td></tr>`;
    }
  }

  async function cargar(showLoading = true) {
    const loading = $('#loading');
    const errorState = $('#error-state');
    const app = $('#permissions-app');
    if (showLoading) {
      loading.hidden = false;
      errorState.hidden = true;
      app.hidden = true;
    }

    try {
      const response = await portalRequest('/api/permisos', 'listarPermisosPortal');
      data = {
        usuarios: response.usuarios || [],
        permisos: response.permisos || [],
        modulos: response.modulos || []
      };
      cargarSelects();
      actualizarMetricas();
      renderLista();
      renderDetalle();
      renderModulos();
      loading.hidden = true;
      errorState.hidden = true;
      app.hidden = false;
      $('#user-level').textContent = response.administrador ? 'Administración' : 'Acceso autorizado';
    } catch (error) {
      loading.hidden = true;
      app.hidden = true;
      errorState.hidden = false;
      $('#error-message').textContent = error.message || 'Produciuse un erro inesperado.';
      $('#user-level').textContent = 'Sen autorización';
    }
  }

  document.querySelectorAll('.permissions-tabs button[data-tab]').forEach((button) => {
    button.onclick = () => {
      document.querySelectorAll('.permissions-tabs button[data-tab]').forEach((item) => item.classList.toggle('activo', item === button));
      document.querySelectorAll('.tab-panel').forEach((panel) => { panel.hidden = true; });
      $('#' + button.dataset.tab).hidden = false;
      if (button.dataset.tab === 'modulos') renderModulos();
      if (button.dataset.tab === 'actividade') renderActividade();
    };
  });

  $('#buscar').oninput = renderLista;
  $('#filtro-modulo').onchange = renderLista;
  $('#modulo-consulta').onchange = renderModulos;
  $('#consultar').onclick = renderActividade;
  $('#retry-button').onclick = () => cargar(true);
  $('#permisos-logout').onclick = () => closePortalSession();

  const hoxe = new Date().toISOString().slice(0, 10);
  $('#desde').value = hoxe;
  $('#ata').value = hoxe;

  waitForPortalUser().then((user) => {
    if (!user?.email) {
      location.href = '/portal/';
      return;
    }
    $('#user-email').textContent = user.email;
    cargar(true);
  });
</script>

<style is:global>
  body{background:#f5f3f1}
  .permisos-layout{display:flex;min-height:100vh}
  .permisos-main{flex:1;min-width:0;padding:2rem clamp(1.15rem,3vw,3.4rem) 4rem;font-family:var(--fuente-minimalista)}
  .permisos-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-end;padding-bottom:1.35rem;border-bottom:1px solid #ded7d2}
  .volver{display:inline-block;margin-bottom:1.25rem;color:#6b2135;text-decoration:none;font-weight:700;font-size:.92rem}
  .section-kicker{display:block;color:var(--color-acento);font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}
  .permisos-main h1{margin:.25rem 0 .45rem;color:#61152c;font-size:clamp(2.25rem,4vw,3.45rem);line-height:1.02}
  .permisos-header p{max-width:760px;margin:0;color:#6c625d;font-size:1.03rem;line-height:1.55}
  .account-card{display:grid;grid-template-columns:1fr;gap:.55rem;min-width:250px;background:#fff;border:1px solid #e1d9d3;border-radius:16px;padding:1rem 1.1rem;box-shadow:0 10px 28px rgba(59,40,32,.05)}
  .account-card span{display:grid;gap:.15rem}.account-card small{color:#8b7f78;font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;font-weight:750}.account-card strong{color:#352d29;font-size:.9rem;overflow-wrap:anywhere}
  .state-box{margin-top:1.25rem;background:#fff;border:1px solid #e0d8d2;border-radius:14px;padding:1rem 1.1rem;color:#665d58}.error-box{border-color:#dfc6c6;background:#fffafa}.error-box strong{color:#7a2234}.error-box p{margin:.35rem 0 .9rem}
  .permissions-app{margin-top:1.15rem}.feedback{position:sticky;top:.75rem;z-index:5;margin-bottom:1rem;padding:.8rem 1rem;border-radius:12px;font-weight:700;box-shadow:0 8px 24px rgba(40,30,25,.08)}.feedback.is-ok{background:#f2f7f2;border:1px solid #cbdcca;color:#33543a}.feedback.is-error{background:#fff5f5;border:1px solid #e1c7c7;color:#812f39}
  .permissions-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-bottom:1rem}.permissions-summary>div{background:#fff;border:1px solid #e1d9d3;border-radius:14px;padding:.9rem 1rem;display:grid;gap:.15rem}.permissions-summary small{color:#8a7d76;font-size:.7rem;text-transform:uppercase;letter-spacing:.07em;font-weight:750}.permissions-summary strong{font-size:1.45rem;color:#61152c}
