---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
---
<BaseLayout title="Nova administración de persoas" lang="gl">
<div class="private-layout"><PortalSidebar active="administracion" logoutId="pn-logout" />
<main class="pn-main">
<header class="pn-head"><div><span>ADMINISTRACIÓN · NOVO MÓDULO</span><h1>Xestión de persoas</h1><p>Módulo novo e independente para altas, invitacións, fotografía, revisión legal, edición e baixas.</p></div><div class="pn-account"><small>CONTA</small><strong id="pn-email">—</strong><small>NIVEL</small><strong id="pn-level">Comprobando…</strong></div></header>
<section id="pn-loading" class="box">Comprobando permisos e cargando persoas…</section>
<section id="pn-error" class="box error" hidden></section>
<section id="pn-app" hidden>
<div class="metrics"><div><small>Rexistradas</small><strong id="m-total">0</strong></div><div><small>Activas</small><strong id="m-active">0</strong></div><div><small>Baixas</small><strong id="m-inactive">0</strong></div><div><small>Pendentes</small><strong id="m-pending">0</strong></div></div>
<div class="actions"><a class="btn secondary" href="/portal/administracion/persoas-revisions/">Invitación / revisión masiva</a><button id="btn-invite" class="btn secondary">+ Alta por invitación</button><button id="btn-new" class="btn primary">+ Alta de persoa</button></div>
<div class="filters"><input id="search" type="search" placeholder="Buscar por nome, apelidos, correo ou teléfono…"><select id="state"><option value="all">Todas</option><option value="active">Activas</option><option value="inactive">Baixas</option><option value="pending">Pendentes</option></select></div>
<div class="list-wrap"><select id="people"><option value="">Escolle unha persoa…</option></select><span id="count"></span></div>
<article id="card" class="card" hidden><div><div class="badges"><span id="badge-state"></span><span id="badge-type"></span></div><h2 id="card-name"></h2><p id="card-info"></p></div><div class="card-actions"><button id="btn-edit" class="btn secondary">Editar</button><button id="btn-review" class="btn secondary">Xerar revisión</button><button id="btn-toggle" class="btn danger"></button></div><dl id="details"></dl></article>
<div id="feedback" class="box" hidden></div>
</section>
</main></div>

<dialog id="dlg"><form id="form" method="dialog"><header><div><small id="dlg-kicker">ADMINISTRACIÓN · PERSOAS</small><h2 id="dlg-title">Nova persoa</h2></div><button type="button" id="dlg-x">×</button></header>
<div class="grid"><label>Nome *<input id="f-nome" required></label><label id="wrap-primeiro">Primeiro apelido *<input id="f-primeiro"></label><label>Segundo apelido<input id="f-segundo"></label><label>Correo electrónico<input id="f-correo" type="email"></label><label>Teléfono<input id="f-telefono" type="tel"></label><label>NIF<input id="f-nif"></label><label>Data de nacemento<input id="f-nacemento" type="date"></label><label>Voz<input id="f-voz"></label><label>Tipo de socio<input id="f-tipo"></label><label>Cargo<input id="f-cargo"></label><label>Data incorporación<input id="f-incorporacion" type="date"></label><label>Cidade<input id="f-cidade"></label><label>CP<input id="f-cp"></label><label class="wide">Enderezo<input id="f-enderezo"></label><label class="wide">Contacto de emerxencia<input id="f-emerxencia"></label><label>Teléfono emerxencia<input id="f-tel-em" type="tel"></label><label>Preferencia comunicación<input id="f-comunicacion"></label><label>Consentimento fotografía<input id="f-consent"></label><label class="wide">Fotografía de perfil (opcional)<input id="f-foto" type="file" accept="image/jpeg,image/png,image/webp"><small>JPG, PNG ou WebP · máximo 5 MB. É privada e non autoriza a publicación.</small></label><label class="check"><input id="f-web" type="checkbox"> Mostrar na web cando corresponda</label><label class="check"><input id="f-aniv" type="checkbox"> Mostrar aniversario</label><label class="wide">Observacións<textarea id="f-obs"></textarea></label><label class="wide">Observacións privadas<textarea id="f-priv"></textarea></label></div>
<section id="legal" class="legal"><strong>Texto legal vixente</strong><p id="legal-title"></p><details><summary>Ver texto completo</summary><div id="legal-text"></div></details><small>A aceptación corresponde á persoa interesada e rexistrarase cando complete a revisión. O consentimento de imaxe é independente.</small></section>
<p id="form-state"></p><footer><button type="button" id="cancel" class="btn secondary">Cancelar</button><button id="save" class="btn primary">Gardar</button></footer></form></dialog>

<dialog id="review-dlg"><section class="review"><header><h2>Ligazón segura</h2><button type="button" id="review-x">×</button></header><p id="review-name"></p><input id="review-link" readonly><small id="review-exp"></small><footer><button id="copy" class="btn secondary">Copiar ligazón</button><button id="open" class="btn primary">Abrir revisión</button></footer></section></dialog>

<script>
import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
const $=s=>document.querySelector(s);let persoas=[],selected=null,mode='create',legal=null;
const clean=v=>String(v??'').trim(),norm=v=>clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
async function api(accion,extra={}){const u=auth.currentUser;if(!u)throw new Error('Sesión non activa');const idToken=await u.getIdToken();const r=await fetch('/api/persoas-novo',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const j=await r.json().catch(()=>null);if(!r.ok||!j?.ok)throw new Error(j?.erro||`Erro HTTP ${r.status}`);return j;}
async function review(accion,extra={}){const u=auth.currentUser;const idToken=await u.getIdToken();const r=await fetch('/api/persoas-revision',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const j=await r.json().catch(()=>null);if(!r.ok||!j?.ok)throw new Error(j?.erro||`Erro HTTP ${r.status}`);return j;}
async function uploadPhoto(id,file){if(!file)return;const u=auth.currentUser;const fd=new FormData();fd.set('idToken',await u.getIdToken());fd.set('idPersoa',id);fd.set('foto',file);const r=await fetch('/api/persoas-novo-foto',{method:'POST',body:fd});const j=await r.json().catch(()=>null);if(!r.ok||!j?.ok)throw new Error(j?.erro||'Non foi posible gardar a fotografía');}
function key(p){return clean(p?.idPersoa||p?.id||p?.rowId)}
function filter(){const q=norm($('#search').value),st=$('#state').value;return persoas.filter(p=>{const hay=!q||norm([p.nomeCompleto,p.correo,p.telefono,p.nif].join(' ')).includes(q);const pend=clean(p.estadoAlta).toUpperCase()==='PENDENTE';const state=st==='all'||(st==='active'&&p.activo===true)||(st==='inactive'&&p.activo!==true)||(st==='pending'&&pend);return hay&&state;});}
function render(){const rows=filter(),sel=$('#people'),keep=sel.value;sel.innerHTML='<option value="">Escolle unha persoa…</option>';rows.forEach(p=>sel.add(new Option(`${p.nomeCompleto||p.etiqueta}${clean(p.estadoAlta).toUpperCase()==='PENDENTE'?' · PENDENTE':''}`,key(p))));if(rows.some(p=>key(p)===keep))sel.value=keep;$('#count').textContent=`${rows.length} de ${persoas.length} persoas`;$('#m-total').textContent=persoas.length;$('#m-active').textContent=persoas.filter(p=>p.activo===true).length;$('#m-inactive').textContent=persoas.filter(p=>p.activo!==true).length;$('#m-pending').textContent=persoas.filter(p=>clean(p.estadoAlta).toUpperCase()==='PENDENTE').length;showCard();}
function showCard(){selected=persoas.find(p=>key(p)===$('#people').value)||null;const c=$('#card');if(!selected){c.hidden=true;return}c.hidden=false;$('#card-name').textContent=selected.nomeCompleto||selected.etiqueta;$('#card-info').textContent=[selected.correo,selected.telefono,selected.voz].filter(Boolean).join(' · ');$('#badge-state').textContent=selected.activo?'ACTIVA':'BAIXA';$('#badge-type').textContent=clean(selected.estadoAlta).toUpperCase()==='PENDENTE'?'PENDENTE DE COMPLETAR':(selected.tipoSocio||'');$('#btn-toggle').textContent=selected.activo?'Rexistrar baixa':'Reactivar';const fields=[['NIF',selected.nif],['Voz',selected.voz],['Tipo de socio',selected.tipoSocio],['Cargo',selected.cargo],['Data nacemento',selected.dataNacemento],['Data incorporación',selected.dataIncorporacion],['Enderezo',[selected.enderezo,selected.cidade,selected.cp].filter(Boolean).join(' · ')],['Contacto emerxencia',[selected.contactoEmerxencia,selected.telefonoEmerxencia].filter(Boolean).join(' · ')],['Consentimento fotografía',selected.consentimentoFoto]];$('#details').innerHTML=fields.filter(x=>x[1]).map(x=>`<div><dt>${x[0]}</dt><dd>${String(x[1]).replaceAll('<','&lt;')}</dd></div>`).join('');}
async function load(){try{const r=await api('listar');persoas=Array.isArray(r.persoas)?r.persoas:[];legal=r.textoLegalPersoas||null;$('#pn-email').textContent=auth.currentUser?.email||'—';$('#pn-level').textContent=r.perfil?.nivel||'—';$('#pn-loading').hidden=true;$('#pn-app').hidden=false;render();}catch(e){$('#pn-loading').hidden=true;$('#pn-error').hidden=false;$('#pn-error').textContent=e.message;}}
const fields={nome:'#f-nome',primeiroApelido:'#f-primeiro',segundoApelido:'#f-segundo',correo:'#f-correo',telefono:'#f-telefono',nif:'#f-nif',dataNacemento:'#f-nacemento',voz:'#f-voz',tipoSocio:'#f-tipo',cargo:'#f-cargo',dataIncorporacion:'#f-incorporacion',cidade:'#f-cidade',cp:'#f-cp',enderezo:'#f-enderezo',contactoEmerxencia:'#f-emerxencia',telefonoEmerxencia:'#f-tel-em',preferenciaComunicacion:'#f-comunicacion',consentimentoFoto:'#f-consent',observacions:'#f-obs',observacionsPrivadas:'#f-priv'};
function openForm(m){mode=m;$('#form').reset();$('#form-state').textContent='';$('#dlg-title').textContent=m==='invite'?'Alta por invitación':m==='edit'?'Editar persoa':'Nova persoa';$('#wrap-primeiro').style.display=m==='invite'?'none':'';$('#f-primeiro').required=m!=='invite';if(m==='edit'&&selected){Object.entries(fields).forEach(([k,s])=>{$(s).value=clean(selected[k])});$('#f-web').checked=selected.mostrarWeb===true;$('#f-aniv').checked=selected.mostrarAniversario===true;}$('#legal-title').textContent=legal?`${legal.titulo} · versión ${legal.version}`:'Texto legal non dispoñible';$('#legal-text').textContent=legal?.texto||'';$('#dlg').showModal();}
function payload(){const p={};Object.entries(fields).forEach(([k,s])=>p[k]=clean($(s).value));p.mostrarWeb=$('#f-web').checked;p.mostrarAniversario=$('#f-aniv').checked;return p;}
async function save(ev){ev.preventDefault();const btn=$('#save');btn.disabled=true;$('#form-state').textContent='Gardando…';try{const p=payload(),file=$('#f-foto').files?.[0]||null;let r;if(mode==='edit')r=await api('actualizar',{idPersoa:key(selected),persoa:p});else r=await api(mode==='invite'?'crearInvitacion':'crear',{persoa:p});const id=clean(r.idPersoa||key(selected));if(file)await uploadPhoto(id,file);$('#dlg').close();await load();$('#people').value=id;showCard();if(mode==='invite'){await makeReview(id);}notify('Operación completada correctamente.');}catch(e){$('#form-state').textContent=e.message;}finally{btn.disabled=false;}}
async function makeReview(id){try{const r=await review('xerarLigazon',{idPersoa:id});$('#review-name').textContent=r.persoa||'';$('#review-link').value=r.ligazon;$('#review-exp').textContent=r.caducaEn?`Caduca: ${new Date(r.caducaEn).toLocaleString('gl-ES')}`:'';$('#review-dlg').showModal();}catch(e){notify(e.message,true);}}
function notify(msg,err=false){const f=$('#feedback');f.hidden=false;f.textContent=msg;f.className=`box ${err?'error':''}`;setTimeout(()=>f.hidden=true,5000);}
$('#btn-new').onclick=()=>openForm('create');$('#btn-invite').onclick=()=>openForm('invite');$('#btn-edit').onclick=()=>openForm('edit');$('#btn-review').onclick=()=>selected&&makeReview(key(selected));$('#btn-toggle').onclick=async()=>{if(!selected)return;try{await api('estado',{idPersoa:key(selected),activo:!selected.activo});await load();}catch(e){notify(e.message,true)}};$('#form').addEventListener('submit',save);$('#dlg-x').onclick=$('#cancel').onclick=()=>$('#dlg').close();$('#review-x').onclick=()=>$('#review-dlg').close();$('#copy').onclick=async()=>{await navigator.clipboard.writeText($('#review-link').value);notify('Ligazón copiada.')};$('#open').onclick=()=>window.open($('#review-link').value,'_blank','noopener');$('#people').onchange=showCard;$('#search').oninput=render;$('#state').onchange=render;$('#pn-logout')?.addEventListener('click',()=>closePortalSession());
waitForPortalUser().then(u=>{if(!u?.email){location.href='/portal/';return}load();});
</script>
<style>
.pn-main{padding:2rem 3rem;max-width:1500px;width:100%}.pn-head{display:flex;justify-content:space-between;gap:2rem;margin-bottom:2rem}.pn-head span{font-size:.75rem;color:#ad7b22;font-weight:700}.pn-head h1{font-size:3rem;color:#741827;margin:.5rem 0}.pn-head p{max-width:820px}.pn-account{border:1px solid #ddd;padding:1rem 1.4rem;min-width:220px;display:grid;gap:.3rem;height:max-content}.pn-account small{font-size:.65rem}.box{border:1px solid #ddd;padding:1rem;margin:1rem 0}.error{color:#a11;border-color:#d8b1b1}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.metrics div{border:1px solid #ddd;padding:1rem}.metrics small{display:block;font-size:.7rem}.metrics strong{font-size:1.5rem;color:#741827}.actions{display:flex;justify-content:flex-end;gap:.7rem;margin:1rem 0}.btn{padding:.75rem 1rem;border:1px solid #c8bebe;background:#fff;font-weight:700;text-decoration:none;color:#222;cursor:pointer}.primary{background:#741827;color:#fff;border-color:#741827}.danger{color:#741827;border-color:#741827}.filters{display:grid;grid-template-columns:1fr 240px;gap:1rem;border:1px solid #ddd;padding:1rem}.filters input,.filters select,.list-wrap select{padding:.8rem;border:1px solid #ccc;width:100%}.list-wrap{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;margin:1rem 0}.card{border:1px solid #ddd;padding:1.3rem}.card-actions{display:flex;gap:.5rem;justify-content:flex-end}.badges span{display:inline-block;padding:.25rem .5rem;background:#f2eded;margin-right:.4rem;font-size:.7rem;font-weight:700}.card dl{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;border-top:1px solid #eee;padding-top:1rem}.card dt{font-size:.7rem;text-transform:uppercase}.card dd{margin:.25rem 0}dialog{border:0;padding:0;width:min(900px,94vw);box-shadow:0 20px 70px #0004}dialog form,.review{padding:1.5rem}dialog header,dialog footer{display:flex;justify-content:space-between;align-items:center;gap:1rem}dialog header button{font-size:1.5rem;border:0;background:none}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1rem 0}.grid label{display:grid;gap:.35rem;font-weight:600}.grid input,.grid textarea{padding:.7rem;border:1px solid #ccc}.wide{grid-column:1/-1}.check{display:flex!important;grid-template-columns:auto 1fr;align-items:center}.legal{background:#f8f5ef;padding:1rem;margin:1rem 0}.legal #legal-text{white-space:pre-wrap;max-height:220px;overflow:auto}.review input{width:100%;padding:.8rem;margin:1rem 0}.review footer{margin-top:1rem}@media(max-width:850px){.pn-main{padding:1rem}.pn-head{display:block}.metrics{grid-template-columns:1fr 1fr}.actions{flex-wrap:wrap}.filters,.grid,.card dl{grid-template-columns:1fr}.wide{grid-column:auto}}
</style>
</BaseLayout>
