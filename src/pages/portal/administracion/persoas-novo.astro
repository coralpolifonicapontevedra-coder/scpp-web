---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
---

<BaseLayout title="Nova administración de persoas" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="pn-logout" />
    <main class="people-main">
      <header class="page-head">
        <div>
          <span class="kicker">ADMINISTRACIÓN · NOVO MÓDULO</span>
          <h1>Xestión de persoas</h1>
          <p>Alta, invitación, fotografía de perfil, revisión legal, edición e baixa.</p>
        </div>
        <div class="account-card">
          <small>CONTA</small><strong id="pn-email">—</strong>
          <small>NIVEL</small><strong id="pn-level">Comprobando…</strong>
        </div>
      </header>

      <section id="pn-loading" class="state-box">Comprobando permisos e cargando persoas…</section>
      <section id="pn-error" class="state-box error" hidden></section>

      <section id="pn-app" hidden>
        <div class="metrics">
          <div><small>Rexistradas</small><strong id="m-total">0</strong></div>
          <div><small>Activas</small><strong id="m-active">0</strong></div>
          <div><small>Baixas</small><strong id="m-inactive">0</strong></div>
          <div><small>Pendentes</small><strong id="m-pending">0</strong></div>
        </div>

        <div class="actions">
          <a class="button secondary" href="/portal/administracion/persoas-revisions/">Invitación / revisión masiva</a>
          <button id="btn-invite" class="button secondary" type="button">+ Alta por invitación</button>
          <button id="btn-new" class="button primary" type="button">+ Alta de persoa</button>
        </div>

        <div class="filters">
          <input id="search" type="search" placeholder="Buscar por nome, apelidos, correo ou teléfono…" />
          <select id="state">
            <option value="all">Todas</option>
            <option value="active">Activas</option>
            <option value="inactive">Baixas</option>
            <option value="pending">Pendentes</option>
          </select>
        </div>

        <div class="selector-row">
          <select id="people"><option value="">Escolle unha persoa…</option></select>
          <span id="count"></span>
        </div>

        <article id="card" class="person-card" hidden>
          <div class="card-title">
            <div><span id="badge-state" class="badge"></span><span id="badge-type" class="badge"></span></div>
            <h2 id="card-name"></h2>
            <p id="card-info"></p>
          </div>
          <div class="card-actions">
            <button id="btn-edit" class="button secondary" type="button">Editar</button>
            <button id="btn-review" class="button secondary" type="button">Xerar revisión</button>
            <button id="btn-toggle" class="button danger" type="button"></button>
          </div>
          <dl id="details"></dl>
        </article>
        <div id="feedback" class="state-box" hidden></div>
      </section>
    </main>
  </div>

  <dialog id="dlg">
    <form id="form">
      <header class="dialog-head"><div><small>ADMINISTRACIÓN · PERSOAS</small><h2 id="dlg-title">Nova persoa</h2></div><button id="dlg-x" type="button">×</button></header>
      <div class="form-grid">
        <label>Nome *<input id="f-nome" required /></label>
        <label id="wrap-primeiro">Primeiro apelido *<input id="f-primeiro" /></label>
        <label>Segundo apelido<input id="f-segundo" /></label>
        <label>Correo electrónico<input id="f-correo" type="email" /></label>
        <label>Teléfono<input id="f-telefono" type="tel" /></label>
        <label>NIF<input id="f-nif" /></label>
        <label>Data de nacemento<input id="f-nacemento" type="date" /></label>
        <label>Voz<input id="f-voz" /></label>
        <label>Tipo de socio<input id="f-tipo" /></label>
        <label>Cargo<input id="f-cargo" /></label>
        <label>Data incorporación<input id="f-incorporacion" type="date" /></label>
        <label>Cidade<input id="f-cidade" /></label>
        <label>CP<input id="f-cp" /></label>
        <label class="wide">Enderezo<input id="f-enderezo" /></label>
        <label class="wide">Fotografía de perfil (opcional)<input id="f-foto" type="file" accept="image/jpeg,image/png,image/webp" /><small>JPG, PNG ou WebP · máximo 5 MB. Privada; non autoriza publicación.</small></label>
        <label class="wide">Consentimento fotografía<input id="f-consent" /></label>
        <label class="wide">Observacións<textarea id="f-obs"></textarea></label>
      </div>
      <section class="legal-box"><strong>Texto legal vixente</strong><p id="legal-title"></p><details><summary>Ver texto completo</summary><div id="legal-text"></div></details><small>A aceptación rexístrase cando a persoa completa a revisión. O consentimento de imaxe é independente.</small></section>
      <p id="form-state"></p>
      <footer class="dialog-actions"><button id="cancel" class="button secondary" type="button">Cancelar</button><button id="save" class="button primary" type="submit">Gardar</button></footer>
    </form>
  </dialog>

  <dialog id="review-dlg">
    <section class="review-box"><header class="dialog-head"><h2>Ligazón segura</h2><button id="review-x" type="button">×</button></header><p id="review-name"></p><input id="review-link" readonly /><small id="review-exp"></small><footer class="dialog-actions"><button id="copy" class="button secondary" type="button">Copiar ligazón</button><button id="open" class="button primary" type="button">Abrir revisión</button></footer></section>
  </dialog>

  <script>
    import { auth, closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
    const $ = (s) => document.querySelector(s);
    let persoas = [], selected = null, mode = 'create', legal = null;
    const clean = (v) => String(v ?? '').trim();
    const norm = (v) => clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    const key = (p) => clean(p?.idPersoa || p?.id || p?.rowId);

    async function api(accion, extra = {}) {
      const user = auth.currentUser;
      if (!user) throw new Error('Sesión non activa');
      const idToken = await user.getIdToken();
      const response = await fetch('/api/persoas-novo', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ idToken, accion, ...extra }) });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.ok) throw new Error(result?.erro || `Erro HTTP ${response.status}`);
      return result;
    }

    async function review(accion, extra = {}) {
      const user = auth.currentUser;
      const idToken = await user.getIdToken();
      const response = await fetch('/api/persoas-revision', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ idToken, accion, ...extra }) });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.ok) throw new Error(result?.erro || `Erro HTTP ${response.status}`);
      return result;
    }

    async function uploadPhoto(idPersoa, file) {
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) throw new Error('A fotografía non pode superar 5 MB.');
      const user = auth.currentUser;
      const fd = new FormData();
      fd.set('idToken', await user.getIdToken()); fd.set('idPersoa', idPersoa); fd.set('foto', file);
      const response = await fetch('/api/persoas-novo-foto', { method:'POST', body:fd });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.ok) throw new Error(result?.erro || 'Non foi posible gardar a fotografía.');
    }

    function filtered() {
      const q = norm($('#search').value), state = $('#state').value;
      return persoas.filter((p) => {
        const matches = !q || norm([p.nomeCompleto,p.correo,p.telefono,p.nif].join(' ')).includes(q);
        const pending = clean(p.estadoAlta).toUpperCase() === 'PENDENTE';
        const stateOk = state === 'all' || (state === 'active' && p.activo === true) || (state === 'inactive' && p.activo !== true) || (state === 'pending' && pending);
        return matches && stateOk;
      });
    }

    function render() {
      const rows = filtered(), select = $('#people'), keep = select.value;
      select.innerHTML = '<option value="">Escolle unha persoa…</option>';
      rows.forEach((p) => select.add(new Option(`${p.nomeCompleto || p.etiqueta}${clean(p.estadoAlta).toUpperCase()==='PENDENTE'?' · PENDENTE':''}`, key(p))));
      if (rows.some((p) => key(p) === keep)) select.value = keep;
      $('#count').textContent = `${rows.length} de ${persoas.length} persoas`;
      $('#m-total').textContent = String(persoas.length);
      $('#m-active').textContent = String(persoas.filter((p)=>p.activo===true).length);
      $('#m-inactive').textContent = String(persoas.filter((p)=>p.activo!==true).length);
      $('#m-pending').textContent = String(persoas.filter((p)=>clean(p.estadoAlta).toUpperCase()==='PENDENTE').length);
      showCard();
    }

    function showCard() {
      selected = persoas.find((p) => key(p) === $('#people').value) || null;
      const card = $('#card');
      if (!selected) { card.hidden = true; return; }
      card.hidden = false;
      $('#card-name').textContent = selected.nomeCompleto || selected.etiqueta || '';
      $('#card-info').textContent = [selected.correo, selected.telefono, selected.voz].filter(Boolean).join(' · ');
      $('#badge-state').textContent = selected.activo ? 'ACTIVA' : 'BAIXA';
      $('#badge-type').textContent = clean(selected.estadoAlta).toUpperCase()==='PENDENTE' ? 'PENDENTE DE COMPLETAR' : (selected.tipoSocio || '');
      $('#btn-toggle').textContent = selected.activo ? 'Rexistrar baixa' : 'Reactivar';
      const fields = [['NIF',selected.nif],['Voz',selected.voz],['Tipo de socio',selected.tipoSocio],['Cargo',selected.cargo],['Data nacemento',selected.dataNacemento],['Data incorporación',selected.dataIncorporacion],['Enderezo',[selected.enderezo,selected.cidade,selected.cp].filter(Boolean).join(' · ')],['Consentimento fotografía',selected.consentimentoFoto]];
      $('#details').innerHTML = fields.filter((x)=>x[1]).map((x)=>`<div><dt>${x[0]}</dt><dd>${String(x[1]).replaceAll('<','&lt;')}</dd></div>`).join('');
    }

    async function load() {
      try {
        const result = await api('listar');
        persoas = Array.isArray(result.persoas) ? result.persoas : [];
        legal = result.textoLegalPersoas || null;
        $('#pn-email').textContent = auth.currentUser?.email || '—';
        $('#pn-level').textContent = result.perfil?.nivel || '—';
        $('#pn-loading').hidden = true; $('#pn-error').hidden = true; $('#pn-app').hidden = false;
        render();
      } catch (error) {
        $('#pn-loading').hidden = true; $('#pn-error').hidden = false; $('#pn-error').textContent = error.message;
      }
    }

    const formMap = { nome:'#f-nome', primeiroApelido:'#f-primeiro', segundoApelido:'#f-segundo', correo:'#f-correo', telefono:'#f-telefono', nif:'#f-nif', dataNacemento:'#f-nacemento', voz:'#f-voz', tipoSocio:'#f-tipo', cargo:'#f-cargo', dataIncorporacion:'#f-incorporacion', cidade:'#f-cidade', cp:'#f-cp', enderezo:'#f-enderezo', consentimentoFoto:'#f-consent', observacions:'#f-obs' };
    function openForm(nextMode) {
      mode = nextMode; $('#form').reset(); $('#form-state').textContent = '';
      $('#dlg-title').textContent = mode==='invite' ? 'Alta por invitación' : mode==='edit' ? 'Editar persoa' : 'Nova persoa';
      $('#wrap-primeiro').hidden = mode === 'invite'; $('#f-primeiro').required = mode !== 'invite';
      if (mode==='edit' && selected) Object.entries(formMap).forEach(([k,s]) => { $(s).value = clean(selected[k]); });
      $('#legal-title').textContent = legal ? `${legal.titulo} · versión ${legal.version}` : 'Texto legal non dispoñible';
      $('#legal-text').textContent = legal?.texto || '';
      $('#dlg').showModal();
    }
    function payload() { const out={}; Object.entries(formMap).forEach(([k,s]) => out[k]=clean($(s).value)); return out; }

    async function save(event) {
      event.preventDefault(); const button=$('#save'); button.disabled=true; $('#form-state').textContent='Gardando…';
      try {
        const data = payload(), file = $('#f-foto').files?.[0] || null;
        const result = mode==='edit' ? await api('actualizar',{idPersoa:key(selected),persoa:data}) : await api(mode==='invite'?'crearInvitacion':'crear',{persoa:data});
        const id = clean(result.idPersoa || key(selected));
        if (file) await uploadPhoto(id,file);
        $('#dlg').close(); await load(); $('#people').value=id; showCard();
        if (mode==='invite') await makeReview(id);
        notify('Operación completada correctamente.');
      } catch (error) { $('#form-state').textContent = error.message; }
      finally { button.disabled=false; }
    }

    async function makeReview(id) {
      try {
        const result = await review('xerarLigazon',{idPersoa:id});
        $('#review-name').textContent=result.persoa||''; $('#review-link').value=result.ligazon||'';
        $('#review-exp').textContent=result.caducaEn?`Caduca: ${new Date(result.caducaEn).toLocaleString('gl-ES')}`:'';
        $('#review-dlg').showModal();
      } catch (error) { notify(error.message,true); }
    }
    function notify(message,error=false){const node=$('#feedback');node.hidden=false;node.textContent=message;node.className=`state-box ${error?'error':''}`;setTimeout(()=>node.hidden=true,5000);}

    $('#btn-new').addEventListener('click',()=>openForm('create'));
    $('#btn-invite').addEventListener('click',()=>openForm('invite'));
    $('#btn-edit').addEventListener('click',()=>openForm('edit'));
    $('#btn-review').addEventListener('click',()=>selected&&makeReview(key(selected)));
    $('#btn-toggle').addEventListener('click',async()=>{if(!selected)return;try{await api('estado',{idPersoa:key(selected),activo:!selected.activo});await load();}catch(error){notify(error.message,true);}});
    $('#form').addEventListener('submit',save);
    $('#dlg-x').addEventListener('click',()=>$('#dlg').close()); $('#cancel').addEventListener('click',()=>$('#dlg').close());
    $('#review-x').addEventListener('click',()=>$('#review-dlg').close());
    $('#copy').addEventListener('click',async()=>{await navigator.clipboard.writeText($('#review-link').value);notify('Ligazón copiada.');});
    $('#open').addEventListener('click',()=>window.open($('#review-link').value,'_blank','noopener'));
    $('#people').addEventListener('change',showCard); $('#search').addEventListener('input',render); $('#state').addEventListener('change',render);
    $('#pn-logout')?.addEventListener('click',()=>closePortalSession());
    waitForPortalUser().then((user)=>{if(!user?.email){location.href='/portal/';return;}load();});
  </script>

  <style>
    .private-layout{display:grid;grid-template-columns:282px minmax(0,1fr);min-height:100vh;width:100%}
    .people-main{width:100%;max-width:1500px;margin:0 auto;padding:2.7rem clamp(1.3rem,4vw,4.2rem) 5rem;min-width:0}
    .page-head{display:flex;justify-content:space-between;gap:2rem;margin-bottom:2rem}.kicker{color:var(--color-acento);font-size:.72rem;font-weight:800;letter-spacing:.12em}.page-head h1{margin:.35rem 0 .5rem;color:var(--color-principal);font-size:clamp(2.4rem,4.5vw,4rem)}.page-head p{margin:0;color:#625d58}.account-card{display:grid;gap:.3rem;min-width:220px;padding:1rem 1.3rem;border:1px solid #ddd;height:max-content}.account-card small{font-size:.65rem}.state-box{border:1px solid #ddd;padding:1rem;margin:1rem 0}.error{color:#9d1b1b;border-color:#d5aaaa}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.metrics div{border:1px solid #ddd;padding:1rem}.metrics small{display:block;font-size:.7rem}.metrics strong{font-size:1.55rem;color:var(--color-principal)}.actions{display:flex;justify-content:flex-end;gap:.7rem;margin:1rem 0;flex-wrap:wrap}.button{padding:.75rem 1rem;border:1px solid #c8bebe;background:#fff;color:#222;text-decoration:none;font-weight:700;cursor:pointer}.primary{background:var(--color-principal);border-color:var(--color-principal);color:#fff}.danger{color:var(--color-principal);border-color:var(--color-principal)}.filters{display:grid;grid-template-columns:1fr 240px;gap:1rem;padding:1rem;border:1px solid #ddd}.filters input,.filters select,.selector-row select{width:100%;padding:.8rem;border:1px solid #ccc}.selector-row{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;margin:1rem 0}.person-card{display:grid;grid-template-columns:1fr auto;gap:1.2rem;border:1px solid #ddd;padding:1.3rem}.card-actions{display:flex;gap:.5rem;align-items:flex-start}.badge{display:inline-block;padding:.25rem .5rem;margin-right:.35rem;background:#f2eded;font-size:.7rem;font-weight:700}.person-card dl{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;border-top:1px solid #eee;padding-top:1rem}.person-card dt{font-size:.7rem;text-transform:uppercase}.person-card dd{margin:.25rem 0}dialog{border:0;padding:0;width:min(900px,94vw);box-shadow:0 20px 70px #0004}dialog form,.review-box{padding:1.5rem}.dialog-head,.dialog-actions{display:flex;justify-content:space-between;align-items:center;gap:1rem}.dialog-head button{border:0;background:none;font-size:1.6rem}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1rem 0}.form-grid label{display:grid;gap:.35rem;font-weight:600}.form-grid input,.form-grid textarea{padding:.7rem;border:1px solid #ccc}.wide{grid-column:1/-1}.legal-box{margin:1rem 0;padding:1rem;background:#f8f5ef}.legal-box #legal-text{white-space:pre-wrap;max-height:220px;overflow:auto}.review-box input{width:100%;padding:.8rem;margin:1rem 0}
    @media(max-width:900px){.private-layout{display:block}.people-main{padding:1.3rem}.page-head{display:block}.metrics{grid-template-columns:1fr 1fr}.filters,.form-grid,.person-card dl{grid-template-columns:1fr}.person-card{grid-template-columns:1fr}.wide{grid-column:auto}}
  </style>
</BaseLayout>
