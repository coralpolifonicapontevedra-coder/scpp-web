---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---
<BaseLayout title="Auditoría de envíos de Persoas" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="auditoria-envios-logout" />
    <main class="audit-main">
      <header class="page-head">
        <div>
          <span>Administración · Persoas</span>
          <h1>Auditoría de envíos masivos</h1>
          <p>Consulta as tandas xeradas nos últimos sete días e comproba que revisións foron realmente enviadas por Apps Script.</p>
        </div>
        <a class="back" href="/portal/administracion/persoas-revisions/">Volver ás revisións</a>
      </header>
      <AdministracionNav active="persoas" />
      <div id="loading" class="state">Consultando os rexistros reais de envío…</div>
      <div id="error" class="state error" hidden></div>
      <section id="results" hidden></section>
    </main>
  </div>
</BaseLayout>

<script>
  import { closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';

  const $ = (s: string) => document.querySelector(s);
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] || c));
  const fmt = (v: unknown) => {
    const d = new Date(String(v || ''));
    return Number.isNaN(d.getTime()) ? String(v || '—') : new Intl.DateTimeFormat('es-ES', { dateStyle:'medium', timeStyle:'short' }).format(d);
  };

  async function requestAudit() {
    const user = await waitForPortalUser();
    if (!user) throw new Error('Non hai unha sesión válida.');
    const response = await fetch('/api/persoas-envios-auditoria', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken: await user.getIdToken() })
    });
    const data = await response.json();
    if (!response.ok || !data?.ok) throw new Error(data?.erro || 'Non foi posible consultar a auditoría.');
    return data;
  }

  function draw(data: any) {
    const root = $('#results') as HTMLElement;
    const tandas = Array.isArray(data?.tandas) ? data.tandas : [];
    if (!tandas.length) {
      root.innerHTML = '<p class="state">Non hai tandas masivas dos últimos sete días.</p>';
      return;
    }
    root.innerHTML = tandas.map((t: any, index: number) => {
      const pendentes = Array.isArray(t.pendentesEnvio) ? t.pendentesEnvio : [];
      const todos = Array.isArray(t.elementos) ? t.elementos : [];
      const resumo = `<div class="summary"><strong>${esc(fmt(t.creadaEn))}</strong><span>${esc(t.total)} xerados</span><span class="ok">${esc(t.enviados)} enviados</span><span class="${t.nonEnviados ? 'bad' : 'ok'}">${esc(t.nonEnviados)} non enviados</span></div>`;
      const pendientesHtml = pendentes.length
        ? `<div class="pending"><h3>Non enviados</h3>${pendentes.map((x: any) => `<article><div><strong>${esc(x.nome || x.idPersoa)}</strong><small>${esc(x.correo || 'Sen correo')}</small></div><span>${esc(x.estadoRevision || 'PENDENTE')}</span></article>`).join('')}</div>`
        : '<p class="all-ok">Todos os correos desta tanda constan como enviados.</p>';
      const detalles = `<details ${index === 0 ? 'open' : ''}><summary>Ver os ${esc(t.total)} rexistros</summary><div class="rows">${todos.map((x: any) => `<article><div><strong>${esc(x.nome || x.idPersoa)}</strong><small>${esc(x.correo || 'Sen correo')}</small></div><div class="send-state ${x.enviado ? 'sent' : 'not-sent'}">${x.enviado ? `Enviado${x.enviadoEn ? ` · ${esc(fmt(x.enviadoEn))}` : ''}` : 'Non enviado'}</div></article>`).join('')}</div></details>`;
      return `<section class="batch">${resumo}${pendientesHtml}${detalles}</section>`;
    }).join('');
  }

  async function init() {
    try {
      const data = await requestAudit();
      ($('#loading') as HTMLElement).hidden = true;
      const root = $('#results') as HTMLElement;
      root.hidden = false;
      draw(data);
    } catch (error) {
      ($('#loading') as HTMLElement).hidden = true;
      const box = $('#error') as HTMLElement;
      box.hidden = false;
      box.textContent = error instanceof Error ? error.message : String(error);
    }
  }

  document.querySelector('#auditoria-envios-logout')?.addEventListener('click', () => closePortalSession());
  init();
</script>

<style>
  .audit-main{min-width:0;padding:2rem clamp(1rem,3vw,3rem) 4rem;background:#f7f6f2;min-height:100vh;color:#24211f}.page-head{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.page-head span{font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;color:#766d65}.page-head h1{margin:.35rem 0 .5rem;font-size:clamp(1.8rem,3vw,2.7rem);font-weight:500}.page-head p{margin:0;max-width:52rem;color:#625c57}.back{display:inline-flex;padding:.7rem 1rem;border:1px solid #b9b1a9;border-radius:.4rem;color:inherit;text-decoration:none;white-space:nowrap;background:white}.state{padding:1.25rem;background:white;border:1px solid #ddd6cf;border-radius:.5rem}.error{border-color:#b87474;color:#7f2626}.batch{margin:1.2rem 0;padding:1.25rem;background:white;border:1px solid #ddd6cf;border-radius:.55rem}.summary{display:flex;flex-wrap:wrap;gap:.65rem 1.1rem;align-items:center;padding-bottom:1rem;border-bottom:1px solid #ece7e2}.summary strong{font-size:1.05rem;margin-right:auto}.summary span{font-size:.9rem}.ok{color:#32613e}.bad{color:#9a2f2f;font-weight:600}.pending{margin-top:1rem;padding:1rem;background:#fff8f6;border:1px solid #ebcac4;border-radius:.45rem}.pending h3{margin:0 0 .7rem;color:#862c2c;font-size:1rem}.pending article,.rows article{display:flex;justify-content:space-between;gap:1rem;padding:.65rem 0;border-top:1px solid #ece7e2}.pending article:first-of-type,.rows article:first-child{border-top:0}.pending div,.rows div:first-child{display:flex;flex-direction:column;gap:.15rem}.pending small,.rows small{color:#716a64}.all-ok{margin:1rem 0;color:#32613e}details{margin-top:1rem}summary{cursor:pointer;font-weight:600}.rows{margin-top:.75rem}.send-state{text-align:right;align-self:center;font-size:.88rem}.sent{color:#32613e}.not-sent{color:#9a2f2f;font-weight:600}@media(max-width:760px){.audit-main{padding:1rem}.page-head{display:block}.back{margin-top:1rem}.summary strong{width:100%;margin-right:0}.pending article,.rows article{display:block}.send-state{text-align:left;margin-top:.3rem}}
</style>
