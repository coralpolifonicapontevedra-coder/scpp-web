---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---
<BaseLayout title="Auditoría de envíos de Persoas" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="auditoria-envios-logout" />
    <main class="audit-main">
      <header class="page-head">
        <div>
          <span>Administración · Persoas</span>
          <h1>Auditoría de envíos masivos</h1>
          <p>Consulta directamente os correos realmente enviados hoxe e onte e a cota de correo dispoñible.</p>
        </div>
        <a class="back" href="/portal/administracion/persoas-revisions/">Volver ás revisións</a>
      </header>
      <AdministracionNav active="persoas" />
      <div id="loading" class="state">Consultando o rexistro real de envíos…</div>
      <div id="error" class="state error" hidden></div>
      <section id="results" hidden></section>
    </main>
  </div>
</BaseLayout>

<script>
  import { closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';

  type AuditEnvio = {
    idPersoa?: string;
    correo?: string;
    revisionId?: string;
    enviadoEn?: string;
    nome?: string;
  };

  type AuditPersona = AuditEnvio & {
    envios: AuditEnvio[];
  };

  type AuditResponse = {
    ok?: boolean;
    erro?: string;
    envios?: AuditEnvio[];
    cotaRestante?: number | string | null;
    restablecementoEstimado?: string | null;
  };

  const $ = (s: string) => document.querySelector(s);
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] || c));
  const fmt = (v: unknown) => {
    const d = new Date(String(v || ''));
    return Number.isNaN(d.getTime()) ? String(v || '—') : new Intl.DateTimeFormat('gl-ES', { dateStyle:'medium', timeStyle:'short', timeZone:'Europe/Madrid' }).format(d);
  };
  const fmtTime = (v: unknown) => {
    const d = new Date(String(v || ''));
    return Number.isNaN(d.getTime()) ? '' : new Intl.DateTimeFormat('gl-ES', { hour:'2-digit', minute:'2-digit', timeZone:'Europe/Madrid' }).format(d);
  };
  const madridParts = (value: Date) => {
    const parts = new Intl.DateTimeFormat('en-CA', { timeZone:'Europe/Madrid', year:'numeric', month:'2-digit', day:'2-digit' }).formatToParts(value);
    const get = (type: string) => parts.find(p => p.type === type)?.value || '';
    return { year:Number(get('year')), month:Number(get('month')), day:Number(get('day')) };
  };
  const dateKeyMadrid = (value: unknown) => {
    const d = new Date(String(value || ''));
    if (Number.isNaN(d.getTime())) return '';
    const p = madridParts(d);
    return `${String(p.year).padStart(4,'0')}-${String(p.month).padStart(2,'0')}-${String(p.day).padStart(2,'0')}`;
  };
  const relativeDayMadrid = (offsetDays: number) => {
    const p = madridParts(new Date());
    const target = new Date(Date.UTC(p.year, p.month - 1, p.day) + offsetDays * 86400000);
    return {
      key: `${target.getUTCFullYear()}-${String(target.getUTCMonth()+1).padStart(2,'0')}-${String(target.getUTCDate()).padStart(2,'0')}`,
      label: new Intl.DateTimeFormat('gl-ES', { day:'numeric', month:'numeric', year:'numeric', timeZone:'UTC' }).format(target)
    };
  };

  async function requestAudit(): Promise<AuditResponse> {
    const user = await waitForPortalUser();
    if (!user) throw new Error('Non hai unha sesión válida.');
    const response = await fetch('/api/persoas-envios-auditoria', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken: await user.getIdToken() })
    });
    const data = await response.json() as AuditResponse;
    if (!response.ok || !data?.ok) throw new Error(data?.erro || 'Non foi posible consultar a auditoría.');
    return data;
  }

  function agruparPersoas(items: AuditEnvio[]): AuditPersona[] {
    const mapa = new Map<string, AuditPersona>();
    for (const item of items) {
      const key = String(item.idPersoa || item.correo || item.revisionId || '').trim().toLowerCase();
      if (!key) continue;
      const existing = mapa.get(key);
      if (existing) {
        existing.envios.push(item);
      } else {
        mapa.set(key, { ...item, envios: [item] });
      }
    }
    return [...mapa.values()].map((item) => {
      item.envios.sort((a, b) => (Date.parse(String(a.enviadoEn || '')) || 0) - (Date.parse(String(b.enviadoEn || '')) || 0));
      item.enviadoEn = item.envios[item.envios.length - 1]?.enviadoEn || item.enviadoEn;
      return item;
    }).sort((a, b) => String(a.nome || '').localeCompare(String(b.nome || ''), 'gl', { sensitivity:'base' }));
  }

  function dayHtml(all: AuditEnvio[], day: { key:string; label:string }, title: string, className: string) {
    const raw = all.filter((x) => dateKeyMadrid(x.enviadoEn) === day.key);
    const people = agruparPersoas(raw);
    const body = people.length
      ? `<div class="rows day-rows">${people.map((x) => {
          const times = x.envios.map((e) => fmtTime(e.enviadoEn)).filter(Boolean);
          const detail = times.length > 1 ? `${times.length} envíos · ${times.join(', ')}` : (times[0] || fmt(x.enviadoEn));
          return `<article><div><strong>${esc(x.nome || x.idPersoa)}</strong><small>${esc(x.correo || 'Sen correo')}</small></div><div class="send-state sent">${esc(detail)}</div></article>`;
        }).join('')}</div>`
      : '<p class="state compact">Non consta ningún envío realizado nesa data.</p>';
    return `<section class="day-block ${className}"><div class="day-head"><div><span>Envíos reais</span><h2>${esc(title)} · ${esc(day.label)}</h2></div><strong>${esc(people.length)} persoas · ${esc(raw.length)} correos</strong></div>${body}</section>`;
  }

  function quotaHtml(data: AuditResponse) {
    const quota = Number(data.cotaRestante);
    if (!Number.isFinite(quota)) return '';
    const reset = data.restablecementoEstimado ? fmt(data.restablecementoEstimado) : '';
    return `<section class="quota"><div><span>Cota de correo</span><strong>${esc(quota)}</strong><small>destinatarios dispoñibles</small></div><p>${reset ? `Recuperación estimada arredor de ${esc(reset)}. Google non facilita a hora exacta do restablecemento.` : 'Google non facilita directamente a hora exacta do restablecemento da cota.'}</p></section>`;
  }

  function draw(data: AuditResponse) {
    const root = $('#results') as HTMLElement;
    const envios: AuditEnvio[] = Array.isArray(data.envios) ? data.envios : [];
    const today = relativeDayMadrid(0);
    const yesterday = relativeDayMadrid(-1);
    root.innerHTML = `${quotaHtml(data)}${dayHtml(envios, today, 'Enviados hoxe', 'today')}${dayHtml(envios, yesterday, 'Enviados onte', 'yesterday')}`;
  }

  async function init() {
    try {
      const data = await requestAudit();
      ($('#loading') as HTMLElement).hidden = true;
      const root = $('#results') as HTMLElement;
      root.hidden = false;
      draw(data);
    } catch (error) {
      ($('#loading') as HTMLElement).hidden = true;
      const box = $('#error') as HTMLElement;
      box.hidden = false;
      box.textContent = error instanceof Error ? error.message : String(error);
    }
  }

  document.querySelector('#auditoria-envios-logout')?.addEventListener('click', () => closePortalSession());
  init();
</script>

<style>
  .audit-main{min-width:0;padding:2rem clamp(1rem,3vw,3rem) 4rem;background:#f7f6f2;min-height:100vh;color:#24211f}.page-head{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.page-head span{font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;color:#766d65}.page-head h1{margin:.35rem 0 .5rem;font-size:clamp(1.8rem,3vw,2.7rem);font-weight:500}.page-head p{margin:0;max-width:52rem;color:#625c57}.back{display:inline-flex;padding:.7rem 1rem;border:1px solid #b9b1a9;border-radius:.4rem;color:inherit;text-decoration:none;white-space:nowrap;background:white}.state{padding:1.25rem;background:white;border:1px solid #ddd6cf;border-radius:.5rem}.state.compact{margin:.9rem 0 0}.error{border-color:#b87474;color:#7f2626}.quota{display:flex;justify-content:space-between;gap:2rem;align-items:center;margin:1.2rem 0;padding:1.25rem;background:#f0ede8;border:1px solid #d5ccc3;border-radius:.55rem}.quota div{display:grid;grid-template-columns:auto auto;column-gap:.7rem;align-items:baseline}.quota span{grid-column:1/-1;font-size:.72rem;text-transform:uppercase;letter-spacing:.11em;color:#766d65}.quota strong{font-size:2rem;font-weight:500;color:#6f1722}.quota small{color:#625c57}.quota p{margin:0;max-width:42rem;color:#625c57}.day-block{margin:1.2rem 0 1.5rem;padding:1.35rem;background:white;border:1px solid #c9c0b8;border-radius:.6rem}.day-block.today{border-color:#b9cbbd}.day-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-end;padding-bottom:1rem;border-bottom:1px solid #ece7e2}.day-head span{display:block;font-size:.74rem;text-transform:uppercase;letter-spacing:.11em;color:#766d65}.day-head h2{margin:.2rem 0 0;font-size:1.35rem;font-weight:600;color:#6f1722}.day-block.today .day-head h2{color:#315d3c}.day-head>strong{font-size:1rem;color:#32613e}.rows{margin-top:.75rem}.rows article{display:flex;justify-content:space-between;gap:1rem;padding:.75rem 0;border-top:1px solid #ece7e2}.rows article:first-child{border-top:0}.rows div:first-child{display:flex;flex-direction:column;gap:.15rem}.rows small{color:#716a64}.send-state{text-align:right;align-self:center;font-size:.88rem}.sent{color:#32613e}@media(max-width:760px){.audit-main{padding:1rem}.page-head{display:block}.back{margin-top:1rem}.quota{display:block}.quota p{margin-top:.8rem}.day-head{display:block}.day-head>strong{display:block;margin-top:.6rem}.rows article{display:block}.send-state{text-align:left;margin-top:.3rem}}
</style>
