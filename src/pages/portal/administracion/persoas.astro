---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Administración de persoas" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="persoas-v4-logout" />

    <main class="people-main">
      <AdministracionNav active="persoas" />

      <header class="private-page-header people-header">
        <div>
          <span class="section-kicker">Administración</span>
          <h1>Xestión de persoas</h1>
          <p>Alta, consulta, actualización, baixa e eliminación controlada. Os datos de negocio proceden da folla Persoas e a copia operativa de R2 actualízase automaticamente.</p>
        </div>
        <div class="account-card">
          <span><small>Conta</small><strong id="user-email">—</strong></span>
          <span><small>Permiso en Persoas</small><strong id="user-level">Comprobando…</strong></span>
        </div>
      </header>

      <section id="loading" class="state-box">Comprobando permisos e cargando Persoas…</section>
      <section id="error-state" class="state-box error-box" hidden>
        <strong>Non foi posible abrir o módulo Persoas</strong>
        <p id="error-message"></p>
        <button id="retry-button" type="button" class="secondary-action">Tentar de novo</button>
      </section>

      <section id="people-app" class="people-app" hidden>
        <div id="feedback" class="feedback" role="status" hidden></div>

        <section class="people-summary" aria-label="Resumo de persoas">
          <div><small>Rexistradas</small><strong id="metric-total">0</strong></div>
          <div><small>Activas</small><strong id="metric-active">0</strong></div>
          <div><small>Baixas</small><strong id="metric-inactive">0</strong></div>
          <div><small>Cantores</small><strong id="metric-singers">0</strong></div>
          <div><small>Dirección</small><strong id="metric-director">0</strong></div>
          <div><small>Colaboradores/as</small><strong id="metric-collaborators">0</strong></div>
          <nav class="people-summary-actions" aria-label="Accións de Persoas">
            <a href="/portal/administracion/persoas-revisions/" class="secondary-action">Revisións masivas</a>
            <button id="new-person-button" type="button" class="primary-action">+ Alta de persoa</button>
          </nav>
        </section>

        <section class="filters-panel">
          <label class="search-field">
            <span>Buscar</span>
            <input id="people-search" type="search" placeholder="Nome, apelidos, correo, teléfono…" autocomplete="off" />
          </label>
          <label><span>Estado</span><select id="status-filter"><option value="all">Todas</option><option value="active">Activas</option><option value="inactive">Baixas</option></select></label>
          <label><span>Vinculación</span><select id="relation-filter"><option value="all">Todas</option><option value="singer">Cantores</option><option value="director">Dirección</option><option value="collaborator">Colaboradores/as</option><option value="other">Outras</option></select></label>
          <label><span>Voz</span><select id="voice-filter"><option value="all">Todas as voces</option></select></label>
        </section>

        <div class="toolbar">
          <label>
            <span>Seleccionar persoa</span>
            <select id="person-select"><option value="">Escolle unha persoa…</option></select>
          </label>
          <p id="people-count"></p>
        </div>

        <section id="empty-selection" class="state-box">Selecciona unha persoa para consultar ou modificar os seus datos.</section>

        <article id="person-card" class="person-card" hidden>
          <div class="person-photo-column">
            <div class="person-photo-frame"><img id="person-photo" alt="" hidden /><span id="person-photo-empty">Sen fotografía</span></div>
            <button id="change-photo" type="button" class="secondary-action">Cambiar fotografía</button>
          </div>

          <div class="person-card-content">
            <header class="person-card-header">
              <div>
                <div class="badges"><span id="person-status" class="status-badge"></span><span id="person-relation" class="relation-badge"></span></div>
                <h2 id="person-name"></h2>
                <p id="person-summary"></p>
              </div>
              <div class="person-actions">
                <button id="edit-person" type="button" class="secondary-action">Editar datos</button>
                <button id="review-person" type="button" class="secondary-action">Xerar revisión</button>
                <button id="toggle-person" type="button" class="secondary-action"></button>
                <button id="open-file" type="button" class="primary-action" hidden>Ver ficha escaneada</button>
                <button id="delete-person" type="button" class="danger-action">Eliminar rexistro</button>
              </div>
            </header>
            <div id="person-sections" class="person-sections"></div>
          </div>
        </article>
      </section>
    </main>
  </div>

  <dialog id="person-dialog" class="person-dialog">
    <form id="person-form" method="dialog">
      <header class="dialog-header">
        <div><span class="section-kicker">Persoas</span><h2 id="person-dialog-title">Alta de persoa</h2></div>
        <button id="close-person-dialog" class="icon-button" type="button" aria-label="Pechar">×</button>
      </header>

      <div id="form-fields" class="dynamic-form"></div>

      <fieldset class="photo-fieldset">
        <legend>Fotografía</legend>
        <div class="photo-edit-grid">
          <div class="person-photo-frame small"><img id="form-photo-preview" alt="" hidden /><span id="form-photo-empty">Sen fotografía</span></div>
          <label class="file-field"><span>Nova fotografía (JPG, PNG ou WebP · máximo 5 MB)</span><input id="form-photo" type="file" accept="image/jpeg,image/png,image/webp" /></label>
        </div>
      </fieldset>

      <section class="legal-form-section" aria-label="Información legal">
        <article id="legal-data-card" class="legal-card" hidden><h3></h3><p class="legal-meta"></p><div class="legal-text"></div></article>
        <article id="legal-fee-card" class="legal-card" hidden><h3></h3><p class="legal-meta"></p><div class="legal-text"></div></article>
      </section>

      <p class="form-note">Estes textos móstranse como información legal vixente. A aceptación da persoa interesada rexístrase mediante o seu propio proceso de revisión de datos; unha edición administrativa non crea unha aceptación no seu nome.</p>

      <footer class="dialog-footer">
        <button id="cancel-person" type="button" class="secondary-action">Cancelar</button>
        <button id="save-person" type="submit" class="primary-action">Gardar</button>
      </footer>
    </form>
  </dialog>

  <dialog id="delete-dialog" class="person-dialog compact-dialog">
    <form id="delete-form" method="dialog">
      <header class="dialog-header"><div><span class="section-kicker">Eliminación definitiva</span><h2>Eliminar rexistro</h2></div><button id="close-delete-dialog" class="icon-button" type="button" aria-label="Pechar">×</button></header>
      <p>Esta acción é distinta dunha baixa. Está reservada para rexistros erróneos que non deben existir e elimina tamén os seus recursos administrados en R2.</p>
      <p><strong id="delete-person-name"></strong></p>
      <label><span>Escribe <strong>ELIMINAR</strong> para confirmar</span><input id="delete-confirmation" type="text" autocomplete="off" /></label>
      <footer class="dialog-footer"><button id="cancel-delete" type="button" class="secondary-action">Cancelar</button><button id="confirm-delete" type="submit" class="danger-action">Eliminar definitivamente</button></footer>
    </form>
  </dialog>

  <dialog id="review-dialog" class="person-dialog compact-dialog">
    <form method="dialog">
      <header class="dialog-header"><div><span class="section-kicker">Revisión de datos</span><h2>Ligazón individual</h2></div><button id="close-review-dialog" class="icon-button" type="button" aria-label="Pechar">×</button></header>
      <p id="review-person-name"></p>
      <label><span>Ligazón</span><input id="review-link" type="text" readonly /></label>
      <p id="review-expiry" class="form-note"></p>
      <p id="review-state" class="form-note"></p>
      <footer class="dialog-footer"><button id="copy-review-link" type="button" class="secondary-action">Copiar ligazón</button><div><button id="close-review" type="button" class="primary-action">Pechar</button></div></footer>
    </form>
  </dialog>
</BaseLayout>

<script>
  import { initPersoasAdminV4 } from '../../../lib/persoas-admin-v4.js';
  initPersoasAdminV4();
</script>

<style>
  .people-main{flex:1 1 auto;min-width:0;width:auto;padding:clamp(1.4rem,3vw,3rem) clamp(1rem,3vw,3.4rem) 4rem;background:#f5f3f1;color:#2f292b}
  .people-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.4rem;padding-bottom:1.2rem;border-bottom:1px solid #d8d0cb}
  .private-page-header h1{margin:.2rem 0 .55rem;font-size:clamp(1.8rem,3vw,2.55rem);font-weight:650;color:#351f27}.private-page-header p{max-width:780px;margin:0;color:#655b5e;line-height:1.55}.section-kicker{font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#775b42}
  .account-card{display:grid;grid-template-columns:1fr 1fr;gap:1rem;min-width:min(360px,100%);padding:1rem;background:#fff;border:1px solid #d8d0cb}.account-card span{display:grid;gap:.2rem}.account-card small{color:#746b6d}.account-card strong{font-size:.92rem;overflow-wrap:anywhere}
  .state-box,.feedback{padding:1rem 1.15rem;background:#fff;border:1px solid #d8d0cb}.error-box{border-left:4px solid #7a2439}.feedback{margin-bottom:1rem;border-left:4px solid #6c7a50}.feedback.is-error{border-left-color:#7a2439}.feedback[hidden],.state-box[hidden]{display:none}
  .people-summary{display:grid;grid-template-columns:repeat(6,minmax(96px,1fr));gap:.65rem;margin-bottom:1rem}.people-summary>div{display:grid;gap:.25rem;padding:.8rem .9rem;background:#fff;border:1px solid #d8d0cb}.people-summary small{color:#71676a}.people-summary strong{font-size:1.35rem}.people-summary-actions{grid-column:1/-1;display:flex;gap:.6rem;justify-content:flex-end;flex-wrap:wrap}
  .filters-panel{display:grid;grid-template-columns:minmax(220px,2fr) repeat(3,minmax(140px,1fr));gap:.75rem;padding:1rem;background:#fff;border:1px solid #d8d0cb}.filters-panel label,.toolbar label,.person-dialog label,.file-field{display:grid;gap:.35rem;font-size:.85rem;font-weight:700;color:#51494b}.filters-panel input,.filters-panel select,.toolbar select,.person-dialog input,.person-dialog select,.person-dialog textarea{width:100%;min-width:0;padding:.68rem .72rem;border:1px solid #c9bfba;border-radius:0;background:#fff;color:#2f292b;font:inherit}.toolbar{display:flex;justify-content:space-between;gap:1rem;align-items:end;margin:1rem 0}.toolbar label{width:min(620px,100%)}.toolbar p{margin:0;color:#746b6d}
  .person-card{display:grid;grid-template-columns:160px minmax(0,1fr);gap:1.4rem;padding:1.2rem;background:#fff;border:1px solid #d8d0cb}.person-photo-column{display:grid;align-content:start;gap:.7rem}.person-photo-frame{display:grid;place-items:center;aspect-ratio:4/5;overflow:hidden;background:#eee9e5;border:1px solid #d2c7c1;color:#817679;font-size:.85rem}.person-photo-frame.small{width:110px}.person-photo-frame img{width:100%;height:100%;object-fit:cover}.person-card-header{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;padding-bottom:1rem;border-bottom:1px solid #e2dbd7}.person-card-header h2{margin:.35rem 0 .25rem;color:#351f27}.person-card-header p{margin:0;color:#71676a}.badges{display:flex;gap:.4rem;flex-wrap:wrap}.status-badge,.relation-badge{display:inline-flex;padding:.25rem .45rem;border:1px solid #cfc4bf;font-size:.76rem;font-weight:800;background:#f8f6f4}.status-badge.is-inactive{background:#eee7e4;color:#6e3e48}.person-actions{display:flex;justify-content:flex-end;gap:.45rem;flex-wrap:wrap}.person-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}.data-section{padding:.85rem;border:1px solid #e0d9d5}.data-section h3{margin:0 0 .65rem;font-size:.9rem;color:#5d142b}.data-section dl{display:grid;grid-template-columns:minmax(120px,.8fr) 1.2fr;gap:.45rem .8rem;margin:0}.data-section dt{color:#746b6d}.data-section dd{margin:0;overflow-wrap:anywhere}
  .primary-action,.secondary-action,.danger-action,.icon-button{display:inline-flex;align-items:center;justify-content:center;min-height:2.35rem;padding:.52rem .85rem;border-radius:0;font:inherit;font-size:.86rem;font-weight:750;cursor:pointer;text-decoration:none}.primary-action{border:1px solid #5d142b;background:#5d142b;color:#fff}.secondary-action{border:1px solid #9d8f88;background:#fff;color:#3f3437}.danger-action{border:1px solid #7a2439;background:#fff;color:#7a2439}.primary-action:disabled,.secondary-action:disabled,.danger-action:disabled{opacity:.45;cursor:not-allowed}.icon-button{border:0;background:transparent;font-size:1.5rem;color:#554a4d;padding:.2rem .5rem}
  .person-dialog{width:min(940px,calc(100vw - 2rem));max-height:calc(100vh - 2rem);padding:0;border:1px solid #b9aca6;background:#f9f7f5;color:#2f292b}.compact-dialog{width:min(650px,calc(100vw - 2rem))}.person-dialog::backdrop{background:rgba(34,25,28,.48)}.person-dialog form{display:grid;gap:1rem;padding:1.2rem}.dialog-header{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;padding-bottom:.8rem;border-bottom:1px solid #d8d0cb}.dialog-header h2{margin:.2rem 0 0;color:#351f27}.dynamic-form{display:grid;gap:1rem}.form-group{margin:0;padding:.9rem;border:1px solid #d8d0cb}.form-group legend{padding:0 .3rem;font-weight:800;color:#5d142b}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.form-grid label.is-wide{grid-column:1/-1}.check-field{display:flex!important;align-items:center;gap:.6rem;padding:.6rem 0}.check-field input{width:auto!important}.person-dialog textarea{min-height:88px;resize:vertical}.photo-fieldset{margin:0;padding:.9rem;border:1px solid #d8d0cb}.photo-fieldset legend{font-weight:800;color:#5d142b}.photo-edit-grid{display:grid;grid-template-columns:120px 1fr;gap:1rem;align-items:center}.legal-form-section{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.legal-card{padding:.9rem;background:#fff;border:1px solid #d8d0cb}.legal-card h3{margin:0 0 .3rem;color:#5d142b;font-size:1rem}.legal-meta,.form-note{margin:.2rem 0;color:#776d70;font-size:.82rem;line-height:1.45}.legal-text{white-space:pre-line;max-height:210px;overflow:auto;font-size:.88rem;line-height:1.5}.dialog-footer{display:flex;justify-content:flex-end;gap:.55rem;padding-top:.8rem;border-top:1px solid #d8d0cb}.dialog-footer>div{display:flex;gap:.55rem}
  @media(max-width:980px){.people-header{display:grid}.account-card{min-width:0}.people-summary{grid-template-columns:repeat(3,1fr)}.filters-panel{grid-template-columns:1fr 1fr}.person-card{grid-template-columns:120px minmax(0,1fr)}.person-card-header{display:grid}.person-actions{justify-content:flex-start}}
  @media(max-width:720px){.people-main{padding:1rem .75rem 3rem}.account-card{grid-template-columns:1fr}.people-summary{grid-template-columns:repeat(2,1fr)}.filters-panel{grid-template-columns:1fr}.toolbar{display:grid;align-items:stretch}.person-card{grid-template-columns:1fr}.person-photo-column{grid-template-columns:100px 1fr;align-items:end}.person-sections{grid-template-columns:1fr}.data-section dl{grid-template-columns:1fr}.data-section dd{padding-bottom:.3rem}.form-grid,.legal-form-section{grid-template-columns:1fr}.form-grid label.is-wide{grid-column:auto}.photo-edit-grid{grid-template-columns:90px 1fr}.person-photo-frame.small{width:85px}.dialog-footer{flex-wrap:wrap}.dialog-footer>*{flex:1 1 auto}.people-summary-actions{justify-content:stretch}.people-summary-actions>*{flex:1 1 auto}}
</style>
