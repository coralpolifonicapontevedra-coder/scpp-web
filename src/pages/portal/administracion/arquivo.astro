---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---
<BaseLayout title="Arquivo e préstamos" lang="gl">
  <div class="private-layout"><PortalSidebar active="administracion" logoutId="arquivo-logout" />
    <main class="archive-main"><header class="page-head"><div><span>Administración</span><h1>Arquivo e préstamos</h1><p>Catalogación dos fondos da Coral e rexistro de préstamos, consultas, cesións e copias dixitais.</p></div><div class="account"><small>Usuario</small><strong id="user-email">—</strong><small>Nivel</small><strong>Administración</strong></div></header>
      <AdministracionNav active="arquivo" />
      <div id="loading" class="state">Cargando o arquivo…</div><div id="error" class="state error" hidden></div>
      <section id="app" hidden>
        <div class="metrics"><article><strong id="m-fondos">0</strong><span>Fondos</span></article><article><strong id="m-elementos">0</strong><span>Elementos catalogados</span></article><article><strong id="m-abertos">0</strong><span>Movementos abertos</span></article><article><strong id="m-vencidos">0</strong><span>Préstamos vencidos</span></article></div>
        <nav class="tabs" aria-label="Arquivo"><button class="active" data-tab="fondos">Fondos</button><button data-tab="elementos">Elementos</button><button data-tab="movementos">Préstamos e cesións</button><button data-tab="historico">Historial</button></nav>
        <div class="toolbar"><input id="search" type="search" placeholder="Buscar por nome, destinatario ou identificador"/><button id="new" class="primary">Nova alta</button></div>
        <div id="list" class="records"></div>
      </section>
    </main>
  </div>
  <dialog id="form-dialog"><form method="dialog" id="record-form"><header><div><small>Arquivo SCPP</small><h2 id="form-title">Nova alta</h2></div><button value="cancel" aria-label="Pechar">×</button></header><div id="form-fields" class="form-grid"></div><p id="form-status"></p><footer><button value="cancel" class="secondary">Cancelar</button><button type="submit" value="default" class="primary">Gardar</button></footer></form></dialog>
</BaseLayout>
<script>
  import { closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
  type Row=Record<string,unknown>; let data:{fondos:Row[],elementosFondo:Row[],movementos:Row[],elementosMovemento:Row[]}={fondos:[],elementosFondo:[],movementos:[],elementosMovemento:[]},tab='fondos',editing:Row|null=null;
  const $=(s:string)=>document.querySelector(s), esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
  async function request(accion:string,extra:Row={}){const u=await waitForPortalUser();if(!u)throw new Error('Non hai unha sesión válida.');const r=await fetch('/api/arquivo-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken:await u.getIdToken(),accion,...extra})});const x=await r.json();if(!r.ok||!x.ok)throw new Error(x.erro||'Non foi posible completar a operación.');return x;}
  const schemas:Record<string,Array<[string,string,string,boolean]>>={
    fondos:[['NomeFondo','Nome do fondo','text',true],['TipoFondo','Tipo','select:Persoal|Institucional|Colección|Musical|Documental|Mixto|Outro',true],['Descricion','Descrición','textarea',false],['PersoaEntidadeOrixe','Persoa ou entidade de orixe','text',false],['DataIngreso','Data de ingreso','date',false],['TipoIngreso','Tipo de ingreso','select:Doazón|Depósito|Compra|Transferencia|Outro',false],['LocalizacionFisica','Localización física','text',false],['NivelAcceso','Nivel de acceso','select:Coralistas|Xunta Directiva|Administración',true],['Estado','Estado','select:Activo|En catalogación|Arquivado',true],['Observacions','Observacións','textarea',false]],
    elementos:[['Id_Fondo','Fondo','select-fondos',true],['TipoRecurso','Tipo de recurso','select:Documento|Partitura|Fotografía|Audio|Vídeo|Outro',true],['Id_Recurso','Identificador do recurso','text',true],['TituloElemento','Título','text',true],['NumeroInventario','Número de inventario','text',false],['Caixa','Caixa','text',false],['Carpeta','Carpeta','text',false],['LocalizacionFisica','Localización física','text',false],['EstadoConservacion','Conservación','select:Bo|Regular|Delicado|Require restauración',false],['Observacions','Observacións','textarea',false]],
    movementos:[['DataEntrega','Data de entrega','date',true],['TipoMovemento','Tipo','select:Préstamo físico|Envío de copia dixital|Consulta presencial|Cesión temporal|Reprodución autorizada|Outro',true],['Destinatario','Destinatario','text',true],['Entidade','Entidade','text',false],['Email','Correo electrónico','email',false],['Telefono','Teléfono','tel',false],['MedioEntrega','Medio de entrega','select:En man|Correo electrónico|WhatsApp|Drive|Correo postal|Outro',true],['Finalidade','Finalidade','textarea',false],['DataPrevistaDevolucion','Devolución prevista','date',false],['Estado','Estado','select:Preparado|Entregado|Pendente de devolución|Devolto|Pechado|Cancelado',true],['Observacions','Observacións','textarea',false]]
  };
  function rows(){const movementos=tab==='historico'?data.movementos.filter(x=>['Devolto','Pechado','Cancelado'].includes(String(x.Estado||''))):data.movementos;return tab==='fondos'?data.fondos:tab==='elementos'?data.elementosFondo:movementos;}
  function key(r:Row){return String(r.Id_Fondo||r.Id_ElementoFondo||r.Id_Movemento||'');}
  function draw(){const q=String((($('#search') as HTMLInputElement)?.value)||'').toLowerCase(),list=$('#list');if(!list)return;const source=rows().filter(r=>JSON.stringify(r).toLowerCase().includes(q));list.innerHTML=source.length?source.map(r=>{const title=r.NomeFondo||r.TituloElemento||r.Destinatario||key(r),sub=r.Descricion||r.TipoRecurso||r.TipoMovemento||'',state=r.Estado||r.EstadoConservacion||'',fondoAction=tab==='fondos'?`<button class="${String(r.Estado)==='Arquivado'?'primary':'danger'}" data-toggle-fondo="${esc(key(r))}">${String(r.Estado)==='Arquivado'?'Reactivar':'Dar de baixa'}</button>`:'';return `<article class="record"><div><small>${esc(key(r))}</small><h2>${esc(title)}</h2><p>${esc(sub)}</p></div><strong class="badge">${esc(state)}</strong><button class="secondary" data-edit="${esc(key(r))}">Editar</button>${fondoAction}${tab==='movementos'&&!['Devolto','Pechado','Cancelado'].includes(String(r.Estado||''))?`<button class="primary" data-return="${esc(key(r))}">Rexistrar devolución</button>`:''}</article>`}).join(''):'<p class="state">Non hai rexistros para mostrar.</p>';}
  function metrics(){const open=data.movementos.filter(x=>!['Devolto','Pechado','Cancelado'].includes(String(x.Estado||''))),today=new Date().toISOString().slice(0,10);($('#m-fondos') as HTMLElement).textContent=String(data.fondos.length);($('#m-elementos') as HTMLElement).textContent=String(data.elementosFondo.length);($('#m-abertos') as HTMLElement).textContent=String(open.length);($('#m-vencidos') as HTMLElement).textContent=String(open.filter(x=>String(x.DataPrevistaDevolucion||'')<today&&x.DataPrevistaDevolucion).length);}
  function openForm(row:Row|null=null){editing=row;const schema=schemas[tab];if(!schema)return;($('#form-title') as HTMLElement).textContent=row?'Editar rexistro':'Nova alta';($('#form-fields') as HTMLElement).innerHTML=schema.map(([name,label,type,req])=>{let input='';if(type==='textarea')input=`<textarea name="${name}" ${req?'required':''}>${esc(row?.[name])}</textarea>`;else if(type==='select-fondos')input=`<select name="${name}" required>${data.fondos.map(f=>`<option value="${esc(f.Id_Fondo)}" ${String(row?.[name])===String(f.Id_Fondo)?'selected':''}>${esc(f.NomeFondo)}</option>`).join('')}</select>`;else if(type.startsWith('select:'))input=`<select name="${name}" ${req?'required':''}><option value=""></option>${type.slice(7).split('|').map(v=>`<option ${String(row?.[name])===v?'selected':''}>${esc(v)}</option>`).join('')}</select>`;else input=`<input name="${name}" type="${type}" value="${esc(row?.[name])}" ${req?'required':''}/>`;return`<label><span>${label}</span>${input}</label>`}).join('');($('#form-dialog') as HTMLDialogElement).showModal();}
  async function load(){try{const u=await waitForPortalUser();if(!u)throw new Error('Non hai unha sesión válida.');($('#user-email') as HTMLElement).textContent=u.email||'—';data=await request('listarArquivoAdministracion');($('#loading') as HTMLElement).hidden=true;($('#app') as HTMLElement).hidden=false;metrics();draw();}catch(e){($('#loading') as HTMLElement).hidden=true;const x=$('#error') as HTMLElement;x.hidden=false;x.textContent=e instanceof Error?e.message:String(e);}}
  $('.tabs')?.addEventListener('click',e=>{const b=e.target as HTMLButtonElement;if(!b.dataset.tab)return;tab=b.dataset.tab;document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('active',x===b));($('#new') as HTMLButtonElement).hidden=tab==='historico';draw();});$('#search')?.addEventListener('input',draw);$('#new')?.addEventListener('click',()=>openForm());
  $('#list')?.addEventListener('click',async e=>{const b=e.target as HTMLButtonElement;if(b.dataset.edit){openForm(rows().find(r=>key(r)===b.dataset.edit)||null);}if(b.dataset.toggleFondo){const fondo=data.fondos.find(r=>key(r)===b.dataset.toggleFondo);if(!fondo)return;const baixa=String(fondo.Estado)!=='Arquivado';if(!confirm(baixa?'Dar de baixa este fondo? Conservaranse os elementos e o historial.':'Reactivar este fondo?'))return;await request('gardarFondoAdministracion',{fondo:{...fondo,Estado:baixa?'Arquivado':'Activo'}});await load();}if(b.dataset.return&&confirm('Confirmas que o material foi devolto?')){await request('rexistrarDevolucionArquivoAdministracion',{idMovemento:b.dataset.return});await load();}});
  $('#record-form')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement,values=Object.fromEntries(new FormData(form));const status=$('#form-status') as HTMLElement;try{status.textContent='Gardando…';if(tab==='fondos')await request('gardarFondoAdministracion',{fondo:{...editing,...values}});if(tab==='elementos')await request('gardarElementoFondoAdministracion',{elemento:{...editing,...values,Activo:true}});if(tab==='movementos')await request('gardarMovementoArquivoAdministracion',{movemento:{...editing,...values}});($('#form-dialog') as HTMLDialogElement).close();await load();}catch(err){status.textContent=err instanceof Error?err.message:String(err);}});$('#arquivo-logout')?.addEventListener('click',()=>closePortalSession());load();
</script>
<style is:global>
body{background:#f5f3f1}.private-layout{display:flex;min-height:100vh}.archive-main{flex:1;min-width:0;padding:2rem clamp(1rem,3vw,3.5rem) 4rem;font-family:var(--fuente-minimalista)}.page-head{display:flex;justify-content:space-between;gap:2rem;margin-bottom:1.5rem}.page-head span,.account small{color:#806f74;font-size:.7rem;font-weight:800;text-transform:uppercase}.page-head h1{margin:.2rem 0;color:var(--color-principal);font-size:clamp(2rem,4vw,3.4rem)}.page-head p{max-width:720px;color:#625c58}.account{display:grid;align-content:start;min-width:250px;padding:1rem;border:1px solid #ddd;background:#fff}.account strong{margin-bottom:.7rem;overflow-wrap:anywhere}.state,.toolbar,.record,.metrics article{border:1px solid #ded8d3;background:#fff}.state{padding:1.2rem}.error{color:#8b2d36}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin-bottom:1rem}.metrics article{padding:1rem}.metrics strong{display:block;color:var(--color-principal);font-size:1.8rem}.metrics span{color:#766b66;font-size:.78rem}.tabs{display:flex;gap:.3rem;border-bottom:1px solid #ccc}.tabs button,.primary,.secondary{min-height:2.5rem;padding:.55rem .85rem;border:1px solid #cfc5c8;background:#fff;font-weight:800;cursor:pointer}.tabs button.active,.primary{border-color:#5d142b;background:#5d142b;color:#fff}.toolbar{display:flex;justify-content:space-between;gap:1rem;margin:1rem 0;padding:1rem}.toolbar input{flex:1;min-height:2.7rem;padding:.6rem;border:1px solid #ccc}.records{display:grid;gap:.7rem}.record{display:grid;grid-template-columns:1fr auto auto auto;align-items:center;gap:1rem;padding:1rem}.record h2{margin:.15rem 0;color:var(--color-principal);font-size:1.05rem}.record p,.record small{margin:0;color:#766b66}.badge{padding:.35rem .55rem;background:#edf4ef;color:#3f6c50;font-size:.75rem}dialog{width:min(720px,calc(100vw - 2rem));border:0;padding:0}dialog form{padding:1.2rem}dialog header,dialog footer{display:flex;justify-content:space-between;align-items:center;gap:1rem}dialog header{border-bottom:1px solid #ddd}dialog footer{justify-content:flex-end;border-top:1px solid #ddd;padding-top:1rem}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;padding:1rem 0}.form-grid label{display:grid;gap:.35rem}.form-grid input,.form-grid select,.form-grid textarea{min-height:2.6rem;padding:.55rem;border:1px solid #ccc;font:inherit}.form-grid textarea{min-height:5rem}@media(max-width:900px){.private-layout{display:block}.page-head{display:grid}.metrics{grid-template-columns:1fr 1fr}.record{grid-template-columns:1fr auto}}@media(max-width:620px){.archive-main{padding:1rem .8rem 2rem}.metrics,.form-grid{grid-template-columns:1fr}.tabs{overflow:auto}.toolbar,.record{display:grid}.account{min-width:0}}
.danger{min-height:2.5rem;padding:.55rem .85rem;border:1px solid #9a3944;background:#fff;color:#8b2d36;font-weight:800;cursor:pointer}
</style>
