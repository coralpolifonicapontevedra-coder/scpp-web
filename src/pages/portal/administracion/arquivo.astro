---
import BaseLayout from '../../../layouts/Layout.astro';
import PortalSidebar from '../../../components/PortalSidebar.astro';
import AdministracionNav from '../../../components/AdministracionNav.astro';
---

<BaseLayout title="Movementos de arquivo" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="administracion" logoutId="arquivo-logout" />
    <main class="archive-main">
      <header class="page-head">
        <div>
          <span>Administración</span>
          <h1>Movementos de arquivo</h1>
          <p>Rexistro de envíos dixitais, préstamos físicos, consultas, cesións e demais movementos dos fondos da Coral.</p>
        </div>
        <div class="account"><small>Usuario</small><strong id="user-email">—</strong></div>
      </header>
      <AdministracionNav active="arquivo" />
      <div id="loading" class="state">Cargando os datos do arquivo…</div>
      <div id="error" class="state error" hidden></div>
      <section id="app" hidden>
        <div class="metrics">
          <article><strong id="m-movementos">0</strong><span>Movementos</span></article>
          <article><strong id="m-abertos">0</strong><span>Con devolución pendente</span></article>
          <article><strong id="m-dixitais">0</strong><span>Envíos dixitais</span></article>
          <article><strong id="m-fondos">0</strong><span>Fondos</span></article>
        </div>
        <nav class="tabs" aria-label="Movementos de arquivo">
          <button class="active" data-tab="movementos">Movementos</button>
          <button data-tab="fondos">Fondos</button>
          <button data-tab="catalogo">Catálogo</button>
          <button data-tab="historico">Historial</button>
        </nav>
        <div class="toolbar"><input id="search" type="search" placeholder="Buscar por destinatario, recurso, fondo ou identificador" /><button id="new" class="primary" type="button">Novo movemento</button></div>
        <div id="list" class="records"></div>
      </section>
    </main>
  </div>

  <dialog id="movement-dialog" class="wide-dialog">
    <form method="dialog" id="movement-form">
      <header><div><small>Arquivo SCPP</small><h2>Novo movemento</h2></div><button type="button" data-close-movement aria-label="Pechar">×</button></header>
      <section class="form-section"><h3>1. Tipo de movemento</h3><div class="form-grid">
        <label><span>Tipo de movemento *</span><select name="TipoMovemento" id="movement-type" required><option value="Envío de copia dixital">Envío de copia dixital</option><option value="Préstamo físico">Préstamo físico</option><option value="Consulta presencial">Consulta presencial</option><option value="Cesión temporal">Cesión temporal</option><option value="Reprodución autorizada">Reprodución autorizada</option><option value="Outro">Outro</option></select></label>
        <label><span>Data de entrega / envío *</span><input name="DataEntrega" id="movement-date" type="date" required /></label>
        <label><span>Medio de entrega *</span><select name="MedioEntrega" id="delivery-method" required><option value="Correo electrónico">Correo electrónico</option><option value="Drive">Drive</option><option value="WhatsApp">WhatsApp</option><option value="En man">En man</option><option value="Correo postal">Correo postal</option><option value="Outro">Outro</option></select></label>
        <label id="return-date-field" hidden><span>Data prevista de devolución</span><input name="DataPrevistaDevolucion" type="date" /></label>
      </div></section>
      <section class="form-section"><h3>2. Destinatario e finalidade</h3><div class="form-grid">
        <label><span>Destinatario *</span><input name="Destinatario" required /></label><label><span>Entidade</span><input name="Entidade" /></label><label><span>Correo electrónico</span><input name="Email" type="email" /></label><label><span>Teléfono</span><input name="Telefono" type="tel" /></label><label class="wide"><span>Finalidade</span><textarea name="Finalidade" rows="3"></textarea></label><label><span>Autorizado por</span><input name="AutorizadoPor" /></label><label class="wide"><span>Observacións</span><textarea name="Observacions" rows="2"></textarea></label>
      </div></section>
      <section class="form-section"><div class="section-head"><div><h3>3. Material</h3><p>Podes engadir varios recursos ao mesmo movemento.</p></div></div><div class="resource-adder">
        <label><span>Tipo</span><select id="resource-type"><option value="Documento">Documento</option><option value="Partitura">Partitura</option><option value="Audio">Audio</option><option value="Fotografía">Fotografía</option><option value="Fondo">Fondo</option><option value="Outro">Outro / material físico</option></select></label>
        <label class="resource-select-wrap"><span>Recurso</span><input id="resource-filter" type="search" placeholder="Filtrar por título ou identificador" /><select id="resource-select"></select><input id="resource-manual" type="text" placeholder="Descrición ou referencia do material" hidden /></label>
        <label><span>Cantidade</span><input id="resource-qty" type="number" min="1" value="1" /></label><button id="add-resource" class="secondary" type="button">Engadir</button>
      </div><div id="selected-resources" class="selected-resources"><p class="muted">Aínda non seleccionaches material.</p></div></section>
      <section class="form-section"><h3>4. Documento de aceptación / autorización</h3><div class="form-grid"><label class="wide"><span>Xustificante</span><input id="movement-proof" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp" /><small>Opcional. Gardarase no arquivo privado e a súa referencia escribirase en MovementosArquivo.Xustificante.</small></label></div></section>
      <p id="movement-status" class="form-status"></p><footer><button type="button" data-close-movement class="secondary">Cancelar</button><button type="submit" class="primary">Gardar movemento</button></footer>
    </form>
  </dialog>

  <dialog id="simple-dialog"><form method="dialog" id="simple-form"><header><div><small>Arquivo SCPP</small><h2 id="simple-title">Nova alta</h2></div><button type="button" data-close-simple aria-label="Pechar">×</button></header><div id="simple-fields" class="form-grid"></div><p id="simple-status" class="form-status"></p><footer><button type="button" data-close-simple class="secondary">Cancelar</button><button type="submit" class="primary">Gardar</button></footer></form></dialog>
</BaseLayout>

<script>
  import { closePortalSession, waitForPortalUser } from '../../../lib/portal-session.js';
  type Row=Record<string,unknown>; type Recurso={tipo?:unknown,id?:unknown,titulo?:unknown,detalle?:unknown}; type ArchiveData={fondos:Row[],elementosFondo:Row[],movementos:Row[],elementosMovemento:Row[],recursos?:Record<string,Recurso[]>}; type SelectedResource={tipo:string,id:string,titulo:string,cantidade:number};
  let data:ArchiveData={fondos:[],elementosFondo:[],movementos:[],elementosMovemento:[],recursos:{}},tab='movementos',simpleEditing:Row|null=null,selectedResources:SelectedResource[]=[];
  const $=(s:string)=>document.querySelector(s),clean=(v:unknown)=>String(v??'').trim(),esc=(v:unknown)=>clean(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c)),today=()=>new Date().toISOString().slice(0,10),physicalTypes=new Set(['Préstamo físico','Cesión temporal']);
  async function request(accion:string,extra:Row={}){const u=await waitForPortalUser();if(!u)throw new Error('Non hai unha sesión válida.');const r=await fetch('/api/arquivo-admin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken:await u.getIdToken(),accion,...extra})});const x=await r.json().catch(()=>null);if(!r.ok||!x?.ok)throw new Error(x?.erro||'Non foi posible completar a operación.');return x;}
  async function uploadProof(file:File,movementId:string){const u=await waitForPortalUser();if(!u)throw new Error('Non hai unha sesión válida.');const form=new FormData();form.append('idToken',await u.getIdToken());form.append('idMovemento',movementId);form.append('file',file);const r=await fetch('/api/arquivo-xustificante',{method:'POST',body:form});const x=await r.json().catch(()=>null);if(!r.ok||!x?.ok)throw new Error(x?.erro||'Non foi posible gardar o xustificante.');return clean(x.ruta);}
  const movementElements=(id:string)=>data.elementosMovemento.filter(x=>clean(x.Id_Movemento)===id),isPhysicalMovement=(row:Row)=>physicalTypes.has(clean(row.TipoMovemento)),movementClosed=(row:Row)=>['Devolto','Pechado','Cancelado'].includes(clean(row.Estado));
  function metrics(){const open=data.movementos.filter(x=>isPhysicalMovement(x)&&!movementClosed(x)),digital=data.movementos.filter(x=>clean(x.TipoMovemento)==='Envío de copia dixital');($('#m-movementos') as HTMLElement).textContent=String(data.movementos.length);($('#m-abertos') as HTMLElement).textContent=String(open.length);($('#m-dixitais') as HTMLElement).textContent=String(digital.length);($('#m-fondos') as HTMLElement).textContent=String(data.fondos.length);}
  function resourceList(tipo:string):Recurso[]{if(tipo==='Fondo')return data.fondos.filter(f=>clean(f.Estado)!=='Arquivado').map(f=>({tipo:'Fondo',id:f.Id_Fondo,titulo:f.NomeFondo,detalle:f.TipoFondo}));return Array.isArray(data.recursos?.[tipo])?data.recursos?.[tipo]||[]:[];}
  function refreshResourcePicker(){const type=$('#resource-type') as HTMLSelectElement,filter=$('#resource-filter') as HTMLInputElement,select=$('#resource-select') as HTMLSelectElement,manual=$('#resource-manual') as HTMLInputElement,tipo=type.value,isManual=tipo==='Outro';filter.hidden=isManual;select.hidden=isManual;manual.hidden=!isManual;if(isManual)return;const q=filter.value.trim().toLowerCase(),items=resourceList(tipo).filter(r=>!q||`${clean(r.titulo)} ${clean(r.detalle)} ${clean(r.id)}`.toLowerCase().includes(q));select.innerHTML=`<option value="">Selecciona un recurso…</option>`+items.map(r=>`<option value="${esc(r.id)}">${esc(r.titulo)}${r.detalle?` — ${esc(r.detalle)}`:''} · ${esc(r.id)}</option>`).join('');}
  function drawSelectedResources(){const box=$('#selected-resources') as HTMLElement;if(!selectedResources.length){box.innerHTML='<p class="muted">Aínda non seleccionaches material.</p>';return;}box.innerHTML=selectedResources.map((r,i)=>`<article><div><small>${esc(r.tipo)} · ${esc(r.id||'sen referencia')}</small><strong>${esc(r.titulo)}</strong><span>Cantidade: ${r.cantidade}</span></div><button type="button" class="secondary" data-remove-resource="${i}">Retirar</button></article>`).join('');}
  function addResource(){const tipo=($('#resource-type') as HTMLSelectElement).value,qty=Math.max(1,Number(($('#resource-qty') as HTMLInputElement).value||1));let id='',titulo='';if(tipo==='Outro'){titulo=clean(($('#resource-manual') as HTMLInputElement).value);if(!titulo)return alert('Indica unha descrición do material.');}else{id=clean(($('#resource-select') as HTMLSelectElement).value);if(!id)return alert('Selecciona un recurso.');const item=resourceList(tipo).find(r=>clean(r.id)===id);titulo=clean(item?.titulo)||id;}if(selectedResources.some(r=>r.tipo===tipo&&r.id===id&&r.titulo===titulo))return alert('Ese material xa está engadido.');selectedResources.push({tipo,id,titulo,cantidade:qty});drawSelectedResources();($('#resource-filter') as HTMLInputElement).value='';($('#resource-manual') as HTMLInputElement).value='';($('#resource-qty') as HTMLInputElement).value='1';refreshResourcePicker();}
  function updateMovementMode(){const type=clean(($('#movement-type') as HTMLSelectElement).value),physical=physicalTypes.has(type),returnField=$('#return-date-field') as HTMLElement,method=$('#delivery-method') as HTMLSelectElement;returnField.hidden=!physical;if(physical&&['Correo electrónico','Drive','WhatsApp'].includes(method.value))method.value='En man';if(!physical&&['En man','Correo postal'].includes(method.value))method.value='Correo electrónico';}
  function openMovement(){selectedResources=[];drawSelectedResources();const form=$('#movement-form') as HTMLFormElement;form.reset();($('#movement-type') as HTMLSelectElement).value='Envío de copia dixital';($('#movement-date') as HTMLInputElement).value=today();($('#delivery-method') as HTMLSelectElement).value='Correo electrónico';($('#movement-status') as HTMLElement).textContent='';updateMovementMode();refreshResourcePicker();($('#movement-dialog') as HTMLDialogElement).showModal();}
  const fundFields:Array<[string,string,string]>=[['NomeFondo','Nome do fondo *','text'],['Descricion','Descrición','textarea'],['TipoFondo','Tipo de fondo *','select:Persoal|Institucional|Colección|Musical|Documental|Mixto|Outro'],['Procedencia','Procedencia','text'],['PersoaEntidadeOrixe','Persoa ou entidade de orixe','text'],['DataIngreso','Data de ingreso','date'],['TipoIngreso','Tipo de ingreso','select:Doazón|Depósito|Compra|Transferencia|Outro'],['DataInicio','Data de inicio','date'],['DataFin','Data de fin','date'],['Volume','Volume','text'],['EstadoConservacion','Estado de conservación','text'],['LocalizacionFisica','Localización física','text'],['NivelAcceso','Nivel de acceso','select:Coralistas|Xunta Directiva|Administración'],['Estado','Estado','select:Activo|En catalogación|Arquivado'],['Observacions','Observacións','textarea']];
  const catalogFields:Array<[string,string,string]>=[['Id_Fondo','Fondo *','fund'],['TipoRecurso','Tipo de recurso *','select:Documento|Partitura|Fotografía|Audio|Vídeo|Outro'],['Id_Recurso','Identificador do recurso','text'],['TituloElemento','Título do elemento *','text'],['NumeroInventario','Número de inventario','text'],['Caixa','Caixa','text'],['Carpeta','Carpeta','text'],['Orde','Orde','number'],['EstadoConservacion','Estado de conservación','text'],['LocalizacionFisica','Localización física','text'],['Observacions','Observacións','textarea'],['Activo','Activo','checkbox']];
  function fieldHtml(name:string,label:string,type:string,row:Row|null){const value=row?.[name],required=label.endsWith('*')?'required':'';if(type==='textarea')return`<label class="wide"><span>${esc(label)}</span><textarea name="${name}" ${required}>${esc(value)}</textarea></label>`;if(type==='fund')return`<label><span>${esc(label)}</span><select name="${name}" ${required}><option value="">Selecciona un fondo…</option>${data.fondos.map(f=>`<option value="${esc(f.Id_Fondo)}" ${clean(value)===clean(f.Id_Fondo)?'selected':''}>${esc(f.NomeFondo)}</option>`).join('')}</select></label>`;if(type==='checkbox')return`<label class="check-line"><input name="${name}" type="checkbox" ${value===true||clean(value).toLowerCase()==='true'?'checked':''}/><span>${esc(label)}</span></label>`;if(type.startsWith('select:'))return`<label><span>${esc(label)}</span><select name="${name}" ${required}><option value=""></option>${type.slice(7).split('|').map(v=>`<option value="${esc(v)}" ${clean(value)===v?'selected':''}>${esc(v)}</option>`).join('')}</select></label>`;return`<label><span>${esc(label)}</span><input name="${name}" type="${type}" value="${esc(value)}" ${required}/></label>`;}
  function openSimple(row:Row|null=null){simpleEditing=row;const fields=tab==='fondos'?fundFields:catalogFields;($('#simple-title') as HTMLElement).textContent=row?'Editar rexistro':tab==='fondos'?'Novo fondo':'Novo elemento de catálogo';($('#simple-fields') as HTMLElement).innerHTML=fields.map(f=>fieldHtml(f[0],f[1],f[2],row)).join('');($('#simple-status') as HTMLElement).textContent='';($('#simple-dialog') as HTMLDialogElement).showModal();}
  const movementTitle=(row:Row)=>clean(row.Destinatario)||clean(row.Entidade)||clean(row.Id_Movemento);
  function draw(){const q=clean((($('#search') as HTMLInputElement)?.value)).toLowerCase(),list=$('#list') as HTMLElement;let rows:Row[];if(tab==='fondos')rows=data.fondos;else if(tab==='catalogo')rows=data.elementosFondo;else if(tab==='historico')rows=data.movementos.filter(movementClosed);else rows=data.movementos.filter(x=>!movementClosed(x)||clean(x.TipoMovemento)==='Envío de copia dixital');rows=rows.filter(r=>{const related=clean(r.Id_Movemento)?movementElements(clean(r.Id_Movemento)).map(e=>`${clean(e.DescricionElemento)} ${clean(e.Id_Recurso)}`).join(' '):'';return!q||`${JSON.stringify(r)} ${related}`.toLowerCase().includes(q);});if(!rows.length){list.innerHTML='<p class="state">Non hai rexistros para mostrar.</p>';return;}if(tab==='fondos'){list.innerHTML=rows.map(r=>`<article class="record"><div><small>${esc(r.Id_Fondo)}</small><h2>${esc(r.NomeFondo)}</h2><p>${esc(r.TipoFondo)}${r.LocalizacionFisica?` · ${esc(r.LocalizacionFisica)}`:''}</p></div><strong class="badge">${esc(r.Estado)}</strong><button class="secondary" data-edit-simple="${esc(r.Id_Fondo)}">Editar</button></article>`).join('');return;}if(tab==='catalogo'){list.innerHTML=rows.map(r=>`<article class="record"><div><small>${esc(r.Id_ElementoFondo)} · ${esc(r.TipoRecurso)}</small><h2>${esc(r.TituloElemento)}</h2><p>${esc(r.NumeroInventario||r.Id_Recurso||'')}</p></div><strong class="badge">${esc(r.EstadoConservacion||'')}</strong><button class="secondary" data-edit-simple="${esc(r.Id_ElementoFondo)}">Editar</button></article>`).join('');return;}list.innerHTML=rows.map(r=>{const id=clean(r.Id_Movemento),elements=movementElements(id),items=elements.length?elements.map(e=>clean(e.DescricionElemento)||clean(e.Id_Recurso)).filter(Boolean).join(' · '):'Sen elementos asociados',canReturn=isPhysicalMovement(r)&&!movementClosed(r),proof=clean(r.Xustificante);return`<article class="record movement-record"><div><small>${esc(id)} · ${esc(r.DataEntrega)}</small><h2>${esc(movementTitle(r))}</h2><p><strong>${esc(r.TipoMovemento)}</strong> · ${esc(items)}</p><p>${esc(r.Finalidade||'')}</p>${proof?'<small class="proof-note">Xustificante rexistrado</small>':''}</div><strong class="badge">${esc(r.Estado)}</strong>${canReturn?`<button class="primary" data-return="${esc(id)}">Rexistrar devolución</button>`:''}</article>`;}).join('');}
  function activateTab(next:string){tab=next;document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('active',(x as HTMLButtonElement).dataset.tab===tab));const button=$('#new') as HTMLButtonElement;button.hidden=tab==='historico';button.textContent=tab==='fondos'?'Novo fondo':tab==='catalogo'?'Novo elemento':'Novo movemento';draw();}
  async function load(){try{const u=await waitForPortalUser();if(!u)throw new Error('Non hai unha sesión válida.');($('#user-email') as HTMLElement).textContent=u.email||'—';data=await request('listarArquivoAdministracion') as ArchiveData;data.recursos=data.recursos||{};($('#loading') as HTMLElement).hidden=true;($('#app') as HTMLElement).hidden=false;metrics();draw();}catch(e){($('#loading') as HTMLElement).hidden=true;const box=$('#error') as HTMLElement;box.hidden=false;box.textContent=e instanceof Error?e.message:String(e);}}
  async function saveMovement(event:Event){event.preventDefault();const form=event.currentTarget as HTMLFormElement,status=$('#movement-status') as HTMLElement;if(!selectedResources.length){status.textContent='Engade polo menos un recurso ou material ao movemento.';return;}const values=Object.fromEntries(new FormData(form)),type=clean(values.TipoMovemento),physical=physicalTypes.has(type),movement:Row={...values,DataPrevistaDevolucion:physical?clean(values.DataPrevistaDevolucion):'',DataDevolucion:'',Estado:physical?'Pendente de devolución':'Pechado',Xustificante:''},submit=form.querySelector('button[type="submit"]') as HTMLButtonElement;submit.disabled=true;status.textContent='Gardando o movemento…';try{const saved=await request('gardarMovementoArquivoAdministracion',{movemento:movement}),idMovemento=clean(saved.id);if(!idMovemento)throw new Error('O backend non devolveu o identificador do movemento.');const defaultFormat=physical?'Orixinal físico':'Copia dixital';for(const item of selectedResources){await request('gardarElementoMovementoAdministracion',{elemento:{Id_Movemento:idMovemento,TipoRecurso:item.tipo,Id_Recurso:item.id,DescricionElemento:item.titulo,Cantidade:item.cantidade,FormatoEntrega:defaultFormat,EstadoSaida:physical?'Entregado':'Enviado',EstadoRegreso:'',Devolto:physical?false:'',DataDevolucionElemento:'',Observacions:''}});}const proof=$('#movement-proof') as HTMLInputElement;if(proof.files?.[0]){status.textContent='Gardando o xustificante…';const ruta=await uploadProof(proof.files[0],idMovemento);await request('gardarMovementoArquivoAdministracion',{movemento:{...movement,Id_Movemento:idMovemento,Xustificante:ruta}});}($('#movement-dialog') as HTMLDialogElement).close();status.textContent='';await load();}catch(e){status.textContent=e instanceof Error?e.message:String(e);}finally{submit.disabled=false;}}
  async function saveSimple(event:Event){event.preventDefault();const form=event.currentTarget as HTMLFormElement,status=$('#simple-status') as HTMLElement,values:Row=Object.fromEntries(new FormData(form));if(tab==='catalogo')values.Activo=(form.elements.namedItem('Activo') as HTMLInputElement)?.checked===true;status.textContent='Gardando…';try{if(tab==='fondos')await request('gardarFondoAdministracion',{fondo:{...simpleEditing,...values}});else await request('gardarElementoFondoAdministracion',{elemento:{...simpleEditing,...values}});($('#simple-dialog') as HTMLDialogElement).close();await load();}catch(e){status.textContent=e instanceof Error?e.message:String(e);}}
  async function registerReturn(id:string){if(!confirm('Confirmas a devolución deste material físico?'))return;const date=today();try{await request('rexistrarDevolucionArquivoAdministracion',{idMovemento:id,dataDevolucion:date});for(const element of movementElements(id)){await request('gardarElementoMovementoAdministracion',{elemento:{...element,Devolto:true,DataDevolucionElemento:date,EstadoRegreso:'Devolto'}});}await load();}catch(e){alert(e instanceof Error?e.message:String(e));}}
  $('.tabs')?.addEventListener('click',e=>{const b=e.target as HTMLButtonElement;if(b.dataset.tab)activateTab(b.dataset.tab);});$('#search')?.addEventListener('input',draw);$('#new')?.addEventListener('click',()=>tab==='movementos'?openMovement():openSimple());$('#movement-type')?.addEventListener('change',updateMovementMode);$('#resource-type')?.addEventListener('change',()=>{($('#resource-filter') as HTMLInputElement).value='';refreshResourcePicker();});$('#resource-filter')?.addEventListener('input',refreshResourcePicker);$('#add-resource')?.addEventListener('click',addResource);$('#selected-resources')?.addEventListener('click',e=>{const b=e.target as HTMLButtonElement;if(b.dataset.removeResource==null)return;selectedResources.splice(Number(b.dataset.removeResource),1);drawSelectedResources();});$('#movement-form')?.addEventListener('submit',saveMovement);$('#simple-form')?.addEventListener('submit',saveSimple);$('#list')?.addEventListener('click',e=>{const b=e.target as HTMLButtonElement;if(b.dataset.return)registerReturn(b.dataset.return);if(b.dataset.editSimple){const source=tab==='fondos'?data.fondos:data.elementosFondo,key=tab==='fondos'?'Id_Fondo':'Id_ElementoFondo';openSimple(source.find(r=>clean(r[key])===b.dataset.editSimple)||null);}});document.querySelectorAll('[data-close-movement]').forEach(b=>b.addEventListener('click',()=>($('#movement-dialog') as HTMLDialogElement).close()));document.querySelectorAll('[data-close-simple]').forEach(b=>b.addEventListener('click',()=>($('#simple-dialog') as HTMLDialogElement).close()));$('#arquivo-logout')?.addEventListener('click',()=>closePortalSession());load();
</script>

<style is:global>
