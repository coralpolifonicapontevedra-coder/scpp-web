---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Concertos" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="concertos" logoutId="concertos-novo-logout" />

    <main class="concertos-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Portal do Coralista</span>
          <h1>Concertos</h1>
          <p>Consulta as próximas actuacións e o arquivo de concertos da Coral, cos seus programas e información práctica.</p>
        </div>
        <div class="account-card" aria-label="Conta identificada">
          <small>Conta identificada</small>
          <strong id="user-email">—</strong>
        </div>
      </header>

      <section id="estado" class="portal-state">Cargando os concertos…</section>

      <section id="app" class="concertos-app" hidden>
        <div class="view-switch" aria-label="Vista de concertos">
          <button id="ver-concertos" type="button" class="is-active">Concertos</button>
          <button id="ver-informe" type="button">Informe de asistencia</button>
          <button id="ver-historico" type="button">Histórico</button>
        </div>

        <div id="vista-concertos">
          <div class="concert-toolbar">
            <label class="search-box">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></svg>
              <input id="busca" type="search" placeholder="Buscar concerto, cidade ou lugar" autocomplete="off" />
            </label>
            <div class="filters" aria-label="Filtrar concertos">
              <button type="button" class="is-active" data-filter="todos">Todos</button>
              <button type="button" data-filter="proximos">Próximos</button>
              <button type="button" data-filter="arquivo">Arquivo</button>
            </div>
            <p class="concert-count"><strong id="concert-count">0</strong> concertos</p>
          </div>

          <p id="estado-asistencias" class="attendance-status">Asistentes: cargando…</p>
          <div id="grid" class="concert-grid"></div>
          <p id="sen-resultados" class="no-results" hidden>Non hai concertos que coincidan coa busca.</p>
        </div>

        <section id="vista-informe" class="attendance-report" hidden>
          <header class="report-heading">
            <div>
              <span>Participación da Coral</span>
              <h2>Informe de asistencia</h2>
              <p>Agrupado por número de concertos e, dentro de cada grupo, por corda e orde alfabética.</p>
            </div>
            <strong id="resumo-informe"></strong>
          </header>
          <div id="informe" class="report-content"></div>
          <p id="informe-baleiro" class="no-results" hidden>Non hai datos de asistencia dispoñibles.</p>
        </section>

        <!-- VISTA DE HISTÓRICO CON TIPOGRAFÍA APTOS UNIFICADA -->
        <section id="vista-historico" class="history-report" hidden>
          <header class="report-heading">
            <div>
              <span>Arquivo da Coral</span>
              <h2>Histórico de concertos</h2>
              <p>Consulta por décadas os concertos documentados desde 1925, cunha lectura directa e sen pasos intermedios.</p>
            </div>
            <strong id="resumo-historico"></strong>
          </header>
          <div class="history-actions">
            <a href="/historico-concertos/">Ver histórico completo</a>
            <a href="/documentos/Concertos_SCPP_1925_2026.pdf" download="Concertos_SCPP_1925_2026.pdf">Descargar histórico (.pdf)</a>
          </div>
          <label class="history-search search-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></svg>
            <input id="busca-historico" type="search" placeholder="Buscar ano, número, concerto, cidade ou lugar" autocomplete="off" />
          </label>
          <div id="anos-historico" class="historico-container"></div>
          <p id="historico-baleiro" class="no-results" hidden>Non hai concertos que coincidan coa busca.</p>
        </section>
      </section>
    </main>
  </div>

  <dialog id="dialogo" class="concert-dialog" aria-labelledby="titulo">
    <button id="pechar" type="button" class="dialog-close" aria-label="Pechar">×</button>
    <div class="detail-grid">
      <div>
        <span id="estado-concerto" class="detail-state"></span>
        <time id="data-concerto"></time>
        <h2 id="titulo"></h2>
        <p id="detalle" class="detail-location"></p>
      </div>
    </div>

    <section class="program-section">
      <header>
        <span>Programa</span>
        <strong id="contador-programa"></strong>
      </header>
      <ol id="programa" class="program-list"></ol>
      <p id="programa-baleiro" class="program-empty" hidden>O programa deste concerto aínda non está incorporado.</p>
    </section>

    <details class="attendees-section" open>
      <summary><span>Asistentes</span><strong id="contador-asistentes"></strong></summary>
      <div id="grupos-asistentes" class="attendees-groups"></div>
      <p id="sen-asistentes" class="attendees-empty" hidden>Non hai asistentes rexistrados para este concerto.</p>
    </details>
  </dialog>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const URL_CONCERTOS = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSX8BEJ-hrubqEtaZ1zZaLSy7LoxaDQOuQuqR2ior7TZErtBGL5bJG0B_AK5Dp8eFeTDb3Pmpqh7Hnu/pub?gid=1098509641&single=true&output=csv';
  const URL_PROGRAMAS = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTMm4Z45Bcfz_-AEwcA6lNmttLAjJEOxXpTFmlnLwtRCoSIF7xlCP-LEdlfLoMYkbOnAefC7I9G9Cec/pub?gid=1925601694&single=true&output=csv';
  const URL_REPERTORIO = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSuYtrIlKLbU1QkH7fP2zbKQQYFV6kvACLLFBZrJ7cC8t54jAsrTDWvL_x7fko9Hw71oKIoYyBcjNF3/pub?gid=984049442&single=true&output=csv';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const estado = document.querySelector('#estado');
  const app = document.querySelector('#app');
  const grid = document.querySelector('#grid');
  const busca = document.querySelector('#busca');
  const filtros = document.querySelector('.filters');
  const contador = document.querySelector('#concert-count');
  const senResultados = document.querySelector('#sen-resultados');
  const estadoAsistencias = document.querySelector('#estado-asistencias');
  const dialogo = document.querySelector('#dialogo');
  const vistaConcertos = document.querySelector('#vista-concertos');
  const vistaInforme = document.querySelector('#vista-informe');
  const informe = document.querySelector('#informe');
  const resumoInforme = document.querySelector('#resumo-informe');
  const informeBaleiro = document.querySelector('#informe-baleiro');
  const logout = document.querySelector('#concertos-novo-logout');
  const botonConcertos = document.querySelector('#ver-concertos');
  const botonInforme = document.querySelector('#ver-informe');
  const botonHistorico = document.querySelector('#ver-historico');
  const vistaHistorico = document.querySelector('#vista-historico');
  const anosHistorico = document.querySelector('#anos-historico');
  const resumoHistorico = document.querySelector('#resumo-historico');
  const buscaHistorico = document.querySelector('#busca-historico');
  const historicoBaleiro = document.querySelector('#historico-baleiro');

  let concertos = [];
  let todosConcertos = [];
  let filtroActivo = 'todos';

  const normalizar = (v = '') => String(v).normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();
  const escapar = (v = '') => String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');

  function parseCSV(texto) {
    const filas = [];
    let fila = [], campo = '', comillas = false;
    for (let i = 0; i < texto.length; i += 1) {
      const c = texto[i], s = texto[i + 1];
      if (c === '"' && comillas && s === '"') { campo += '"'; i += 1; }
      else if (c === '"') comillas = !comillas;
      else if (c === ',' && !comillas) { fila.push(campo); campo = ''; }
      else if ((c === '\n' || c === '\r') && !comillas) {
        if (c === '\r' && s === '\n') i += 1;
        fila.push(campo);
        if (fila.some((x) => x.trim())) filas.push(fila);
        fila = []; campo = '';
      } else campo += c;
    }
    if (campo || fila.length) { fila.push(campo); filas.push(fila); }
    const cab = (filas.shift() || []).map(normalizar);
    return filas.map((valores) => Object.fromEntries(cab.map((h, i) => [h, String(valores[i] || '').trim()])));
  }

  const valor = (fila, ...nomes) => {
    for (const nome of nomes) {
      const v = fila[normalizar(nome)];
      if (v !== undefined && v !== '') return v;
    }
    return '';
  };

  const verdadeiro = (v = '') => ['true','1','si','sí','yes','x'].includes(normalizar(v));
  const anoHistorico = (concerto) => {
    const data = String(concerto.data || '').match(/\b(18|19|20)\d{2}\b/)?.[0];
    const texto = String(concerto.dataTextoHistorica || '').match(/\b(18|19|20)\d{2}\b/)?.[0];
    return data || texto || 'Sen data';
  };

  const dataISO = (data = '') => {
    const p = String(data).split(/[\/-]/).map(Number);
    if (p.length !== 3 || p.some(Number.isNaN)) return String(data);
    return p[0] > 31
      ? `${p[0]}-${String(p[1]).padStart(2,'0')}-${String(p[2]).padStart(2,'0')}`
      : `${p[2]}-${String(p[1]).padStart(2,'0')}-${String(p[0]).padStart(2,'0')}`;
  };

  const partesData = (data) => {
    const d = new Date(`${dataISO(data)}T12:00:00`);
    if (Number.isNaN(d.getTime())) return { dia: data, mes: '', ano: '' };
    const meses = ['XAN','FEB','MAR','ABR','MAI','XUÑ','XUL','AGO','SET','OUT','NOV','DEC'];
    return { dia: String(d.getDate()).padStart(2,'0'), mes: meses[d.getMonth()], ano: String(d.getFullYear()) };
  };

  const dataLonga = (data) => {
    const d = new Date(`${dataISO(data)}T12:00:00`);
    return Number.isNaN(d.getTime()) ? data : new Intl.DateTimeFormat('gl-ES', { day:'numeric', month:'long', year:'numeric' }).format(d);
  };

  async function lerCSV(url) {
    const r = await fetch(url, { cache: 'no-store' });
    if (!r.ok) throw new Error(`Erro ao ler datos (${r.status})`);
    return parseCSV(await r.text());
  }

  function etiquetaEstado(c) {
    return c.estado === 'realizado' ? 'Arquivo' : 'Próximo concerto';
  }

  function pintarConcertos() {
    if (!(grid instanceof HTMLElement)) return;
    const q = normalizar(busca instanceof HTMLInputElement ? busca.value : '');
    const listaxe = concertos.filter((c) => {
      const coincideBusca = normalizar(`${c.nome} ${c.cidade} ${c.lugar} ${c.data}`).includes(q);
      const coincideFiltro = filtroActivo === 'todos'
        || (filtroActivo === 'proximos' && c.estado !== 'realizado')
        || (filtroActivo === 'arquivo' && c.estado === 'realizado');
      return coincideBusca && coincideFiltro;
    });

    if (contador) contador.textContent = String(listaxe.length);
    if (senResultados instanceof HTMLElement) senResultados.hidden = listaxe.length > 0;

    grid.innerHTML = listaxe.map((c) => {
      const data = partesData(c.data);
      return `<button type="button" class="concert-square ${c.estado === 'realizado' ? 'is-past' : ''}" data-id="${escapar(c.id)}">
        <span class="square-top"><span class="square-state">${escapar(etiquetaEstado(c))}</span><span class="square-year">${escapar(data.ano)}</span></span>
        <span class="square-date"><strong>${escapar(data.dia)}</strong><span>${escapar(data.mes)}</span></span>
        <span class="square-copy"><strong>${escapar(c.nome)}</strong><span>${escapar([c.lugar,c.cidade].filter(Boolean).join(' · '))}</span></span>
        <span class="square-bottom"><span>${c.programa.length} obra${c.programa.length === 1 ? '' : 's'}</span><span>${(c.asistentes || []).length} asistentes</span></span>
      </button>`;
    }).join('');
  }

  function pintarInforme() {
    if (!(informe instanceof HTMLElement)) return;

    const persoas = new Map();
    todosConcertos.forEach((c) => (c.asistentes || []).forEach((p) => {
      const nome = String(p.nome || '').trim();
      const voz = String(p.voz || 'Sen voz indicada').trim();
      if (!nome) return;
      const clave = `${voz}|${nome}`;
      if (!persoas.has(clave)) persoas.set(clave, { nome, voz, concertos: [] });
      const persoa = persoas.get(clave);
      if (!persoa.concertos.some((item) => item.id === c.id)) {
        persoa.concertos.push({ id: c.id, data: c.data, nome: c.nome });
      }
    }));

    const listaxe = [...persoas.values()];
    listaxe.forEach((p) => p.concertos.sort((a,b) => dataISO(b.data).localeCompare(dataISO(a.data))));

    const totais = [...new Set(listaxe.map((p) => p.concertos.length))].sort((a,b) => b-a);
    const ordeVoces = ['Soprano','Contralto','Tenor','Baixo'];

    informe.innerHTML = totais.map((total) => {
      const grupo = listaxe.filter((p) => p.concertos.length === total);
      const voces = [...new Set(grupo.map((p) => p.voz))].sort((a,b) => {
        const ia = ordeVoces.indexOf(a), ib = ordeVoces.indexOf(b);
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b,'gl');
      });

      return `<section class="attendance-tier">
        <header><strong>${total} concerto${total === 1 ? '' : 's'}</strong><span>${grupo.length} persoa${grupo.length === 1 ? '' : 's'}</span></header>
        <div class="report-voices">${voces.map((voz) => {
          const persoasVoz = grupo.filter((p) => p.voz === voz)
            .sort((a,b) => a.nome.localeCompare(b.nome,'gl',{ sensitivity:'base' }));
          return `<section class="report-voice">
            <h3>${escapar(voz)} <span>${persoasVoz.length}</span></h3>
            <div>${persoasVoz.map((p) => `<article class="person-report">
              <header><strong>${escapar(p.nome)}</strong><span>${p.concertos.length}</span></header>
              <ul>${p.concertos.map((c) => `<li><button type="button" data-report-id="${escapar(c.id)}"><time>${escapar(c.data)}</time><span>${escapar(c.nome)}</span></button></li>`).join('')}</ul>
            </article>`).join('')}</div>
          </section>`;
        }).join('')}</div>
      </section>`;
    }).join('');

    const totalAsistencias = listaxe.reduce((suma,p) => suma + p.concertos.length, 0);
    if (resumoInforme) resumoInforme.textContent = `${listaxe.length} persoas · ${totalAsistencias} asistencias`;
    if (informeBaleiro instanceof HTMLElement) informeBaleiro.hidden = listaxe.length > 0;
  }

  function abrirConcerto(id) {
    const c = todosConcertos.find((x) => x.id === id);
    if (!c || !(dialogo instanceof HTMLDialogElement)) return;
    const set = (s,v) => { const e = dialogo.querySelector(s); if (e) e.textContent = String(v || ''); };

    set('#estado-concerto', etiquetaEstado(c));
    const time = dialogo.querySelector('#data-concerto');
    if (time instanceof HTMLTimeElement) { time.textContent = dataLonga(c.data); time.dateTime = dataISO(c.data); }
    set('#titulo', c.nome);
    set('#detalle', [c.lugar,c.cidade].filter(Boolean).join(' · '));

    const programa = dialogo.querySelector('#programa');
    if (programa) programa.innerHTML = c.programa.map((p,index) => `<li><span class="program-order">${String(index+1).padStart(2,'0')}</span><span><strong>${escapar(p.obra)}</strong>${p.autor ? `<small>${escapar(p.autor)}</small>` : ''}</span></li>`).join('');
    set('#contador-programa', c.programa.length ? `${c.programa.length} obras` : '');
    const programaBaleiro = dialogo.querySelector('#programa-baleiro');
    if (programaBaleiro instanceof HTMLElement) programaBaleiro.hidden = c.programa.length > 0;

    const asistentes = c.asistentes || [];
    set('#contador-asistentes', `${asistentes.length} persoas`);
    const grupos = dialogo.querySelector('#grupos-asistentes');
    if (grupos) {
      const porVoz = asistentes.reduce((acc,p) => {
        const voz = p.voz || 'Sen voz indicada';
        (acc[voz] ||= []).push(p.nome);
        return acc;
      }, {});
      const ordeVoces = ['Soprano','Contralto','Tenor','Baixo'];
      const voces = Object.keys(porVoz).sort((a,b) => {
        const ia = ordeVoces.indexOf(a), ib = ordeVoces.indexOf(b);
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b,'gl');
      });
      grupos.innerHTML = voces.map((voz) => {
        const nomes = porVoz[voz].sort((a,b) => a.localeCompare(b,'gl',{ sensitivity:'base' }));
        return `<section class="voice-group"><h3>${escapar(voz)} <span>${nomes.length}</span></h3><ul>${nomes.map((n) => `<li>${escapar(n)}</li>`).join('')}</ul></section>`;
      }).join('');
    }
    const sen = dialogo.querySelector('#sen-asistentes');
    if (sen instanceof HTMLElement) sen.hidden = asistentes.length > 0;
    dialogo.showModal();
  }

  const inicioPeriodo = (ano) => 1925 + Math.floor((Number(ano) - 1925) / 10) * 10;
  const etiquetaPeriodo = (inicio) => `${inicio}–${Math.min(inicio + 9, 2026)}`;
  const nomeXenerico = (concerto) => {
    const nome = normalizar(concerto.nome).replaceAll(' ', '');
    const numero = normalizar(concerto.numeroConcerto).replaceAll(' ', '');
    return nome === `concerto nº ${numero}`.replaceAll(' ', '')
      || nome === `concerto n.º ${numero}`.replaceAll(' ', '')
      || nome === `concerto numero ${numero}`.replaceAll(' ', '');
  };
  const descricionHistorica = (concerto) =>
    concerto.caracteristicas || (nomeXenerico(concerto) ? '' : concerto.nome) || 'Sen descrición documentada';

  function pintarHistorico() {
    if (!(anosHistorico instanceof HTMLElement)) return;
    const q = normalizar(buscaHistorico instanceof HTMLInputElement ? buscaHistorico.value : '');
    const consultaAno = /^\d{4}$/.test(q);
    const listaxe = todosConcertos.filter((concerto) => {
      if (!concerto.numeroConcerto) return false;
      if (consultaAno) return anoHistorico(concerto) === q;
      return !q || normalizar([
        anoHistorico(concerto), concerto.numeroConcerto, concerto.data,
        concerto.dataTextoHistorica, concerto.nome, concerto.lugar,
        concerto.cidade, concerto.caracteristicas
      ].join(' ')).includes(q);
    });
    const porPeriodo = new Map();
    listaxe.forEach((concerto) => {
      const ano = anoHistorico(concerto);
      const periodo = ano === 'Sen data' ? ano : inicioPeriodo(ano);
      if (!porPeriodo.has(periodo)) porPeriodo.set(periodo, []);
      porPeriodo.get(periodo).push(concerto);
    });
    const periodos = [...porPeriodo.keys()].sort((a,b) => {
      if (a === 'Sen data') return 1;
      if (b === 'Sen data') return -1;
      return Number(a) - Number(b);
    });

    const abertos = q.length > 0;

    anosHistorico.innerHTML = periodos.map((periodo) => {
      const items = porPeriodo.get(periodo).sort((a,b) => (Number(a.ordeHistorica)||0) - (Number(b.ordeHistorica)||0));
      const etiqueta = periodo === 'Sen data' ? periodo : `Década de ${etiquetaPeriodo(periodo)}`;
      return `<details class="historico-decada" ${abertos ? 'open' : ''}>
        <summary class="historico-summary">
          <div class="historico-summary-main">
            <span class="historico-icon" aria-hidden="true"></span>
            <div class="historico-summary-info">
              <span class="historico-kicker">Período histórico</span>
              <strong class="historico-title">${escapar(etiqueta)}</strong>
            </div>
          </div>

          <div class="historico-summary-side">
            <span class="historico-count">
              ${items.length}
              <small>${items.length === 1 ? 'concerto' : 'concertos'}</small>
            </span>
            <span class="historico-toggle" aria-hidden="true"></span>
          </div>
        </summary>

        <div class="historico-content">
          <div class="historico-table-wrapper">
            <table class="historico-table">
              <thead>
                <tr>
                  <th class="th-num">Nº</th>
                  <th class="th-data">Data</th>
                  <th class="th-localidade">Localidade</th>
                  <th class="th-lugar">Lugar</th>
                  <th class="th-descricion">Descrición</th>
                </tr>
              </thead>
              <tbody>${items.map((concerto) => `<tr>
                <td class="col-num">${escapar(concerto.numeroConcerto || '—')}</td>
                <td class="col-date">${escapar(concerto.dataTextoHistorica || concerto.data || 'Data non documentada')}</td>
                <td class="col-localidade">${escapar(concerto.cidade || '—')}</td>
                <td class="col-lugar"><strong>${escapar(concerto.lugar || '—')}</strong></td>
                <td class="col-desc">${escapar(descricionHistorica(concerto))}</td>
              </tr>`).join('')}</tbody>
            </table>
          </div>
        </div>
      </details>`;
    }).join('');

    if (resumoHistorico) resumoHistorico.textContent = `${listaxe.length} concerto${listaxe.length === 1 ? '' : 's'} · ${periodos.length} ${periodos.length === 1 ? 'período' : 'períodos'}`;
    if (historicoBaleiro instanceof HTMLElement) historicoBaleiro.hidden = listaxe.length > 0;
  }

  async function cargarConcertos() {
    const [cRows,pRows,rRows] = await Promise.all([lerCSV(URL_CONCERTOS),lerCSV(URL_PROGRAMAS),lerCSV(URL_REPERTORIO)]);
    const obras = new Map(rRows.map((r) => [valor(r,'Id','Row ID'), { nome:valor(r,'NomeObra','Nome','Obra'), autor:valor(r,'Compositor','Autor') }]));

    todosConcertos = cRows.map((r) => {
      const id = valor(r,'Id','Row ID');
      const programa = pRows.filter((p) => valor(p,'Id_Conciertos','Id_Concertos') === id).map((p) => {
        const obraId = valor(p,'Id_Obras');
        const obra = obras.get(obraId) || {};
        return { obra:obra.nome || obraId, autor:obra.autor || '', orde:Number(valor(p,'Orde')) || 999 };
      }).sort((a,b) => a.orde-b.orde);

      return {
        id,
        data:valor(r,'Data'),
        nome:valor(r,'Nome'),
        cidade:valor(r,'Cidade'),
        lugar:valor(r,'Lugar'),
        estado:normalizar(valor(r,'Estado')) || 'confirmado',
        mostrarWeb:verdadeiro(valor(r,'Mostrar_Web')),
        numeroConcerto:valor(r,'NumeroConcerto'),
        ordeHistorica:Number(valor(r,'OrdeHistorica')) || 0,
        dataTextoHistorica:valor(r,'DataTextoHistorica'),
        caracteristicas:valor(r,'Características','Caracteristicas'),
        programa,
        asistentes:[]
      };
    }).filter((c) => c.id && (c.nome || c.numeroConcerto))
      .sort((a,b) => (b.ordeHistorica || 0) - (a.ordeHistorica || 0) || dataISO(b.data).localeCompare(dataISO(a.data)));
    concertos = todosConcertos.filter((c) => c.mostrarWeb && c.nome && c.data)
      .sort((a,b) => dataISO(b.data).localeCompare(dataISO(a.data)));

    pintarConcertos();
    pintarHistorico();
    if (app instanceof HTMLElement) app.hidden = false;
    if (estado instanceof HTMLElement) estado.hidden = true;
  }

  async function cargarAsistencias(user) {
    const inicio = performance.now();
    try {
      const idToken = await user.getIdToken(true);
      const r = await fetch(`/api/asistencias-concertos?t=${Date.now()}`, {
        method:'POST',
        headers:{ 'Content-Type':'application/json', Accept:'application/json' },
        body:JSON.stringify({ idToken }),
        cache:'no-store'
      });
      const datos = await r.json();
      if (!r.ok || !datos?.ok) throw new Error(datos?.erro || `HTTP ${r.status}`);
      const porConcerto = datos.asistenciasPorConcerto || {};
      todosConcertos = todosConcertos.map((c) => ({ ...c, asistentes:Array.isArray(porConcerto[c.id]) ? porConcerto[c.id] : [] }));
      concertos = todosConcertos.filter((c) => c.mostrarWeb && c.nome && c.data)
        .sort((a,b) => dataISO(b.data).localeCompare(dataISO(a.data)));
      pintarConcertos();
      pintarInforme();
      pintarHistorico();
      if (estadoAsistencias) estadoAsistencias.textContent = `Asistentes cargados en ${Math.round(performance.now()-inicio)} ms`;
    } catch (e) {
      if (estadoAsistencias) estadoAsistencias.textContent = `Erro ao cargar asistentes: ${e instanceof Error ? e.message : e}`;
    }
  }

  onAuthStateChanged(auth, async (user) => {
    if (!user?.email) { window.location.replace('/portal/'); return; }
    const email = document.querySelector('#user-email');
    if (email) email.textContent = user.email;
    try {
      await cargarConcertos();
      cargarAsistencias(user);
    } catch (e) {
      if (estado) estado.textContent = e instanceof Error ? e.message : String(e);
    }
  });

  busca?.addEventListener('input', pintarConcertos);
  filtros?.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.filter) return;
    filtroActivo = target.dataset.filter;
    filtros.querySelectorAll('button').forEach((b) => b.classList.toggle('is-active', b === target));
    pintarConcertos();
  });
  grid?.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    const button = target.closest('[data-id]');
    if (button) abrirConcerto(button.getAttribute('data-id') || '');
  });
  informe?.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    const button = target.closest('[data-report-id]');
    if (button) abrirConcerto(button.getAttribute('data-report-id') || '');
  });
  botonConcertos?.addEventListener('click', () => {
    if (vistaConcertos instanceof HTMLElement) vistaConcertos.hidden = false;
    if (vistaInforme instanceof HTMLElement) vistaInforme.hidden = true;
    if (vistaHistorico instanceof HTMLElement) vistaHistorico.hidden = true;
    botonConcertos.classList.add('is-active');
    botonInforme?.classList.remove('is-active');
    botonHistorico?.classList.remove('is-active');
  });
  botonInforme?.addEventListener('click', () => {
    if (vistaConcertos instanceof HTMLElement) vistaConcertos.hidden = true;
    if (vistaInforme instanceof HTMLElement) vistaInforme.hidden = false;
    if (vistaHistorico instanceof HTMLElement) vistaHistorico.hidden = true;
    botonInforme.classList.add('is-active');
    botonConcertos?.classList.remove('is-active');
    botonHistorico?.classList.remove('is-active');
  });
  botonHistorico?.addEventListener('click', () => {
    if (vistaConcertos instanceof HTMLElement) vistaConcertos.hidden = true;
    if (vistaInforme instanceof HTMLElement) vistaInforme.hidden = true;
    if (vistaHistorico instanceof HTMLElement) vistaHistorico.hidden = false;
    botonHistorico.classList.add('is-active');
    botonConcertos?.classList.remove('is-active');
    botonInforme?.classList.remove('is-active');
  });
  buscaHistorico?.addEventListener('input', pintarHistorico);

  document.querySelector('#pechar')?.addEventListener('click', () => dialogo instanceof HTMLDialogElement && dialogo.close());
  dialogo?.addEventListener('click', (e) => { if (e.target === dialogo && dialogo instanceof HTMLDialogElement) dialogo.close(); });
  logout?.addEventListener('click', async () => { await signOut(auth); window.location.href='/portal/'; });
</script>

