---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Concertos" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="concertos" logoutId="concertos-logout" />

    <main class="concertos-main">
      <header class="private-page-header">
        <div>
          <span class="section-kicker">Portal do Coralista</span>
          <h1>Concertos</h1>
          <p>Consulta as próximas actuacións e o arquivo de concertos da Coral, cos seus programas e información práctica.</p>
        </div>
        <div class="account-card" aria-label="Conta identificada">
          <small>Conta identificada</small>
          <strong id="user-email">—</strong>
        </div>
      </header>

      <section id="loading" class="portal-state">Cargando os concertos…</section>
      <section id="error-state" class="portal-state error-state" hidden>
        <strong>Non foi posible cargar os concertos</strong>
        <p id="error-message"></p>
        <button id="retry-button" type="button">Tentar de novo</button>
      </section>

      <section id="concertos-app" class="concertos-app" hidden>
        <div class="view-switch" aria-label="Vista de concertos">
          <button type="button" class="is-active" data-view="concertos">Concertos</button>
          <button type="button" data-view="asistencia">Informe de asistencia</button>
        </div>

        <div id="concerts-view">
          <div class="concert-toolbar">
            <label class="search-box">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16.5 16.5 4 4" /></svg>
              <input id="concert-search" type="search" placeholder="Buscar concerto, cidade ou lugar" autocomplete="off" />
            </label>
            <div class="filters" aria-label="Filtrar concertos">
              <button type="button" class="is-active" data-filter="todos">Todos</button>
              <button type="button" data-filter="proximos">Próximos</button>
              <button type="button" data-filter="arquivo">Arquivo</button>
            </div>
            <p class="concert-count"><strong id="concert-count">0</strong> concertos</p>
          </div>

          <div id="concert-grid" class="concert-grid"></div>
          <p id="no-results" class="no-results" hidden>Non hai concertos que coincidan coa busca.</p>
        </div>

        <section id="attendance-report" class="attendance-report" hidden>
          <header class="report-heading">
            <div>
              <span>Participación da Coral</span>
              <h2>Informe de asistencia</h2>
              <p>Clasificación por número de concertos, corda e orde alfabética.</p>
            </div>
            <strong id="report-summary"></strong>
          </header>
          <div id="report-content" class="report-content"></div>
          <p id="report-empty" class="no-results" hidden>Non hai datos de asistencia dispoñibles.</p>
        </section>
      </section>
    </main>
  </div>

  <dialog id="concert-dialog" class="concert-dialog" aria-labelledby="detail-title">
    <button id="dialog-close" type="button" class="dialog-close" aria-label="Pechar">×</button>
    <div class="detail-grid">
      <div>
        <span id="detail-state" class="detail-state"></span>
        <time id="detail-date"></time>
        <h2 id="detail-title"></h2>
        <p id="detail-location" class="detail-location"></p>
        <p id="detail-description" class="detail-description"></p>
      </div>
      <figure id="detail-poster-wrap" class="detail-poster-wrap" hidden>
        <img id="detail-poster" src="" alt="" />
      </figure>
    </div>
    <section class="program-section">
      <header>
        <span>Programa</span>
        <strong id="program-count"></strong>
      </header>
      <ol id="program-list" class="program-list"></ol>
      <p id="program-empty" class="program-empty" hidden>O programa deste concerto aínda non está incorporado.</p>
    </section>

    <details class="attendees-section">
      <summary><span>Asistentes</span><strong id="attendees-count"></strong></summary>
      <div id="attendees-groups" class="attendees-groups"></div>
      <p id="attendees-empty" class="attendees-empty" hidden>Non hai asistentes rexistrados para este concerto.</p>
    </details>
  </dialog>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const URL_CONCERTOS = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSX8BEJ-hrubqEtaZ1zZaLSy7LoxaDQOuQuqR2ior7TZErtBGL5bJG0B_AK5Dp8eFeTDb3Pmpqh7Hnu/pub?gid=1098509641&single=true&output=csv';
  const URL_PROGRAMAS = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTMm4Z45Bcfz_-AEwcA6lNmttLAjJEOxXpTFmlnLwtRCoSIF7xlCP-LEdlfLoMYkbOnAefC7I9G9Cec/pub?gid=1925601694&single=true&output=csv';
  const URL_REPERTORIO = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSuYtrIlKLbU1QkH7fP2zbKQQYFV6kvACLLFBZrJ7cC8t54jAsrTDWvL_x7fko9Hw71oKIoYyBcjNF3/pub?gid=984049442&single=true&output=csv';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const loading = document.querySelector('#loading');
  const app = document.querySelector('#concertos-app');
  const errorState = document.querySelector('#error-state');
  const errorMessage = document.querySelector('#error-message');
  const retryButton = document.querySelector('#retry-button');
  const userEmail = document.querySelector('#user-email');
  const logout = document.querySelector('#concertos-logout');
  const search = document.querySelector('#concert-search');
  const grid = document.querySelector('#concert-grid');
  const count = document.querySelector('#concert-count');
  const noResults = document.querySelector('#no-results');
  const filters = document.querySelector('.filters');
  const dialog = document.querySelector('#concert-dialog');
  const dialogClose = document.querySelector('#dialog-close');
  const viewSwitch = document.querySelector('.view-switch');
  const concertsView = document.querySelector('#concerts-view');
  const attendanceReport = document.querySelector('#attendance-report');
  const reportContent = document.querySelector('#report-content');
  const reportSummary = document.querySelector('#report-summary');
  const reportEmpty = document.querySelector('#report-empty');

  let concertos = [];
  let filtroActivo = 'todos';

  const normalizar = (valor = '') => String(valor)
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();

  const corrixir = (valor = '') => String(valor)
    .replaceAll('Liceo Casinto', 'Liceo Casino')
    .replaceAll('Real Acadademia', 'Real Academia')
    .replace(/\s+/g, ' ').trim();

  const escapar = (valor = '') => corrixir(valor)
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

  function parseCSV(texto) {
    const filas = [];
    let fila = [], campo = '', entreComillas = false;
    for (let i = 0; i < texto.length; i++) {
      const c = texto[i], seguinte = texto[i + 1];
      if (c === '"' && entreComillas && seguinte === '"') { campo += '"'; i++; }
      else if (c === '"') entreComillas = !entreComillas;
      else if (c === ',' && !entreComillas) { fila.push(campo); campo = ''; }
      else if ((c === '\n' || c === '\r') && !entreComillas) {
        if (c === '\r' && seguinte === '\n') i++;
        fila.push(campo);
        if (fila.some((v) => v.trim() !== '')) filas.push(fila);
        fila = []; campo = '';
      } else campo += c;
    }
    if (campo || fila.length) { fila.push(campo); filas.push(fila); }
    const cabeceiras = (filas.shift() || []).map(normalizar);
    return filas.map((valores) => Object.fromEntries(cabeceiras.map((cab, i) => [cab, (valores[i] || '').trim()])));
  }

  const valor = (fila, ...nomes) => {
    for (const nome of nomes) {
      const atopado = fila[normalizar(nome)];
      if (atopado !== undefined && atopado !== '') return atopado;
    }
    return '';
  };

  const dataISO = (data) => {
    const p = String(data).split(/[\/-]/).map(Number);
    if (p.length !== 3 || p.some(Number.isNaN)) return String(data);
    if (p[0] > 31) return `${p[0]}-${String(p[1]).padStart(2, '0')}-${String(p[2]).padStart(2, '0')}`;
    return `${p[2]}-${String(p[1]).padStart(2, '0')}-${String(p[0]).padStart(2, '0')}`;
  };

  const partesData = (data) => {
    const d = new Date(`${dataISO(data)}T12:00:00`);
    if (Number.isNaN(d.getTime())) return { dia: data, mes: '', ano: '' };
    const meses = ['XAN','FEB','MAR','ABR','MAI','XUÑ','XUL','AGO','SET','OUT','NOV','DEC'];
    return { dia: String(d.getDate()).padStart(2, '0'), mes: meses[d.getMonth()], ano: String(d.getFullYear()) };
  };

  const dataLonga = (data) => {
    const d = new Date(`${dataISO(data)}T12:00:00`);
    if (Number.isNaN(d.getTime())) return data;
    return new Intl.DateTimeFormat('gl-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
  };

  const horaLocal = (hora = '') => String(hora).trim().replace(/^(\d{1,2}:\d{2}):\d{2}$/, '$1');

  const cartelPublico = (ruta = '') => {
    const nome = String(ruta).replaceAll('\\', '/').split('/').filter(Boolean).pop();
    if (!nome) return '';
    const limpo = nome.replace(/\.pdf$/i, '.jpg');
    return `/img/concertos/${encodeURIComponent(limpo)}`;
  };

  async function lerCSV(url) {
    const response = await fetch(url, { cache: 'no-store' });
    if (!response.ok) throw new Error(`Erro ${response.status}`);
    return parseCSV(await response.text());
  }

  async function solicitarAsistencias() {
    const user = auth.currentUser;
    if (!user?.email) return { asistenciasPorConcerto: {} };
    const idToken = await user.getIdToken(true);
    const response = await fetch('/api/repertorio', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion: 'listarAsistenciasConcertosPortal' })
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || 'Non foi posible consultar as asistencias.');
    return result;
  }

  async function aceptacionVixente(user) {
    const idToken = await user.getIdToken(true);
    const response = await fetch('/api/aceptacion', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion: 'comprobarAceptacion', version: 'PRIVACIDADE-WEB-1.0' })
    });
    const result = await response.json().catch(() => null);
    return response.ok && result?.ok && result.aceptacionVixente === true;
  }

  function etiquetaEstado(concerto) {
    if (concerto.estado === 'realizado') return 'Arquivo';
    if (concerto.estado === 'aprazado' || concerto.estado === 'aplazado') return 'Aprazado';
    return 'Próximo concerto';
  }

  function debuxarTarxetas() {
    if (!(grid instanceof HTMLElement)) return;
    const busca = normalizar(search instanceof HTMLInputElement ? search.value : '');
    const filtrados = concertos.filter((concerto) => {
      const coincideFiltro = filtroActivo === 'todos'
        || (filtroActivo === 'proximos' && concerto.estado !== 'realizado')
        || (filtroActivo === 'arquivo' && concerto.estado === 'realizado');
      const coincideBusca = normalizar([concerto.nome, concerto.cidade, concerto.lugar, concerto.data].join(' ')).includes(busca);
      return coincideFiltro && coincideBusca;
    });
    if (count instanceof HTMLElement) count.textContent = String(filtrados.length);
    if (noResults instanceof HTMLElement) noResults.hidden = filtrados.length > 0;
    grid.innerHTML = filtrados.map((concerto) => {
      const data = partesData(concerto.data);
      const lugar = [concerto.lugar, concerto.cidade].filter(Boolean).join(' · ');
      return `<button type="button" class="concert-square ${concerto.estado === 'realizado' ? 'is-past' : ''}" data-id="${escapar(concerto.id)}">
        <span class="square-top"><span class="square-state">${escapar(etiquetaEstado(concerto))}</span><span class="square-year">${escapar(data.ano)}</span></span>
        <span class="square-date"><strong>${escapar(data.dia)}</strong><span>${escapar(data.mes)}</span></span>
        <span class="square-copy"><strong>${escapar(concerto.nome)}</strong><span>${escapar(lugar)}</span></span>
        <span class="square-bottom"><span>${concerto.programa.length} obra${concerto.programa.length === 1 ? '' : 's'}</span><span aria-hidden="true">→</span></span>
      </button>`;
    }).join('');
  }

  function debuxarInforme() {
    if (!(reportContent instanceof HTMLElement)) return;

    const persoas = new Map();
    concertos.forEach((concerto) => {
      (concerto.asistentes || []).forEach((asistente) => {
        const nome = String(asistente.nome || '').trim();
        const voz = String(asistente.voz || 'Sen voz indicada').trim();
        if (!nome) return;
        const clave = `${voz}|${nome}`;
        if (!persoas.has(clave)) persoas.set(clave, { nome, voz, concertos: [] });
        const persoa = persoas.get(clave);
        if (!persoa.concertos.some((item) => item.id === concerto.id)) {
          persoa.concertos.push({ id: concerto.id, data: concerto.data, nome: concerto.nome });
        }
      });
    });

    const listado = Array.from(persoas.values());
    listado.forEach((persoa) => persoa.concertos.sort((a, b) => dataISO(b.data).localeCompare(dataISO(a.data))));
    const totais = [...new Set(listado.map((persoa) => persoa.concertos.length))].sort((a, b) => b - a);
    const ordeVoces = ['Soprano', 'Contralto', 'Tenor', 'Baixo'];

    reportContent.innerHTML = totais.map((total) => {
      const persoasTotal = listado.filter((persoa) => persoa.concertos.length === total);
      const voces = [...new Set(persoasTotal.map((persoa) => persoa.voz))].sort((a, b) => {
        const ia = ordeVoces.indexOf(a), ib = ordeVoces.indexOf(b);
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b, 'gl');
      });
      return `<section class="attendance-tier">
        <header><strong>${total} concerto${total === 1 ? '' : 's'}</strong><span>${persoasTotal.length} persoa${persoasTotal.length === 1 ? '' : 's'}</span></header>
        <div class="report-voices">${voces.map((voz) => {
          const persoasVoz = persoasTotal.filter((persoa) => persoa.voz === voz)
            .sort((a, b) => a.nome.localeCompare(b.nome, 'gl', { sensitivity: 'base' }));
          return `<section class="report-voice">
            <h3>${escapar(voz)} <span>${persoasVoz.length}</span></h3>
            <div>${persoasVoz.map((persoa) => `<article class="person-report">
              <header><strong>${escapar(persoa.nome)}</strong><span>${persoa.concertos.length}</span></header>
              <ul>${persoa.concertos.map((concerto) => `<li><a href="/portal/concertos/?id=${encodeURIComponent(concerto.id)}"><time>${escapar(concerto.data)}</time><span>${escapar(concerto.nome)}</span></a></li>`).join('')}</ul>
            </article>`).join('')}</div>
          </section>`;
        }).join('')}</div>
      </section>`;
    }).join('');

    if (reportSummary instanceof HTMLElement) {
      const totalAsistencias = listado.reduce((suma, persoa) => suma + persoa.concertos.length, 0);
      reportSummary.textContent = `${listado.length} persoas · ${totalAsistencias} asistencias`;
    }
    if (reportEmpty instanceof HTMLElement) reportEmpty.hidden = listado.length > 0;
  }

  function abrirConcerto(concerto) {
    if (!(dialog instanceof HTMLDialogElement)) return;
    const set = (selector, value) => {
      const element = dialog.querySelector(selector);
      if (element instanceof HTMLElement) element.textContent = value || '';
    };
    set('#detail-state', etiquetaEstado(concerto));
    const time = dialog.querySelector('#detail-date');
    if (time instanceof HTMLTimeElement) { time.textContent = dataLonga(concerto.data); time.dateTime = dataISO(concerto.data); }
    set('#detail-title', concerto.nome);
    const info = [concerto.hora && `${horaLocal(concerto.hora)} h`, concerto.lugar, concerto.cidade].filter(Boolean).join(' · ');
    set('#detail-location', info);
    set('#detail-description', concerto.caracteristicas);
    set('#program-count', concerto.programa.length ? `${concerto.programa.length} obras` : '');
    const list = dialog.querySelector('#program-list');
    const empty = dialog.querySelector('#program-empty');
    if (list instanceof HTMLOListElement) {
      list.innerHTML = concerto.programa.map((item) => `<li>
        <span class="program-order">${String(item.orde).padStart(2, '0')}</span>
        <a class="program-work" href="/portal/repertorio/?id=${encodeURIComponent(item.id)}" aria-label="Abrir ${escapar(item.obra)} no repertorio">
          <strong>${escapar(item.obra)}</strong><span>${escapar(item.autor)}</span>${item.solista ? `<small>${escapar(item.solista)}</small>` : ''}
        </a>
      </li>`).join('');
    }
    if (empty instanceof HTMLElement) empty.hidden = concerto.programa.length > 0;

    const asistentes = Array.isArray(concerto.asistentes) ? concerto.asistentes : [];
    set('#attendees-count', asistentes.length ? `${asistentes.length} persoas` : '0 persoas');
    const groups = dialog.querySelector('#attendees-groups');
    const attendeesEmpty = dialog.querySelector('#attendees-empty');
    if (groups instanceof HTMLElement) {
      const orde = ['Soprano', 'Contralto', 'Tenor', 'Baixo'];
      const porVoz = asistentes.reduce((acc, persoa) => {
        const voz = persoa.voz || 'Sen voz indicada';
        if (!acc[voz]) acc[voz] = [];
        acc[voz].push(persoa.nome);
        return acc;
      }, {});
      const voces = Object.keys(porVoz).sort((a, b) => {
        const ia = orde.indexOf(a), ib = orde.indexOf(b);
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b, 'gl');
      });
      groups.innerHTML = voces.map((voz) => `<section class="voice-group">
        <h3>${escapar(voz)} <span>${porVoz[voz].length}</span></h3>
        <ul>${porVoz[voz].map((nome) => `<li>${escapar(nome)}</li>`).join('')}</ul>
      </section>`).join('');
    }
    if (attendeesEmpty instanceof HTMLElement) attendeesEmpty.hidden = asistentes.length > 0;

    const posterWrap = dialog.querySelector('#detail-poster-wrap');
    const poster = dialog.querySelector('#detail-poster');
    const posterUrl = cartelPublico(concerto.cartel);
    if (posterWrap instanceof HTMLElement && poster instanceof HTMLImageElement) {
      posterWrap.hidden = !posterUrl;
      poster.src = posterUrl;
      poster.alt = posterUrl ? `Cartel de ${concerto.nome}` : '';
      poster.onerror = () => { posterWrap.hidden = true; };
    }
    dialog.showModal();
  }

  async function cargar() {
    if (loading instanceof HTMLElement) loading.hidden = false;
    if (app instanceof HTMLElement) app.hidden = true;
    if (errorState instanceof HTMLElement) errorState.hidden = true;
    try {
      const [concertosRaw, programasRaw, repertorioRaw, asistenciasResult] = await Promise.all([
        lerCSV(URL_CONCERTOS),
        lerCSV(URL_PROGRAMAS),
        lerCSV(URL_REPERTORIO),
        solicitarAsistencias().catch(() => ({ asistenciasPorConcerto: {} }))
      ]);
      const asistenciasPorConcerto = asistenciasResult.asistenciasPorConcerto || {};
      const obras = new Map(repertorioRaw.map((fila) => [valor(fila, 'Id', 'Row ID'), {
        nome: valor(fila, 'NomeObra', 'Nome', 'Obra'),
        autor: valor(fila, 'Compositor', 'Autor')
      }]));
      concertos = concertosRaw.map((fila) => {
        const id = valor(fila, 'Id', 'Row ID');
        const programa = programasRaw.filter((p) => valor(p, 'Id_Conciertos', 'Id_Concertos') === id)
          .map((p) => {
            const obra = obras.get(valor(p, 'Id_Obras')) || {};
            return {
              id: valor(p, 'Id_Obras'),
              orde: Number(valor(p, 'Orde')) || 999,
              obra: obra.nome || valor(p, 'Id_Obras'),
              autor: obra.autor || '',
              solista: valor(p, 'Solista')
            };
          }).sort((a, b) => a.orde - b.orde);
        return {
          id,
          data: valor(fila, 'Data'),
          nome: corrixir(valor(fila, 'Nome')),
          cidade: valor(fila, 'Cidade'),
          lugar: valor(fila, 'Lugar'),
          caracteristicas: corrixir(valor(fila, 'Características', 'Caracteristicas')),
          cartel: valor(fila, 'Cartel'),
          hora: valor(fila, 'Hora'),
          estado: normalizar(valor(fila, 'Estado')) || 'confirmado',
          programa,
          asistentes: Array.isArray(asistenciasPorConcerto[id])
            ? asistenciasPorConcerto[id]
            : []
        };
      }).filter((c) => c.id && c.data && c.nome)
        .sort((a, b) => dataISO(b.data).localeCompare(dataISO(a.data)));
      debuxarTarxetas();
      debuxarInforme();
      if (app instanceof HTMLElement) app.hidden = false;
      const requested = new URLSearchParams(window.location.search).get('id');
      const concerto = requested && concertos.find((c) => c.id === requested);
      if (concerto) abrirConcerto(concerto);
    } catch (error) {
      if (errorMessage instanceof HTMLElement) errorMessage.textContent = error instanceof Error ? error.message : 'Erro descoñecido.';
      if (errorState instanceof HTMLElement) errorState.hidden = false;
    } finally {
      if (loading instanceof HTMLElement) loading.hidden = true;
    }
  }

  onAuthStateChanged(auth, async (user) => {
    if (!user?.email) { window.location.replace('/portal/'); return; }
    try {
      if (!(await aceptacionVixente(user))) { window.location.replace('/portal/'); return; }
      if (userEmail instanceof HTMLElement) userEmail.textContent = user.email;
      await cargar();
    } catch {
      window.location.replace('/portal/');
    }
  });

  viewSwitch?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.view) return;
    const informe = target.dataset.view === 'asistencia';
    viewSwitch.querySelectorAll('button').forEach((button) => button.classList.toggle('is-active', button === target));
    if (concertsView instanceof HTMLElement) concertsView.hidden = informe;
    if (attendanceReport instanceof HTMLElement) attendanceReport.hidden = !informe;
  });

  grid?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest('button[data-id]');
    const concerto = concertos.find((item) => item.id === button?.getAttribute('data-id'));
    if (concerto) abrirConcerto(concerto);
  });
  filters?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.filter) return;
    filtroActivo = target.dataset.filter;
    filters.querySelectorAll('button').forEach((button) => button.classList.toggle('is-active', button === target));
    debuxarTarxetas();
  });
  search?.addEventListener('input', debuxarTarxetas);
  retryButton?.addEventListener('click', cargar);
  dialogClose?.addEventListener('click', () => dialog instanceof HTMLDialogElement && dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
  logout?.addEventListener('click', async () => { await signOut(auth); window.location.href = '/portal/'; });
</script>

