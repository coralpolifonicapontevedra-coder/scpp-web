---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Ensaios V2" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="ensaios" logoutId="ensaios-v2-logout" />
    <main class="private-main">
      <header class="page-header">
        <div>
          <span class="kicker">Portal do Coralista</span>
          <h1>Ensaios</h1>
          <p>Preparación do próximo ensaio. O traballo permanece en R2 ata finalizar o ensaio.</p>
        </div>
        <div class="storage"><small>Almacenamento de traballo</small><strong>R2 privado</strong></div>
      </header>

      <section id="loading" class="state-card">Cargando os ensaios…</section>
      <section id="error" class="state-card error" hidden></section>

      <section id="app" class="app" hidden>
        <section class="selector-card">
          <label for="ensaio-select">Ensaio</label>
          <select id="ensaio-select"></select>
          <nav class="module-nav only-board" aria-label="Seccións de ensaios">
            <button id="open-works" class="secondary is-current" type="button">Obras a ensaiar</button>
            <button id="open-attendance" class="secondary" type="button">Lista de asistentes</button>
            <button id="open-analysis" class="secondary" type="button">Análise de asistencias</button>
          </nav>
        </section>

        <article id="ensaio-resumo" class="summary-card"></article>

        <section id="works-panel" class="panel">
          <header class="section-heading">
            <div><span class="kicker">Preparación musical</span><h2>Obras a ensaiar</h2></div>
            <strong id="works-summary"></strong>
          </header>

          <div class="works-toolbar only-board">
            <button id="load-program" type="button" class="secondary">Cargar desde programa</button>
            <div class="work-search-box">
              <input id="work-search" type="search" placeholder="Buscar obra ou compositor…" autocomplete="off" />
              <button id="work-search-btn" type="button" class="search-button" aria-label="Buscar obra" title="Buscar obra">⌕</button>
            </div>
            <select id="work-select"><option value="">Escolle unha obra…</option></select>
            <button id="add-work" type="button" class="primary">Engadir obra</button>
          </div>
          <p id="work-search-result" class="search-result only-board"></p>
          <p id="works-status" class="status"></p>
          <div id="works-list" class="works-grid"></div>
        </section>

        <section id="attendance-panel" class="panel only-board" hidden>
          <header class="section-heading panel-heading">
            <div><span class="kicker">Control de asistencia</span><h2>Lista de asistentes</h2><p>En «Todos» móstranse só os asistentes. Por corda realízase o control.</p></div>
            <button class="secondary back-works" type="button">Volver ás obras</button>
          </header>
          <div class="attendance-toolbar">
            <div class="voice-tabs" aria-label="Filtrar por corda">
              <button type="button" class="is-active" data-voice="Todos">Todos</button>
              <button type="button" data-voice="Soprano">Sopranos</button>
              <button type="button" data-voice="Contralto">Contraltos</button>
              <button type="button" data-voice="Tenor">Tenores</button>
              <button type="button" data-voice="Baixo">Baixos</button>
            </div>
            <input id="people-search" type="search" placeholder="Buscar coralista…" autocomplete="off" />
          </div>
          <div class="attendance-overview">
            <span><strong id="count-present">0</strong> asisten</span>
            <span><strong id="count-absent">0</strong> non asisten</span>
            <span><strong id="count-justified">0</strong> xustificadas</span>
          </div>
          <div id="attendance-list" class="attendance-list"></div>
        </section>

        <section id="analysis-panel" class="panel only-board" hidden>
          <header class="section-heading panel-heading">
            <div><span class="kicker">Seguimento</span><h2>Análise de asistencias</h2><p>Consulta por período, persoa, corda ou conxunto da coral.</p></div>
            <button class="secondary back-works" type="button">Volver ás obras</button>
          </header>

          <div class="analysis-filters">
            <label><span>Desde</span><input id="analysis-from" type="date" /></label>
            <label><span>Ata</span><input id="analysis-to" type="date" /></label>
            <label><span>Consulta</span><select id="analysis-scope"><option value="general">Xeral</option><option value="voice">Por corda</option><option value="person">Por persoa</option></select></label>
            <label id="analysis-voice-wrap" hidden><span>Corda</span><select id="analysis-voice"><option value="Soprano">Sopranos</option><option value="Contralto">Contraltos</option><option value="Tenor">Tenores</option><option value="Baixo">Baixos</option></select></label>
            <label id="analysis-person-wrap" hidden><span>Coralista</span><select id="analysis-person"></select></label>
            <button id="run-analysis" type="button" class="primary">Consultar</button>
          </div>

          <div id="analysis-summary" class="analysis-summary"></div>
          <section class="analysis-block"><h3>Relación por ensaios</h3><div id="analysis-by-rehearsal" class="analysis-results"></div></section>
          <section class="analysis-block"><h3>Ranking de asistencias</h3><div id="analysis-ranking" class="analysis-results"></div></section>
        </section>

        <p id="finalize-status" class="status only-board"></p>
        <div class="finalize-zone only-board"><button id="finalize" class="primary" type="button">Finalizar ensaio</button></div>
      </section>

      <dialog id="absence-dialog">
        <form id="absence-form">
          <header><h2>Aviso de non asistencia</h2><button id="close-absence" type="button" aria-label="Pechar">×</button></header>
          <p>Este aviso corresponde unicamente á túa asistencia ao ensaio seleccionado.</p>
          <div class="absence-options">
            <button id="absence-simple" type="button" class="secondary">Non asistirei</button>
            <button id="absence-justified" type="button" class="secondary">Non asistirei con xustificación</button>
          </div>
          <label id="absence-reason-wrap" hidden><span>Motivo da xustificación</span><textarea id="absence-reason" rows="3" maxlength="240"></textarea></label>
          <p id="absence-status" class="status"></p>
          <footer><button id="cancel-absence" type="button" class="secondary">Cancelar</button><button id="send-absence" type="submit" class="primary">Enviar aviso</button></footer>
        </form>
      </dialog>

      <dialog id="program-dialog">
        <form id="program-form">
          <header><h2>Cargar desde programa</h2><button id="close-program" type="button" aria-label="Pechar">×</button></header>
          <label><span>Concerto</span><select id="program-select"></select></label>
          <p id="program-status" class="status"></p>
          <footer><button id="cancel-program" type="button" class="secondary">Cancelar</button><button type="submit" class="primary">Incluír programa</button></footer>
        </form>
      </dialog>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp,getApps,initializeApp } from 'firebase/app';
  import { getAuth,onAuthStateChanged } from 'firebase/auth';

  const firebaseConfig={apiKey:'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',authDomain:'scpp-portal-privado.firebaseapp.com',projectId:'scpp-portal-privado',storageBucket:'scpp-portal-privado.firebasestorage.app',messagingSenderId:'506857659587',appId:'1:506857659587:web:a7ed36b22f044f5f639676'};
  const auth=getAuth(getApps().length?getApp():initializeApp(firebaseConfig));
  const $=(s)=>document.querySelector(s);
  const esc=(v='')=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const norm=(v='')=>String(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
  const truthy=(v)=>v===true||['true','1','si','sí','yes','x'].includes(norm(v));
  const rid=(r)=>String(r?.idEnsaio||r?.id||'').trim(),pid=(p)=>String(p?.idPersoa||p?.id||'').trim(),wid=(w)=>String(w?.idRepertorio||w?.id||'').trim();
  const first=(p)=>String(p?.nome||'').trim(),s1=(p)=>String(p?.primeiroApelido||'').trim(),s2=(p)=>String(p?.segundoApelido||'').trim();
  const displayName=(p)=>[s1(p),s2(p),first(p)].filter(Boolean).join(' ')||String(p?.nomeCompleto||'').trim();
  const sortPeople=(a,b)=>[s1(a),s2(a),first(a)].map(norm).join('|').localeCompare([s1(b),s2(b),first(b)].map(norm).join('|'),'gl',{sensitivity:'base',numeric:true});
  const VOICES=['Soprano','Contralto','Tenor','Baixo'];
  const voiceLabel=(v)=>({Soprano:'Sopranos',Contralto:'Contraltos',Tenor:'Tenores',Baixo:'Baixos'}[v]||v);
  const toDate=(v='')=>{const t=String(v).trim();if(!t)return null;const iso=/^\d{4}-\d{2}-\d{2}/.test(t)?t.slice(0,10):t.split(/[\/-]/).reverse().join('-');const d=new Date(`${iso}T12:00:00`);return Number.isNaN(d.getTime())?null:d;};
  const fmtDate=(v)=>{const d=toDate(v);return d?new Intl.DateTimeFormat('gl-ES',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d):String(v||'');};
  const fmtLongDate=(v)=>{const d=toDate(v);return d?new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d):String(v||'');};
  const fmtTime=(v='')=>String(v).trim().replace(/^(\d{1,2}:\d{2}):\d{2}$/,'$1');

  let payload=null,selected=null,draft=null,board=false,voice='Todos',loadSeq=0,absenceKind='non';

  async function call(url,accion,extra={}){const user=auth.currentUser;if(!user)throw new Error('A sesión non está dispoñible.');const idToken=await user.getIdToken();const response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const result=await response.json().catch(()=>null);if(!response.ok||!result?.ok)throw new Error(result?.erro||`Erro ${response.status}`);return result;}
  const apiMain=(accion,extra={})=>call('/api/ensaios',accion,extra),apiDraft=(accion,extra={})=>call('/api/ensaios-borrador',accion,{idEnsaio:rid(selected),...extra});

  function rehearsals(){const today=new Date();today.setHours(0,0,0,0);const map=new Map();(payload?.ensaios||[]).forEach((r)=>{const id=rid(r);if(id&&!map.has(id))map.set(id,r);});return[...map.values()].filter((r)=>!truthy(r.cancelado)&&(!toDate(r.data)||toDate(r.data)>=today)).sort((a,b)=>(toDate(a.data)?.getTime()||0)-(toDate(b.data)?.getTime()||0));}
  function renderSelector(){const rows=rehearsals();if(!selected)selected=rows[0]||null;$('#ensaio-select').innerHTML=rows.map((r)=>`<option value="${esc(rid(r))}">${esc(fmtLongDate(r.data))}</option>`).join('');if(selected)$('#ensaio-select').value=rid(selected);}
  function renderSummary(){const box=$('#ensaio-resumo');if(!selected){box.innerHTML='<p>Non hai próximos ensaios.</p>';return;}const horario=[fmtTime(selected.horaInicio),selected.horaFin?fmtTime(selected.horaFin):''].filter(Boolean).join(' – ');box.innerHTML=`<div><span class="summary-label">Ensaio seleccionado</span><h2>${esc(fmtLongDate(selected.data))}</h2></div><div class="summary-meta">${selected.tipoEnsaio?`<span>${esc(selected.tipoEnsaio)}</span>`:''}${horario?`<span>${esc(horario)}</span>`:''}<button id="open-absence" type="button" class="secondary">Aviso de non asistencia</button></div>`;$('#open-absence')?.addEventListener('click',openAbsenceDialog);}

  function attendanceMap(){return new Map((draft?.asistencias||[]).map((a)=>[String(a.persoa||a.idPersoa||''),a]));}
  function kind(a={}){const s=norm(a.estadoAsistencia);if(s==='asiste')return'asiste';if(s==='non asiste'&&truthy(a.xustificada))return'xustificada';if(s==='non asiste')return'non';return'';}
  function updateCounts(){if(!draft||!board)return;const map=attendanceMap();let p=0,n=0,j=0;(payload?.persoas||[]).forEach((x)=>{const k=kind(map.get(pid(x)));if(k==='asiste')p++;else if(k==='xustificada')j++;else if(k==='non')n++;});$('#count-present').textContent=String(p);$('#count-absent').textContent=String(n);$('#count-justified').textContent=String(j);}
  function renderControlRow(p){const id=pid(p),a=attendanceMap().get(id)||{},k=kind(a);return `<article class="person-row" data-person="${esc(id)}"><strong>${esc(displayName(p))}</strong><div class="attendance-buttons"><button type="button" data-kind="asiste" class="${k==='asiste'?'selected':''}">Asiste</button><button type="button" data-kind="non" class="${k==='non'?'selected':''}">Non asiste</button><button type="button" data-kind="xustificada" class="${k==='xustificada'?'selected':''}">Non asiste con xustificación</button></div>${k==='xustificada'?`<label class="reason"><span>Motivo da xustificación</span><input type="text" data-reason maxlength="240" value="${esc(a.motivo||'')}" placeholder="Indica o motivo…" /></label>`:''}<span class="row-status"></span></article>`;}
  function renderAttendance(){if(!board||!draft)return;const q=norm($('#people-search')?.value||''),map=attendanceMap(),people=(payload?.persoas||[]).filter((p)=>!q||norm(displayName(p)).includes(q)),list=$('#attendance-list');if(voice==='Todos'){list.innerHTML=VOICES.map((v)=>{const rows=people.filter((p)=>norm(p.voz)===norm(v)&&kind(map.get(pid(p)))==='asiste').sort(sortPeople);return `<section class="voice-group"><header><h3>${voiceLabel(v)}</h3><strong>${rows.length}</strong></header><div class="attendee-names">${rows.map((p)=>`<span>${esc(displayName(p))}</span>`).join('')||'<p class="empty">Sen asistentes rexistrados.</p>'}</div></section>`;}).join('');}else{const rows=people.filter((p)=>norm(p.voz)===norm(voice)).sort(sortPeople);list.innerHTML=`<section class="voice-group"><header><h3>${voiceLabel(voice)}</h3><strong>${rows.length}</strong></header><div class="voice-people">${rows.map(renderControlRow).join('')||'<p class="empty">Sen coralistas.</p>'}</div></section>`;}updateCounts();}
  async function saveAttendance(id,k,motivo){const map=attendanceMap(),current=map.get(id)||{},values=k==='asiste'?{estadoAsistencia:'Asiste',xustificada:false,motivo:''}:k==='xustificada'?{estadoAsistencia:'Non asiste',xustificada:true,motivo:String(motivo??current.motivo??'')}:{estadoAsistencia:'Non asiste',xustificada:false,motivo:''};const previous=structuredClone(draft);map.set(id,{...current,ensaio:rid(selected),persoa:id,...values});draft={...draft,asistencias:[...map.values()]};renderAttendance();try{const out=await apiDraft('gardarAsistencia',{idPersoa:id,...values,observacions:String(current.observacions||'')});draft=out.draft;renderAttendance();}catch(e){draft=previous;renderAttendance();}}

  function workById(id){return(payload?.repertorio||[]).find((w)=>wid(w)===String(id||''))||null;}function works(){return Array.isArray(draft?.repertorio)?draft.repertorio:[];}
  function filteredWorks(){const q=norm($('#work-search')?.value||''),used=new Set(works().map((r)=>String(r.repertorio||r.idRepertorio||'')));return(payload?.repertorio||[]).filter((w)=>!used.has(wid(w))&&(!q||norm([w.nomeObra,w.nome,w.compositor].join(' ')).includes(q))).sort((a,b)=>String(a.nomeObra||a.nome||'').localeCompare(String(b.nomeObra||b.nome||''),'gl',{sensitivity:'base'})).slice(0,100);}
  function renderWorkPicker(selectFirst=false){if(!board)return;const rows=filteredWorks();$('#work-select').innerHTML='<option value="">Escolle unha obra…</option>'+rows.map((w)=>`<option value="${esc(wid(w))}">${esc([w.nomeObra||w.nome,w.compositor].filter(Boolean).join(' — '))}</option>`).join('');const q=String($('#work-search')?.value||'').trim();$('#work-search-result').textContent=q?`${rows.length} resultado${rows.length===1?'':'s'} para «${q}»`:'';if(selectFirst&&rows.length)$('#work-select').value=wid(rows[0]);}
  function renderWorks(){const list=$('#works-list');if(!draft){$('#works-summary').textContent='Cargando…';list.innerHTML='<p class="empty">Cargando obras do borrador R2…</p>';return;}const rows=[...works()].sort((a,b)=>Number(a.orde||999)-Number(b.orde||999));$('#works-summary').textContent=`${rows.length} obras`;list.innerHTML=rows.map((r,i)=>{const id=String(r.repertorio||r.idRepertorio||''),w=workById(id)||{};return `<article class="work-card" data-work="${esc(id)}"><header><span class="work-number">${i+1}</span><div><a class="work-title" href="/portal/repertorio/?id=${encodeURIComponent(id)}">${esc(w.nomeObra||w.nome||id)}</a>${w.compositor?`<small>${esc(w.compositor)}</small>`:''}</div>${board?'<button type="button" class="remove-work" aria-label="Eliminar obra">×</button>':''}</header>${board?`<label><span>Observacións</span><textarea class="work-notes" rows="2">${esc(r.observacions||'')}</textarea></label><footer><span class="work-status"></span><button type="button" class="save-work secondary">Gardar</button></footer>`:(r.observacions?`<p>${esc(r.observacions)}</p>`:'')}</article>`;}).join('')||'<p class="empty">Aínda non hai obras neste ensaio.</p>';renderWorkPicker();}
  async function loadDraft(){if(!selected)return;const n=++loadSeq;draft=null;renderWorks();try{const out=await apiDraft('obter');if(n!==loadSeq)return;draft=out.draft;renderWorks();renderAttendance();}catch(e){if(n!==loadSeq)return;$('#works-status').textContent=`⚠ ${e instanceof Error?e.message:'Non se puido cargar o borrador.'}`;}}

  function historicalRehearsals(){const today=new Date();today.setHours(23,59,59,999);return(payload?.ensaios||[]).filter((e)=>!truthy(e.cancelado)&&toDate(e.data)&&toDate(e.data)<=today).sort((a,b)=>(toDate(a.data)?.getTime()||0)-(toDate(b.data)?.getTime()||0));}
  function fillAnalysisPeople(){const rows=[...(payload?.persoas||[])].sort(sortPeople);$('#analysis-person').innerHTML=rows.map((p)=>`<option value="${esc(pid(p))}">${esc(displayName(p))} · ${esc(voiceLabel(p.voz||''))}</option>`).join('');}
  function attendanceHistoricalMap(){const map=new Map();(payload?.asistencias||[]).forEach((a)=>map.set(`${a.ensaio}|${a.persoa}`,a));return map;}
  function analysisPeople(){const scope=$('#analysis-scope')?.value||'general';if(scope==='person'){const id=$('#analysis-person')?.value||'';return(payload?.persoas||[]).filter((p)=>pid(p)===id);}if(scope==='voice'){const v=$('#analysis-voice')?.value||'';return(payload?.persoas||[]).filter((p)=>norm(p.voz)===norm(v));}return payload?.persoas||[];}
  function runAnalysis(){const from=toDate($('#analysis-from')?.value||''),to=toDate($('#analysis-to')?.value||''),scope=$('#analysis-scope')?.value||'general',people=analysisPeople(),map=attendanceHistoricalMap(),ensaios=historicalRehearsals().filter((e)=>{const d=toDate(e.data);return(!from||d>=from)&&(!to||d<=to);});let present=0,absent=0,justified=0,decided=0;ensaios.forEach((e)=>people.forEach((p)=>{const k=kind(map.get(`${rid(e)}|${pid(p)}`));if(k){decided++;if(k==='asiste')present++;else if(k==='xustificada')justified++;else absent++;}}));const pct=decided?Math.round(present*100/decided):0;$('#analysis-summary').innerHTML=`<div><strong>${ensaios.length}</strong><span>ensaios</span></div><div><strong>${present}</strong><span>asistencias</span></div><div><strong>${absent+justified}</strong><span>ausencias</span></div><div><strong>${justified}</strong><span>xustificadas</span></div><div><strong>${pct}%</strong><span>asistencia</span></div>`;
    const rows=ensaios.map((e)=>{let p=0,n=0,j=0,d=0;people.forEach((person)=>{const k=kind(map.get(`${rid(e)}|${pid(person)}`));if(k){d++;if(k==='asiste')p++;else if(k==='xustificada')j++;else n++;}});if(scope==='person'){const person=people[0],a=person?map.get(`${rid(e)}|${pid(person)}`):null,k=kind(a),label=k==='asiste'?'Asiste':k==='xustificada'?'Non asiste con xustificación':k==='non'?'Non asiste':'Sen rexistro';return `<div class="analysis-row person-analysis"><span>${esc(fmtDate(e.data))}</span><span>${esc(label)}</span><span>${esc(a?.motivo||'')}</span></div>`;}return `<div class="analysis-row"><span>${esc(fmtDate(e.data))}</span><span>${p}</span><span>${n}</span><span>${j}</span><span>${d?Math.round(p*100/d):0}%</span></div>`;}).join('');
    $('#analysis-by-rehearsal').innerHTML=scope==='person'?`<div class="analysis-table"><div class="analysis-row head person-analysis"><span>Data</span><span>Estado</span><span>Motivo</span></div>${rows}</div>`:`<div class="analysis-table"><div class="analysis-row head"><span>Data</span><span>Asisten</span><span>Non asisten</span><span>Xustificadas</span><span>%</span></div>${rows}</div>`;
    const ranking=people.map((person)=>{let a=0,n=0,j=0,d=0;ensaios.forEach((e)=>{const k=kind(map.get(`${rid(e)}|${pid(person)}`));if(k){d++;if(k==='asiste')a++;else if(k==='xustificada')j++;else n++;}});return{person,a,n,j,d,pct:d?Math.round(a*100/d):0};}).sort((x,y)=>y.pct-x.pct||y.a-x.a||sortPeople(x.person,y.person));
    $('#analysis-ranking').innerHTML=`<div class="analysis-table ranking-table"><div class="analysis-row head ranking-row"><span>#</span><span>Coralista</span><span>Corda</span><span>Asiste</span><span>Ausencias</span><span>%</span></div>${ranking.map((r,i)=>`<div class="analysis-row ranking-row"><span>${i+1}</span><span>${esc(displayName(r.person))}</span><span>${esc(voiceLabel(r.person.voz||''))}</span><span>${r.a}</span><span>${r.n+r.j}</span><span>${r.pct}%</span></div>`).join('')}</div>`;
  }

  function fillPrograms(){const rows=[...(payload?.concertos||[])].sort((a,b)=>String(a.data||'').localeCompare(String(b.data||'')));$('#program-select').innerHTML='<option value="">Escolle un concerto…</option>'+rows.map((c)=>`<option value="${esc(c.id||'')}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join('');}
  function concertById(id){return(payload?.concertos||[]).find((c)=>String(c.id||'')===String(id||''))||null;}function resolveProgramId(item){if(item?.idRepertorio&&workById(item.idRepertorio))return String(item.idRepertorio);const target=norm(item?.obra||'');if(!target)return'';const exact=(payload?.repertorio||[]).find((w)=>norm(w.nomeObra||w.nome||'')===target);return exact?wid(exact):'';}
  function showPanel(name){$('#works-panel').hidden=name!=='works';$('#attendance-panel').hidden=name!=='attendance';$('#analysis-panel').hidden=name!=='analysis';document.querySelectorAll('.module-nav button').forEach((b)=>b.classList.toggle('is-current',(name==='works'&&b.id==='open-works')||(name==='attendance'&&b.id==='open-attendance')||(name==='analysis'&&b.id==='open-analysis')));window.scrollTo({top:0,behavior:'smooth'});}
  function applyRole(){board=payload?.perfil?.podeEditar===true;document.querySelectorAll('.only-board').forEach((el)=>{if(el instanceof HTMLElement)el.hidden=!board;});showPanel('works');}
  async function load(){try{payload=await apiMain('listarEnsaiosPortal');selected=rehearsals()[0]||null;renderSelector();renderSummary();fillPrograms();fillAnalysisPeople();applyRole();$('#loading').hidden=true;$('#app').hidden=false;await loadDraft();}catch(e){$('#loading').hidden=true;$('#error').hidden=false;$('#error').textContent=e instanceof Error?e.message:'Non foi posible cargar os ensaios.';}}

  function openAbsenceDialog(){const d=$('#absence-dialog');if(d instanceof HTMLDialogElement){absenceKind='non';$('#absence-reason-wrap').hidden=true;$('#absence-reason').value='';$('#absence-status').textContent=board?'O aviso persoal empregarase só para o teu propio rexistro.':' ';d.showModal();}}
  $('#absence-simple')?.addEventListener('click',()=>{absenceKind='non';$('#absence-reason-wrap').hidden=true;});
  $('#absence-justified')?.addEventListener('click',()=>{absenceKind='xustificada';$('#absence-reason-wrap').hidden=false;});
  $('#absence-form')?.addEventListener('submit',(e)=>{e.preventDefault();$('#absence-status').textContent='A interface está preparada; a gravación segura do aviso persoal activarase coa validación de usuario no backend.';});
  const closeAbsence=()=>{const d=$('#absence-dialog');if(d instanceof HTMLDialogElement)d.close();};$('#close-absence')?.addEventListener('click',closeAbsence);$('#cancel-absence')?.addEventListener('click',closeAbsence);

  $('#ensaio-select')?.addEventListener('change',(e)=>{selected=rehearsals().find((r)=>rid(r)===String(e.target?.value||''))||null;renderSummary();void loadDraft();});
  $('#work-search')?.addEventListener('input',()=>renderWorkPicker(false));$('#work-search')?.addEventListener('keydown',(e)=>{if(e.key==='Enter'){e.preventDefault();renderWorkPicker(true);}});$('#work-search-btn')?.addEventListener('click',()=>renderWorkPicker(true));
  $('#people-search')?.addEventListener('input',renderAttendance);$('#open-works')?.addEventListener('click',()=>showPanel('works'));$('#open-attendance')?.addEventListener('click',()=>{voice='Todos';document.querySelectorAll('[data-voice]').forEach((b)=>b.classList.toggle('is-active',b.dataset.voice==='Todos'));renderAttendance();showPanel('attendance');});$('#open-analysis')?.addEventListener('click',()=>{runAnalysis();showPanel('analysis');});document.querySelectorAll('.back-works').forEach((b)=>b.addEventListener('click',()=>showPanel('works')));
  $('#analysis-scope')?.addEventListener('change',(e)=>{const v=e.target?.value||'general';$('#analysis-voice-wrap').hidden=v!=='voice';$('#analysis-person-wrap').hidden=v!=='person';});$('#run-analysis')?.addEventListener('click',runAnalysis);

  document.addEventListener('click',async(e)=>{const t=e.target;if(!(t instanceof HTMLElement))return;const vb=t.closest('[data-voice]');if(vb){voice=vb.dataset.voice||'Todos';document.querySelectorAll('[data-voice]').forEach((b)=>b.classList.toggle('is-active',b===vb));renderAttendance();return;}const ab=t.closest('[data-kind]');if(ab){const row=ab.closest('.person-row');if(!row||!draft||!board||voice==='Todos')return;await saveAttendance(String(row.dataset.person||''),String(ab.dataset.kind||''));return;}const rm=t.closest('.remove-work');if(rm){const row=rm.closest('.work-card'),id=String(row?.dataset.work||'');if(!id||!draft||!board)return;const prev=structuredClone(draft);draft={...draft,repertorio:draft.repertorio.filter((r)=>String(r.repertorio||r.idRepertorio||'')!==id)};renderWorks();try{const out=await apiDraft('eliminarObra',{idRepertorio:id});draft=out.draft;renderWorks();}catch{draft=prev;renderWorks();}return;}const sw=t.closest('.save-work');if(sw){const row=sw.closest('.work-card'),id=String(row?.dataset.work||'');if(!row||!id||!draft||!board)return;const old=works().find((r)=>String(r.repertorio||r.idRepertorio||'')===id)||{};try{const out=await apiDraft('gardarObra',{idRepertorio:id,orde:old.orde||1,tipoTraballo:'',desde:'',ata:'',observacions:row.querySelector('.work-notes')?.value||''});draft=out.draft;renderWorks();}catch{}return;}});
  document.addEventListener('change',async(e)=>{const input=e.target;if(!(input instanceof HTMLInputElement)||!input.matches('[data-reason]')||!board)return;const row=input.closest('.person-row');if(row&&draft)await saveAttendance(String(row.dataset.person||''),'xustificada',input.value);});

  $('#add-work')?.addEventListener('click',async()=>{const id=$('#work-select')?.value||'',st=$('#works-status');if(!id){st.textContent='Escolle unha obra.';return;}try{const out=await apiDraft('gardarObra',{idRepertorio:id,orde:(draft?.repertorio?.length||0)+1,tipoTraballo:'',desde:'',ata:'',observacions:''});draft=out.draft;st.textContent='✓ Obra engadida.';$('#work-search').value='';renderWorks();}catch(e){st.textContent=`⚠ ${e instanceof Error?e.message:'Erro ao engadir'}`;}});
  const programDialog=$('#program-dialog');const closeProgram=()=>{if(programDialog instanceof HTMLDialogElement)programDialog.close();};$('#load-program')?.addEventListener('click',()=>{if(programDialog instanceof HTMLDialogElement)programDialog.showModal();});$('#close-program')?.addEventListener('click',closeProgram);$('#cancel-program')?.addEventListener('click',closeProgram);
  $('#program-form')?.addEventListener('submit',async(e)=>{e.preventDefault();const c=concertById($('#program-select')?.value||''),st=$('#program-status');if(!c){st.textContent='Escolle un concerto.';return;}const used=new Set(works().map((r)=>String(r.repertorio||r.idRepertorio||''))),ids=[...new Set((c.programa||[]).map(resolveProgramId).filter((id)=>id&&!used.has(id)))];if(!ids.length){st.textContent='Non hai obras novas dese programa.';return;}try{const out=await apiDraft('incluírPrograma',{idsRepertorio:ids});draft=out.draft;renderWorks();closeProgram();}catch(err){st.textContent=`⚠ ${err instanceof Error?err.message:'Erro ao cargar programa'}`;}});
  $('#finalize')?.addEventListener('click',async()=>{if(!board||!draft||!selected)return;if(!window.confirm('Finalizar o ensaio e gravar definitivamente asistencia e obras nas Sheets?'))return;const st=$('#finalize-status');try{st.textContent='Gravando resultado definitivo…';const out=await apiDraft('finalizar');draft=out.draft;st.textContent='✓ Ensaio finalizado.';renderWorks();renderAttendance();}catch(e){st.textContent=`⚠ ${e instanceof Error?e.message:'Erro ao finalizar'}`;}});
  onAuthStateChanged(auth,(user)=>{if(!user){window.location.href='/portal/';return;}void load();});
</script>

