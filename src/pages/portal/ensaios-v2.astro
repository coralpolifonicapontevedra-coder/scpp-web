---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Ensaios V2" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="ensaios" logoutId="ensaios-v2-logout" />
    <main class="private-main">
      <header class="page-header">
        <div>
          <span class="kicker">Portal do Coralista</span>
          <h1>Ensaios</h1>
          <p>Preparación do próximo ensaio. O traballo permanece en R2 ata finalizar o ensaio.</p>
        </div>
        <div class="storage"><small>Almacenamento de traballo</small><strong>R2 privado</strong></div>
      </header>

      <section id="loading" class="state-card">Cargando os ensaios…</section>
      <section id="error" class="state-card error" hidden></section>

      <section id="app" class="app" hidden>
        <section class="selector-card">
          <label for="ensaio-select">Ensaio</label>
          <select id="ensaio-select"></select>
          <div class="selector-actions">
            <button id="open-attendance" class="secondary only-board" type="button">Ver lista de asistentes</button>
            <button id="finalize" class="primary only-board" type="button">Finalizar ensaio</button>
          </div>
        </section>

        <article id="ensaio-resumo" class="summary-card"></article>

        <section id="absence-card" class="absence-card only-coralist" hidden>
          <div>
            <span class="kicker">A miña asistencia</span>
            <h2>Avisar dunha ausencia</h2>
            <p>Podes comunicar que non asistirás. Se queres xustificalo, engade o motivo.</p>
          </div>
          <div class="absence-actions">
            <button id="absence-simple" type="button" class="secondary">Non asistirei</button>
            <button id="absence-justify" type="button" class="secondary">Non asistirei e quero xustificalo</button>
          </div>
          <div id="absence-reason-wrap" class="absence-reason" hidden>
            <label for="absence-reason">Motivo da xustificación</label>
            <textarea id="absence-reason" rows="2" maxlength="240" placeholder="Indica o motivo…"></textarea>
            <button id="absence-send" type="button" class="primary">Enviar aviso</button>
          </div>
          <p id="absence-status" class="status"></p>
        </section>

        <section id="works-panel" class="panel">
          <header class="section-heading">
            <div><span class="kicker">Preparación musical</span><h2>Obras a estudar</h2></div>
            <strong id="works-summary"></strong>
          </header>

          <div class="works-toolbar only-board">
            <button id="load-program" type="button" class="secondary">Cargar desde programa</button>
            <input id="work-search" type="search" placeholder="Buscar obra ou compositor…" autocomplete="off" />
            <select id="work-select"><option value="">Escolle unha obra…</option></select>
            <button id="add-work" type="button" class="primary">Engadir obra</button>
          </div>
          <p id="works-status" class="status"></p>
          <div id="works-list" class="works-grid"></div>
        </section>

        <section id="attendance-panel" class="panel only-board" hidden>
          <header class="attendance-header">
            <div>
              <span class="kicker">Control de asistencia</span>
              <h2>Lista de coralistas</h2>
              <p>Selecciona unha corda ou consulta todos os coralistas agrupados por corda.</p>
            </div>
            <button id="close-attendance" type="button" class="secondary">Volver a obras</button>
          </header>

          <div class="attendance-toolbar">
            <div class="voice-tabs" aria-label="Filtrar por corda">
              <button type="button" class="is-active" data-voice="Todos">Todos</button>
              <button type="button" data-voice="Soprano">Sopranos</button>
              <button type="button" data-voice="Contralto">Contraltos</button>
              <button type="button" data-voice="Tenor">Tenores</button>
              <button type="button" data-voice="Baixo">Baixos</button>
            </div>
            <input id="people-search" type="search" placeholder="Buscar coralista…" autocomplete="off" />
          </div>

          <div class="attendance-overview">
            <span><strong id="count-present">0</strong> asisten</span>
            <span><strong id="count-absent">0</strong> non asisten</span>
            <span><strong id="count-justified">0</strong> xustificadas</span>
          </div>
          <div id="attendance-list" class="attendance-list"></div>
        </section>

        <p id="finalize-status" class="status only-board"></p>
      </section>

      <dialog id="program-dialog">
        <form id="program-form">
          <header><h2>Cargar desde programa</h2><button id="close-program" type="button" aria-label="Pechar">×</button></header>
          <label>Concerto<select id="program-select"></select></label>
          <p id="program-status" class="status"></p>
          <footer><button id="cancel-program" type="button" class="secondary">Cancelar</button><button type="submit" class="primary">Incluír programa</button></footer>
        </form>
      </dialog>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged } from 'firebase/auth';

  const firebaseConfig = {
    apiKey:'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain:'scpp-portal-privado.firebaseapp.com',
    projectId:'scpp-portal-privado',
    storageBucket:'scpp-portal-privado.firebasestorage.app',
    messagingSenderId:'506857659587',
    appId:'1:506857659587:web:a7ed36b22f044f5f639676'
  };
  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const $ = (selector) => document.querySelector(selector);
  const esc = (v='') => String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
  const norm = (v='') => String(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
  const truthy = (v) => v === true || ['true','1','si','sí','yes','x'].includes(norm(v));
  const rid = (r) => String(r?.idEnsaio || r?.id || '').trim();
  const pid = (p) => String(p?.idPersoa || p?.id || '').trim();
  const wid = (w) => String(w?.idRepertorio || w?.id || '').trim();
  const first = (p) => String(p?.nome || '').trim();
  const s1 = (p) => String(p?.primeiroApelido || '').trim();
  const s2 = (p) => String(p?.segundoApelido || '').trim();
  const displayName = (p) => [s1(p), s2(p), first(p)].filter(Boolean).join(' ') || String(p?.nomeCompleto || '').trim();
  const surnameKey = (p) => [s1(p), s2(p), first(p)].map(norm).join('|');
  const sortPeople = (a,b) => surnameKey(a).localeCompare(surnameKey(b),'gl',{sensitivity:'base',numeric:true});
  const VOICES = ['Soprano','Contralto','Tenor','Baixo'];
  const voiceLabel = (v) => v === 'Baixo' ? 'Baixos' : `${v}s`;

  const toDate = (v='') => {
    const t = String(v).trim(); if (!t) return null;
    const iso = /^\d{4}-\d{2}-\d{2}/.test(t) ? t.slice(0,10) : t.split(/[\/-]/).reverse().join('-');
    const d = new Date(`${iso}T12:00:00`); return Number.isNaN(d.getTime()) ? null : d;
  };
  const fmtDate = (v) => { const d=toDate(v); return d ? new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d) : String(v||''); };
  const fmtTime = (v='') => String(v).trim().replace(/^(\d{1,2}:\d{2}):\d{2}$/,'$1');

  let payload = null;
  let selected = null;
  let draft = null;
  let board = false;
  let voice = 'Todos';
  let loadSeq = 0;

  async function call(url, accion, extra={}) {
    const user = auth.currentUser;
    if (!user) throw new Error('A sesión non está dispoñible.');
    const idToken = await user.getIdToken();
    const response = await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});
    const result = await response.json().catch(()=>null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || `Erro ${response.status}`);
    return result;
  }
  const apiMain = (accion,extra={}) => call('/api/ensaios',accion,extra);
  const apiDraft = (accion,extra={}) => call('/api/ensaios-borrador',accion,{idEnsaio:rid(selected),...extra});

  function rehearsals() {
    const today = new Date(); today.setHours(0,0,0,0);
    const map = new Map();
    (payload?.ensaios || []).forEach((r)=>{ const id=rid(r); if(id && !map.has(id)) map.set(id,r); });
    return [...map.values()].filter((r)=>!truthy(r.cancelado) && (!toDate(r.data) || toDate(r.data)>=today)).sort((a,b)=>(toDate(a.data)?.getTime()||0)-(toDate(b.data)?.getTime()||0));
  }

  function renderSelector() {
    const rows = rehearsals(); if (!selected) selected = rows[0] || null;
    $('#ensaio-select').innerHTML = rows.map((r)=>`<option value="${esc(rid(r))}">${esc(fmtDate(r.data))}${r.horaInicio?` · ${esc(fmtTime(r.horaInicio))}`:''}${r.lugar?` · ${esc(r.lugar)}`:''}</option>`).join('');
    if (selected) $('#ensaio-select').value = rid(selected);
  }

  function renderSummary() {
    const box = $('#ensaio-resumo');
    if (!selected) { box.innerHTML='<p>Non hai próximos ensaios.</p>'; return; }
    const horario = [fmtTime(selected.horaInicio),selected.horaFin?fmtTime(selected.horaFin):''].filter(Boolean).join(' – ');
    box.innerHTML = `<div><span class="summary-label">Ensaio seleccionado</span><h2>${esc(fmtDate(selected.data))}</h2></div><div class="summary-meta">${selected.tipoEnsaio?`<span>${esc(selected.tipoEnsaio)}</span>`:''}${horario?`<span>${esc(horario)}</span>`:''}${selected.lugar?`<span>${esc(selected.lugar)}</span>`:''}${selected.concertoNome?`<span>${esc(selected.concertoNome)}</span>`:''}</div>`;
  }

  function attendanceMap() { return new Map((draft?.asistencias || []).map((a)=>[String(a.persoa || a.idPersoa || ''),a])); }
  function kind(a={}) { const s=norm(a.estadoAsistencia); if(s==='asiste')return'asiste'; if(s==='non asiste'&&truthy(a.xustificada))return'xustificada'; if(s==='non asiste')return'non'; return''; }

  function updateCounts() {
    if (!draft || !board) return;
    const map=attendanceMap(); let present=0, absent=0, justified=0;
    (payload?.persoas||[]).forEach((p)=>{ const k=kind(map.get(pid(p))); if(k==='asiste')present++; else if(k==='xustificada')justified++; else if(k==='non')absent++; });
    $('#count-present').textContent=String(present); $('#count-absent').textContent=String(absent); $('#count-justified').textContent=String(justified);
  }

  function renderPersonRow(p) {
    const id=pid(p), a=attendanceMap().get(id)||{}, k=kind(a);
    return `<article class="person-row" data-person="${esc(id)}"><div class="person-main"><strong>${esc(displayName(p))}</strong><a href="/portal/administracion/persoas/?id=${encodeURIComponent(id)}">Ver ficha</a></div><div class="attendance-buttons"><button type="button" data-kind="asiste" class="${k==='asiste'?'selected':''}">Asiste</button><button type="button" data-kind="non" class="${k==='non'?'selected':''}">Non asiste</button><button type="button" data-kind="xustificada" class="${k==='xustificada'?'selected':''}">Non asiste con xustificación</button></div>${k==='xustificada'?`<label class="reason"><span>Motivo da xustificación</span><input type="text" data-reason maxlength="240" value="${esc(a.motivo||'')}" placeholder="Indica o motivo…" /></label>`:''}<span class="row-status"></span></article>`;
  }

  function renderAttendance() {
    if (!board || !draft) return;
    const q=norm($('#people-search')?.value||'');
    const people=(payload?.persoas||[]).filter((p)=>!q || norm(displayName(p)).includes(q));
    const list=$('#attendance-list');
    if (voice==='Todos') {
      list.innerHTML=VOICES.map((v)=>{ const rows=people.filter((p)=>norm(p.voz)===norm(v)).sort(sortPeople); return `<section class="voice-group"><header><h3>${voiceLabel(v)}</h3><strong>${rows.length}</strong></header><div class="voice-people">${rows.map(renderPersonRow).join('')||'<p class="empty">Sen coralistas.</p>'}</div></section>`; }).join('');
    } else {
      const rows=people.filter((p)=>norm(p.voz)===norm(voice)).sort(sortPeople);
      list.innerHTML=`<section class="voice-group"><header><h3>${voiceLabel(voice)}</h3><strong>${rows.length}</strong></header><div class="voice-people">${rows.map(renderPersonRow).join('')||'<p class="empty">Sen coralistas.</p>'}</div></section>`;
    }
    updateCounts();
  }

  async function saveAttendance(id,k,motivo) {
    const map=attendanceMap(), current=map.get(id)||{};
    const values=k==='asiste'?{estadoAsistencia:'Asiste',xustificada:false,motivo:''}:k==='xustificada'?{estadoAsistencia:'Non asiste',xustificada:true,motivo:String(motivo??current.motivo??'')}:{estadoAsistencia:'Non asiste',xustificada:false,motivo:''};
    const previous=structuredClone(draft); map.set(id,{...current,ensaio:rid(selected),persoa:id,...values}); draft={...draft,asistencias:[...map.values()]}; renderAttendance();
    try { const out=await apiDraft('gardarAsistencia',{idPersoa:id,...values,observacions:String(current.observacions||'')}); draft=out.draft; renderAttendance(); }
    catch(e) { draft=previous; renderAttendance(); const st=document.querySelector(`.person-row[data-person="${CSS.escape(id)}"] .row-status`); if(st)st.textContent=`⚠ ${e instanceof Error?e.message:'Erro ao gardar'}`; }
  }

  function workById(id){ return (payload?.repertorio||[]).find((w)=>wid(w)===String(id||''))||null; }
  function works(){ return Array.isArray(draft?.repertorio)?draft.repertorio:[]; }
  function renderWorkPicker(){
    if(!board)return;
    const q=norm($('#work-search')?.value||''), used=new Set(works().map((r)=>String(r.repertorio||r.idRepertorio||'')));
    const rows=(payload?.repertorio||[]).filter((w)=>!used.has(wid(w))&&(!q||norm([w.nomeObra,w.nome,w.compositor].join(' ')).includes(q))).sort((a,b)=>String(a.nomeObra||a.nome||'').localeCompare(String(b.nomeObra||b.nome||''),'gl',{sensitivity:'base'})).slice(0,100);
    $('#work-select').innerHTML='<option value="">Escolle unha obra…</option>'+rows.map((w)=>`<option value="${esc(wid(w))}">${esc([w.nomeObra||w.nome,w.compositor].filter(Boolean).join(' — '))}</option>`).join('');
  }

  function renderWorks(){
    const list=$('#works-list');
    if(!draft){ $('#works-summary').textContent='Cargando…'; list.innerHTML='<p class="empty">Cargando obras do borrador R2…</p>'; return; }
    const rows=[...works()].sort((a,b)=>Number(a.orde||999)-Number(b.orde||999)); $('#works-summary').textContent=`${rows.length} obras`;
    list.innerHTML=rows.map((r,i)=>{ const id=String(r.repertorio||r.idRepertorio||''), w=workById(id)||{}; return `<article class="work-card" data-work="${esc(id)}"><header><span class="work-number">${i+1}</span><div><a class="work-title" href="/portal/repertorio/?id=${encodeURIComponent(id)}">${esc(w.nomeObra||w.nome||id)}</a>${w.compositor?`<small>${esc(w.compositor)}</small>`:''}</div>${board?'<button type="button" class="remove-work" aria-label="Eliminar obra">×</button>':''}</header>${board?`<label><span>Observacións</span><textarea class="work-notes" rows="2">${esc(r.observacions||'')}</textarea></label><footer><span class="work-status"></span><button type="button" class="save-work secondary">Gardar</button></footer>`:(r.observacions?`<p class="work-observations">${esc(r.observacions)}</p>`:'')}</article>`; }).join('')||'<p class="empty">Aínda non hai obras neste ensaio.</p>';
    renderWorkPicker();
  }

  async function loadDraft(){
    if(!selected)return; const n=++loadSeq; draft=null; renderWorks();
    try { const out=await apiDraft('obter'); if(n!==loadSeq)return; draft=out.draft; renderWorks(); renderAttendance(); }
    catch(e){ if(n!==loadSeq)return; $('#works-status').textContent=`⚠ ${e instanceof Error?e.message:'Non se puido cargar o borrador.'}`; }
  }

  function fillPrograms(){ const rows=[...(payload?.concertos||[])].sort((a,b)=>String(a.data||'').localeCompare(String(b.data||''))); $('#program-select').innerHTML='<option value="">Escolle un concerto…</option>'+rows.map((c)=>`<option value="${esc(c.id||'')}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join(''); }
  function concertById(id){return(payload?.concertos||[]).find((c)=>String(c.id||'')===String(id||''))||null;}
  function resolveProgramId(item){ if(item?.idRepertorio&&workById(item.idRepertorio))return String(item.idRepertorio); const target=norm(item?.obra||''); if(!target)return''; const exact=(payload?.repertorio||[]).find((w)=>norm(w.nomeObra||w.nome||'')===target); return exact?wid(exact):''; }

  function applyRole(){
    board=payload?.perfil?.podeEditar===true;
    document.querySelectorAll('.only-board').forEach((el)=>{ if(el instanceof HTMLElement)el.hidden=!board; });
    document.querySelectorAll('.only-coralist').forEach((el)=>{ if(el instanceof HTMLElement)el.hidden=board; });
    $('#works-panel').hidden=false;
    $('#attendance-panel').hidden=true;
  }

  async function load(){
    $('#loading').hidden=false; $('#error').hidden=true; $('#app').hidden=true;
    try { payload=await apiMain('listarEnsaiosPortal'); selected=rehearsals()[0]||null; renderSelector(); renderSummary(); fillPrograms(); applyRole(); $('#loading').hidden=true; $('#app').hidden=false; await loadDraft(); }
    catch(e){ $('#loading').hidden=true; $('#error').hidden=false; $('#error').textContent=e instanceof Error?e.message:'Non foi posible cargar os ensaios.'; }
  }

  $('#ensaio-select')?.addEventListener('change',(e)=>{ selected=rehearsals().find((r)=>rid(r)===String(e.target?.value||''))||null; renderSummary(); void loadDraft(); });
  $('#work-search')?.addEventListener('input',renderWorkPicker);
  $('#people-search')?.addEventListener('input',renderAttendance);
  $('#open-attendance')?.addEventListener('click',()=>{ $('#works-panel').hidden=true; $('#attendance-panel').hidden=false; renderAttendance(); window.scrollTo({top:0,behavior:'smooth'}); });
  $('#close-attendance')?.addEventListener('click',()=>{ $('#attendance-panel').hidden=true; $('#works-panel').hidden=false; });

  document.addEventListener('click',async(e)=>{
    const t=e.target; if(!(t instanceof HTMLElement))return;
    const vb=t.closest('[data-voice]'); if(vb){ voice=vb.dataset.voice||'Todos'; document.querySelectorAll('[data-voice]').forEach((b)=>b.classList.toggle('is-active',b===vb)); renderAttendance(); return; }
    const ab=t.closest('[data-kind]'); if(ab){ const row=ab.closest('.person-row'); if(!row||!draft||!board)return; await saveAttendance(String(row.dataset.person||''),String(ab.dataset.kind||'')); return; }
    const rm=t.closest('.remove-work'); if(rm){ const row=rm.closest('.work-card'),id=String(row?.dataset.work||''); if(!id||!draft||!board)return; const prev=structuredClone(draft); draft={...draft,repertorio:draft.repertorio.filter((r)=>String(r.repertorio||r.idRepertorio||'')!==id)}; renderWorks(); try{const out=await apiDraft('eliminarObra',{idRepertorio:id});draft=out.draft;renderWorks();}catch(err){draft=prev;renderWorks();$('#works-status').textContent=`⚠ ${err instanceof Error?err.message:'Erro ao eliminar'}`;} return; }
    const sw=t.closest('.save-work'); if(sw){ const row=sw.closest('.work-card'),id=String(row?.dataset.work||''),st=row?.querySelector('.work-status'); if(!row||!id||!draft||!board)return; try{if(st)st.textContent='Gardando…';const old=works().find((r)=>String(r.repertorio||r.idRepertorio||'')===id)||{};const out=await apiDraft('gardarObra',{idRepertorio:id,orde:old.orde||1,tipoTraballo:'',desde:'',ata:'',observacions:row.querySelector('.work-notes')?.value||''});draft=out.draft;renderWorks();const fresh=document.querySelector(`.work-card[data-work="${CSS.escape(id)}"] .work-status`);if(fresh)fresh.textContent='✓ Gardado';}catch(err){if(st)st.textContent=`⚠ ${err instanceof Error?err.message:'Erro ao gardar'}`;} return; }
  });

  document.addEventListener('change',async(e)=>{ const input=e.target; if(!(input instanceof HTMLInputElement)||!input.matches('[data-reason]')||!board)return; const row=input.closest('.person-row'); if(row&&draft)await saveAttendance(String(row.dataset.person||''),'xustificada',input.value); });

  $('#add-work')?.addEventListener('click',async()=>{ const id=$('#work-select')?.value||'',st=$('#works-status'); if(!id){st.textContent='Escolle unha obra.';return;} if(!board)return; try{st.textContent='Engadindo ao borrador R2…';const out=await apiDraft('gardarObra',{idRepertorio:id,orde:(draft?.repertorio?.length||0)+1,tipoTraballo:'',desde:'',ata:'',observacions:''});draft=out.draft;st.textContent='✓ Obra engadida.';renderWorks();}catch(e){st.textContent=`⚠ ${e instanceof Error?e.message:'Erro ao engadir'}`;} });

  const dialog=$('#program-dialog'); const closeDialog=()=>{if(dialog instanceof HTMLDialogElement)dialog.close();$('#program-status').textContent='';};
  $('#load-program')?.addEventListener('click',()=>{if(!(dialog instanceof HTMLDialogElement)||!board)return;const s=$('#program-select');if(s instanceof HTMLSelectElement)s.value=selected?.concerto||'';dialog.showModal();});
  $('#close-program')?.addEventListener('click',closeDialog); $('#cancel-program')?.addEventListener('click',closeDialog);
  $('#program-form')?.addEventListener('submit',async(e)=>{e.preventDefault();if(!board)return;const c=concertById($('#program-select')?.value||''),st=$('#program-status');if(!c){st.textContent='Escolle un concerto.';return;}const used=new Set(works().map((r)=>String(r.repertorio||r.idRepertorio||'')));const ids=[...new Set((c.programa||[]).map(resolveProgramId).filter((id)=>id&&!used.has(id)))];if(!ids.length){st.textContent='Non hai obras novas dese programa.';return;}try{st.textContent=`Incluíndo ${ids.length} obras…`;const out=await apiDraft('incluírPrograma',{idsRepertorio:ids});draft=out.draft;renderWorks();$('#works-status').textContent=`✓ ${out.engadidas??ids.length} obras incluídas.`;closeDialog();}catch(err){st.textContent=`⚠ ${err instanceof Error?err.message:'Erro ao cargar programa'}`;}});

  $('#finalize')?.addEventListener('click',async()=>{if(!board||!draft||!selected)return;if(!window.confirm('Finalizar o ensaio e gravar definitivamente asistencia e obras nas Sheets?'))return;const btn=$('#finalize'),st=$('#finalize-status');btn.disabled=true;st.textContent='Gravando resultado definitivo nas Sheets…';try{const out=await apiDraft('finalizar');draft=out.draft;st.textContent='✓ Ensaio finalizado e gardado definitivamente.';renderWorks();renderAttendance();}catch(e){st.textContent=`⚠ ${e instanceof Error?e.message:'Erro ao finalizar'}`;}finally{btn.disabled=false;}});

  $('#absence-simple')?.addEventListener('click',()=>{ $('#absence-reason-wrap').hidden=true; $('#absence-status').textContent='O aviso simple estará dispoñible cando se active o permiso persoal do coralista.'; });
  $('#absence-justify')?.addEventListener('click',()=>{ $('#absence-reason-wrap').hidden=false; $('#absence-status').textContent=''; });
  $('#absence-send')?.addEventListener('click',()=>{ $('#absence-status').textContent='O aviso persoal está preparado na interface; falta activar a validación segura do propio usuario na API.'; });

  onAuthStateChanged(auth,(user)=>{if(!user){window.location.href='/portal/';return;}void load();});
</script>

