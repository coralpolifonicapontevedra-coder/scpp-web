---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Ensaios V2" lang="gl">
  <div class="private-layout"><PortalSidebar active="ensaios" logoutId="ensaios-v2-logout" /><main class="private-main">
    <header class="page-header"><div><span class="kicker">Portal do Coralista</span><h1>Ensaios</h1><p>Traballo en borrador R2. As Sheets só se actualizan ao finalizar o ensaio.</p></div><div class="storage"><small>Almacenamento de traballo</small><strong>R2 privado</strong></div></header>
    <section id="loading" class="state-card">Cargando os ensaios…</section><section id="error" class="state-card error" hidden></section>
    <section id="app" class="app" hidden>
      <section class="selector-card"><label for="ensaio-select">Ensaio</label><select id="ensaio-select"></select><button id="finalize-top" class="primary only-board" type="button">Finalizar ensaio</button></section>
      <article class="summary-card"><div id="ensaio-resumo"></div><div class="attendance-kpis only-board"><div><strong id="kpi-present">0</strong><span>Asisten</span></div><div><strong id="kpi-absent">0</strong><span>Non asisten</span></div><div><strong id="kpi-justified">0</strong><span>Xustificadas</span></div><small id="kpi-total">0 rexistrados</small></div></article>
      <section id="self-absence" class="self-card" hidden><div><span class="kicker">A miña asistencia</span><h2>Non podes asistir?</h2><p>Podes comunicar a túa ausencia e indicar o motivo.</p></div><div class="self-actions"><textarea id="self-reason" rows="2" placeholder="Motivo da ausencia…"></textarea><button id="send-self-absence" class="primary" type="button">Comunicar ausencia</button></div><p id="self-status" class="status"></p></section>
      <nav class="main-tabs"><button type="button" class="is-active only-board" data-tab="attendance">Asistencia</button><button type="button" data-tab="works">Obras a estudar</button></nav>
      <section id="attendance-panel" class="panel only-board"><div class="attendance-toolbar"><div class="voice-tabs"><button type="button" class="is-active" data-voice="Soprano">Sopranos</button><button type="button" data-voice="Contralto">Contraltos</button><button type="button" data-voice="Tenor">Tenores</button><button type="button" data-voice="Baixo">Baixos</button><button type="button" data-voice="Todos">Todos</button></div><div class="attendance-tools"><input id="people-search" type="search" placeholder="Buscar coralista…" /><button id="show-attendees" type="button" class="secondary">Ver lista de asistentes</button></div></div><header class="section-heading"><div><span class="kicker">Control de asistencia</span><h2 id="voice-title">Sopranos</h2></div><strong id="attendance-summary"></strong></header><div id="attendance-list" class="attendance-list"></div></section>
      <section id="attendees-panel" class="panel only-board" hidden><header class="section-heading"><div><span class="kicker">Consulta</span><h2>Lista de asistentes</h2></div><button id="back-attendance" class="secondary" type="button">Volver ao control</button></header><div id="attendees-list" class="attendees-list"></div></section>
      <section id="works-panel" class="panel" hidden><header class="section-heading"><div><span class="kicker">Preparación musical</span><h2>Obras a estudar</h2></div><strong id="works-summary"></strong></header><div class="works-toolbar only-board"><button id="load-program" class="secondary" type="button">Cargar desde programa</button><input id="work-search" type="search" placeholder="Buscar obra ou compositor…" /><select id="work-select"><option value="">Escolle unha obra…</option></select><button id="add-work" class="primary" type="button">Engadir obra</button></div><p id="works-status" class="status"></p><div id="works-list" class="works-grid"></div></section>
      <p id="finalize-status" class="status only-board"></p>
    </section>
    <dialog id="program-dialog"><form id="program-form"><header><h2>Cargar desde programa</h2><button id="close-program" type="button" aria-label="Pechar">×</button></header><label>Concerto<select id="program-select"></select></label><p id="program-status" class="status"></p><footer><button id="cancel-program" class="secondary" type="button">Cancelar</button><button class="primary" type="submit">Incluír programa</button></footer></form></dialog>
  </main></div>
</BaseLayout>

<script>
import { getApp,getApps,initializeApp } from 'firebase/app'; import { getAuth,onAuthStateChanged } from 'firebase/auth';
const firebaseConfig={apiKey:'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',authDomain:'scpp-portal-privado.firebaseapp.com',projectId:'scpp-portal-privado',storageBucket:'scpp-portal-privado.firebasestorage.app',messagingSenderId:'506857659587',appId:'1:506857659587:web:a7ed36b22f044f5f639676'}; const auth=getAuth(getApps().length?getApp():initializeApp(firebaseConfig)); const $=s=>document.querySelector(s); const esc=(v='')=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;'); const norm=(v='')=>String(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase(); const truthy=v=>v===true||['true','1','si','sí','yes','x'].includes(norm(v)); const rid=r=>String(r?.idEnsaio||r?.id||'').trim(),pid=p=>String(p?.idPersoa||p?.id||'').trim(),wid=w=>String(w?.idRepertorio||w?.id||'').trim(); const first=p=>String(p?.nome||'').trim(),s1=p=>String(p?.primeiroApelido||'').trim(),s2=p=>String(p?.segundoApelido||'').trim(); const displayName=p=>[s1(p),s2(p),first(p)].filter(Boolean).join(' ')||String(p?.nomeCompleto||'').trim(); const sortPeople=(a,b)=>[s1(a),s2(a),first(a)].join('|').localeCompare([s1(b),s2(b),first(b)].join('|'),'gl',{sensitivity:'base',numeric:true});
const toDate=(v='')=>{const t=String(v).trim();if(!t)return null;const iso=/^\d{4}-\d{2}-\d{2}/.test(t)?t.slice(0,10):t.split(/[\/-]/).reverse().join('-');const d=new Date(`${iso}T12:00:00`);return Number.isNaN(d.getTime())?null:d}; const fmtDate=v=>{const d=toDate(v);return d?new Intl.DateTimeFormat('gl-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d):String(v||'')}; const fmtTime=(v='')=>String(v).trim().replace(/^(\d{1,2}:\d{2}):\d{2}$/,'$1'); let payload=null,selected=null,draft=null,voice='Soprano',board=false,seq=0;
async function call(url,accion,extra={}){const user=auth.currentUser;if(!user)throw new Error('A sesión non está dispoñible.');const idToken=await user.getIdToken();const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idToken,accion,...extra})});const out=await res.json().catch(()=>null);if(!res.ok||!out?.ok)throw new Error(out?.erro||`Erro ${res.status}`);return out} const apiMain=(accion,extra={})=>call('/api/ensaios',accion,extra),apiDraft=(accion,extra={})=>call('/api/ensaios-borrador',accion,{idEnsaio:rid(selected),...extra});
function rehearsals(){const today=new Date();today.setHours(0,0,0,0);const m=new Map();(payload?.ensaios||[]).forEach(r=>{const id=rid(r);if(id&&!m.has(id))m.set(id,r)});return[...m.values()].filter(r=>!truthy(r.cancelado)&&(!toDate(r.data)||toDate(r.data)>=today)).sort((a,b)=>(toDate(a.data)?.getTime()||0)-(toDate(b.data)?.getTime()||0))} function renderSelector(){const rows=rehearsals();if(!selected)selected=rows[0]||null;$('#ensaio-select').innerHTML=rows.map(r=>`<option value="${esc(rid(r))}">${esc(fmtDate(r.data))}${r.horaInicio?` · ${esc(fmtTime(r.horaInicio))}`:''}${r.lugar?` · ${esc(r.lugar)}`:''}</option>`).join('');if(selected)$('#ensaio-select').value=rid(selected)} function renderSummary(){if(!selected)return;const horario=[fmtTime(selected.horaInicio),selected.horaFin?fmtTime(selected.horaFin):''].filter(Boolean).join(' – ');$('#ensaio-resumo').innerHTML=`<span class="summary-label">Ensaio seleccionado</span><h2>${esc(fmtDate(selected.data))}</h2><div class="meta"><span>${esc(selected.tipoEnsaio||'Ensaio')}</span>${horario?`<span>${esc(horario)}</span>`:''}${selected.lugar?`<span>${esc(selected.lugar)}</span>`:''}${selected.concertoNome?`<span>${esc(selected.concertoNome)}</span>`:''}</div>`}
function attendanceMap(){return new Map((draft?.asistencias||[]).map(a=>[String(a.persoa||a.idPersoa||''),a]))} function kind(a={}){const s=norm(a.estadoAsistencia);if(s==='asiste')return'asiste';if(s==='non asiste'&&truthy(a.xustificada))return'xustificada';if(s==='non asiste')return'non';return''} function renderKpis(){if(!draft)return;const rows=payload?.persoas||[],map=attendanceMap();let p=0,n=0,j=0,m=0;rows.forEach(x=>{const k=kind(map.get(pid(x)));if(k){m++;if(k==='asiste')p++;else if(k==='xustificada')j++;else n++}});$('#kpi-present').textContent=String(p);$('#kpi-absent').textContent=String(n);$('#kpi-justified').textContent=String(j);$('#kpi-total').textContent=`${m} rexistrados de ${rows.length} coralistas`} function filteredPeople(){const q=norm($('#people-search')?.value||'');return(payload?.persoas||[]).filter(p=>(voice==='Todos'||norm(p.voz)===norm(voice))&&(!q||norm(displayName(p)).includes(q))).sort(sortPeople)}
function renderAttendance(){if(!board)return;$('#voice-title').textContent=voice==='Todos'?'Todos os coralistas':voice==='Baixo'?'Baixos':`${voice}s`;const list=$('#attendance-list');if(!draft){list.innerHTML='<p class="empty">Cargando borrador R2…</p>';return}const map=attendanceMap(),people=filteredPeople(),present=people.filter(p=>kind(map.get(pid(p)))==='asiste').length,marked=people.filter(p=>kind(map.get(pid(p)))).length;$('#attendance-summary').textContent=`${present} asisten · ${marked}/${people.length} rexistrados`;list.innerHTML=people.map(p=>{const id=pid(p),a=map.get(id)||{},k=kind(a);return`<article class="person-row" data-person="${esc(id)}"><div class="person-main"><strong>${esc(displayName(p))}</strong><a href="/portal/administracion/persoas/?id=${encodeURIComponent(id)}">Ver ficha</a></div><div class="attendance-buttons"><button type="button" data-kind="asiste" class="${k==='asiste'?'selected':''}">Asiste</button><button type="button" data-kind="non" class="${k==='non'?'selected':''}">Non asiste</button><button type="button" data-kind="xustificada" class="${k==='xustificada'?'selected':''}">Non asiste con xustificación</button></div>${k==='xustificada'?`<label class="reason"><span>Motivo da xustificación</span><input data-reason maxlength="240" value="${esc(a.motivo||'')}" placeholder="Indica o motivo…" /></label>`:''}<span class="row-status"></span></article>`}).join('')||'<p class="empty">Non hai persoas nesta selección.</p>';renderKpis();renderAttendees()} function renderAttendees(){if(!board||!draft)return;const map=attendanceMap(),voices=['Soprano','Contralto','Tenor','Baixo'];$('#attendees-list').innerHTML=voices.map(v=>{const rows=(payload?.persoas||[]).filter(p=>norm(p.voz)===norm(v)&&kind(map.get(pid(p)))==='asiste').sort(sortPeople);return`<section><header><h3>${v==='Baixo'?'Baixos':`${v}s`}</h3><strong>${rows.length}</strong></header>${rows.length?`<div>${rows.map(p=>`<span>${esc(displayName(p))}</span>`).join('')}</div>`:'<p>Sen asistentes rexistrados.</p>'}</section>`}).join('')}
async function saveAttendance(id,k,motivo){const map=attendanceMap(),current=map.get(id)||{},values=k==='asiste'?{estadoAsistencia:'Asiste',xustificada:false,motivo:''}:k==='xustificada'?{estadoAsistencia:'Non asiste',xustificada:true,motivo:String(motivo??current.motivo??'')}:{estadoAsistencia:'Non asiste',xustificada:false,motivo:''},prev=structuredClone(draft);map.set(id,{...current,ensaio:rid(selected),persoa:id,...values});draft={...draft,asistencias:[...map.values()]};renderAttendance();try{const out=await apiDraft('gardarAsistencia',{idPersoa:id,...values,observacions:String(current.observacions||'')});draft=out.draft;renderAttendance()}catch(e){draft=prev;renderAttendance();const st=document.querySelector(`.person-row[data-person="${CSS.escape(id)}"] .row-status`);if(st)st.textContent=`⚠ ${e instanceof Error?e.message:'Erro ao gardar'}`}} async function loadDraft(){if(!selected)return;const n=++seq;draft=null;renderAttendance();renderWorks();try{const out=await apiDraft('obter');if(n!==seq)return;draft=out.draft;renderAttendance();renderWorks()}catch(e){if(n!==seq)return;$('#finalize-status').textContent=`⚠ ${e instanceof Error?e.message:'Non se puido cargar o borrador.'}`}}
function workById(id){return(payload?.repertorio||[]).find(w=>wid(w)===String(id||''))||null} function works(){return Array.isArray(draft?.repertorio)?draft.repertorio:[]} function renderWorkPicker(){if(!board)return;const q=norm($('#work-search')?.value||''),used=new Set(works().map(r=>String(r.repertorio||r.idRepertorio||''))),rows=(payload?.repertorio||[]).filter(w=>!used.has(wid(w))&&(!q||norm([w.nomeObra,w.nome,w.compositor].join(' ')).includes(q))).sort((a,b)=>String(a.nomeObra||a.nome||'').localeCompare(String(b.nomeObra||b.nome||''),'gl',{sensitivity:'base'})).slice(0,100);$('#work-select').innerHTML='<option value="">Escolle unha obra…</option>'+rows.map(w=>`<option value="${esc(wid(w))}">${esc([w.nomeObra||w.nome,w.compositor].filter(Boolean).join(' — '))}</option>`).join('')} function renderWorks(){const list=$('#works-list');if(!draft){list.innerHTML='<p class="empty">Cargando obras do borrador R2…</p>';return}const rows=[...works()].sort((a,b)=>Number(a.orde||999)-Number(b.orde||999));$('#works-summary').textContent=`${rows.length} obras`;list.innerHTML=rows.map((r,i)=>{const id=String(r.repertorio||r.idRepertorio||''),w=workById(id)||{};return`<article class="work-card" data-work="${esc(id)}"><header><span>${i+1}</span><div><strong>${esc(w.nomeObra||w.nome||id)}</strong>${w.compositor?`<small>${esc(w.compositor)}</small>`:''}</div>${board?'<button class="remove-work" type="button" aria-label="Eliminar obra">×</button>':''}</header><label><span>Observacións</span><textarea class="work-notes" rows="2" ${board?'':'readonly'}>${esc(r.observacions||'')}</textarea></label>${board?'<footer><span class="work-status"></span><button class="save-work secondary" type="button">Gardar</button></footer>':''}</article>`}).join('')||'<p class="empty">Aínda non hai obras neste ensaio.</p>';renderWorkPicker()} function concertById(id){return(payload?.concertos||[]).find(c=>String(c.id||'')===String(id||''))||null} function resolveProgramId(item){if(item?.idRepertorio&&workById(item.idRepertorio))return String(item.idRepertorio);const t=norm(item?.obra||'');const exact=(payload?.repertorio||[]).find(w=>norm(w.nomeObra||w.nome||'')===t);return exact?wid(exact):''} function fillPrograms(){const rows=[...(payload?.concertos||[])].sort((a,b)=>String(a.data||'').localeCompare(String(b.data||'')));$('#program-select').innerHTML='<option value="">Escolle un concerto…</option>'+rows.map(c=>`<option value="${esc(c.id||'')}">${esc([c.data,c.nome].filter(Boolean).join(' · '))}</option>`).join('')}
function applyPermissions(){board=payload?.perfil?.podeEditar===true;document.querySelectorAll('.only-board').forEach(el=>el.hidden=!board);$('#self-absence').hidden=board;if(!board){document.querySelector('[data-tab="works"]')?.classList.add('is-active');$('#works-panel').hidden=false}} async function load(){try{payload=await apiMain('listarEnsaiosPortal');selected=rehearsals()[0]||null;renderSelector();renderSummary();fillPrograms();applyPermissions();$('#loading').hidden=true;$('#app').hidden=false;await loadDraft()}catch(e){$('#loading').hidden=true;$('#error').hidden=false;$('#error').textContent=e instanceof Error?e.message:'Non foi posible cargar os ensaios.'}}
$('#ensaio-select')?.addEventListener('change',e=>{selected=rehearsals().find(r=>rid(r)===String(e.target?.value||''))||null;voice='Soprano';renderSummary();void loadDraft()});$('#people-search')?.addEventListener('input',renderAttendance);$('#work-search')?.addEventListener('input',renderWorkPicker);document.addEventListener('click',async e=>{const t=e.target;if(!(t instanceof HTMLElement))return;const tab=t.closest('[data-tab]');if(tab){document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('is-active',b===tab));$('#attendance-panel').hidden=tab.dataset.tab!=='attendance';$('#attendees-panel').hidden=true;$('#works-panel').hidden=tab.dataset.tab!=='works';return}const vb=t.closest('[data-voice]');if(vb){voice=vb.dataset.voice||'Soprano';document.querySelectorAll('[data-voice]').forEach(b=>b.classList.toggle('is-active',b===vb));renderAttendance();return}const ab=t.closest('[data-kind]');if(ab&&board){const row=ab.closest('.person-row');if(row&&draft)await saveAttendance(String(row.dataset.person||''),String(ab.dataset.kind||''));return}const rm=t.closest('.remove-work');if(rm&&board){const row=rm.closest('.work-card'),id=String(row?.dataset.work||'');if(!id||!draft)return;const prev=structuredClone(draft);draft={...draft,repertorio:draft.repertorio.filter(r=>String(r.repertorio||r.idRepertorio||'')!==id)};renderWorks();try{const out=await apiDraft('eliminarObra',{idRepertorio:id});draft=out.draft;renderWorks()}catch{draft=prev;renderWorks()}return}const sw=t.closest('.save-work');if(sw&&board){const row=sw.closest('.work-card'),id=String(row?.dataset.work||'');if(!row||!id)return;const old=works().find(r=>String(r.repertorio||r.idRepertorio||'')===id)||{},out=await apiDraft('gardarObra',{idRepertorio:id,orde:old.orde||1,tipoTraballo:'',desde:'',ata:'',observacions:row.querySelector('.work-notes')?.value||''});draft=out.draft;renderWorks();return}});document.addEventListener('change',async e=>{const input=e.target;if(!(input instanceof HTMLInputElement)||!input.matches('[data-reason]')||!board)return;const row=input.closest('.person-row');if(row&&draft)await saveAttendance(String(row.dataset.person||''),'xustificada',input.value)});$('#show-attendees')?.addEventListener('click',()=>{$('#attendance-panel').hidden=true;$('#attendees-panel').hidden=false;renderAttendees()});$('#back-attendance')?.addEventListener('click',()=>{$('#attendees-panel').hidden=true;$('#attendance-panel').hidden=false});$('#add-work')?.addEventListener('click',async()=>{if(!board)return;const id=$('#work-select')?.value||'';if(!id)return;const out=await apiDraft('gardarObra',{idRepertorio:id,orde:(draft?.repertorio?.length||0)+1,tipoTraballo:'',desde:'',ata:'',observacions:''});draft=out.draft;renderWorks()});const dlg=$('#program-dialog'),closeDlg=()=>dlg instanceof HTMLDialogElement&&dlg.close();$('#load-program')?.addEventListener('click',()=>dlg instanceof HTMLDialogElement&&dlg.showModal());$('#close-program')?.addEventListener('click',closeDlg);$('#cancel-program')?.addEventListener('click',closeDlg);$('#program-form')?.addEventListener('submit',async e=>{e.preventDefault();if(!board)return;const c=concertById($('#program-select')?.value||''),st=$('#program-status');if(!c){st.textContent='Escolle un concerto.';return}const used=new Set(works().map(r=>String(r.repertorio||r.idRepertorio||''))),ids=[...new Set((c.programa||[]).map(resolveProgramId).filter(id=>id&&!used.has(id)))];if(!ids.length){st.textContent='Non hai obras novas dese programa.';return}const out=await apiDraft('incluírPrograma',{idsRepertorio:ids});draft=out.draft;renderWorks();closeDlg()});async function finalize(){if(!board||!draft||!selected)return;if(!window.confirm('Finalizar o ensaio e gravar definitivamente asistencia e obras nas Sheets?'))return;const st=$('#finalize-status');st.textContent='Gravando resultado definitivo…';try{const out=await apiDraft('finalizar');draft=out.draft;st.textContent='✓ Ensaio finalizado e gardado definitivamente.';renderAttendance();renderWorks()}catch(e){st.textContent=`⚠ ${e instanceof Error?e.message:'Erro ao finalizar'}`}}$('#finalize-top')?.addEventListener('click',finalize);$('#send-self-absence')?.addEventListener('click',()=>{$('#self-status').textContent='A auto-xustificación require activar o permiso correspondente no servizo de datos.'});onAuthStateChanged(auth,user=>{if(!user){window.location.href='/portal/';return}void load()});
</script>

<style is:global>
.private-layout{display:flex;min-height:100vh;background:#fff}.private-main{flex:1;min-width:0;padding:2rem clamp(1rem,3vw,2.5rem) 4rem}.page-header,.app{max-width:1180px}.page-header{display:flex;justify-content:space-between;gap:1.5rem;align-items:flex-start;padding-bottom:1.2rem;border-bottom:1px solid #e7e2de;margin-bottom:1.2rem}.page-header h1{margin:.28rem 0 .45rem;font-size:2rem}.page-header p{margin:0;color:#6d6661}.kicker,.summary-label{color:#741b2b;font-size:.72rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.storage{display:grid;gap:.2rem;padding:.85rem 1rem;min-width:170px;border:1px solid #e3ddda;border-radius:8px;background:#fbfaf9}.storage small{color:#777}.storage strong{color:#741b2b}.app{display:grid;gap:1rem}.state-card,.selector-card,.summary-card,.panel,.self-card{border:1px solid #e5dfdb;border-radius:8px;background:#fff;box-shadow:0 2px 7px rgb(30 25 22/.04)}.state-card{max-width:1180px;padding:1rem}.error{color:#8b1e2d}.selector-card{display:grid;grid-template-columns:auto minmax(280px,1fr) auto;gap:.8rem;align-items:center;padding:.8rem 1rem}.selector-card label{font-weight:800}.selector-card select,.works-toolbar input,.works-toolbar select,.attendance-tools input,.reason input,.work-card textarea,.self-actions textarea,dialog select{width:100%;padding:.65rem .72rem;border:1px solid #d8d0cb;border-radius:6px;background:#fff;font:inherit}.summary-card{display:grid;grid-template-columns:1.5fr 1fr;gap:1rem;padding:1rem 1.15rem}.summary-card h2{margin:.35rem 0 .65rem;color:#741b2b}.meta{display:flex;flex-wrap:wrap;gap:.4rem .7rem;color:#5d5651}.meta span+span:before{content:'·';margin-right:.7rem;color:#b3aaa4}.attendance-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem}.attendance-kpis>div{display:grid;place-items:center;padding:.7rem;border:1px solid #e3ddda;border-radius:7px;background:#fcfbfa}.attendance-kpis strong{font-size:1.45rem;color:#741b2b}.attendance-kpis span{font-size:.78rem}.attendance-kpis sm