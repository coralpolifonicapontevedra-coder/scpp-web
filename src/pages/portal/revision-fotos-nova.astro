---
import BaseLayout from '../../layouts/Layout.astro';
import PortalSidebar from '../../components/PortalSidebar.astro';
---

<BaseLayout title="Revisión de fotografías" lang="gl">
  <div class="private-layout">
    <PortalSidebar active="revisar" logoutId="review-logout" />
    <main class="review-main">
      <header class="private-page-header">
        <div>
          <span class="kicker">Xestión fotográfica</span>
          <h1>Revisar fotografías</h1>
          <p>Revisa, completa os datos e decide o destino de cada fotografía.</p>
        </div>
        <div class="pending-card">
          <small>Pendentes</small>
          <strong id="review-count">0</strong>
          <button id="review-refresh" type="button" aria-label="Actualizar">↻</button>
        </div>
      </header>

      <section id="access-state" class="state">Comprobando sesión e permisos…</section>

      <section id="review-shell" hidden>
        <nav class="review-navigation" aria-label="Navegación entre fotografías">
          <button id="review-previous" type="button">← Anterior</button>
          <strong id="review-position">0 de 0</strong>
          <button id="review-next" type="button">Seguinte →</button>
        </nav>
        <p id="review-message" class="message" hidden aria-live="polite"></p>
        <div id="review-list"></div>
        <p id="review-empty" class="empty" hidden>Non hai fotografías pendentes de revisión.</p>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getApp, getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';

  const firebaseConfig = {
    apiKey: 'AIzaSyDrQY7NsaKpBfrSc8GqV3lUQDOIkecPZbs',
    authDomain: 'scpp-portal-privado.firebaseapp.com',
    projectId: 'scpp-portal-privado',
    storageBucket: 'scpp-portal-privado.firebasestorage.app',
    messagingSenderId: '506857659587',
    appId: '1:506857659587:web:a7ed36b22f044f5f639676'
  };

  const auth = getAuth(getApps().length ? getApp() : initializeApp(firebaseConfig));
  const shell = document.querySelector('#review-shell');
  const accessState = document.querySelector('#access-state');
  const list = document.querySelector('#review-list');
  const count = document.querySelector('#review-count');
  const position = document.querySelector('#review-position');
  const empty = document.querySelector('#review-empty');
  const message = document.querySelector('#review-message');
  const refresh = document.querySelector('#review-refresh');
  const previous = document.querySelector('#review-previous');
  const next = document.querySelector('#review-next');
  const logout = document.querySelector('#review-logout');

  let photos = [];
  let currentIndex = 0;
  let cachedToken = '';
  let loadingList = false;
  const preloadCache = new Set();

  const text = (value = '') => String(value ?? '').trim();
  const escapeHtml = (value = '') => text(value)
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
  const safeUrl = (value = '') => /^https:\/\//i.test(text(value)) ? text(value) : '';
  const first = (...values) => values.map(text).find(Boolean) || '';

  function showMessage(value = '', type = '') {
    if (!(message instanceof HTMLElement)) return;
    message.textContent = value;
    message.dataset.type = type;
    message.hidden = !value;
  }

  async function token() {
    const user = auth.currentUser;
    if (!user?.email) throw new Error('A sesión non está activa.');
    if (!cachedToken) cachedToken = await user.getIdToken();
    return cachedToken;
  }

  async function api(action, data = {}) {
    const idToken = await token();
    let response = await fetch('/api/fotos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken, accion: action, ...data })
    });

    if (response.status === 401 || response.status === 403) {
      cachedToken = await auth.currentUser?.getIdToken(true) || '';
      response = await fetch('/api/fotos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idToken: cachedToken, accion: action, ...data })
      });
    }

    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) throw new Error(result?.erro || `HTTP ${response.status}`);
    return result;
  }

  function updateNavigation() {
    const total = photos.length;
    if (count instanceof HTMLElement) count.textContent = String(total);
    if (position instanceof HTMLElement) position.textContent = total ? `${currentIndex + 1} de ${total}` : '0 de 0';
    if (previous instanceof HTMLButtonElement) previous.disabled = total === 0 || currentIndex <= 0;
    if (next instanceof HTMLButtonElement) next.disabled = total === 0 || currentIndex >= total - 1;
    if (empty instanceof HTMLElement) empty.hidden = total !== 0;
  }

  function photoUrl(photo) {
    return safeUrl(first(photo?.miniaturaUrl, photo?.urlMiniatura, photo?.ficheiroUrl, photo?.url));
  }

  function preloadAround() {
    [currentIndex - 1, currentIndex + 1].forEach((index) => {
      const url = photoUrl(photos[index]);
      if (!url || preloadCache.has(url)) return;
      preloadCache.add(url);
      const image = new Image();
      image.decoding = 'async';
      image.src = url;
    });
  }

  function renderCurrent() {
    if (!(list instanceof HTMLElement)) return;
    updateNavigation();
    const photo = photos[currentIndex];
    if (!photo) {
      list.replaceChildren();
      return;
    }

    const thumbnail = photoUrl(photo);
    const original = safeUrl(first(photo.ficheiroUrl, photo.urlOriginal, thumbnail));
    const title = first(photo.titulo, photo.nomeFicheiro, 'Fotografía pendente');
    const rowId = first(photo.rowId, photo.idFoto, photo.Id_Foto);

    list.innerHTML = `
      <article class="review-card" data-row-id="${escapeHtml(rowId)}">
        <section class="photo-column">
          <div class="photo-frame">
            ${thumbnail ? `<img src="${escapeHtml(thumbnail)}" alt="${escapeHtml(title)}" decoding="async" fetchpriority="high" />` : '<div class="placeholder">Sen miniatura dispoñible</div>'}
          </div>
          ${original ? `<a class="original-link" href="${escapeHtml(original)}" target="_blank" rel="noopener noreferrer">Abrir fotografía orixinal ↗</a>` : ''}
        </section>
        <section class="form-column">
          <div class="readonly-grid">
            <label><span>Evento / Concerto</span><input readonly value="${escapeHtml(first(photo.evento, photo.concerto, 'Sen indicar'))}" /></label>
            <label><span>Data</span><input readonly value="${escapeHtml(first(photo.data, photo.dataFoto, photo.anoAproximado, 'Sen indicar'))}" /></label>
            <label><span>Lugar</span><input readonly value="${escapeHtml(first(photo.lugar, 'Sen indicar'))}" /></label>
            <label><span>Autor / Procedencia</span><input readonly value="${escapeHtml(first(photo.autor, photo.autoria, photo.procedencia, 'Sen indicar'))}" /></label>
          </div>
          <label><span>Título ou descrición</span><input name="titulo" maxlength="120" value="${escapeHtml(photo.titulo)}" /></label>
          <label><span>Pé de foto</span><textarea name="peFoto" rows="3" maxlength="600">${escapeHtml(photo.peFoto)}</textarea></label>
          <label><span>Notas privadas</span><textarea name="observacions" rows="3" maxlength="500">${escapeHtml(photo.observacions)}</textarea></label>
          <fieldset>
            <legend>Destino da publicación</legend>
            <label class="check"><input type="checkbox" name="publicarPublica" ${photo.publicarPublica ? 'checked' : ''} /> Galería pública</label>
            <label class="check"><input type="checkbox" name="publicarPrivada" ${photo.publicarPrivada ? 'checked' : ''} /> Galería privada</label>
          </fieldset>
          <div class="actions">
            <button class="reject" type="button" data-action="rexeitar">Rexeitar</button>
            <button type="button" data-action="aceptar">Aceptar</button>
            <button class="publish" type="button" data-action="publicar">Publicar</button>
          </div>
        </section>
      </article>`;

    preloadAround();
  }

  async function loadPhotos() {
    if (loadingList) return;
    loadingList = true;
    if (refresh instanceof HTMLButtonElement) refresh.disabled = true;
    showMessage('Cargando fotografías pendentes…', 'loading');
    try {
      const result = await api('listarFotosRevision');
      photos = Array.isArray(result.fotos) ? result.fotos : [];
      currentIndex = Math.min(currentIndex, Math.max(0, photos.length - 1));
      if (accessState instanceof HTMLElement) accessState.hidden = true;
      if (shell instanceof HTMLElement) shell.hidden = false;
      renderCurrent();
      showMessage();
    } catch (error) {
      if (accessState instanceof HTMLElement) {
        accessState.hidden = false;
        accessState.textContent = error instanceof Error ? error.message : 'Non foi posible abrir a revisión.';
      }
    } finally {
      loadingList = false;
      if (refresh instanceof HTMLButtonElement) refresh.disabled = false;
    }
  }

  function removeCurrentLocally() {
    photos.splice(currentIndex, 1);
    if (currentIndex >= photos.length) currentIndex = Math.max(0, photos.length - 1);
    renderCurrent();
  }

  previous?.addEventListener('click', () => {
    if (currentIndex <= 0) return;
    currentIndex -= 1;
    renderCurrent();
  });

  next?.addEventListener('click', () => {
    if (currentIndex >= photos.length - 1) return;
    currentIndex += 1;
    renderCurrent();
  });

  refresh?.addEventListener('click', loadPhotos);

  list?.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest('button[data-action]') : null;
    if (!(button instanceof HTMLButtonElement)) return;
    const card = button.closest('.review-card');
    if (!(card instanceof HTMLElement)) return;
    const action = button.dataset.action;
    if (!action) return;
    if (action === 'rexeitar' && !window.confirm('Queres rexeitar esta fotografía?')) return;

    const publicarPublica = card.querySelector('[name="publicarPublica"]');
    const publicarPrivada = card.querySelector('[name="publicarPrivada"]');
    const publica = publicarPublica instanceof HTMLInputElement && publicarPublica.checked;
    const privada = publicarPrivada instanceof HTMLInputElement && publicarPrivada.checked;
    if (action === 'publicar' && !publica && !privada) {
      showMessage('Selecciona polo menos unha galería.', 'error');
      return;
    }

    const buttons = card.querySelectorAll('button[data-action]');
    buttons.forEach((item) => { if (item instanceof HTMLButtonElement) item.disabled = true; });
    showMessage('Gardando cambios…', 'loading');

    try {
      const titulo = card.querySelector('[name="titulo"]');
      const peFoto = card.querySelector('[name="peFoto"]');
      const observacions = card.querySelector('[name="observacions"]');
      const result = await api('actualizarRevisionFoto', {
        rowId: card.dataset.rowId,
        estado: action === 'rexeitar' ? 'Rexeitada' : 'Aprobada',
        publicarPublica: action === 'publicar' && publica,
        publicarPrivada: action === 'publicar' && privada,
        titulo: titulo instanceof HTMLInputElement ? titulo.value : '',
        peFoto: peFoto instanceof HTMLTextAreaElement ? peFoto.value : '',
        observacions: observacions instanceof HTMLTextAreaElement ? observacions.value : '',
        destacadaPublica: false,
        destacadaPrivada: false
      });
      removeCurrentLocally();
      showMessage(result.mensaxe || 'Fotografía actualizada correctamente.', 'success');
    } catch (error) {
      buttons.forEach((item) => { if (item instanceof HTMLButtonElement) item.disabled = false; });
      showMessage(error instanceof Error ? error.message : 'Non foi posible gardar os cambios.', 'error');
    }
  });

  onAuthStateChanged(auth, (user) => {
    cachedToken = '';
    if (!user?.email) {
      window.location.replace('/portal/');
      return;
    }
    loadPhotos();
  });

  logout?.addEventListener('click', async () => {
    await signOut(auth);
    window.location.href = '/portal/';
  });
</script>

<style>
  :global(body){background:#f5f3f0}.private-layout{display:grid;grid-template-columns:282px minmax(0,1fr);min-height:100vh}.review-main{padding:2.5rem clamp(1rem,4vw,4rem) 5rem;font-family:Aptos,'Segoe UI',Arial,sans-serif}.private-page-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.kicker{color:var(--color-acento);font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.private-page-header h1{margin:.35rem 0;color:var(--color-principal)}.private-page-header p{margin:0;color:#6a635e}.pending-card{display:flex;align-items:center;gap:.7rem;padding:.7rem .9rem;border:1px solid #d8d1cb;background:#fff}.pending-card strong{font-size:1.3rem;color:var(--color-principal)}.pending-card button{border:0;background:transparent;font-size:1.2rem;cursor:pointer}.state,.message,.empty{padding:1rem;border:1px solid #ddd5cf;background:#fff;color:#625b56}.review-navigation{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;margin-bottom:1rem}.review-navigation button{padding:.7rem 1rem;border:1px solid #bfb5ad;background:#fff;cursor:pointer}.review-navigation button:last-child{justify-self:end}.review-navigation button:disabled{opacity:.4;cursor:not-allowed}.review-card{display:grid;grid-template-columns:minmax(320px,46%) minmax(0,1fr);gap:1.5rem;padding:1rem;border:1px solid #d8d1cb;background:#fff}.photo-frame{min-height:360px;display:grid;place-items:center;background:#ece8e5;overflow:hidden}.photo-frame img{display:block;width:100%;max-height:68vh;object-fit:contain}.placeholder{color:#776f69}.original-link{display:block;margin-top:.65rem;text-align:center;color:var(--color-principal)}.form-column{display:grid;gap:.85rem}.readonly-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.form-column label{display:grid;gap:.3rem}.form-column span,.form-column legend{font-size:.76rem;font-weight:700;color:#554d48}.form-column input,.form-column textarea{width:100%;box-sizing:border-box;padding:.68rem;border:1px solid #cfc6bf;background:#fff;font:inherit}.form-column input[readonly]{background:#f3f0ed;color:#6c645e}.form-column fieldset{display:flex;gap:1.25rem;padding:.8rem;border:1px solid #d8d1cb}.check{display:flex!important;grid-template-columns:auto 1fr!important;align-items:center;gap:.45rem!important}.check input{width:auto}.actions{display:flex;justify-content:flex-end;gap:.65rem}.actions button{padding:.72rem 1rem;border:1px solid #9f948c;background:#fff;cursor:pointer}.actions .publish{background:var(--color-principal);color:#fff;border-color:var(--color-principal)}.actions .reject{color:#8a2929}.message[data-type="error"]{border-color:#c98e8e;color:#8a2929}.message[data-type="success"]{border-color:#9abd9e;color:#285d31}@media(max-width:980px){.private-layout{display:block}.review-main{padding:1.25rem}.private-page-header{display:block}.pending-card{margin-top:1rem;width:max-content}.review-card{grid-template-columns:1fr}.readonly-grid{grid-template-columns:1fr}.photo-frame{min-height:240px}}
</style>
