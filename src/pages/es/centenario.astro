---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';

const eventos = [
  { fecha:'26 de marzo y 8 de abril de 2025', titulo:'Sello conmemorativo y presentación oficial', lugar:'Correos · Edificio Castelao del Museo de Pontevedra', texto:'Correos dedicó a la Sociedad Coral Polifónica de Pontevedra un sello de la serie «Efemérides» con motivo del centenario. La emisión se realizó el 26 de marzo y la presentación oficial se celebró el 8 de abril en el Museo de Pontevedra, con un acto institucional y el tradicional matasellos de honor.', imagen:'/img/centenario/02-presentacion-selo.webp', alt:'Presentación oficial del sello conmemorativo del centenario en el Museo de Pontevedra', pie:'Emisión del sello conmemorativo y presentación oficial con matasellos de honor.' },
  { fecha:'9 de abril de 2025', titulo:'Concierto del centenario en San Francisco', lugar:'Iglesia conventual de San Francisco · Pontevedra', texto:'Cien años después de la primera presentación pública de la Coral, la iglesia de San Francisco acogió un concierto conmemorativo que recuperó la memoria de aquella actuación fundacional de 1925.', imagen:'/img/centenario/03-concerto-san-francisco.webp', alt:'Concierto del centenario de la Coral en la iglesia de San Francisco', pie:'Concierto conmemorativo del 9 de abril de 2025.' },
  { fecha:'2 de junio de 2025', titulo:'Homenaje de la Sociedad Filarmónica', lugar:'Teatro Principal · Pontevedra', texto:'La Sociedad Filarmónica de Pontevedra organizó un concierto homenaje a la Coral en el Teatro Principal, escenario de su primer gran concierto de 1926.', imagen:'/img/centenario/04-filarmonica-teatro-principal.webp', alt:'Concierto homenaje de la Sociedad Filarmónica en el Teatro Principal', pie:'Concierto homenaje organizado por la Sociedad Filarmónica de Pontevedra.' },
  { fecha:'4 de junio de 2025', titulo:'Pontevedreses del Año', lugar:'Auditorio de Afundación · Pontevedra', texto:'La Sociedad fue distinguida en la categoría de Música y Cultura. La Coral cerró la gala interpretando «Si vas a San Benitiño», de Antonio Blanco Porto.', imagen:'/img/centenario/05-pontevedreses-do-ano.webp', alt:'Entrega del premio Pontevedreses del Año a la Coral Polifónica', pie:'Entrega del reconocimiento Pontevedreses del Año 2025.' },
  { fecha:'2025', titulo:'Exposición del centenario', lugar:'Edificio Castelao · Museo de Pontevedra', texto:'La exposición reunió fotografías, documentos, programas, partituras, grabaciones y materiales escenográficos que permitieron recorrer cien años de historia musical e institucional.', imagen:'/img/centenario/06-exposicion-centenario.webp', alt:'Exposición del centenario de la Coral en el Museo de Pontevedra', pie:'Exposición dedicada a los cien años de la Sociedad.' },
  { fecha:'22 de mayo de 2025', titulo:'Jornada de conferencias', lugar:'Teatro Principal · Pontevedra', texto:'El Teatro Principal acogió una jornada de estudio y divulgación sobre la historia, la música, la escena y el legado de la Sociedad, con la participación de especialistas y personas vinculadas a la institución.', imagen:'/img/centenario/07-conferencias-teatro-principal.webp', alt:'Jornada de conferencias del centenario en el Teatro Principal', pie:'Conferencias e intervenciones musicales sobre la historia de la Coral.' },
  { fecha:'11 de diciembre de 2025', titulo:'Premio Otero Pedrayo', lugar:'Pazo de la Deputación · Pontevedra', texto:'La Sociedad recibió uno de los grandes reconocimientos del centenario por su contribución a la dignificación y a la proyección de la cultura gallega. El acto incluyó una audición de la Coral.', imagen:'/img/centenario/08-premio-otero-pedrayo.webp', alt:'Entrega del Premio Otero Pedrayo a la Sociedad Coral Polifónica', pie:'Acto de entrega del Premio Otero Pedrayo 2025.' },
  { fecha:'13 de diciembre de 2025', titulo:'Medalla de Oro «Marcial del Adalid»', lugar:'Edificio Castelao · Museo de Pontevedra', texto:'La Real Academia Galega de Belas Artes entregó a la Sociedad la Medalla de Oro «Marcial del Adalid». La ceremonia incluyó la laudatio de Rosa Cedrón y un recital de la Coral.', imagen:'/img/centenario/09-marcial-del-adalid.webp', alt:'Entrega de la Medalla Marcial del Adalid a la Coral Polifónica', pie:'Entrega de la Medalla de Oro «Marcial del Adalid».', documentos:[{ etiqueta:'Leer la laudatio', href:'/docs/distincions/laudatio-marcial-del-adalid.pdf' }] },
  { fecha:'20 de diciembre de 2025', titulo:'Concierto de Navidad y «Missa Brevis»', lugar:'Iglesia conventual de San Francisco · Pontevedra', texto:'La Coral y la Banda de Música de Pontevedra compartieron uno de los grandes conciertos del centenario, con un programa que incluyó la «Missa Brevis» de Jacob de Haan y una selección de villancicos.', imagen:'/img/centenario/10-missa-brevis.webp', alt:'Concierto de Navidad con la Missa Brevis en la iglesia de San Francisco', pie:'Concierto de Navidad del centenario con la Banda de Música de Pontevedra.' },
  { fecha:'23 de marzo de 2026', titulo:'«Leucoíña. O canto das augas»', lugar:'Auditorio de Afundación · Pontevedra', texto:'La Sociedad Coral Polifónica de Pontevedra y la Orquestra Sinfónica de Pontevedra estrenaron la cantata «Leucoíña. O canto das augas», compuesta por Brais González. El concierto clausuró oficialmente los actos del centenario.', imagen:'/img/centenario/11-leucoina.webp', alt:'Concierto Leucoíña en el Auditorio de Afundación de Pontevedra', pie:'Estreno de «Leucoíña. O canto das augas» en el Auditorio de Afundación.' },
  { fecha:'28 de marzo de 2026', titulo:'Vieira de Honor a la Calidad Artística', lugar:'LVIII Cabido Xeral da Enxebre Orde da Vieira · Madrid', texto:'La Fundación Cultural da Vieira reconoció la trayectoria centenaria de la Sociedad y su contribución a la difusión de la música coral gallega.', imagen:'/img/centenario/12-vieira-de-honra.webp', alt:'Entrega de la Vieira de Honor a la Calidad Artística', pie:'Vieira de Honor a la Calidad Artística, Madrid, 28 de marzo de 2026.', documentos:[{ etiqueta:'Ver el diploma', href:'/docs/distincions/diploma-vieira-de-honra.pdf' }] }
];

const distinciones = [
  { fecha:'26 de marzo y 8 de abril de 2025', titulo:'Sello conmemorativo del centenario', entidad:'Correos y Fábrica Nacional de Moneda y Timbre' },
  { fecha:'4 de junio de 2025', titulo:'Pontevedreses del Año · Música y Cultura', entidad:'Diario de Pontevedra' },
  { fecha:'11 de diciembre de 2025', titulo:'Premio Otero Pedrayo 2025', entidad:'Las cuatro diputaciones gallegas y la Fundación Otero Pedrayo' },
  { fecha:'13 de diciembre de 2025', titulo:'Medalla de Oro «Marcial del Adalid»', entidad:'Real Academia Galega de Belas Artes' },
  { fecha:'28 de marzo de 2026', titulo:'Vieira de Honor a la Calidad Artística', entidad:'Fundación Cultural da Vieira · Enxebre Orde da Vieira' }
];
---

<SpanishPublicLayout title="Centenario" description="Centenario de la Sociedad Coral Polifónica de Pontevedra: conciertos, exposiciones y reconocimientos de 2025 y 2026.">
  <main class="centenario-page">
    <header class="centenario-hero"><div class="hero-content"><p class="eyebrow">1925 — 2025</p><h1>Un siglo de voces</h1><p class="hero-lead">Conciertos, exposiciones, conferencias, reconocimientos y nuevas creaciones para celebrar cien años de música, memoria y compromiso colectivo.</p></div></header>

    <section class="centenario-intro"><p class="section-kicker">2025 — 2026</p><h2>Una celebración abierta a la ciudad</h2><p>El centenario no fue un único acontecimiento, sino un amplio programa que recuperó la historia de la Sociedad, hizo visible su patrimonio y abrió nuevas vías artísticas para el futuro.</p></section>

    <section id="eventos" class="events-section" aria-label="Actos del centenario"><div class="events-list">{eventos.map((evento,index)=><article class="event-card"><div class="event-index">{String(index+1).padStart(2,'0')}</div><div class="event-image"><img src={evento.imagen} alt={evento.alt} loading="lazy" onerror="this.closest('.event-image')?.classList.add('image-missing'); this.remove();"/><div class="image-placeholder" aria-hidden="true"><span>Foto del evento</span></div></div><div class="event-content"><div class="event-meta"><span>{evento.fecha}</span><span>{evento.lugar}</span></div><h2>{evento.titulo}</h2><p>{evento.texto}</p><p class="event-caption">{evento.pie}</p>{evento.documentos?.length>0&&<div class="event-documents">{evento.documentos.map((documento)=><a href={documento.href} target="_blank" rel="noreferrer">{documento.etiqueta} <span aria-hidden="true">↗</span></a>)}</div>}</div></article>)}</div></section>

    <section id="distinciones" class="awards-section" aria-labelledby="distinciones-title"><header class="awards-heading"><p class="section-kicker">Reconocimientos</p><h2 id="distinciones-title">Un siglo reconocido</h2><p>Cinco distinciones que hicieron visible la dimensión musical, cultural y patrimonial de la Sociedad en el año de su centenario.</p></header><div class="awards-grid">{distinciones.map((distincion)=><article class="award-card"><p class="award-date">{distincion.fecha}</p><h3>{distincion.titulo}</h3><p>{distincion.entidad}</p></article>)}</div></section>

    <section class="closing-section"><p class="section-kicker">23 de marzo de 2026</p><h2>Un final que también fue un comienzo</h2><p>El estreno de «Leucoíña. O canto das augas» cerró oficialmente los actos del centenario con una obra nueva creada para la Sociedad, convirtiendo la memoria acumulada durante cien años en música para el futuro.</p><a href="/es/historia" class="closing-link">Volver a la historia <span aria-hidden="true">→</span></a></section>
  </main>
</SpanishPublicLayout>

<style>
.centenario-page{--wine:var(--color-principal,#5c1926);--gold:var(--color-acento,#a3821a);--ink:#201d1d;--muted:#6f6965;--paper:#f7f5f0;--line:#ded8ce;background:#fff;color:var(--ink);padding-bottom:7rem}.centenario-hero{min-height:430px;display:grid;place-items:center;padding:5rem 1.5rem 6rem;background:radial-gradient(circle at 75% 20%,rgba(225,202,123,.18),transparent 28%),linear-gradient(135deg,#45101a,#701f30);color:white;text-align:center}.hero-content{width:min(850px,100%)}.eyebrow,.section-kicker{margin:0 0 1rem;color:var(--gold);font-size:.78rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.centenario-hero h1{margin:0;font-size:clamp(2.8rem,7vw,5.3rem);line-height:.98}.hero-lead{max-width:720px;margin:1.4rem auto 0;color:rgba(255,255,255,.85);font-size:1.08rem;line-height:1.75}.centenario-intro,.awards-section,.closing-section{width:min(960px,calc(100% - 3rem));margin-inline:auto}.centenario-intro{padding:4.5rem 0 3rem;text-align:center}.centenario-intro h2,.awards-heading h2,.closing-section h2{margin:.2rem 0 1rem;color:var(--wine);font-size:clamp(2rem,4vw,3rem);line-height:1.1}.centenario-intro>p:last-child,.awards-heading>p:last-child,.closing-section>p{max-width:760px;margin-inline:auto;color:var(--muted);font-size:1.02rem;line-height:1.8}.events-section{width:min(1120px,calc(100% - 3rem));margin:0 auto}.events-list{display:grid;gap:2rem}.event-card{display:grid;grid-template-columns:44px minmax(260px,36%) minmax(0,1fr);gap:1.5rem;padding:1.4rem;border-top:1px solid var(--line);background:#fff}.event-index{color:var(--gold);font-size:.75rem;font-weight:800;letter-spacing:.12em}.event-image{position:relative;min-height:210px;background:var(--paper);overflow:hidden}.event-image img{display:block;width:100%;height:100%;min-height:210px;object-fit:cover}.image-placeholder{position:absolute;inset:0;display:none;place-items:center;color:var(--muted);font-size:.8rem}.event-image.image-missing .image-placeholder{display:grid}.event-meta{display:flex;flex-wrap:wrap;gap:.4rem 1rem;color:var(--gold);font-size:.74rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em}.event-content h2{margin:.55rem 0 .75rem;color:var(--wine);font-size:1.55rem}.event-content>p{color:var(--muted);line-height:1.72}.event-caption{font-size:.82rem;font-style:italic}.event-documents{display:flex;gap:1rem;flex-wrap:wrap}.event-documents a,.closing-link{color:var(--wine);font-size:.78rem;font-weight:700;text-transform:uppercase;text-decoration:none}.awards-section{padding:5rem 0}.awards-heading{text-align:center;margin-bottom:2.2rem}.awards-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.award-card{padding:1.4rem;border:1px solid var(--line);background:var(--paper)}.award-date{margin:0;color:var(--gold);font-size:.72rem;font-weight:700;text-transform:uppercase}.award-card h3{margin:.55rem 0;color:var(--wine);font-size:1.05rem}.award-card>p:last-child{margin:0;color:var(--muted);font-size:.88rem;line-height:1.55}.closing-section{padding:3rem 0;border-top:1px solid var(--line);text-align:center}.closing-link{display:inline-flex;gap:.5rem;margin-top:1rem}
@media(max-width:820px){.event-card{grid-template-columns:32px 1fr}.event-image{grid-column:2}.event-content{grid-column:2}.awards-grid{grid-template-columns:1fr}}@media(max-width:520px){.events-section,.centenario-intro,.awards-section,.closing-section{width:calc(100% - 2rem)}.event-card{grid-template-columns:1fr;padding:1rem 0}.event-index,.event-image,.event-content{grid-column:1}.event-image{min-height:190px}}
</style>
