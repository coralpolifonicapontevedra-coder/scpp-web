---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';
const categorias=[
{clave:'Placa de San David',titulo:'Placas de San David'},
{clave:'Medalla de Ouro e Brillantes',titulo:'Medallas de Oro y Brillantes'},
{clave:'Medalla de Ouro',titulo:'Medallas de Oro'},
{clave:'Medalla de Prata',titulo:'Medallas de Plata'}];
---

<SpanishPublicLayout title="Honores concedidos" description="Placas y medallas concedidas por la Sociedad Coral Polifónica de Pontevedra a personas, colectivos y entidades a lo largo de su historia.">
<main class="honras-page">
<header class="page-header"><p class="intro">Placas y medallas con las que la Sociedad Coral Polifónica de Pontevedra ha reconocido a personas, colectivos y entidades vinculadas a su historia.</p></header>
<section class="honras-directory" aria-label="Honores concedidos">
<div class="category-grid" aria-label="Categorías de honores">{categorias.map((categoria,index)=><button class="category-card" type="button" data-category={categoria.clave} aria-pressed="false"><span class="category-number">{String(index+1).padStart(2,'0')}</span><span class="category-copy"><strong>{categoria.titulo}</strong><small data-category-count={categoria.clave}>—</small></span><span class="category-arrow" aria-hidden="true">↓</span></button>)}</div>
<div id="honras-status" class="status" role="status" aria-live="polite">Cargando los honores concedidos…</div>
<div id="honras-results" class="honras-results" hidden></div>
<div id="error-actions" class="error-actions" hidden><button id="retry-button" type="button">Intentar de nuevo</button></div>
</section>
</main>
<script is:inline>
(()=>{const API_URL='/api/honras';const order=['Placa de San David','Medalla de Ouro e Brillantes','Medalla de Ouro','Medalla de Prata'];const collator=new Intl.Collator('es',{sensitivity:'base'});const status=document.getElementById('honras-status');const results=document.getElementById('honras-results');const errorActions=document.getElementById('error-actions');const retryButton=document.getElementById('retry-button');const buttons=[...document.querySelectorAll('[data-category]')];let honras=[];let active='';const clean=(value)=>String(value??'').trim();const displayDate=(value)=>{const raw=clean(value);if(!raw)return'';const match=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);return match?`${match[3]}/${match[2]}/${match[1]}`:raw};const cell=(label,value,className='')=>{const td=document.createElement('td');td.dataset.label=label;if(className)td.className=className;td.textContent=clean(value)||'—';return td};const render=(category)=>{active=category;buttons.forEach((button)=>button.setAttribute('aria-pressed',String(button.dataset.category===category)));const selected=honras.filter((item)=>clean(item.categoria)===category);const years=new Map();selected.forEach((item)=>{const year=Number(item.ano)||0;if(!years.has(year))years.set(year,[]);years.get(year).push(item)});results.replaceChildren();[...years.entries()].sort((a,b)=>b[0]-a[0]).forEach(([year,items])=>{items.sort((a,b)=>(Number(a.orde)||999)-(Number(b.orde)||999)||collator.compare(clean(a.persoaEntidade),clean(b.persoaEntidade)));const section=document.createElement('section');section.className='year-block';const header=document.createElement('header');header.className='year-heading';const h3=document.createElement('h3');h3.textContent=String(year);const count=document.createElement('span');count.textContent=`${items.length} ${items.length===1?'honor':'honores'}`;header.append(h3,count);const tableWrap=document.createElement('div');tableWrap.className='table-wrap';const table=document.createElement('table');table.className='honras-table';const thead=document.createElement('thead');const headRow=document.createElement('tr');['Fecha','Persona / entidad','Condición','Festividad','Observaciones'].forEach((label)=>{const th=document.createElement('th');th.scope='col';th.textContent=label;headRow.append(th)});thead.append(headRow);const tbody=document.createElement('tbody');items.forEach((item)=>{const row=document.createElement('tr');row.append(cell('Fecha',displayDate(item.data)||String(year),'honra-date'),cell('Persona / entidad',item.persoaEntidade,'honra-name'),cell('Condición',item.condicion),cell('Festividad',item.festividade),cell('Observaciones',item.observacions,'honra-notes'));tbody.append(row)});table.append(thead,tbody);tableWrap.append(table);section.append(header,tableWrap);results.append(section)});results.hidden=false;status.hidden=true};const load=async()=>{status.hidden=false;status.textContent='Cargando los honores concedidos…';results.hidden=true;errorActions.hidden=true;try{const response=await fetch(API_URL,{headers:{Accept:'application/json'}});if(!response.ok)throw new Error(`Respuesta HTTP ${response.status}`);const data=await response.json();if(!data?.ok||!Array.isArray(data.honras))throw new Error('Formato de respuesta no válido');honras=data.honras;order.forEach((category)=>{const count=honras.filter((item)=>clean(item.categoria)===category).length;const node=document.querySelector(`[data-category-count="${category}"]`);if(node)node.textContent=`${count} ${count===1?'honor':'honores'}`});render(active||order[0])}catch(error){status.hidden=false;status.textContent='No ha sido posible cargar ahora la relación de honores.';errorActions.hidden=false}};buttons.forEach((button)=>button.addEventListener('click',()=>render(button.dataset.category||order[0])));retryButton?.addEventListener('click',load);load()})();
</script>
</SpanishPublicLayout>
<style>
.honras-page{--wine:#6a1b29;--wine-dark:#49121d;--gold:#c5a059;--ink:#1f1f1f;--muted:#68625b;--paper:#fdfbf7;--soft:#f4f0e6;--line:rgba(106,27,41,.32);background:var(--paper);color:var(--ink);min-height:70vh;padding:clamp(2rem,4vw,3.5rem) clamp(1rem,3.5vw,3rem) clamp(4rem,8vw,7rem)}.page-header,.honras-directory{width:min(1420px,100%);margin-inline:auto}.page-header{text-align:left;margin-bottom:clamp(2rem,3.5vw,3rem)}.intro{color:var(--muted);font-size:clamp(1rem,1.6vw,1.16rem);line-height:1.65;margin:0;max-width:980px}.category-grid{display:grid;gap:.8rem;grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:2.2rem}.category-card{align-items:center;background:#fff;border:1px solid var(--line);border-radius:5px;color:var(--wine-dark);cursor:pointer;display:grid;font:inherit;gap:.85rem;grid-template-columns:auto minmax(0,1fr) auto;min-height:5rem;padding:1rem;text-align:left}.category-card:hover,.category-card[aria-pressed='true']{background:var(--soft);border-color:rgba(106,27,41,.55)}.category-card[aria-pressed='true']{box-shadow:inset 4px 0 0 var(--gold)}.category-number{color:var(--gold);font-size:.72rem;font-weight:800}.category-copy strong,.category-copy small{display:block}.category-copy small{color:var(--muted);margin-top:.2rem}.category-arrow{color:var(--gold)}.status{background:var(--soft);border:1px solid var(--line);border-radius:5px;color:var(--muted);padding:1rem}.error-actions{margin-top:1rem}.error-actions button{background:var(--wine);border:0;border-radius:4px;color:#fff;cursor:pointer;font:inherit;padding:.65rem 1rem}:global(.year-block){margin-top:2.6rem}:global(.year-heading){align-items:baseline;display:flex;justify-content:space-between;margin-bottom:.65rem;padding:0 .1rem}:global(.year-heading h3){color:var(--wine-dark);font-size:1.7rem;margin:0}:global(.year-heading span){color:var(--muted);font-size:.92rem;font-weight:600}:global(.table-wrap){background:#fff;overflow-x:auto}:global(.honras-table){border:2px solid var(--wine);border-collapse:collapse;table-layout:fixed;width:100%}:global(.honras-table th){background:var(--wine);border:1px solid rgba(255,255,255,.72);color:#fff;font-size:.82rem;font-weight:700;padding:.85rem 1rem;text-align:center}:global(.honras-table td){border:1px solid rgba(106,27,41,.26);padding:.78rem .9rem;vertical-align:top;font-size:.88rem;line-height:1.5}:global(.honras-table th:nth-child(1)){width:12%}:global(.honras-table th:nth-child(2)){width:27%}:global(.honras-table th:nth-child(3)){width:19%}:global(.honras-table th:nth-child(4)){width:16%}:global(.honras-table th:nth-child(5)){width:26%}
@media(max-width:900px){.category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.category-grid{grid-template-columns:1fr}:global(.honras-table thead){display:none}:global(.honras-table),:global(.honras-table tbody),:global(.honras-table tr),:global(.honras-table td){display:block;width:100%}:global(.honras-table tr){border-bottom:2px solid var(--wine)}:global(.honras-table td){display:grid;grid-template-columns:115px 1fr;gap:.7rem}:global(.honras-table td)::before{content:attr(data-label);color:var(--wine);font-weight:700}}
</style>