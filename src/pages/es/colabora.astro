---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';
import TpvContribution from '../../components/TpvContribution.astro';
const viasColaboracion=[
{id:'cantar',tipo:'Quero cantar',titulo:'Quiero cantar',descripcion:'Buscamos nuevas voces para todas las cuerdas. Si tienes oído musical, ilusión por aprender y quieres formar parte de una agrupación centenaria, te invitamos a conocer nuestros ensayos.',botonText:'Quiero participar',destacado:true},
{id:'socio',tipo:'Alta de socio/a',titulo:'Quiero hacerme socio/a',descripcion:'Apoya la actividad regular de la Coral con una colaboración periódica y ayúdanos a sostener los ensayos, la formación vocal, los conciertos y la conservación del archivo histórico.',botonText:'Solicitar información',destacado:false},
{id:'economica',tipo:'Colaboración económica',titulo:'Colaboración económica',descripcion:'Una colaboración puntual puede destinarse a proyectos artísticos, edición de partituras, grabaciones, desplazamientos o iniciativas de conservación y difusión del patrimonio de la Coral.',botonText:'Quiero colaborar',destacado:false},
{id:'empresas',tipo:'Empresa ou mecenado',titulo:'Empresas y mecenazgo',descripcion:'Diseñamos acuerdos de patrocinio, mecenazgo y colaboración en especie adaptados a empresas y entidades que deseen apoyar un proyecto cultural centenario.',botonText:'Hablar sobre colaboración',destacado:false}];
---

<SpanishPublicLayout title="Colabora" description="Formas de colaborar con la Sociedad Coral Polifónica de Pontevedra.">
<div class="container colabora-page-wrapper">
<header class="colabora-header"><p class="sobrelinea">Forma parte del proyecto</p><h1>Colabora con nosotros</h1><div class="section-line-center"></div><p class="colabora-intro">La Sociedad Coral Polifónica de Pontevedra mantiene vivo un legado cultural único desde 1925. Descubre las diferentes formas de participar y apoyar nuestra actividad musical.</p></header>

<div class="colabora-grid">{viasColaboracion.map((via)=><article class:list={['colabora-card',via.destacado&&'featured-card']}>{via.destacado&&<span class="badge-destacado">Nuevas voces</span>}<div class="colabora-content"><h2>{via.titulo}</h2><div class="card-line"></div><p>{via.descripcion}</p></div>{via.id==='economica'?<a class="btn-colabora" href="#colaboracion-economica">{via.botonText}</a>:<button type="button" class="btn-colabora" data-seleccionar-solicitud={via.tipo} data-form-target="#form-colabora">{via.botonText}</button>}</article>)}</div>

<TpvContribution lang="es" />

<section class="formulario-colabora" aria-labelledby="titulo-form-colabora"><div class="formulario-intro"><p class="sobrelinea">Primer contacto</p><h2 id="titulo-form-colabora">Cuéntanos cómo quieres colaborar</h2><p>Enviarás una solicitud sin compromiso. La Coral la revisará y se pondrá en contacto contigo para explicar los siguientes pasos.</p></div>
<form id="form-colabora" class="colabora-form" data-solicitud-form data-orixe="Colabora" data-version-legal="formularios-web-v1-2026-07-25">
<div class="form-group"><label for="colabora-tipo">Forma de colaboración *</label><select id="colabora-tipo" name="tipoSolicitude" required><option value="" selected disabled>Selecciona una opción…</option><option value="Quero cantar">Quiero cantar</option><option value="Alta de socio/a">Quiero hacerme socio/a</option><option value="Colaboración económica">Colaboración económica</option><option value="Empresa ou mecenado">Empresa, patrocinio o mecenazgo</option><option value="Colaboración en especie">Colaboración en especie</option></select></div>
<div class="form-row"><div class="form-group"><label for="colabora-nome">Nombre completo *</label><input type="text" id="colabora-nome" name="nomeCompleto" maxlength="140" autocomplete="name" required /></div><div class="form-group"><label for="colabora-email">Correo electrónico *</label><input type="email" id="colabora-email" name="correoElectronico" maxlength="160" autocomplete="email" required /></div></div>
<div class="form-row"><div class="form-group"><label for="colabora-telefono">Teléfono</label><input type="tel" id="colabora-telefono" name="telefono" maxlength="40" autocomplete="tel" /></div><div class="form-group" data-visible-para="Empresa ou mecenado|Colaboración en especie" hidden><label for="colabora-entidade">Empresa o entidad *</label><input type="text" id="colabora-entidade" name="entidade" maxlength="180" autocomplete="organization" data-required-when-visible="true" /></div></div>
<div class="form-row" data-visible-para="Quero cantar" hidden><div class="form-group"><label for="colabora-corda">Cuerda preferente *</label><select id="colabora-corda" name="cordaPreferente" data-required-when-visible="true"><option value="" selected>Selecciona una opción…</option><option value="Soprano">Soprano</option><option value="Contralto">Contralto</option><option value="Tenor">Tenor</option><option value="Baixo">Bajo</option><option value="Non o sei">No lo sé</option></select></div><div class="form-group"><label for="colabora-experiencia">Experiencia musical o coral</label><textarea id="colabora-experiencia" name="experienciaCoral" rows="4" maxlength="1200" placeholder="No es necesario tener experiencia previa."></textarea></div></div>
<div class="form-group"><label for="colabora-mensaxe">Mensaje *</label><textarea id="colabora-mensaxe" name="mensaxe" rows="6" maxlength="4000" required placeholder="Cuéntanos brevemente tu interés o propuesta de colaboración…"></textarea></div>
<div class="campo-trampa" aria-hidden="true"><label for="colabora-website">Sitio web</label><input type="text" id="colabora-website" name="website" tabindex="-1" autocomplete="off" /></div>
<label class="privacidade"><input type="checkbox" name="aceptacionProteccionDatos" required /><span>Acepto que la Sociedad Coral Polifónica de Pontevedra trate estos datos exclusivamente para atender esta solicitud, conforme a la <a href="/es/privacidad/" target="_blank">política de privacidad</a>. *</span></label>
<div class="form-actions"><button type="submit" class="btn-enviar">Enviar solicitud</button><p class="form-status" data-form-status aria-live="polite" hidden></p></div>
</form></section>

<aside class="empresas-adianto"><div><p class="sobrelinea">Reconocimiento público</p><h2>Instituciones y entidades colaboradoras</h2></div><div><p>Conoce las instituciones, entidades y empresas que contribuyen a mantener viva la actividad artística y el patrimonio de la Sociedad.</p><a class="btn-entidades" href="/es/colaboradores/">Conocer las entidades colaboradoras <span aria-hidden="true">→</span></a></div></aside>
</div>
<script src="/js/solicitudes-web-es.js" defer></script>
</SpanishPublicLayout>
<style>
.colabora-page-wrapper{padding-top:clamp(2.5rem,6vw,4rem);padding-bottom:6rem}.colabora-header{max-width:820px;margin:0 auto clamp(2.75rem,6vw,4rem);text-align:center}.sobrelinea{color:var(--color-principal);font-size:.82rem;font-weight:700;letter-spacing:.16em;margin:0 0 .85rem;text-transform:uppercase}.colabora-header h1{color:var(--color-principal);font-size:clamp(2.25rem,5vw,3.8rem);font-weight:700;line-height:1;margin:0}.section-line-center{width:60px;height:2px;background-color:var(--color-acento);margin:1rem auto 1.5rem}.colabora-intro{font-size:clamp(1.02rem,2vw,1.15rem);line-height:1.65;margin:0;opacity:.85}.colabora-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1.25rem,3vw,2rem)}.colabora-card{display:flex;flex-direction:column;justify-content:space-between;position:relative;min-height:310px;border:1px solid rgba(106,27,41,.12);border-radius:5px;background:#fff;padding:clamp(1.6rem,4vw,2.5rem);transition:transform .2s ease,box-shadow .2s ease}.colabora-card:hover{transform:translateY(-3px);box-shadow:0 10px 25px rgba(0,0,0,.05)}.featured-card{border-left:4px solid var(--color-principal);background:linear-gradient(to bottom right,#fff,var(--color-gris))}.badge-destacado{position:absolute;top:1.25rem;right:1.5rem;border-radius:3px;background:var(--color-principal);color:#fff;font-size:.68rem;font-weight:700;letter-spacing:.06em;padding:.32rem .75rem;text-transform:uppercase}.colabora-content h2,.formulario-intro h2,.empresas-adianto h2{color:var(--color-texto);font-size:clamp(1.35rem,2.5vw,1.65rem);font-weight:700;margin:0}.card-line{width:35px;height:2px;background:var(--color-acento);margin:.8rem 0 1.4rem}.colabora-content p,.formulario-intro p,.empresas-adianto p{color:#444;font-size:1rem;line-height:1.65}.btn-colabora,.btn-enviar,.btn-entidades{display:inline-flex;border:0;border-radius:4px;background:var(--color-principal);color:#fff;cursor:pointer;font:inherit;font-size:.82rem;font-weight:700;letter-spacing:.06em;padding:.9rem 1.35rem;text-decoration:none;text-transform:uppercase}.btn-colabora{align-self:flex-start}.btn-colabora:hover,.btn-enviar:hover,.btn-entidades:hover{background:var(--color-acento)}.formulario-colabora{scroll-margin-top:130px;display:grid;grid-template-columns:minmax(250px,.75fr) minmax(0,1.25fr);gap:clamp(2rem,5vw,4rem);margin-top:5rem;padding:clamp(1.5rem,4vw,2.5rem);background:var(--color-gris);border-top:3px solid var(--color-principal)}.colabora-form{display:flex;flex-direction:column;gap:1.25rem}.form-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.form-group{display:flex;flex-direction:column;gap:.45rem}.form-group label,.privacidade{font-size:.9rem;font-weight:600}.form-group input,.form-group select,.form-group textarea{width:100%;border:1px solid rgba(106,27,41,.22);border-radius:5px;background:#fff;color:var(--color-texto);font:inherit;font-size:1rem;padding:.82rem .95rem}.form-group textarea{resize:vertical}.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:var(--color-principal);box-shadow:0 0 0 3px rgba(106,27,41,.08)}.privacidade{display:grid;grid-template-columns:auto 1fr;gap:.75rem;align-items:start;line-height:1.5;font-weight:400}.privacidade input{margin-top:.25rem}.campo-trampa{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.form-actions{display:flex;flex-wrap:wrap;gap:1rem;align-items:center}.btn-enviar:disabled{cursor:wait;opacity:.65}.form-status{flex:1 1 260px;margin:0;font-size:.9rem}.form-status[data-state="success"]{color:#23633b}.form-status[data-state="error"]{color:#8b1f2d}.empresas-adianto{display:grid;grid-template-columns:.8fr 1.2fr;gap:3rem;margin-top:4rem;padding:2rem;border-left:3px solid var(--color-acento);background:var(--color-gris)}@media(max-width:820px){.colabora-grid,.formulario-colabora,.empresas-adianto{grid-template-columns:1fr}.form-row{grid-template-columns:1fr}}@media(max-width:520px){.colabora-page-wrapper{padding-inline:1rem}.badge-destacado{position:static;align-self:flex-start;margin-bottom:1rem}}
</style>
