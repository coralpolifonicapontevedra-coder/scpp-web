---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';

const secciones=[
{id:'origenes',numero:'01',titulo:'Orígenes',subtitulo:'1924 — 1926'},
{id:'cronologia',numero:'02',titulo:'Cronología',subtitulo:'1926 — actualidad'},
{id:'direccion',numero:'03',titulo:'Dirección musical',subtitulo:'1925 — actualidad'},
{id:'presidencias',numero:'04',titulo:'Presidencias',subtitulo:'Memoria institucional'},
{id:'castelao',numero:'05',titulo:'Castelao y la escena',subtitulo:'Arte y música'},
{id:'legado',numero:'06',titulo:'Legado',subtitulo:'Patrimonio vivo'},
{id:'historico',numero:'07',titulo:'Histórico de conciertos',subtitulo:'1925 — actualidad'}];

const origenes=[
{ano:'1924',etiqueta:'El germen',titulo:'Un proyecto nacido en el ambiente cultural de Pontevedra',texto:'En la Pontevedra de los años veinte, marcada por una intensa actividad artística e intelectual, fue tomando forma la idea de crear una agrupación capaz de unir la gran polifonía europea con la música tradicional gallega. El impulso surgió alrededor de un grupo de músicos, artistas e intelectuales que entendían la cultura como una tarea colectiva.',detalle:'La actuación del Coro de los Cosacos de Kubán en la Sociedad Filarmónica, en abril de 1924, fue una de las referencias que alimentaron aquella voluntad de crear una formación coral con personalidad propia.'},
{ano:'1925',etiqueta:'3 de febrero',titulo:'Fundación de la Sociedad Coral Polifónica de Pontevedra',texto:'La primera Junta General se celebró el 3 de febrero de 1925. Antón Losada Diéguez asumió la presidencia y Antonio Blanco Porto la dirección musical. De la unión de músicos, intelectuales, artistas y personas comprometidas con la vida cultural de la ciudad surgió una institución llamada a convertirse en uno de los grandes referentes de la música coral gallega.',detalle:'El padre Luis María Fernández Espinosa desempeñó posteriormente un papel fundamental en la incorporación de las voces femeninas procedentes de la Xuventude Antoniana, contribuyendo decisivamente a la consolidación del carácter mixto y pionero de la agrupación.'},
{ano:'1925',etiqueta:'Los fundadores',titulo:'Las personas que impulsaron el proyecto',texto:'El grupo fundador estuvo formado por Antón Losada Diéguez, Antonio Blanco Porto, Antonio Iglesias Vilarelle, Joaquín Maquieira Fernández, Alfonso Daniel Rodríguez Castelao, Álvaro Losada, Vicente Barreiro Viñas, Carlos Gastañaduy Ozores, Prudencio Otero Bermúdez de Castro y el padre Luis María Fernández Espinosa.',detalle:'Músicos, intelectuales, artistas y religiosos unidos por un mismo propósito: crear una institución coral llamada a desempeñar un papel fundamental en la vida cultural gallega.'},
{ano:'1925',etiqueta:'9 y 10 de abril',titulo:'Primeras presentaciones públicas',texto:'La Coral se presentó oficialmente en la iglesia de San Francisco el Jueves Santo de 1925 y repitió programa al día siguiente en la Basílica de Santa María la Mayor. Aquellas actuaciones sacras dejaron ver ya la disciplina musical y la ambición cultural del proyecto.',detalle:'El programa incluyó obras de maestros de la polifonía histórica y confirmó desde el inicio la voluntad de abordar repertorios exigentes.'},
{ano:'1926',etiqueta:'23 de marzo',titulo:'El primer gran concierto en el Teatro Principal',texto:'El concierto del Teatro Principal supuso la verdadera presentación artística de la Sociedad. El programa combinó música antigua y moderna, repertorio religioso y canción popular, en una propuesta escénica en la que música y artes plásticas formaban una unidad.',detalle:'El público acogió con entusiasmo tanto las interpretaciones como los paños diseñados por Castelao, y varias obras tuvieron que ser repetidas.'}];

const cronologia=[
['23 de marzo de 1926','El primer gran concierto en el Teatro Principal','La Sociedad se presentó artísticamente ante el gran público en el Teatro Principal de Pontevedra con un programa dividido en música antigua y moderna, repertorio religioso y música popular. Los paños diseñados por Castelao convirtieron la actuación en una experiencia en la que música y artes plásticas formaban una unidad.'],
['4 de abril de 1926','Primera salida de Pontevedra','La Coral actuó en el Teatro Principal de Santiago de Compostela y participó en un acto litúrgico en la Catedral. Fue la primera vez que la agrupación llevó su proyecto artístico fuera de la ciudad.'],
['11 de mayo de 1926','Debut en el Teatro Odeón de Vigo','La actuación, organizada por la Sociedad Filarmónica de Vigo, confirmó el interés que había despertado la nueva agrupación tras el concierto inaugural de Pontevedra.'],
['28 de septiembre de 1927','Concierto de gala en el García Barbón','La Sociedad Coral Polifónica actuó en el Teatro García Barbón de Vigo ante los reyes Alfonso XIII y Victoria Eugenia, en uno de los hitos más destacados de sus primeros años.'],
['24–27 de noviembre de 1928','La consagración en Madrid','Los conciertos en el Teatro de la Zarzuela y en el Monumental Cinema confirmaron la proyección estatal de la agrupación. La crítica madrileña destacó la calidad musical del programa, la presencia del repertorio gallego y la singularidad de la escenografía de Castelao.'],
['13–14 de mayo de 1930','A Coruña','La Coral ofreció un concierto en el Teatro Rosalía de Castro, organizado por la Sociedad Filarmónica, y participó en un acto litúrgico en la iglesia de San Nicolás.'],
['22–23 de noviembre de 1934','Teatro Nacional de Lisboa','Las actuaciones en Lisboa abrieron una larga relación musical con Portugal y consolidaron la primera gran proyección internacional de la Sociedad.'],
['11–12 de diciembre de 1944','Conciertos en el Teatro Arriaga','La Sociedad participó en los Concertos Aguinaldo para los Humildes celebrados en el Teatro Arriaga de Bilbao, consolidando su proyección estatal bajo la dirección de Antonio Iglesias Vilarelle.'],
['23–24 de febrero de 1946','Nueva gira por Bilbao','Tras actuar en Oviedo y Santander, la Coral ofreció dos conciertos en Bilbao: en el Teatro Filarmónica y en el Teatro Buenos Aires, este último a beneficio de un hospital. En aquel viaje se estrenó en Bilbao Keltia, obra compuesta por Antonio Iglesias Vilarelle.'],
['1951','Nuevos formatos y colaboraciones musicales','A partir de la década de 1950 la actividad se amplió con conciertos acompañados por formaciones instrumentales. La colaboración con la Orquesta de Cámara de Pontevedra abrió nuevas posibilidades interpretativas.'],
['29 de abril de 1975','Cincuenta años de historia','El Monasterio de Armenteira acogió el concierto conmemorativo del 50 aniversario de la Sociedad, una actuación grabada en directo y convertida en uno de los testimonios sonoros más valiosos de aquella etapa.'],
['1979','Argentina y Uruguay','La gira por Buenos Aires y Montevideo constituyó uno de los episodios internacionales más significativos de la historia de la Coral, reforzando los lazos con la emigración gallega y llevando el nombre de Pontevedra al otro lado del Atlántico.'],
['Décadas de 1980 y 1990','Europa y la continuidad','La Coral mantuvo una intensa presencia en Galicia y en el resto de España, al tiempo que amplió su proyección internacional con actuaciones en Francia, Portugal y Andorra. París, Tours, Mettray y Angers forman parte de esa memoria viajera.'],
['2000–2001','Setenta y cinco años y Premio Cidade de Pontevedra','El 75 aniversario impulsó conciertos, publicaciones y recuperaciones discográficas. En ese contexto, el Concello reconoció la labor colectiva de la Sociedad con la concesión del Premio Cidade de Pontevedra.'],
['2025','Tres grandes conciertos del centenario','El programa conmemorativo tuvo tres citas musicales especialmente significativas: el concierto del 9 de abril en la iglesia de San Francisco, el homenaje organizado por la Sociedad Filarmónica de Pontevedra el 2 de junio en el Teatro Principal y el concierto de Navidad del 20 de diciembre en San Francisco, compartido con la Banda de Música de Pontevedra.']];

const directores=[
['Antonio Blanco Porto','1925 — 1940','Director fundador y principal artífice de la primera identidad sonora de la Coral.'],['Antonio Iglesias Vilarelle','1940 — 1964','Compositor, musicólogo y continuador de la etapa fundacional.'],['Manuel Fernández Cayeiro','1964 — 1967','Primera etapa al frente de la dirección musical de la Sociedad.'],['Agustín Bertomeu Salazar','1968 — 1977','Músico y compositor con una aportación propia al repertorio de la Coral.'],['José Antonio Sánchez Rodríguez «Pachú»','1977 — 1980','Director de una etapa breve de transición y continuidad artística.'],['José Verea Montero','1980 — 1998','Responsable de una larga etapa de estabilidad y renovación coral.'],['Manuel Fernández Cayeiro','1998 — 2008','Segunda etapa al frente de la Coral, coincidente con el 75 aniversario.'],['Marlene Armentero Cutiño','2008 — 2013','Primera mujer en asumir la dirección musical de la Sociedad.'],['Nanette Sánchez Ordaz','2013 — actualidad','Directora de la etapa contemporánea y del centenario.']];

const presidentes=[
['Antón Losada Diéguez','1925 — 1929','Primer presidente y una de las personas decisivas en el impulso cultural e institucional de la Sociedad.'],['Alfonso Daniel Rodríguez Castelao','1929 — 1932','Presidente, cantor bajo, escenógrafo y creador de la identidad visual de la Coral.'],['José Blein Llinás','1932 — 1947','Dio continuidad a la estructura institucional de la Sociedad en un periodo complejo de la historia de Galicia.'],['Vicente Riestra Calderón','1947 — 1967','Presidió la Sociedad durante dos décadas, sosteniendo su continuidad organizativa y su actividad pública.'],['Augusto García Sánchez','1967 — 1978','Dio continuidad a la vida institucional en una etapa de transformación social y renovación musical.'],['José Fernando Filgueira Valverde','1978 — 1996','Intelectual, investigador y director del Museo de Pontevedra, reforzó la dimensión cultural y patrimonial de la Coral.'],['Xosé Carlos Valle Pérez','1996 — 2026','Presidió la Sociedad durante casi treinta años, incluyendo el 75 aniversario y la preparación y celebración del centenario.'],['José Raposeiras Correa','2026 — actualidad','Presidente de la nueva etapa posterior al centenario, orientada a la continuidad artística, la conservación de la memoria y la apertura de nuevos proyectos.']];

const panos=[['El Pano de Boca','Diseñado en 1925, incorporó la figura del rey David del Pórtico das Praterías y el nombre de la Sociedad en letras de inspiración románica. De aquella composición nació la imagen que sigue identificando a la Coral.'],['El pórtico románico','Utilizado en la parte religiosa de los primeros conciertos, creaba un espacio escénico solemne y convertía la actuación coral en una experiencia visual completa.'],['El rosetón ojival','Concebido para acompañar el Exultate Deo de Palestrina, fue una de las escenografías más celebradas de los primeros programas.'],['La ventana nocturna','Reservada para la música popular, evocaba una ventana iluminada por la luna y establecía un diálogo poético entre el repertorio y la escena.']];

const legado=[['Un repertorio con identidad','Desde sus inicios la Coral hizo convivir la polifonía sacra y profana, los madrigales, la música histórica, las Cantigas de Santa María y las armonizaciones del canto popular gallego.'],['Una embajadora cultural','A lo largo de más de un siglo llevó el nombre de Pontevedra por numerosas ciudades de Galicia, España, Portugal, Francia, Argentina, Uruguay y Andorra.'],['Memoria sonora','Las grabaciones realizadas en distintas épocas permiten seguir la evolución interpretativa de la agrupación y constituyen una parte esencial de su patrimonio.'],['Archivo documental y artístico','Partituras, programas de mano, fotografías, actas, carteles, correspondencia, recortes de prensa y paños escénicos forman un fondo histórico de extraordinario valor.'],['Una comunidad entre generaciones','La historia de la Sociedad no se explica solo por los conciertos o las distinciones, sino por la entrega continuada de cientos de cantores, directoras, directores y personas colaboradoras.'],['Un patrimonio vivo','La mejor manera de conservar esta memoria es mantenerla en movimiento: cantando, investigando, compartiendo e incorporando nuevas generaciones al proyecto.'],['Distinciones y reconocimientos','A lo largo de su historia, la Sociedad recibió numerosos premios, medallas y homenajes que reconocen su contribución a la música, a la cultura gallega y a la vida de la ciudad.']];
---

<SpanishPublicLayout title="Historia" description="Historia de la Sociedad Coral Polifónica de Pontevedra desde su fundación en 1925.">
<main class="historia-page">
<section id="archivo" class="archive-nav" aria-label="Secciones de la historia"><div class="archive-nav-grid">{secciones.map((sec,index)=><button class:list={['archive-tab',index===0&&'active']} type="button" data-tab={sec.id} aria-controls={`panel-${sec.id}`} aria-selected={index===0?'true':'false'}><span class="tab-number">{sec.numero}</span><span class="tab-meta">{sec.subtitulo}</span><strong>{sec.titulo}</strong></button>)}</div></section>
<section class="archive-content">
<div id="panel-origenes" class="archive-panel active" role="tabpanel"><header class="section-heading"><p class="section-kicker">1924 — 1926</p><h2>El nacimiento de una idea</h2><p>La Polifónica nació en un momento de excepcional vitalidad cultural. Su novedad estuvo en concebir el canto coral como una obra colectiva en la que música, lengua, arte y compromiso con la cultura gallega formaban parte de un mismo proyecto.</p></header><div class="story-list">{origenes.map((fito,index)=><article class="story-item"><div class="story-marker"><span>{String(index+1).padStart(2,'0')}</span></div><div class="story-card"><div class="story-meta"><span>{fito.ano}</span><span>{fito.etiqueta}</span></div><h3>{fito.titulo}</h3><p>{fito.texto}</p><p class="story-detail">{fito.detalle}</p></div></article>)}</div></div>
<div id="panel-cronologia" class="archive-panel" role="tabpanel"><header class="section-heading"><p class="section-kicker">1926 — actualidad</p><h2>Una historia en movimiento</h2><p>Una selección de momentos que explican la proyección, la continuidad y la capacidad de renovación de la Sociedad.</p></header><div class="chronology-grid">{cronologia.map((fito)=><article class="chronology-card"><span class="chronology-year">{fito[0]}</span><h3>{fito[1]}</h3><p>{fito[2]}</p></article>)}</div></div>
<div id="panel-direccion" class="archive-panel" role="tabpanel"><header class="section-heading"><p class="section-kicker">Dirección musical</p><h2>Nueve etapas, una misma voz</h2><p>Cada dirección dejó una huella propia. Juntas forman una línea de continuidad que explica la personalidad musical de la Sociedad a lo largo de más de un siglo.</p></header><div class="people-list">{directores.map((dir,index)=><article class="person-card"><div class="person-index">{String(index+1).padStart(2,'0')}</div><div><p class="person-period">{dir[1]}</p><h3>{dir[0]==='Nanette Sánchez Ordaz'?<a href="/es/directora">{dir[0]}</a>:dir[0]}</h3><p>{dir[2]}</p></div></article>)}</div></div>
<div id="panel-presidencias" class="archive-panel" role="tabpanel"><header class="section-heading"><p class="section-kicker">Memoria institucional</p><h2>La responsabilidad de dar continuidad</h2><p>Las sucesivas presidencias sostuvieron la vida organizativa de la Sociedad, protegieron su patrimonio e hicieron posible que el proyecto atravesase épocas históricas muy diferentes.</p></header><div class="presidency-grid">{presidentes.map((pres)=><article class="presidency-card"><span>{pres[1]}</span><h3>{pres[0]}</h3><p>{pres[2]}</p></article>)}</div></div>
<div id="panel-castelao" class="archive-panel" role="tabpanel"><header class="section-heading"><p class="section-kicker">Arte y música</p><h2>Castelao: una escena para la voz</h2><p>Castelao no se limitó a acompañar la fundación de la Sociedad. Concibió para ella una imagen y una escenografía que transformaron los conciertos en una experiencia artística total.</p></header><p class="castelao-intro">Su trabajo unió el repertorio, el espacio y la identidad gallega. Los paños escénicos —ocho de ellos conservados en el Museo de Pontevedra— se convirtieron en una de las aportaciones más singulares de la historia visual de la Coral.</p><div class="scenography-grid">{panos.map((pano,index)=><article class="scenography-card"><span>{String(index+1).padStart(2,'0')}</span><h3>{pano[0]}</h3><p>{pano[1]}</p></article>)}</div></div>
<div id="panel-legado" class="archive-panel" role="tabpanel"><header class="section-heading"><p class="section-kicker">Patrimonio vivo</p><h2>Una memoria que sigue cantando</h2></header><div class="legacy-grid">{legado.map((item)=><article class="legacy-card"><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div>
<div id="panel-historico" class="archive-panel" role="tabpanel"><header class="section-heading"><p class="section-kicker">1925 — actualidad</p><h2>Histórico de conciertos</h2><p>Consulta por décadas las actuaciones documentadas de la Sociedad y la memoria de más de un siglo de actividad musical.</p></header><a class="history-cta" href="/es/historico-conciertos">Abrir el histórico de conciertos <span aria-hidden="true">→</span></a></div>
</section>
</main>
<script>
const tabs=[...document.querySelectorAll<HTMLButtonElement>('.archive-tab')];const panels=[...document.querySelectorAll<HTMLElement>('.archive-panel')];tabs.forEach((tab)=>tab.addEventListener('click',()=>{tabs.forEach((t)=>{t.classList.toggle('active',t===tab);t.setAttribute('aria-selected',String(t===tab))});panels.forEach((panel)=>panel.classList.toggle('active',panel.id===`panel-${tab.dataset.tab}`));}));
</script>
</SpanishPublicLayout>
<style>
.historia-page{--wine:#6a1b29;--gold:#b79043;--ink:#292525;--muted:#68615d;--paper:#faf8f3;--line:#ded8ce;padding:1rem 0 6rem}.archive-nav,.archive-content{width:min(100% - 2rem,960px);margin-inline:auto}.archive-nav{margin:1rem auto 2.4rem}.archive-nav-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line);background:#fff}.archive-tab{min-height:88px;padding:.8rem;border:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff;color:var(--ink);text-align:left;cursor:pointer}.archive-tab.active{background:#f4f0e6;box-shadow:inset 0 -3px 0 var(--wine)}.archive-tab span,.archive-tab strong{display:block}.tab-number{color:var(--gold);font-size:.65rem;font-weight:800}.tab-meta{margin:.18rem 0;color:var(--muted);font-size:.63rem;text-transform:uppercase}.archive-tab strong{font-size:.9rem}.archive-panel{display:none}.archive-panel.active{display:block}.section-heading{max-width:760px;margin:0 auto 2.5rem;text-align:center}.section-kicker{margin:0 0 .7rem;color:var(--gold);font-size:.72rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.section-heading h2{margin:0;color:var(--wine);font-size:clamp(1.8rem,3vw,2.5rem)}.section-heading>p:last-child{color:var(--muted);line-height:1.75}.story-list,.people-list{display:grid;gap:1rem}.story-item,.person-card{display:grid;grid-template-columns:42px 1fr;gap:1rem}.story-marker,.person-index{color:var(--gold);font-size:.7rem;font-weight:800;padding-top:1.2rem}.story-card,.person-card>div:last-child{padding:1.25rem;border:1px solid var(--line);background:#fff}.story-meta{display:flex;gap:1rem;color:var(--gold);font-size:.7rem;font-weight:700;text-transform:uppercase}.story-card h3,.chronology-card h3,.person-card h3,.presidency-card h3,.scenography-card h3,.legacy-card h3{margin:.45rem 0;color:var(--wine);font-size:1.05rem}.story-card p,.chronology-card p,.person-card p,.presidency-card p,.scenography-card p,.legacy-card p,.castelao-intro{color:var(--muted);line-height:1.7}.story-detail{font-size:.9rem;font-style:italic}.chronology-grid,.presidency-grid,.scenography-grid,.legacy-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.chronology-card,.presidency-card,.scenography-card,.legacy-card{padding:1.25rem;border:1px solid var(--line);background:#fff}.chronology-year,.presidency-card>span,.scenography-card>span,.person-period{color:var(--gold);font-size:.72rem;font-weight:800;text-transform:uppercase}.castelao-intro{max-width:760px;margin:0 auto 2rem}.history-cta{display:inline-flex;gap:.5rem;padding:.85rem 1.2rem;background:var(--wine);color:#fff;text-decoration:none;font-size:.78rem;font-weight:700;text-transform:uppercase}
@media(max-width:720px){.archive-nav-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.chronology-grid,.presidency-grid,.scenography-grid,.legacy-grid{grid-template-columns:1fr}}@media(max-width:460px){.archive-nav-grid{grid-template-columns:1fr}.story-item,.person-card{grid-template-columns:1fr}.story-marker,.person-index{padding-top:0}}
</style>