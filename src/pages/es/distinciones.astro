---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';

const distinciones = [
  {
    ano: '1950–1951',
    fecha: '25 aniversario · entrega del 22 de enero de 1951',
    titulo: 'Primera Medalla de Plata de la ciudad de Pontevedra',
    entidad: 'Concello de Pontevedra',
    texto: 'Concedida en el marco del 25 aniversario de la Sociedad, fue uno de los primeros grandes reconocimientos institucionales a la trayectoria artística y cultural de la Polifónica.',
    acto: 'La medalla fue entregada solemnemente en el Teatro Principal de Pontevedra el 22 de enero de 1951. El alcalde Remigio Hevia Marinas se la impuso al director Antonio Iglesias Vilarelle en representación de la Sociedad.',
    destacada: false
  },
  {
    ano: '1959',
    fecha: '22 de noviembre de 1959',
    titulo: 'Primera Medalla de Plata de Santa Cecilia de Marín',
    entidad: 'Asociación de Cultura e Arte «Santa Cecilia» de Marín · actual Ateneo Santa Cecilia',
    texto: 'La Polifónica recibió la Primera Medalla de Plata de la histórica entidad cultural marinense, creada para promover la música, las artes y la vida cultural de la villa.',
    acto: 'La imposición tuvo lugar en el Teatro Avenida de Marín durante un concierto celebrado el 22 de noviembre de 1959, festividad de Santa Cecilia y séptimo aniversario de la entidad.',
    destacada: false
  },
  {
    ano: '1975',
    fecha: 'Año de las Bodas de Oro',
    titulo: 'Premio Amigos de Pontevedra 1975',
    entidad: 'Asociación de Amigos de Pontevedra',
    texto: 'Reconocimiento concedido por la Asociación de Amigos de Pontevedra en el año en que la Sociedad celebraba su cincuentenario, incorporándose a la memoria de las Bodas de Oro de la Polifónica.',
    acto: 'La concesión en 1975 aparece recogida tanto en la documentación histórica de la Sociedad como en fuentes institucionales posteriores. El galardón reconoce la vinculación de la Polifónica con la cultura y con el prestigio de la ciudad de Pontevedra.',
    destacada: false
  },
  {
    ano: 'Reconocimiento histórico',
    fecha: 'Fecha pendiente de documentar',
    titulo: 'Colaboradora de Honor de la AEDET',
    entidad: 'Asociación Española de Escritores de Turismo (AEDET)',
    texto: 'La documentación histórica de la Sociedad recoge su condición de Colaboradora de Honor de la AEDET, una entidad estatal vinculada a la comunicación, a la promoción turística y a la proyección cultural de los territorios.',
    acto: 'AEDET fue una de las organizaciones pioneras del periodismo y de la literatura de viajes y turismo en España y antecedente de la posterior Federación Española de Periodistas y Escritores de Turismo.',
    destacada: false
  },
  {
    ano: 'Reconocimiento histórico',
    fecha: 'Fecha pendiente de documentar',
    titulo: 'Medalla de Plata de las Rutas Cicloturísticas del Románico',
    entidad: 'Rutas Cicloturísticas del Románico',
    texto: 'Distinción concedida por una iniciativa pontevedresa que unió durante décadas el cicloturismo con la investigación, la divulgación cultural y la defensa del patrimonio románico.',
    acto: 'La relación entre ambas instituciones se prolongó en el tiempo. En 2009, la Fundación Cultural Rutas del Románico organizó en la iglesia de San Francisco de Pontevedra un concierto de la Polifónica en homenaje al padre Luis María Fernández Espinosa.',
    destacada: false
  },
  {
    ano: '2000–2001',
    fecha: 'Acuerdo del 18 y entrega del 20 de enero de 2001',
    titulo: 'Premio Cidade de Pontevedra 2000',
    entidad: 'Concello de Pontevedra',
    texto: 'Concedido por la labor de recuperación y difusión de la música y del canto coral, por la contribución de varias generaciones a la identidad cultural de Pontevedra y por la intensa actividad desarrollada durante el 75 aniversario y el Año Castelao.',
    acto: 'La Corporación Municipal aprobó el premio por unanimidad en la sesión extraordinaria del 18 de enero de 2001. La Sesión de Honores y la entrega del diploma, de la certificación y de la placa conmemorativa se celebraron en el Teatro Principal el 20 de enero.',
    destacada: true
  },
  {
    ano: '2022',
    fecha: 'Agosto de 2022',
    titulo: 'Diploma de Amigos de Pontevedra',
    entidad: 'Asociación de Amigos de Pontevedra',
    texto: 'Nuevo reconocimiento público de la entidad a la trayectoria y a la presencia de la Polifónica en la vida cultural de la ciudad.',
    acto: 'La entrega del diploma tuvo lugar en agosto de 2022, con la participación de integrantes de la Sociedad.',
    destacada: false
  },
  {
    ano: '2025',
    fecha: 'Emisión del 26 de marzo · presentación del 8 de abril',
    titulo: 'Sello conmemorativo y presentación oficial del centenario',
    entidad: 'Correos y Fábrica Nacional de Moneda y Timbre',
    texto: 'Correos dedicó a la Sociedad un sello de la serie «Efemérides» con motivo del centenario de su fundación. La emisión reproduce el emblema de la Coral sobre una imagen de la agrupación en plena actuación.',
    acto: 'El sello fue emitido el 26 de marzo de 2025 y presentado oficialmente el 8 de abril en el Edificio Castelao del Museo de Pontevedra, en el marco de la exposición del centenario. El acto concluyó con el tradicional matasellos de honor. La emisión tuvo una tirada de 70.000 ejemplares y un valor postal de 2 euros.',
    destacada: true
  },
  {
    ano: '2025',
    fecha: '4 de junio de 2025',
    titulo: 'Pontevedreses del Año — Música y Cultura',
    entidad: 'Diario de Pontevedra',
    texto: 'La Sociedad fue distinguida en la categoría de Música y Cultura en el año de su centenario, como reconocimiento a cien años de actividad artística y de compromiso con la ciudad.',
    acto: 'La gala se celebró en el Auditorio de Afundación de Pontevedra. La Coral cerró el acto interpretando Si vas a San Benitiño, de Antonio Blanco Porto.',
    destacada: true
  },
  {
    ano: '2025',
    fecha: '11 de diciembre de 2025',
    titulo: 'Premio Otero Pedrayo 2025',
    entidad: 'Las cuatro diputaciones gallegas y la Fundación Otero Pedrayo',
    texto: 'Uno de los grandes reconocimientos del centenario, concedido por la contribución continuada de la Sociedad a la preservación, difusión y dignificación del patrimonio musical y cultural gallego.',
    acto: 'La ceremonia se celebró en el Salón de Plenos del Pazo da Deputación de Pontevedra. Fue conducida por la periodista Belén López e incluyó la laudatio de Ángeles Tilve, directora del Museo de Pontevedra, intervenciones institucionales y una audición de la Coral.',
    destacada: true
  },
  {
    ano: '2025',
    fecha: 'Acuerdo del 1 de febrero · entrega del 13 de diciembre',
    titulo: 'Medalla de Oro «Marcial del Adalid»',
    entidad: 'Real Academia Galega de Belas Artes',
    texto: 'Concedida por la trayectoria acreditada de un siglo de actividad artística del más alto nivel y por el lugar de la Sociedad entre las instituciones musicales históricas de Galicia.',
    acto: 'La Real Academia acordó la concesión el 1 de febrero de 2025. El diploma y la medalla se entregaron el 13 de diciembre en el Edificio Castelao del Museo de Pontevedra. La académica Rosa Cedrón pronunció la laudatio y, después de la entrega, la Coral ofreció un recital.',
    detalle: 'En su intervención, Rosa Cedrón realizó un recorrido por la historia centenaria de la Sociedad, desde la fundación y la primera presentación pública hasta su proyección dentro y fuera de Galicia. Subrayó especialmente el papel de la Coral en la difusión de la polifonía clásica y sacra y de la música popular gallega armonizada, así como la contribución de las sucesivas generaciones de cantores, direcciones y personas vinculadas a la entidad.',
    repertorio: 'El recital incluyó Si vas a San Benitiño, de Antonio Blanco Porto; Unha noite na eira do trigo, de M. Ángel Viro con texto de Curros Enríquez; y Deitadiño está nas pallas, popular con arreglo de Luís Bolón.',
    documento: '/docs/distincions/laudatio-marcial-del-adalid.pdf',
    documentoTexto: 'Leer la laudatio completa',
    destacada: true
  },
  {
    ano: '2026',
    fecha: '28 de marzo de 2026',
    titulo: 'Vieira de Honor a la Calidad Artística',
    entidad: 'Fundación Cultural da Vieira · Enxebre Orde da Vieira',
    texto: 'Distinción concedida a la Sociedad por su trayectoria y por su contribución a la difusión de la música coral gallega y de la galleguidad.',
    acto: 'La entrega tuvo lugar en Madrid durante el LVIII Cabido Xeral da Enxebre Orde da Vieira, celebrado el 28 de marzo de 2026. El reconocimiento fue recibido en el marco de un encuentro dedicado a distinguir a personas y entidades que mantienen viva y prestigian la cultura gallega.',
    documento: '/docs/distincions/diploma-vieira-de-honra.pdf',
    documentoTexto: 'Ver el diploma de la Vieira de Honor',
    destacada: true
  }
];

const hitosCentenario = [
  {
    titulo: 'Un siglo reconocido',
    texto: 'Los galardones recibidos en 2025 hicieron visible, desde ámbitos periodísticos, institucionales y académicos, la dimensión musical, cultural y patrimonial de la Sociedad.'
  },
  {
    titulo: 'La música dentro de las ceremonias',
    texto: 'La Coral no fue una presencia pasiva en los actos: participó musicalmente en las entregas de Pontevedreses del Año, del Premio Otero Pedrayo y de la Medalla Marcial del Adalid.'
  },
  {
    titulo: 'Documentación abierta',
    texto: 'La relación seguirá completándose con diplomas, fotografías, actas y fechas exactas procedentes del archivo de la Sociedad y de otras instituciones.'
  }
];
---

<SpanishPublicLayout
  title="Distinciones"
  description="Premios, medallas y reconocimientos recibidos por la Sociedad Coral Polifónica de Pontevedra."
>
  <main class="distincions-page">
    <section class="intro-section">
      <p class="section-kicker">Centenario · 2025–2026</p>
      <h2>Reconocimientos de un siglo de música</h2>
      <p>
        Muchas de estas distinciones forman parte de los actos del centenario.
        Conciertos, conferencias, exposiciones y homenajes pueden consultarse
        en la página específica de la celebración.
      </p>
      <a href="/es/centenario" class="btn-centenario">Visitar la página del centenario</a>
    </section>

    <section class="intro-section">
      <p class="section-kicker">Memoria institucional</p>
      <h2>El reconocimiento a una obra colectiva</h2>
      <p>
        Cada distinción pertenece a las generaciones de cantoras, cantores, direcciones musicales,
        juntas directivas y personas colaboradoras que hicieron posible la continuidad de la
        Sociedad Coral Polifónica de Pontevedra desde 1925.
      </p>
    </section>

    <section id="relacion" class="awards-section" aria-label="Relación de distinciones">
      <div class="awards-list">
        {distinciones.map((item, index) => (
          <article class={`award-card ${item.destacada ? 'featured' : ''}`}>
            <div class="award-index">{String(index + 1).padStart(2, '0')}</div>
            <div class="award-content">
              <div class="award-meta">
                <span>{item.ano}</span>
                <span>{item.fecha}</span>
              </div>
              <h2>{item.titulo}</h2>
              <p class="award-entity">{item.entidad}</p>
              <p>{item.texto}</p>

              <div class="award-event">
                <strong>Acto y documentación</strong>
                <p>{item.acto}</p>
              </div>

              {item.detalle && (
                <details class="award-details">
                  <summary>Resumen de la laudatio</summary>
                  <p>{item.detalle}</p>
                  {item.repertorio && (
                    <p class="award-repertoire"><strong>Recital:</strong> {item.repertorio}</p>
                  )}
                </details>
              )}

              {item.documento && (
                <a
                  class="document-link"
                  href={item.documento}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.documentoTexto}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="centenary-section">
      <header class="section-heading">
        <p class="section-kicker">Centenario · 2025</p>
        <h2>Un año de especial significado</h2>
        <p>
          Los reconocimientos del centenario tuvieron una dimensión institucional,
          pero también musical: en cada acto, la Sociedad volvió a hacer de su voz
          la mejor expresión de su historia.
        </p>
      </header>

      <div class="centenary-grid">
        {hitosCentenario.map((item, index) => (
          <article class="centenary-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="documentation-note">
      <p class="section-kicker">Memoria documental</p>
      <h2>Premios que forman parte de nuestro patrimonio</h2>
      <p>
        Diplomas, medallas, sellos, programas y fotografías conservan la memoria
        material de estos reconocimientos y permiten seguir ampliando la historia
        institucional de la Sociedad.
      </p>
      <a href="/es/la-coral" class="back-link">Volver a La Coral <span aria-hidden="true">→</span></a>
    </section>
  </main>
</SpanishPublicLayout>

<style>
  .distincions-page {
    --wine: var(--color-principal, #5c1926);
    --gold: var(--color-acento, #a3821a);
    --ink: #201d1d;
    --muted: #6f6965;
    --paper: #f7f5f0;
    --line: #ded8ce;
    background: #fff;
    color: var(--ink);
    padding-bottom: 7rem;
  }

  .section-kicker {
    margin: 0 0 1rem;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .back-link span {
    color: var(--gold);
    font-size: 1.05rem;
  }

  .intro-section,
  .awards-section,
  .centenary-section,
  .documentation-note {
    width: min(980px, calc(100% - 3rem));
    margin-right: auto;
    margin-left: auto;
  }

  .intro-section {
    max-width: 760px;
    padding: 5.5rem 0 4rem;
    text-align: center;
  }

  .intro-section h2,
  .section-heading h2,
  .documentation-note h2 {
    margin: 0;
    color: var(--wine);
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .intro-section > p:last-child,
  .section-heading > p:last-child,
  .documentation-note > p {
    margin: 1.4rem auto 0;
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.85;
  }

  .awards-list {
    display: grid;
    gap: 1.35rem;
  }

  .award-card {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 1.5rem;
    padding: 2.2rem;
    border: 1px solid var(--line);
    background: white;
  }

  .award-card:nth-child(even) {
    background: var(--paper);
    border-left: 4px solid var(--gold);
  }

  .award-card:nth-child(odd) {
    background: white;
    border-left: 4px solid transparent;
  }

  .award-index {
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding-top: 0.35rem;
  }

  .award-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    margin-bottom: 0.85rem;
  }

  .award-meta span {
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .award-content h2 {
    margin: 0;
    color: var(--wine);
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .award-content > p,
  .award-event p,
  .centenary-card p {
    color: #4c4744;
    line-height: 1.8;
  }

  .award-entity {
    margin-top: 0.55rem;
    color: var(--ink) !important;
    font-weight: 700;
  }

  .award-event {
    margin-top: 1.25rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .award-event strong {
    color: var(--wine);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .award-event p {
    margin-bottom: 0;
    font-size: 0.93rem;
  }

  .award-details {
    margin-top: 1rem;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid var(--line);
  }

  .award-details summary {
    color: var(--wine);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .award-details p {
    color: #4c4744;
    line-height: 1.75;
  }

  .award-repertoire {
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.93rem;
  }

  .document-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--gold);
    color: var(--wine);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .document-link:hover,
  .document-link:focus-visible {
    background: var(--wine);
    color: white;
  }

  .document-link span {
    color: var(--gold);
    font-size: 1rem;
  }

  .centenary-section {
    padding-top: 6rem;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .centenary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  .centenary-card {
    padding: 2rem;
    background: var(--wine);
  }

  .centenary-card > span {
    color: #e1ca7b;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .centenary-card h3 {
    margin: 1.1rem 0 0;
    color: white;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .centenary-card p {
    color: rgba(255, 255, 255, 0.78);
  }

  .documentation-note {
    margin-top: 5rem;
    padding: 4rem 2.5rem;
    background: var(--paper);
    text-align: center;
  }

  .back-link {
    margin-top: 2rem;
    color: var(--wine);
  }

  .btn-centenario {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.85rem 2rem;
    background: var(--wine);
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    border-radius: 4px;
  }

  .btn-centenario:hover {
    background: var(--gold);
  }

  @media (max-width: 760px) {
    .centenary-grid {
      grid-template-columns: 1fr;
    }

    .award-card {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 1.6rem;
    }

    .award-index {
      padding-top: 0;
    }
  }

  @media (max-width: 520px) {
    .intro-section,
    .awards-section,
    .centenary-section,
    .documentation-note {
      width: min(100% - 2rem, 980px);
    }

    .documentation-note {
      padding: 3rem 1.4rem;
    }
  }
</style>
