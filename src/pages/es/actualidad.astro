---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';
---

<SpanishPublicLayout title="Actualidad" description="Publicaciones, entrevistas y noticias de la Sociedad Coral Polifónica de Pontevedra.">
<main class="actualidade">
<header class="cabeceira"><p class="sobrelinea">Sociedad Coral Polifónica de Pontevedra</p><h1>Actualidad</h1><p class="introducion">Publicaciones, entrevistas y noticias sobre la vida de la Coral.</p></header>
<div id="actualidade-status" class="status" role="status" aria-live="polite"><span class="status-mark" aria-hidden="true"></span><span id="status-text">Cargando las publicaciones…</span></div>
<section id="publicacion-destacada" class="destacada" aria-labelledby="destacada-titulo" hidden><p class="etiqueta">Publicación destacada</p><h2 id="destacada-titulo"><a id="destacada-titulo-ligazon" href="/"></a></h2><div class="metadatos"><span id="destacada-tipo"></span><span id="destacada-medio"></span><time id="destacada-data"></time></div><a id="destacada-ligazon" class="ligazon-principal" href="/">Leer la ficha completa <span aria-hidden="true">→</span></a></section>
<section id="arquivo-publicacions" class="arquivo" aria-labelledby="ultimas-publicacions" hidden><div class="titulo-seccion"><h2 id="ultimas-publicacions">Últimas publicaciones</h2><span id="total-publicacions" aria-label="Número de publicaciones"></span></div><div id="lista-publicacions" class="lista-publicacions"></div></section>
<div id="error-actions" class="error-actions" hidden><button id="retry-button" type="button">Intentar de nuevo</button></div>
</main>
<script is:inline>
(()=>{const API_URL='https://script.google.com/macros/s/AKfycbyFrlkJW9Ur1gRVRtIXOucfdr7zFzVGiL_V3KCHbot8IkNvoAXylP7-Dta2X-ki7bEh/exec?recurso=publicacions';const status=document.getElementById('actualidade-status');const statusText=document.getElementById('status-text');const destacada=document.getElementById('publicacion-destacada');const destacadaTitulo=document.getElementById('destacada-titulo-ligazon');const destacadaTipo=document.getElementById('destacada-tipo');const destacadaMedio=document.getElementById('destacada-medio');const destacadaData=document.getElementById('destacada-data');const destacadaLigazon=document.getElementById('destacada-ligazon');const arquivo=document.getElementById('arquivo-publicacions');const total=document.getElementById('total-publicacions');const lista=document.getElementById('lista-publicacions');const errorActions=document.getElementById('error-actions');const retryButton=document.getElementById('retry-button');const clean=(value)=>String(value??'').trim();const first=(o,keys,fallback='')=>{for(const k of keys){const v=clean(o?.[k]);if(v)return v}return clean(fallback)};const isTrue=(value)=>value===true||['true','si','sí','yes','y','1'].includes(clean(value).toLowerCase());const safeInternalPdf=(value)=>{const route=clean(value);return /^\/documentos\/publicacions\/[a-z0-9._-]+\.pdf$/i.test(route)?route:''};const visibleDate=(isoDate)=>{if(!/^\d{4}-\d{2}-\d{2}$/.test(isoDate))return isoDate;try{return new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${isoDate}T00:00:00Z`))}catch{return isoDate}};const normalisePublication=(p)=>({id:clean(p?.id),titulo:first(p,['tituloEs','titulo_es','Titulo_ES','Título_ES'],p?.titulo),tipo:first(p,['tipoEs','tipo_es','Tipo_ES'],p?.tipo),medio:clean(p?.medio),data:clean(p?.data),destacada:isTrue(p?.destacada),rutaWeb:safeInternalPdf(p?.rutaWeb)});const createMeta=(p)=>{const wrapper=document.createElement('div');const date=document.createElement('time');const type=document.createElement('span');wrapper.className='publicacion-meta';date.dateTime=p.data;date.textContent=visibleDate(p.data);type.textContent=p.tipo;wrapper.append(date,type);return wrapper};const createPublication=(p)=>{const article=document.createElement('article');const title=document.createElement('h3');const titleLink=document.createElement('a');const footer=document.createElement('div');const media=document.createElement('span');const readLink=document.createElement('a');const arrow=document.createElement('span');article.className='publicacion';titleLink.href=p.rutaWeb;titleLink.textContent=p.titulo;title.append(titleLink);footer.className='publicacion-pe';media.textContent=p.medio;readLink.href=p.rutaWeb;readLink.setAttribute('aria-label',`Leer la ficha completa: ${p.titulo}`);readLink.append(document.createTextNode('Leer ficha '));arrow.setAttribute('aria-hidden','true');arrow.textContent='→';readLink.append(arrow);footer.append(media,readLink);article.append(createMeta(p),title,footer);return article};const render=(publications)=>{const cleanPublications=publications.map(normalisePublication).filter((p)=>p.titulo&&p.rutaWeb).sort((a,b)=>b.data.localeCompare(a.data));if(!cleanPublications.length){status.classList.remove('is-loading','is-error');statusText.textContent='No hay publicaciones disponibles en este momento.';return}const featured=cleanPublications.find((p)=>p.destacada)??cleanPublications[0];const remaining=cleanPublications.filter((p)=>p!==featured);destacadaTitulo.textContent=featured.titulo;destacadaTitulo.href=featured.rutaWeb;destacadaTipo.textContent=featured.tipo;destacadaMedio.textContent=featured.medio;destacadaData.dateTime=featured.data;destacadaData.textContent=visibleDate(featured.data);destacadaLigazon.href=featured.rutaWeb;destacada.hidden=false;lista.replaceChildren(...remaining.map(createPublication));total.textContent=String(remaining.length);arquivo.hidden=remaining.length===0;status.hidden=true};const loadPublications=async()=>{status.hidden=false;status.classList.add('is-loading');status.classList.remove('is-error');statusText.textContent='Cargando las publicaciones…';destacada.hidden=true;arquivo.hidden=true;errorActions.hidden=true;retryButton.disabled=true;try{const response=await fetch(API_URL,{method:'GET',cache:'no-store',redirect:'follow'});if(!response.ok)throw new Error(`Respuesta HTTP ${response.status}`);const data=await response.json();if(!data?.ok||!Array.isArray(data.publicacions))throw new Error('Formato de respuesta no válido');render(data.publicacions)}catch(error){status.classList.remove('is-loading');status.classList.add('is-error');statusText.textContent='No ha sido posible cargar ahora las publicaciones.';errorActions.hidden=false}finally{retryButton.disabled=false}};retryButton?.addEventListener('click',loadPublications);loadPublications()})();
</script>
</SpanishPublicLayout>
<style>
.actualidade{--wine:#6a1b29;--wine-dark:#49121d;--gold:#c5a059;--ink:#1f1f1f;--muted:#68625b;--paper:#fdfbf7;--soft:#f4f0e6;--line:rgba(106,27,41,.17);background:var(--paper);color:var(--ink);min-height:70vh;padding:clamp(3.5rem,7vw,6.5rem) clamp(1.25rem,5vw,5rem) clamp(4rem,8vw,7rem)}.cabeceira,.status,.destacada,.arquivo,.error-actions{width:min(1180px,100%);margin-inline:auto}.cabeceira{margin-bottom:clamp(3.5rem,7vw,6rem);text-align:center}.sobrelinea,.etiqueta{color:var(--wine);font-size:.82rem;font-weight:700;letter-spacing:.18em;margin:0 0 1rem;text-transform:uppercase}.cabeceira h1{color:var(--wine-dark);font-size:clamp(2.5rem,5.5vw,4.6rem);font-weight:700;letter-spacing:-.04em;line-height:.95;margin:0}.cabeceira h1::after{background:var(--gold);content:'';display:block;height:2px;margin:1.5rem auto 1.75rem;width:4rem}.introducion{color:var(--muted);font-size:clamp(1.1rem,2vw,1.35rem);line-height:1.65;margin:0 auto;max-width:710px}.status{align-items:center;background:var(--soft);color:var(--muted);display:flex;gap:.8rem;justify-content:center;min-height:8rem;padding:1.5rem;text-align:center}.status-mark{animation:pulse 1.1s ease-in-out infinite alternate;background:var(--gold);border-radius:999px;height:.55rem;width:.55rem}.status:not(.is-loading) .status-mark{animation:none}.status.is-error .status-mark{background:var(--wine)}.destacada{border-bottom:1px solid var(--line);border-top:1px solid var(--wine);padding:clamp(2.25rem,5vw,4.5rem) 0 clamp(3rem,6vw,5rem);position:relative}.destacada::before{background:var(--gold);content:'';height:3px;left:0;position:absolute;top:-1px;width:7rem}.destacada h2{font-size:clamp(1.9rem,4.5vw,4rem);font-weight:700;letter-spacing:-.045em;line-height:1.02;margin:0;max-width:1000px}.destacada h2 a,.publicacion h3 a{color:var(--wine-dark);text-decoration:none}.metadatos,.publicacion-meta{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;margin:1.3rem 0;color:var(--muted);font-size:.82rem}.ligazon-principal{display:inline-flex;gap:.55rem;color:var(--wine);font-size:.78rem;font-weight:700;text-decoration:none;text-transform:uppercase}.arquivo{padding-top:4rem}.titulo-seccion{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:1rem}.titulo-seccion h2{margin:0;color:var(--wine-dark);font-size:1.6rem}.titulo-seccion span{color:var(--gold);font-weight:800}.lista-publicacions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem}.publicacion{padding:1.5rem;border:1px solid var(--line);background:#fff}.publicacion h3{margin:.65rem 0 1.4rem;font-size:1.15rem;line-height:1.35}.publicacion-pe{display:flex;justify-content:space-between;gap:1rem;align-items:center;color:var(--muted);font-size:.8rem}.publicacion-pe a{color:var(--wine);font-weight:700;text-decoration:none}.error-actions{text-align:center;margin-top:1rem}.error-actions button{background:var(--wine);border:0;color:#fff;cursor:pointer;padding:.75rem 1.2rem;font:inherit}@keyframes pulse{from{opacity:.35;transform:scale(.85)}to{opacity:1;transform:scale(1.1)}}@media(max-width:720px){.lista-publicacions{grid-template-columns:1fr}.publicacion-pe{align-items:flex-start;flex-direction:column}}
</style>