---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';
---

<SpanishPublicLayout title="Histórico de conciertos" description="Histórico de conciertos de la Sociedad Coral Polifónica de Pontevedra desde 1925.">
  <main class="history-page container">
    <header class="history-hero">
      <p class="eyebrow">Archivo histórico</p>
      <h1>Un siglo de conciertos</h1>
      <div class="section-line-center"></div>
      <p>Explora por décadas la actividad concertística de la Sociedad Coral Polifónica de Pontevedra desde 1925.</p>
      <div id="history-summary" class="history-summary" aria-live="polite">Cargando el archivo…</div>
      <div class="history-actions">
        <button id="show-all-history" type="button">Ver todo el histórico</button>
        <a href="/arquivos/publico/documentos/concertos_scpp_1925_2026.pdf" target="_blank" rel="noopener noreferrer">Descargar histórico (.pdf)</a>
      </div>
    </header>

    <section id="arquivo-completo" class="history-browser" aria-labelledby="browser-title">
      <div class="history-toolbar">
        <div><p class="eyebrow">Consulta</p><h2 id="browser-title">Conciertos por décadas</h2></div>
        <label class="history-search"><span class="sr-only">Buscar en el histórico</span><input id="history-search" type="search" placeholder="Buscar año, número, concierto, ciudad o lugar" autocomplete="off" /></label>
      </div>
      <div id="history-years" class="history-years"></div>
      <p id="history-empty" class="history-state" hidden>No hay conciertos que coincidan con la búsqueda.</p>
      <p id="history-error" class="history-state error" hidden>No ha sido posible cargar el histórico. Inténtalo de nuevo en unos instantes.</p>
    </section>
  </main>

  <script>
    const endpoint='/api/concertos-historico';const years=document.querySelector('#history-years');const summary=document.querySelector('#history-summary');const search=document.querySelector('#history-search');const empty=document.querySelector('#history-empty');const errorState=document.querySelector('#history-error');const showAll=document.querySelector('#show-all-history');let conciertos=[];
    const normalizar=(value='')=>String(value).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();
    const escapar=(value='')=>String(value).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
    const first=(o,keys,fallback='')=>{for(const k of keys){const v=String(o?.[k]??'').trim();if(v)return v}return String(fallback??'').trim()};
    const formatarData=(c)=>{const texto=first(c,['dataTextoHistoricaEs','fechaTextoHistorica','DataTextoHistorica_ES'],c.dataTextoHistorica);if(texto)return texto;if(!c.data)return'Fecha no documentada';const date=new Date(c.data+'T12:00:00');return Number.isNaN(date.getTime())?c.data:new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long',year:'numeric'}).format(date)};
    const inicioPeriodo=(ano)=>1925+Math.floor((Number(ano)-1925)/10)*10;const etiquetaPeriodo=(inicio)=>`${inicio}–${Math.min(inicio+9,2026)}`;
    const nombre=(c)=>first(c,['nomeEs','nombreEs','Nome_ES','Nombre_ES'],c.nome||c.nombre||'');
    const nomeGenerico=(c)=>{const nome=normalizar(nombre(c)).replaceAll(' ','');const numero=normalizar(c.numeroConcerto).replaceAll(' ','');return nome===`concierto nº ${numero}`.replaceAll(' ','')||nome===`concerto nº ${numero}`.replaceAll(' ','')||nome===`concerto n.º ${numero}`.replaceAll(' ','')||nome===`concierto numero ${numero}`.replaceAll(' ','')};
    const descripcion=(c)=>first(c,['descricionEs','descripcionEs','Descricion_ES','Descripcion_ES'],c.descricion||c.descripcion||(nomeGenerico(c)?'':nombre(c))||'Sin descripción documentada');
    function dibujar(){if(!(years instanceof HTMLElement))return;const query=normalizar(search instanceof HTMLInputElement?search.value:'');const exactYear=/^\d{4}$/.test(query);const filtered=conciertos.filter((c)=>{if(exactYear)return String(c.ano||'')===query;return !query||normalizar([c.ano,c.numeroConcerto,c.data,c.dataTextoHistorica,nombre(c),c.cidade,c.ciudad,c.lugar,descripcion(c)].join(' ')).includes(query)});const grouped=new Map();filtered.forEach((c)=>{const ano=Number(c.ano);const periodo=Number.isFinite(ano)?inicioPeriodo(ano):'Sin fecha';if(!grouped.has(periodo))grouped.set(periodo,[]);grouped.get(periodo).push(c)});const periodos=Array.from(grouped.keys()).sort((a,b)=>{if(a==='Sin fecha')return 1;if(b==='Sin fecha')return-1;return Number(a)-Number(b)});const isOpen=query.length>0?'open':'';years.innerHTML=periodos.map((periodo)=>{const items=grouped.get(periodo).sort((a,b)=>(Number(a.ordeHistorica)||0)-(Number(b.ordeHistorica)||0));const etiqueta=periodo==='Sin fecha'?periodo:`Década de ${etiquetaPeriodo(periodo)}`;return `<details class="card-decada" ${isOpen}><summary><div><span class="period-label">Período histórico</span><strong>${escapar(etiqueta)}</strong></div><div class="period-meta"><span>${items.length} concierto${items.length===1?'':'s'}</span><b aria-hidden="true">▼</b></div></summary><div class="table-wrap"><table><thead><tr><th>Nº</th><th>Fecha</th><th>Localidad</th><th>Lugar</th><th>Descripción</th></tr></thead><tbody>${items.map((c)=>`<tr><td data-label="Nº" class="number">${escapar(c.numeroConcerto||'—')}</td><td data-label="Fecha">${escapar(formatarData(c))}</td><td data-label="Localidad">${escapar(c.cidade||c.ciudad||'—')}</td><td data-label="Lugar"><strong>${escapar(c.lugar||'—')}</strong></td><td data-label="Descripción">${escapar(descripcion(c))}</td></tr>`).join('')}</tbody></table></div></details>`}).join('');if(summary instanceof HTMLElement)summary.textContent=`${filtered.length} concierto${filtered.length===1?'':'s'} documentado${filtered.length===1?'':'s'} · ${periodos.length} ${periodos.length===1?'década':'décadas'}`;if(empty instanceof HTMLElement)empty.hidden=filtered.length>0}
    async function cargar(){try{const response=await fetch(endpoint,{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('HTTP '+response.status);const data=await response.json();if(!data?.ok||!Array.isArray(data.concertos))throw new Error('Índice no válido');conciertos=data.concertos;dibujar()}catch{if(summary instanceof HTMLElement)summary.textContent='Archivo temporalmente no disponible';if(errorState instanceof HTMLElement)errorState.hidden=false}}
    search?.addEventListener('input',dibujar);showAll?.addEventListener('click',()=>{if(search instanceof HTMLInputElement)search.value='';dibujar();document.querySelector('#arquivo-completo')?.scrollIntoView({behavior:'smooth',block:'start'})});cargar();
  </script>
</SpanishPublicLayout>

<style>
.history-page{padding-block:clamp(3rem,5vw,5rem)}.history-hero{max-width:850px;margin:0 auto 3rem;text-align:center}.eyebrow{margin:0 0 .4rem;color:#a3821a;font-size:.75rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.history-hero h1{margin:.25rem 0;color:#5c1926;font-size:clamp(2.2rem,4vw,3.5rem)}.history-hero>p:not(.eyebrow){max-width:680px;margin:1rem auto 0;color:#555;line-height:1.6}.section-line-center{width:60px;height:2px;margin:1rem auto;background:#a3821a}.history-summary{display:inline-block;margin-top:1.2rem;padding:.5rem 1rem;color:#5c1926;background:#f4f0e8;font-size:.85rem;font-weight:700;border-radius:4px}.history-actions{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;margin-top:1.2rem}.history-actions a,.history-actions button{padding:.75rem 1.25rem;border:1px solid #5c1926;background:#fff;color:#5c1926;font-weight:700;font-size:.8rem;text-decoration:none;cursor:pointer;border-radius:4px}.history-actions a:hover,.history-actions button:hover{background:#5c1926;color:#fff}.history-browser{max-width:1000px;margin:auto}.history-toolbar{display:flex;justify-content:space-between;align-items:flex-end;gap:1.5rem;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid #e0d9d0}.history-toolbar h2{margin:0;color:#5c1926;font-size:1.8rem}.history-search{width:min(100%,380px)}.history-search input{width:100%;box-sizing:border-box;padding:.75rem 1rem;border:1px solid #ccc;background:#fff;font:inherit;font-size:.9rem;border-radius:4px}.history-years{display:flex;flex-direction:column;gap:1.25rem;width:100%}.card-decada{width:100%;background:#fff;border:1px solid #e2ddd7;border-radius:6px;overflow:hidden}.card-decada summary{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.4rem;background:#faf8f5;cursor:pointer;list-style:none}.card-decada summary>div:first-child{display:flex;flex-direction:column;gap:.2rem}.period-label{font-size:.65rem;font-weight:800;color:#a3821a;text-transform:uppercase;letter-spacing:.08em}.card-decada summary strong{font-size:1.25rem;color:#5c1926}.period-meta{display:flex;align-items:center;gap:1rem}.period-meta span{font-size:.78rem;font-weight:700;color:#555;background:#eae4d9;padding:.25rem .75rem;border-radius:12px}.period-meta b{font-size:.8rem;color:#5c1926}.table-wrap{width:100%;overflow-x:auto;border-top:1px solid #e2ddd7}.table-wrap table{width:100%;border-collapse:collapse;text-align:left;font-size:.88rem}.table-wrap thead{background:#fcfbf9;border-bottom:2px solid #e2ddd7}.table-wrap th{padding:.8rem 1rem;color:#5c1926;font-size:.72rem;font-weight:800;text-transform:uppercase}.table-wrap td{padding:.8rem 1rem;border-bottom:1px solid #f0ebe3;vertical-align:top}.table-wrap .number{color:#a3821a;font-weight:800}.history-state{padding:1rem;background:#f4f0e8;color:#555}.history-state.error{color:#5c1926}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:720px){.history-toolbar{align-items:stretch;flex-direction:column}.history-search{width:100%}.table-wrap thead{display:none}.table-wrap table,.table-wrap tbody,.table-wrap tr,.table-wrap td{display:block;width:100%}.table-wrap tr{padding:.8rem;border-bottom:2px solid #e2ddd7}.table-wrap td{display:grid;grid-template-columns:100px 1fr;gap:.75rem;padding:.4rem;border:0}.table-wrap td::before{content:attr(data-label);color:#5c1926;font-weight:700}.card-decada summary{align-items:flex-start;gap:1rem}.period-meta{flex-direction:column;align-items:flex-end}}
</style>