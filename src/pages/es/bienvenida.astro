---
import SpanishPublicLayout from '../../layouts/SpanishPublicLayout.astro';
import { Image } from 'astro:assets';
import benvidaImg from '../../assets/benvida-2026.jpg';
---

<SpanishPublicLayout title="Bienvenida" description="Bienvenida a la Sociedad Coral Polifónica de Pontevedra.">
  <div class="container benvida-page-wrapper">
    <div class="page-header">
      <p class="page-kicker">DESCUBRE NUESTRA ESENCIA</p>
      <h1>Bienvenida a la Sociedad Coral Polifónica de Pontevedra</h1>
      <div class="section-line"></div>
    </div>

    <div class="benvida-card">
      <aside class="benvida-image-container">
        <Image src={benvidaImg} alt="Sociedad Coral Polifónica de Pontevedra" class="benvida-image" />
      </aside>

      <article class="benvida-content">
        <p class="lead">Es una satisfacción daros la bienvenida a la página web de la Sociedad Coral Polifónica de Pontevedra.</p>
        <p>Desde aquí queremos acercaros a la historia, la actividad y el espíritu de una institución que lleva más de un siglo haciendo de la música una parte esencial de la vida cultural de Pontevedra.</p>
        <p>Nuestra Coral es el resultado del compromiso, la ilusión y la dedicación de cientos de personas que, a lo largo de más de cien años, compartieron una misma pasión. Gracias a ellas conservamos un legado que tenemos la responsabilidad de cuidar y seguir enriqueciendo para las futuras generaciones.</p>
        <p>La música une a las personas, emociona y crea vínculos que perduran en el tiempo. Ese es el espíritu que nos inspira cada día y que queremos compartir con todas las personas que forman parte de esta gran familia, así como con quienes deseen conocernos, acompañarnos en nuestros conciertos o acercarse por primera vez a la música coral.</p>
        <p>Nuestra vocación es preservar el patrimonio musical que recibimos, promover la cultura coral y seguir haciendo de la música un punto de encuentro entre generaciones. Con cada ensayo y con cada concierto renovamos el compromiso de mantener viva una institución centenaria que continúa mirando al futuro con ilusión.</p>
        <p>La Junta Directiva quiere expresar su agradecimiento a todas las personas que, a lo largo de nuestra historia, contribuyeron con su esfuerzo, dedicación y generosidad a hacer posible que la Sociedad Coral Polifónica de Pontevedra llegase hasta aquí. Su ejemplo es la mejor inspiración para seguir construyendo el futuro manteniendo vivos los valores que nos identifican.</p>
        <p>Esperamos que esta visita sea el comienzo de un vínculo duradero con nuestra Coral.</p>
        <p><strong>Gracias por acompañarnos.</strong></p>

        <div class="signature">
          <div class="signature-line"></div>
          <p class="signature-name">La Junta Directiva</p>
          <p class="signature-org">Sociedad Coral Polifónica de Pontevedra</p>
        </div>

        <div class="next-section">
          <h3>Continúa conociendo nuestra Coral</h3>
          <nav class="next-nav">
            <a href="/es/historia">Historia</a>
            <a href="/es/directora">Directora</a>
            <a href="/es/junta-directiva">Junta Directiva</a>
            <a href="/es/coralistas">Coralistas</a>
          </nav>
        </div>
      </article>
    </div>
  </div>
</SpanishPublicLayout>

<style>
.benvida-page-wrapper{padding-top:4rem;padding-bottom:6rem}.page-header{text-align:center;margin-bottom:4rem;background:var(--color-fondo);padding:1.2rem 0}.page-kicker{letter-spacing:.18em;font-size:.68rem;font-weight:700;color:var(--color-acento);margin-bottom:.5rem}.page-header h1{font-size:2.2rem;color:var(--color-principal);line-height:1.2}.section-line{width:60px;height:2px;background:var(--color-acento);margin:1.2rem auto 0}.benvida-card{display:grid;grid-template-columns:42% 58%;gap:4rem;align-items:start;margin-top:2rem}.benvida-image-container{position:sticky;top:200px}.benvida-image{width:100%;display:block;height:auto;object-fit:cover;border-radius:8px;padding:10px;background:white;box-shadow:0 14px 35px rgba(0,0,0,.08);border:1px solid #ececec}.benvida-content{max-width:680px}.lead{font-size:1.25rem;font-style:italic;color:var(--color-principal);line-height:1.8;margin-bottom:2rem}.benvida-content p{font-size:1.08rem;line-height:1.9;color:var(--color-texto);margin-bottom:1.6rem}.signature{margin-top:4rem;padding-top:2rem}.signature-line{width:80px;height:1px;background:var(--color-acento);margin-bottom:1.5rem}.signature-name{font-size:1.05rem;font-weight:700;color:var(--color-principal);margin-bottom:.2rem!important}.signature-org{font-size:.95rem;color:#666;margin-bottom:0!important}.next-section{margin-top:5rem;padding-top:2.5rem;border-top:1px solid var(--color-gris)}.next-section h3{font-size:1.1rem;color:var(--color-principal);margin-bottom:1.5rem}.next-nav{display:flex;flex-wrap:wrap;gap:1.5rem 2.5rem}.next-nav a{text-decoration:none;color:var(--color-principal);font-weight:600;transition:all .25s ease;border-bottom:1px solid transparent;padding-bottom:.15rem}.next-nav a:hover{color:var(--color-acento);border-bottom-color:var(--color-acento)}
@media(max-width:1100px){.benvida-card{grid-template-columns:1fr;gap:3rem}.benvida-image-container{position:relative;top:0;max-width:720px;margin:0 auto}.benvida-content{max-width:100%}}
@media(max-width:768px){.benvida-page-wrapper{padding-top:2rem;padding-bottom:4rem}.page-header h1{font-size:1.8rem}.lead{font-size:1.15rem}.benvida-content p{font-size:1rem;line-height:1.8}.next-nav{flex-direction:column;gap:1rem}}
</style>
